# Capability-bounded, nonblocking TCP networking primitives for YAZA.
# Handles are process-local Number tokens.

fn tcp_listen(host: Text, port: Number, backlog: Number) -> Result[Number, Text]:
    return net_listen(host, port, backlog)

fn tcp_connect(host: Text, port: Number, timeout_ms: Number) -> Result[Number, Text]:
    return net_connect(host, port, timeout_ms)

fn tcp_accept(listener: Number, timeout_ms: Number) -> Result[Number, Text]:
    return net_accept(listener, timeout_ms)

fn tcp_read(connection: Number, max_bytes: Number, timeout_ms: Number) -> Result[Bytes, Text]:
    return net_read(connection, max_bytes, timeout_ms)

fn tcp_write(connection: Number, bytes: Bytes, timeout_ms: Number) -> Result[Number, Text]:
    return net_write(connection, bytes, timeout_ms)

fn tcp_close(handle: Number) -> Result[Boolean, Text]:
    return net_close(handle)

fn tcp_pair_create() -> Result[Number, Text]:
    return net_pair_create()

fn tcp_pair_peer(handle: Number) -> Result[Number, Text]:
    return net_pair_peer(handle)
