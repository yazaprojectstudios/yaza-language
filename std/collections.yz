# Typed collection algorithms for the current concrete List[T] Core surface.
# Number search APIs expect values in ascending order unless stated otherwise.

fn collections_linear_search_number(values: List[Number], target: Number) -> Number:
    let view: ListView[Number] = list_read_view(values)
    let count: Number = list_view_count(view)
    var index: Number = 0
    while index < count:
        if list_view_get(view, index) == target:
            return index
        set index = number_wrapping_add(index, 1)
    return -1
fn collections_lower_bound_number_view(values: ListView[Number], target: Number) -> Number:
    var low: Number = 0
    var high: Number = list_view_count(values)
    while low < high:
        # List lengths are capped at INT64_MAX; low <= middle < high.
        # Wrapping ops are used only where those invariants prove no wrap can occur.
        let middle: Number = number_wrapping_add(low, (number_wrapping_sub(high, low) / 2))
        if list_view_get(values, middle) < target:
            set low = number_wrapping_add(middle, 1)
        else:
            set high = middle
    return low

fn collections_lower_bound_number(values: List[Number], target: Number) -> Number:
    let view: ListView[Number] = list_read_view(values)
    return collections_lower_bound_number_view(view, target)

fn collections_branchless_lower_bound_number_view(values: ListView[Number], target: Number) -> Number:
    var low: Number = 0
    var high: Number = list_view_count(values)
    while low < high:
        # Keep the search-direction decision in arithmetic form; -O2 lowers
        # the conditional assignment to a select/csel/cmov on tested targets.
        # Bounds prove the wrapping index arithmetic remains within [0, count].
        let middle: Number = number_wrapping_add(low, (number_wrapping_sub(high, low) / 2))
        var move_right: Number = 0
        if list_view_get(values, middle) < target:
            set move_right = 1
        set low = number_wrapping_add(low, number_wrapping_mul(number_wrapping_sub(number_wrapping_add(middle, 1), low), move_right))
        set high = number_wrapping_add(middle, number_wrapping_mul(number_wrapping_sub(high, middle), move_right))
    return low

fn collections_branchless_lower_bound_number(values: List[Number], target: Number) -> Number:
    let view: ListView[Number] = list_read_view(values)
    return collections_branchless_lower_bound_number_view(view, target)

fn collections_binary_search_number(values: List[Number], target: Number) -> Number:
    let view: ListView[Number] = list_read_view(values)
    let index: Number = collections_lower_bound_number_view(view, target)
    let count: Number = list_view_count(view)
    if index < count and list_view_get(view, index) == target:
        return index
    return -1

fn collections_branchless_binary_search_number(values: List[Number], target: Number) -> Number:
    let view: ListView[Number] = list_read_view(values)
    let index: Number = collections_branchless_lower_bound_number_view(view, target)
    let count: Number = list_view_count(view)
    if index < count and list_view_get(view, index) == target:
        return index
    return -1

# --- Advanced Scaled Search Algorithms ---

fn collections_math_isqrt(n: Number) -> Number:
    if n <= 0: return 0
    if n < 4: return 1
    var x: Number = n
    var y: Number = (x + 1) / 2
    while y < x:
        set x = y
        set y = (x + (n / x)) / 2
    return x

fn collections_min_num(a: Number, b: Number) -> Number:
    if a < b: return a
    return b

fn collections_interpolation_search(values: List[Number], target: Number) -> Number:
    let view: ListView[Number] = list_read_view(values)
    let count: Number = list_view_count(view)
    if count == 0: return -1
    var low: Number = 0
    var high: Number = count - 1
    while low <= high and target >= list_view_get(view, low) and target <= list_view_get(view, high):
        if low == high:
            if list_view_get(view, low) == target: return low
            return -1
        let val_low: Number = list_view_get(view, low)
        let val_high: Number = list_view_get(view, high)
        if val_high == val_low:
            if val_low == target: return low
            return -1
        let pos: Number = low + (((high - low) / (val_high - val_low)) * (target - val_low))
        if pos < low or pos > high: return -1
        let val_pos: Number = list_view_get(view, pos)
        if val_pos == target:
            return pos
        if val_pos < target:
            set low = pos + 1
        else:
            set high = pos - 1
    return -1

fn collections_jump_search(values: List[Number], target: Number) -> Number:
    let view: ListView[Number] = list_read_view(values)
    let count: Number = list_view_count(view)
    if count == 0: return -1
    var step: Number = collections_math_isqrt(count)
    if step <= 0: set step = 1
    var prev: Number = 0
    while prev < count and list_view_get(view, collections_min_num(step, count) - 1) < target:
        set prev = step
        set step = step + collections_math_isqrt(count)
        if prev >= count: return -1
    var curr: Number = prev
    let limit: Number = collections_min_num(step, count)
    while curr < limit:
        if list_view_get(view, curr) == target: return curr
        set curr = curr + 1
    return -1

fn collections_exponential_search(values: List[Number], target: Number) -> Number:
    let view: ListView[Number] = list_read_view(values)
    let count: Number = list_view_count(view)
    if count == 0: return -1
    if list_view_get(view, 0) == target: return 0
    var bound: Number = 1
    while bound < count and list_view_get(view, bound) <= target:
        set bound = bound * 2
    var low: Number = bound / 2
    var high: Number = collections_min_num(bound, count)
    while low < high:
        let mid: Number = low + ((high - low) / 2)
        if list_view_get(view, mid) < target:
            set low = mid + 1
        else:
            set high = mid
    if low < count and list_view_get(view, low) == target:
        return low
    return -1

fn collections_ternary_search(values: List[Number], target: Number) -> Number:
    let view: ListView[Number] = list_read_view(values)
    let count: Number = list_view_count(view)
    if count == 0: return -1
    var low: Number = 0
    var high: Number = count - 1
    while low <= high:
        let third: Number = (high - low) / 3
        let mid1: Number = low + third
        let mid2: Number = high - third
        if list_view_get(view, mid1) == target: return mid1
        if list_view_get(view, mid2) == target: return mid2
        if target < list_view_get(view, mid1):
            set high = mid1 - 1
        elif target > list_view_get(view, mid2):
            set low = mid2 + 1
        else:
            set low = mid1 + 1
            set high = mid2 - 1
    return -1
