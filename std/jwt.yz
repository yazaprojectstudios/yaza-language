# Standard JSON Web Token (JWT) HS256 (RFC 7519) for YAZA.
# Token format: base64url(header) + "." + base64url(payload) + "." + base64url(hmac_sha256(signing_input, secret))

use "std/json"
use "std/crypto/hash"

shape JwtClaims:
    subject: Text
    role: Text
    issuer: Text
    audience: Text
    expiry_s: Number

fn jwt_b64url_alphabet() -> Text:
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

fn jwt_b64url_encode(data: Bytes) -> Text:
    let alphabet: Text = jwt_b64url_alphabet()
    let len: Number = bytes_length(data)
    var out: Text = ""
    var i: Number = 0
    while i < len:
        let b0: Number = bytes_get(data, i)
        var b1: Number = 0
        var b2: Number = 0
        var remaining: Number = len - i
        if remaining > 1: set b1 = bytes_get(data, i + 1)
        if remaining > 2: set b2 = bytes_get(data, i + 2)
        let n: Number = (b0 * 65536) + (b1 * 256) + b2
        let c0: Number = (n / 262144) % 64
        let c1: Number = (n / 4096) % 64
        let c2: Number = (n / 64) % 64
        let c3: Number = n % 64
        set out = out + text_slice(alphabet, c0, 1) + text_slice(alphabet, c1, 1)
        if remaining > 1:
            set out = out + text_slice(alphabet, c2, 1)
        if remaining > 2:
            set out = out + text_slice(alphabet, c3, 1)
        set i = i + 3
    return out

fn jwt_b64url_val(byte: Number) -> Number:
    if byte >= 65 and byte <= 90: return byte - 65
    if byte >= 97 and byte <= 122: return byte - 71
    if byte >= 48 and byte <= 57: return byte + 4
    if byte == 45: return 62 # '-'
    if byte == 95: return 63 # '_'
    return -1

fn jwt_b64url_decode(encoded: Text) -> Result[Bytes, Text]:
    let len: Number = text_length(encoded)
    if len == 0 or (len % 4) == 1:
        return err("invalid base64url length")
    var extra: Number = 0
    if (len % 4) == 2: set extra = 1
    elif (len % 4) == 3: set extra = 2
    let out_len: Number = (len / 4) * 3 + extra
    let out: Bytes = bytes_try_new_zeroed(out_len)?
    var i: Number = 0
    var o: Number = 0
    while i < len:
        let v0: Number = jwt_b64url_val(text_byte(encoded, i))
        let v1: Number = jwt_b64url_val(text_byte(encoded, i + 1))
        if v0 < 0 or v1 < 0: return err("invalid base64url character")
        var v2: Number = 0
        var v3: Number = 0
        var rem: Number = len - i
        if rem > 2:
            set v2 = jwt_b64url_val(text_byte(encoded, i + 2))
            if v2 < 0: return err("invalid base64url character")
        if rem > 3:
            set v3 = jwt_b64url_val(text_byte(encoded, i + 3))
            if v3 < 0: return err("invalid base64url character")
        let n: Number = (v0 * 262144) + (v1 * 4096) + (v2 * 64) + v3
        let _s0: Boolean = bytes_try_set(out, o, (n / 65536) % 256)
        set o = o + 1
        if rem > 2:
            let _s1: Boolean = bytes_try_set(out, o, (n / 256) % 256)
            set o = o + 1
        if rem > 3:
            let _s2: Boolean = bytes_try_set(out, o, n % 256)
            set o = o + 1
        set i = i + 4
    return ok(out)

fn jwt_create_hs256(subject: Text, issuer: Text, audience: Text, role: Text, expiry_s: Number, secret: Text) -> Text:
    if text_length(secret) < 32: fail("JWT HS256 secret must contain at least 32 characters")
    let header_json: Text = "{\"alg\":\"HS256\",\"typ\":\"JWT\"}"
    let payload_json: Text = "{\"sub\":\"" + json_escape_text(subject) + "\",\"iss\":\"" + json_escape_text(issuer) + "\",\"aud\":\"" + json_escape_text(audience) + "\",\"role\":\"" + json_escape_text(role) + "\",\"exp\":" + number_text(expiry_s) + "}"
    let h_b64: Text = jwt_b64url_encode(bytes_from_text(header_json))
    let p_b64: Text = jwt_b64url_encode(bytes_from_text(payload_json))
    let signing_input: Text = h_b64 + "." + p_b64
    let sig_bytes: Bytes = crypto_hmac_sha256(bytes_from_text(secret), bytes_from_text(signing_input))
    let sig_b64: Text = jwt_b64url_encode(sig_bytes)
    return signing_input + "." + sig_b64

fn jwt_verify_hs256(token: Text, expected_issuer: Text, expected_audience: Text, current_time_s: Number, secret: Text) -> Result[JwtClaims, Text]:
    if text_length(secret) < 32:
        return err("JWT HS256 secret must contain at least 32 characters")
    if text_length(token) > 8192:
        return err("JWT token exceeds the 8 KiB hard limit")
    let parts: TextList = text_split(token, ".")
    if list_count(parts) != 3:
        return err("malformed JWT structure; expected header.payload.signature")
    let h_b64: Text = list_get(parts, 0)
    let p_b64: Text = list_get(parts, 1)
    let sig_b64: Text = list_get(parts, 2)

    let header_bytes_res: Result[Bytes, Text] = jwt_b64url_decode(h_b64)
    if not result_is_ok(header_bytes_res): return err("invalid JWT header encoding")
    let header_text: Text = bytes_to_text(result_unwrap(header_bytes_res))
    let alg_opt: Option[Text] = json_extract_string(header_text, "alg")
    if not option_is_some(alg_opt) or option_unwrap(alg_opt) != "HS256":
        return err("unsupported JWT algorithm; expected HS256")

    let signing_input: Text = h_b64 + "." + p_b64
    let expected_sig: Text = jwt_b64url_encode(crypto_hmac_sha256(bytes_from_text(secret), bytes_from_text(signing_input)))
    if not crypto_constant_time_compare(expected_sig, sig_b64):
        return err("invalid JWT signature")

    let payload_bytes_res: Result[Bytes, Text] = jwt_b64url_decode(p_b64)
    if not result_is_ok(payload_bytes_res): return err("invalid JWT payload encoding")
    let payload_text: Text = bytes_to_text(result_unwrap(payload_bytes_res))

    let sub_opt: Option[Text] = json_extract_string(payload_text, "sub")
    if not option_is_some(sub_opt) or option_unwrap(sub_opt) == "": return err("JWT missing sub claim")
    let exp_opt: Option[Number] = json_extract_number(payload_text, "exp")
    if not option_is_some(exp_opt): return err("JWT missing exp claim")
    let exp_val: Number = option_unwrap(exp_opt)
    if exp_val <= current_time_s: return err("JWT token expired")

    var iss_val: Text = ""
    let iss_opt: Option[Text] = json_extract_string(payload_text, "iss")
    if option_is_some(iss_opt): set iss_val = option_unwrap(iss_opt)
    if expected_issuer != "" and iss_val != expected_issuer:
        return err("JWT issuer mismatch")

    var aud_val: Text = ""
    let aud_opt: Option[Text] = json_extract_string(payload_text, "aud")
    if option_is_some(aud_opt): set aud_val = option_unwrap(aud_opt)
    if expected_audience != "" and aud_val != expected_audience:
        return err("JWT audience mismatch")

    var role_val: Text = ""
    let role_opt: Option[Text] = json_extract_string(payload_text, "role")
    if option_is_some(role_opt): set role_val = option_unwrap(role_opt)

    return ok(JwtClaims(option_unwrap(sub_opt), role_val, iss_val, aud_val, exp_val))
