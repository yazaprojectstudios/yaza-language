# Fullstack Web & Media Request Parser (Binary-Body Safe: Cookie, Fragment, CSRF, ETag & Range).
use "std/http"
use "std/web/cookie"

shape WebRequest:
    http: HttpRequest
    cookie_header: Text
    fragment_target: Text
    csrf_header: Text
    if_none_match: Text
    range_header: Text

fn web_extract_header_value(raw_headers: Text, target_lower: Text) -> Text:
    let lines: TextList = text_lines(raw_headers)
    let matches: TextList = text_list()
    var i: Number = 1
    while i < list_count(lines):
        let line: Text = text_trim(list_get(lines, i))
        let colon: Number = text_find(line, ":")
        if colon > 0:
            let name_lower: Text = http_ascii_lower_header_name(text_trim(text_slice(line, 0, colon)))
            if name_lower == target_lower:
                let val: Text = text_trim(text_slice(line, colon + 1, text_length(line) - colon - 1))
                if target_lower != "cookie":
                    return val
                if text_length(val) > 0:
                    list_push(matches, val)
        set i = i + 1
    if list_count(matches) == 0:
        return ""
    return text_join(matches, "; ")

fn web_header_block_text(raw_bytes: Bytes) -> Text:
    let header_end: Number = http_find_header_end_bytes(raw_bytes)
    var slice_len: Number = bytes_length(raw_bytes)
    if header_end >= 0:
        set slice_len = header_end
    elif slice_len > 16384:
        set slice_len = 16384
    if slice_len == 0:
        return ""
    let hdr_slice: Bytes = bytes_slice(raw_bytes, 0, slice_len)
    let fast_res: Result[Text, Text] = bytes_try_to_text(hdr_slice)
    if result_is_ok(fast_res):
        return result_unwrap(fast_res)
    # Lossy ASCII fallback so 1 stray non-UTF-8 byte in Referer/User-Agent never drops Cookie/CSRF/Range headers
    let clean_res: Result[Bytes, Text] = bytes_try_new_zeroed(slice_len)
    if not result_is_ok(clean_res):
        return ""
    let clean: Bytes = result_unwrap(clean_res)
    var i: Number = 0
    while i < slice_len:
        let b: Number = bytes_get(hdr_slice, i)
        var out_b: Number = b
        if b == 0 or b >= 128:
            set out_b = 63
        let _s: Boolean = bytes_try_set(clean, i, out_b)
        set i = i + 1
    let lossy_res: Result[Text, Text] = bytes_try_to_text(clean)
    if result_is_ok(lossy_res):
        return result_unwrap(lossy_res)
    return ""

fn web_parse_request(raw_bytes: Bytes) -> Result[WebRequest, Text]:
    let http_req: HttpRequest = http_parse_request(raw_bytes)?
    let hdr_block: Text = web_header_block_text(raw_bytes)
    let cookie_hdr: Text = web_extract_header_value(hdr_block, "cookie")
    let frag_hdr: Text = web_extract_header_value(hdr_block, "x-yaza-fragment")
    let csrf_hdr: Text = web_extract_header_value(hdr_block, "x-csrf-token")
    let inm_hdr: Text = web_extract_header_value(hdr_block, "if-none-match")
    let rng_hdr: Text = web_extract_header_value(hdr_block, "range")
    return ok(WebRequest(http_req, cookie_hdr, frag_hdr, csrf_hdr, inm_hdr, rng_hdr))

fn web_request_cookie(req: WebRequest, name: Text) -> Option[Text]:
    return cookie_get(req.cookie_header, name)

fn web_request_wants_fragment(req: WebRequest) -> Boolean:
    if text_length(req.fragment_target) > 0:
        return true
    return text_find(req.http.accept, "text/vnd.yaza.fragment") >= 0

fn web_request_wants_json(req: WebRequest) -> Boolean:
    if text_starts_with(req.http.path, "/api/"):
        return true
    let has_json: Boolean = text_find(req.http.accept, "application/json") >= 0
    let has_html: Boolean = text_find(req.http.accept, "text/html") >= 0
    return has_json and not has_html
