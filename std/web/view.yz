# Type-Safe Compiled SSR View Helpers over std/html (XSS-Safe by Construction).
use "std/html"

fn view_escape(value: Text) -> Text:
    let escaped: Result[Text, Text] = html_escape(value)
    if result_is_ok(escaped):
        return result_unwrap(escaped)
    return ""

fn view_attr_name_is_safe(name: Text) -> Boolean:
    let len: Number = text_length(name)
    if len == 0 or len > 64:
        return false
    var i: Number = 0
    while i < len:
        let b: Number = text_byte(name, i)
        let ok_ch: Boolean = (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or (b >= 48 and b <= 57) or b == 45 or b == 95
        if not ok_ch:
            return false
        set i = i + 1
    # Reject inline event handlers (on*) to prevent attribute XSS
    if len >= 2 and (text_byte(name, 0) == 111 or text_byte(name, 0) == 79) and (text_byte(name, 1) == 110 or text_byte(name, 1) == 78):
        return false
    return true

fn view_tag_name_is_safe(tag: Text) -> Boolean:
    let len: Number = text_length(tag)
    if len == 0 or len > 32:
        return false
    let b0: Number = text_byte(tag, 0)
    if not ((b0 >= 65 and b0 <= 90) or (b0 >= 97 and b0 <= 122)):
        return false
    let lower_parts: TextList = text_list()
    var i: Number = 0
    while i < len:
        let b: Number = text_byte(tag, i)
        let ok_ch: Boolean = (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or (b >= 48 and b <= 57) or b == 45
        if not ok_ch:
            return false
        if b >= 65 and b <= 90:
            let one: Bytes = bytes_from_text("a")
            let _ok: Boolean = bytes_try_set(one, 0, b + 32)
            list_push(lower_parts, bytes_to_text(one))
        else:
            list_push(lower_parts, text_slice(tag, i, 1))
        set i = i + 1
    let low: Text = text_join(lower_parts, "")
    if low == "script" or low == "style" or low == "iframe" or low == "object" or low == "embed" or low == "base" or low == "meta" or low == "link":
        return false
    return true

fn view_attr(name: Text, value: Text) -> Text:
    if not view_attr_name_is_safe(name):
        return ""
    return " " + name + "=\"" + view_escape(value) + "\""

fn view_safe_href(href: Text) -> Text:
    let ok_res: Result[Boolean, Text] = html_href_is_safe(href)
    if result_is_ok(ok_res) and result_unwrap(ok_res):
        return view_escape(href)
    return "#"

fn view_text_tag(tag: Text, class_name: Text, content: Text) -> Text:
    var safe_tag: Text = tag
    if not view_tag_name_is_safe(safe_tag):
        set safe_tag = "span"
    if text_length(class_name) > 0:
        return "<" + safe_tag + view_attr("class", class_name) + ">" + view_escape(content) + "</" + safe_tag + ">"
    return "<" + safe_tag + ">" + view_escape(content) + "</" + safe_tag + ">"

fn view_csrf_input(csrf_token: Text) -> Text:
    return "<input type=\"hidden\" name=\"_csrf\"" + view_attr("value", csrf_token) + ">"

fn view_link(href: Text, class_name: Text, label: Text) -> Text:
    var attrs: Text = " href=\"" + view_safe_href(href) + "\""
    if text_length(class_name) > 0:
        set attrs = attrs + view_attr("class", class_name)
    return "<a" + attrs + ">" + view_escape(label) + "</a>"
