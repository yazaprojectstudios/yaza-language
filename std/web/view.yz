# Type-Safe Compiled SSR View Helpers over std/html (XSS-Safe by Construction).
use "std/html"

fn view_escape(value: Text) -> Text:
    let escaped: Result[Text, Text] = html_escape(value)
    if result_is_ok(escaped):
        return result_unwrap(escaped)
    return ""

fn view_attr(name: Text, value: Text) -> Text:
    return " " + name + "=\"" + view_escape(value) + "\""

fn view_safe_href(href: Text) -> Text:
    let ok_res: Result[Boolean, Text] = html_href_is_safe(href)
    if result_is_ok(ok_res) and result_unwrap(ok_res):
        return view_escape(href)
    return "#"

fn view_text_tag(tag: Text, class_name: Text, content: Text) -> Text:
    if text_length(class_name) > 0:
        return "<" + tag + view_attr("class", class_name) + ">" + view_escape(content) + "</" + tag + ">"
    return "<" + tag + ">" + view_escape(content) + "</" + tag + ">"

fn view_csrf_input(csrf_token: Text) -> Text:
    return "<input type=\"hidden\" name=\"_csrf\"" + view_attr("value", csrf_token) + ">"

fn view_link(href: Text, class_name: Text, label: Text) -> Text:
    var attrs: Text = " href=\"" + view_safe_href(href) + "\""
    if text_length(class_name) > 0:
        set attrs = attrs + view_attr("class", class_name)
    return "<a" + attrs + ">" + view_escape(label) + "</a>"
