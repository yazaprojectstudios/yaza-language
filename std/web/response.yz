# Web HTTP/1.1 Response Builders & Wire Formatter (HTML SSR, Fragments, Downloads, HTTP 206 Streaming, Cookies & Web CSP).
use "std/http"

shape WebResponse:
    status_code: Number
    status_text: Text
    content_type: Text
    body: Bytes
    location: Text
    set_cookie: Text
    etag: Text
    cache_control: Text
    csp_policy: Text
    vary_header: Text
    content_disposition: Text
    accept_ranges: Text
    content_range: Text

fn web_default_csp() -> Text:
    return "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

fn web_api_csp() -> Text:
    return "default-src 'none'; frame-ancestors 'none'"

fn web_sanitize_header_line(value: Text) -> Text:
    let len: Number = text_length(value)
    var i: Number = 0
    while i < len:
        let b: Number = text_byte(value, i)
        if b < 32 or b == 127:
            return ""
        set i = i + 1
    return value

fn web_sanitize_disposition_filename(raw: Text) -> Text:
    let len: Number = text_length(raw)
    let parts: TextList = text_list()
    var i: Number = 0
    while i < len and i < 120:
        let b: Number = text_byte(raw, i)
        let is_safe: Boolean = (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 45 or b == 46 or b == 95
        if is_safe:
            list_push(parts, text_slice(raw, i, 1))
        set i = i + 1
    let clean: Text = text_join(parts, "")
    if text_length(clean) == 0:
        return "download.bin"
    return clean

fn web_html_status(status_code: Number, status_text: Text, html_body: Text) -> WebResponse:
    return WebResponse(status_code, status_text, "text/html; charset=utf-8", bytes_from_text(html_body), "", "", "", "no-store", web_default_csp(), "Accept, X-Yaza-Fragment", "", "", "")

fn web_html_ok(html_body: Text) -> WebResponse:
    return web_html_status(200, "OK", html_body)

fn web_fragment_ok(fragment_html: Text) -> WebResponse:
    return web_html_status(200, "OK", fragment_html)

fn web_redirect_see_other(location: Text) -> WebResponse:
    var safe_loc: Text = web_sanitize_header_line(location)
    if text_length(safe_loc) == 0 or not text_starts_with(safe_loc, "/"):
        set safe_loc = "/"
    return WebResponse(303, "See Other", "text/plain; charset=utf-8", bytes_empty(), safe_loc, "", "", "no-store", web_default_csp(), "Accept", "", "", "")

fn web_static_ok(content_type: Text, body: Bytes, etag: Text, cache_control: Text) -> WebResponse:
    return WebResponse(200, "OK", content_type, body, "", "", etag, cache_control, web_default_csp(), "Accept-Encoding", "", "bytes", "")

fn web_media_ok(content_type: Text, body: Bytes, etag: Text, cache_control: Text) -> WebResponse:
    return WebResponse(200, "OK", content_type, body, "", "", etag, cache_control, web_default_csp(), "Range, Accept-Encoding", "", "bytes", "")

fn web_partial_content(content_type: Text, chunk: Bytes, start_offset: Number, end_offset: Number, total_size: Number, etag: Text) -> WebResponse:
    let cr: Text = "bytes " + number_text(start_offset) + "-" + number_text(end_offset) + "/" + number_text(total_size)
    return WebResponse(206, "Partial Content", content_type, chunk, "", "", etag, "public, max-age=300, must-revalidate", web_default_csp(), "Range", "", "bytes", cr)

fn web_range_not_satisfiable(total_size: Number) -> WebResponse:
    let cr: Text = "bytes */" + number_text(total_size)
    return WebResponse(416, "Range Not Satisfiable", "text/plain; charset=utf-8", bytes_from_text("Range Not Satisfiable"), "", "", "", "no-store", web_api_csp(), "Range", "", "bytes", cr)

fn web_download_bytes(filename: Text, content_type: Text, body: Bytes) -> WebResponse:
    let safe_name: Text = web_sanitize_disposition_filename(filename)
    let disp: Text = "attachment; filename=\"" + safe_name + "\""
    return WebResponse(200, "OK", content_type, body, "", "", "", "private, no-store", web_api_csp(), "Accept", disp, "bytes", "")

fn web_not_modified(etag: Text, cache_control: Text) -> WebResponse:
    return WebResponse(304, "Not Modified", "", bytes_empty(), "", "", etag, cache_control, web_default_csp(), "Accept-Encoding", "", "", "")

fn web_from_http_response(resp: HttpResponse) -> WebResponse:
    return WebResponse(resp.status_code, resp.status_text, resp.content_type, resp.body, "", "", "", "no-store", web_api_csp(), "Accept", "", "", "")

fn web_with_cookie(resp: WebResponse, set_cookie_value: Text) -> WebResponse:
    let safe_cookie: Text = web_sanitize_header_line(set_cookie_value)
    return WebResponse(resp.status_code, resp.status_text, resp.content_type, resp.body, resp.location, safe_cookie, resp.etag, resp.cache_control, resp.csp_policy, resp.vary_header, resp.content_disposition, resp.accept_ranges, resp.content_range)

fn web_with_content_disposition(resp: WebResponse, filename: Text, attachment: Boolean) -> WebResponse:
    let safe_name: Text = web_sanitize_disposition_filename(filename)
    var kind: Text = "inline"
    if attachment:
        set kind = "attachment"
    let disp: Text = kind + "; filename=\"" + safe_name + "\""
    return WebResponse(resp.status_code, resp.status_text, resp.content_type, resp.body, resp.location, resp.set_cookie, resp.etag, resp.cache_control, resp.csp_policy, resp.vary_header, disp, resp.accept_ranges, resp.content_range)

fn web_format_response(resp: WebResponse, request_id: Text, keep_alive: Boolean) -> Bytes:
    let p: TextList = text_list()
    list_push(p, "HTTP/1.1 " + number_text(resp.status_code) + " " + resp.status_text + "\r\n")
    if text_length(resp.content_type) > 0:
        list_push(p, "Content-Type: " + resp.content_type + "\r\n")
    list_push(p, "Content-Length: " + number_text(bytes_length(resp.body)) + "\r\n")
    if text_length(resp.location) > 0:
        list_push(p, "Location: " + resp.location + "\r\n")
    if text_length(resp.set_cookie) > 0:
        list_push(p, "Set-Cookie: " + resp.set_cookie + "\r\n")
    if text_length(resp.etag) > 0:
        list_push(p, "ETag: " + resp.etag + "\r\n")
    if text_length(resp.content_disposition) > 0:
        list_push(p, "Content-Disposition: " + resp.content_disposition + "\r\n")
    if text_length(resp.accept_ranges) > 0:
        list_push(p, "Accept-Ranges: " + resp.accept_ranges + "\r\n")
    if text_length(resp.content_range) > 0:
        list_push(p, "Content-Range: " + resp.content_range + "\r\n")
    list_push(p, "X-Content-Type-Options: nosniff\r\n")
    list_push(p, "X-Frame-Options: DENY\r\n")
    list_push(p, "Referrer-Policy: strict-origin-when-cross-origin\r\n")
    if text_length(resp.csp_policy) > 0:
        list_push(p, "Content-Security-Policy: " + resp.csp_policy + "\r\n")
    if text_length(resp.cache_control) > 0:
        list_push(p, "Cache-Control: " + resp.cache_control + "\r\n")
    if text_length(request_id) > 0:
        list_push(p, "X-Request-Id: " + request_id + "\r\n")
    if text_length(resp.vary_header) > 0:
        list_push(p, "Vary: " + resp.vary_header + "\r\n")
    if keep_alive:
        list_push(p, "Connection: keep-alive\r\nKeep-Alive: timeout=5, max=64\r\n\r\n")
    else:
        list_push(p, "Connection: close\r\n\r\n")
    return bytes_concat(bytes_from_text(text_join(p, "")), resp.body)
