# Web HTTP/1.1 Response Builders & Wire Formatter (HTML SSR, Fragments, Downloads, HTTP 206 Streaming, Multi-Cookie & Web CSP).
use "std/http"

shape WebResponse:
    status_code: Number
    status_text: Text
    content_type: Text
    body: Bytes
    location: Text
    set_cookies: TextList
    etag: Text
    cache_control: Text
    csp_policy: Text
    vary_header: Text
    content_disposition: Text
    accept_ranges: Text
    content_range: Text

fn web_default_csp() -> Text:
    return "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

fn web_api_csp() -> Text:
    return "default-src 'none'; frame-ancestors 'none'"

fn web_sanitize_header_line(value: Text) -> Text:
    let len: Number = text_length(value)
    var i: Number = 0
    while i < len:
        let b: Number = text_byte(value, i)
        if b < 32 or b == 127:
            return ""
        set i = i + 1
    return value

fn web_sanitize_disposition_filename(raw: Text) -> Text:
    let len: Number = text_length(raw)
    let parts: TextList = text_list()
    var i: Number = 0
    while i < len and i < 120:
        let b: Number = text_byte(raw, i)
        let is_safe: Boolean = (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 45 or b == 46 or b == 95
        if is_safe:
            list_push(parts, text_slice(raw, i, 1))
        set i = i + 1
    let clean: Text = text_join(parts, "")
    if text_length(clean) == 0:
        return "download.bin"
    return clean

fn web_html_status(status_code: Number, status_text: Text, html_body: Text) -> WebResponse:
    return WebResponse(status_code, status_text, "text/html; charset=utf-8", bytes_from_text(html_body), "", text_list(), "", "no-store", web_default_csp(), "Accept, X-Yaza-Fragment", "", "", "")

fn web_html_ok(html_body: Text) -> WebResponse:
    return web_html_status(200, "OK", html_body)

fn web_fragment_ok(fragment_html: Text) -> WebResponse:
    return web_html_status(200, "OK", fragment_html)

fn web_redirect_see_other(location: Text) -> WebResponse:
    var safe_loc: Text = web_sanitize_header_line(location)
    if text_length(safe_loc) == 0 or not text_starts_with(safe_loc, "/") or text_starts_with(safe_loc, "//") or text_starts_with(safe_loc, "/\\"):
        set safe_loc = "/"
    return WebResponse(303, "See Other", "text/plain; charset=utf-8", bytes_empty(), safe_loc, text_list(), "", "no-store", web_default_csp(), "Accept", "", "", "")

fn web_static_ok(content_type: Text, body: Bytes, etag: Text, cache_control: Text) -> WebResponse:
    return WebResponse(200, "OK", content_type, body, "", text_list(), etag, cache_control, web_default_csp(), "Accept-Encoding", "", "bytes", "")

fn web_media_ok(content_type: Text, body: Bytes, etag: Text, cache_control: Text) -> WebResponse:
    return WebResponse(200, "OK", content_type, body, "", text_list(), etag, cache_control, web_default_csp(), "Range, Accept-Encoding", "", "bytes", "")

fn web_partial_content(content_type: Text, chunk: Bytes, start_offset: Number, end_offset: Number, total_size: Number, etag: Text) -> WebResponse:
    let cr: Text = "bytes " + number_text(start_offset) + "-" + number_text(end_offset) + "/" + number_text(total_size)
    return WebResponse(206, "Partial Content", content_type, chunk, "", text_list(), etag, "public, max-age=300, must-revalidate", web_default_csp(), "Range", "", "bytes", cr)

fn web_range_not_satisfiable(total_size: Number) -> WebResponse:
    let cr: Text = "bytes */" + number_text(total_size)
    return WebResponse(416, "Range Not Satisfiable", "text/plain; charset=utf-8", bytes_from_text("Range Not Satisfiable"), "", text_list(), "", "no-store", web_api_csp(), "Range", "", "bytes", cr)

fn web_download_bytes(filename: Text, content_type: Text, body: Bytes) -> WebResponse:
    let safe_name: Text = web_sanitize_disposition_filename(filename)
    let disp: Text = "attachment; filename=\"" + safe_name + "\""
    return WebResponse(200, "OK", content_type, body, "", text_list(), "", "private, no-store", web_api_csp(), "Accept", disp, "bytes", "")

fn web_not_modified(etag: Text, cache_control: Text) -> WebResponse:
    return WebResponse(304, "Not Modified", "", bytes_empty(), "", text_list(), etag, cache_control, web_default_csp(), "Accept-Encoding", "", "", "")

fn web_from_http_response(resp: HttpResponse) -> WebResponse:
    return WebResponse(resp.status_code, resp.status_text, resp.content_type, resp.body, "", text_list(), "", "no-store", web_api_csp(), "Accept", "", "", "")

fn web_with_cookie(resp: WebResponse, set_cookie_value: Text) -> WebResponse:
    let next_cookies: TextList = text_list()
    var i: Number = 0
    while i < list_count(resp.set_cookies):
        list_push(next_cookies, list_get(resp.set_cookies, i))
        set i = i + 1
    let safe_cookie: Text = web_sanitize_header_line(set_cookie_value)
    if text_length(safe_cookie) > 0:
        list_push(next_cookies, safe_cookie)
    return WebResponse(resp.status_code, resp.status_text, resp.content_type, resp.body, resp.location, next_cookies, resp.etag, resp.cache_control, resp.csp_policy, resp.vary_header, resp.content_disposition, resp.accept_ranges, resp.content_range)

fn web_with_content_disposition(resp: WebResponse, filename: Text, attachment: Boolean) -> WebResponse:
    let safe_name: Text = web_sanitize_disposition_filename(filename)
    var kind: Text = "inline"
    if attachment:
        set kind = "attachment"
    let disp: Text = kind + "; filename=\"" + safe_name + "\""
    return WebResponse(resp.status_code, resp.status_text, resp.content_type, resp.body, resp.location, resp.set_cookies, resp.etag, resp.cache_control, resp.csp_policy, resp.vary_header, disp, resp.accept_ranges, resp.content_range)

fn web_format_response(resp: WebResponse, request_id: Text, keep_alive: Boolean) -> Bytes:
    let p: TextList = text_list()
    var safe_status_text: Text = web_sanitize_header_line(resp.status_text)
    if text_length(safe_status_text) == 0:
        set safe_status_text = "OK"
    list_push(p, "HTTP/1.1 " + number_text(resp.status_code) + " " + safe_status_text + "\r\n")
    let safe_ct: Text = web_sanitize_header_line(resp.content_type)
    if text_length(safe_ct) > 0:
        list_push(p, "Content-Type: " + safe_ct + "\r\n")
    let has_body_allowed: Boolean = resp.status_code != 204 and resp.status_code != 304
    if has_body_allowed:
        list_push(p, "Content-Length: " + number_text(bytes_length(resp.body)) + "\r\n")
    let safe_loc: Text = web_sanitize_header_line(resp.location)
    if text_length(safe_loc) > 0:
        list_push(p, "Location: " + safe_loc + "\r\n")
    var ci: Number = 0
    while ci < list_count(resp.set_cookies):
        let sc: Text = web_sanitize_header_line(list_get(resp.set_cookies, ci))
        if text_length(sc) > 0:
            list_push(p, "Set-Cookie: " + sc + "\r\n")
        set ci = ci + 1
    let safe_etag: Text = web_sanitize_header_line(resp.etag)
    if text_length(safe_etag) > 0:
        list_push(p, "ETag: " + safe_etag + "\r\n")
    let safe_disp: Text = web_sanitize_header_line(resp.content_disposition)
    if text_length(safe_disp) > 0:
        list_push(p, "Content-Disposition: " + safe_disp + "\r\n")
    let safe_ar: Text = web_sanitize_header_line(resp.accept_ranges)
    if text_length(safe_ar) > 0:
        list_push(p, "Accept-Ranges: " + safe_ar + "\r\n")
    let safe_cr: Text = web_sanitize_header_line(resp.content_range)
    if text_length(safe_cr) > 0:
        list_push(p, "Content-Range: " + safe_cr + "\r\n")
    list_push(p, "X-Content-Type-Options: nosniff\r\n")
    list_push(p, "X-Frame-Options: DENY\r\n")
    list_push(p, "Referrer-Policy: strict-origin-when-cross-origin\r\n")
    let safe_csp: Text = web_sanitize_header_line(resp.csp_policy)
    if text_length(safe_csp) > 0:
        list_push(p, "Content-Security-Policy: " + safe_csp + "\r\n")
    let safe_cc: Text = web_sanitize_header_line(resp.cache_control)
    if text_length(safe_cc) > 0:
        list_push(p, "Cache-Control: " + safe_cc + "\r\n")
    let safe_req_id: Text = web_sanitize_header_line(request_id)
    if text_length(safe_req_id) > 0:
        list_push(p, "X-Request-Id: " + safe_req_id + "\r\n")
    let safe_vary: Text = web_sanitize_header_line(resp.vary_header)
    if text_length(safe_vary) > 0:
        list_push(p, "Vary: " + safe_vary + "\r\n")
    if keep_alive:
        list_push(p, "Connection: keep-alive\r\nKeep-Alive: timeout=5, max=64\r\n\r\n")
    else:
        list_push(p, "Connection: close\r\n\r\n")
    if not has_body_allowed:
        return bytes_from_text(text_join(p, ""))
    return bytes_concat(bytes_from_text(text_join(p, "")), resp.body)
