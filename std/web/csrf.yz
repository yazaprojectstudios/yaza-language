# Session-Bound Synchronizer CSRF Token Generation & Constant-Time Verification.
# Uses domain-separated sub-key derivation to isolate CSRF tokens from YWT/session signing keys.
use "std/crypto/hash"

fn csrf_derive_key(secret: Text) -> Text:
    return crypto_hmac_sha256_hex(secret, "csrf1:hmac-sha256:signing-key")

fn csrf_issue_token(session_token: Text, secret: Text) -> Text:
    if text_length(session_token) == 0 or text_length(secret) < 32:
        return ""
    let key: Text = csrf_derive_key(secret)
    return crypto_hmac_sha256_hex(key, "yaza-csrf-v1:" + session_token)

fn csrf_verify_token(session_token: Text, submitted_token: Text, secret: Text) -> Boolean:
    if text_length(session_token) == 0 or text_length(submitted_token) != 64 or text_length(secret) < 32:
        return false
    let expected: Text = csrf_issue_token(session_token, secret)
    if text_length(expected) != 64:
        return false
    return crypto_constant_time_compare(expected, submitted_token)
