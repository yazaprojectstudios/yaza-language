# Capability-Rooted Static Asset Server over yaza_vfs_v1 (Blocks ../ traversal, NUL bytes & symlinks).
use "std/web/response"
use "std/crypto/hash"

fn static_ascii_lower(raw: Text) -> Text:
    let len: Number = text_length(raw)
    let parts: TextList = text_list()
    var i: Number = 0
    while i < len:
        let b: Number = text_byte(raw, i)
        if b >= 65 and b <= 90:
            let one: Bytes = bytes_from_text("a")
            let _ok: Boolean = bytes_try_set(one, 0, b + 32)
            list_push(parts, bytes_to_text(one))
        else:
            list_push(parts, text_slice(raw, i, 1))
        set i = i + 1
    return text_join(parts, "")

fn static_mime_for_path(filename: Text) -> Option[Text]:
    let low: Text = static_ascii_lower(filename)
    if text_ends_with(low, ".css"): return some("text/css; charset=utf-8")
    if text_ends_with(low, ".js"): return some("application/javascript; charset=utf-8")
    if text_ends_with(low, ".svg"): return some("image/svg+xml")
    if text_ends_with(low, ".png"): return some("image/png")
    if text_ends_with(low, ".jpg") or text_ends_with(low, ".jpeg"): return some("image/jpeg")
    if text_ends_with(low, ".webp"): return some("image/webp")
    if text_ends_with(low, ".gif"): return some("image/gif")
    if text_ends_with(low, ".mp4"): return some("video/mp4")
    if text_ends_with(low, ".webm"): return some("video/webm")
    if text_ends_with(low, ".mp3"): return some("audio/mpeg")
    if text_ends_with(low, ".pdf"): return some("application/pdf")
    if text_ends_with(low, ".zip"): return some("application/zip")
    if text_ends_with(low, ".woff2"): return some("font/woff2")
    if text_ends_with(low, ".ico"): return some("image/x-icon")
    if text_ends_with(low, ".txt"): return some("text/plain; charset=utf-8")
    if text_ends_with(low, ".json"): return some("application/json; charset=utf-8")
    return none

fn static_normalize_child_name(url_path: Text, mount_prefix: Text) -> Result[Text, Text]:
    if not text_starts_with(url_path, mount_prefix):
        return err("path does not match mount prefix")
    let rel: Text = text_slice(url_path, text_length(mount_prefix), text_length(url_path) - text_length(mount_prefix))
    let rlen: Number = text_length(rel)
    if rlen == 0 or rlen > 128:
        return err("invalid static asset filename length")
    if text_find(rel, "/") >= 0 or text_find(rel, "\\") >= 0 or text_find(rel, "..") >= 0:
        return err("static path traversal rejected")
    var i: Number = 0
    while i < rlen:
        let b: Number = text_byte(rel, i)
        if b < 32 or b == 127:
            return err("control byte in static filename")
        set i = i + 1
    return ok(rel)

fn static_compute_etag(data: Bytes) -> Text:
    # Full SHA-256 content digest ETag so any byte change invalidates cache reliably
    return "\"sha256-" + text_slice(crypto_bytes_to_hex(crypto_sha256(data)), 0, 32) + "\""

fn static_serve_vfs_mode(vfs_root_handle: Number, url_path: Text, mount_prefix: Text, if_none_match: Text, max_bytes: Number, allow_public_mode: Boolean) -> Result[WebResponse, Text]:
    let filename: Text = static_normalize_child_name(url_path, mount_prefix)?
    let mime_opt: Option[Text] = static_mime_for_path(filename)
    if not option_is_some(mime_opt):
        return err("disallowed static asset extension")
    let mime: Text = option_unwrap(mime_opt)
    var open_res: Result[Number, Text] = err("static asset open failed")
    if allow_public_mode:
        set open_res = vfs_open_read_public(vfs_root_handle, filename)
    else:
        set open_res = vfs_open_read(vfs_root_handle, filename)
    let file_handle: Number = open_res?
    let size_res: Result[Number, Text] = vfs_file_size(file_handle)
    if not result_is_ok(size_res):
        let _c1: Result[Boolean, Text] = vfs_close(file_handle)
        return err(result_unwrap_error(size_res))
    let size: Number = result_unwrap(size_res)
    if size < 0 or size > max_bytes:
        let _c2: Result[Boolean, Text] = vfs_close(file_handle)
        return err("static asset exceeds configured byte limit")
    var data: Bytes = bytes_empty()
    if size > 0:
        let read_res: Result[Bytes, Text] = vfs_read_exact(file_handle, 0, size)
        let _c3: Result[Boolean, Text] = vfs_close(file_handle)
        if not result_is_ok(read_res):
            return err(result_unwrap_error(read_res))
        set data = result_unwrap(read_res)
    else:
        let _c4: Result[Boolean, Text] = vfs_close(file_handle)
    let etag: Text = static_compute_etag(data)
    let cache_ctrl: Text = "public, max-age=300, must-revalidate"
    if if_none_match == etag:
        return ok(web_not_modified(etag, cache_ctrl))
    return ok(web_static_ok(mime, data, etag, cache_ctrl))

fn static_serve_vfs(vfs_root_handle: Number, url_path: Text, mount_prefix: Text, if_none_match: Text, max_bytes: Number) -> Result[WebResponse, Text]:
    return static_serve_vfs_mode(vfs_root_handle, url_path, mount_prefix, if_none_match, max_bytes, false)

fn static_serve_public_dir(public_dir: Text, url_path: Text, mount_prefix: Text, if_none_match: Text, max_bytes: Number) -> Result[WebResponse, Text]:
    # Always serve through capability-rooted yaza_vfs_v1 (O_NOFOLLOW + openat + raw Bytes):
    # immune to ../ traversal, symlinks, and UTF-8/NUL panics for both 0600 and 0644 assets.
    let root_fd: Number = vfs_root_open(public_dir)?
    let res: Result[WebResponse, Text] = static_serve_vfs_mode(root_fd, url_path, mount_prefix, if_none_match, max_bytes, true)
    let _cl: Result[Boolean, Text] = vfs_close(root_fd)
    return res
