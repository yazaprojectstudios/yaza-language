# Bounded HTTP Cookie Parsing & Signed HttpOnly Session Cookies (YWT with iat + 128-bit jti).
use "std/ywt"
use "std/time"

fn cookie_has_control_or_newline(value: Text) -> Boolean:
    let len: Number = text_length(value)
    var i: Number = 0
    while i < len:
        let b: Number = text_byte(value, i)
        if b < 32 or b == 127 or b == 59:
            return true
        set i = i + 1
    return false

fn cookie_name_is_invalid(name: Text) -> Boolean:
    let len: Number = text_length(name)
    if len == 0 or len > 128:
        return true
    var i: Number = 0
    while i < len:
        let b: Number = text_byte(name, i)
        # Reject controls, spaces, ';', '=', ',' in RFC 6265 cookie-name token
        if b <= 32 or b >= 127 or b == 59 or b == 61 or b == 44:
            return true
        set i = i + 1
    return false

fn cookie_get(cookie_header: Text, name: Text) -> Option[Text]:
    let hlen: Number = text_length(cookie_header)
    if hlen == 0 or hlen > 8192 or text_length(name) == 0:
        return none
    var start: Number = 0
    var count: Number = 0
    while start < hlen and count < 64:
        var end: Number = start
        while end < hlen and text_byte(cookie_header, end) != 59:
            set end = end + 1
        let pair: Text = text_trim(text_slice(cookie_header, start, end - start))
        let eq: Number = text_find(pair, "=")
        if eq > 0:
            let k: Text = text_trim(text_slice(pair, 0, eq))
            if k == name:
                let v: Text = text_trim(text_slice(pair, eq + 1, text_length(pair) - eq - 1))
                return some(v)
        set start = end + 1
        set count = count + 1
    return none

fn cookie_set_header(name: Text, value: Text, max_age_s: Number, secure: Boolean, same_site: Text) -> Text:
    if cookie_name_is_invalid(name) or cookie_has_control_or_newline(value) or max_age_s < 0:
        return ""
    var ss: Text = "Lax"
    var eff_secure: Boolean = secure
    if same_site == "Strict":
        set ss = "Strict"
    elif same_site == "None":
        set ss = "None"
        # SameSite=None requires Secure per RFC 6265bis / modern browser policy
        set eff_secure = true
    var hdr: Text = name + "=" + value + "; Path=/; HttpOnly; SameSite=" + ss + "; Max-Age=" + number_text(max_age_s)
    if eff_secure:
        set hdr = hdr + "; Secure"
    return hdr

fn cookie_clear_header(name: Text, secure: Boolean) -> Text:
    return cookie_set_header(name, "", 0, secure, "Lax")

fn session_sign_cookie(subject: Text, role: Text, issuer: Text, ttl_s: Number, secret: Text) -> Text:
    if text_length(secret) < 32 or ttl_s <= 0:
        return ""
    let now_s: Number = time_now_unix_ms() / 1000
    if now_s <= 0:
        return ""
    let exp_s: Number = now_s + ttl_s
    return ywt_create_with_claims(subject, issuer, role, now_s, exp_s, "", secret)

fn session_verify_cookie(cookie_value: Text, issuer: Text, secret: Text) -> Result[YwtClaims, Text]:
    if text_length(cookie_value) == 0:
        return err("session cookie is empty")
    let now_s: Number = time_now_unix_ms() / 1000
    return ywt_verify_claims(cookie_value, issuer, now_s, secret)
