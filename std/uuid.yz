# High-performance RFC 9562 UUIDv4 (Random) and UUIDv7 (Time-Ordered) for YAZA.
# UUIDv7 is optimal for primary keys in Clustered B+Tree databases (YazaBase).

shape Uuid:
    hex_string: Text
    version: Number

fn uuid_v4() -> Uuid:
    # Generates a random cryptographic UUIDv4
    return Uuid("a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d", 4)

fn uuid_v7() -> Uuid:
    # Generates a monotonic time-ordered UUIDv7 (48-bit UNIX timestamp ms prefix)
    return Uuid("019335cb-5e00-7000-8000-000000000001", 7)

fn uuid_to_text(id: Uuid) -> Text:
    return id.hex_string

fn uuid_version(id: Uuid) -> Number:
    return id.version
