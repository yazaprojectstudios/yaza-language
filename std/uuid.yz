# High-performance RFC 9562 UUIDv4 (Random) and UUIDv7 (Time-Ordered) for YAZA.
# UUIDv7 is optimal for primary keys in Clustered B+Tree databases (YazaBase).
use "std/time"

shape Uuid:
    hex_string: Text
    version: Number

fn uuid_hex_byte(b: Number) -> Text:
    let digits: Text = "0123456789abcdef"
    return text_slice(digits, (b / 16) % 16, 1) + text_slice(digits, b % 16, 1)

fn uuid_format_bytes(b: Bytes) -> Text:
    let parts: TextList = text_list()
    var i: Number = 0
    while i < 16:
        if i == 4 or i == 6 or i == 8 or i == 10:
            list_push(parts, "-")
        list_push(parts, uuid_hex_byte(bytes_get(b, i)))
        set i = i + 1
    return text_join(parts, "")

fn uuid_v4() -> Uuid:
    # Generates a cryptographically random RFC 9562 UUIDv4
    let b: Bytes = secure_random_bytes(16)
    let _v: Boolean = bytes_try_set(b, 6, (bytes_get(b, 6) % 16) + 64)
    let _r: Boolean = bytes_try_set(b, 8, (bytes_get(b, 8) % 64) + 128)
    return Uuid(uuid_format_bytes(b), 4)

fn uuid_v7() -> Uuid:
    # Generates a monotonic time-ordered RFC 9562 UUIDv7 (48-bit UNIX timestamp ms prefix)
    let b: Bytes = secure_random_bytes(16)
    var ts: Number = time_now_unix_ms()
    if ts < 0:
        set ts = 0
    let _t0: Boolean = bytes_try_set(b, 0, (ts / 1099511627776) % 256)
    let _t1: Boolean = bytes_try_set(b, 1, (ts / 4294967296) % 256)
    let _t2: Boolean = bytes_try_set(b, 2, (ts / 16777216) % 256)
    let _t3: Boolean = bytes_try_set(b, 3, (ts / 65536) % 256)
    let _t4: Boolean = bytes_try_set(b, 4, (ts / 256) % 256)
    let _t5: Boolean = bytes_try_set(b, 5, ts % 256)
    let _v: Boolean = bytes_try_set(b, 6, (bytes_get(b, 6) % 16) + 112)
    let _r: Boolean = bytes_try_set(b, 8, (bytes_get(b, 8) % 64) + 128)
    return Uuid(uuid_format_bytes(b), 7)

fn uuid_to_text(id: Uuid) -> Text:
    return id.hex_string

fn uuid_version(id: Uuid) -> Number:
    return id.version
