# Modern Test Harness, Assertions, and Micro-Benchmark framework for YAZA.

shape TestResult:
    test_name: Text
    passed: Boolean
    failure_message: Text

fn assert_true(condition: Boolean, message: Text) -> Result[Boolean, Text]:
    if not condition:
        return err("Assertion failed (expected true): " + message)
    return ok(true)

fn assert_false(condition: Boolean, message: Text) -> Result[Boolean, Text]:
    if condition:
        return err("Assertion failed (expected false): " + message)
    return ok(true)

fn assert_eq_number(actual: Number, expected: Number, message: Text) -> Result[Boolean, Text]:
    if actual != expected:
        return err("Assertion failed (" + message + "): expected " + number_text(expected) + ", got " + number_text(actual))
    return ok(true)

fn assert_eq_text(actual: Text, expected: Text, message: Text) -> Result[Boolean, Text]:
    if actual != expected:
        return err("Assertion failed (" + message + "): expected '" + expected + "', got '" + actual + "'")
    return ok(true)

fn test_create_pass(name: Text) -> TestResult:
    return TestResult(name, true, "")

fn test_create_fail(name: Text, reason: Text) -> TestResult:
    return TestResult(name, false, reason)
