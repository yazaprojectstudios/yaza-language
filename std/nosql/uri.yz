# NoSQL connection URI parser for Key-Value (Redis) and Document (MongoDB) databases.

shape RedisConnectionConfig:
    host: Text
    port: Number
    password: Option[Text]
    database_index: Number

shape MongoConnectionConfig:
    host: Text
    port: Number
    user: Option[Text]
    password: Option[Text]
    database: Option[Text]

fn nosql_uri_find_from(value: Text, start: Number, needle: Text) -> Number:
    if start < 0 or start >= text_length(value): return -1
    let suffix: Text = text_slice(value, start, text_length(value) - start)
    let found: Number = text_find(suffix, needle)
    if found < 0: return -1
    return start + found

fn redis_parse_uri(uri: Text) -> Result[RedisConnectionConfig, Text]:
    if not text_starts_with(uri, "redis://"):
        return err("Redis URI must begin with redis://")
    var cursor: Number = 8
    let total_len: Number = text_length(uri)
    var pass_opt: Option[Text] = none
    let at_pos: Number = nosql_uri_find_from(uri, cursor, "@")
    if at_pos >= 0:
        let userinfo: Text = text_slice(uri, cursor, at_pos - cursor)
        set cursor = at_pos + 1
        let colon_pos: Number = text_find(userinfo, ":")
        if colon_pos >= 0:
            let p_raw: Text = text_slice(userinfo, colon_pos + 1, text_length(userinfo) - colon_pos - 1)
            set pass_opt = some(p_raw)
        else:
            set pass_opt = some(userinfo)

    var host_and_port: Text = ""
    var db_idx: Number = 0
    let slash_pos: Number = nosql_uri_find_from(uri, cursor, "/")
    if slash_pos >= 0:
        set host_and_port = text_slice(uri, cursor, slash_pos - cursor)
        let db_str: Text = text_slice(uri, slash_pos + 1, total_len - slash_pos - 1)
        if text_length(db_str) > 0:
            let parsed_db: Result[Number, Text] = number_try_parse(db_str)
            if result_is_ok(parsed_db): set db_idx = result_unwrap(parsed_db)
    else:
        set host_and_port = text_slice(uri, cursor, total_len - cursor)

    var host: Text = "127.0.0.1"
    var port: Number = 6379
    if text_length(host_and_port) > 0:
        let colon_idx: Number = text_find(host_and_port, ":")
        if colon_idx >= 0:
            set host = text_slice(host_and_port, 0, colon_idx)
            let p_raw: Text = text_slice(host_and_port, colon_idx + 1, text_length(host_and_port) - colon_idx - 1)
            let p_parsed: Result[Number, Text] = number_try_parse(p_raw)
            if result_is_ok(p_parsed): set port = result_unwrap(p_parsed)
        else:
            set host = host_and_port
    return ok(RedisConnectionConfig(host, port, pass_opt, db_idx))

fn mongo_parse_uri(uri: Text) -> Result[MongoConnectionConfig, Text]:
    if not text_starts_with(uri, "mongodb://"):
        return err("MongoDB URI must begin with mongodb://")
    var cursor: Number = 10
    let total_len: Number = text_length(uri)
    var user_opt: Option[Text] = none
    var pass_opt: Option[Text] = none
    let at_pos: Number = nosql_uri_find_from(uri, cursor, "@")
    if at_pos >= 0:
        let userinfo: Text = text_slice(uri, cursor, at_pos - cursor)
        set cursor = at_pos + 1
        let colon_pos: Number = text_find(userinfo, ":")
        if colon_pos >= 0:
            set user_opt = some(text_slice(userinfo, 0, colon_pos))
            set pass_opt = some(text_slice(userinfo, colon_pos + 1, text_length(userinfo) - colon_pos - 1))
        else:
            set user_opt = some(userinfo)

    var host_and_port: Text = ""
    var db_opt: Option[Text] = none
    let slash_pos: Number = nosql_uri_find_from(uri, cursor, "/")
    let qmark_pos: Number = nosql_uri_find_from(uri, cursor, "?")
    if slash_pos >= 0:
        set host_and_port = text_slice(uri, cursor, slash_pos - cursor)
        set cursor = slash_pos + 1
        let q_pos2: Number = nosql_uri_find_from(uri, cursor, "?")
        if q_pos2 >= 0:
            let db_raw: Text = text_slice(uri, cursor, q_pos2 - cursor)
            if text_length(db_raw) > 0: set db_opt = some(db_raw)
        else:
            let db_raw: Text = text_slice(uri, cursor, total_len - cursor)
            if text_length(db_raw) > 0: set db_opt = some(db_raw)
    else:
        if qmark_pos >= 0:
            set host_and_port = text_slice(uri, cursor, qmark_pos - cursor)
        else:
            set host_and_port = text_slice(uri, cursor, total_len - cursor)

    var host: Text = "127.0.0.1"
    var port: Number = 27017
    if text_length(host_and_port) > 0:
        let colon_idx: Number = text_find(host_and_port, ":")
        if colon_idx >= 0:
            set host = text_slice(host_and_port, 0, colon_idx)
            let p_raw: Text = text_slice(host_and_port, colon_idx + 1, text_length(host_and_port) - colon_idx - 1)
            let p_parsed: Result[Number, Text] = number_try_parse(p_raw)
            if result_is_ok(p_parsed): set port = result_unwrap(p_parsed)
        else:
            set host = host_and_port
    return ok(MongoConnectionConfig(host, port, user_opt, pass_opt, db_opt))
