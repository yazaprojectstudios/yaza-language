# Capability-rooted, synchronous filesystem operations for YazaBase.
# Handles are process-local Number tokens. Child names are single path components.
# list_names returns immediate child entry names as bounded NUL-separated bytes.

fn root_open(path: Text) -> Result[Number, Text]:
    return vfs_root_open(path)

fn open_read(root: Number, name: Text) -> Result[Number, Text]:
    return vfs_open_read(root, name)

fn open_rw(root: Number, name: Text) -> Result[Number, Text]:
    return vfs_open_rw(root, name)

fn create_exclusive(root: Number, name: Text) -> Result[Number, Text]:
    return vfs_create_exclusive(root, name)

fn list_names(root: Number) -> Result[Bytes, Text]:
    return vfs_list_names(root)

fn lock_exclusive(root: Number, name: Text) -> Result[Number, Text]:
    return vfs_lock_exclusive(root, name)

fn file_size(file: Number) -> Result[Number, Text]:
    return vfs_file_size(file)

fn read_exact(file: Number, offset: Number, length: Number) -> Result[Bytes, Text]:
    return vfs_read_exact(file, offset, length)

fn write_exact(file: Number, offset: Number, bytes: Bytes) -> Result[Number, Text]:
    return vfs_write_exact(file, offset, bytes)

fn truncate(file: Number, size: Number) -> Result[Boolean, Text]:
    return vfs_truncate(file, size)

fn preallocate(file: Number, minimum_size: Number) -> Result[Boolean, Text]:
    return vfs_preallocate(file, minimum_size)

fn sync(handle: Number) -> Result[Boolean, Text]:
    return vfs_sync(handle)

fn sync_directory(root: Number) -> Result[Boolean, Text]:
    return vfs_sync_directory(root)

fn remove(root: Number, name: Text) -> Result[Boolean, Text]:
    return vfs_remove(root, name)

fn rename(root: Number, old_name: Text, new_name: Text) -> Result[Boolean, Text]:
    return vfs_rename(root, old_name, new_name)

fn close(handle: Number) -> Result[Boolean, Text]:
    return vfs_close(handle)
