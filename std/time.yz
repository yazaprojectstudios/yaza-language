# High-precision time, monotonic clocks, duration calculations, and ISO-8601 formatting for YAZA.

shape Duration:
    nanoseconds: Number

shape DateTime:
    year: Number
    month: Number
    day: Number
    hour: Number
    minute: Number
    second: Number
    nanosecond: Number
    utc_offset: Number

fn time_now_monotonic_ns() -> Number:
    # High-resolution monotonic clock (unaffected by NTP wall-clock adjustments)
    return monotonic_ns()

fn time_now_monotonic_ms() -> Number:
    # Monotonic clock in milliseconds (unaffected by NTP wall-clock adjustments)
    return monotonic_ms()

fn time_now_unix_ms() -> Number:
    # Milliseconds since UNIX epoch (1970-01-01 00:00:00 UTC) via CLOCK_REALTIME
    return unix_ms()

fn duration_from_millis(ms: Number) -> Duration:
    return Duration(ms * 1000000)

fn duration_from_seconds(secs: Number) -> Duration:
    return Duration(secs * 1000000000)

fn duration_to_millis(d: Duration) -> Number:
    return d.nanoseconds / 1000000

fn duration_to_seconds(d: Duration) -> Number:
    return d.nanoseconds / 1000000000

fn time_create_datetime(year: Number, month: Number, day: Number, hour: Number, min: Number, sec: Number) -> DateTime:
    return DateTime(year, month, day, hour, min, sec, 0, 0)

fn time_pad2(n: Number) -> Text:
    if n < 0: return "00"
    if n < 10: return "0" + number_text(n)
    return number_text(n)

fn time_pad4(n: Number) -> Text:
    if n < 0: return "0000"
    if n < 10: return "000" + number_text(n)
    if n < 100: return "00" + number_text(n)
    if n < 1000: return "0" + number_text(n)
    return number_text(n)

fn time_format_iso8601(dt: DateTime) -> Text:
    # Formats to standard ISO-8601 string: YYYY-MM-DDTHH:MM:SSZ or ±HH:MM
    let base: Text = time_pad4(dt.year) + "-" + time_pad2(dt.month) + "-" + time_pad2(dt.day) + "T" + time_pad2(dt.hour) + ":" + time_pad2(dt.minute) + ":" + time_pad2(dt.second)
    if dt.utc_offset == 0:
        return base + "Z"
    var sign: Text = "+"
    var off_mins: Number = dt.utc_offset / 60
    if off_mins < 0:
        set sign = "-"
        set off_mins = 0 - off_mins
    return base + sign + time_pad2(off_mins / 60) + ":" + time_pad2(off_mins % 60)
