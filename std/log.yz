# Structured JSON Logger for Cloud-Native APIs & Microservices.
# Uses real wall-clock Unix timestamps (std/time) and JSON escaping (std/json).

use "std/time"
use "std/json"

shape Logger:
    level: Text    # "TRACE", "DEBUG", "INFO", "WARN", "ERROR"
    service_name: Text

fn logger_create(service_name: Text, level: Text) -> Logger:
    return Logger(level, service_name)

fn log_emit(logger: Logger, level: Text, message: Text, extra_key: Text, extra_val: Text) -> Boolean:
    let ts: Number = time_now_unix_ms()
    var line: Text = "{\"timestamp_ms\":" + number_text(ts)
    set line = line + ",\"level\":\"" + json_escape_text(level) + "\""
    set line = line + ",\"service\":\"" + json_escape_text(logger.service_name) + "\""
    set line = line + ",\"message\":\"" + json_escape_text(message) + "\""
    if extra_key != "":
        set line = line + ",\"" + json_escape_text(extra_key) + "\":" + extra_val
    set line = line + "}"
    say line
    return true

fn log_info(logger: Logger, message: Text, fields_json: Text) -> Boolean:
    return log_emit(logger, "INFO", message, "data", fields_json)

fn log_warn(logger: Logger, message: Text, fields_json: Text) -> Boolean:
    return log_emit(logger, "WARN", message, "data", fields_json)

fn log_error(logger: Logger, message: Text, error_details: Text) -> Boolean:
    return log_emit(logger, "ERROR", message, "error", json_string(error_details))
