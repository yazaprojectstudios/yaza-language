# Bounded process-local PostgreSQL connection pool primitives.
# Applications pass a SHA-256 identity digest, never a raw connection URI.
# Checkout returns an existing positive connection handle, or a negative
# reservation token when the caller must open and attach a new connection.

fn pg_pool_checkout(identity: Bytes, maximum: Number, acquire_timeout_ms: Number, idle_timeout_ms: Number) -> Result[Number, Text]:
    return pg_pool_checkout_native(identity, maximum, acquire_timeout_ms, idle_timeout_ms)

fn pg_pool_checkout_environment(identity: Bytes) -> Result[Number, Text]:
    return pg_pool_checkout_environment_native(identity)

fn pg_pool_environment_identity() -> Bytes:
    return pg_pool_environment_identity_native()

fn pg_pool_attach(reservation_token: Number, connection: Number) -> Boolean:
    return pg_pool_attach_native(reservation_token, connection)

fn pg_pool_needs_ping(connection: Number, interval_ms: Number) -> Boolean:
    return pg_pool_needs_ping_native(connection, interval_ms)

# A closed socket is discarded even when the caller marks it healthy.
# Register this defer before pg_scope_cleanup so LIFO cleanup runs the
# transaction guard before the pool inspects the connection handle.
fn pg_pool_release(connection_or_reservation: Number, healthy: Boolean) -> Boolean:
    return pg_pool_release_native(connection_or_reservation, healthy)

fn pg_pool_stats(identity: Bytes) -> Text:
    return pg_pool_stats_native(identity)
