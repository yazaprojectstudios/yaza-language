# Safe PostgreSQL error classification for application-level mapping.
# Server messages remain internal; only validated SQLSTATE values are exposed.
use "protocol"

variant PgErrorKind:
    UniqueConstraint
    Constraint
    QueryTimeout
    ConnectionFailure
    TransactionConflict
    ServerFailure
    Unclassified

fn pg_server_error_internal_text(error: PgServerError) -> Text:
    if not pg_valid_sqlstate(error.sqlstate):
        return "postgres server error: invalid SQLSTATE"
    return "postgres server error: " + error.sqlstate + ": " + error.message

fn pg_error_sqlstate(message: Text) -> Option[Text]:
    let prefix: Text = "postgres server error: "
    if not text_starts_with(message, prefix):
        return none
    let code_start: Number = text_length(prefix)
    let separator: Number = code_start + 5
    if text_length(message) <= separator or text_byte(message, separator) != 58:
        return none
    let sqlstate: Text = text_slice(message, code_start, 5)
    if not pg_valid_sqlstate(sqlstate):
        return none
    return some(sqlstate)

fn pg_error_classify(message: Text) -> PgErrorKind:
    let sqlstate: Option[Text] = pg_error_sqlstate(message)
    if not option_is_some(sqlstate):
        return PgErrorKind::Unclassified
    let code: Text = option_unwrap(sqlstate)
    if code == "23505":
        return PgErrorKind::UniqueConstraint
    if text_starts_with(code, "23"):
        return PgErrorKind::Constraint
    if code == "57014":
        return PgErrorKind::QueryTimeout
    if code == "40001" or code == "40P01":
        return PgErrorKind::TransactionConflict
    if text_starts_with(code, "08"):
        return PgErrorKind::ConnectionFailure
    return PgErrorKind::ServerFailure

fn pg_error_kind_name(kind: PgErrorKind) -> Text:
    match kind:
        UniqueConstraint:
            return "unique_constraint"
        Constraint:
            return "constraint"
        QueryTimeout:
            return "query_timeout"
        ConnectionFailure:
            return "connection_failure"
        TransactionConflict:
            return "transaction_conflict"
        ServerFailure:
            return "server_failure"
        Unclassified:
            return "unclassified"
    return "unclassified"
