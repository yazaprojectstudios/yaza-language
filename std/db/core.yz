fn db_decimal_text_valid(value: Text) -> Boolean:
    # Keep exact decimal values bounded and finite. Scientific notation stays
    # textual, so validation never rounds through Float64.
    let byte_length: Number = bytes_length(bytes_from_text(value))
    if byte_length < 1 or byte_length > 147456 or text_length(value) != byte_length:
        return false
    var index: Number = 0
    if text_byte(value, index) == 43 or text_byte(value, index) == 45:
        set index = index + 1
    var integer_digits: Number = 0
    while index < byte_length and text_byte(value, index) >= 48 and text_byte(value, index) <= 57:
        set integer_digits = integer_digits + 1
        set index = index + 1
    var fraction_digits: Number = 0
    if index < byte_length and text_byte(value, index) == 46:
        set index = index + 1
        while index < byte_length and text_byte(value, index) >= 48 and text_byte(value, index) <= 57:
            set fraction_digits = fraction_digits + 1
            set index = index + 1
    if integer_digits == 0 and fraction_digits == 0:
        return false
    if index < byte_length and (text_byte(value, index) == 69 or text_byte(value, index) == 101):
        set index = index + 1
        var exponent_sign: Number = 1
        if index < byte_length and text_byte(value, index) == 45:
            set exponent_sign = -1
            set index = index + 1
        else:
            if index < byte_length and text_byte(value, index) == 43:
                set index = index + 1
        var exponent: Number = 0
        var exponent_digits: Number = 0
        while index < byte_length and text_byte(value, index) >= 48 and text_byte(value, index) <= 57:
            if exponent > 131072:
                return false
            set exponent = exponent * 10 + text_byte(value, index) - 48
            if exponent > 131072:
                return false
            set exponent_digits = exponent_digits + 1
            set index = index + 1
        if exponent_digits == 0:
            return false
        if exponent_sign < 0 and exponent > 16383:
            return false
    return index == byte_length

fn db_temporal_text_ascii(value: Text, minimum_bytes: Number, maximum_bytes: Number) -> Boolean:
    let byte_length: Number = bytes_length(bytes_from_text(value))
    if byte_length < minimum_bytes or byte_length > maximum_bytes:
        return false
    return text_length(value) == byte_length

fn db_temporal_two_digits(value: Text, index: Number) -> Number:
    let length: Number = text_length(value)
    if index < 0 or index + 1 >= length:
        return -1
    let first: Number = text_byte(value, index)
    let second: Number = text_byte(value, index + 1)
    if first < 48 or first > 57 or second < 48 or second > 57:
        return -1
    return (first - 48) * 10 + second - 48

fn db_date_text_valid(value: Text) -> Boolean:
    if not db_temporal_text_ascii(value, 10, 10):
        return false
    if text_byte(value, 4) != 45 or text_byte(value, 7) != 45:
        return false
    var year: Number = 0
    var index: Number = 0
    while index < 4:
        let digit: Number = text_byte(value, index)
        if digit < 48 or digit > 57:
            return false
        set year = year * 10 + digit - 48
        set index = index + 1
    let month: Number = db_temporal_two_digits(value, 5)
    let day: Number = db_temporal_two_digits(value, 8)
    if year < 1 or month < 1 or month > 12 or day < 1:
        return false
    var days_in_month: Number = 31
    if month == 4 or month == 6 or month == 9 or month == 11:
        set days_in_month = 30
    else:
        if month == 2:
            set days_in_month = 28
            if year % 400 == 0 or (year % 4 == 0 and year % 100 != 0):
                set days_in_month = 29
    return day <= days_in_month

fn db_time_components_valid(value: Text, start: Number, end: Number) -> Boolean:
    if start < 0 or end > text_length(value) or end - start < 8:
        return false
    if text_byte(value, start + 2) != 58 or text_byte(value, start + 5) != 58:
        return false
    let hours: Number = db_temporal_two_digits(value, start)
    let minutes: Number = db_temporal_two_digits(value, start + 3)
    let seconds: Number = db_temporal_two_digits(value, start + 6)
    if hours < 0 or hours > 24 or minutes < 0 or minutes > 59 or seconds < 0 or seconds > 59:
        return false
    if hours == 24 and (minutes != 0 or seconds != 0):
        return false
    if end - start == 8:
        return true
    if text_byte(value, start + 8) != 46:
        return false
    let fraction_start: Number = start + 9
    let fraction_count: Number = end - fraction_start
    if fraction_count < 1 or fraction_count > 6:
        return false
    var index: Number = fraction_start
    while index < end:
        let digit: Number = text_byte(value, index)
        if digit < 48 or digit > 57:
            return false
        if hours == 24 and digit != 48:
            return false
        set index = index + 1
    return true

fn db_timezone_offset_valid(value: Text, start: Number, end: Number) -> Boolean:
    if start < 0 or start + 3 > end or end > text_length(value):
        return false
    if text_byte(value, start) != 43 and text_byte(value, start) != 45:
        return false
    let hours: Number = db_temporal_two_digits(value, start + 1)
    if hours < 0 or hours > 15:
        return false
    let offset_length: Number = end - start
    if offset_length == 3:
        return true
    if offset_length != 6 and offset_length != 9:
        return false
    if text_byte(value, start + 3) != 58:
        return false
    let minutes: Number = db_temporal_two_digits(value, start + 4)
    if minutes < 0 or minutes > 59:
        return false
    if offset_length == 6:
        return true
    if text_byte(value, start + 6) != 58:
        return false
    let seconds: Number = db_temporal_two_digits(value, start + 7)
    return seconds >= 0 and seconds <= 59

fn db_time_text_valid(value: Text) -> Boolean:
    if not db_temporal_text_ascii(value, 8, 15):
        return false
    return db_time_components_valid(value, 0, text_length(value))

fn db_time_tz_text_valid(value: Text) -> Boolean:
    if not db_temporal_text_ascii(value, 11, 24):
        return false
    var offset_start: Number = -1
    var index: Number = 8
    while index < text_length(value):
        if text_byte(value, index) == 43 or text_byte(value, index) == 45:
            set offset_start = index
            set index = text_length(value)
        else:
            set index = index + 1
    if offset_start < 0:
        return false
    if not db_time_components_valid(value, 0, offset_start):
        return false
    return db_timezone_offset_valid(value, offset_start, text_length(value))

fn db_timestamp_base_valid(value: Text, time_end: Number) -> Boolean:
    if time_end < 19 or time_end > 26:
        return false
    if not db_date_text_valid(text_slice(value, 0, 10)) or text_byte(value, 10) != 32:
        return false
    return db_time_components_valid(value, 11, time_end)

fn db_timestamp_text_valid(value: Text) -> Boolean:
    if not db_temporal_text_ascii(value, 19, 26):
        return false
    return db_timestamp_base_valid(value, text_length(value))

fn db_timestamp_tz_text_valid(value: Text) -> Boolean:
    if not db_temporal_text_ascii(value, 22, 35):
        return false
    var offset_start: Number = -1
    var index: Number = 19
    while index < text_length(value):
        if text_byte(value, index) == 43 or text_byte(value, index) == 45:
            set offset_start = index
            set index = text_length(value)
        else:
            set index = index + 1
    if offset_start < 0 or not db_timestamp_base_valid(value, offset_start):
        return false
    return db_timezone_offset_valid(value, offset_start, text_length(value))

fn db_value_is_valid(value: DbValue) -> Boolean:
    match value:
        DecimalValue(inner):
            return db_decimal_text_valid(inner)
        DateValue(inner):
            return db_date_text_valid(inner)
        TimeValue(inner):
            return db_time_text_valid(inner)
        TimeTzValue(inner):
            return db_time_tz_text_valid(inner)
        TimestampValue(inner):
            return db_timestamp_text_valid(inner)
        TimestampTzValue(inner):
            return db_timestamp_tz_text_valid(inner)
        JsonValue(inner):
            return json_is_valid(inner)
        JsonbValue(inner):
            return json_is_valid(inner)
        Null:
            return true
        BooleanValue(_):
            return true
        Int32Value(_):
            return true
        Int64Value(_):
            return true
        Float64Value(_):
            return true
        TextValue(_):
            return true
        BytesValue(_):
            return true
    return false

fn db_value_as_decimal(value: DbValue) -> Option[Text]:
    match value:
        DecimalValue(inner):
            if db_decimal_text_valid(inner):
                return some(inner)
            return none
        Null:
            return none
        BooleanValue(_):
            return none
        Int32Value(_):
            return none
        Int64Value(_):
            return none
        Float64Value(_):
            return none
        DateValue(_):
            return none
        TimeValue(_):
            return none
        TimeTzValue(_):
            return none
        TimestampValue(_):
            return none
        TimestampTzValue(_):
            return none
        JsonValue(_):
            return none
        JsonbValue(_):
            return none
        TextValue(_):
            return none
        BytesValue(_):
            return none
    return none

fn db_value_as_temporal_text(value: DbValue) -> Option[Text]:
    match value:
        DateValue(inner):
            if db_date_text_valid(inner):
                return some(inner)
            return none
        TimeValue(inner):
            if db_time_text_valid(inner):
                return some(inner)
            return none
        TimeTzValue(inner):
            if db_time_tz_text_valid(inner):
                return some(inner)
            return none
        TimestampValue(inner):
            if db_timestamp_text_valid(inner):
                return some(inner)
            return none
        TimestampTzValue(inner):
            if db_timestamp_tz_text_valid(inner):
                return some(inner)
            return none
        Null:
            return none
        BooleanValue(_):
            return none
        Int32Value(_):
            return none
        Int64Value(_):
            return none
        Float64Value(_):
            return none
        DecimalValue(_):
            return none
        JsonValue(_):
            return none
        JsonbValue(_):
            return none
        TextValue(_):
            return none
        BytesValue(_):
            return none
    return none

