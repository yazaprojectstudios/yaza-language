# Provider-neutral database vocabulary.
# This module defines shared names and safety helpers, not database drivers.

variant DbProvider:
    PostgreSQL
    SQLite
    MySQL
    MariaDB
    SQLServer
    Redis
    Oracle
    MongoDB

variant DbDriverReadiness:
    ProtocolFoundation
    NotImplemented

variant DbErrorKind:
    Configuration
    Connection
    Authentication
    TLS
    Timeout
    Cancelled
    Unavailable
    Protocol
    Constraint
    Serialization
    UnsupportedFeature
    Internal

variant DbValueKind:
    Null
    Boolean
    Int32
    Int64
    Float64
    Decimal
    Date
    Time
    TimeTz
    Timestamp
    TimestampTz
    Json
    Jsonb
    Text
    Bytes

# SQL NULL is represented by its own case, never by an empty Text or zero value.
# Decimal is an exact, bounded base-10 text value; it does not imply decimal arithmetic.
# Temporal database values retain validated textual forms; no timezone database
# or calendar arithmetic is implied.
# JSON and JSONB retain validated JSON source text and remain distinct SQL kinds.
variant DbValue:
    Null
    BooleanValue(value: Boolean)
    Int32Value(value: Int32)
    Int64Value(value: Number)
    Float64Value(value: Float64)
    DecimalValue(value: Text)
    DateValue(value: Text)
    TimeValue(value: Text)
    TimeTzValue(value: Text)
    TimestampValue(value: Text)
    TimestampTzValue(value: Text)
    JsonValue(value: Text)
    JsonbValue(value: Text)
    TextValue(value: Text)
    BytesValue(value: Bytes)

fn json_is_valid(value: Text) -> Boolean:
    let length: Number = text_length(value)
    if length == 0 or length > 65536:
        return false
    let trimmed: Text = text_trim(value)
    let tlen: Number = text_length(trimmed)
    if tlen == 0:
        return false
    let first: Number = text_byte(trimmed, 0)
    let last: Number = text_byte(trimmed, tlen - 1)
    if first == 123 and last == 125:
        return true
    if first == 91 and last == 93:
        return true
    if first == 34 and last == 34 and tlen >= 2:
        return true
    if trimmed == "true" or trimmed == "false" or trimmed == "null":
        return true
    let parsed: Result[Number, Text] = number_try_parse(trimmed)
    if result_is_ok(parsed):
        return true
    let fparsed: Result[Float64, Text] = float64_try_parse(trimmed)
    if result_is_ok(fparsed):
        return true
    return false

shape DbCapabilities:
    transactions: Boolean
    savepoints: Boolean
    prepared_statements: Boolean
    streaming_results: Boolean
    returning_rows: Boolean
    batch_execution: Boolean
    isolation_read_committed: Boolean
    isolation_repeatable_read: Boolean
    isolation_serializable: Boolean

shape DbError:
    kind: DbErrorKind
    message: Text
    provider_code: Option[Text]
    retryable: Boolean

# Provider-neutral result metadata. Duplicate names are preserved because they
# are valid in SQL projections; name lookup reports ambiguity instead of
# silently selecting one of them.
shape DbColumn:
    name: Text
    value: DbValue

shape DbRow:
    columns: List[DbColumn]

variant DbColumnLookup:
    ColumnMissing
    ColumnFound(value: DbValue)
    ColumnAmbiguous

fn db_provider_name(provider: DbProvider) -> Text:
    match provider:
        PostgreSQL:
            return "postgresql"
        SQLite:
            return "sqlite"
        MySQL:
            return "mysql"
        MariaDB:
            return "mariadb"
        SQLServer:
            return "sqlserver"
        Redis:
            return "redis"
        Oracle:
            return "oracle"
        MongoDB:
            return "mongodb"
    return "unknown"

fn db_driver_readiness(provider: DbProvider) -> DbDriverReadiness:
    match provider:
        PostgreSQL:
            return DbDriverReadiness::ProtocolFoundation
        SQLite:
            return DbDriverReadiness::NotImplemented
        MySQL:
            return DbDriverReadiness::ProtocolFoundation
        MariaDB:
            return DbDriverReadiness::NotImplemented
        SQLServer:
            return DbDriverReadiness::ProtocolFoundation
        Redis:
            return DbDriverReadiness::ProtocolFoundation
        Oracle:
            return DbDriverReadiness::NotImplemented
        MongoDB:
            return DbDriverReadiness::ProtocolFoundation
    return DbDriverReadiness::NotImplemented

fn db_empty_capabilities() -> DbCapabilities:
    return DbCapabilities(false, false, false, false, false, false, false, false, false)

fn db_capabilities_valid(capabilities: DbCapabilities) -> Boolean:
    if capabilities.savepoints and not capabilities.transactions:
        return false
    if (capabilities.isolation_read_committed or capabilities.isolation_repeatable_read or capabilities.isolation_serializable) and not capabilities.transactions:
        return false
    return true

# These are features exposed by the currently implemented client surface, not a
# claim that every server-supported SQL feature is available through this API.
fn db_provider_capabilities(provider: DbProvider) -> DbCapabilities:
    match provider:
        PostgreSQL:
            return DbCapabilities(true, true, true, false, true, false, false, false, false)
        SQLite:
            return db_empty_capabilities()
        MySQL:
            return DbCapabilities(true, true, true, false, false, false, false, false, false)
        MariaDB:
            return db_empty_capabilities()
        SQLServer:
            return DbCapabilities(true, true, true, false, false, false, false, false, false)
        Redis:
            return db_empty_capabilities()
        Oracle:
            return db_empty_capabilities()
        MongoDB:
            return db_empty_capabilities()
    return db_empty_capabilities()

fn db_value_kind(value: DbValue) -> DbValueKind:
    match value:
        Null:
            return DbValueKind::Null
        BooleanValue(_):
            return DbValueKind::Boolean
        Int32Value(_):
            return DbValueKind::Int32
        Int64Value(_):
            return DbValueKind::Int64
        Float64Value(_):
            return DbValueKind::Float64
        DecimalValue(_):
            return DbValueKind::Decimal
        DateValue(_):
            return DbValueKind::Date
        TimeValue(_):
            return DbValueKind::Time
        TimeTzValue(_):
            return DbValueKind::TimeTz
        TimestampValue(_):
            return DbValueKind::Timestamp
        TimestampTzValue(_):
            return DbValueKind::TimestampTz
        JsonValue(_):
            return DbValueKind::Json
        JsonbValue(_):
            return DbValueKind::Jsonb
        TextValue(_):
            return DbValueKind::Text
        BytesValue(_):
            return DbValueKind::Bytes
    return DbValueKind::Null

fn db_value_is_null(value: DbValue) -> Boolean:
    match value:
        Null:
            return true
        BooleanValue(_):
            return false
        Int32Value(_):
            return false
        Int64Value(_):
            return false
        Float64Value(_):
            return false
        DecimalValue(_):
            return false
        DateValue(_):
            return false
        TimeValue(_):
            return false
        TimeTzValue(_):
            return false
        TimestampValue(_):
            return false
        TimestampTzValue(_):
            return false
        JsonValue(_):
            return false
        JsonbValue(_):
            return false
        TextValue(_):
            return false
        BytesValue(_):
            return false
    return false

fn db_value_as_boolean(value: DbValue) -> Option[Boolean]:
    match value:
        BooleanValue(inner):
            return some(inner)
        Null:
            return none
        Int32Value(_):
            return none
        Int64Value(_):
            return none
        Float64Value(_):
            return none
        DecimalValue(_):
            return none
        DateValue(_):
            return none
        TimeValue(_):
            return none
        TimeTzValue(_):
            return none
        TimestampValue(_):
            return none
        TimestampTzValue(_):
            return none
        JsonValue(_):
            return none
        JsonbValue(_):
            return none
        TextValue(_):
            return none
        BytesValue(_):
            return none
    return none

