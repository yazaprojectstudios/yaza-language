fn db_identifier_is_plain_ascii(identifier: Text) -> Boolean:
    let length: Number = text_length(identifier)
    if length < 1 or length > 63:
        return false
    var index: Number = 0
    while index < length:
        let byte: Number = text_byte(identifier, index)
        let is_letter: Boolean = (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122)
        let is_digit: Boolean = byte >= 48 and byte <= 57
        let is_underscore: Boolean = byte == 95
        if index == 0 and not is_letter and not is_underscore:
            return false
        if index > 0 and not is_letter and not is_digit and not is_underscore:
            return false
        set index = index + 1
    return true

fn db_error(kind: DbErrorKind, message: Text, provider_code: Option[Text], retryable: Boolean) -> DbError:
    return DbError(kind, message, provider_code, retryable)

fn db_row_is_valid(row: DbRow) -> Boolean:
    let column_count: Number = list_count(row.columns)
    if column_count > 256:
        return false
    for column in row.columns:
        let name_length: Number = text_length(column.name)
        if name_length < 1 or name_length > 255 or not db_value_is_valid(column.value):
            return false
    return true

fn db_row_new(columns: List[DbColumn]) -> Result[DbRow, DbError]:
    let column_count: Number = list_count(columns)
    if column_count > 256:
        return err(db_error(DbErrorKind::Protocol, "Database row exceeds the 256-column limit", none, false))
    let copied_columns: List[DbColumn] = List[DbColumn]()
    for column in columns:
        let name_length: Number = text_length(column.name)
        if name_length < 1 or name_length > 255 or not db_value_is_valid(column.value):
            return err(db_error(DbErrorKind::Protocol, "Database row contains an invalid column name", none, false))
        list_push(copied_columns, DbColumn(column.name, column.value))
    return ok(DbRow(copied_columns))

fn db_row_column_at(row: DbRow, index: Number) -> Option[DbColumn]:
    if not db_row_is_valid(row) or index < 0 or index >= list_count(row.columns):
        return none
    return some(list_get(row.columns, index))

fn db_row_find(row: DbRow, name: Text) -> Result[DbColumnLookup, DbError]:
    if not db_row_is_valid(row):
        return err(db_error(DbErrorKind::Protocol, "Database row metadata is invalid", none, false))
    let name_length: Number = text_length(name)
    if name_length < 1 or name_length > 255:
        return err(db_error(DbErrorKind::Configuration, "Database column lookup name is invalid", none, false))
    var found: Option[DbValue] = none
    for column in row.columns:
        if column.name == name:
            if option_is_some(found):
                return ok(DbColumnLookup::ColumnAmbiguous)
            set found = some(column.value)
    if not option_is_some(found):
        return ok(DbColumnLookup::ColumnMissing)
    return ok(DbColumnLookup::ColumnFound(option_unwrap(found)))

fn db_error_code(kind: DbErrorKind) -> Text:
    match kind:
        Configuration:
            return "configuration"
        Connection:
            return "connection"
