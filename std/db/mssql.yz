# Provider adapter from Microsoft SQL Server TDS tokens and rows to DbValue and DbRow.
use "core"
use "query"
use "../mssql/protocol"

fn db_mssql_error(kind: DbErrorKind, message: Text) -> DbError:
    let code: Option[Text] = none
    return db_error(kind, message, code, false)

fn db_mssql_decode_cell(col_meta: TdsColumnMetadata, cell_text: Text, is_null: Boolean) -> Result[DbValue, DbError]:
    if is_null:
        return ok(DbValue::Null)
    let tid: Number = col_meta.type_id
    # BIT (50), BITN (104)
    if tid == 50 or tid == 104:
        if cell_text == "1" or cell_text == "true":
            return ok(DbValue::BooleanValue(true))
        return ok(DbValue::BooleanValue(false))
    # TINYINT (48), SMALLINT (52), INT (56)
    if tid == 48 or tid == 52 or tid == 56:
        let parsed: Result[Number, Text] = number_try_parse(cell_text)
        if not result_is_ok(parsed):
            return err(db_mssql_error(DbErrorKind::Protocol, "MSSQL integer conversion failed"))
        let n: Number = result_unwrap(parsed)
        if n < -2147483648 or n > 2147483647:
            return err(db_mssql_error(DbErrorKind::Protocol, "MSSQL integer outside 32-bit range"))
        return ok(DbValue::Int32Value(int32_from_number(n)))
    # BIGINT (127), INTN (38)
    if tid == 127 or tid == 38:
        let parsed64: Result[Number, Text] = number_try_parse(cell_text)
        if not result_is_ok(parsed64):
            return err(db_mssql_error(DbErrorKind::Protocol, "MSSQL bigint conversion failed"))
        return ok(DbValue::Int64Value(result_unwrap(parsed64)))
    # REAL (59), FLOAT (62), FLTN (109)
    if tid == 59 or tid == 62 or tid == 109:
        let parsed_f: Result[Float64, Text] = float64_try_parse(cell_text)
        if not result_is_ok(parsed_f):
            return err(db_mssql_error(DbErrorKind::Protocol, "MSSQL float conversion failed"))
        return ok(DbValue::Float64Value(result_unwrap(parsed_f)))
    # DECIMALN (106), NUMERICN (108)
    if tid == 106 or tid == 108:
        if not db_decimal_text_valid(cell_text):
            return err(db_mssql_error(DbErrorKind::Protocol, "MSSQL decimal format invalid"))
        return ok(DbValue::DecimalValue(cell_text))
    # DATE (40)
    if tid == 40:
        if not db_date_text_valid(cell_text):
            return err(db_mssql_error(DbErrorKind::Protocol, "MSSQL date format invalid"))
        return ok(DbValue::DateValue(cell_text))
    # TIME (41)
    if tid == 41:
        if not db_time_text_valid(cell_text):
            return err(db_mssql_error(DbErrorKind::Protocol, "MSSQL time format invalid"))
        return ok(DbValue::TimeValue(cell_text))
    # DATETIME (61), SMALLDATETIME (58), DATETIME2 (42), DATETIMN (111)
    if tid == 61 or tid == 58 or tid == 42 or tid == 111:
        if not db_timestamp_text_valid(cell_text):
            return err(db_mssql_error(DbErrorKind::Protocol, "MSSQL timestamp format invalid"))
        return ok(DbValue::TimestampValue(cell_text))
    # DATETIMEOFFSET (43)
    if tid == 43:
        if not db_timestamp_tz_text_valid(cell_text):
            return err(db_mssql_error(DbErrorKind::Protocol, "MSSQL timestamp_tz format invalid"))
        return ok(DbValue::TimestampTzValue(cell_text))
    # VARBINARY (165), BINARY (173), IMAGE (34)
    if tid == 165 or tid == 173 or tid == 34:
        return ok(DbValue::BytesValue(bytes_from_text(cell_text)))
    # All text / varchar / nvarchar types
    return ok(DbValue::TextValue(cell_text))

fn db_mssql_row_to_dbrow(columns: List[TdsColumnMetadata], row: TdsRow) -> Result[DbRow, DbError]:
    let col_count: Number = list_count(columns)
    if list_count(row.cell_values) != col_count or list_count(row.cell_is_null) != col_count:
        return err(db_mssql_error(DbErrorKind::Protocol, "MSSQL row column count mismatch"))
    let db_cols: List[DbColumn] = List[DbColumn]()
    var idx: Number = 0
    while idx < col_count:
        let cm: TdsColumnMetadata = list_get(columns, idx)
        let raw_val: Text = list_get(row.cell_values, idx)
        let is_null_str: Text = list_get(row.cell_is_null, idx)
        let is_null: Boolean = is_null_str == "true"
        let val_res: Result[DbValue, DbError] = db_mssql_decode_cell(cm, raw_val, is_null)
        if not result_is_ok(val_res):
            return err(result_unwrap_error(val_res))
        list_push(db_cols, DbColumn(cm.name, result_unwrap(val_res)))
        set idx = idx + 1
    return db_row_new(db_cols)
