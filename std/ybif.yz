# YAZA Binary Interchange Format (YBIF) v1
# Specification: proposal-yaza-llvm-backend-parity.md (lines 171-198)
# Magic: "YBIF" (0x59 0x42 0x49 0x46), Version: 1

fn ybif_header() -> Bytes:
    let magic: Bytes = bytes_from_text("YBIF")
    let ver: Bytes = bytes_from_number(1)
    return bytes_concat(magic, ver)

fn ybif_is_valid_header(data: Bytes) -> Boolean:
    if bytes_length(data) < 5: return false
    let magic: Bytes = bytes_slice(data, 0, 4)
    if not bytes_equal(magic, bytes_from_text("YBIF")): return false
    if bytes_get(data, 4) != 1: return false
    return true

fn ybif_u32_le(val: Number) -> Bytes:
    var v: Number = val
    if v < 0: set v = 0
    let b0: Bytes = bytes_from_number(v % 256)
    let b1: Bytes = bytes_from_number((v / 256) % 256)
    let b2: Bytes = bytes_from_number((v / 65536) % 256)
    let b3: Bytes = bytes_from_number((v / 16777216) % 256)
    return bytes_concat(bytes_concat(b0, b1), bytes_concat(b2, b3))

fn ybif_read_u32_le(data: Bytes, offset: Number) -> Number:
    if offset < 0 or offset > bytes_length(data) - 4: return 0
    let b0: Number = bytes_get(data, offset)
    let b1: Number = bytes_get(data, offset + 1)
    let b2: Number = bytes_get(data, offset + 2)
    let b3: Number = bytes_get(data, offset + 3)
    return b0 + (b1 * 256) + (b2 * 65536) + (b3 * 16777216)

fn ybif_encode_null() -> Bytes:
    return bytes_from_number(0)

fn ybif_encode_bool(val: Boolean) -> Bytes:
    if val: return bytes_from_number(2)
    return bytes_from_number(1)

fn ybif_encode_number(val: Number) -> Bytes:
    # Tag 3 + full 8-byte little-endian two's complement signed 64-bit integer (handles full 64-bit range incl. INT64_MIN)
    let buf_res: Result[Bytes, Text] = bytes_try_new_zeroed(9)
    if not result_is_ok(buf_res):
        return bytes_from_number(3)
    let buf: Bytes = result_unwrap(buf_res)
    let _t: Boolean = bytes_try_set(buf, 0, 3)
    var v: Number = val
    var i: Number = 0
    while i < 8:
        var b: Number = v % 256
        if b < 0:
            set b = b + 256
            set v = (v - b) / 256
        else:
            set v = v / 256
        let _s: Boolean = bytes_try_set(buf, 1 + i, b)
        set i = i + 1
    return buf

fn ybif_encode_text(val: Text) -> Bytes:
    let tag: Bytes = bytes_from_number(4)
    let payload: Bytes = bytes_from_text(val)
    let len: Bytes = ybif_u32_le(bytes_length(payload))
    return bytes_concat(bytes_concat(tag, len), payload)

fn ybif_encode_bytes(val: Bytes) -> Bytes:
    let tag: Bytes = bytes_from_number(5)
    let len: Bytes = ybif_u32_le(bytes_length(val))
    return bytes_concat(bytes_concat(tag, len), val)

fn ybif_encode_error(code: Number, message: Text) -> Bytes:
    let tag: Bytes = bytes_from_number(8)
    let code_bytes: Bytes = ybif_u32_le(code)
    let msg_payload: Bytes = bytes_from_text(message)
    let msg_len: Bytes = ybif_u32_le(bytes_length(msg_payload))
    return bytes_concat(ybif_header(), bytes_concat(bytes_concat(bytes_concat(tag, code_bytes), msg_len), msg_payload))

# Encodes a SQL table result in YBIF format:
# Header + Tag 9 + column_count (4B) + columns (len + text) + row_count (4B) + row cells
fn ybif_encode_sql_result(columns: List[Text], rows_json_format: List[Text], row_count: Number) -> Bytes:
    let chunks: List[Bytes] = List[Bytes]()
    list_push(chunks, ybif_header())
    list_push(chunks, bytes_from_number(9))
    let col_count: Number = list_count(columns)
    list_push(chunks, ybif_u32_le(col_count))
    var i: Number = 0
    while i < col_count:
        let col_name: Text = list_get(columns, i)
        let col_bytes: Bytes = bytes_from_text(col_name)
        list_push(chunks, ybif_u32_le(bytes_length(col_bytes)))
        list_push(chunks, col_bytes)
        set i = i + 1
    list_push(chunks, ybif_u32_le(row_count))
    var r: Number = 0
    while r < list_count(rows_json_format):
        let row_text: Text = list_get(rows_json_format, r)
        let row_bytes: Bytes = bytes_from_text(row_text)
        list_push(chunks, ybif_u32_le(bytes_length(row_bytes)))
        list_push(chunks, row_bytes)
        set r = r + 1
    let joined: Result[Bytes, Text] = bytes_join(chunks)
    if result_is_ok(joined):
        return result_unwrap(joined)
    return ybif_header()
