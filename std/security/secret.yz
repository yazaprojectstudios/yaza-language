# Opaque secret helpers. Task-created values are wiped at task termination;
# values created elsewhere require explicit zeroization. Reveal only at APIs that need Text.

fn secret_from_text(value: Text) -> Option[SecretText]:
    return secret_text_from_text(value)

fn secret_from_environment(name: Text) -> Option[SecretText]:
    return secret_text_from_env(name)

fn secret_is_valid(value: SecretText) -> Boolean:
    return secret_text_is_valid(value)

# Check a secret's bounded length without exposing a Text alias to its bytes.
fn secret_at_most(value: SecretText, maximum: Number) -> Boolean:
    return secret_text_at_most(value, maximum)

# Make an explicit, owned byte copy without exposing a Text alias. The caller
# must zeroize the returned Bytes as soon as the sensitive operation ends.
fn secret_copy_bytes(value: SecretText) -> Option[Bytes]:
    return secret_text_copy_bytes(value)

fn secret_reveal_text(value: SecretText) -> Option[Text]:
    return secret_text_reveal(value)

fn secret_redacted_text(value: SecretText) -> Text:
    return secret_text_redacted(value)

fn secret_zeroize(value: SecretText) -> Boolean:
    return secret_text_zeroize(value)
