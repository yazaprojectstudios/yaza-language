# Separate web-admin Argon2id verifier. Database service credentials are never changed here.
use "std/crypto/password"
use "std/crypto/hash"
use "std/uuid"

fn admin_credentials_path(db_dir: Text) -> Text:
    return db_dir + "/.yaza_web_admin"

fn admin_credentials_exist(db_dir: Text) -> Boolean:
    return file_exists(admin_credentials_path(db_dir))

fn admin_credentials_line(db_dir: Text, prefix: Text) -> Text:
    if not admin_credentials_exist(db_dir): return ""
    let lines: TextList = text_lines(file_read(admin_credentials_path(db_dir)))
    var index: Number = 0
    while index < list_count(lines):
        let line: Text = list_get(lines, index)
        if text_starts_with(line, prefix):
            return text_slice(line, text_length(prefix), text_length(line) - text_length(prefix))
        set index = index + 1
    return ""

fn admin_current_username(db_dir: Text) -> Text:
    return admin_credentials_line(db_dir, "username=")

fn admin_current_hash(db_dir: Text) -> Text:
    return admin_credentials_line(db_dir, "hash=")

fn admin_set_credentials(db_dir: Text, username: Text, password: Text) -> Result[Boolean, Text]:
    let clean_user: Text = text_trim(username)
    if text_length(clean_user) < 1 or text_length(clean_user) > 128 or text_find(clean_user, "=") >= 0 or text_find(clean_user, "\n") >= 0 or text_find(clean_user, "\r") >= 0:
        return err("web admin username is invalid")
    if text_length(password) < 16 or text_length(password) > 1024:
        return err("web admin password must contain 16–1024 characters")
    let hash_result: Result[Text, PasswordHashError] = password_hash_argon2id(password)
    if not result_is_ok(hash_result): return err("web admin Argon2id hashing failed")
    let payload: Bytes = bytes_try_from_text("username=" + clean_user + "\nhash=" + result_unwrap(hash_result) + "\n")?
    let root: Number = vfs_root_open(db_dir)?
    let temp_name: Text = ".yaza_web_admin.tmp." + uuid_to_text(uuid_v4())
    let temp_res: Result[Number, Text] = vfs_create_exclusive(root, temp_name)
    if not result_is_ok(temp_res):
        let _closed: Result[Boolean, Text] = vfs_close(root)
        return err(result_unwrap_error(temp_res))
    let temp_fd: Number = result_unwrap(temp_res)
    let written: Result[Number, Text] = vfs_write_exact(temp_fd, 0, payload)
    var synced: Result[Boolean, Text] = err("write failed")
    if result_is_ok(written) and result_unwrap(written) == bytes_length(payload):
        set synced = vfs_sync(temp_fd)
    let _closed_file: Result[Boolean, Text] = vfs_close(temp_fd)
    if not result_is_ok(synced):
        let _removed: Result[Boolean, Text] = vfs_remove(root, temp_name)
        let _closed_root: Result[Boolean, Text] = vfs_close(root)
        return err("web admin credential write or sync failed")
    let renamed: Result[Boolean, Text] = vfs_rename(root, temp_name, ".yaza_web_admin")
    if not result_is_ok(renamed):
        let _removed2: Result[Boolean, Text] = vfs_remove(root, temp_name)
        let _closed_root2: Result[Boolean, Text] = vfs_close(root)
        return err("web admin credential replacement failed")
    let dir_synced: Result[Boolean, Text] = vfs_sync_directory(root)
    let _closed_root3: Result[Boolean, Text] = vfs_close(root)
    if not result_is_ok(dir_synced): return err("web admin credential directory sync failed")
    return ok(true)

fn admin_verify_credentials(db_dir: Text, username: Text, password: Text) -> Boolean:
    let stored_user: Text = admin_current_username(db_dir)
    let hash: Text = admin_current_hash(db_dir)
    if not text_starts_with(hash, "$argon2id$"): return false
    let checked: Result[Boolean, PasswordHashError] = password_verify_argon2id(password, hash)
    let user_ok: Boolean = text_length(stored_user) > 0 and crypto_constant_time_compare(stored_user, username)
    let pw_ok: Boolean = result_is_ok(checked) and result_unwrap(checked)
    return user_ok and pw_ok
