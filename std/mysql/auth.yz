# MySQL authentication implementations: caching_sha2_password and cleartext fallback.
use "protocol"

fn mysql_xor_32(left: Bytes, right: Bytes) -> Result[Bytes, Text]:
    if bytes_length(left) != 32 or bytes_length(right) != 32:
        return err("MySQL XOR requires exact 32-byte operands")
    var output: Bytes = bytes_empty()
    var index: Number = 0
    while index < 32:
        var first: Number = bytes_get(left, index)
        var second: Number = bytes_get(right, index)
        var bit: Number = 1
        var result_byte: Number = 0
        var bit_index: Number = 0
        while bit_index < 8:
            let b1: Number = first % 2
            let b2: Number = second % 2
            if b1 != b2:
                set result_byte = result_byte + bit
            set first = first / 2
            set second = second / 2
            set bit = bit * 2
            set bit_index = bit_index + 1
        set output = bytes_concat(output, bytes_from_number(result_byte))
        set index = index + 1
    return ok(output)

fn mysql_scramble_caching_sha2(password: Text, salt: Bytes) -> Result[Bytes, Text]:
    if text_length(password) == 0:
        return ok(bytes_empty())
    if bytes_length(salt) < 20:
        return err("MySQL salt must contain at least 20 bytes")
    let salt_20: Bytes = bytes_slice(salt, 0, 20)
    let p_bytes: Bytes = bytes_from_text(password)
    let stage1: Bytes = crypto_sha256(p_bytes)
    let stage2: Bytes = crypto_sha256(stage1)
    let stage3_input: Bytes = bytes_concat(stage2, salt_20)
    let stage3: Bytes = crypto_sha256(stage3_input)
    return mysql_xor_32(stage1, stage3)
