# Capability-based filesystem access for application data rooted in one directory.
# Relative paths are capped at 4096 bytes/128 components and reject traversal,
# control bytes, malformed UTF-8, backslashes, and symlinks. New directories
# are created with owner-only permissions; existing directory permissions stay unchanged.
# Reads, ranged reads/writes, appends, and atomic replacements are bounded to 64 MiB and do not follow links.
# Except close, rooted operations check API cancellation before traversal or mutation; traversal/listing and byte transfers poll between bounded steps.
# Byte transfers use 64 KiB chunks; cancellation cannot interrupt a blocked OS disk call.
# Appending and positional writes wait at most 1000 ms for cooperating YAZA file operations; cancellation or another failed write may leave a prefix.
# Cancelled directory creation may leave already-created ancestors; permission changes and removals check before mutation.
# Atomic replacement removes its private temporary file when cancellation is observed before the rename commit point.
# Directory listings are sorted and bounded to 4096 names/512 KiB; invalid UTF-8 names fail closed.
# FsMetadata accepts only regular files/directories and exposes permissions & 0777 plus modification time.
# Permission updates accept decimal POSIX mode bits from 0 through 511 (0777), never follow a final symlink,
# and require the target to be openable by the current process. The root handle is not an OS sandbox.
# Removal accepts only regular files or empty directories; it rejects symlinks, special files, and the root itself.

shape FsMetadata:
    kind: Text
    size_bytes: Number
    permissions: Number
    modified_seconds: Number
    modified_nanoseconds: Number

fn fs_root_open(root_path: Text) -> Result[Number, Text]:
    return fs_root_open_native(root_path)

fn fs_root_close(root: Number) -> Result[Boolean, Text]:
    return fs_root_close_native(root)

fn fs_root_create_directory(root: Number, relative_path: Text) -> Result[Boolean, Text]:
    return fs_root_create_directory_native(root, relative_path)

fn fs_root_list_directory(root: Number, relative_path: Text) -> Result[TextList, Text]:
    return fs_root_list_directory_native(root, relative_path)

fn fs_root_metadata(root: Number, relative_path: Text) -> Result[FsMetadata, Text]:
    let fields: TextList = fs_root_metadata_native(root, relative_path)?
    if list_count(fields) != 5:
        return err("filesystem metadata record is malformed")
    return ok(FsMetadata(list_get(fields, 0), number_parse(list_get(fields, 1)), number_parse(list_get(fields, 2)), number_parse(list_get(fields, 3)), number_parse(list_get(fields, 4))))

fn fs_root_set_permissions(root: Number, relative_path: Text, permissions: Number) -> Result[Boolean, Text]:
    return fs_root_set_permissions_native(root, relative_path, permissions)

fn fs_root_remove_file(root: Number, relative_path: Text) -> Result[Boolean, Text]:
    return fs_root_remove_file_native(root, relative_path)

fn fs_root_remove_directory(root: Number, relative_path: Text) -> Result[Boolean, Text]:
    return fs_root_remove_directory_native(root, relative_path)

fn fs_root_read_bytes(root: Number, relative_path: Text, maximum_bytes: Number) -> Result[Bytes, Text]:
    return fs_root_read_bytes_native(root, relative_path, maximum_bytes)

fn fs_root_read_bytes_range(root: Number, relative_path: Text, offset: Number, length: Number) -> Result[Bytes, Text]:
    return fs_root_read_bytes_range_native(root, relative_path, offset, length)

fn fs_root_append_bytes(root: Number, relative_path: Text, data: Bytes) -> Result[Boolean, Text]:
    return fs_root_append_bytes_native(root, relative_path, data)

fn fs_root_write_bytes_range(root: Number, relative_path: Text, offset: Number, data: Bytes) -> Result[Boolean, Text]:
    return fs_root_write_bytes_range_native(root, relative_path, offset, data)

fn fs_root_replace_bytes(root: Number, relative_path: Text, data: Bytes) -> Result[Boolean, Text]:
    return fs_root_replace_bytes_native(root, relative_path, data)
