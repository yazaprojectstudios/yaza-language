# Concurrency Control and Synchronization Primitives for YAZA backed by POSIX mutexes and C11 atomics.

shape Mutex:
    id: Number

shape AtomicNumber:
    val: Number

fn mutex_create(id: Number) -> Mutex:
    return Mutex(rt_mutex_create())

fn mutex_lock(m: Mutex) -> Boolean:
    return rt_mutex_lock(m.id)

fn mutex_unlock(m: Mutex) -> Boolean:
    return rt_mutex_unlock(m.id)

fn mutex_destroy(m: Mutex) -> Boolean:
    return rt_mutex_destroy(m.id)

fn atomic_create(initial: Number) -> AtomicNumber:
    return AtomicNumber(rt_atomic_create(initial))

fn atomic_load(a: AtomicNumber) -> Number:
    return rt_atomic_load(a.val)

fn atomic_store(a: AtomicNumber, new_val: Number) -> AtomicNumber:
    let ignored: Boolean = rt_atomic_store(a.val, new_val)
    return a

fn atomic_add(a: AtomicNumber, delta: Number) -> AtomicNumber:
    let ignored: Number = rt_atomic_add(a.val, delta)
    return a

fn atomic_fetch_add(a: AtomicNumber, delta: Number) -> Number:
    return rt_atomic_add(a.val, delta)
