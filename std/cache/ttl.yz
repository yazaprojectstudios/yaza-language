# Process-local bounded TTL cache for small, non-sensitive application values.
# Keys are limited to 255 UTF-8 bytes, values to 4095 bytes, entries to 128,
# and TTLs to one week. This is not persistent or shared across processes.

fn ttl_cache_get(key: Text) -> Option[Text]:
    return native_ttl_cache_get(key)

fn ttl_cache_set(key: Text, value: Text, ttl_ms: Number) -> Boolean:
    return native_ttl_cache_set(key, value, ttl_ms)

fn ttl_cache_remove(key: Text) -> Boolean:
    return native_ttl_cache_remove(key)

fn ttl_cache_clear() -> Number:
    return native_ttl_cache_clear()
