# Asynchronous Runtime, Cooperative Yield, Sleep, and Bounded Channels backed by C11/POSIX primitives.

use "std/time"

shape AsyncTask:
    task_id: Number
    status: Text    # "pending", "running", "completed", "failed"
    error_msg: Text

shape AsyncChannel:
    id: Number
    capacity: Number
    closed: Boolean
    in_flight_count: Number

fn async_spawn_task(task_id: Number) -> AsyncTask:
    return AsyncTask(task_id, "pending", "")

fn async_yield() -> Boolean:
    return thread_yield()

async fn async_sleep(ms: Number) -> Boolean:
    return sleep_ms(ms)

async fn async_yield_task() -> Boolean:
    return thread_yield()

fn async_channel_create(capacity: Number) -> AsyncChannel:
    let handle: Number = rt_channel_create(capacity)
    return AsyncChannel(handle, capacity, false, 0)

fn async_channel_send(chan: AsyncChannel, value: Number) -> Boolean:
    return rt_channel_send(chan.id, value)

fn async_channel_recv(chan: AsyncChannel) -> Option[Number]:
    return rt_channel_recv(chan.id)

fn async_channel_is_full(chan: AsyncChannel) -> Boolean:
    return rt_channel_is_full(chan.id)

fn async_channel_is_closed(chan: AsyncChannel) -> Boolean:
    return rt_channel_is_closed(chan.id)

fn async_channel_close(chan: AsyncChannel) -> AsyncChannel:
    let ignored: Boolean = rt_channel_close(chan.id)
    return AsyncChannel(chan.id, chan.capacity, true, chan.in_flight_count)

fn async_worker_count() -> Number:
    let count: Number = processor_count()
    if count < 1: return 1
    return count
