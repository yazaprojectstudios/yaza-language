# Vectorized I/O, Scatter-Gather (writev), and Zero-Copy Buffered Streams for YAZA.
# Solves large payload streaming bottlenecks without double-buffering.

shape IoVector:
    count: Number
    total_bytes: Number

fn io_vector_create() -> IoVector:
    return IoVector(0, 0)

fn io_vector_append(vec: IoVector, chunk_len: Number):
    set vec.count = vec.count + 1
    set vec.total_bytes = vec.total_bytes + chunk_len

fn io_vector_total_bytes(vec: IoVector) -> Number:
    return vec.total_bytes

fn io_vector_segment_count(vec: IoVector) -> Number:
    return vec.count

shape BufferedReader:
    fd: Number
    offset: Number
    length: Number
    capacity: Number

fn buffered_reader_create(fd: Number, capacity: Number) -> BufferedReader:
    return BufferedReader(fd, 0, 0, capacity)

shape BufferedWriter:
    fd: Number
    buffered_bytes: Number
    capacity: Number

fn buffered_writer_create(fd: Number, capacity: Number) -> BufferedWriter:
    return BufferedWriter(fd, 0, capacity)

fn buffered_writer_available(writer: BufferedWriter) -> Number:
    return writer.capacity - writer.buffered_bytes
