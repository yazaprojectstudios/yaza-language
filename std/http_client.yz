# Bounded HTTPS client. Certificate and hostname verification are mandatory.
# Redirects are returned to the caller, never followed implicitly.

shape HttpsResponse:
    status_code: Number
    body: Bytes

fn http_client_request(method: Text, url: Text, body: Bytes, bearer_token: Text, timeout_ms: Number, max_response_bytes: Number) -> Result[HttpsResponse, Text]:
    if timeout_ms < 1 or timeout_ms > 60000: return err("HTTPS timeout must be between 1 and 60000 ms")
    if max_response_bytes < 1 or max_response_bytes > 16777216: return err("HTTPS response limit must be between 1 and 16 MiB")
    let wire: Bytes = https_request(method, url, body, bearer_token, timeout_ms, max_response_bytes)?
    if bytes_length(wire) < 2: return err("HTTPS transport returned an incomplete status")
    let status: Number = bytes_get(wire, 0) * 256 + bytes_get(wire, 1)
    let payload: Bytes = bytes_try_slice(wire, 2, bytes_length(wire) - 2)?
    return ok(HttpsResponse(status, payload))

fn http_client_get(url: Text, bearer_token: Text) -> Result[HttpsResponse, Text]:
    return http_client_request("GET", url, bytes_empty(), bearer_token, 5000, 1048576)

fn http_client_post_json(url: Text, json_body: Text, bearer_token: Text) -> Result[HttpsResponse, Text]:
    let payload: Bytes = bytes_try_from_text(json_body)?
    return http_client_request("POST", url, payload, bearer_token, 5000, 1048576)
