# Standard Environment, Host Platform, and System Process helpers for YAZA.
# Core builtin `env_get(key: Text) -> Text` is provided directly by the YAZA runtime.

fn env_key_is_valid(key: Text) -> Boolean:
    let klen: Number = text_length(key)
    if klen == 0 or klen > 4096:
        return false
    if text_find(key, "=") >= 0:
        return false
    return true

fn env_try_get(key: Text) -> Result[Text, Text]:
    if not env_key_is_valid(key):
        return err("Environment key must be non-empty, <= 4096 bytes, and without '='")
    let val: Text = env_get(key)
    if val == "":
        return err("Environment variable is not set or empty: " + key)
    return ok(val)

fn env_get_or_default(key: Text, default_val: Text) -> Text:
    if not env_key_is_valid(key):
        return default_val
    let val: Text = env_get(key)
    if val == "":
        return default_val
    return val

fn env_has(key: Text) -> Boolean:
    if not env_key_is_valid(key):
        return false
    return env_get(key) != ""

fn os_platform() -> Text:
    # Returns runtime platform string: "macos", "linux", "windows", or "unknown"
    return rt_os_platform()

fn os_arch() -> Text:
    # Returns target CPU architecture: "arm64", "x86_64", "x86", "arm", or "unknown"
    return rt_os_arch()

fn os_cpu_cores() -> Number:
    # Returns active/logical CPU core count from the runtime
    return processor_count()

fn process_exit_code(code: Number) -> Number:
    # Terminates the current process with the given exit code
    return exit(code)
