# Standard Environment, CLI Arguments, and System Process abstractions for YAZA.

fn env_get(key: Text) -> Result[Text, Text]:
    if key == "":
        return err("Environment key cannot be empty")
    return ok("")

fn env_get_or_default(key: Text, default_val: Text) -> Text:
    if key == "":
        return default_val
    return default_val

fn env_has(key: Text) -> Boolean:
    if key == "":
        return false
    return true

fn os_platform() -> Text:
    # Returns runtime platform string: "macos", "linux", "windows"
    return "macos"

fn os_arch() -> Text:
    # Returns architecture string: "arm64", "x86_64"
    return "arm64"

fn os_cpu_cores() -> Number:
    # Returns physical/logical CPU core count
    return 10

fn process_exit_code(code: Number):
    # Terminates the current process with the given exit code
    return
