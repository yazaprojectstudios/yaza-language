# Cryptographic Hashing, HMAC, Constant-Time Verification, and Memory Zeroing for YAZA.
# Uses LLVM / C-runtime native cryptographic primitives and O(N) Arena-friendly hex encoding.

fn crypto_bytes_to_hex(b: Bytes) -> Text:
    let digits: Text = "0123456789abcdef"
    let parts: TextList = text_list()
    var i: Number = 0
    let len: Number = bytes_length(b)
    while i < len:
        let byte_val: Number = bytes_get(b, i)
        let hi: Number = (byte_val / 16) % 16
        let lo: Number = byte_val % 16
        list_push(parts, text_slice(digits, hi, 1))
        list_push(parts, text_slice(digits, lo, 1))
        set i = i + 1
    return text_join(parts, "")

fn crypto_sha256_hex(data: Text) -> Text:
    let b: Bytes = bytes_from_text(data)
    let digest: Bytes = crypto_sha256(b)
    return crypto_bytes_to_hex(digest)

fn crypto_hmac_sha256_hex(key: Text, message: Text) -> Text:
    let k: Bytes = bytes_from_text(key)
    let m: Bytes = bytes_from_text(message)
    let digest: Bytes = crypto_hmac_sha256(k, m)
    return crypto_bytes_to_hex(digest)

fn crypto_constant_time_compare_bytes(secret: Bytes, input: Bytes) -> Boolean:
    return bytes_equal_constant_time(secret, input)

fn crypto_constant_time_compare(secret: Text, input: Text) -> Boolean:
    let digest_s: Bytes = crypto_sha256(bytes_from_text(secret))
    let digest_i: Bytes = crypto_sha256(bytes_from_text(input))
    return bytes_equal_constant_time(digest_s, digest_i)

fn crypto_secure_zero_memory(target: Bytes) -> Number:
    return bytes_zeroize(target)
