# Password verification helpers backed by the reviewed Argon2 reference provider.
# The provider format and parameters are versioned in its PHC-encoded string.

variant PasswordHashError:
    PasswordTooLong
    InvalidEncodedHash
    ProviderUnavailable
    ProviderFailure

fn password_argon2_hash_is_current(encoded_hash: Text) -> Boolean:
    return crypto_argon2id_hash_format_is_current(encoded_hash)

fn password_hash_argon2id(password: Text) -> Result[Text, PasswordHashError]:
    let password_bytes_result: Result[Bytes, Text] = bytes_from_text_bounded(password, 1024)
    if not result_is_ok(password_bytes_result):
        return err(PasswordHashError::PasswordTooLong)
    let password_bytes: Bytes = result_unwrap(password_bytes_result)
    let salt_result: Result[Bytes, Text] = secure_random_bytes_try(16)
    if not result_is_ok(salt_result):
        let wiped_password: Number = bytes_zeroize(password_bytes)
        return err(PasswordHashError::ProviderFailure)
    let salt: Bytes = result_unwrap(salt_result)
    let encoded: Result[Text, Text] = crypto_argon2id_hash(password_bytes, salt)
    let wiped: Number = bytes_zeroize(password_bytes)
    let wiped_salt: Number = bytes_zeroize(salt)
    if not result_is_ok(encoded):
        let provider_error: Text = result_unwrap_error(encoded)
        if provider_error == "Argon2id provider is unavailable; install the YAZA Argon2 provider package":
            return err(PasswordHashError::ProviderUnavailable)
        return err(PasswordHashError::ProviderFailure)
    return ok(result_unwrap(encoded))

fn password_verify_argon2id(password: Text, encoded_hash: Text) -> Result[Boolean, PasswordHashError]:
    if not password_argon2_hash_is_current(encoded_hash):
        return err(PasswordHashError::InvalidEncodedHash)
    let password_bytes_result: Result[Bytes, Text] = bytes_from_text_bounded(password, 1024)
    if not result_is_ok(password_bytes_result):
        return err(PasswordHashError::PasswordTooLong)
    let password_bytes: Bytes = result_unwrap(password_bytes_result)
    let verified: Boolean = crypto_argon2id_verify(password_bytes, encoded_hash)
    let wiped: Number = bytes_zeroize(password_bytes)
    return ok(verified)

fn password_hash_needs_rehash(encoded_hash: Text) -> Boolean:
    return not password_argon2_hash_is_current(encoded_hash)
