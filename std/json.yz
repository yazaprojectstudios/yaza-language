# Strict, bounded JSON serialization and parsing for YAZA.
# Provides encoding of primitives, arrays, and objects, and bounded field extraction.

fn json_escape_text(raw: Text) -> Text:
    var result: Text = ""
    var index: Number = 0
    let length: Number = text_length(raw)
    while index < length:
        let byte: Number = text_byte(raw, index)
        if byte == 34:
            set result = result + "\\\""
        elif byte == 92:
            set result = result + "\\\\"
        elif byte == 10:
            set result = result + "\\n"
        elif byte == 13:
            set result = result + "\\r"
        elif byte == 9:
            set result = result + "\\t"
        elif byte < 32:
            set result = result + " "
        else:
            set result = result + text_slice(raw, index, 1)
        set index = index + 1
    return result

fn json_null() -> Text:
    return "null"

fn json_bool(value: Boolean) -> Text:
    if value: return "true"
    return "false"

fn json_number(value: Number) -> Text:
    return number_text(value)

fn json_float(value: Float64) -> Text:
    return float64_text(value)

fn json_string(value: Text) -> Text:
    return "\"" + json_escape_text(value) + "\""

fn json_field(key: Text, value: Text) -> Text:
    return json_string(key) + ": " + value

fn json_object(fields: List[Text]) -> Text:
    var res: Text = "{"
    var i: Number = 0
    let count: Number = list_count(fields)
    while i < count:
        if i > 0: set res = res + ", "
        set res = res + list_get(fields, i)
        set i = i + 1
    return res + "}"

fn json_array(items: List[Text]) -> Text:
    var res: Text = "["
    var i: Number = 0
    let count: Number = list_count(items)
    while i < count:
        if i > 0: set res = res + ", "
        set res = res + list_get(items, i)
        set i = i + 1
    return res + "]"

# Bounded extraction of a string field from a flat JSON object: {"key": "val"}
fn json_extract_string(json: Text, key: Text) -> Option[Text]:
    let needle: Text = "\"" + key + "\""
    let pos: Number = text_find(json, needle)
    if pos < 0: return none
    var colon_pos: Number = pos + text_length(needle)
    let json_len: Number = text_length(json)
    while colon_pos < json_len and text_byte(json, colon_pos) != 58: # ':'
        set colon_pos = colon_pos + 1
    if colon_pos >= json_len: return none
    var val_start: Number = colon_pos + 1
    while val_start < json_len and text_byte(json, val_start) <= 32:
        set val_start = val_start + 1
    if val_start >= json_len: return none
    if text_byte(json, val_start) != 34: # must start with '"'
        return none
    set val_start = val_start + 1
    var val_end: Number = val_start
    while val_end < json_len:
        let b: Number = text_byte(json, val_end)
        if b == 34 and text_byte(json, val_end - 1) != 92: # unescaped quote
            return some(text_slice(json, val_start, val_end - val_start))
        set val_end = val_end + 1
    return none

# Bounded extraction of a number field from a JSON object: {"key": 123}
fn json_extract_number(json: Text, key: Text) -> Option[Number]:
    let needle: Text = "\"" + key + "\""
    let pos: Number = text_find(json, needle)
    if pos < 0: return none
    var colon_pos: Number = pos + text_length(needle)
    let json_len: Number = text_length(json)
    while colon_pos < json_len and text_byte(json, colon_pos) != 58:
        set colon_pos = colon_pos + 1
    if colon_pos >= json_len: return none
    var val_start: Number = colon_pos + 1
    while val_start < json_len and text_byte(json, val_start) <= 32:
        set val_start = val_start + 1
    if val_start >= json_len: return none
    var val_end: Number = val_start
    while val_end < json_len:
        let b: Number = text_byte(json, val_end)
        let is_digit_or_sign: Boolean = (b >= 48 and b <= 57) or b == 45
        if not is_digit_or_sign:
            break
        set val_end = val_end + 1
    if val_end <= val_start: return none
    let num_str: Text = text_slice(json, val_start, val_end - val_start)
    let parsed: Result[Number, Text] = number_try_parse(num_str)
    if result_is_ok(parsed):
        return some(result_unwrap(parsed))
    return none
