# YAZA Data Science Engine — Arena-Backed Vector, Time-Series & Dense Matrix Linear Algebra (NumPy / BLAS Alternative).
# Uses contiguous row-major storage, Neumaier compensated dot products, and partial-pivoting Gaussian elimination.

use "std/math"
use "std/data/stats"

shape DenseMatrix:
    rows: Number
    cols: Number
    data: List[Float64]

fn vec_zeros(n: Number) -> List[Float64]:
    let out: List[Float64] = List[Float64]()
    var i: Number = 0
    while i < n:
        list_push(out, 0.0)
        set i = i + 1
    return out

fn vec_fill(n: Number, value: Float64) -> List[Float64]:
    let out: List[Float64] = List[Float64]()
    var i: Number = 0
    while i < n:
        list_push(out, value)
        set i = i + 1
    return out

fn vec_linspace(start_val: Float64, end_val: Float64, count: Number) -> List[Float64]:
    let out: List[Float64] = List[Float64]()
    if count <= 0:
        return out
    if count == 1:
        list_push(out, start_val)
        return out
    let step: Float64 = (end_val - start_val) / float64_from_number(count - 1)
    var i: Number = 0
    while i < count:
        list_push(out, start_val + float64_from_number(i) * step)
        set i = i + 1
    return out

fn vec_scale(xs: List[Float64], scalar: Float64) -> List[Float64]:
    let n: Number = list_count(xs)
    let out: List[Float64] = List[Float64]()
    var i: Number = 0
    while i < n:
        list_push(out, list_get(xs, i) * scalar)
        set i = i + 1
    return out

fn vec_add(a: List[Float64], b: List[Float64]) -> Result[List[Float64], Text]:
    let n: Number = list_count(a)
    if n != list_count(b):
        return err("vec_add requires equal-length vectors")
    let out: List[Float64] = List[Float64]()
    var i: Number = 0
    while i < n:
        list_push(out, list_get(a, i) + list_get(b, i))
        set i = i + 1
    return ok(out)

fn vec_sub(a: List[Float64], b: List[Float64]) -> Result[List[Float64], Text]:
    let n: Number = list_count(a)
    if n != list_count(b):
        return err("vec_sub requires equal-length vectors")
    let out: List[Float64] = List[Float64]()
    var i: Number = 0
    while i < n:
        list_push(out, list_get(a, i) - list_get(b, i))
        set i = i + 1
    return ok(out)

fn vec_mul(a: List[Float64], b: List[Float64]) -> Result[List[Float64], Text]:
    let n: Number = list_count(a)
    if n != list_count(b):
        return err("vec_mul requires equal-length vectors")
    let out: List[Float64] = List[Float64]()
    var i: Number = 0
    while i < n:
        list_push(out, list_get(a, i) * list_get(b, i))
        set i = i + 1
    return ok(out)

fn vec_axpy(alpha: Float64, x: List[Float64], y: List[Float64]) -> Result[List[Float64], Text]:
    let n: Number = list_count(x)
    if n != list_count(y):
        return err("vec_axpy requires equal-length vectors")
    let out: List[Float64] = List[Float64]()
    var i: Number = 0
    while i < n:
        list_push(out, alpha * list_get(x, i) + list_get(y, i))
        set i = i + 1
    return ok(out)

# Neumaier compensated inner product (dot product)
fn vec_dot_compensated(a: List[Float64], b: List[Float64]) -> Result[Float64, Text]:
    let n: Number = list_count(a)
    if n != list_count(b):
        return err("vec_dot_compensated requires equal-length vectors")
    var sum: Float64 = 0.0
    var c: Float64 = 0.0
    var i: Number = 0
    while i < n:
        let prod: Float64 = list_get(a, i) * list_get(b, i)
        let t: Float64 = sum + prod
        if math_abs_float64(sum) >= math_abs_float64(prod):
            set c = c + ((sum - t) + prod)
        else:
            set c = c + ((prod - t) + sum)
        set sum = t
        set i = i + 1
    return ok(sum + c)

fn vec_l2_norm(xs: List[Float64]) -> Float64:
    let dot_res: Result[Float64, Text] = vec_dot_compensated(xs, xs)
    return math_sqrt_float64(result_unwrap(dot_res))

fn vec_cosine_similarity(a: List[Float64], b: List[Float64]) -> Result[Float64, Text]:
    let dot: Float64 = vec_dot_compensated(a, b)?
    let na: Float64 = vec_l2_norm(a)
    let nb: Float64 = vec_l2_norm(b)
    if na == 0.0 or nb == 0.0:
        return err("vec_cosine_similarity undefined for zero-norm vector")
    return ok(dot / (na * nb))

fn vec_zscore_normalize(xs: List[Float64]) -> Result[List[Float64], Text]:
    let desc: StatsSummary = stats_describe(xs)?
    if desc.std_dev_sample == 0.0:
        return err("vec_zscore_normalize undefined for constant vector")
    let n: Number = list_count(xs)
    let out: List[Float64] = List[Float64]()
    var i: Number = 0
    while i < n:
        list_push(out, (list_get(xs, i) - desc.mean) / desc.std_dev_sample)
        set i = i + 1
    return ok(out)

fn vec_minmax_scale(xs: List[Float64]) -> Result[List[Float64], Text]:
    let desc: StatsSummary = stats_describe(xs)?
    let span: Float64 = desc.max - desc.min
    if span == 0.0:
        return err("vec_minmax_scale undefined for constant vector")
    let n: Number = list_count(xs)
    let out: List[Float64] = List[Float64]()
    var i: Number = 0
    while i < n:
        list_push(out, (list_get(xs, i) - desc.min) / span)
        set i = i + 1
    return ok(out)

fn vec_ewma(xs: List[Float64], alpha: Float64) -> Result[List[Float64], Text]:
    let n: Number = list_count(xs)
    if n == 0:
        return err("vec_ewma requires non-empty input")
    if math_is_nan_float64(alpha) or alpha <= 0.0 or alpha > 1.0:
        return err("vec_ewma smoothing factor alpha must be in (0.0, 1.0]")
    let out: List[Float64] = List[Float64]()
    var s: Float64 = list_get(xs, 0)
    list_push(out, s)
    var i: Number = 1
    while i < n:
        set s = alpha * list_get(xs, i) + (1.0 - alpha) * s
        list_push(out, s)
        set i = i + 1
    return ok(out)

# --- 2D Contiguous DenseMatrix Linear Algebra ---

fn mat_zeros(rows: Number, cols: Number) -> DenseMatrix:
    return DenseMatrix(rows, cols, vec_zeros(rows * cols))

fn mat_identity(n: Number) -> DenseMatrix:
    let m: DenseMatrix = mat_zeros(n, n)
    var i: Number = 0
    while i < n:
        list_set(m.data, i * n + i, 1.0)
        set i = i + 1
    return m

fn mat_get(m: DenseMatrix, r: Number, c: Number) -> Float64:
    return list_get(m.data, r * m.cols + c)

fn mat_set(m: DenseMatrix, r: Number, c: Number, val: Float64) -> Boolean:
    list_set(m.data, r * m.cols + c, val)
    return true

fn mat_transpose(m: DenseMatrix) -> DenseMatrix:
    let out: DenseMatrix = mat_zeros(m.cols, m.rows)
    var r: Number = 0
    while r < m.rows:
        var c: Number = 0
        while c < m.cols:
            let _s: Boolean = mat_set(out, c, r, mat_get(m, r, c))
            set c = c + 1
        set r = r + 1
    return out

fn mat_matvec(m: DenseMatrix, v: List[Float64]) -> Result[List[Float64], Text]:
    if m.cols != list_count(v):
        return err("mat_matvec dimension mismatch")
    let out: List[Float64] = List[Float64]()
    var r: Number = 0
    while r < m.rows:
        var sum: Float64 = 0.0
        var comp: Float64 = 0.0
        let row_offset: Number = r * m.cols
        var c: Number = 0
        while c < m.cols:
            let prod: Float64 = list_get(m.data, row_offset + c) * list_get(v, c)
            let t: Float64 = sum + prod
            if math_abs_float64(sum) >= math_abs_float64(prod):
                set comp = comp + ((sum - t) + prod)
            else:
                set comp = comp + ((prod - t) + sum)
            set sum = t
            set c = c + 1
        list_push(out, sum + comp)
        set r = r + 1
    return ok(out)

fn mat_matmul(a: DenseMatrix, b: DenseMatrix) -> Result[DenseMatrix, Text]:
    if a.cols != b.rows:
        return err("mat_matmul inner dimensions do not match")
    let out: DenseMatrix = mat_zeros(a.rows, b.cols)
    var i: Number = 0
    while i < a.rows:
        var j: Number = 0
        while j < b.cols:
            var sum: Float64 = 0.0
            var comp: Float64 = 0.0
            var k: Number = 0
            while k < a.cols:
                let prod: Float64 = mat_get(a, i, k) * mat_get(b, k, j)
                let t: Float64 = sum + prod
                if math_abs_float64(sum) >= math_abs_float64(prod):
                    set comp = comp + ((sum - t) + prod)
                else:
                    set comp = comp + ((prod - t) + sum)
                set sum = t
                set k = k + 1
            let _s: Boolean = mat_set(out, i, j, sum + comp)
            set j = j + 1
        set i = i + 1
    return ok(out)

# Solves A * x = b using Gaussian Elimination with Partial Pivoting + Back-Substitution
fn mat_solve_linear(a: DenseMatrix, b: List[Float64]) -> Result[List[Float64], Text]:
    let n: Number = a.rows
    if n == 0 or a.cols != n or list_count(b) != n:
        return err("mat_solve_linear requires a non-empty square matrix A and matching vector b")
    # Clone A and b so inputs are not mutated
    let aug: DenseMatrix = mat_zeros(n, n)
    let rhs: List[Float64] = List[Float64]()
    var idx: Number = 0
    while idx < n * n:
        list_set(aug.data, idx, list_get(a.data, idx))
        set idx = idx + 1
    var bi: Number = 0
    while bi < n:
        list_push(rhs, list_get(b, bi))
        set bi = bi + 1

    # Forward elimination with partial pivoting
    var col: Number = 0
    while col < n:
        var pivot_row: Number = col
        var max_val: Float64 = math_abs_float64(mat_get(aug, col, col))
        var r_scan: Number = col + 1
        while r_scan < n:
            let cand: Float64 = math_abs_float64(mat_get(aug, r_scan, col))
            if cand > max_val:
                set max_val = cand
                set pivot_row = r_scan
            set r_scan = r_scan + 1
        if not math_is_finite_float64(max_val) or max_val < 0.000000000001:
            return err("mat_solve_linear singular or near-singular matrix")

        if pivot_row != col:
            var swap_c: Number = col
            while swap_c < n:
                let tmp: Float64 = mat_get(aug, col, swap_c)
                let _s1: Boolean = mat_set(aug, col, swap_c, mat_get(aug, pivot_row, swap_c))
                let _s2: Boolean = mat_set(aug, pivot_row, swap_c, tmp)
                set swap_c = swap_c + 1
            let tmp_rhs: Float64 = list_get(rhs, col)
            list_set(rhs, col, list_get(rhs, pivot_row))
            list_set(rhs, pivot_row, tmp_rhs)

        let pivot_val: Float64 = mat_get(aug, col, col)
        var row: Number = col + 1
        while row < n:
            let factor: Float64 = mat_get(aug, row, col) / pivot_val
            let _z: Boolean = mat_set(aug, row, col, 0.0)
            var c2: Number = col + 1
            while c2 < n:
                let updated: Float64 = mat_get(aug, row, c2) - factor * mat_get(aug, col, c2)
                let _u: Boolean = mat_set(aug, row, c2, updated)
                set c2 = c2 + 1
            list_set(rhs, row, list_get(rhs, row) - factor * list_get(rhs, col))
            set row = row + 1
        set col = col + 1

    # Back-substitution
    let x: List[Float64] = vec_zeros(n)
    var back_r: Number = n - 1
    while back_r >= 0:
        var sum: Float64 = list_get(rhs, back_r)
        var back_c: Number = back_r + 1
        while back_c < n:
            set sum = sum - mat_get(aug, back_r, back_c) * list_get(x, back_c)
            set back_c = back_c + 1
        list_set(x, back_r, sum / mat_get(aug, back_r, back_r))
        set back_r = back_r - 1
    return ok(x)
