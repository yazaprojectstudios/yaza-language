# YAZA Data Science Engine — Frontend SVG Data Visualization Standard Library (ggplot2 / Seaborn / Plotly Alternative).
# Generates responsive, zero-JS, CSP-compliant vector SVG charts with native <title> tooltips for YAZA MVC views.

use "std/math"
use "std/data/stats"
use "std/data/matrix"
use "std/data/frame"
use "std/data/ml"

shape ChartConfig:
    title: Text
    subtitle: Text
    x_label: Text
    y_label: Text
    accent_hex: Text

fn viz_config(title: Text, subtitle: Text, x_label: Text, y_label: Text, accent_hex: Text) -> ChartConfig:
    var color: Text = accent_hex
    if text_length(color) == 0:
        set color = "#10b981"
    return ChartConfig(title, subtitle, x_label, y_label, color)

fn viz_default_config(title: Text, x_label: Text, y_label: Text) -> ChartConfig:
    return ChartConfig(title, "YAZA Zero-GC Arena Data Science Engine", x_label, y_label, "#10b981")

fn viz_escape(raw: Text) -> Text:
    let len: Number = text_length(raw)
    let parts: TextList = text_list()
    var i: Number = 0
    while i < len:
        let b: Number = text_byte(raw, i)
        if b == 38: list_push(parts, "&amp;")
        elif b == 60: list_push(parts, "&lt;")
        elif b == 62: list_push(parts, "&gt;")
        elif b == 34: list_push(parts, "&quot;")
        elif b == 39: list_push(parts, "&#39;")
        else: list_push(parts, text_slice(raw, i, 1))
        set i = i + 1
    return text_join(parts, "")

fn viz_fmt_num(v: Float64) -> Text:
    if not math_is_finite_float64(v):
        return "NaN"
    let rounded: Float64 = math_round_float64(v * 100.0) / 100.0
    return float64_text(rounded)

fn viz_scale_linear(val: Float64, domain_min: Float64, domain_max: Float64, range_min: Float64, range_max: Float64) -> Float64:
    let span: Float64 = domain_max - domain_min
    if span == 0.0:
        return (range_min + range_max) * 0.5
    let ratio: Float64 = (val - domain_min) / span
    return range_min + ratio * (range_max - range_min)

fn viz_svg_frame_open(cfg: ChartConfig, badge_text: Text) -> Text:
    let out: TextList = text_list()
    list_push(out, "<figure class=\"yz-viz-card\">")
    list_push(out, "<svg class=\"yz-viz-svg\" viewBox=\"0 0 760 380\" role=\"img\" aria-label=\"" + viz_escape(cfg.title) + "\">")
    list_push(out, "<rect x=\"0\" y=\"0\" width=\"760\" height=\"380\" rx=\"14\" fill=\"#0b1120\" stroke=\"#1e293b\" stroke-width=\"1.5\"/>")
    list_push(out, "<text x=\"28\" y=\"34\" fill=\"#f8fafc\" font-family=\"system-ui,-apple-system,sans-serif\" font-size=\"16\" font-weight=\"700\">" + viz_escape(cfg.title) + "</text>")
    list_push(out, "<text x=\"28\" y=\"54\" fill=\"#94a3b8\" font-family=\"system-ui,-apple-system,sans-serif\" font-size=\"12\">" + viz_escape(cfg.subtitle) + "</text>")
    if text_length(badge_text) > 0:
        list_push(out, "<rect x=\"490\" y=\"18\" width=\"244\" height=\"26\" rx=\"13\" fill=\"#111827\" stroke=\"#334155\" stroke-width=\"1\"/>")
        list_push(out, "<text x=\"612\" y=\"35\" text-anchor=\"middle\" fill=\"" + viz_escape(cfg.accent_hex) + "\" font-family=\"ui-monospace,monospace\" font-size=\"11\" font-weight=\"600\">" + viz_escape(badge_text) + "</text>")
    # Plot canvas background & gridlines (x: 68..728, y: 74..314)
    list_push(out, "<rect x=\"68\" y=\"74\" width=\"660\" height=\"240\" fill=\"#0f172a\" stroke=\"#1e293b\" stroke-width=\"1\"/>")
    var g: Number = 1
    while g < 4:
        let gy: Number = 74 + g * 60
        list_push(out, "<line x1=\"68\" y1=\"" + number_text(gy) + "\" x2=\"728\" y2=\"" + number_text(gy) + "\" stroke=\"#1e293b\" stroke-dasharray=\"4 4\" stroke-width=\"1\"/>")
        set g = g + 1
    return text_join(out, "")

fn viz_svg_axes_and_close(cfg: ChartConfig, y_min: Float64, y_max: Float64, x_left_text: Text, x_right_text: Text, footer_text: Text) -> Text:
    let out: TextList = text_list()
    let y_mid: Float64 = (y_min + y_max) * 0.5
    list_push(out, "<text x=\"60\" y=\"80\" text-anchor=\"end\" fill=\"#64748b\" font-family=\"ui-monospace,monospace\" font-size=\"10\">" + viz_fmt_num(y_max) + "</text>")
    list_push(out, "<text x=\"60\" y=\"198\" text-anchor=\"end\" fill=\"#64748b\" font-family=\"ui-monospace,monospace\" font-size=\"10\">" + viz_fmt_num(y_mid) + "</text>")
    list_push(out, "<text x=\"60\" y=\"314\" text-anchor=\"end\" fill=\"#64748b\" font-family=\"ui-monospace,monospace\" font-size=\"10\">" + viz_fmt_num(y_min) + "</text>")
    if text_length(x_left_text) > 0:
        list_push(out, "<text x=\"68\" y=\"332\" text-anchor=\"start\" fill=\"#64748b\" font-family=\"ui-monospace,monospace\" font-size=\"10\">" + viz_escape(x_left_text) + "</text>")
    if text_length(x_right_text) > 0:
        list_push(out, "<text x=\"728\" y=\"332\" text-anchor=\"end\" fill=\"#64748b\" font-family=\"ui-monospace,monospace\" font-size=\"10\">" + viz_escape(x_right_text) + "</text>")
    list_push(out, "<text x=\"398\" y=\"348\" text-anchor=\"middle\" fill=\"#94a3b8\" font-family=\"system-ui,-apple-system,sans-serif\" font-size=\"11\" font-weight=\"600\">" + viz_escape(cfg.x_label) + " · " + viz_escape(cfg.y_label) + "</text>")
    list_push(out, "<text x=\"28\" y=\"368\" fill=\"#64748b\" font-family=\"ui-monospace,monospace\" font-size=\"10\">" + viz_escape(footer_text) + "</text>")
    list_push(out, "</svg></figure>")
    return text_join(out, "")

# 1. Line & Area Trend Chart (Time-Series / Continuous Signal)
fn viz_line_chart(cfg: ChartConfig, xs: List[Float64], ys: List[Float64]) -> Result[Text, Text]:
    let n: Number = list_count(xs)
    if n < 2 or n != list_count(ys):
        return err("viz_line_chart requires equal-length xs and ys with count >= 2")
    let dx: StatsSummary = stats_describe(xs)?
    let dy: StatsSummary = stats_describe(ys)?
    let badge: Text = "mean=" + viz_fmt_num(dy.mean) + " · sd=" + viz_fmt_num(dy.std_dev_sample)

    let out: TextList = text_list()
    list_push(out, viz_svg_frame_open(cfg, badge))

    let poly_pts: TextList = text_list()
    let area_pts: TextList = text_list()
    list_push(area_pts, "68,314")
    var i: Number = 0
    while i < n:
        let px: Float64 = viz_scale_linear(list_get(xs, i), dx.min, dx.max, 76.0, 720.0)
        let py: Float64 = viz_scale_linear(list_get(ys, i), dy.min, dy.max, 302.0, 86.0)
        let pt_str: Text = viz_fmt_num(px) + "," + viz_fmt_num(py)
        list_push(poly_pts, pt_str)
        list_push(area_pts, pt_str)
        set i = i + 1
    list_push(area_pts, "720,314")

    list_push(out, "<polygon points=\"" + text_join(area_pts, " ") + "\" fill=\"" + viz_escape(cfg.accent_hex) + "\" fill-opacity=\"0.14\"/>")
    list_push(out, "<polyline points=\"" + text_join(poly_pts, " ") + "\" fill=\"none\" stroke=\"" + viz_escape(cfg.accent_hex) + "\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>")

    var j: Number = 0
    var step: Number = 1
    if n > 64:
        set step = n / 40
    while j < n:
        let vx: Float64 = list_get(xs, j)
        let vy: Float64 = list_get(ys, j)
        let cx: Float64 = viz_scale_linear(vx, dx.min, dx.max, 76.0, 720.0)
        let cy: Float64 = viz_scale_linear(vy, dy.min, dy.max, 302.0, 86.0)
        list_push(out, "<circle cx=\"" + viz_fmt_num(cx) + "\" cy=\"" + viz_fmt_num(cy) + "\" r=\"3.5\" fill=\"" + viz_escape(cfg.accent_hex) + "\" stroke=\"#0b1120\" stroke-width=\"1.2\"><title>(" + viz_fmt_num(vx) + ", " + viz_fmt_num(vy) + ")</title></circle>")
        set j = j + step

    let footer: Text = "n=" + number_text(n) + " | min=" + viz_fmt_num(dy.min) + " | max=" + viz_fmt_num(dy.max) + " | skew=" + viz_fmt_num(dy.skewness)
    list_push(out, viz_svg_axes_and_close(cfg, dy.min, dy.max, viz_fmt_num(dx.min), viz_fmt_num(dx.max), footer))
    return ok(text_join(out, ""))

# 2. Scatter Plot + Automatic OLS Regression Line (ggplot2 geom_point + geom_smooth(method="lm") / seaborn.regplot)
fn viz_scatter_regression_chart(cfg: ChartConfig, xs: List[Float64], ys: List[Float64]) -> Result[Text, Text]:
    let n: Number = list_count(xs)
    if n < 2 or n != list_count(ys):
        return err("viz_scatter_regression_chart requires equal-length xs and ys with count >= 2")
    let dx: StatsSummary = stats_describe(xs)?
    let dy: StatsSummary = stats_describe(ys)?
    let ols: OlsModel = ml_ols_fit(xs, ys)?
    let badge: Text = "R2=" + viz_fmt_num(ols.r_squared) + " · RMSE=" + viz_fmt_num(ols.rmse)

    let out: TextList = text_list()
    list_push(out, viz_svg_frame_open(cfg, badge))

    # Draw OLS regression line across [dx.min, dx.max]
    let y_hat_min: Float64 = ml_ols_predict(ols, dx.min)
    let y_hat_max: Float64 = ml_ols_predict(ols, dx.max)
    let rx1: Float64 = viz_scale_linear(dx.min, dx.min, dx.max, 76.0, 720.0)
    let ry1: Float64 = viz_scale_linear(y_hat_min, dy.min, dy.max, 302.0, 86.0)
    let rx2: Float64 = viz_scale_linear(dx.max, dx.min, dx.max, 76.0, 720.0)
    let ry2: Float64 = viz_scale_linear(y_hat_max, dy.min, dy.max, 302.0, 86.0)
    list_push(out, "<line x1=\"" + viz_fmt_num(rx1) + "\" y1=\"" + viz_fmt_num(ry1) + "\" x2=\"" + viz_fmt_num(rx2) + "\" y2=\"" + viz_fmt_num(ry2) + "\" stroke=\"#f59e0b\" stroke-width=\"2.2\" stroke-dasharray=\"6 4\"/>")

    var i: Number = 0
    while i < n:
        let vx: Float64 = list_get(xs, i)
        let vy: Float64 = list_get(ys, i)
        let cx: Float64 = viz_scale_linear(vx, dx.min, dx.max, 76.0, 720.0)
        let cy: Float64 = viz_scale_linear(vy, dy.min, dy.max, 302.0, 86.0)
        list_push(out, "<circle cx=\"" + viz_fmt_num(cx) + "\" cy=\"" + viz_fmt_num(cy) + "\" r=\"4.5\" fill=\"" + viz_escape(cfg.accent_hex) + "\" fill-opacity=\"0.85\" stroke=\"#0b1120\" stroke-width=\"1.2\"><title>(" + viz_fmt_num(vx) + ", " + viz_fmt_num(vy) + ")</title></circle>")
        set i = i + 1

    let footer: Text = "OLS: y = " + viz_fmt_num(ols.intercept) + " + " + viz_fmt_num(ols.slope) + "*x | R2=" + viz_fmt_num(ols.r_squared) + " | MAE=" + viz_fmt_num(ols.mae)
    list_push(out, viz_svg_axes_and_close(cfg, dy.min, dy.max, viz_fmt_num(dx.min), viz_fmt_num(dx.max), footer))
    return ok(text_join(out, ""))

# 3. Categorical Bar Chart
fn viz_bar_chart(cfg: ChartConfig, categories: TextList, values: List[Float64]) -> Result[Text, Text]:
    let n: Number = list_count(categories)
    if n == 0 or n != list_count(values):
        return err("viz_bar_chart requires equal-length non-empty categories and values")
    let dv: StatsSummary = stats_describe(values)?
    var y_min: Float64 = 0.0
    if dv.min < 0.0:
        set y_min = dv.min
    var y_max: Float64 = dv.max
    if y_max <= y_min:
        set y_max = y_min + 1.0

    let badge: Text = "sum=" + viz_fmt_num(dv.sum) + " · max=" + viz_fmt_num(dv.max)
    let out: TextList = text_list()
    list_push(out, viz_svg_frame_open(cfg, badge))

    let slot_w: Float64 = 640.0 / float64_from_number(n)
    var bar_w: Float64 = slot_w * 0.62
    if bar_w > 72.0: set bar_w = 72.0
    if bar_w < 6.0: set bar_w = 6.0

    var i: Number = 0
    while i < n:
        let cat: Text = list_get(categories, i)
        let val: Float64 = list_get(values, i)
        let center_x: Float64 = 78.0 + (float64_from_number(i) + 0.5) * slot_w
        let bx: Float64 = center_x - (bar_w * 0.5)
        let top_y: Float64 = viz_scale_linear(val, y_min, y_max, 310.0, 92.0)
        var bh: Float64 = 310.0 - top_y
        if bh < 2.0: set bh = 2.0
        list_push(out, "<rect x=\"" + viz_fmt_num(bx) + "\" y=\"" + viz_fmt_num(top_y) + "\" width=\"" + viz_fmt_num(bar_w) + "\" height=\"" + viz_fmt_num(bh) + "\" rx=\"4\" fill=\"" + viz_escape(cfg.accent_hex) + "\"><title>" + viz_escape(cat) + ": " + viz_fmt_num(val) + "</title></rect>")
        list_push(out, "<text x=\"" + viz_fmt_num(center_x) + "\" y=\"" + viz_fmt_num(top_y - 6.0) + "\" text-anchor=\"middle\" fill=\"#e2e8f0\" font-family=\"ui-monospace,monospace\" font-size=\"10\">" + viz_fmt_num(val) + "</text>")
        list_push(out, "<text x=\"" + viz_fmt_num(center_x) + "\" y=\"328\" text-anchor=\"middle\" fill=\"#94a3b8\" font-family=\"system-ui,-apple-system,sans-serif\" font-size=\"10\">" + viz_escape(cat) + "</text>")
        set i = i + 1

    let footer: Text = "groups=" + number_text(n) + " | mean=" + viz_fmt_num(dv.mean) + " | total=" + viz_fmt_num(dv.sum)
    list_push(out, viz_svg_axes_and_close(cfg, y_min, y_max, "", "", footer))
    return ok(text_join(out, ""))

# 4. Distribution Histogram with Mean Reference Line (ggplot2 geom_histogram / seaborn.histplot)
fn viz_histogram_chart(cfg: ChartConfig, xs: List[Float64], bin_count: Number) -> Result[Text, Text]:
    let hist: HistogramBins = stats_histogram(xs, bin_count)?
    let desc: StatsSummary = stats_describe(xs)?
    var max_cnt: Number = 1
    var b: Number = 0
    while b < hist.bin_count:
        let c: Number = list_get(hist.counts, b)
        if c > max_cnt: set max_cnt = c
        set b = b + 1

    let badge: Text = "mean=" + viz_fmt_num(desc.mean) + " · sd=" + viz_fmt_num(desc.std_dev_sample)
    let out: TextList = text_list()
    list_push(out, viz_svg_frame_open(cfg, badge))

    let slot_w: Float64 = 644.0 / float64_from_number(hist.bin_count)
    var i: Number = 0
    while i < hist.bin_count:
        let cnt: Number = list_get(hist.counts, i)
        let center_v: Float64 = list_get(hist.centers, i)
        let bx: Float64 = 76.0 + float64_from_number(i) * slot_w + 1.5
        var bw: Float64 = slot_w - 3.0
        if bw < 2.0: set bw = 2.0
        let top_y: Float64 = viz_scale_linear(float64_from_number(cnt), 0.0, float64_from_number(max_cnt), 310.0, 88.0)
        let bh: Float64 = 310.0 - top_y
        list_push(out, "<rect x=\"" + viz_fmt_num(bx) + "\" y=\"" + viz_fmt_num(top_y) + "\" width=\"" + viz_fmt_num(bw) + "\" height=\"" + viz_fmt_num(bh) + "\" rx=\"2\" fill=\"" + viz_escape(cfg.accent_hex) + "\" fill-opacity=\"0.82\"><title>bin=" + viz_fmt_num(center_v) + " count=" + number_text(cnt) + "</title></rect>")
        set i = i + 1

    let mean_x: Float64 = viz_scale_linear(desc.mean, hist.min_edge, hist.max_edge, 76.0, 720.0)
    list_push(out, "<line x1=\"" + viz_fmt_num(mean_x) + "\" y1=\"76\" x2=\"" + viz_fmt_num(mean_x) + "\" y2=\"312\" stroke=\"#f43f5e\" stroke-width=\"2\" stroke-dasharray=\"5 3\"/>")

    let footer: Text = "n=" + number_text(desc.count) + " | bins=" + number_text(hist.bin_count) + " | skew=" + viz_fmt_num(desc.skewness) + " | kurtosis=" + viz_fmt_num(desc.excess_kurtosis)
    list_push(out, viz_svg_axes_and_close(cfg, 0.0, float64_from_number(max_cnt), viz_fmt_num(hist.min_edge), viz_fmt_num(hist.max_edge), footer))
    return ok(text_join(out, ""))

# 5. Multi-Group Box-and-Whisker Plot (R boxplot / seaborn.boxplot: min, Q25, Median, Q75, max, IQR, MAD)
fn viz_boxplot_chart(cfg: ChartConfig, group_names: TextList, groups: List[List[Float64]]) -> Result[Text, Text]:
    let k: Number = list_count(groups)
    if k == 0 or k != list_count(group_names):
        return err("viz_boxplot_chart requires equal-length non-empty group_names and groups")

    let summaries: List[FiveNumberSummary] = List[FiveNumberSummary]()
    var global_min: Float64 = math_positive_infinity_float64()
    var global_max: Float64 = math_negative_infinity_float64()
    var g: Number = 0
    while g < k:
        let fns: FiveNumberSummary = stats_five_number_summary(list_get(groups, g))?
        if fns.min < global_min: set global_min = fns.min
        if fns.max > global_max: set global_max = fns.max
        list_push(summaries, fns)
        set g = g + 1

    let out: TextList = text_list()
    list_push(out, viz_svg_frame_open(cfg, "Five-Number Summary · IQR & MAD"))

    let slot_w: Float64 = 640.0 / float64_from_number(k)
    var box_w: Float64 = slot_w * 0.45
    if box_w > 64.0: set box_w = 64.0
    if box_w < 12.0: set box_w = 12.0

    var i: Number = 0
    while i < k:
        let gname: Text = list_get(group_names, i)
        let s: FiveNumberSummary = list_get(summaries, i)
        let cx: Float64 = 78.0 + (float64_from_number(i) + 0.5) * slot_w
        let bx: Float64 = cx - (box_w * 0.5)
        let y_min: Float64 = viz_scale_linear(s.min, global_min, global_max, 304.0, 86.0)
        let y_q25: Float64 = viz_scale_linear(s.q25, global_min, global_max, 304.0, 86.0)
        let y_med: Float64 = viz_scale_linear(s.median, global_min, global_max, 304.0, 86.0)
        let y_q75: Float64 = viz_scale_linear(s.q75, global_min, global_max, 304.0, 86.0)
        let y_max: Float64 = viz_scale_linear(s.max, global_min, global_max, 304.0, 86.0)
        var box_h: Float64 = y_q25 - y_q75
        if box_h < 2.0: set box_h = 2.0

        # Whisker vertical spine + caps
        list_push(out, "<line x1=\"" + viz_fmt_num(cx) + "\" y1=\"" + viz_fmt_num(y_max) + "\" x2=\"" + viz_fmt_num(cx) + "\" y2=\"" + viz_fmt_num(y_min) + "\" stroke=\"#64748b\" stroke-width=\"1.5\"/>")
        list_push(out, "<line x1=\"" + viz_fmt_num(cx - 10.0) + "\" y1=\"" + viz_fmt_num(y_max) + "\" x2=\"" + viz_fmt_num(cx + 10.0) + "\" y2=\"" + viz_fmt_num(y_max) + "\" stroke=\"#94a3b8\" stroke-width=\"1.5\"/>")
        list_push(out, "<line x1=\"" + viz_fmt_num(cx - 10.0) + "\" y1=\"" + viz_fmt_num(y_min) + "\" x2=\"" + viz_fmt_num(cx + 10.0) + "\" y2=\"" + viz_fmt_num(y_min) + "\" stroke=\"#94a3b8\" stroke-width=\"1.5\"/>")
        # IQR Q25..Q75 box + Median line
        list_push(out, "<rect x=\"" + viz_fmt_num(bx) + "\" y=\"" + viz_fmt_num(y_q75) + "\" width=\"" + viz_fmt_num(box_w) + "\" height=\"" + viz_fmt_num(box_h) + "\" rx=\"3\" fill=\"" + viz_escape(cfg.accent_hex) + "\" fill-opacity=\"0.30\" stroke=\"" + viz_escape(cfg.accent_hex) + "\" stroke-width=\"1.8\"><title>" + viz_escape(gname) + " | median=" + viz_fmt_num(s.median) + " IQR=" + viz_fmt_num(s.iqr) + " MAD=" + viz_fmt_num(s.mad) + "</title></rect>")
        list_push(out, "<line x1=\"" + viz_fmt_num(bx) + "\" y1=\"" + viz_fmt_num(y_med) + "\" x2=\"" + viz_fmt_num(bx + box_w) + "\" y2=\"" + viz_fmt_num(y_med) + "\" stroke=\"#f8fafc\" stroke-width=\"2.4\"/>")
        list_push(out, "<text x=\"" + viz_fmt_num(cx) + "\" y=\"328\" text-anchor=\"middle\" fill=\"#94a3b8\" font-family=\"system-ui,-apple-system,sans-serif\" font-size=\"10\">" + viz_escape(gname) + "</text>")
        set i = i + 1

    let footer: Text = "groups=" + number_text(k) + " | range=[" + viz_fmt_num(global_min) + ", " + viz_fmt_num(global_max) + "]"
    list_push(out, viz_svg_axes_and_close(cfg, global_min, global_max, "", "", footer))
    return ok(text_join(out, ""))

# 6. 2D Matrix / Correlation Heatmap with Cell Annotations (seaborn.heatmap(annot=True) alternative)
fn viz_heatmap_matrix(cfg: ChartConfig, row_labels: TextList, col_labels: TextList, mat: DenseMatrix) -> Result[Text, Text]:
    if mat.rows == 0 or mat.cols == 0 or list_count(row_labels) != mat.rows or list_count(col_labels) != mat.cols:
        return err("viz_heatmap_matrix dimension mismatch between labels and DenseMatrix")
    let desc: StatsSummary = stats_describe(mat.data)?
    let out: TextList = text_list()
    list_push(out, viz_svg_frame_open(cfg, "min=" + viz_fmt_num(desc.min) + " · max=" + viz_fmt_num(desc.max)))

    let cell_w: Float64 = 640.0 / float64_from_number(mat.cols)
    let cell_h: Float64 = 224.0 / float64_from_number(mat.rows)

    var r: Number = 0
    while r < mat.rows:
        let cy: Float64 = 80.0 + float64_from_number(r) * cell_h
        var c: Number = 0
        while c < mat.cols:
            let cx: Float64 = 78.0 + float64_from_number(c) * cell_w
            let val: Float64 = mat_get(mat, r, c)
            let norm: Float64 = viz_scale_linear(val, desc.min, desc.max, 0.18, 0.92)
            list_push(out, "<rect x=\"" + viz_fmt_num(cx) + "\" y=\"" + viz_fmt_num(cy) + "\" width=\"" + viz_fmt_num(cell_w - 4.0) + "\" height=\"" + viz_fmt_num(cell_h - 4.0) + "\" rx=\"4\" fill=\"" + viz_escape(cfg.accent_hex) + "\" fill-opacity=\"" + viz_fmt_num(norm) + "\"><title>" + viz_escape(list_get(row_labels, r)) + " x " + viz_escape(list_get(col_labels, c)) + " = " + viz_fmt_num(val) + "</title></rect>")
            list_push(out, "<text x=\"" + viz_fmt_num(cx + (cell_w * 0.5)) + "\" y=\"" + viz_fmt_num(cy + (cell_h * 0.55)) + "\" text-anchor=\"middle\" fill=\"#f8fafc\" font-family=\"ui-monospace,monospace\" font-size=\"11\" font-weight=\"600\">" + viz_fmt_num(val) + "</text>")
            set c = c + 1
        set r = r + 1

    let footer: Text = "matrix=" + number_text(mat.rows) + "x" + number_text(mat.cols) + " | mean=" + viz_fmt_num(desc.mean)
    list_push(out, viz_svg_axes_and_close(cfg, desc.min, desc.max, "", "", footer))
    return ok(text_join(out, ""))
