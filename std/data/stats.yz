# YAZA Data Science Engine — High-Accuracy Compensated Statistics, Order Statistics & Hypothesis Testing.
# Uses Neumaier compensated summation and Welford/Pébay one-pass recurrence to prevent catastrophic cancellation.

use "std/math"

shape StatsSummary:
    count: Number
    sum: Float64
    mean: Float64
    variance_sample: Float64
    variance_pop: Float64
    std_dev_sample: Float64
    std_dev_pop: Float64
    std_error: Float64
    min: Float64
    max: Float64
    skewness: Float64
    excess_kurtosis: Float64

shape FiveNumberSummary:
    min: Float64
    q25: Float64
    median: Float64
    q75: Float64
    max: Float64
    iqr: Float64
    mad: Float64

shape WelchTTestResult:
    t_stat: Float64
    degrees_of_freedom: Float64
    p_value_two_tailed: Float64
    mean_diff: Float64
    significant_at_05: Boolean

shape AnovaOneWayResult:
    f_stat: Float64
    df_between: Number
    df_within: Number
    ss_between: Float64
    ss_within: Float64
    eta_squared: Float64
    significant_at_05: Boolean

shape ChiSquareResult:
    chi_square_stat: Float64
    degrees_of_freedom: Number
    p_value: Float64
    significant_at_05: Boolean

shape HistogramBins:
    bin_count: Number
    min_edge: Float64
    max_edge: Float64
    bin_width: Float64
    centers: List[Float64]
    counts: List[Number]
    densities: List[Float64]

# Neumaier (1974) improved Kahan-Babuska compensated summation:
# Achieves O(eps) error independent of N and handles terms larger than the running sum (e.g. [1e16, 1.0, -1e16] == 1.0).
fn stats_sum_compensated(xs: List[Float64]) -> Float64:
    let n: Number = list_count(xs)
    if n == 0:
        return 0.0
    var sum: Float64 = 0.0
    var c: Float64 = 0.0
    var i: Number = 0
    while i < n:
        let x: Float64 = list_get(xs, i)
        let t: Float64 = sum + x
        if math_abs_float64(sum) >= math_abs_float64(x):
            set c = c + ((sum - t) + x)
        else:
            set c = c + ((x - t) + sum)
        set sum = t
        set i = i + 1
    return sum + c

fn stats_mean_compensated(xs: List[Float64]) -> Float64:
    let n: Number = list_count(xs)
    if n == 0:
        return math_nan_float64()
    return stats_sum_compensated(xs) / float64_from_number(n)

# Welford (1962) / Terriberry (2007) one-pass numerically stable online moments (mean, variance, skewness, kurtosis).
# Immune to catastrophic cancellation even when mean >> std_dev (e.g. 1e9 +/- 1.0).
fn stats_describe(xs: List[Float64]) -> Result[StatsSummary, Text]:
    let n: Number = list_count(xs)
    if n == 0:
        return err("stats_describe requires a non-empty List[Float64]")
    var count: Number = 0
    var mean: Float64 = 0.0
    var m2: Float64 = 0.0
    var m3: Float64 = 0.0
    var m4: Float64 = 0.0
    var min_v: Float64 = list_get(xs, 0)
    var max_v: Float64 = min_v
    var sum: Float64 = 0.0
    var comp: Float64 = 0.0

    var i: Number = 0
    while i < n:
        let x: Float64 = list_get(xs, i)
        if x < min_v: set min_v = x
        if x > max_v: set max_v = x

        # Compensated sum
        let t: Float64 = sum + x
        if math_abs_float64(sum) >= math_abs_float64(x):
            set comp = comp + ((sum - t) + x)
        else:
            set comp = comp + ((x - t) + sum)
        set sum = t

        # Higher-order Welford recurrence
        let n1: Number = count
        set count = count + 1
        let nf: Float64 = float64_from_number(count)
        let n1f: Float64 = float64_from_number(n1)
        let delta: Float64 = x - mean
        let delta_n: Float64 = delta / nf
        let delta_n2: Float64 = delta_n * delta_n
        let term1: Float64 = delta * delta_n * n1f
        set mean = mean + delta_n
        set m4 = m4 + term1 * delta_n2 * (nf * nf - 3.0 * nf + 3.0) + 6.0 * delta_n2 * m2 - 4.0 * delta_n * m3
        set m3 = m3 + term1 * delta_n * (nf - 2.0) - 3.0 * delta_n * m2
        set m2 = m2 + term1
        set i = i + 1

    let total_sum: Float64 = sum + comp
    let n_float: Float64 = float64_from_number(n)
    let var_pop: Float64 = m2 / n_float
    var var_sample: Float64 = 0.0
    if n > 1:
        set var_sample = m2 / float64_from_number(n - 1)
    let sd_pop: Float64 = math_sqrt_float64(var_pop)
    let sd_sample: Float64 = math_sqrt_float64(var_sample)
    let std_err: Float64 = sd_sample / math_sqrt_float64(n_float)

    var skew: Float64 = 0.0
    var kurt: Float64 = 0.0
    if m2 > 0.0:
        set skew = (math_sqrt_float64(n_float) * m3) / math_pow_float64(m2, 1.5)
        set kurt = ((n_float * m4) / (m2 * m2)) - 3.0

    return ok(StatsSummary(n, total_sum, mean, var_sample, var_pop, sd_sample, sd_pop, std_err, min_v, max_v, skew, kurt))

# Ciura gap sequence ShellSort (O(N log^2 N), zero recursive stack frames, cache-contiguous in arena)
fn stats_sort_asc(xs: List[Float64]) -> List[Float64]:
    let n: Number = list_count(xs)
    let out: List[Float64] = List[Float64]()
    var i: Number = 0
    while i < n:
        list_push(out, list_get(xs, i))
        set i = i + 1
    var gap: Number = n / 2
    while gap > 0:
        var j: Number = gap
        while j < n:
            let temp: Float64 = list_get(out, j)
            var k: Number = j
            while k >= gap and list_get(out, k - gap) > temp:
                list_set(out, k, list_get(out, k - gap))
                set k = k - gap
            list_set(out, k, temp)
            set j = j + 1
        if gap == 2:
            set gap = 1
        else:
            set gap = (gap * 10) / 22
    return out

# R Type-7 / NumPy default linear-interpolated quantile on a pre-sorted ascending List[Float64]
fn stats_quantile_sorted(sorted_xs: List[Float64], p: Float64) -> Result[Float64, Text]:
    let n: Number = list_count(sorted_xs)
    if n == 0:
        return err("stats_quantile_sorted requires a non-empty list")
    if p < 0.0 or p > 1.0:
        return err("quantile probability p must be in [0.0, 1.0]")
    if n == 1 or p == 0.0:
        return ok(list_get(sorted_xs, 0))
    if p == 1.0:
        return ok(list_get(sorted_xs, n - 1))
    let h: Float64 = float64_from_number(n - 1) * p
    let lo_f: Float64 = math_floor_float64(h)
    let lo_idx: Number = number_from_float64(lo_f)
    let frac: Float64 = h - lo_f
    let v_lo: Float64 = list_get(sorted_xs, lo_idx)
    if lo_idx + 1 >= n or frac == 0.0:
        return ok(v_lo)
    let v_hi: Float64 = list_get(sorted_xs, lo_idx + 1)
    return ok(v_lo + frac * (v_hi - v_lo))

fn stats_quantile(xs: List[Float64], p: Float64) -> Result[Float64, Text]:
    let sorted_xs: List[Float64] = stats_sort_asc(xs)
    return stats_quantile_sorted(sorted_xs, p)

fn stats_median(xs: List[Float64]) -> Result[Float64, Text]:
    return stats_quantile(xs, 0.5)

fn stats_five_number_summary(xs: List[Float64]) -> Result[FiveNumberSummary, Text]:
    let n: Number = list_count(xs)
    if n == 0:
        return err("stats_five_number_summary requires a non-empty list")
    let sorted_xs: List[Float64] = stats_sort_asc(xs)
    let min_v: Float64 = list_get(sorted_xs, 0)
    let max_v: Float64 = list_get(sorted_xs, n - 1)
    let q25: Float64 = stats_quantile_sorted(sorted_xs, 0.25)?
    let med: Float64 = stats_quantile_sorted(sorted_xs, 0.50)?
    let q75: Float64 = stats_quantile_sorted(sorted_xs, 0.75)?
    let iqr: Float64 = q75 - q25

    let abs_devs: List[Float64] = List[Float64]()
    var i: Number = 0
    while i < n:
        list_push(abs_devs, math_abs_float64(list_get(sorted_xs, i) - med))
        set i = i + 1
    let sorted_devs: List[Float64] = stats_sort_asc(abs_devs)
    let mad: Float64 = stats_quantile_sorted(sorted_devs, 0.50)?
    return ok(FiveNumberSummary(min_v, q25, med, q75, max_v, iqr, mad))

# One-pass numerically stable sample covariance & Pearson correlation coefficient r
fn stats_covariance(xs: List[Float64], ys: List[Float64]) -> Result[Float64, Text]:
    let n: Number = list_count(xs)
    if n != list_count(ys):
        return err("stats_covariance requires equal-length vectors")
    if n < 2:
        return err("stats_covariance requires at least 2 observations")
    var mean_x: Float64 = 0.0
    var mean_y: Float64 = 0.0
    var c_xy: Float64 = 0.0
    var i: Number = 0
    while i < n:
        let x: Float64 = list_get(xs, i)
        let y: Float64 = list_get(ys, i)
        let nf: Float64 = float64_from_number(i + 1)
        let dx: Float64 = x - mean_x
        set mean_x = mean_x + (dx / nf)
        set mean_y = mean_y + ((y - mean_y) / nf)
        let dy2: Float64 = y - mean_y
        set c_xy = c_xy + dx * dy2
        set i = i + 1
    return ok(c_xy / float64_from_number(n - 1))

fn stats_pearson_r(xs: List[Float64], ys: List[Float64]) -> Result[Float64, Text]:
    let n: Number = list_count(xs)
    if n != list_count(ys):
        return err("stats_pearson_r requires equal-length vectors")
    if n < 2:
        return err("stats_pearson_r requires at least 2 observations")
    var mean_x: Float64 = 0.0
    var mean_y: Float64 = 0.0
    var m2_x: Float64 = 0.0
    var m2_y: Float64 = 0.0
    var c_xy: Float64 = 0.0
    var i: Number = 0
    while i < n:
        let x: Float64 = list_get(xs, i)
        let y: Float64 = list_get(ys, i)
        let nf: Float64 = float64_from_number(i + 1)
        let dx1: Float64 = x - mean_x
        let dy1: Float64 = y - mean_y
        set mean_x = mean_x + (dx1 / nf)
        set mean_y = mean_y + (dy1 / nf)
        let dx2: Float64 = x - mean_x
        let dy2: Float64 = y - mean_y
        set m2_x = m2_x + dx1 * dx2
        set m2_y = m2_y + dy1 * dy2
        set c_xy = c_xy + dx1 * dy2
        set i = i + 1
    let denom: Float64 = math_sqrt_float64(m2_x * m2_y)
    if denom == 0.0:
        return err("stats_pearson_r undefined for zero-variance input")
    return ok(c_xy / denom)

# Standard Normal Cumulative Distribution Function Phi(z) = P(Z <= z)
fn stats_normal_cdf(z: Float64) -> Float64:
    return 0.5 * (1.0 + math_erf_float64(z / math_sqrt2()))

# Two-sample Welch's t-test (unequal variances, Welch-Satterthwaite degrees of freedom, Normal/Cornish-Fisher tail p-value)
fn stats_welch_ttest(sample_a: List[Float64], sample_b: List[Float64]) -> Result[WelchTTestResult, Text]:
    if list_count(sample_a) < 2 or list_count(sample_b) < 2:
        return err("stats_welch_ttest requires at least 2 observations per sample")
    let sum_a: StatsSummary = stats_describe(sample_a)?
    let sum_b: StatsSummary = stats_describe(sample_b)?
    let na: Float64 = float64_from_number(sum_a.count)
    let nb: Float64 = float64_from_number(sum_b.count)
    let va_n: Float64 = sum_a.variance_sample / na
    let vb_n: Float64 = sum_b.variance_sample / nb
    let se_diff: Float64 = math_sqrt_float64(va_n + vb_n)
    if se_diff == 0.0:
        return err("stats_welch_ttest standard error is zero")
    let diff: Float64 = sum_a.mean - sum_b.mean
    let t_val: Float64 = diff / se_diff
    let df_num: Float64 = (va_n + vb_n) * (va_n + vb_n)
    let df_den: Float64 = ((va_n * va_n) / (na - 1.0)) + ((vb_n * vb_n) / (nb - 1.0))
    let df: Float64 = df_num / df_den
    # Peizer-Pratt / Hill normal approximation to Student's t distribution for arbitrary df >= 2
    let abs_t: Float64 = math_abs_float64(t_val)
    let z_equiv: Float64 = math_sqrt_float64(df * math_ln_float64(1.0 + (abs_t * abs_t) / df)) * (1.0 - (1.0 / (4.0 * df)))
    let p_two_tailed: Float64 = 2.0 * (1.0 - stats_normal_cdf(z_equiv))
    return ok(WelchTTestResult(t_val, df, p_two_tailed, diff, p_two_tailed < 0.05))

# One-Way ANOVA F-Test across k >= 2 groups (R aov / scipy.stats.f_oneway alternative)
fn stats_anova_oneway(groups: List[List[Float64]]) -> Result[AnovaOneWayResult, Text]:
    let k: Number = list_count(groups)
    if k < 2:
        return err("stats_anova_oneway requires at least 2 groups")
    var total_n: Number = 0
    let all_vals: List[Float64] = List[Float64]()
    var g: Number = 0
    while g < k:
        let grp: List[Float64] = list_get(groups, g)
        let gn: Number = list_count(grp)
        if gn < 2:
            return err("stats_anova_oneway requires at least 2 observations per group")
        set total_n = total_n + gn
        var i: Number = 0
        while i < gn:
            list_push(all_vals, list_get(grp, i))
            set i = i + 1
        set g = g + 1

    let grand_mean: Float64 = stats_mean_compensated(all_vals)
    var ss_between: Float64 = 0.0
    var ss_within: Float64 = 0.0

    var g2: Number = 0
    while g2 < k:
        let grp2: List[Float64] = list_get(groups, g2)
        let gn2: Number = list_count(grp2)
        let g_desc: StatsSummary = stats_describe(grp2)?
        let diff_m: Float64 = g_desc.mean - grand_mean
        set ss_between = ss_between + float64_from_number(gn2) * diff_m * diff_m
        set ss_within = ss_within + g_desc.variance_sample * float64_from_number(gn2 - 1)
        set g2 = g2 + 1

    let df_between: Number = k - 1
    let df_within: Number = total_n - k
    if ss_within <= 0.0 or df_within <= 0:
        return err("stats_anova_oneway zero within-group variance")
    let ms_between: Float64 = ss_between / float64_from_number(df_between)
    let ms_within: Float64 = ss_within / float64_from_number(df_within)
    let f_stat: Float64 = ms_between / ms_within
    let eta_sq: Float64 = ss_between / (ss_between + ss_within)
    # Paulson-Cube-Root normal approximation to F(d1, d2) for alpha=0.05 significance check
    let d1: Float64 = float64_from_number(df_between)
    let d2: Float64 = float64_from_number(df_within)
    let f_cbrt: Float64 = math_pow_float64(f_stat, 1.0 / 3.0)
    let a_term: Float64 = 1.0 - (2.0 / (9.0 * d2))
    let b_term: Float64 = 1.0 - (2.0 / (9.0 * d1))
    let z_num: Float64 = a_term * f_cbrt - b_term
    let z_den: Float64 = math_sqrt_float64((2.0 / (9.0 * d2)) * f_cbrt * f_cbrt + (2.0 / (9.0 * d1)))
    let p_val: Float64 = 1.0 - stats_normal_cdf(z_num / z_den)
    return ok(AnovaOneWayResult(f_stat, df_between, df_within, ss_between, ss_within, eta_sq, p_val < 0.05))

# Chi-Square Goodness-of-Fit Test (R chisq.test alternative)
fn stats_chi_square_gof(observed: List[Float64], expected: List[Float64]) -> Result[ChiSquareResult, Text]:
    let k: Number = list_count(observed)
    if k < 2 or k != list_count(expected):
        return err("stats_chi_square_gof requires equal-length observed and expected lists with k >= 2")
    var chi2: Float64 = 0.0
    var i: Number = 0
    while i < k:
        let o: Float64 = list_get(observed, i)
        let e: Float64 = list_get(expected, i)
        if e <= 0.0:
            return err("stats_chi_square_gof expected frequencies must be > 0")
        let d: Float64 = o - e
        set chi2 = chi2 + ((d * d) / e)
        set i = i + 1
    let df: Number = k - 1
    let dff: Float64 = float64_from_number(df)
    # Wilson-Hilferty cube-root normal transformation for Chi-Square upper-tail p-value
    let h_term: Float64 = 2.0 / (9.0 * dff)
    let z: Float64 = (math_pow_float64(chi2 / dff, 1.0 / 3.0) - (1.0 - h_term)) / math_sqrt_float64(h_term)
    let p_val: Float64 = 1.0 - stats_normal_cdf(z)
    return ok(ChiSquareResult(chi2, df, p_val, p_val < 0.05))

# Time-Series Autocorrelation Function ACF(lag) (R acf alternative)
fn stats_autocorrelation(xs: List[Float64], lag: Number) -> Result[Float64, Text]:
    let n: Number = list_count(xs)
    if lag < 0 or lag >= n or n < 2:
        return err("stats_autocorrelation requires 0 <= lag < count(xs) and count >= 2")
    if lag == 0:
        return ok(1.0)
    let mean: Float64 = stats_mean_compensated(xs)
    var num: Float64 = 0.0
    var den: Float64 = 0.0
    var i: Number = 0
    while i < n:
        let d: Float64 = list_get(xs, i) - mean
        set den = den + d * d
        if i + lag < n:
            let d_lag: Float64 = list_get(xs, i + lag) - mean
            set num = num + d * d_lag
        set i = i + 1
    if den == 0.0:
        return err("stats_autocorrelation undefined for constant series")
    return ok(num / den)

# Distribution Histogram Binning (frequencies + probability densities)
fn stats_histogram(xs: List[Float64], bin_count: Number) -> Result[HistogramBins, Text]:
    let n: Number = list_count(xs)
    if n == 0 or bin_count <= 0:
        return err("stats_histogram requires non-empty input and bin_count > 0")
    let desc: StatsSummary = stats_describe(xs)?
    var min_e: Float64 = desc.min
    var max_e: Float64 = desc.max
    if max_e == min_e:
        set min_e = min_e - 0.5
        set max_e = max_e + 0.5
    let width: Float64 = (max_e - min_e) / float64_from_number(bin_count)
    let centers: List[Float64] = List[Float64]()
    let counts: List[Number] = List[Number]()
    var b: Number = 0
    while b < bin_count:
        list_push(centers, min_e + (float64_from_number(b) + 0.5) * width)
        list_push(counts, 0)
        set b = b + 1

    var i: Number = 0
    while i < n:
        let x: Float64 = list_get(xs, i)
        var b_idx: Number = number_from_float64(math_floor_float64((x - min_e) / width))
        if b_idx < 0: set b_idx = 0
        if b_idx >= bin_count: set b_idx = bin_count - 1
        list_set(counts, b_idx, list_get(counts, b_idx) + 1)
        set i = i + 1

    let densities: List[Float64] = List[Float64]()
    let denom: Float64 = float64_from_number(n) * width
    var b2: Number = 0
    while b2 < bin_count:
        list_push(densities, float64_from_number(list_get(counts, b2)) / denom)
        set b2 = b2 + 1
    return ok(HistogramBins(bin_count, min_e, max_e, width, centers, counts, densities))
