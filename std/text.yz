# Bounded text assembly helpers for the current concrete TextList Core surface.

shape TextBuilder:
    parts: TextList
    byte_length: Number
    maximum_bytes: Number

fn text_builder_maximum_bytes_v1() -> Number:
    return 67108864

fn text_builder_maximum_parts_v1() -> Number:
    return 65536

fn text_builder_new(maximum_bytes: Number) -> Result[TextBuilder, Text]:
    if maximum_bytes < 0 or maximum_bytes > text_builder_maximum_bytes_v1():
        return err("TextBuilder byte limit must be between 0 and 64 MiB")
    let parts_result: Result[TextList, Text] = text_list_try_new()
    if not result_is_ok(parts_result): return err(result_unwrap_error(parts_result))
    return ok(TextBuilder(result_unwrap(parts_result), 0, maximum_bytes))

fn text_builder_byte_length(builder: TextBuilder) -> Number:
    return builder.byte_length

fn text_builder_append(builder: TextBuilder, fragment: Text) -> Result[TextBuilder, Text]:
    if builder.maximum_bytes < 0 or builder.maximum_bytes > text_builder_maximum_bytes_v1():
        return err("TextBuilder has an invalid byte limit")
    if builder.byte_length < 0 or builder.byte_length > builder.maximum_bytes:
        return err("TextBuilder has an invalid accumulated byte length")
    if list_count(builder.parts) >= text_builder_maximum_parts_v1():
        return err("TextBuilder exceeds the 65536-fragment limit")
    let fragment_bytes: Number = text_length(fragment)
    if fragment_bytes > builder.maximum_bytes - builder.byte_length:
        return err("TextBuilder exceeds its configured byte limit")
    if not list_try_push(builder.parts, fragment):
        return err("TextBuilder could not append a fragment within the arena limit")
    return ok(TextBuilder(builder.parts, builder.byte_length + fragment_bytes, builder.maximum_bytes))

fn text_builder_finish(builder: TextBuilder) -> Result[Text, Text]:
    if builder.maximum_bytes < 0 or builder.maximum_bytes > text_builder_maximum_bytes_v1():
        return err("TextBuilder has an invalid byte limit")
    if builder.byte_length < 0 or builder.byte_length > builder.maximum_bytes:
        return err("TextBuilder has an invalid accumulated byte length")
    if list_count(builder.parts) > text_builder_maximum_parts_v1():
        return err("TextBuilder exceeds the 65536-fragment limit")
    var measured_bytes: Number = 0
    var index: Number = 0
    while index < list_count(builder.parts):
        let fragment_bytes: Number = text_length(list_get(builder.parts, index))
        if fragment_bytes > builder.maximum_bytes - measured_bytes:
            return err("TextBuilder parts exceed their configured byte limit")
        set measured_bytes = measured_bytes + fragment_bytes
        set index = index + 1
    if measured_bytes != builder.byte_length:
        return err("TextBuilder byte-length metadata does not match its fragments")
    return text_try_join(builder.parts, "")
