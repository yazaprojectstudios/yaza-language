# Bounded ASCII regular-expression subset with anchored full-string matching.
# Patterns are limited to 128 bytes and 64 atoms; matching is O(pattern * text).

fn regex_pattern_is_valid(pattern: Text) -> Boolean:
    return regex_pattern_valid_native(pattern)

fn regex_matches(pattern: Text, value: Text) -> Boolean:
    return regex_pattern_matches_native(pattern, value)
