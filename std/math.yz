# Small typed numeric helpers; transcendental functions need a separate, reviewed libm contract.

fn math_abs_number(value: Number) -> Result[Number, Text]:
    let minimum: Number = -9223372036854775807 - 1
    if value == minimum: return err("math_abs_number overflows for the minimum Number")
    if value < 0: return ok(0 - value)
    return ok(value)

fn math_min_number(left: Number, right: Number) -> Number:
    if left < right: return left
    return right

fn math_max_number(left: Number, right: Number) -> Number:
    if left > right: return left
    return right

fn math_clamp_number(value: Number, lower: Number, upper: Number) -> Result[Number, Text]:
    if lower > upper: return err("math_clamp_number requires lower <= upper")
    if value < lower: return ok(lower)
    if value > upper: return ok(upper)
    return ok(value)

# --- High-Precision IEEE-754 Scientific & Transcendental Functions (Data Science Engine) ---

fn math_pi() -> Float64:
    return 3.14159265358979323846

fn math_e() -> Float64:
    return 2.71828182845904523536

fn math_ln2() -> Float64:
    return 0.69314718055994530942

fn math_ln10() -> Float64:
    return 2.30258509299404568402

fn math_sqrt2() -> Float64:
    return 1.41421356237309504880

fn math_epsilon_float64() -> Float64:
    return 0.0000000000000002220446049250313

fn math_nan_float64() -> Float64:
    return float64_from_bits(9221120237041090560)

fn math_positive_infinity_float64() -> Float64:
    return float64_from_bits(math_positive_infinity_bits_v1())

fn math_negative_infinity_float64() -> Float64:
    return float64_from_bits(math_negative_infinity_bits_v1())

fn math_sqrt_float64(x: Float64) -> Float64:
    if math_is_nan_float64(x) or x < 0.0:
        return math_nan_float64()
    if x == 0.0 or math_is_infinite_float64(x):
        return x
    let bits: Number = float64_bits(x)
    # Exact IEEE-754 exponent halving seed + 6 Newton-Raphson iterations (< 0.5 ULP across full range)
    let seed_bits: Number = 2303591209003646976 + (bits / 2)
    var g: Float64 = float64_from_bits(seed_bits)
    var i: Number = 0
    while i < 6:
        set g = 0.5 * (g + (x / g))
        set i = i + 1
    return g

fn math_ldexp_float64(x: Float64, exp_shift: Number) -> Float64:
    if x == 0.0 or not math_is_finite_float64(x) or exp_shift == 0:
        return x
    var cur: Float64 = x
    var rem: Number = exp_shift
    while rem > 0:
        var step: Number = rem
        if step > 512: set step = 512
        let factor: Float64 = float64_from_bits((1023 + step) * 4503599627370496)
        set cur = cur * factor
        set rem = rem - step
    while rem < 0:
        var step2: Number = rem
        if step2 < -512: set step2 = -512
        let factor2: Float64 = float64_from_bits((1023 + step2) * 4503599627370496)
        set cur = cur * factor2
        set rem = rem - step2
    return cur

fn math_exp_float64(x: Float64) -> Float64:
    if math_is_nan_float64(x): return x
    if x > 709.782712893384: return math_positive_infinity_float64()
    if x < -745.133219101941: return 0.0
    if x == 0.0: return 1.0
    # Range reduction: x = k * ln(2) + r, where |r| <= ln(2)/2
    let inv_ln2: Float64 = 1.44269504088896340736
    let k_float: Float64 = math_round_float64(x * inv_ln2)
    let k: Number = number_from_float64(k_float)
    # Cody-Waite split of ln(2) = ln2_hi + ln2_lo for extra range-reduction precision
    let ln2_hi: Float64 = 0.69314718036912381649
    let ln2_lo: Float64 = 0.00000000019082149292705877
    let r: Float64 = (x - k_float * ln2_hi) - k_float * ln2_lo
    # 11-term Horner Taylor polynomial for exp(r) on |r| <= 0.3466
    var poly: Float64 = 1.0 / 39916800.0
    set poly = poly * r + (1.0 / 3628800.0)
    set poly = poly * r + (1.0 / 362880.0)
    set poly = poly * r + (1.0 / 40320.0)
    set poly = poly * r + (1.0 / 5040.0)
    set poly = poly * r + (1.0 / 720.0)
    set poly = poly * r + (1.0 / 120.0)
    set poly = poly * r + (1.0 / 24.0)
    set poly = poly * r + (1.0 / 6.0)
    set poly = poly * r + 0.5
    set poly = poly * r + 1.0
    set poly = poly * r + 1.0
    return math_ldexp_float64(poly, k)

fn math_ln_float64(x: Float64) -> Float64:
    if math_is_nan_float64(x) or x < 0.0: return math_nan_float64()
    if x == 0.0: return math_negative_infinity_float64()
    if math_is_infinite_float64(x): return x
    if x == 1.0: return 0.0
    let bits: Number = float64_bits(x)
    let two52: Number = 4503599627370496
    var exp_bits: Number = bits / two52
    let mant_bits: Number = bits - (exp_bits * two52)
    var e: Number = exp_bits - 1023
    # Normalize mantissa m into [1.0, 2.0) by setting biased exponent to 1023
    var m: Float64 = float64_from_bits(mant_bits + (1023 * two52))
    if m > 1.41421356237309504880:
        set m = m * 0.5
        set e = e + 1
    # Hyperbolic artanh series: ln(m) = 2 * sum_{k=0..9} u^(2k+1)/(2k+1), |u| <= 0.1716
    let u: Float64 = (m - 1.0) / (m + 1.0)
    let u2: Float64 = u * u
    var sum: Float64 = 1.0 / 19.0
    set sum = sum * u2 + (1.0 / 17.0)
    set sum = sum * u2 + (1.0 / 15.0)
    set sum = sum * u2 + (1.0 / 13.0)
    set sum = sum * u2 + (1.0 / 11.0)
    set sum = sum * u2 + (1.0 / 9.0)
    set sum = sum * u2 + (1.0 / 7.0)
    set sum = sum * u2 + (1.0 / 5.0)
    set sum = sum * u2 + (1.0 / 3.0)
    set sum = sum * u2 + 1.0
    let ln_m: Float64 = 2.0 * u * sum
    return float64_from_number(e) * math_ln2() + ln_m

fn math_log10_float64(x: Float64) -> Float64:
    return math_ln_float64(x) / math_ln10()

fn math_log2_float64(x: Float64) -> Float64:
    return math_ln_float64(x) / math_ln2()

fn math_pow_float64(base: Float64, exponent: Float64) -> Float64:
    if exponent == 0.0: return 1.0
    if exponent == 1.0: return base
    if base == 0.0:
        if exponent > 0.0: return 0.0
        return math_positive_infinity_float64()
    if base < 0.0:
        let trunc_exp: Float64 = math_trunc_float64(exponent)
        if trunc_exp != exponent:
            return math_nan_float64()
        let abs_res: Float64 = math_exp_float64(exponent * math_ln_float64(0.0 - base))
        let n_exp: Number = number_from_float64(trunc_exp)
        if n_exp - (n_exp / 2) * 2 != 0:
            return 0.0 - abs_res
        return abs_res
    return math_exp_float64(exponent * math_ln_float64(base))

fn math_sin_float64(x: Float64) -> Float64:
    if not math_is_finite_float64(x): return math_nan_float64()
    let two_pi: Float64 = 6.28318530717958647692
    let pi: Float64 = 3.14159265358979323846
    let half_pi: Float64 = 1.57079632679489661923
    var r: Float64 = x - math_round_float64(x / two_pi) * two_pi
    var sign: Float64 = 1.0
    if r > pi:
        set r = r - two_pi
    elif r < (0.0 - pi):
        set r = r + two_pi
    if r > half_pi:
        set r = pi - r
    elif r < (0.0 - half_pi):
        set r = (0.0 - pi) - r
    if r < 0.0:
        set sign = -1.0
        set r = 0.0 - r
    let r2: Float64 = r * r
    var poly: Float64 = 1.0 / 355687428096000.0
    set poly = poly * r2 - (1.0 / 1307674368000.0)
    set poly = poly * r2 + (1.0 / 6227020800.0)
    set poly = poly * r2 - (1.0 / 39916800.0)
    set poly = poly * r2 + (1.0 / 362880.0)
    set poly = poly * r2 - (1.0 / 5040.0)
    set poly = poly * r2 + (1.0 / 120.0)
    set poly = poly * r2 - (1.0 / 6.0)
    set poly = poly * r2 + 1.0
    return sign * r * poly

fn math_cos_float64(x: Float64) -> Float64:
    return math_sin_float64(x + 1.57079632679489661923)

fn math_tan_float64(x: Float64) -> Float64:
    return math_sin_float64(x) / math_cos_float64(x)

fn math_erf_float64(x: Float64) -> Float64:
    if math_is_nan_float64(x): return x
    var sign: Float64 = 1.0
    var ax: Float64 = x
    if x < 0.0:
        set sign = -1.0
        set ax = 0.0 - x
    if ax >= 6.0:
        return sign
    # Abramowitz & Stegun 7.1.26 rational approximation (max error <= 1.5e-7)
    let p: Float64 = 0.3275911
    let a1: Float64 = 0.254829592
    let a2: Float64 = -0.284496736
    let a3: Float64 = 1.421413741
    let a4: Float64 = -1.453152027
    let a5: Float64 = 1.061405429
    let t: Float64 = 1.0 / (1.0 + p * ax)
    let poly: Float64 = (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t
    let y: Float64 = 1.0 - poly * math_exp_float64(0.0 - (ax * ax))
    return sign * y

fn math_is_nan_float64(value: Float64) -> Boolean:
    let bits: Number = float64_bits(value)
    if bits > math_positive_infinity_bits_v1(): return true
    if bits > math_negative_infinity_bits_v1() and bits < 0: return true
    return false

fn math_positive_infinity_bits_v1() -> Number:
    return 9218868437227405312

fn math_negative_infinity_bits_v1() -> Number:
    return -4503599627370496

fn math_negative_sign_bit_v1() -> Number:
    return -9223372036854775807 - 1

fn math_is_infinite_float64(value: Float64) -> Boolean:
    let bits: Number = float64_bits(value)
    return bits == math_positive_infinity_bits_v1() or bits == math_negative_infinity_bits_v1()

fn math_is_finite_float64(value: Float64) -> Boolean:
    return not math_is_nan_float64(value) and not math_is_infinite_float64(value)

fn math_abs_float64(value: Float64) -> Float64:
    let bits: Number = float64_bits(value)
    if bits < 0:
        let sign_bit: Number = math_negative_sign_bit_v1()
        return float64_from_bits(bits - sign_bit)
    return value

fn math_trunc_float64(value: Float64) -> Float64:
    if not math_is_finite_float64(value): return value
    let bits: Number = float64_bits(value)
    let negative: Boolean = bits < 0
    var magnitude_bits: Number = bits
    if negative: set magnitude_bits = bits - math_negative_sign_bit_v1()
    let exponent_field: Number = magnitude_bits / 4503599627370496
    if exponent_field == 0:
        if negative: return float64_from_bits(math_negative_sign_bit_v1())
        return 0.0
    let exponent: Number = exponent_field - 1023
    if exponent < 0:
        if negative: return float64_from_bits(math_negative_sign_bit_v1())
        return 0.0
    if exponent >= 52: return value
    let discarded_bit_count: Number = 52 - exponent
    var step: Number = 1
    var bit_index: Number = 0
    while bit_index < discarded_bit_count:
        set step = step * 2
        set bit_index = bit_index + 1
    let truncated_magnitude: Number = magnitude_bits / step * step
    if negative: return float64_from_bits(truncated_magnitude + math_negative_sign_bit_v1())
    return float64_from_bits(truncated_magnitude)

fn math_floor_float64(value: Float64) -> Float64:
    if not math_is_finite_float64(value): return value
    let truncated: Float64 = math_trunc_float64(value)
    if value >= 0.0 or truncated == value: return truncated
    return truncated - 1.0

fn math_ceil_float64(value: Float64) -> Float64:
    if not math_is_finite_float64(value): return value
    let truncated: Float64 = math_trunc_float64(value)
    if value <= 0.0 or truncated == value: return truncated
    return truncated + 1.0

fn math_round_float64(value: Float64) -> Float64:
    if not math_is_finite_float64(value): return value
    let truncated: Float64 = math_trunc_float64(value)
    if truncated == value: return value
    let fraction: Float64 = value - truncated
    if fraction >= 0.5: return truncated + 1.0
    if fraction <= -0.5: return truncated - 1.0
    return truncated

fn math_min_float64(left: Float64, right: Float64) -> Float64:
    if math_is_nan_float64(left): return left
    if math_is_nan_float64(right): return right
    if left == 0.0 and right == 0.0:
        if float64_bits(left) < 0: return left
        if float64_bits(right) < 0: return right
        return left
    if left < right: return left
    return right

fn math_max_float64(left: Float64, right: Float64) -> Float64:
    if math_is_nan_float64(left): return left
    if math_is_nan_float64(right): return right
    if left == 0.0 and right == 0.0:
        if float64_bits(left) >= 0: return left
        if float64_bits(right) >= 0: return right
        return left
    if left > right: return left
    return right

fn math_clamp_float64(value: Float64, lower: Float64, upper: Float64) -> Result[Float64, Text]:
    if math_is_nan_float64(lower) or math_is_nan_float64(upper):
        return err("math_clamp_float64 bounds must not be NaN")
    if lower > upper: return err("math_clamp_float64 requires lower <= upper")
    if math_is_nan_float64(value): return ok(value)
    if value < lower: return ok(lower)
    if value > upper: return ok(upper)
    return ok(value)
