# Small typed numeric helpers; transcendental functions need a separate, reviewed libm contract.

fn math_abs_number(value: Number) -> Result[Number, Text]:
    let minimum: Number = -9223372036854775807 - 1
    if value == minimum: return err("math_abs_number overflows for the minimum Number")
    if value < 0: return ok(0 - value)
    return ok(value)

fn math_min_number(left: Number, right: Number) -> Number:
    if left < right: return left
    return right

fn math_max_number(left: Number, right: Number) -> Number:
    if left > right: return left
    return right

fn math_clamp_number(value: Number, lower: Number, upper: Number) -> Result[Number, Text]:
    if lower > upper: return err("math_clamp_number requires lower <= upper")
    if value < lower: return ok(lower)
    if value > upper: return ok(upper)
    return ok(value)

# --- High-Precision IEEE-754 Scientific & Transcendental Functions (Data Science Engine) ---

fn math_pi() -> Float64:
    return 3.14159265358979323846

fn math_e() -> Float64:
    return 2.71828182845904523536

fn math_ln2() -> Float64:
    return 0.69314718055994530942

fn math_ln10() -> Float64:
    return 2.30258509299404568402

fn math_sqrt2() -> Float64:
    return 1.41421356237309504880

fn math_epsilon_float64() -> Float64:
    return 0.0000000000000002220446049250313

fn math_nan_float64() -> Float64:
    return float64_from_bits(9221120237041090560)

fn math_positive_infinity_float64() -> Float64:
    return float64_from_bits(math_positive_infinity_bits_v1())

fn math_negative_infinity_float64() -> Float64:
    return float64_from_bits(math_negative_infinity_bits_v1())

fn math_sqrt_float64(x: Float64) -> Float64:
    if math_is_nan_float64(x) or x < 0.0:
        return math_nan_float64()
    if x == 0.0 or math_is_infinite_float64(x):
        return x
    var scaled_x: Float64 = x
    var rescale: Float64 = 1.0
    var bits: Number = float64_bits(scaled_x)
    if bits < 4503599627370496:
        set scaled_x = scaled_x * 18014398509481984.0
        set rescale = 0.000000007450580596923828125
        set bits = float64_bits(scaled_x)
    # Exact IEEE-754 exponent halving seed + 6 Newton-Raphson iterations (< 0.5 ULP across full range)
    let seed_bits: Number = 2303591209003646976 + (bits / 2)
    var g: Float64 = float64_from_bits(seed_bits)
    var i: Number = 0
    while i < 6:
        set g = 0.5 * (g + (scaled_x / g))
        set i = i + 1
    return g * rescale

fn math_ldexp_float64(x: Float64, exp_shift: Number) -> Float64:
    if x == 0.0 or not math_is_finite_float64(x) or exp_shift == 0:
        return x
    if exp_shift > 2100:
        if x < 0.0:
            return math_negative_infinity_float64()
        return math_positive_infinity_float64()
    if exp_shift < -2100:
        return 0.0 * x
    var cur: Float64 = x
    var rem: Number = exp_shift
    while rem > 0:
        var step: Number = rem
        if step > 512: set step = 512
        let factor: Float64 = float64_from_bits((1023 + step) * 4503599627370496)
        set cur = cur * factor
        set rem = rem - step
    while rem < 0:
        var step2: Number = rem
        if step2 < -512: set step2 = -512
        let factor2: Float64 = float64_from_bits((1023 + step2) * 4503599627370496)
        set cur = cur * factor2
        set rem = rem - step2
    return cur

fn math_exp_float64(x: Float64) -> Float64:
    if math_is_nan_float64(x): return x
    if x > 709.782712893384: return math_positive_infinity_float64()
    if x < -745.133219101941: return 0.0
    if x == 0.0: return 1.0
    # Range reduction: x = k * ln(2) + r, where |r| <= ln(2)/2
    let inv_ln2: Float64 = 1.44269504088896340736
    let k_float: Float64 = math_round_float64(x * inv_ln2)
    let k: Number = number_from_float64(k_float)
    # Cody-Waite split of ln(2) = ln2_hi + ln2_lo for extra range-reduction precision
    let ln2_hi: Float64 = 0.69314718036912381649
    let ln2_lo: Float64 = 0.00000000019082149292705877
    let r: Float64 = (x - k_float * ln2_hi) - k_float * ln2_lo
    # 11-term Horner Taylor polynomial for exp(r) on |r| <= 0.3466
    var poly: Float64 = 1.0 / 39916800.0
    set poly = poly * r + (1.0 / 3628800.0)
    set poly = poly * r + (1.0 / 362880.0)
    set poly = poly * r + (1.0 / 40320.0)
    set poly = poly * r + (1.0 / 5040.0)
    set poly = poly * r + (1.0 / 720.0)
    set poly = poly * r + (1.0 / 120.0)
    set poly = poly * r + (1.0 / 24.0)
    set poly = poly * r + (1.0 / 6.0)
    set poly = poly * r + 0.5
    set poly = poly * r + 1.0
    set poly = poly * r + 1.0
    return math_ldexp_float64(poly, k)

fn math_ln_float64(x: Float64) -> Float64:
    if math_is_nan_float64(x) or x < 0.0: return math_nan_float64()
    if x == 0.0: return math_negative_infinity_float64()
    if math_is_infinite_float64(x): return x
    if x == 1.0: return 0.0
    var vx: Float64 = x
    var sub_shift: Number = 0
    let two52: Number = 4503599627370496
    var bits: Number = float64_bits(vx)
    var exp_bits: Number = bits / two52
    # Normalize subnormal IEEE-754 doubles (0 < x < 2^-1022) by scaling up by 2^54
    if exp_bits == 0:
        set vx = vx * 18014398509481984.0
        set sub_shift = -54
        set bits = float64_bits(vx)
        set exp_bits = bits / two52
    let mant_bits: Number = bits - (exp_bits * two52)
    var e: Number = (exp_bits - 1023) + sub_shift
    # Normalize mantissa m into [1.0, 2.0) by setting biased exponent to 1023
    var m: Float64 = float64_from_bits(mant_bits + (1023 * two52))
    if m > 1.41421356237309504880:
        set m = m * 0.5
        set e = e + 1
    # Hyperbolic artanh series: ln(m) = 2 * sum_{k=0..11} u^(2k+1)/(2k+1), |u| <= 0.1716 (< 0.5 ULP)
    let u: Float64 = (m - 1.0) / (m + 1.0)
    let u2: Float64 = u * u
    var sum: Float64 = 1.0 / 23.0
    set sum = sum * u2 + (1.0 / 21.0)
    set sum = sum * u2 + (1.0 / 19.0)
    set sum = sum * u2 + (1.0 / 17.0)
    set sum = sum * u2 + (1.0 / 15.0)
    set sum = sum * u2 + (1.0 / 13.0)
    set sum = sum * u2 + (1.0 / 11.0)
    set sum = sum * u2 + (1.0 / 9.0)
    set sum = sum * u2 + (1.0 / 7.0)
    set sum = sum * u2 + (1.0 / 5.0)
    set sum = sum * u2 + (1.0 / 3.0)
    set sum = sum * u2 + 1.0
    let ln_m: Float64 = 2.0 * u * sum
    return float64_from_number(e) * math_ln2() + ln_m

fn math_log10_float64(x: Float64) -> Float64:
    return math_ln_float64(x) / math_ln10()

fn math_log2_float64(x: Float64) -> Float64:
    return math_ln_float64(x) / math_ln2()

fn math_pow_float64(base: Float64, exponent: Float64) -> Float64:
    if exponent == 0.0: return 1.0
    if base == 1.0: return 1.0
    if exponent == 1.0: return base
    if math_is_nan_float64(base) or math_is_nan_float64(exponent): return math_nan_float64()
    if base == 0.0:
        if exponent > 0.0: return 0.0
        return math_positive_infinity_float64()
    if base < 0.0:
        if not math_is_finite_float64(exponent):
            if base == -1.0: return 1.0
            let ab: Float64 = 0.0 - base
            if (ab > 1.0 and exponent > 0.0) or (ab < 1.0 and exponent < 0.0):
                return math_positive_infinity_float64()
            return 0.0
        let trunc_exp: Float64 = math_trunc_float64(exponent)
        if trunc_exp != exponent:
            return math_nan_float64()
        let abs_res: Float64 = math_exp_float64(exponent * math_ln_float64(0.0 - base))
        # Any integer double with |exponent| >= 2^53 is guaranteed even in IEEE-754
        if math_abs_float64(trunc_exp) >= 9007199254740992.0:
            return abs_res
        let n_exp: Number = number_from_float64(trunc_exp)
        if n_exp - (n_exp / 2) * 2 != 0:
            return 0.0 - abs_res
        return abs_res
    return math_exp_float64(exponent * math_ln_float64(base))

fn math_sin_float64(x: Float64) -> Float64:
    if not math_is_finite_float64(x): return math_nan_float64()
    let two_pi: Float64 = 6.28318530717958647692
    let pi: Float64 = 3.14159265358979323846
    let half_pi: Float64 = 1.57079632679489661923
    var r: Float64 = x - math_round_float64(x / two_pi) * two_pi
    var sign: Float64 = 1.0
    if r > pi:
        set r = r - two_pi
    elif r < (0.0 - pi):
        set r = r + two_pi
    if r > half_pi:
        set r = pi - r
    elif r < (0.0 - half_pi):
        set r = (0.0 - pi) - r
    if r < 0.0:
        set sign = -1.0
        set r = 0.0 - r
    let r2: Float64 = r * r
    var poly: Float64 = 1.0 / 355687428096000.0
    set poly = poly * r2 - (1.0 / 1307674368000.0)
    set poly = poly * r2 + (1.0 / 6227020800.0)
    set poly = poly * r2 - (1.0 / 39916800.0)
    set poly = poly * r2 + (1.0 / 362880.0)
    set poly = poly * r2 - (1.0 / 5040.0)
    set poly = poly * r2 + (1.0 / 120.0)
    set poly = poly * r2 - (1.0 / 6.0)
    set poly = poly * r2 + 1.0
    return sign * r * poly

fn math_cos_float64(x: Float64) -> Float64:
    return math_sin_float64(x + 1.57079632679489661923)

fn math_tan_float64(x: Float64) -> Float64:
    return math_sin_float64(x) / math_cos_float64(x)

fn math_erfc_float64(x: Float64) -> Float64:
    if math_is_nan_float64(x): return x
    if x < 0.0:
        return 2.0 - math_erfc_float64(0.0 - x)
    if x == 0.0:
        return 1.0
    if x >= 27.0:
        return 0.0
    # For 0 < x < 2.0 use power series of erf(x) (45 terms -> < 1e-16 accuracy), then 1 - erf(x)
    if x < 2.0:
        let x2: Float64 = x * x
        var term: Float64 = x
        var sum: Float64 = x
        var k: Number = 1
        while k <= 45:
            let kf: Float64 = float64_from_number(k)
            set term = (0.0 - term) * x2 / kf
            let contrib: Float64 = term / (2.0 * kf + 1.0)
            set sum = sum + contrib
            if math_abs_float64(contrib) <= math_abs_float64(sum) * 0.0000000000000001:
                set k = 100
            set k = k + 1
        let two_over_sqrt_pi: Float64 = 1.12837916709551257390
        return 1.0 - (two_over_sqrt_pi * sum)
    # For x >= 2.0 use Laplace / Lentz continued fraction for erfc(x) = (exp(-x^2)/sqrt(pi)) * CF
    let tiny: Float64 = 0.000000000000000000000000000001
    var b: Float64 = x
    var c: Float64 = 1.0 / tiny
    var d: Float64 = 1.0 / b
    var h: Float64 = d
    var i: Number = 1
    while i <= 60:
        let a: Float64 = float64_from_number(i) * 0.5
        set d = b + a * d
        if math_abs_float64(d) < tiny: set d = tiny
        set c = b + (a / c)
        if math_abs_float64(c) < tiny: set c = tiny
        set d = 1.0 / d
        let del: Float64 = c * d
        set h = h * del
        if math_abs_float64(del - 1.0) <= 0.0000000000000002:
            set i = 100
        set i = i + 1
    let inv_sqrt_pi: Float64 = 0.56418958354775628695
    return inv_sqrt_pi * math_exp_float64(0.0 - (x * x)) * h

fn math_erf_float64(x: Float64) -> Float64:
    if math_is_nan_float64(x): return x
    var sign: Float64 = 1.0
    var ax: Float64 = x
    if x < 0.0:
        set sign = -1.0
        set ax = 0.0 - x
    if ax < 1.5:
        let x2: Float64 = ax * ax
        var term: Float64 = ax
        var sum: Float64 = ax
        var k: Number = 1
        while k <= 40:
            let kf: Float64 = float64_from_number(k)
            set term = (0.0 - term) * x2 / kf
            let contrib: Float64 = term / (2.0 * kf + 1.0)
            set sum = sum + contrib
            if math_abs_float64(contrib) <= math_abs_float64(sum) * 0.0000000000000001:
                set k = 100
            set k = k + 1
        let two_over_sqrt_pi: Float64 = 1.12837916709551257390
        return sign * (two_over_sqrt_pi * sum)
    return sign * (1.0 - math_erfc_float64(ax))

fn math_is_nan_float64(value: Float64) -> Boolean:
    let bits: Number = float64_bits(value)
    if bits > math_positive_infinity_bits_v1(): return true
    if bits > math_negative_infinity_bits_v1() and bits < 0: return true
    return false

fn math_positive_infinity_bits_v1() -> Number:
    return 9218868437227405312

fn math_negative_infinity_bits_v1() -> Number:
    return -4503599627370496

fn math_negative_sign_bit_v1() -> Number:
    return -9223372036854775807 - 1

fn math_is_infinite_float64(value: Float64) -> Boolean:
    let bits: Number = float64_bits(value)
    return bits == math_positive_infinity_bits_v1() or bits == math_negative_infinity_bits_v1()

fn math_is_finite_float64(value: Float64) -> Boolean:
    return not math_is_nan_float64(value) and not math_is_infinite_float64(value)

fn math_abs_float64(value: Float64) -> Float64:
    let bits: Number = float64_bits(value)
    if bits < 0:
        let sign_bit: Number = math_negative_sign_bit_v1()
        return float64_from_bits(bits - sign_bit)
    return value

fn math_trunc_float64(value: Float64) -> Float64:
    if not math_is_finite_float64(value): return value
    let bits: Number = float64_bits(value)
    let negative: Boolean = bits < 0
    var magnitude_bits: Number = bits
    if negative: set magnitude_bits = bits - math_negative_sign_bit_v1()
    let exponent_field: Number = magnitude_bits / 4503599627370496
    if exponent_field == 0:
        if negative: return float64_from_bits(math_negative_sign_bit_v1())
        return 0.0
    let exponent: Number = exponent_field - 1023
    if exponent < 0:
        if negative: return float64_from_bits(math_negative_sign_bit_v1())
        return 0.0
    if exponent >= 52: return value
    let discarded_bit_count: Number = 52 - exponent
    var step: Number = 1
    var bit_index: Number = 0
    while bit_index < discarded_bit_count:
        set step = step * 2
        set bit_index = bit_index + 1
    let truncated_magnitude: Number = magnitude_bits / step * step
    if negative: return float64_from_bits(truncated_magnitude + math_negative_sign_bit_v1())
    return float64_from_bits(truncated_magnitude)

fn math_floor_float64(value: Float64) -> Float64:
    if not math_is_finite_float64(value): return value
    let truncated: Float64 = math_trunc_float64(value)
    if value >= 0.0 or truncated == value: return truncated
    return truncated - 1.0

fn math_ceil_float64(value: Float64) -> Float64:
    if not math_is_finite_float64(value): return value
    let truncated: Float64 = math_trunc_float64(value)
    if value <= 0.0 or truncated == value: return truncated
    return truncated + 1.0

fn math_round_float64(value: Float64) -> Float64:
    if not math_is_finite_float64(value): return value
    let truncated: Float64 = math_trunc_float64(value)
    if truncated == value: return value
    let fraction: Float64 = value - truncated
    if fraction >= 0.5: return truncated + 1.0
    if fraction <= -0.5: return truncated - 1.0
    return truncated

fn math_min_float64(left: Float64, right: Float64) -> Float64:
    if math_is_nan_float64(left): return left
    if math_is_nan_float64(right): return right
    if left == 0.0 and right == 0.0:
        if float64_bits(left) < 0: return left
        if float64_bits(right) < 0: return right
        return left
    if left < right: return left
    return right

fn math_max_float64(left: Float64, right: Float64) -> Float64:
    if math_is_nan_float64(left): return left
    if math_is_nan_float64(right): return right
    if left == 0.0 and right == 0.0:
        if float64_bits(left) >= 0: return left
        if float64_bits(right) >= 0: return right
        return left
    if left > right: return left
    return right

fn math_clamp_float64(value: Float64, lower: Float64, upper: Float64) -> Result[Float64, Text]:
    if math_is_nan_float64(lower) or math_is_nan_float64(upper):
        return err("math_clamp_float64 bounds must not be NaN")
    if lower > upper: return err("math_clamp_float64 requires lower <= upper")
    if math_is_nan_float64(value): return ok(value)
    if value < lower: return ok(lower)
    if value > upper: return ok(upper)
    return ok(value)

fn math_atan_float64(x: Float64) -> Float64:
    if math_is_nan_float64(x): return x
    let half_pi: Float64 = 1.57079632679489661923
    if math_is_infinite_float64(x):
        if x > 0.0: return half_pi
        return 0.0 - half_pi
    var sign: Float64 = 1.0
    var ax: Float64 = x
    if x < 0.0:
        set sign = -1.0
        set ax = 0.0 - x
    var inv: Boolean = false
    if ax > 1.0:
        set ax = 1.0 / ax
        set inv = true
    # Range reduction: if ax > tan(pi/12) ~= 0.267949, shift by pi/6 (sqrt(3) = 1.7320508075688772)
    var offset: Float64 = 0.0
    if ax > 0.2679491924311227:
        let sqrt3: Float64 = 1.73205080756887729352
        set ax = (ax * sqrt3 - 1.0) / (sqrt3 + ax)
        set offset = 0.52359877559829887308
    let x2: Float64 = ax * ax
    var poly: Float64 = -1.0 / 13.0
    set poly = poly * x2 + (1.0 / 11.0)
    set poly = poly * x2 - (1.0 / 9.0)
    set poly = poly * x2 + (1.0 / 7.0)
    set poly = poly * x2 - (1.0 / 5.0)
    set poly = poly * x2 + (1.0 / 3.0)
    set poly = poly * x2 - 1.0
    set poly = 0.0 - poly
    var res: Float64 = offset + ax * poly
    if inv:
        set res = half_pi - res
    return sign * res

fn math_atan2_float64(y: Float64, x: Float64) -> Float64:
    if math_is_nan_float64(y) or math_is_nan_float64(x):
        return math_nan_float64()
    let pi: Float64 = 3.14159265358979323846
    let half_pi: Float64 = 1.57079632679489661923
    if x > 0.0:
        return math_atan_float64(y / x)
    if x < 0.0:
        if y >= 0.0:
            return math_atan_float64(y / x) + pi
        return math_atan_float64(y / x) - pi
    if y > 0.0: return half_pi
    if y < 0.0: return 0.0 - half_pi
    return 0.0

fn math_asin_float64(x: Float64) -> Float64:
    if math_is_nan_float64(x) or x < -1.0 or x > 1.0:
        return math_nan_float64()
    if x == 1.0: return 1.57079632679489661923
    if x == -1.0: return -1.57079632679489661923
    return math_atan_float64(x / math_sqrt_float64(1.0 - x * x))

fn math_acos_float64(x: Float64) -> Float64:
    if math_is_nan_float64(x) or x < -1.0 or x > 1.0:
        return math_nan_float64()
    return 1.57079632679489661923 - math_asin_float64(x)

fn math_sinh_float64(x: Float64) -> Float64:
    let ex: Float64 = math_exp_float64(x)
    let emx: Float64 = math_exp_float64(0.0 - x)
    return 0.5 * (ex - emx)

fn math_cosh_float64(x: Float64) -> Float64:
    let ex: Float64 = math_exp_float64(x)
    let emx: Float64 = math_exp_float64(0.0 - x)
    return 0.5 * (ex + emx)

fn math_tanh_float64(x: Float64) -> Float64:
    if x > 20.0: return 1.0
    if x < -20.0: return -1.0
    let e2x: Float64 = math_exp_float64(2.0 * x)
    return (e2x - 1.0) / (e2x + 1.0)

# Lanczos (g=7, n=9) Log-Gamma ln(Gamma(z)) for statistical distributions (Student-t, F, Chi2, Beta, Gamma)
fn math_lgamma_float64(z: Float64) -> Float64:
    if z == math_positive_infinity_float64():
        return z
    if math_is_nan_float64(z) or z <= 0.0:
        return math_nan_float64()
    let x: Float64 = z - 1.0
    var acc: Float64 = 0.99999999999980993
    set acc = acc + 676.5203681218851 / (x + 1.0)
    set acc = acc - 1259.1392167224028 / (x + 2.0)
    set acc = acc + 771.32342877765313 / (x + 3.0)
    set acc = acc - 176.61502916214059 / (x + 4.0)
    set acc = acc + 12.507343278686905 / (x + 5.0)
    set acc = acc - 0.13857109526572012 / (x + 6.0)
    set acc = acc + 0.0000099843695780195716 / (x + 7.0)
    set acc = acc + 0.00000015056327351493116 / (x + 8.0)
    let t: Float64 = x + 7.5
    let half_ln_2pi: Float64 = 0.91893853320467274178
    return half_ln_2pi + (x + 0.5) * math_ln_float64(t) - t + math_ln_float64(acc)

fn math_tgamma_float64(z: Float64) -> Float64:
    return math_exp_float64(math_lgamma_float64(z))

fn math_lbeta_float64(a: Float64, b: Float64) -> Float64:
    return math_lgamma_float64(a) + math_lgamma_float64(b) - math_lgamma_float64(a + b)

fn math_beta_float64(a: Float64, b: Float64) -> Float64:
    return math_exp_float64(math_lbeta_float64(a, b))

# Regularized Incomplete Gamma P(a, x) (lower) and Q(a, x) (upper = 1 - P(a, x)) via series & Lentz continued fraction
fn math_gammainc_lower_reg_float64(a: Float64, x: Float64) -> Float64:
    if math_is_nan_float64(a) or math_is_nan_float64(x) or a <= 0.0 or x < 0.0:
        return math_nan_float64()
    if x == 0.0:
        return 0.0
    if x < a + 1.0:
        var ap: Float64 = a
        var del: Float64 = 1.0 / a
        var sum: Float64 = del
        var n: Number = 1
        while n <= 200:
            set ap = ap + 1.0
            set del = del * (x / ap)
            set sum = sum + del
            if math_abs_float64(del) <= math_abs_float64(sum) * 0.0000000000000002:
                set n = 300
            set n = n + 1
        return sum * math_exp_float64((0.0 - x) + a * math_ln_float64(x) - math_lgamma_float64(a))
    return 1.0 - math_gammainc_upper_reg_float64(a, x)

fn math_gammainc_upper_reg_float64(a: Float64, x: Float64) -> Float64:
    if math_is_nan_float64(a) or math_is_nan_float64(x) or a <= 0.0 or x < 0.0:
        return math_nan_float64()
    if x == 0.0:
        return 1.0
    if x < a + 1.0:
        return 1.0 - math_gammainc_lower_reg_float64(a, x)
    let tiny: Float64 = 0.000000000000000000000000000001
    var b: Float64 = x + 1.0 - a
    var c: Float64 = 1.0 / tiny
    var d: Float64 = 1.0 / b
    var h: Float64 = d
    var i: Number = 1
    while i <= 200:
        let ifl: Float64 = float64_from_number(i)
        let an: Float64 = (0.0 - ifl) * (ifl - a)
        set b = b + 2.0
        set d = an * d + b
        if math_abs_float64(d) < tiny: set d = tiny
        set c = b + (an / c)
        if math_abs_float64(c) < tiny: set c = tiny
        set d = 1.0 / d
        let del: Float64 = d * c
        set h = h * del
        if math_abs_float64(del - 1.0) <= 0.0000000000000002:
            set i = 300
        set i = i + 1
    return math_exp_float64((0.0 - x) + a * math_ln_float64(x) - math_lgamma_float64(a)) * h

# Lentz continued fraction helper for Regularized Incomplete Beta I_x(a, b)
fn math_betacf_v1(a: Float64, b: Float64, x: Float64) -> Float64:
    let tiny: Float64 = 0.000000000000000000000000000001
    let qab: Float64 = a + b
    let qap: Float64 = a + 1.0
    let qam: Float64 = a - 1.0
    var c: Float64 = 1.0
    var d: Float64 = 1.0 - (qab * x / qap)
    if math_abs_float64(d) < tiny: set d = tiny
    set d = 1.0 / d
    var h: Float64 = d
    var m: Number = 1
    while m <= 200:
        let mf: Float64 = float64_from_number(m)
        let m2: Float64 = 2.0 * mf
        let aa1: Float64 = mf * (b - mf) * x / ((qam + m2) * (a + m2))
        set d = 1.0 + aa1 * d
        if math_abs_float64(d) < tiny: set d = tiny
        set c = 1.0 + (aa1 / c)
        if math_abs_float64(c) < tiny: set c = tiny
        set d = 1.0 / d
        set h = h * d * c
        let aa2: Float64 = (0.0 - (a + mf)) * (qab + mf) * x / ((a + m2) * (qap + m2))
        set d = 1.0 + aa2 * d
        if math_abs_float64(d) < tiny: set d = tiny
        set c = 1.0 + (aa2 / c)
        if math_abs_float64(c) < tiny: set c = tiny
        set d = 1.0 / d
        let del: Float64 = d * c
        set h = h * del
        if math_abs_float64(del - 1.0) <= 0.0000000000000002:
            set m = 300
        set m = m + 1
    return h

# Regularized Incomplete Beta I_x(a, b) (R pbeta / scipy.special.betainc)
fn math_betainc_reg_float64(a: Float64, b: Float64, x: Float64) -> Float64:
    if math_is_nan_float64(a) or math_is_nan_float64(b) or math_is_nan_float64(x) or a <= 0.0 or b <= 0.0 or x < 0.0 or x > 1.0:
        return math_nan_float64()
    if x == 0.0:
        return 0.0
    if x == 1.0:
        return 1.0
    let bt: Float64 = math_exp_float64(a * math_ln_float64(x) + b * math_ln_float64(1.0 - x) - math_lbeta_float64(a, b))
    if x < (a + 1.0) / (a + b + 2.0):
        return bt * math_betacf_v1(a, b, x) / a
    return 1.0 - (bt * math_betacf_v1(b, a, 1.0 - x) / b)
