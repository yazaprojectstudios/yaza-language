use "app"
use "std/sync"
use "std/web/request"

start:
    let raw: Bytes = bytes_from_text("GET / HTTP/1.1\r\nHost: localhost\r\nX-Request-Id: trace-smoke-1\r\n\r\n")
    let parsed: Result[WebRequest, Text] = web_parse_request(raw)
    assert result_is_ok(parsed)
    let response: WebResponse = app_dispatch_request(result_unwrap(parsed), "./public", "balanced", atomic_create(0), atomic_create(0))
    assert response.status_code == 200
    say "mvc-trace-smoke passed"
