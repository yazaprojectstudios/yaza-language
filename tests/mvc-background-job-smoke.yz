use "models/background_job_repository"
use "jobs/handlers"

fn check_background_jobs() -> Result[Boolean, Text]:
    let echo_id: Number = background_job_enqueue("echo", "ready")?
    let conn: YazaBaseConnection = background_job_connect()?
    let first: Option[BackgroundJob] = background_job_claim(conn)?
    assert option_is_some(first)
    let echo_job: BackgroundJob = option_unwrap(first)
    assert echo_job.id == echo_id
    let echo_result: Text = background_job_handle(echo_job)?
    assert echo_result == "ready"
    let echo_done: Boolean = background_job_complete(conn, echo_job, echo_result)?

    let file_id: Number = background_job_enqueue("sha256_file", "input.txt")?
    let second: Option[BackgroundJob] = background_job_claim(conn)?
    assert option_is_some(second)
    let file_job: BackgroundJob = option_unwrap(second)
    assert file_job.id == file_id
    let digest: Text = background_job_handle(file_job)?
    assert digest == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
    let file_done: Boolean = background_job_complete(conn, file_job, digest)?

    let unknown_id: Number = background_job_enqueue("unknown", "")?
    let third: Option[BackgroundJob] = background_job_claim(conn)?
    assert option_is_some(third)
    let unknown_job: BackgroundJob = option_unwrap(third)
    assert unknown_job.id == unknown_id
    let missing: Result[Text, Text] = background_job_handle(unknown_job)
    assert not result_is_ok(missing)
    let failed: Boolean = background_job_retry(conn, BackgroundJob(unknown_job.id, unknown_job.kind, unknown_job.payload, 4), result_unwrap_error(missing))?
    let p: TextList = text_list()
    list_push(p, "bigint:" + number_text(unknown_id))
    let status_csv: Text = yazabase_query_csv(conn, "SELECT status, attempts FROM background_jobs WHERE id = $1", p)?
    assert text_find(status_csv, "failed") >= 0
    return ok(true)

start:
    let checked: Result[Boolean, Text] = check_background_jobs()
    if not result_is_ok(checked):
        say result_unwrap_error(checked)
        exit(1)
    say "mvc-background-job-smoke passed"
