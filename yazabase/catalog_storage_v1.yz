# Read and validate the file-backed YDBv1 system-catalog root directory.
use "./page_v1"
use "./catalog_v1"
use "./storage_v1"

fn yaza_db_catalog_storage_read_root_v1(file: Number, file_header: YazaDbFileHeaderV1) -> Result[YazaDbCatalogRootV1, Text]:
    if file_header.catalog_root == 0: return err("YDBv1 file has no installed system-catalog root")
    let descriptor_page: Bytes = yaza_db_storage_read_page_validated_file_v1(file, file_header, file_header.catalog_root)?
    let catalog: YazaDbCatalogRootV1 = yaza_db_catalog_root_validate_header_v1(descriptor_page, file_header.catalog_root, file_header)?
    let roots: List[Number] = [catalog.sys_tables_root, catalog.sys_columns_root, catalog.sys_indexes_root, catalog.sys_constraints_root]
    if catalog.sys_views_root != 0 and not list_try_push(roots, catalog.sys_views_root): return err("YDBv1 catalog-root loader could not allocate its optional sys_views root")
    var index: Number = 0
    while index < list_count(roots):
        let root_page_id: Number = list_get(roots, index)
        let root_page: Bytes = yaza_db_storage_read_page_validated_file_v1(file, file_header, root_page_id)?
        let root_header: YazaDbPageHeaderV1 = yaza_db_page_header_decode_v1(root_page, root_page_id)?
        if root_header.page_type != 1 and root_header.page_type != 2: return err("YDBv1 system-catalog root is not a B+Tree page")
        set index = index + 1
    return ok(catalog)
