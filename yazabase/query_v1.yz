fn yaza_db_execute_single_select_with_tokens_and_virtual_relations_and_prior_v1(file: Number, file_header: YazaDbFileHeaderV1, source: Text, tokens: List[YazaSqlTokenV1], parameters: List[YazaSqlValueV1], virtual_relations: List[YazaDbQueryVirtualRelationV1], statement_prior_work_units: Number) -> Result[YazaSqlQueryResultV1, Text]:
