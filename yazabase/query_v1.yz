fn yaza_db_execute_single_select_v1(file: Number, file_header: YazaDbFileHeaderV1, source: Text, parameters: List[YazaSqlValueV1]) -> Result[YazaSqlQueryResultV1, Text]:
    return yaza_db_execute_single_select_with_virtual_relations_v1(file, file_header, source, parameters, List[YazaDbQueryVirtualRelationV1]())

fn yaza_db_execute_single_select_at_snapshot_with_virtual_relations_and_prior_v1(storage: YazaDbStorageHandleV1, wal: YazaDbWalLogV1, source: Text, parameters: List[YazaSqlValueV1], snapshot_ts: Number, own_txn_id: Number, transactions: List[YazaDbTxnStatusV1], virtual_relations: List[YazaDbQueryVirtualRelationV1], statement_prior_work_units: Number) -> Result[YazaSqlQueryResultV1, Text]:
    if statement_prior_work_units < 0 or statement_prior_work_units > yaza_sql_executor_max_work_units_v1(): return err("YDBv1 historical SELECT prior statement work is outside its bound")
    if storage.root != wal.root or not bytes_equal(storage.header.db_uuid, wal.db_uuid): return err("YDBv1 historical SELECT storage and WAL handles belong to different databases")
    if snapshot_ts < 1 or snapshot_ts > storage.header.next_commit_ts - 1 or own_txn_id < 0: return err("YDBv1 historical SELECT snapshot or transaction identity is outside the committed range")
    let base_loaded: YazaDbCatalogSnapshotWithRootsV1 = yaza_db_catalog_snapshot_load_with_roots_v1(storage.file, storage.header)?
    var loaded: YazaDbCatalogSnapshotWithRootsV1 = base_loaded
    if list_count(virtual_relations) > 0:
        set loaded = yaza_db_query_catalog_with_virtual_relations_v1(base_loaded, virtual_relations)?
    let catalog_snapshot: YazaSqlCatalogSnapshotV1 = loaded.sql_snapshot
    let parsed: YazaSqlSelectAstV3 = yaza_sql_parse_select_v3(source)?
    if yaza_db_query_select_references_unshadowed_view_v1(source, parsed, base_loaded.views, virtual_relations):
        if snapshot_ts != base_loaded.sql_snapshot.version:
            return err("YDBv1 historical SELECT through a persistent view is not supported until view metadata is loaded at the requested catalog snapshot")
        if own_txn_id != 0:
            return err("YDBv1 SELECT through a persistent view does not support an uncommitted transaction snapshot")
        return yaza_db_execute_single_select_with_virtual_relations_and_prior_v1(storage.file, storage.header, source, parameters, virtual_relations, statement_prior_work_units)
    let plan: YazaSqlBoundPlanV1 = yaza_sql_bind_select_v1(source, parsed, catalog_snapshot)?
    let virtual_index: Number = yaza_db_query_virtual_relation_index_v1(virtual_relations, plan.table_id)
    var uses_virtual_relation: Boolean = virtual_index >= 0 or yaza_db_query_virtual_relation_index_v1(virtual_relations, plan.right_table_id) >= 0
    var stage_probe: Number = 0
    while stage_probe < list_count(plan.join_stages):
        if yaza_db_query_virtual_relation_index_v1(virtual_relations, list_get(plan.join_stages, stage_probe).table_id) >= 0:
            set uses_virtual_relation = true
        set stage_probe = stage_probe + 1
    if uses_virtual_relation:
        let scoped_subqueries: List[YazaSqlSubqueryValuesV1] = yaza_db_query_materialize_subqueries_at_snapshot_with_virtual_relations_and_prior_v1(storage, wal, plan, parameters, snapshot_ts, own_txn_id, transactions, virtual_relations, statement_prior_work_units)?
        if plan.right_table_id > 0:
            let catalog: YazaDbCatalogRootV1 = yaza_db_catalog_storage_read_root_v1(storage.file, storage.header)?
            let left_memory: YazaSqlMemoryTableV1 = yaza_db_query_join_relation_at_snapshot_v1(storage, wal, catalog, loaded, plan.table_id, snapshot_ts, own_txn_id, transactions, virtual_relations)?
            let right_memory: YazaSqlMemoryTableV1 = yaza_db_query_join_relation_at_snapshot_v1(storage, wal, catalog, loaded, plan.right_table_id, snapshot_ts, own_txn_id, transactions, virtual_relations)?
            var joined_table: YazaSqlMemoryTableV1 = yaza_sql_join_dispatch_memory_v1(plan, left_memory, right_memory)?
            var stage_index: Number = 0
            while stage_index < list_count(plan.join_stages):
                let stage: YazaSqlBoundJoinStageV1 = list_get(plan.join_stages, stage_index)
                set joined_table = yaza_db_query_join_stage_at_snapshot_with_virtual_relations_v1(storage, wal, catalog, loaded, plan, stage, snapshot_ts, own_txn_id, transactions, joined_table, virtual_relations)?
                set stage_index = stage_index + 1
            return yaza_sql_execute_memory_with_subqueries_and_prior_v1(plan, joined_table, parameters, scoped_subqueries, statement_prior_work_units)
        if virtual_index >= 0:
            return yaza_sql_execute_memory_with_subqueries_and_prior_v1(plan, list_get(virtual_relations, virtual_index).memory, parameters, scoped_subqueries, statement_prior_work_units)
    let subquery_values: List[YazaSqlSubqueryValuesV1] = yaza_db_query_materialize_subqueries_at_snapshot_with_virtual_relations_and_prior_v1(storage, wal, plan, parameters, snapshot_ts, own_txn_id, transactions, virtual_relations, statement_prior_work_units)?
    let table_index: Number = yaza_db_catalog_snapshot_table_index_v1(catalog_snapshot.tables, plan.table_id)
    if table_index < 0 or table_index >= list_count(loaded.root_page_ids) or table_index >= list_count(loaded.table_schema_versions): return err("YDBv1 historical SELECT bound table is absent from the current catalog")
    let table_existed: Boolean = yaza_db_query_table_exists_at_snapshot_v1(storage, wal, plan.table_id, snapshot_ts, own_txn_id, transactions)?
    if not table_existed: return err("YDBv1 historical SELECT table did not exist at the requested snapshot")
    let table_root_page_id: Number = list_get(loaded.root_page_ids, table_index)
    let table_schema: YazaSqlTableSchemaV1 = list_get(catalog_snapshot.tables, table_index)
    let table_schema_version: Number = list_get(loaded.table_schema_versions, table_index)
    let catalog: YazaDbCatalogRootV1 = yaza_db_catalog_storage_read_root_v1(storage.file, storage.header)?
    if plan.right_table_id > 0:
        let right_table_index: Number = yaza_db_catalog_snapshot_table_index_v1(catalog_snapshot.tables, plan.right_table_id)
        if right_table_index < 0 or right_table_index >= list_count(loaded.root_page_ids) or right_table_index >= list_count(loaded.table_schema_versions): return err("YDBv1 historical SELECT joined table is absent from the current catalog")
        let right_table_existed: Boolean = yaza_db_query_table_exists_at_snapshot_v1(storage, wal, plan.right_table_id, snapshot_ts, own_txn_id, transactions)?
        if not right_table_existed: return err("YDBv1 historical SELECT joined table did not exist at the requested snapshot")
        let right_table_root_page_id: Number = list_get(loaded.root_page_ids, right_table_index)
        let right_table_schema: YazaSqlTableSchemaV1 = list_get(catalog_snapshot.tables, right_table_index)
        let right_table_schema_version: Number = list_get(loaded.table_schema_versions, right_table_index)
        let left_key_ordinals: List[Number] = yaza_db_query_clustered_key_ordinals_v1(storage.file, storage.header, catalog, plan.table_id, table_root_page_id, catalog_snapshot.version, list_count(table_schema.columns))?
        let right_key_ordinals: List[Number] = yaza_db_query_clustered_key_ordinals_v1(storage.file, storage.header, catalog, plan.right_table_id, right_table_root_page_id, catalog_snapshot.version, list_count(right_table_schema.columns))?
        let left_stored_rows: List[YazaDbRowV1] = yaza_db_btree_read_rows_at_snapshot_for_schema_v1(storage.root, wal.db_uuid, wal.next_lsn, storage.file, storage.header, table_root_page_id, table_schema.columns, table_schema_version, left_key_ordinals, snapshot_ts, 65536, own_txn_id, transactions)?
        let right_stored_rows: List[YazaDbRowV1] = yaza_db_btree_read_rows_at_snapshot_for_schema_v1(storage.root, wal.db_uuid, wal.next_lsn, storage.file, storage.header, right_table_root_page_id, right_table_schema.columns, right_table_schema_version, right_key_ordinals, snapshot_ts, 65536, own_txn_id, transactions)?
        let left_memory_table: YazaSqlMemoryTableV1 = yaza_db_query_memory_table_v1(plan.table_id, catalog_snapshot.version, table_schema.columns, left_stored_rows)?
        let right_memory_table: YazaSqlMemoryTableV1 = yaza_db_query_memory_table_v1(plan.right_table_id, catalog_snapshot.version, right_table_schema.columns, right_stored_rows)?
        var joined_table: YazaSqlMemoryTableV1 = yaza_sql_join_dispatch_memory_v1(plan, left_memory_table, right_memory_table)?
        var stage_index: Number = 0
        while stage_index < list_count(plan.join_stages):
            let stage: YazaSqlBoundJoinStageV1 = list_get(plan.join_stages, stage_index)
            set joined_table = yaza_db_query_join_stage_at_snapshot_v1(storage, wal, catalog, loaded, plan, stage, snapshot_ts, own_txn_id, transactions, joined_table)?
            set stage_index = stage_index + 1
        return yaza_sql_execute_memory_with_subqueries_v1(plan, joined_table, parameters, subquery_values)
    let key_ordinals: List[Number] = yaza_db_query_clustered_key_ordinals_v1(storage.file, storage.header, catalog, plan.table_id, table_root_page_id, catalog_snapshot.version, list_count(table_schema.columns))?
    var stored_rows: List[YazaDbRowV1] = List[YazaDbRowV1]()
    var filter_was_pushed: Boolean = false
    var prior_scan_work_units: Number = 0
    if yaza_db_query_prefix_limit_eligible_v1(plan):
        set stored_rows = yaza_db_btree_read_rows_at_snapshot_prefix_for_schema_v1(storage.root, wal.db_uuid, wal.next_lsn, storage.file, storage.header, table_root_page_id, table_schema.columns, table_schema_version, key_ordinals, snapshot_ts, plan.limit, own_txn_id, transactions)?
    elif plan.where_root >= 0 and not yaza_db_query_has_correlated_subquery_v1(plan):
        let prepared_filter: List[YazaSqlValueV1] = yaza_db_query_prepare_filter_v1(plan, catalog_snapshot.version, table_schema.columns, parameters)?
        let filter_scan: YazaDbBtreeScanResultV1 = yaza_db_btree_read_rows_where_at_snapshot_with_stats_for_schema_v1(storage.root, wal.db_uuid, wal.next_lsn, storage.file, storage.header, table_root_page_id, table_schema.columns, table_schema_version, key_ordinals, snapshot_ts, own_txn_id, transactions, plan, prepared_filter, subquery_values)?
        set stored_rows = filter_scan.rows
        set prior_scan_work_units = filter_scan.work_units
        set filter_was_pushed = true
    else:
        set stored_rows = yaza_db_btree_read_rows_at_snapshot_for_schema_v1(storage.root, wal.db_uuid, wal.next_lsn, storage.file, storage.header, table_root_page_id, table_schema.columns, table_schema_version, key_ordinals, snapshot_ts, 65536, own_txn_id, transactions)?
    let memory_table: YazaSqlMemoryTableV1 = yaza_db_query_memory_table_v1(plan.table_id, catalog_snapshot.version, table_schema.columns, stored_rows)?
    if filter_was_pushed: return yaza_sql_execute_memory_with_scan_v1(plan, memory_table, parameters, subquery_values, prior_scan_work_units, statement_prior_work_units, true)
    return yaza_sql_execute_memory_with_subqueries_and_prior_v1(plan, memory_table, parameters, subquery_values, statement_prior_work_units)

fn yaza_db_execute_single_select_at_snapshot_with_virtual_relations_v1(storage: YazaDbStorageHandleV1, wal: YazaDbWalLogV1, source: Text, parameters: List[YazaSqlValueV1], snapshot_ts: Number, own_txn_id: Number, transactions: List[YazaDbTxnStatusV1], virtual_relations: List[YazaDbQueryVirtualRelationV1]) -> Result[YazaSqlQueryResultV1, Text]:
    return yaza_db_execute_single_select_at_snapshot_with_virtual_relations_and_prior_v1(storage, wal, source, parameters, snapshot_ts, own_txn_id, transactions, virtual_relations, 0)

fn yaza_db_execute_single_select_at_snapshot_v1(storage: YazaDbStorageHandleV1, wal: YazaDbWalLogV1, source: Text, parameters: List[YazaSqlValueV1], snapshot_ts: Number, own_txn_id: Number, transactions: List[YazaDbTxnStatusV1]) -> Result[YazaSqlQueryResultV1, Text]:
    return yaza_db_execute_single_select_at_snapshot_with_virtual_relations_v1(storage, wal, source, parameters, snapshot_ts, own_txn_id, transactions, List[YazaDbQueryVirtualRelationV1]())

fn yaza_db_query_prepare_cte_branches_v1(parsed: YazaSqlCteQueryV1, parameters: List[YazaSqlValueV1]) -> Result[List[YazaSqlSetPreparedBranchV1], Text]:
    let branch_count: Number = list_count(parsed.definitions) + 1
    let branches_created: Result[List[Text], Text] = list_try_new()
    let operators_created: Result[List[YazaSqlSetOperatorV1], Text] = list_try_new()
    let order_created: Result[List[YazaSqlSetOrderTermV1], Text] = list_try_new()
    if not result_is_ok(branches_created) or not result_is_ok(operators_created) or not result_is_ok(order_created):
        return err("SQL CTE could not allocate statement-wide bind metadata")
    let branches: List[Text] = result_unwrap(branches_created)
    let operators: List[YazaSqlSetOperatorV1] = result_unwrap(operators_created)
    if not list_try_reserve(branches, branch_count) or not list_try_reserve(operators, branch_count - 1):
        return err("SQL CTE could not reserve statement-wide bind metadata")
    var index: Number = 0
    while index < list_count(parsed.definitions):
        if not list_try_push(branches, list_get(parsed.definitions, index).query): return err("SQL CTE could not append a definition query for bind validation")
        if index > 0 and not list_try_push(operators, YazaSqlSetOperatorV1(1, false)): return err("SQL CTE could not append bounded bind metadata")
        set index = index + 1
    if not list_try_push(branches, parsed.main_query): return err("SQL CTE could not append its final query for bind validation")
    if list_count(operators) + 1 != list_count(branches):
        if not list_try_push(operators, YazaSqlSetOperatorV1(1, false)): return err("SQL CTE could not complete statement-wide bind metadata")
    return yaza_sql_set_prepare_branches_v1(YazaSqlSetQueryPartsV1(branches, List[Number](), operators, false, result_unwrap(order_created), false, 0), parameters)

fn yaza_db_query_source_byte_marker_v1() -> Text:
    return "__YAZA_SQL_SOURCE_BYTE__:"

fn yaza_db_query_error_local_byte_v1(error: Text) -> Number:
    let internal_marker: Text = yaza_db_query_source_byte_marker_v1()
    var digit_offset: Number = -1
    var delimiter: Number = -1
    if text_starts_with(error, internal_marker):
        set digit_offset = text_length(internal_marker)
        set delimiter = 58
    else:
        let location_marker: Text = " at byte "
        let marker_offset: Number = text_find(error, location_marker)
        if marker_offset < 0: return -1
        set digit_offset = marker_offset + text_length(location_marker)
    var value: Number = 0
    var digit_count: Number = 0
    while digit_offset < text_length(error):
        let byte: Number = text_byte(error, digit_offset)
        if byte < 48 or byte > 57: break
        if value > 65536: return -1
        set value = value * 10 + byte - 48
        if value > 1048576: return -1
        set digit_count = digit_count + 1
        set digit_offset = digit_offset + 1
    if digit_count == 0: return -1
    if delimiter == 58 and (digit_offset >= text_length(error) or text_byte(error, digit_offset) != delimiter): return -1
    return value

fn yaza_db_query_error_reason_v1(error: Text) -> Text:
    var raw_error: Text = error
    let internal_marker: Text = yaza_db_query_source_byte_marker_v1()
    if text_starts_with(error, internal_marker):
        var digit_offset: Number = text_length(internal_marker)
        while digit_offset < text_length(error) and text_byte(error, digit_offset) >= 48 and text_byte(error, digit_offset) <= 57:
            set digit_offset = digit_offset + 1
        if digit_offset >= text_length(error) or text_byte(error, digit_offset) != 58: return error
        let tail_result: Result[Text, Text] = text_try_slice(error, digit_offset + 1, text_length(error) - digit_offset - 1)
        if not result_is_ok(tail_result): return error
        set raw_error = result_unwrap(tail_result)
    let location_marker: Text = " at byte "
    let marker_offset: Number = text_find(raw_error, location_marker)
    if marker_offset < 0: return raw_error
    let reason_result: Result[Text, Text] = text_try_slice(raw_error, 0, marker_offset)
    if not result_is_ok(reason_result): return raw_error
    return result_unwrap(reason_result)

fn yaza_db_query_map_prepared_source_byte_v1(original_source: Text, prepared_source: Text, prepared_byte: Number) -> Number:
    if prepared_byte < 0 or prepared_byte > text_length(prepared_source): return -1
    if text_compare(original_source, prepared_source) == 0: return prepared_byte
    let original_tokens_result: Result[List[YazaSqlTokenV1], Text] = yaza_sql_lex_v1(original_source)
    let prepared_tokens_result: Result[List[YazaSqlTokenV1], Text] = yaza_sql_lex_v1(prepared_source)
    if not result_is_ok(original_tokens_result) or not result_is_ok(prepared_tokens_result): return -1
    let original_tokens: List[YazaSqlTokenV1] = result_unwrap(original_tokens_result)
    let prepared_tokens: List[YazaSqlTokenV1] = result_unwrap(prepared_tokens_result)
    if list_count(original_tokens) != list_count(prepared_tokens): return -1
    var original_cursor: Number = 0
    var prepared_cursor: Number = 0
    var token_index: Number = 0
    while token_index < list_count(original_tokens):
        let original_token: YazaSqlTokenV1 = list_get(original_tokens, token_index)
        let prepared_token: YazaSqlTokenV1 = list_get(prepared_tokens, token_index)
        if original_token.kind != prepared_token.kind: return -1
        let original_gap: Number = original_token.start_byte - original_cursor
        let prepared_gap: Number = prepared_token.start_byte - prepared_cursor
        if original_gap < 0 or prepared_gap != original_gap: return -1
        if text_compare(text_slice(original_source, original_cursor, original_gap), text_slice(prepared_source, prepared_cursor, prepared_gap)) != 0: return -1
        if prepared_byte < prepared_token.start_byte: return original_cursor + prepared_byte - prepared_cursor
        if prepared_token.kind == 0:
            if text_length(original_source) - original_cursor != text_length(prepared_source) - prepared_cursor: return -1
            if text_compare(text_slice(original_source, original_cursor, text_length(original_source) - original_cursor), text_slice(prepared_source, prepared_cursor, text_length(prepared_source) - prepared_cursor)) != 0: return -1
            return original_cursor + prepared_byte - prepared_cursor
        let original_token_length: Number = original_token.end_byte - original_token.start_byte
        let prepared_token_length: Number = prepared_token.end_byte - prepared_token.start_byte
        if prepared_byte < prepared_token.end_byte:
            if original_token.kind == 5 and prepared_token.kind == 5 and original_token_length != prepared_token_length: return original_token.start_byte
            if original_token_length != prepared_token_length: return -1
            if text_compare(text_slice(original_source, original_token.start_byte, original_token_length), text_slice(prepared_source, prepared_token.start_byte, prepared_token_length)) != 0 and original_token.kind != 5: return -1
            return original_token.start_byte + prepared_byte - prepared_token.start_byte
        if original_token_length != prepared_token_length and (original_token.kind != 5 or prepared_token.kind != 5): return -1
        if original_token.kind != 5 and text_compare(text_slice(original_source, original_token.start_byte, original_token_length), text_slice(prepared_source, prepared_token.start_byte, prepared_token_length)) != 0: return -1
        if prepared_byte == prepared_token.end_byte and original_token_length != prepared_token_length: return original_token.end_byte
        set original_cursor = original_token.end_byte
        set prepared_cursor = prepared_token.end_byte
        set token_index = token_index + 1
    return -1

fn yaza_db_query_set_branch_source_error_v1(original_branch: Text, branch_start_byte: Number, prepared_branch: Text, original_error: Text) -> Text:
    let local_error_byte: Number = yaza_db_query_error_local_byte_v1(original_error)
    var mapped_byte: Number = 0
    if local_error_byte >= 0:
        let candidate: Number = yaza_db_query_map_prepared_source_byte_v1(original_branch, prepared_branch, local_error_byte)
        if candidate >= 0: set mapped_byte = candidate
    if mapped_byte > text_length(original_branch): set mapped_byte = 0
    var safe_branch_start_byte: Number = branch_start_byte
    if safe_branch_start_byte < 0: set safe_branch_start_byte = 0
    let absolute_byte: Number = safe_branch_start_byte + mapped_byte
    let absolute_text: Result[Text, Text] = number_try_text(absolute_byte)
    if not result_is_ok(absolute_text): return original_error
    return yaza_db_query_source_byte_marker_v1() + result_unwrap(absolute_text) + ":" + yaza_db_query_error_reason_v1(original_error)

fn yaza_db_query_cte_source_error_v1(source: Text, original_fragment: Text, fragment_start_byte: Number, fallback_byte: Number, executed_fragment: Text, context: Text, original_error: Text) -> Text:
    var absolute_byte: Number = fallback_byte
    let local_error_byte: Number = yaza_db_query_error_local_byte_v1(original_error)
    if local_error_byte >= 0:
        let mapped_byte: Number = yaza_db_query_map_prepared_source_byte_v1(original_fragment, executed_fragment, local_error_byte)
        if mapped_byte >= 0 and fragment_start_byte >= 0 and fragment_start_byte <= text_length(source) - mapped_byte:
            set absolute_byte = fragment_start_byte + mapped_byte
    let reason: Text = yaza_db_query_error_reason_v1(original_error)
    if absolute_byte < 0 or absolute_byte > text_length(source): return original_error
    let location_result: Result[YazaSqlSourceLocationV1, Text] = yaza_sql_v1_location(source, absolute_byte)
    if not result_is_ok(location_result): return original_error
    let location: YazaSqlSourceLocationV1 = result_unwrap(location_result)
    let byte_text: Result[Text, Text] = number_try_text(absolute_byte)
    let line_text: Result[Text, Text] = number_try_text(location.line)
    let column_text: Result[Text, Text] = number_try_text(location.column)
    if not result_is_ok(byte_text) or not result_is_ok(line_text) or not result_is_ok(column_text): return original_error
    var output: Result[Text, Text] = text_try_concat("SQL ", context)
    if not result_is_ok(output): return original_error
    set output = text_try_concat(result_unwrap(output), " failed at byte ")
    if not result_is_ok(output): return original_error
    set output = text_try_concat(result_unwrap(output), result_unwrap(byte_text))
    if not result_is_ok(output): return original_error
    set output = text_try_concat(result_unwrap(output), " (line ")
    if not result_is_ok(output): return original_error
    set output = text_try_concat(result_unwrap(output), result_unwrap(line_text))
    if not result_is_ok(output): return original_error
    set output = text_try_concat(result_unwrap(output), ", column ")
    if not result_is_ok(output): return original_error
    set output = text_try_concat(result_unwrap(output), result_unwrap(column_text))
    if not result_is_ok(output): return original_error
    set output = text_try_concat(result_unwrap(output), "): ")
    if not result_is_ok(output): return original_error
    set output = text_try_concat(result_unwrap(output), reason)
    if not result_is_ok(output): return original_error
    return result_unwrap(output)

fn yaza_db_query_public_sql_error_v1(source: Text, original_error: Text) -> Text:
    if not text_starts_with(original_error, yaza_db_query_source_byte_marker_v1()): return original_error
    return yaza_db_query_cte_source_error_v1(source, source, 0, 0, source, "query", original_error)

fn yaza_db_query_validate_cte_result_budget_v1(result: YazaSqlQueryResultV1, prior_rows: Number, prior_cells: Number, prior_text_bytes: Number, prior_work_units: Number) -> Result[YazaDbQueryCteBudgetV1, Text]:
    if prior_rows < 0 or prior_rows > 65536 or prior_cells < 0 or prior_cells > yaza_sql_executor_max_input_cells_v1() or prior_text_bytes < 0 or prior_text_bytes > yaza_sql_executor_max_input_text_bytes_v1():
        return err("SQL CTE statement-wide materialization counters are outside their bounds")
    if prior_work_units < 0 or prior_work_units > yaza_sql_executor_max_work_units_v1(): return err("SQL CTE statement-wide work counter is outside its bound")
    let column_count: Number = list_count(result.columns)
    if column_count < 1 or column_count > 1024 or list_count(result.rows) > 65536:
        return err("SQL CTE output exceeds its bounded relation dimensions")
    if result.auxiliary_rows < 0 or result.auxiliary_rows > 65536 - list_count(result.rows):
        return err("SQL CTE nested materialization exceeds its bounded row profile")
    let added_rows: Number = list_count(result.rows) + result.auxiliary_rows
    if added_rows > 65536 - prior_rows:
        return err("SQL CTE materialization exceeds the statement-wide row budget")
    let cell_count: Number = list_count(result.rows) * column_count
    if result.auxiliary_cells < 0 or result.auxiliary_cells > yaza_sql_executor_max_input_cells_v1() - cell_count:
        return err("SQL CTE nested materialization exceeds its bounded cell profile")
    let added_cells: Number = cell_count + result.auxiliary_cells
    if added_cells > yaza_sql_executor_max_input_cells_v1() - prior_cells:
        return err("SQL CTE materialization exceeds the statement-wide cell budget")
    var text_bytes: Number = 0
    var row_index: Number = 0
    while row_index < list_count(result.rows):
        let row: List[YazaSqlValueV1] = list_get(result.rows, row_index)
        if list_count(row) != column_count: return err("SQL CTE result row width does not match its output schema")
        var column_index: Number = 0
        while column_index < column_count:
            let value: YazaSqlValueV1 = list_get(row, column_index)
            let projection: YazaSqlBoundProjectionV1 = list_get(result.columns, column_index)
            if value.type_id != projection.type_id or value.source_literal:
                return err("SQL CTE result row value does not match its bound output type")
            if (value.type_id == 9 or value.type_id == 16) and not value.is_null:
                let length: Number = yaza_sql_value_variable_length_v1(value)?
                if length > yaza_sql_executor_max_input_text_bytes_v1() - prior_text_bytes - text_bytes:
                    return err("SQL CTE materialization exceeds the statement-wide variable-width byte budget")
                set text_bytes = text_bytes + length
            set column_index = column_index + 1
        set row_index = row_index + 1
    if result.auxiliary_text_bytes < 0 or result.auxiliary_text_bytes > yaza_sql_executor_max_input_text_bytes_v1() - text_bytes:
        return err("SQL CTE nested materialization exceeds its bounded Text profile")
    let added_text_bytes: Number = text_bytes + result.auxiliary_text_bytes
    if added_text_bytes > yaza_sql_executor_max_input_text_bytes_v1() - prior_text_bytes:
        return err("SQL CTE materialization exceeds the statement-wide text-byte budget")
    if result.work_units < 0 or result.work_units > yaza_sql_executor_max_work_units_v1() - prior_work_units:
        return err("SQL CTE definitions and subqueries exceed the statement-wide work budget")
    return ok(YazaDbQueryCteBudgetV1(added_rows, added_cells, added_text_bytes, result.work_units))

fn yaza_db_query_explain_append_v1(output: Text, heading: Text, plan_text: Text) -> Result[Text, Text]:
    let with_heading: Text = text_try_concat(output, heading)?
    return text_try_concat(with_heading, plan_text)

fn yaza_db_query_explain_select_or_set_v1(source: Text, catalog: YazaSqlCatalogSnapshotV1, views: List[YazaDbCatalogViewV1], existing_relations: List[YazaDbQueryVirtualRelationV1]) -> Result[YazaDbQueryCteExplainV1, Text]:
    let parts: YazaSqlSetQueryPartsV1 = yaza_sql_set_split_v1(source)?
    var branch_count: Number = 1
    if list_count(parts.operators) > 0: set branch_count = list_count(parts.branches)
    if branch_count < 1 or list_count(parts.operators) > 0 and list_count(parts.operators) + 1 != branch_count:
        return err("SQL CTE EXPLAIN received inconsistent SELECT/set-operation branches")
    var output: Text = ""
    var first_result: YazaSqlQueryResultV1 = YazaSqlQueryResultV1(List[YazaSqlBoundProjectionV1](), List[List[YazaSqlValueV1]](), 0, 0, 0, 0)
    var branch_index: Number = 0
    while branch_index < branch_count:
        var branch_source: Text = source
        if list_count(parts.operators) > 0: set branch_source = list_get(parts.branches, branch_index)
        let parsed: YazaSqlSelectAstV3 = yaza_sql_parse_select_v3(branch_source)?
        let view_relations: List[YazaDbQueryVirtualRelationV1] = yaza_db_query_view_schemas_for_select_v1(branch_source, parsed, views, existing_relations, catalog.version)?
        let plan_catalog: YazaSqlCatalogSnapshotV1 = yaza_db_query_sql_catalog_with_virtual_relations_v1(catalog, view_relations)?
        let plan: YazaSqlBoundPlanV1 = yaza_sql_bind_select_v1(branch_source, parsed, plan_catalog)?
        let branch_result: YazaSqlQueryResultV1 = YazaSqlQueryResultV1(plan.projections, List[List[YazaSqlValueV1]](), 0, 0, 0, 0)
        if branch_index == 0:
            set first_result = branch_result
        else:
            let schema_matches: Boolean = yaza_sql_set_validate_results_v1(first_result, branch_result)?
            if not schema_matches: return err("SQL CTE EXPLAIN set-operation branches have incompatible schemas")
        let branch_number: Text = number_try_text(branch_index + 1)?
        let heading: Text = text_try_concat("SELECT branch ", branch_number)?
        let heading_line: Text = text_try_concat(heading, "\n")?
        let branch_plan: Text = yaza_sql_explain_bound_select_v1(plan)?
        let annotation: Text = yaza_db_query_view_explain_annotation_v1(view_relations, views)?
        let annotated_plan: Text = text_try_concat(annotation, branch_plan)?
        set output = yaza_db_query_explain_append_v1(output, heading_line, annotated_plan)?
        if branch_index < list_count(parts.operators):
            let operation: YazaSqlSetOperatorV1 = list_get(parts.operators, branch_index)
            var operation_name: Text = "Set combine: "
            if operation.kind == 1: set operation_name = "Set combine: UNION"
            elif operation.kind == 2: set operation_name = "Set combine: INTERSECT"
            elif operation.kind == 3: set operation_name = "Set combine: EXCEPT"
            if operation.all: set operation_name = text_try_concat(operation_name, " ALL")?
            set operation_name = text_try_concat(operation_name, "\n")?
            set output = text_try_concat(output, operation_name)?
        set branch_index = branch_index + 1
    if list_count(parts.operators) > 0:
        let validated_modifiers: YazaSqlQueryResultV1 = yaza_sql_set_apply_final_modifiers_v1(first_result, parts, source)?
    return ok(YazaDbQueryCteExplainV1(first_result.columns, output))

fn yaza_db_query_explain_cte_select_v1(file: Number, file_header: YazaDbFileHeaderV1, source: Text, parameters: List[YazaSqlValueV1]) -> Result[Text, Text]:
    if list_count(parameters) != 0: return err("YDBv1 EXPLAIN does not consume runtime bind values")
    let parsed: YazaSqlCteQueryV1 = yaza_sql_cte_parse_v1(source)?
    if parsed.recursive: return err("SQL WITH RECURSIVE is not supported in this YazaBase profile")
    let prepared: List[YazaSqlSetPreparedBranchV1] = yaza_db_query_prepare_cte_branches_v1(parsed, parameters)?
    if list_count(prepared) != list_count(parsed.definitions) + 1:
        return err("SQL CTE EXPLAIN statement-wide preparation returned inconsistent branch metadata")
    let base_loaded: YazaDbCatalogSnapshotWithRootsV1 = yaza_db_catalog_snapshot_load_with_roots_v1(file, file_header)?
    let relations_created: Result[List[YazaDbQueryVirtualRelationV1], Text] = list_try_new()
    if not result_is_ok(relations_created): return err("SQL CTE EXPLAIN could not allocate its scoped relation metadata")
    let relations: List[YazaDbQueryVirtualRelationV1] = result_unwrap(relations_created)
    if not list_try_reserve(relations, list_count(parsed.definitions)):
        return err("SQL CTE EXPLAIN could not reserve its scoped relation metadata")
    var output: Text = "YazaBase CTE logical plan v1 (ordered materialization; physical access path not shown)\n"
    var output_index: Number = 0
    while output_index < list_count(parsed.definitions):
        let definition: YazaSqlCteDefinitionV1 = list_get(parsed.definitions, output_index)
        let scoped_catalog: YazaDbCatalogSnapshotWithRootsV1 = yaza_db_query_catalog_with_virtual_relations_v1(base_loaded, relations)?
        let definition_plan_result: Result[YazaDbQueryCteExplainV1, Text] = yaza_db_query_explain_select_or_set_v1(definition.query, scoped_catalog.sql_snapshot, base_loaded.views, relations)
        if not result_is_ok(definition_plan_result):
            let context: Text = "CTE definition query"
            return err(yaza_db_query_cte_source_error_v1(source, definition.query, definition.query_start_byte, definition.name_token.start_byte, "", context, result_unwrap_error(definition_plan_result)))
        let definition_plan: YazaDbQueryCteExplainV1 = result_unwrap(definition_plan_result)
        let name: Text = yaza_db_query_virtual_identifier_v1(source, definition.name_token)?
        let number_text: Text = number_try_text(output_index + 1)?
        let prefix: Text = text_try_concat("CTE[", number_text)?
        let named: Text = text_try_concat(prefix, "] ")?
        let named_relation: Text = text_try_concat(named, name)?
        let materialize: Text = text_try_concat(named_relation, " Materialize(rows<=65536,cells<=1048576,text_bytes<=67108864)\n")?
        set output = yaza_db_query_explain_append_v1(output, materialize, definition_plan.plan_text)?
        let empty_result: YazaSqlQueryResultV1 = YazaSqlQueryResultV1(definition_plan.columns, List[List[YazaSqlValueV1]](), 0, 0, 0, 0)
        let relation: YazaDbQueryVirtualRelationV1 = yaza_db_query_virtual_relation_from_result_v1(source, definition, empty_result, 1000000 + output_index, base_loaded.sql_snapshot.version)?
        if not list_try_push(relations, relation): return err("SQL CTE EXPLAIN could not append a virtual relation schema")
        set output_index = output_index + 1
    let final_branch: YazaSqlSetPreparedBranchV1 = list_get(prepared, list_count(prepared) - 1)
    let final_catalog: YazaDbCatalogSnapshotWithRootsV1 = yaza_db_query_catalog_with_virtual_relations_v1(base_loaded, relations)?
    let final_plan_result: Result[YazaDbQueryCteExplainV1, Text] = yaza_db_query_explain_select_or_set_v1(final_branch.source, final_catalog.sql_snapshot, base_loaded.views, relations)
    if not result_is_ok(final_plan_result):
        return err(yaza_db_query_cte_source_error_v1(source, parsed.main_query, parsed.main_start_byte, parsed.main_start_byte, final_branch.source, "final CTE query", result_unwrap_error(final_plan_result)))
    let final_plan: YazaDbQueryCteExplainV1 = result_unwrap(final_plan_result)
    set output = yaza_db_query_explain_append_v1(output, "Final query\n", final_plan.plan_text)?
    return ok(output)

fn yaza_db_execute_select_with_tokens_and_virtual_relations_and_prior_v1(file: Number, file_header: YazaDbFileHeaderV1, source: Text, tokens: List[YazaSqlTokenV1], parameters: List[YazaSqlValueV1], virtual_relations: List[YazaDbQueryVirtualRelationV1], statement_prior_work_units: Number) -> Result[YazaSqlQueryResultV1, Text]:
    if statement_prior_work_units < 0 or statement_prior_work_units > yaza_sql_executor_max_work_units_v1(): return err("SQL query prior statement work is outside its bound")
    let initial: Result[YazaSqlQueryResultV1, Text] = yaza_db_execute_single_select_with_tokens_and_virtual_relations_and_prior_v1(file, file_header, source, tokens, parameters, virtual_relations, statement_prior_work_units)
    if result_is_ok(initial): return initial
    let parts_result: Result[YazaSqlSetQueryPartsV1, Text] = yaza_sql_set_split_v1(source)
    if not result_is_ok(parts_result): return err(result_unwrap_error(parts_result))
    let parts: YazaSqlSetQueryPartsV1 = result_unwrap(parts_result)
    if list_count(parts.operators) == 0: return err(result_unwrap_error(initial))
    let prepared: List[YazaSqlSetPreparedBranchV1] = yaza_sql_set_prepare_branches_v1(parts, parameters)?
    let results_created: Result[List[YazaSqlQueryResultV1], Text] = list_try_new()
    if not result_is_ok(results_created): return err("SQL CTE set query could not allocate branch results")
    let results: List[YazaSqlQueryResultV1] = result_unwrap(results_created)
    if not list_try_reserve(results, list_count(prepared)): return err("SQL CTE set query could not reserve branch results")
    var branch_work_units: Number = 0
    var index: Number = 0
    while index < list_count(prepared):
        let branch: YazaSqlSetPreparedBranchV1 = list_get(prepared, index)
        if branch_work_units > yaza_sql_executor_max_work_units_v1() - statement_prior_work_units: return err("SQL set branches exceed the statement-wide work budget")
        let branch_prior_work_units: Number = statement_prior_work_units + branch_work_units
        let result_result: Result[YazaSqlQueryResultV1, Text] = yaza_db_execute_single_select_with_virtual_relations_and_prior_v1(file, file_header, branch.source, branch.parameters, virtual_relations, branch_prior_work_units)
        if not result_is_ok(result_result):
            let branch_start_byte: Number = list_get(parts.branch_start_bytes, index)
            return err(yaza_db_query_set_branch_source_error_v1(list_get(parts.branches, index), branch_start_byte, branch.source, result_unwrap_error(result_result)))
        let result: YazaSqlQueryResultV1 = result_unwrap(result_result)
        if result.work_units < 0 or result.work_units > yaza_sql_executor_max_work_units_v1() - branch_work_units - statement_prior_work_units: return err("SQL set branch exceeds the remaining statement work budget")
        set branch_work_units = branch_work_units + result.work_units
        if not list_try_push(results, result): return err("SQL CTE set query could not append a branch result")
        set index = index + 1
    let combined: YazaSqlQueryResultV1 = yaza_sql_set_evaluate_with_prior_v1(results, parts.operators, statement_prior_work_units)?
    if not parts.has_limit and list_count(parts.order_terms) == 0: return ok(combined)
    return yaza_sql_set_apply_final_modifiers_with_prior_v1(combined, parts, source, statement_prior_work_units)

fn yaza_db_execute_select_with_virtual_relations_and_prior_v1(file: Number, file_header: YazaDbFileHeaderV1, source: Text, parameters: List[YazaSqlValueV1], virtual_relations: List[YazaDbQueryVirtualRelationV1], statement_prior_work_units: Number) -> Result[YazaSqlQueryResultV1, Text]:
    let tokens: List[YazaSqlTokenV1] = yaza_sql_lex_v1(source)?
    return yaza_db_execute_select_with_tokens_and_virtual_relations_and_prior_v1(file, file_header, source, tokens, parameters, virtual_relations, statement_prior_work_units)

fn yaza_db_execute_select_with_virtual_relations_v1(file: Number, file_header: YazaDbFileHeaderV1, source: Text, parameters: List[YazaSqlValueV1], virtual_relations: List[YazaDbQueryVirtualRelationV1]) -> Result[YazaSqlQueryResultV1, Text]:
    return yaza_db_execute_select_with_virtual_relations_and_prior_v1(file, file_header, source, parameters, virtual_relations, 0)

fn yaza_db_execute_select_at_snapshot_with_virtual_relations_and_prior_v1(storage: YazaDbStorageHandleV1, wal: YazaDbWalLogV1, source: Text, parameters: List[YazaSqlValueV1], snapshot_ts: Number, own_txn_id: Number, transactions: List[YazaDbTxnStatusV1], virtual_relations: List[YazaDbQueryVirtualRelationV1], statement_prior_work_units: Number) -> Result[YazaSqlQueryResultV1, Text]:
    if statement_prior_work_units < 0 or statement_prior_work_units > yaza_sql_executor_max_work_units_v1(): return err("YDBv1 historical query prior statement work is outside its bound")
    let initial: Result[YazaSqlQueryResultV1, Text] = yaza_db_execute_single_select_at_snapshot_with_virtual_relations_and_prior_v1(storage, wal, source, parameters, snapshot_ts, own_txn_id, transactions, virtual_relations, statement_prior_work_units)
    if result_is_ok(initial): return initial
    let parts_result: Result[YazaSqlSetQueryPartsV1, Text] = yaza_sql_set_split_v1(source)
    if not result_is_ok(parts_result): return err(result_unwrap_error(parts_result))
    let parts: YazaSqlSetQueryPartsV1 = result_unwrap(parts_result)
    if list_count(parts.operators) == 0: return err(result_unwrap_error(initial))
    let prepared: List[YazaSqlSetPreparedBranchV1] = yaza_sql_set_prepare_branches_v1(parts, parameters)?
    let results_created: Result[List[YazaSqlQueryResultV1], Text] = list_try_new()
    if not result_is_ok(results_created): return err("YDBv1 historical CTE set query could not allocate branch results")
    let results: List[YazaSqlQueryResultV1] = result_unwrap(results_created)
    if not list_try_reserve(results, list_count(prepared)): return err("YDBv1 historical CTE set query could not reserve branch results")
    var branch_work_units: Number = 0
    var index: Number = 0
    while index < list_count(prepared):
        let branch: YazaSqlSetPreparedBranchV1 = list_get(prepared, index)
        if branch_work_units > yaza_sql_executor_max_work_units_v1() - statement_prior_work_units: return err("YDBv1 historical set branches exceed the statement-wide work budget")
        let branch_prior_work_units: Number = statement_prior_work_units + branch_work_units
        let result_result: Result[YazaSqlQueryResultV1, Text] = yaza_db_execute_single_select_at_snapshot_with_virtual_relations_and_prior_v1(storage, wal, branch.source, branch.parameters, snapshot_ts, own_txn_id, transactions, virtual_relations, branch_prior_work_units)
        if not result_is_ok(result_result):
            let branch_start_byte: Number = list_get(parts.branch_start_bytes, index)
            return err(yaza_db_query_set_branch_source_error_v1(list_get(parts.branches, index), branch_start_byte, branch.source, result_unwrap_error(result_result)))
        let result: YazaSqlQueryResultV1 = result_unwrap(result_result)
        if result.work_units < 0 or result.work_units > yaza_sql_executor_max_work_units_v1() - branch_work_units - statement_prior_work_units: return err("YDBv1 historical set branch exceeds the remaining statement work budget")
        set branch_work_units = branch_work_units + result.work_units
        if not list_try_push(results, result): return err("YDBv1 historical CTE set query could not append a branch result")
        set index = index + 1
    let combined: YazaSqlQueryResultV1 = yaza_sql_set_evaluate_with_prior_v1(results, parts.operators, statement_prior_work_units)?
    if not parts.has_limit and list_count(parts.order_terms) == 0: return ok(combined)
    return yaza_sql_set_apply_final_modifiers_with_prior_v1(combined, parts, source, statement_prior_work_units)

fn yaza_db_execute_select_at_snapshot_with_virtual_relations_v1(storage: YazaDbStorageHandleV1, wal: YazaDbWalLogV1, source: Text, parameters: List[YazaSqlValueV1], snapshot_ts: Number, own_txn_id: Number, transactions: List[YazaDbTxnStatusV1], virtual_relations: List[YazaDbQueryVirtualRelationV1]) -> Result[YazaSqlQueryResultV1, Text]:
    return yaza_db_execute_select_at_snapshot_with_virtual_relations_and_prior_v1(storage, wal, source, parameters, snapshot_ts, own_txn_id, transactions, virtual_relations, 0)

fn yaza_db_execute_cte_select_v1(file: Number, file_header: YazaDbFileHeaderV1, source: Text, parameters: List[YazaSqlValueV1]) -> Result[YazaSqlQueryResultV1, Text]:
    let parsed: YazaSqlCteQueryV1 = yaza_sql_cte_parse_v1(source)?
    if parsed.recursive: return err("SQL WITH RECURSIVE is not supported in this YazaBase profile")
    let prepared: List[YazaSqlSetPreparedBranchV1] = yaza_db_query_prepare_cte_branches_v1(parsed, parameters)?
    if list_count(prepared) != list_count(parsed.definitions) + 1: return err("SQL CTE statement-wide bind preparation returned inconsistent branch metadata")
    let catalog: YazaSqlCatalogSnapshotV1 = yaza_db_catalog_snapshot_load_v1(file, file_header)?
    let relations_created: Result[List[YazaDbQueryVirtualRelationV1], Text] = list_try_new()
    if not result_is_ok(relations_created): return err("SQL CTE could not allocate its scoped relation set")
    let relations: List[YazaDbQueryVirtualRelationV1] = result_unwrap(relations_created)
    if not list_try_reserve(relations, list_count(parsed.definitions)): return err("SQL CTE could not reserve its scoped relation set")
    var total_rows: Number = 0
    var total_cells: Number = 0
    var total_text_bytes: Number = 0
    var total_work_units: Number = 0
    var index: Number = 0
    while index < list_count(parsed.definitions):
        let definition: YazaSqlCteDefinitionV1 = list_get(parsed.definitions, index)
        let prepared_branch: YazaSqlSetPreparedBranchV1 = list_get(prepared, index)
        let query_result_result: Result[YazaSqlQueryResultV1, Text] = yaza_db_execute_select_with_virtual_relations_and_prior_v1(file, file_header, prepared_branch.source, prepared_branch.parameters, relations, total_work_units)
        if not result_is_ok(query_result_result):
            let context: Text = "CTE definition query"
            return err(yaza_db_query_cte_source_error_v1(source, definition.query, definition.query_start_byte, definition.name_token.start_byte, prepared_branch.source, context, result_unwrap_error(query_result_result)))
        let query_result: YazaSqlQueryResultV1 = result_unwrap(query_result_result)
        let usage_result: Result[YazaDbQueryCteBudgetV1, Text] = yaza_db_query_validate_cte_result_budget_v1(query_result, total_rows, total_cells, total_text_bytes, total_work_units)
        if not result_is_ok(usage_result):
            let context: Text = "CTE definition materialization"
            return err(yaza_db_query_cte_source_error_v1(source, definition.query, definition.query_start_byte, definition.name_token.start_byte, definition.query, context, result_unwrap_error(usage_result)))
        let usage: YazaDbQueryCteBudgetV1 = result_unwrap(usage_result)
        set total_rows = total_rows + usage.rows
        set total_cells = total_cells + usage.cells
        set total_text_bytes = total_text_bytes + usage.text_bytes
        set total_work_units = total_work_units + usage.work_units
        let relation_result: Result[YazaDbQueryVirtualRelationV1, Text] = yaza_db_query_virtual_relation_from_result_v1(source, definition, query_result, 1000000 + index, catalog.version)
        if not result_is_ok(relation_result):
            let context: Text = "CTE definition output schema"
            return err(yaza_db_query_cte_source_error_v1(source, definition.query, definition.query_start_byte, definition.name_token.start_byte, definition.query, context, result_unwrap_error(relation_result)))
        let relation: YazaDbQueryVirtualRelationV1 = result_unwrap(relation_result)
        if not list_try_push(relations, relation):
            let context: Text = "CTE definition materialization"
            return err(yaza_db_query_cte_source_error_v1(source, definition.query, definition.query_start_byte, definition.name_token.start_byte, definition.query, context, "SQL CTE could not append a materialized relation"))
        set index = index + 1
    let final_branch: YazaSqlSetPreparedBranchV1 = list_get(prepared, list_count(prepared) - 1)
    let final_result_result: Result[YazaSqlQueryResultV1, Text] = yaza_db_execute_select_with_virtual_relations_and_prior_v1(file, file_header, final_branch.source, final_branch.parameters, relations, total_work_units)
    if not result_is_ok(final_result_result):
        return err(yaza_db_query_cte_source_error_v1(source, parsed.main_query, parsed.main_start_byte, parsed.main_start_byte, final_branch.source, "final CTE query", result_unwrap_error(final_result_result)))
    let final_result: YazaSqlQueryResultV1 = result_unwrap(final_result_result)
    let final_usage_result: Result[YazaDbQueryCteBudgetV1, Text] = yaza_db_query_validate_cte_result_budget_v1(final_result, total_rows, total_cells, total_text_bytes, total_work_units)
    if not result_is_ok(final_usage_result):
        return err(yaza_db_query_cte_source_error_v1(source, parsed.main_query, parsed.main_start_byte, parsed.main_start_byte, parsed.main_query, "final CTE result", result_unwrap_error(final_usage_result)))
    return ok(final_result)

fn yaza_db_execute_cte_select_at_snapshot_v1(storage: YazaDbStorageHandleV1, wal: YazaDbWalLogV1, source: Text, parameters: List[YazaSqlValueV1], snapshot_ts: Number, own_txn_id: Number, transactions: List[YazaDbTxnStatusV1]) -> Result[YazaSqlQueryResultV1, Text]:
    let parsed: YazaSqlCteQueryV1 = yaza_sql_cte_parse_v1(source)?
    if parsed.recursive: return err("SQL WITH RECURSIVE is not supported in this YazaBase profile")
    let prepared: List[YazaSqlSetPreparedBranchV1] = yaza_db_query_prepare_cte_branches_v1(parsed, parameters)?
    if list_count(prepared) != list_count(parsed.definitions) + 1: return err("SQL CTE statement-wide bind preparation returned inconsistent branch metadata")
    let catalog: YazaSqlCatalogSnapshotV1 = yaza_db_catalog_snapshot_load_v1(storage.file, storage.header)?
    let relations_created: Result[List[YazaDbQueryVirtualRelationV1], Text] = list_try_new()
    if not result_is_ok(relations_created): return err("SQL CTE could not allocate its historical scoped relation set")
    let relations: List[YazaDbQueryVirtualRelationV1] = result_unwrap(relations_created)
    if not list_try_reserve(relations, list_count(parsed.definitions)): return err("SQL CTE could not reserve its historical scoped relation set")
    var total_rows: Number = 0
    var total_cells: Number = 0
    var total_text_bytes: Number = 0
    var total_work_units: Number = 0
    var index: Number = 0
    while index < list_count(parsed.definitions):
        let definition: YazaSqlCteDefinitionV1 = list_get(parsed.definitions, index)
        let prepared_branch: YazaSqlSetPreparedBranchV1 = list_get(prepared, index)
        let query_result_result: Result[YazaSqlQueryResultV1, Text] = yaza_db_execute_select_at_snapshot_with_virtual_relations_and_prior_v1(storage, wal, prepared_branch.source, prepared_branch.parameters, snapshot_ts, own_txn_id, transactions, relations, total_work_units)
        if not result_is_ok(query_result_result):
            let context: Text = "CTE definition query"
            return err(yaza_db_query_cte_source_error_v1(source, definition.query, definition.query_start_byte, definition.name_token.start_byte, prepared_branch.source, context, result_unwrap_error(query_result_result)))
        let query_result: YazaSqlQueryResultV1 = result_unwrap(query_result_result)
        let usage_result: Result[YazaDbQueryCteBudgetV1, Text] = yaza_db_query_validate_cte_result_budget_v1(query_result, total_rows, total_cells, total_text_bytes, total_work_units)
        if not result_is_ok(usage_result):
            let context: Text = "CTE definition materialization"
            return err(yaza_db_query_cte_source_error_v1(source, definition.query, definition.query_start_byte, definition.name_token.start_byte, definition.query, context, result_unwrap_error(usage_result)))
        let usage: YazaDbQueryCteBudgetV1 = result_unwrap(usage_result)
        set total_rows = total_rows + usage.rows
        set total_cells = total_cells + usage.cells
        set total_text_bytes = total_text_bytes + usage.text_bytes
        set total_work_units = total_work_units + usage.work_units
        let relation_result: Result[YazaDbQueryVirtualRelationV1, Text] = yaza_db_query_virtual_relation_from_result_v1(source, definition, query_result, 1000000 + index, catalog.version)
        if not result_is_ok(relation_result):
            let context: Text = "CTE definition output schema"
            return err(yaza_db_query_cte_source_error_v1(source, definition.query, definition.query_start_byte, definition.name_token.start_byte, definition.query, context, result_unwrap_error(relation_result)))
        let relation: YazaDbQueryVirtualRelationV1 = result_unwrap(relation_result)
        if not list_try_push(relations, relation):
            let context: Text = "CTE definition materialization"
            return err(yaza_db_query_cte_source_error_v1(source, definition.query, definition.query_start_byte, definition.name_token.start_byte, definition.query, context, "SQL CTE could not append a historical materialized relation"))
        set index = index + 1
    let final_branch: YazaSqlSetPreparedBranchV1 = list_get(prepared, list_count(prepared) - 1)
    let final_result_result: Result[YazaSqlQueryResultV1, Text] = yaza_db_execute_select_at_snapshot_with_virtual_relations_and_prior_v1(storage, wal, final_branch.source, final_branch.parameters, snapshot_ts, own_txn_id, transactions, relations, total_work_units)
    if not result_is_ok(final_result_result):
        return err(yaza_db_query_cte_source_error_v1(source, parsed.main_query, parsed.main_start_byte, parsed.main_start_byte, final_branch.source, "final CTE query", result_unwrap_error(final_result_result)))
    let final_result: YazaSqlQueryResultV1 = result_unwrap(final_result_result)
    let final_usage_result: Result[YazaDbQueryCteBudgetV1, Text] = yaza_db_query_validate_cte_result_budget_v1(final_result, total_rows, total_cells, total_text_bytes, total_work_units)
    if not result_is_ok(final_usage_result):
        return err(yaza_db_query_cte_source_error_v1(source, parsed.main_query, parsed.main_start_byte, parsed.main_start_byte, parsed.main_query, "final CTE result", result_unwrap_error(final_usage_result)))
    return ok(final_result)

fn yaza_db_execute_select_with_tokens_profiled_v1(file: Number, file_header: YazaDbFileHeaderV1, source: Text, parameters: List[YazaSqlValueV1], tokens: List[YazaSqlTokenV1], profile_ns: List[Number]) -> Result[YazaSqlQueryResultV1, Text]:
    if yaza_sql_v2_is_keyword(source, tokens, 0, "WITH"):
        return yaza_db_execute_cte_select_v1(file, file_header, source, parameters)
    if list_count(profile_ns) < 4:
        let result: Result[YazaSqlQueryResultV1, Text] = yaza_db_execute_select_with_tokens_v1(file, file_header, source, parameters, tokens)
        if not result_is_ok(result): return err(yaza_db_query_public_sql_error_v1(source, result_unwrap_error(result)))
        return result
    var profile_index: Number = 0
    while profile_index < list_count(profile_ns):
        let ignored_reset: Boolean = list_try_set(profile_ns, profile_index, 0)
        set profile_index = profile_index + 1
    let single: Result[YazaSqlQueryResultV1, Text] = yaza_db_execute_single_select_with_tokens_and_virtual_relations_and_prior_profiled_v1(file, file_header, source, tokens, parameters, List[YazaDbQueryVirtualRelationV1](), 0, profile_ns)
    if result_is_ok(single): return single
    let result: Result[YazaSqlQueryResultV1, Text] = yaza_db_execute_select_with_tokens_v1(file, file_header, source, parameters, tokens)
    if not result_is_ok(result): return err(yaza_db_query_public_sql_error_v1(source, result_unwrap_error(result)))
    return result

fn yaza_db_execute_select_with_tokens_v1(file: Number, file_header: YazaDbFileHeaderV1, source: Text, parameters: List[YazaSqlValueV1], tokens: List[YazaSqlTokenV1]) -> Result[YazaSqlQueryResultV1, Text]:
    if yaza_sql_v2_is_keyword(source, tokens, 0, "WITH"):
        return yaza_db_execute_cte_select_v1(file, file_header, source, parameters)
    let result: Result[YazaSqlQueryResultV1, Text] = yaza_db_execute_select_with_tokens_and_virtual_relations_and_prior_v1(file, file_header, source, tokens, parameters, List[YazaDbQueryVirtualRelationV1](), 0)
    if not result_is_ok(result): return err(yaza_db_query_public_sql_error_v1(source, result_unwrap_error(result)))
    return result

fn yaza_db_execute_select_v1(file: Number, file_header: YazaDbFileHeaderV1, source: Text, parameters: List[YazaSqlValueV1]) -> Result[YazaSqlQueryResultV1, Text]:
    let tokens_result: Result[List[YazaSqlTokenV1], Text] = yaza_sql_lex_v1(source)
    if not result_is_ok(tokens_result): return err(result_unwrap_error(tokens_result))
    let tokens: List[YazaSqlTokenV1] = result_unwrap(tokens_result)
    return yaza_db_execute_select_with_tokens_v1(file, file_header, source, parameters, tokens)

fn yaza_db_execute_select_at_snapshot_v1(storage: YazaDbStorageHandleV1, wal: YazaDbWalLogV1, source: Text, parameters: List[YazaSqlValueV1], snapshot_ts: Number, own_txn_id: Number, transactions: List[YazaDbTxnStatusV1]) -> Result[YazaSqlQueryResultV1, Text]:
    let tokens_result: Result[List[YazaSqlTokenV1], Text] = yaza_sql_lex_v1(source)
    if not result_is_ok(tokens_result): return err(result_unwrap_error(tokens_result))
    let tokens: List[YazaSqlTokenV1] = result_unwrap(tokens_result)
    if yaza_sql_v2_is_keyword(source, tokens, 0, "WITH"):
        return yaza_db_execute_cte_select_at_snapshot_v1(storage, wal, source, parameters, snapshot_ts, own_txn_id, transactions)
    let result: Result[YazaSqlQueryResultV1, Text] = yaza_db_execute_select_at_snapshot_with_virtual_relations_and_prior_v1(storage, wal, source, parameters, snapshot_ts, own_txn_id, transactions, List[YazaDbQueryVirtualRelationV1](), 0)
    if not result_is_ok(result): return err(yaza_db_query_public_sql_error_v1(source, result_unwrap_error(result)))
    return result
