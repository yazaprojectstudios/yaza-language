fn yaza_db_execute_single_select_with_cached_catalog_and_index_rows_profiled_v1(file: Number, file_header: YazaDbFileHeaderV1, source: Text, tokens: List[YazaSqlTokenV1], parameters: List[YazaSqlValueV1], catalog: YazaDbCatalogSnapshotWithRootsV1, index_rows: List[YazaDbRowV1], profile_ns: List[Number]) -> Result[YazaSqlQueryResultV1, Text]:
