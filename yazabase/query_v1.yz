fn yaza_db_execute_single_select_with_cached_catalog_index_and_pool_pooled_profiled_v1(file: Number, file_header: YazaDbFileHeaderV1, source: Text, tokens: List[YazaSqlTokenV1], parameters: List[YazaSqlValueV1], catalog: YazaDbCatalogSnapshotWithRootsV1, index_rows: List[YazaDbRowV1], buffer_pool: Option[YazaDbBufferPoolV1], profile_ns: List[Number]) -> Result[YazaDbQueryPooledSelectResultV1, Text]:
    return yaza_db_execute_single_select_pooled_with_loaded_catalog_profiled_v1(file, file_header, source, tokens, parameters, List[YazaDbQueryVirtualRelationV1](), 0, catalog, some(index_rows), buffer_pool, profile_ns)

fn yaza_db_execute_single_select_with_cached_catalog_index_and_pool_profiled_v1(file: Number, file_header: YazaDbFileHeaderV1, source: Text, tokens: List[YazaSqlTokenV1], parameters: List[YazaSqlValueV1], catalog: YazaDbCatalogSnapshotWithRootsV1, index_rows: List[YazaDbRowV1], buffer_pool: Option[YazaDbBufferPoolV1], profile_ns: List[Number]) -> Result[YazaSqlQueryResultV1, Text]:
    return yaza_db_execute_single_select_with_loaded_catalog_index_and_pool_profiled_v1(file, file_header, source, tokens, parameters, List[YazaDbQueryVirtualRelationV1](), 0, catalog, some(index_rows), buffer_pool, profile_ns)

fn yaza_db_execute_single_select_with_cached_catalog_v1(file: Number, file_header: YazaDbFileHeaderV1, source: Text, tokens: List[YazaSqlTokenV1], parameters: List[YazaSqlValueV1], catalog: YazaDbCatalogSnapshotWithRootsV1) -> Result[YazaSqlQueryResultV1, Text]:
