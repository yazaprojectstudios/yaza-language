fn yaza_db_execute_single_select_with_virtual_relations_v1(file: Number, file_header: YazaDbFileHeaderV1, source: Text, parameters: List[YazaSqlValueV1], virtual_relations: List[YazaDbQueryVirtualRelationV1]) -> Result[YazaSqlQueryResultV1, Text]:
