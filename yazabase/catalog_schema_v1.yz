# Provisional, seeded system-catalog schemas for the YDBv1 bootstrap.
use "./key_codec_v1"
use "./page_v1"
use "./row_v1"
use "./sql_binder_v1"
use "./sql_executor_v1"

shape YazaDbCatalogColumnSeedV1:
    table_id: Number
    ordinal: Number
    name: Text
    type_id: Number
    nullable: Boolean
    key_ordinal: Number

# sys_columns.flags stores declared DECIMAL metadata without changing the
# eight-column YDBv1 system-table layout. Bits 0..7 are currently reserved and
# must be zero; precision occupies bits 8..13, scale bits 14..19, and bits
# 20..31 are reserved. All non-DECIMAL types currently require flags == 0.
fn yaza_db_catalog_column_type_flags_encode_v1(type_id: Number, precision: Number, scale: Number) -> Result[Number, Text]:
    if type_id != 10:
        if precision != 0 or scale != 0: return err("YDBv1 non-DECIMAL column has precision metadata")
        return ok(0)
    if precision < 1 or precision > 38 or scale < 0 or scale > precision: return err("YDBv1 DECIMAL precision or scale is outside its bound")
    return ok(precision * 256 + scale * 16384)

fn yaza_db_catalog_column_type_flags_valid_v1(type_id: Number, flags: Number) -> Boolean:
    if flags < 0 or flags >= 1048576 or flags % 256 != 0: return false
    if type_id != 10: return flags == 0
    let precision: Number = (flags / 256) % 64
    let scale: Number = (flags / 16384) % 64
    return precision >= 1 and precision <= 38 and scale <= precision and flags == precision * 256 + scale * 16384

fn yaza_db_catalog_column_type_precision_v1(type_id: Number, flags: Number) -> Number:
    if type_id != 10: return 0
    return (flags / 256) % 64

fn yaza_db_catalog_column_type_scale_v1(type_id: Number, flags: Number) -> Number:
    if type_id != 10: return 0
    return (flags / 16384) % 64

fn yaza_db_catalog_table_count_v1() -> Number:
    return 5

fn yaza_db_catalog_system_table_id_min_v1() -> Number:
    return 1

fn yaza_db_catalog_system_table_id_max_v1() -> Number:
    return 4

fn yaza_db_catalog_max_table_records_v1() -> Number:
    # Includes the four SQL-visible seeded system tables; sys_views is a private catalog root.
    return 1024

fn yaza_db_catalog_max_object_id_v1() -> Number:
    # 12 seeded objects plus table/index/constraint IDs for the bounded user-table range.
    return 3072

fn yaza_db_catalog_max_column_rows_v1() -> Number:
    # Keep catalog scans aligned with the bounded B+Tree row-scan profile.
    return 65536

fn yaza_db_catalog_index_kind_primary_v1() -> Number:
    return 1

fn yaza_db_catalog_index_kind_secondary_active_v1() -> Number:
    return 2

fn yaza_db_catalog_index_kind_secondary_building_v1() -> Number:
    return 3

fn yaza_db_catalog_table_schema_v1(table_id: Number) -> Result[List[YazaSqlColumnSchemaV1], Text]:
    if table_id < 1 or table_id > 5: return err("YDBv1 system catalog table ID is outside the seeded range")
    let columns: List[YazaSqlColumnSchemaV1] = List[YazaSqlColumnSchemaV1]()
    if table_id == 1:
        list_push(columns, YazaSqlColumnSchemaV1("table_id", 4, false, 0, 0, 0, ""))
        list_push(columns, YazaSqlColumnSchemaV1("schema_name", 9, false, 1, 0, 0, ""))
        list_push(columns, YazaSqlColumnSchemaV1("table_name", 9, false, 2, 0, 0, ""))
        list_push(columns, YazaSqlColumnSchemaV1("root_page_id", 4, false, 3, 0, 0, ""))
        list_push(columns, YazaSqlColumnSchemaV1("table_kind", 2, false, 4, 0, 0, ""))
        list_push(columns, YazaSqlColumnSchemaV1("flags", 3, false, 5, 0, 0, ""))
        list_push(columns, YazaSqlColumnSchemaV1("schema_version", 4, false, 6, 0, 0, ""))
    elif table_id == 2:
        list_push(columns, YazaSqlColumnSchemaV1("table_id", 4, false, 0, 0, 0, ""))
        list_push(columns, YazaSqlColumnSchemaV1("ordinal", 3, false, 1, 0, 0, ""))
        list_push(columns, YazaSqlColumnSchemaV1("column_name", 9, false, 2, 0, 0, ""))
        list_push(columns, YazaSqlColumnSchemaV1("type_id", 2, false, 3, 0, 0, ""))
        list_push(columns, YazaSqlColumnSchemaV1("nullable", 1, false, 4, 0, 0, ""))
        list_push(columns, YazaSqlColumnSchemaV1("key_ordinal", 2, true, 5, 0, 0, ""))
        list_push(columns, YazaSqlColumnSchemaV1("flags", 3, false, 6, 0, 0, ""))
        list_push(columns, YazaSqlColumnSchemaV1("default_text", 9, true, 7, 0, 0, ""))
    elif table_id == 3:
        list_push(columns, YazaSqlColumnSchemaV1("index_id", 4, false, 0, 0, 0, ""))
        list_push(columns, YazaSqlColumnSchemaV1("table_id", 4, false, 1, 0, 0, ""))
        list_push(columns, YazaSqlColumnSchemaV1("index_name", 9, false, 2, 0, 0, ""))
        list_push(columns, YazaSqlColumnSchemaV1("root_page_id", 4, false, 3, 0, 0, ""))
        list_push(columns, YazaSqlColumnSchemaV1("index_kind", 2, false, 4, 0, 0, ""))
        list_push(columns, YazaSqlColumnSchemaV1("is_unique", 1, false, 5, 0, 0, ""))
        list_push(columns, YazaSqlColumnSchemaV1("key_columns", 9, false, 6, 0, 0, ""))
    elif table_id == 4:
        list_push(columns, YazaSqlColumnSchemaV1("constraint_id", 4, false, 0, 0, 0, ""))
        list_push(columns, YazaSqlColumnSchemaV1("table_id", 4, false, 1, 0, 0, ""))
        list_push(columns, YazaSqlColumnSchemaV1("constraint_name", 9, false, 2, 0, 0, ""))
        list_push(columns, YazaSqlColumnSchemaV1("constraint_kind", 2, false, 3, 0, 0, ""))
        list_push(columns, YazaSqlColumnSchemaV1("key_columns", 9, false, 4, 0, 0, ""))
        list_push(columns, YazaSqlColumnSchemaV1("expression_text", 9, true, 5, 0, 0, ""))
    else:
        list_push(columns, YazaSqlColumnSchemaV1("view_id", 4, false, 0, 0, 0, ""))
        list_push(columns, YazaSqlColumnSchemaV1("definition", 9, false, 1, 0, 0, ""))
        list_push(columns, YazaSqlColumnSchemaV1("dependency_table_id", 4, false, 2, 0, 0, ""))
    return ok(columns)

fn yaza_db_catalog_column_seed_push_v1(seeds: List[YazaDbCatalogColumnSeedV1], table_id: Number, ordinal: Number, name: Text, type_id: Number, nullable: Boolean, key_ordinal: Number) -> Boolean:
    return list_try_push(seeds, YazaDbCatalogColumnSeedV1(table_id, ordinal, name, type_id, nullable, key_ordinal))

fn yaza_db_catalog_column_seeds_v1() -> Result[List[YazaDbCatalogColumnSeedV1], Text]:
    let created: Result[List[YazaDbCatalogColumnSeedV1], Text] = list_try_new()
    if not result_is_ok(created): return err(result_unwrap_error(created))
    let seeds: List[YazaDbCatalogColumnSeedV1] = result_unwrap(created)
    if not yaza_db_catalog_column_seed_push_v1(seeds, 1, 0, "table_id", 4, false, 0) or not yaza_db_catalog_column_seed_push_v1(seeds, 1, 1, "schema_name", 9, false, -1) or not yaza_db_catalog_column_seed_push_v1(seeds, 1, 2, "table_name", 9, false, -1) or not yaza_db_catalog_column_seed_push_v1(seeds, 1, 3, "root_page_id", 4, false, -1) or not yaza_db_catalog_column_seed_push_v1(seeds, 1, 4, "table_kind", 2, false, -1) or not yaza_db_catalog_column_seed_push_v1(seeds, 1, 5, "flags", 3, false, -1) or not yaza_db_catalog_column_seed_push_v1(seeds, 1, 6, "schema_version", 4, false, -1): return err("YDBv1 system-column seed for sys_tables could not be built")
    if not yaza_db_catalog_column_seed_push_v1(seeds, 2, 0, "table_id", 4, false, 0) or not yaza_db_catalog_column_seed_push_v1(seeds, 2, 1, "ordinal", 3, false, 1) or not yaza_db_catalog_column_seed_push_v1(seeds, 2, 2, "column_name", 9, false, -1) or not yaza_db_catalog_column_seed_push_v1(seeds, 2, 3, "type_id", 2, false, -1) or not yaza_db_catalog_column_seed_push_v1(seeds, 2, 4, "nullable", 1, false, -1) or not yaza_db_catalog_column_seed_push_v1(seeds, 2, 5, "key_ordinal", 2, true, -1) or not yaza_db_catalog_column_seed_push_v1(seeds, 2, 6, "flags", 3, false, -1) or not yaza_db_catalog_column_seed_push_v1(seeds, 2, 7, "default_text", 9, true, -1): return err("YDBv1 system-column seed for sys_columns could not be built")
    if not yaza_db_catalog_column_seed_push_v1(seeds, 3, 0, "index_id", 4, false, 0) or not yaza_db_catalog_column_seed_push_v1(seeds, 3, 1, "table_id", 4, false, -1) or not yaza_db_catalog_column_seed_push_v1(seeds, 3, 2, "index_name", 9, false, -1) or not yaza_db_catalog_column_seed_push_v1(seeds, 3, 3, "root_page_id", 4, false, -1) or not yaza_db_catalog_column_seed_push_v1(seeds, 3, 4, "index_kind", 2, false, -1) or not yaza_db_catalog_column_seed_push_v1(seeds, 3, 5, "is_unique", 1, false, -1) or not yaza_db_catalog_column_seed_push_v1(seeds, 3, 6, "key_columns", 9, false, -1): return err("YDBv1 system-column seed for sys_indexes could not be built")
    if not yaza_db_catalog_column_seed_push_v1(seeds, 4, 0, "constraint_id", 4, false, 0) or not yaza_db_catalog_column_seed_push_v1(seeds, 4, 1, "table_id", 4, false, -1) or not yaza_db_catalog_column_seed_push_v1(seeds, 4, 2, "constraint_name", 9, false, -1) or not yaza_db_catalog_column_seed_push_v1(seeds, 4, 3, "constraint_kind", 2, false, -1) or not yaza_db_catalog_column_seed_push_v1(seeds, 4, 4, "key_columns", 9, false, -1) or not yaza_db_catalog_column_seed_push_v1(seeds, 4, 5, "expression_text", 9, true, -1): return err("YDBv1 system-column seed for sys_constraints could not be built")
    return ok(seeds)

fn yaza_db_catalog_value_push_integer_v1(values: List[YazaSqlValueV1], type_id: Number, value: Number) -> Boolean:
    let made: Result[YazaSqlValueV1, Text] = yaza_sql_value_integer_v1(type_id, value)
    if not result_is_ok(made): return false
    return list_try_push(values, result_unwrap(made))

fn yaza_db_catalog_value_push_text_v1(values: List[YazaSqlValueV1], value: Text) -> Boolean:
    return list_try_push(values, yaza_sql_value_text_v1(value))

fn yaza_db_catalog_value_push_boolean_v1(values: List[YazaSqlValueV1], value: Boolean) -> Boolean:
    return list_try_push(values, yaza_sql_value_boolean_v1(value))

fn yaza_db_catalog_values_new_v1() -> Result[List[YazaSqlValueV1], Text]:
    return list_try_new()

fn yaza_db_catalog_insert_row_v1(page: Bytes, columns: List[YazaSqlColumnSchemaV1], values: List[YazaSqlValueV1], nulls: List[Boolean], key_ordinals: List[Number]) -> Result[Bytes, Text]:
    let row: Bytes = yaza_db_row_encode_v1(values, nulls, columns, 1)?
    let key: Bytes = yaza_db_key_encode_composite_v1(values, nulls, columns, key_ordinals)?
    return yaza_db_page_insert_slot_v1(page, key, row)

fn yaza_db_catalog_sys_table_values_v1(table_id: Number) -> Result[List[YazaSqlValueV1], Text]:
    let values: List[YazaSqlValueV1] = yaza_db_catalog_values_new_v1()?
    if not yaza_db_catalog_value_push_integer_v1(values, 4, table_id) or not yaza_db_catalog_value_push_text_v1(values, "sys") or not yaza_db_catalog_value_push_text_v1(values, "sys_tables") or not yaza_db_catalog_value_push_integer_v1(values, 4, 3) or not yaza_db_catalog_value_push_integer_v1(values, 2, 1) or not yaza_db_catalog_value_push_integer_v1(values, 3, 1) or not yaza_db_catalog_value_push_integer_v1(values, 4, 1): return err("YDBv1 sys_tables seed row could not be encoded")
    if table_id == 2:
        if not list_try_set(values, 2, yaza_sql_value_text_v1("sys_columns")) or not list_try_set(values, 3, yaza_sql_executor_value_v1(4, 4, 0.0, false, "")): return err("YDBv1 sys_columns seed row could not be specialized")
    elif table_id == 3:
        if not list_try_set(values, 2, yaza_sql_value_text_v1("sys_indexes")) or not list_try_set(values, 3, yaza_sql_executor_value_v1(4, 5, 0.0, false, "")): return err("YDBv1 sys_indexes seed row could not be specialized")
    elif table_id == 4:
        if not list_try_set(values, 2, yaza_sql_value_text_v1("sys_constraints")) or not list_try_set(values, 3, yaza_sql_executor_value_v1(4, 6, 0.0, false, "")): return err("YDBv1 sys_constraints seed row could not be specialized")
    return ok(values)

fn yaza_db_catalog_sys_column_values_v1(column: YazaDbCatalogColumnSeedV1) -> Result[List[YazaSqlValueV1], Text]:
    let values: List[YazaSqlValueV1] = yaza_db_catalog_values_new_v1()?
    var key_ordinal_value: Number = column.key_ordinal
    if key_ordinal_value < 0: set key_ordinal_value = 0
    if not yaza_db_catalog_value_push_integer_v1(values, 4, column.table_id) or not yaza_db_catalog_value_push_integer_v1(values, 3, column.ordinal) or not yaza_db_catalog_value_push_text_v1(values, column.name) or not yaza_db_catalog_value_push_integer_v1(values, 2, column.type_id) or not yaza_db_catalog_value_push_boolean_v1(values, column.nullable) or not yaza_db_catalog_value_push_integer_v1(values, 2, key_ordinal_value) or not yaza_db_catalog_value_push_integer_v1(values, 3, 0) or not yaza_db_catalog_value_push_text_v1(values, ""): return err("YDBv1 sys_columns seed row could not be encoded")
    return ok(values)

fn yaza_db_catalog_sys_index_values_v1(index_id: Number) -> Result[List[YazaSqlValueV1], Text]:
    let values: List[YazaSqlValueV1] = yaza_db_catalog_values_new_v1()?
    let table_id: Number = index_id - 4
    var index_name: Text = "sys_tables_pk"
    var key_columns: Text = "0"
    if table_id == 2:
        set index_name = "sys_columns_pk"
        set key_columns = "0,1"
    elif table_id == 3: set index_name = "sys_indexes_pk"
    elif table_id == 4: set index_name = "sys_constraints_pk"
    if not yaza_db_catalog_value_push_integer_v1(values, 4, index_id) or not yaza_db_catalog_value_push_integer_v1(values, 4, table_id) or not yaza_db_catalog_value_push_text_v1(values, index_name) or not yaza_db_catalog_value_push_integer_v1(values, 4, table_id + 2) or not yaza_db_catalog_value_push_integer_v1(values, 2, yaza_db_catalog_index_kind_primary_v1()) or not yaza_db_catalog_value_push_boolean_v1(values, true) or not yaza_db_catalog_value_push_text_v1(values, key_columns): return err("YDBv1 sys_indexes seed row could not be encoded")
    return ok(values)

fn yaza_db_catalog_sys_constraint_values_v1(constraint_id: Number) -> Result[List[YazaSqlValueV1], Text]:
    let values: List[YazaSqlValueV1] = yaza_db_catalog_values_new_v1()?
    let table_id: Number = constraint_id - 8
    var constraint_name: Text = "sys_tables_pkey"
    var key_columns: Text = "0"
    if table_id == 2:
        set constraint_name = "sys_columns_pkey"
        set key_columns = "0,1"
    elif table_id == 3: set constraint_name = "sys_indexes_pkey"
    elif table_id == 4: set constraint_name = "sys_constraints_pkey"
    if not yaza_db_catalog_value_push_integer_v1(values, 4, constraint_id) or not yaza_db_catalog_value_push_integer_v1(values, 4, table_id) or not yaza_db_catalog_value_push_text_v1(values, constraint_name) or not yaza_db_catalog_value_push_integer_v1(values, 2, 1) or not yaza_db_catalog_value_push_text_v1(values, key_columns) or not yaza_db_catalog_value_push_text_v1(values, ""): return err("YDBv1 sys_constraints seed row could not be encoded")
    return ok(values)

fn yaza_db_catalog_seed_page_v1(page_id: Number) -> Result[Bytes, Text]:
    if page_id < 3 or page_id > 6: return err("YDBv1 system-catalog seed page ID is outside the fixed root range")
    let table_id: Number = page_id - 2
    let schema: List[YazaSqlColumnSchemaV1] = yaza_db_catalog_table_schema_v1(table_id)?
    var key_ordinals: List[Number] = [0]
    if table_id == 2: set key_ordinals = [0, 1]
    var page: Bytes = yaza_db_page_new_v1(page_id, 0, 1, 0)?
    if table_id == 1:
        var seed_table_id: Number = 1
        while seed_table_id <= 4:
            let values: List[YazaSqlValueV1] = yaza_db_catalog_sys_table_values_v1(seed_table_id)?
            let nulls: List[Boolean] = [false, false, false, false, false, false, false]
            set page = yaza_db_catalog_insert_row_v1(page, schema, values, nulls, key_ordinals)?
            set seed_table_id = seed_table_id + 1
    elif table_id == 2:
        let seeds: List[YazaDbCatalogColumnSeedV1] = yaza_db_catalog_column_seeds_v1()?
        var seed_index: Number = 0
        while seed_index < list_count(seeds):
            let seed: YazaDbCatalogColumnSeedV1 = list_get(seeds, seed_index)
            let values: List[YazaSqlValueV1] = yaza_db_catalog_sys_column_values_v1(seed)?
            let nulls: List[Boolean] = [false, false, false, false, false, seed.key_ordinal < 0, false, true]
            set page = yaza_db_catalog_insert_row_v1(page, schema, values, nulls, key_ordinals)?
            set seed_index = seed_index + 1
    elif table_id == 3:
        var seed_index: Number = 5
        while seed_index <= 8:
            let values: List[YazaSqlValueV1] = yaza_db_catalog_sys_index_values_v1(seed_index)?
            let nulls: List[Boolean] = [false, false, false, false, false, false, false]
            set page = yaza_db_catalog_insert_row_v1(page, schema, values, nulls, key_ordinals)?
            set seed_index = seed_index + 1
    else:
        var seed_index: Number = 9
        while seed_index <= 12:
            let values: List[YazaSqlValueV1] = yaza_db_catalog_sys_constraint_values_v1(seed_index)?
            let nulls: List[Boolean] = [false, false, false, false, false, true]
            set page = yaza_db_catalog_insert_row_v1(page, schema, values, nulls, key_ordinals)?
            set seed_index = seed_index + 1
    return yaza_db_page_finalize_v1(page)
