# Bounded DROP INDEX parser for one unqualified index identifier.
use "./sql_create_table_v1"
use "./sql_lexer_v1"
use "./sql_parser_v2"

fn yaza_sql_parse_drop_index_v1(source: Text) -> Result[Text, Text]:
    let lexed: Result[List[YazaSqlTokenV1], Text] = yaza_sql_lex_v1(source)
    if not result_is_ok(lexed): return err(result_unwrap_error(lexed))
    let tokens: List[YazaSqlTokenV1] = result_unwrap(lexed)
    if list_count(tokens) < 2: return err("SQL DROP INDEX parser received an invalid token stream")
    if not yaza_sql_v2_is_keyword(source, tokens, 0, "DROP"): return err(yaza_sql_v2_parse_error(source, tokens, 0, "SQL parser expected DROP at byte "))
    if not yaza_sql_v2_is_keyword(source, tokens, 1, "INDEX"): return err(yaza_sql_v2_parse_error(source, tokens, 1, "SQL parser expected INDEX after DROP at byte "))
    var name_cursor: Number = 2
    if yaza_sql_v2_is_keyword(source, tokens, name_cursor, "IF"):
        if not yaza_sql_v2_is_keyword(source, tokens, name_cursor + 1, "EXISTS"):
            return err(yaza_sql_v2_parse_error(source, tokens, name_cursor + 1, "SQL DROP INDEX expected EXISTS after IF at byte "))
        set name_cursor = name_cursor + 2
    let name_result: Result[YazaSqlNameV2, Text] = yaza_sql_v2_parse_name(source, tokens, name_cursor, false)
    if not result_is_ok(name_result): return err(yaza_sql_v2_parse_error(source, tokens, name_cursor, "SQL DROP INDEX expected an index name at byte "))
    let name: YazaSqlNameV2 = result_unwrap(name_result)
    if name.part_count != 1: return err(yaza_sql_v2_parse_error(source, tokens, name_cursor, "SQL DROP INDEX supports one-part names only at byte "))
    var cursor: Number = name_cursor + name.consumed_tokens
    if yaza_sql_v2_is_symbol(source, tokens, cursor, 59): set cursor = cursor + 1
    if cursor >= list_count(tokens) or list_get(tokens, cursor).kind != 0:
        return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL parser supports one statement; unexpected token at byte "))
    return yaza_sql_create_table_identifier_v1(source, name.first_token)
