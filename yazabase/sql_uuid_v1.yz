# Strict canonical UUID text and 16-byte network-order codec for YazaBase.
# The codec accepts every 128-bit UUID value, including the nil UUID; it does
# not impose a version/variant policy on stored identifiers.

fn yaza_sql_uuid_hex_nibble_v1(byte: Number) -> Number:
    if byte >= 48 and byte <= 57: return byte - 48
    if byte >= 65 and byte <= 70: return byte - 55
    if byte >= 97 and byte <= 102: return byte - 87
    return -1

fn yaza_sql_uuid_parse_v1(source: Text) -> Result[Bytes, Text]:
    if text_length(source) != 36: return err("YazaBase UUID requires canonical 8-4-4-4-12 text")
    if text_byte(source, 8) != 45 or text_byte(source, 13) != 45 or text_byte(source, 18) != 45 or text_byte(source, 23) != 45:
        return err("YazaBase UUID requires canonical 8-4-4-4-12 text")
    let output: Bytes = bytes_try_new_zeroed(16)?
    var source_index: Number = 0
    var output_index: Number = 0
    while source_index < 36:
        if source_index == 8 or source_index == 13 or source_index == 18 or source_index == 23:
            set source_index = source_index + 1
        else:
            let high: Number = yaza_sql_uuid_hex_nibble_v1(text_byte(source, source_index))
            let low: Number = yaza_sql_uuid_hex_nibble_v1(text_byte(source, source_index + 1))
            if high < 0 or low < 0: return err("YazaBase UUID contains a non-hexadecimal digit")
            if not bytes_try_set(output, output_index, high * 16 + low): return err("YazaBase UUID byte could not be written")
            set source_index = source_index + 2
            set output_index = output_index + 1
    if output_index != 16: return err("YazaBase UUID parser produced an invalid byte count")
    return ok(output)

fn yaza_sql_uuid_hex_digit_v1(nibble: Number) -> Text:
    if nibble == 0: return "0"
    if nibble == 1: return "1"
    if nibble == 2: return "2"
    if nibble == 3: return "3"
    if nibble == 4: return "4"
    if nibble == 5: return "5"
    if nibble == 6: return "6"
    if nibble == 7: return "7"
    if nibble == 8: return "8"
    if nibble == 9: return "9"
    if nibble == 10: return "a"
    if nibble == 11: return "b"
    if nibble == 12: return "c"
    if nibble == 13: return "d"
    if nibble == 14: return "e"
    if nibble == 15: return "f"
    return "?"

fn yaza_sql_uuid_to_text_v1(source: Bytes) -> Result[Text, Text]:
    if bytes_length(source) != 16: return err("YazaBase UUID encoding must contain exactly 16 bytes")
    var output: Text = ""
    var byte_index: Number = 0
    while byte_index < 16:
        if byte_index == 4 or byte_index == 6 or byte_index == 8 or byte_index == 10:
            set output = output + "-"
        let byte: Number = bytes_get(source, byte_index)
        set output = output + yaza_sql_uuid_hex_digit_v1(byte / 16) + yaza_sql_uuid_hex_digit_v1(byte % 16)
        set byte_index = byte_index + 1
    if text_length(output) != 36: return err("YazaBase UUID formatter produced an invalid canonical width")
    return ok(output)

fn yaza_sql_uuid_canonical_v1(source: Text) -> Result[Text, Text]:
    let parsed: Bytes = yaza_sql_uuid_parse_v1(source)?
    return yaza_sql_uuid_to_text_v1(parsed)
