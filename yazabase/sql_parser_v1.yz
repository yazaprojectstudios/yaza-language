# Phase 0 parser subset: one SELECT with projected names, one comparison,
# optional ORDER BY, and a bounded literal LIMIT.
use "sql_lexer_v1"

shape YazaSqlProjectionV1:
    token: YazaSqlTokenV1
    is_star: Boolean

shape YazaSqlOrderTermV1:
    token: YazaSqlTokenV1
    descending: Boolean

shape YazaSqlSelectAstV1:
    version: Number
    start_byte: Number
    end_byte: Number
    distinct: Boolean
    projections: List[YazaSqlProjectionV1]
    table: YazaSqlTokenV1
    has_where: Boolean
    where_column: YazaSqlTokenV1
    where_operator: Number
    where_value: YazaSqlTokenV1
    order_by: List[YazaSqlOrderTermV1]
    has_limit: Boolean
    limit: Number

fn yaza_sql_v1_is_keyword(source: Text, tokens: List[YazaSqlTokenV1], index: Number, keyword: Text) -> Boolean:
    if index < 0 or index >= list_count(tokens): return false
    let token: YazaSqlTokenV1 = list_get(tokens, index)
    if token.kind != 1 or token.end_byte - token.start_byte != text_length(keyword): return false
    var offset: Number = 0
    while offset < text_length(keyword):
        var actual: Number = text_byte(source, token.start_byte + offset)
        let expected: Number = text_byte(keyword, offset)
        if actual >= 97 and actual <= 122: set actual = actual - 32
        if actual != expected: return false
        set offset = offset + 1
    return true

fn yaza_sql_v1_is_symbol(source: Text, tokens: List[YazaSqlTokenV1], index: Number, symbol: Number) -> Boolean:
    if index < 0 or index >= list_count(tokens): return false
    let token: YazaSqlTokenV1 = list_get(tokens, index)
    return token.end_byte - token.start_byte == 1 and text_byte(source, token.start_byte) == symbol

fn yaza_sql_v1_comparison_code(source: Text, tokens: List[YazaSqlTokenV1], index: Number) -> Number:
    if index < 0 or index >= list_count(tokens): return 0
    let token: YazaSqlTokenV1 = list_get(tokens, index)
    if token.kind != 7: return 0
    let length: Number = token.end_byte - token.start_byte
    let first: Number = text_byte(source, token.start_byte)
    if length == 1:
        if first == 61: return 1
        if first == 60: return 3
        if first == 62: return 5
        return 0
    if length == 2:
        let second: Number = text_byte(source, token.start_byte + 1)
        if first == 33 and second == 61: return 2
        if first == 60 and second == 62: return 2
        if first == 60 and second == 61: return 4
        if first == 62 and second == 61: return 6
    return 0

fn yaza_sql_v1_parse_error(tokens: List[YazaSqlTokenV1], index: Number, prefix: Text) -> Text:
    if index < 0 or index >= list_count(tokens): return "SQL parser token cursor is invalid"
    let token: YazaSqlTokenV1 = list_get(tokens, index)
    return yaza_sql_v1_error_at(prefix, token.start_byte)

fn yaza_sql_parse_select_v1(source: Text) -> Result[YazaSqlSelectAstV1, Text]:
    let lexed: Result[List[YazaSqlTokenV1], Text] = yaza_sql_lex_v1(source)
    if not result_is_ok(lexed): return err(result_unwrap_error(lexed))
    let tokens: List[YazaSqlTokenV1] = result_unwrap(lexed)
    let token_count: Number = list_count(tokens)
    if token_count < 2: return err("SQL parser received an invalid token stream")

    var cursor: Number = 0
    if not yaza_sql_v1_is_keyword(source, tokens, cursor, "SELECT"):
        return err(yaza_sql_v1_parse_error(tokens, cursor, "SQL parser expected SELECT at byte "))
    let first_token: YazaSqlTokenV1 = list_get(tokens, cursor)
    set cursor = cursor + 1

    var distinct: Boolean = false
    if yaza_sql_v1_is_keyword(source, tokens, cursor, "DISTINCT"):
        set distinct = true
        set cursor = cursor + 1

    let projections_result: Result[List[YazaSqlProjectionV1], Text] = list_try_new()
    if not result_is_ok(projections_result): return err("SQL parser could not allocate the projection list")
    var projections: List[YazaSqlProjectionV1] = result_unwrap(projections_result)
    var projection_done: Boolean = false
    while not projection_done:
        if cursor >= token_count: return err("SQL parser expected a projection at end of input")
        let projection_token: YazaSqlTokenV1 = list_get(tokens, cursor)
        var is_star: Boolean = false
        if yaza_sql_v1_is_symbol(source, tokens, cursor, 42) and projection_token.kind == 7:
            set is_star = true
        elif projection_token.kind != 1 and projection_token.kind != 2:
            return err(yaza_sql_v1_parse_error(tokens, cursor, "SQL parser expected a column name or '*' at byte "))
        if not list_try_push(projections, YazaSqlProjectionV1(projection_token, is_star)):
            return err(yaza_sql_v1_parse_error(tokens, cursor, "SQL parser projection limit or allocation failure at byte "))
        set cursor = cursor + 1
        if yaza_sql_v1_is_symbol(source, tokens, cursor, 44):
            set cursor = cursor + 1
        else:
            set projection_done = true

    if not yaza_sql_v1_is_keyword(source, tokens, cursor, "FROM"):
        return err(yaza_sql_v1_parse_error(tokens, cursor, "SQL parser expected FROM at byte "))
    set cursor = cursor + 1
    if cursor >= token_count: return err("SQL parser expected a table name at end of input")
    let table_token: YazaSqlTokenV1 = list_get(tokens, cursor)
    if table_token.kind != 1 and table_token.kind != 2:
        return err(yaza_sql_v1_parse_error(tokens, cursor, "SQL parser expected a table name at byte "))
    set cursor = cursor + 1

    var has_where: Boolean = false
    var where_column: YazaSqlTokenV1 = YazaSqlTokenV1(0, 0, 0)
    var where_operator: Number = 0
    var where_value: YazaSqlTokenV1 = YazaSqlTokenV1(0, 0, 0)
    if yaza_sql_v1_is_keyword(source, tokens, cursor, "WHERE"):
        set has_where = true
        set cursor = cursor + 1
        if cursor >= token_count: return err("SQL parser expected a WHERE column at end of input")
        set where_column = list_get(tokens, cursor)
        if where_column.kind != 1 and where_column.kind != 2:
            return err(yaza_sql_v1_parse_error(tokens, cursor, "SQL parser expected a WHERE column at byte "))
        set cursor = cursor + 1
        set where_operator = yaza_sql_v1_comparison_code(source, tokens, cursor)
        if where_operator == 0:
            return err(yaza_sql_v1_parse_error(tokens, cursor, "SQL parser expected a comparison operator at byte "))
        set cursor = cursor + 1
        if cursor >= token_count: return err("SQL parser expected a WHERE value at end of input")
        set where_value = list_get(tokens, cursor)
        if where_value.kind != 3 and where_value.kind != 4 and where_value.kind != 5:
            if not yaza_sql_v1_is_keyword(source, tokens, cursor, "NULL") and not yaza_sql_v1_is_keyword(source, tokens, cursor, "TRUE") and not yaza_sql_v1_is_keyword(source, tokens, cursor, "FALSE"):
                return err(yaza_sql_v1_parse_error(tokens, cursor, "SQL parser expected a literal or bind parameter at byte "))
        set cursor = cursor + 1

    let order_result: Result[List[YazaSqlOrderTermV1], Text] = list_try_new()
    if not result_is_ok(order_result): return err("SQL parser could not allocate the ORDER BY list")
    var order_by: List[YazaSqlOrderTermV1] = result_unwrap(order_result)
    if yaza_sql_v1_is_keyword(source, tokens, cursor, "ORDER"):
        set cursor = cursor + 1
        if not yaza_sql_v1_is_keyword(source, tokens, cursor, "BY"):
            return err(yaza_sql_v1_parse_error(tokens, cursor, "SQL parser expected BY after ORDER at byte "))
        set cursor = cursor + 1
        var order_done: Boolean = false
        while not order_done:
            if cursor >= token_count: return err("SQL parser expected an ORDER BY column at end of input")
            let order_token: YazaSqlTokenV1 = list_get(tokens, cursor)
            if order_token.kind != 1 and order_token.kind != 2:
                return err(yaza_sql_v1_parse_error(tokens, cursor, "SQL parser expected an ORDER BY column at byte "))
            set cursor = cursor + 1
            var descending: Boolean = false
            if yaza_sql_v1_is_keyword(source, tokens, cursor, "DESC"):
                set descending = true
                set cursor = cursor + 1
            elif yaza_sql_v1_is_keyword(source, tokens, cursor, "ASC"):
                set cursor = cursor + 1
            if not list_try_push(order_by, YazaSqlOrderTermV1(order_token, descending)):
                return err(yaza_sql_v1_parse_error(tokens, cursor - 1, "SQL parser order-list limit or allocation failure at byte "))
            if yaza_sql_v1_is_symbol(source, tokens, cursor, 44):
                set cursor = cursor + 1
            else:
                set order_done = true

    var has_limit: Boolean = false
    var limit_value: Number = 0
    if yaza_sql_v1_is_keyword(source, tokens, cursor, "LIMIT"):
        set has_limit = true
        set cursor = cursor + 1
        if cursor >= token_count: return err("SQL parser expected an integer LIMIT at end of input")
        let limit_token: YazaSqlTokenV1 = list_get(tokens, cursor)
        if limit_token.kind != 3:
            return err(yaza_sql_v1_parse_error(tokens, cursor, "SQL parser expected an integer LIMIT at byte "))
        var digit_offset: Number = limit_token.start_byte
        while digit_offset < limit_token.end_byte:
            let digit_byte: Number = text_byte(source, digit_offset)
            if digit_byte < 48 or digit_byte > 57:
                return err(yaza_sql_v1_parse_error(tokens, cursor, "SQL parser LIMIT must be an unsigned integer at byte "))
            let digit: Number = digit_byte - 48
            if limit_value > 100000 or (limit_value == 100000 and digit > 0):
                return err(yaza_sql_v1_parse_error(tokens, cursor, "SQL parser LIMIT exceeds 1000000 at byte "))
            set limit_value = limit_value * 10 + digit
            set digit_offset = digit_offset + 1
        if limit_value > 1000000:
            return err(yaza_sql_v1_parse_error(tokens, cursor, "SQL parser LIMIT exceeds 1000000 at byte "))
        set cursor = cursor + 1

    var statement_end: Number = list_get(tokens, cursor - 1).end_byte
    if yaza_sql_v1_is_symbol(source, tokens, cursor, 59):
        set statement_end = list_get(tokens, cursor).end_byte
        set cursor = cursor + 1
    if cursor >= token_count or list_get(tokens, cursor).kind != 0:
        return err(yaza_sql_v1_parse_error(tokens, cursor, "SQL parser supports one statement; unexpected token at byte "))

    return ok(YazaSqlSelectAstV1(1, first_token.start_byte, statement_end, distinct, projections, table_token, has_where, where_column, where_operator, where_value, order_by, has_limit, limit_value))
