# Bounded DELETE parser adapter over the existing SELECT predicate grammar.
# DELETE reuses typed binding and execution; ORDER BY and LIMIT are rejected.
use "./sql_parser_v3"

fn yaza_sql_parse_delete_v1(source: Text) -> Result[Text, Text]:
    let lexed: Result[List[YazaSqlTokenV1], Text] = yaza_sql_lex_v1(source)
    if not result_is_ok(lexed): return err(result_unwrap_error(lexed))
    let tokens: List[YazaSqlTokenV1] = result_unwrap(lexed)
    if list_count(tokens) < 3: return err("SQL DELETE requires FROM and a table name")
    if not yaza_sql_v2_is_keyword(source, tokens, 0, "DELETE"): return err("SQL DELETE parser expected DELETE at the start of the statement")
    if not yaza_sql_v2_is_keyword(source, tokens, 1, "FROM"): return err("SQL DELETE parser expected FROM after DELETE")
    let source_length: Number = text_length(source)
    let from_token: YazaSqlTokenV1 = list_get(tokens, 1)
    if source_length > 65527: return err("SQL DELETE source exceeds the bounded rewritten-query length")
    let tail_result: Result[Text, Text] = text_try_slice(source, from_token.start_byte, source_length - from_token.start_byte)
    if not result_is_ok(tail_result): return err("SQL DELETE parser could not read the FROM clause")
    let select_source: Text = "SELECT * " + result_unwrap(tail_result)
    let parsed: YazaSqlSelectAstV3 = yaza_sql_parse_select_v3(select_source)?
    if parsed.distinct or parsed.has_limit or list_count(parsed.order_by) != 0: return err("SQL DELETE does not support DISTINCT, ORDER BY, or LIMIT")
    if list_count(parsed.projections) != 1 or not list_get(parsed.projections, 0).name.wildcard: return err("SQL DELETE internal predicate query must project every row column")
    return ok(select_source)
