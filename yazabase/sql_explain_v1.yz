# Readable, bounded logical-plan explanation for the current SELECT profile.
# Physical B+Tree access selection is deliberately not represented here.
use "./sql_binder_v1"
use "./index_catalog_v1"
use "./catalog_schema_v1"
use "./row_v1"
use "./sql_parser_v3"
use "./storage_v1"

fn yaza_sql_explain_concat3_v1(first: Text, second: Text, third: Text) -> Result[Text, Text]:
    let partial: Result[Text, Text] = text_try_concat(first, second)
    if not result_is_ok(partial): return err(result_unwrap_error(partial))
    return text_try_concat(result_unwrap(partial), third)

fn yaza_sql_explain_operator_line_v1(index: Number, operator: YazaSqlLogicalOperatorV1, plan: YazaSqlBoundPlanV1) -> Result[Text, Text]:
    let index_text: Text = number_try_text(index)?
    if operator.kind == 1:
        let table_text: Text = number_try_text(operator.table_id)?
        let start: Text = yaza_sql_explain_concat3_v1(index_text, ": Scan(table_id=", table_text)?
        return text_try_concat(start, ")\n")
    if operator.kind == 2:
        let expression_text: Text = number_try_text(operator.expression_root)?
        let start: Text = yaza_sql_explain_concat3_v1(index_text, ": Filter(expression_root=", expression_text)?
        return text_try_concat(start, ")\n")
    if operator.kind == 8:
        let expression_text: Text = number_try_text(operator.expression_root)?
        let start: Text = yaza_sql_explain_concat3_v1(index_text, ": Filter(phase=HAVING,expression_root=", expression_text)?
        return text_try_concat(start, ")\n")
    if operator.kind == 3:
        let column_count_text: Text = number_try_text(operator.item_count)?
        let start: Text = yaza_sql_explain_concat3_v1(index_text, ": Project(columns=", column_count_text)?
        return text_try_concat(start, ")\n")
    if operator.kind == 4:
        return text_try_concat(index_text, ": Distinct\n")
    if operator.kind == 5:
        let key_count_text: Text = number_try_text(operator.item_count)?
        let start: Text = yaza_sql_explain_concat3_v1(index_text, ": Sort(keys=", key_count_text)?
        return text_try_concat(start, ")\n")
    if operator.kind == 6:
        let limit_text: Text = number_try_text(operator.limit)?
        let start: Text = yaza_sql_explain_concat3_v1(index_text, ": Limit(rows=", limit_text)?
        return text_try_concat(start, ")\n")
    if operator.kind == yaza_sql_operator_cross_join_v1():
        let table_text: Text = number_try_text(operator.table_id)?
        let start: Text = yaza_sql_explain_concat3_v1(index_text, ": CrossJoin(table_id=", table_text)?
        return text_try_concat(start, ")\n")
    if operator.kind == yaza_sql_operator_theta_join_v1():
        let table_text: Text = number_try_text(operator.table_id)?
        let left_key_text: Text = number_try_text(operator.item_start)?
        let right_key_text: Text = number_try_text(operator.item_count)?
        var comparison_text: Text = ""
        if operator.limit == 2: set comparison_text = "!="
        elif operator.limit == 3: set comparison_text = "<"
        elif operator.limit == 4: set comparison_text = "<="
        elif operator.limit == 5: set comparison_text = ">"
        elif operator.limit == 6: set comparison_text = ">="
        let prefix: Text = yaza_sql_explain_concat3_v1(index_text, ": ThetaJoin(table_id=", table_text)?
        let left_part: Text = text_try_concat(prefix, ",left_key=")?
        let left_value: Text = text_try_concat(left_part, left_key_text)?
        let comparison_part: Text = text_try_concat(left_value, ",predicate=")?
        let comparison_value: Text = text_try_concat(comparison_part, comparison_text)?
        let right_part: Text = text_try_concat(comparison_value, ",right_key=")?
        let right_value: Text = text_try_concat(right_part, right_key_text)?
        return text_try_concat(right_value, ")\n")
    if operator.kind == 9:
        let table_text: Text = number_try_text(operator.table_id)?
        let left_key_text: Text = number_try_text(operator.item_start)?
        let right_key_text: Text = number_try_text(operator.item_count)?
        let prefix: Result[Text, Text] = yaza_sql_explain_concat3_v1(index_text, ": InnerJoin(table_id=", table_text)
        if not result_is_ok(prefix): return err(result_unwrap_error(prefix))
        let left_part: Result[Text, Text] = text_try_concat(result_unwrap(prefix), ",left_key=")
        if not result_is_ok(left_part): return err(result_unwrap_error(left_part))
        let left_value: Result[Text, Text] = text_try_concat(result_unwrap(left_part), left_key_text)
        if not result_is_ok(left_value): return err(result_unwrap_error(left_value))
        let right_part: Result[Text, Text] = text_try_concat(result_unwrap(left_value), ",right_key=")
        if not result_is_ok(right_part): return err(result_unwrap_error(right_part))
        let right_value: Result[Text, Text] = text_try_concat(result_unwrap(right_part), right_key_text)
        if not result_is_ok(right_value): return err(result_unwrap_error(right_value))
        return text_try_concat(result_unwrap(right_value), ")\n")
    if operator.kind == 10:
        let table_text: Text = number_try_text(operator.table_id)?
        let left_key_text: Text = number_try_text(operator.item_start)?
        let right_key_text: Text = number_try_text(operator.item_count)?
        let prefix: Result[Text, Text] = yaza_sql_explain_concat3_v1(index_text, ": LeftJoin(table_id=", table_text)
        if not result_is_ok(prefix): return err(result_unwrap_error(prefix))
        let left_part: Result[Text, Text] = text_try_concat(result_unwrap(prefix), ",left_key=")
        if not result_is_ok(left_part): return err(result_unwrap_error(left_part))
        let left_value: Result[Text, Text] = text_try_concat(result_unwrap(left_part), left_key_text)
        if not result_is_ok(left_value): return err(result_unwrap_error(left_value))
        let right_part: Result[Text, Text] = text_try_concat(result_unwrap(left_value), ",right_key=")
        if not result_is_ok(right_part): return err(result_unwrap_error(right_part))
        let right_value: Result[Text, Text] = text_try_concat(result_unwrap(right_part), right_key_text)
        if not result_is_ok(right_value): return err(result_unwrap_error(right_value))
        return text_try_concat(result_unwrap(right_value), ")\n")
    if operator.kind == yaza_sql_operator_right_join_v1():
        let table_text: Text = number_try_text(operator.table_id)?
        let left_key_text: Text = number_try_text(operator.item_start)?
        let right_key_text: Text = number_try_text(operator.item_count)?
        let prefix: Result[Text, Text] = yaza_sql_explain_concat3_v1(index_text, ": RightJoin(normalized_to_left,table_id=", table_text)
        if not result_is_ok(prefix): return err(result_unwrap_error(prefix))
        let left_part: Result[Text, Text] = text_try_concat(result_unwrap(prefix), ",left_key=")
        if not result_is_ok(left_part): return err(result_unwrap_error(left_part))
        let left_value: Result[Text, Text] = text_try_concat(result_unwrap(left_part), left_key_text)
        if not result_is_ok(left_value): return err(result_unwrap_error(left_value))
        let right_part: Result[Text, Text] = text_try_concat(result_unwrap(left_value), ",right_key=")
        if not result_is_ok(right_part): return err(result_unwrap_error(right_part))
        let right_value: Result[Text, Text] = text_try_concat(result_unwrap(right_part), right_key_text)
        if not result_is_ok(right_value): return err(result_unwrap_error(right_value))
        return text_try_concat(result_unwrap(right_value), ")\n")
    if operator.kind == yaza_sql_operator_full_join_v1():
        let table_text: Text = number_try_text(operator.table_id)?
        let left_key_text: Text = number_try_text(operator.item_start)?
        let right_key_text: Text = number_try_text(operator.item_count)?
        let prefix: Result[Text, Text] = yaza_sql_explain_concat3_v1(index_text, ": FullJoin(table_id=", table_text)
        if not result_is_ok(prefix): return err(result_unwrap_error(prefix))
        let left_part: Result[Text, Text] = text_try_concat(result_unwrap(prefix), ",left_key=")
        if not result_is_ok(left_part): return err(result_unwrap_error(left_part))
        let left_value: Result[Text, Text] = text_try_concat(result_unwrap(left_part), left_key_text)
        if not result_is_ok(left_value): return err(result_unwrap_error(left_value))
        let right_part: Result[Text, Text] = text_try_concat(result_unwrap(left_value), ",right_key=")
        if not result_is_ok(right_part): return err(result_unwrap_error(right_part))
        let right_value: Result[Text, Text] = text_try_concat(result_unwrap(right_part), right_key_text)
        if not result_is_ok(right_value): return err(result_unwrap_error(right_value))
        return text_try_concat(result_unwrap(right_value), ")\n")
    if operator.kind == yaza_sql_operator_aggregate_v1():
        var functions: Text = ""
        var projection_index: Number = 0
        while projection_index < list_count(plan.projections):
            if projection_index > 0:
                let comma_result: Result[Text, Text] = text_try_concat(functions, ",")
                if not result_is_ok(comma_result): return err(result_unwrap_error(comma_result))
                set functions = result_unwrap(comma_result)
            let projection: YazaSqlBoundProjectionV1 = list_get(plan.projections, projection_index)
            var function_text: Text = "COUNT(*)"
            if projection.aggregate_kind == 0:
                set function_text = "GROUP KEY"
            elif projection.aggregate_kind != 1:
                if projection.source_start_byte < 0 or projection.source_end_byte <= projection.source_start_byte or projection.source_end_byte > text_length(plan.source):
                    return err("YDBv1 logical EXPLAIN received an invalid aggregate source span")
                let aggregate_text: Result[Text, Text] = text_try_slice(plan.source, projection.source_start_byte, projection.source_end_byte - projection.source_start_byte)
                if not result_is_ok(aggregate_text): return err("YDBv1 logical EXPLAIN could not read an aggregate expression")
                set function_text = result_unwrap(aggregate_text)
            let function_result: Result[Text, Text] = text_try_concat(functions, function_text)
            if not result_is_ok(function_result): return err(result_unwrap_error(function_result))
            set functions = result_unwrap(function_result)
            set projection_index = projection_index + 1
        var aggregate_prefix: Text = ": Aggregate(function="
        if list_count(plan.projections) > 1: set aggregate_prefix = ": Aggregate(functions="
        let aggregate_start: Result[Text, Text] = yaza_sql_explain_concat3_v1(index_text, aggregate_prefix, functions)
        if not result_is_ok(aggregate_start): return err(result_unwrap_error(aggregate_start))
        if list_count(plan.group_by_columns) == 0: return text_try_concat(result_unwrap(aggregate_start), ")\n")
        let group_count: Text = number_try_text(list_count(plan.group_by_columns))?
        let grouped: Result[Text, Text] = text_try_concat(result_unwrap(aggregate_start), ",group_by_columns=")
        if not result_is_ok(grouped): return err(result_unwrap_error(grouped))
        let grouped_count: Result[Text, Text] = text_try_concat(result_unwrap(grouped), group_count)
        if not result_is_ok(grouped_count): return err(result_unwrap_error(grouped_count))
        return text_try_concat(result_unwrap(grouped_count), ")\n")
    return err("YDBv1 logical EXPLAIN encountered an unsupported operator")

fn yaza_sql_explain_bound_select_v1(plan: YazaSqlBoundPlanV1) -> Result[Text, Text]:
    let operator_count: Number = list_count(plan.operators)
    if plan.version != 1 or plan.table_id <= 0 or operator_count < 2 or operator_count > 32 or list_count(plan.projections) == 0 or list_count(plan.projections) > 1024 or list_count(plan.group_by_columns) > 64 or list_count(plan.join_stages) > 6:
        return err("YDBv1 logical EXPLAIN received an invalid bounded plan")
    if plan.right_table_id == 0:
        if plan.right_column_count != 0 or plan.join_left_column_ordinal != -1 or plan.join_right_column_ordinal != -1 or plan.join_comparison_operator != 0 or list_count(plan.join_stages) != 0:
            return err("YDBv1 logical EXPLAIN received invalid non-join metadata")
    else:
        if plan.right_table_id <= 0 or plan.left_column_count <= 0 or plan.right_column_count <= 0 or plan.left_column_count + plan.right_column_count > 1024 or operator_count < 3:
            return err("YDBv1 logical EXPLAIN received invalid JOIN metadata")
        let join_kind: Number = list_get(plan.operators, 2).kind
        if join_kind == yaza_sql_operator_cross_join_v1():
            if plan.join_left_column_ordinal != -1 or plan.join_right_column_ordinal != -1 or plan.join_comparison_operator != 0:
                return err("YDBv1 logical EXPLAIN received invalid CROSS JOIN metadata")
        elif join_kind == yaza_sql_operator_theta_join_v1():
            if plan.join_comparison_operator < 2 or plan.join_comparison_operator > 6 or plan.join_left_column_ordinal < 0 or plan.join_left_column_ordinal >= plan.left_column_count or plan.join_right_column_ordinal < 0 or plan.join_right_column_ordinal >= plan.right_column_count:
                return err("YDBv1 logical EXPLAIN received invalid theta JOIN metadata")
        elif plan.join_comparison_operator != 1 or plan.join_left_column_ordinal < 0 or plan.join_left_column_ordinal >= plan.left_column_count or plan.join_right_column_ordinal < 0 or plan.join_right_column_ordinal >= plan.right_column_count:
            return err("YDBv1 logical EXPLAIN received invalid equality JOIN metadata")
        var accumulated_column_count: Number = plan.left_column_count + plan.right_column_count
        var stage_index: Number = 0
        while stage_index < list_count(plan.join_stages):
            let stage: YazaSqlBoundJoinStageV1 = list_get(plan.join_stages, stage_index)
            let equality_stage: Boolean = stage.join_kind == yaza_sql_operator_inner_join_v1() or stage.join_kind == yaza_sql_operator_left_join_v1() or stage.join_kind == yaza_sql_operator_right_join_v1() or stage.join_kind == yaza_sql_operator_full_join_v1()
            let theta_stage: Boolean = stage.join_kind == yaza_sql_operator_theta_join_v1()
            let cross_stage: Boolean = stage.join_kind == yaza_sql_operator_cross_join_v1()
            let valid_comparison: Boolean = (equality_stage and stage.comparison_operator == 1) or (theta_stage and stage.comparison_operator >= 2 and stage.comparison_operator <= 6) or (cross_stage and stage.comparison_operator == 0)
            let valid_keys: Boolean = (cross_stage and stage.left_key_ordinal == -1 and stage.right_key_ordinal == -1) or (not cross_stage and stage.left_key_ordinal >= 0 and stage.left_key_ordinal < accumulated_column_count and stage.right_key_ordinal >= 0 and stage.right_key_ordinal < stage.column_count)
            if stage.table_id <= 0 or stage.column_count <= 0 or not valid_comparison or not valid_keys:
                return err("YDBv1 logical EXPLAIN received invalid additional JOIN metadata")
            set accumulated_column_count = accumulated_column_count + stage.column_count
            if accumulated_column_count > 1024: return err("YDBv1 logical EXPLAIN JOIN chain exceeds the flattened schema limit")
            set stage_index = stage_index + 1
    var group_column_index: Number = 0
    while group_column_index < list_count(plan.group_by_columns):
        let group_column: Number = list_get(plan.group_by_columns, group_column_index)
        if group_column < 0: return err("YDBv1 logical EXPLAIN received an invalid GROUP BY column")
        var prior_group_index: Number = 0
        while prior_group_index < group_column_index:
            if list_get(plan.group_by_columns, prior_group_index) == group_column: return err("YDBv1 logical EXPLAIN received a duplicate GROUP BY column")
            set prior_group_index = prior_group_index + 1
        set group_column_index = group_column_index + 1
    if plan.root_operator != operator_count - 1:
        return err("YDBv1 logical EXPLAIN received an invalid root operator")
    if plan.where_root < -1 or plan.where_root >= list_count(plan.expressions):
        return err("YDBv1 logical EXPLAIN received an invalid predicate root")
    if plan.having_start_index < 0 or plan.having_start_index > list_count(plan.expressions) or (plan.where_root >= plan.having_start_index and plan.where_root >= 0):
        return err("YDBv1 logical EXPLAIN received an invalid HAVING expression boundary")
    if plan.having_root < -1 or (plan.having_root >= 0 and (plan.having_root < plan.having_start_index or plan.having_root >= list_count(plan.expressions))) or (plan.having_root < 0 and plan.having_start_index != list_count(plan.expressions)):
        return err("YDBv1 logical EXPLAIN received an invalid HAVING predicate root")

    var expected_index: Number = 0
    let scan: YazaSqlLogicalOperatorV1 = list_get(plan.operators, expected_index)
    if scan.kind != 1 or scan.input_index != -1 or scan.table_id != plan.table_id:
        return err("YDBv1 logical EXPLAIN received an invalid scan node")
    set expected_index = expected_index + 1
    if plan.right_table_id > 0:
        if expected_index + 1 >= operator_count: return err("YDBv1 logical EXPLAIN is missing a joined scan or JOIN node")
        let right_scan: YazaSqlLogicalOperatorV1 = list_get(plan.operators, expected_index)
        if right_scan.kind != 1 or right_scan.input_index != -1 or right_scan.table_id != plan.right_table_id:
            return err("YDBv1 logical EXPLAIN received an invalid joined scan node")
        set expected_index = expected_index + 1
        let join_operator: YazaSqlLogicalOperatorV1 = list_get(plan.operators, expected_index)
        if (join_operator.kind != 9 and join_operator.kind != 10 and join_operator.kind != yaza_sql_operator_right_join_v1() and join_operator.kind != yaza_sql_operator_full_join_v1() and join_operator.kind != yaza_sql_operator_cross_join_v1() and join_operator.kind != yaza_sql_operator_theta_join_v1()) or join_operator.input_index != 0 or join_operator.expression_root != 1 or join_operator.table_id != plan.right_table_id or join_operator.item_start != plan.join_left_column_ordinal or join_operator.item_count != plan.join_right_column_ordinal or join_operator.limit != plan.join_comparison_operator:
            return err("YDBv1 logical EXPLAIN received an invalid JOIN node")
        set expected_index = expected_index + 1
        var prior_join_index: Number = expected_index - 1
        var stage_index: Number = 0
        while stage_index < list_count(plan.join_stages):
            let stage: YazaSqlBoundJoinStageV1 = list_get(plan.join_stages, stage_index)
            if expected_index + 1 >= operator_count: return err("YDBv1 logical EXPLAIN is missing an additional joined scan or JOIN node")
            let stage_scan: YazaSqlLogicalOperatorV1 = list_get(plan.operators, expected_index)
            if stage_scan.kind != 1 or stage_scan.input_index != -1 or stage_scan.table_id != stage.table_id:
                return err("YDBv1 logical EXPLAIN received an invalid additional joined scan node")
            set expected_index = expected_index + 1
            let stage_join: YazaSqlLogicalOperatorV1 = list_get(plan.operators, expected_index)
            if stage_join.kind != stage.join_kind or stage_join.input_index != prior_join_index or stage_join.expression_root != expected_index - 1 or stage_join.table_id != stage.table_id or stage_join.item_start != stage.left_key_ordinal or stage_join.item_count != stage.right_key_ordinal or stage_join.limit != stage.comparison_operator:
                return err("YDBv1 logical EXPLAIN received an invalid additional JOIN node")
            set prior_join_index = expected_index
            set expected_index = expected_index + 1
            set stage_index = stage_index + 1
    if plan.where_root >= 0:
        if expected_index >= operator_count: return err("YDBv1 logical EXPLAIN is missing its filter node")
        let filter: YazaSqlLogicalOperatorV1 = list_get(plan.operators, expected_index)
        if filter.kind != 2 or filter.input_index != expected_index - 1 or filter.expression_root != plan.where_root or filter.table_id != plan.table_id:
            return err("YDBv1 logical EXPLAIN received an invalid filter node")
        set expected_index = expected_index + 1
    var has_aggregate: Boolean = false
    var has_plain_projection: Boolean = false
    var projection_index: Number = 0
    while projection_index < list_count(plan.projections):
        let projection: YazaSqlBoundProjectionV1 = list_get(plan.projections, projection_index)
        if projection.aggregate_kind == 1:
            set has_aggregate = true
            if projection.column_ordinal != -1 or projection.type_id != 4 or projection.nullable or text_length(projection.output_name) == 0:
                return err("YDBv1 logical EXPLAIN received malformed COUNT(*) projection metadata")
        elif projection.aggregate_kind == 2:
            set has_aggregate = true
            if projection.column_ordinal < 0 or (projection.type_id != 4 and projection.type_id != 6) or not projection.nullable or text_length(projection.output_name) == 0:
                return err("YDBv1 logical EXPLAIN received malformed SUM projection metadata")
        elif projection.aggregate_kind == 3 or projection.aggregate_kind == 4:
            set has_aggregate = true
            if projection.column_ordinal < 0 or (projection.type_id != 1 and projection.type_id != 2 and projection.type_id != 3 and projection.type_id != 4 and projection.type_id != 6 and projection.type_id != 9 and projection.type_id != 11 and projection.type_id != 12 and projection.type_id != 13 and projection.type_id != 14 and projection.type_id != 15 and projection.type_id != 16) or not projection.nullable or text_length(projection.output_name) == 0:
                return err("YDBv1 logical EXPLAIN received malformed MIN/MAX projection metadata")
        elif projection.aggregate_kind == 5:
            set has_aggregate = true
            if projection.column_ordinal < 0 or projection.type_id != 6 or not projection.nullable or text_length(projection.output_name) == 0:
                return err("YDBv1 logical EXPLAIN received malformed AVG projection metadata")
        elif projection.aggregate_kind == 0:
            set has_plain_projection = true
            if text_length(projection.output_name) == 0: return err("YDBv1 logical EXPLAIN received a projection without an output name")
        else: return err("YDBv1 logical EXPLAIN received an unsupported aggregate projection")
        set projection_index = projection_index + 1
    if has_aggregate and list_count(plan.group_by_columns) == 0 and has_plain_projection: return err("YDBv1 logical EXPLAIN ungrouped plan mixes aggregate and regular projections")
    if list_count(plan.group_by_columns) > 0 and has_plain_projection:
        var group_projection_index: Number = 0
        while group_projection_index < list_count(plan.projections):
            let group_projection: YazaSqlBoundProjectionV1 = list_get(plan.projections, group_projection_index)
            if group_projection.aggregate_kind == 0:
                var is_group_key: Boolean = false
                var group_key_index: Number = 0
                while group_key_index < list_count(plan.group_by_columns):
                    if list_get(plan.group_by_columns, group_key_index) == group_projection.column_ordinal: set is_group_key = true
                    set group_key_index = group_key_index + 1
                if not is_group_key: return err("YDBv1 logical EXPLAIN projection is not a GROUP BY column")
            set group_projection_index = group_projection_index + 1
    if has_aggregate and list_count(plan.group_by_columns) == 0 and list_count(plan.order_by) > 0: return err("YDBv1 logical EXPLAIN v1 does not support ORDER BY on ungrouped aggregates")
    let uses_aggregate_operator: Boolean = has_aggregate or list_count(plan.group_by_columns) > 0
    if plan.having_root >= 0 and not uses_aggregate_operator: return err("YDBv1 logical EXPLAIN received HAVING without grouping or aggregation")
    if expected_index >= operator_count: return err("YDBv1 logical EXPLAIN is missing its projection or aggregate node")
    let project: YazaSqlLogicalOperatorV1 = list_get(plan.operators, expected_index)
    if uses_aggregate_operator:
        if project.kind != yaza_sql_operator_aggregate_v1() or project.input_index != expected_index - 1 or project.item_start != list_count(plan.group_by_columns) or project.item_count != list_count(plan.projections) or project.table_id != plan.table_id:
            return err("YDBv1 logical EXPLAIN received an invalid aggregate node")
    elif project.kind != 3 or project.input_index != expected_index - 1 or project.item_count != list_count(plan.projections) or project.table_id != plan.table_id:
        return err("YDBv1 logical EXPLAIN received an invalid projection node")
    set expected_index = expected_index + 1
    if plan.having_root >= 0:
        if expected_index >= operator_count: return err("YDBv1 logical EXPLAIN is missing its HAVING filter node")
        let having_filter: YazaSqlLogicalOperatorV1 = list_get(plan.operators, expected_index)
        if having_filter.kind != 8 or having_filter.input_index != expected_index - 1 or having_filter.expression_root != plan.having_root or having_filter.table_id != plan.table_id:
            return err("YDBv1 logical EXPLAIN received an invalid HAVING filter node")
        set expected_index = expected_index + 1
    if plan.distinct:
        if expected_index >= operator_count: return err("YDBv1 logical EXPLAIN is missing its distinct node")
        let distinct: YazaSqlLogicalOperatorV1 = list_get(plan.operators, expected_index)
        if distinct.kind != 4 or distinct.input_index != expected_index - 1 or distinct.table_id != plan.table_id:
            return err("YDBv1 logical EXPLAIN received an invalid distinct node")
        set expected_index = expected_index + 1
    if list_count(plan.order_by) > 0:
        if expected_index >= operator_count: return err("YDBv1 logical EXPLAIN is missing its sort node")
        let sort: YazaSqlLogicalOperatorV1 = list_get(plan.operators, expected_index)
        if sort.kind != 5 or sort.input_index != expected_index - 1 or sort.item_count != list_count(plan.order_by) or sort.table_id != plan.table_id:
            return err("YDBv1 logical EXPLAIN received an invalid sort node")
        set expected_index = expected_index + 1
    if plan.has_limit:
        if expected_index >= operator_count: return err("YDBv1 logical EXPLAIN is missing its limit node")
        let limit: YazaSqlLogicalOperatorV1 = list_get(plan.operators, expected_index)
        if limit.kind != 6 or limit.input_index != expected_index - 1 or limit.limit != plan.limit or limit.table_id != plan.table_id:
            return err("YDBv1 logical EXPLAIN received an invalid limit node")
        set expected_index = expected_index + 1
    if expected_index != operator_count:
        return err("YDBv1 logical EXPLAIN plan does not match the supported SELECT operator chain")

    var output: Text = "YazaBase logical plan v1 (physical access path not shown)\n"
    var operator_index: Number = 0
    while operator_index < operator_count:
        let line: Text = yaza_sql_explain_operator_line_v1(operator_index, list_get(plan.operators, operator_index), plan)?
        let appended: Result[Text, Text] = text_try_concat(output, line)
        if not result_is_ok(appended): return err(result_unwrap_error(appended))
        set output = result_unwrap(appended)
        set operator_index = operator_index + 1
    return ok(output)

fn yaza_sql_explain_select_v1(source: Text, catalog: YazaSqlCatalogSnapshotV1) -> Result[Text, Text]:
    let parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(source)
    if not result_is_ok(parsed): return err(result_unwrap_error(parsed))
    let plan: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(source, result_unwrap(parsed), catalog)
    if not result_is_ok(plan): return err(result_unwrap_error(plan))
    return yaza_sql_explain_bound_select_v1(result_unwrap(plan))

fn yaza_sql_explain_physical_access_v1(file: Number, file_header: YazaDbFileHeaderV1, plan: YazaSqlBoundPlanV1) -> Result[Text, Text]:
    if list_count(plan.join_stages) > 0: return ok("Physical: Left-deep bounded JOIN stages over clustered B+Tree scans\n")
    if plan.right_table_id > 0: return ok("Physical: ClusteredBTreeScan for both join inputs\n")
    if plan.where_root >= 0 and plan.where_root < list_count(plan.expressions):
        let predicate: YazaSqlBoundExpressionNodeV1 = list_get(plan.expressions, plan.where_root)
        if predicate.kind == 1 and (predicate.operator == 1 or (predicate.operator >= 3 and predicate.operator <= 6)):
            let index_rows: List[YazaDbRowV1] = yaza_db_index_catalog_rows_v1(file, file_header, file_header.next_commit_ts - 1)?
            var row_index: Number = 0
            while row_index < list_count(index_rows):
                let row: YazaDbRowV1 = list_get(index_rows, row_index)
                if list_get(row.values, 1).integer_value == plan.table_id and list_get(row.values, 4).integer_value == yaza_db_catalog_index_kind_secondary_active_v1() and list_get(row.values, 6).text_value == number_text(predicate.column_ordinal):
                    let detail: Result[Text, Text] = yaza_sql_explain_concat3_v1("Physical: SecondaryIndexRangeScan(index=", list_get(row.values, 2).text_value, ", SQL predicate recheck enabled)\n")
                    if not result_is_ok(detail): return err(result_unwrap_error(detail))
                    return ok(result_unwrap(detail))
                set row_index = row_index + 1
    if plan.has_limit and plan.where_root < 0 and list_count(plan.order_by) == 0 and not plan.distinct:
        return ok("Physical: ClusteredBTreePrefixScan(limit bounded)\n")
    return ok("Physical: ClusteredBTreeScan\n")

fn yaza_sql_explain_select_with_access_v1(file: Number, file_header: YazaDbFileHeaderV1, source: Text, catalog: YazaSqlCatalogSnapshotV1) -> Result[Text, Text]:
    let parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(source)
    if not result_is_ok(parsed): return err(result_unwrap_error(parsed))
    let bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(source, result_unwrap(parsed), catalog)
    if not result_is_ok(bound): return err(result_unwrap_error(bound))
    let plan: YazaSqlBoundPlanV1 = result_unwrap(bound)
    let logical: Text = yaza_sql_explain_bound_select_v1(plan)?
    let physical: Text = yaza_sql_explain_physical_access_v1(file, file_header, plan)?
    return text_try_concat(logical, physical)
