# Bounded reclamation plan for overflow chains reachable from a dropped table.
# The table's current leaf rows and their bounded WAL undo versions are scanned
# before DROP starts writing. Page CRCs, chain lengths/links, row images, and
# version links are checked before any referenced page can be freed.
use "./overflow_v1"
use "./btree_reclaim_v1"
use "./btree_scan_v1"
use "./mvcc_history_v1"
use "./page_v1"
use "./page_wal_v1"
use "./row_v1"
use "./storage_v1"
use "./wal_v1"

shape YazaDbOverflowReclaimPlanV1:
    page_ids: List[Number]
    page_reads: Number
    history_records: Number

shape YazaDbOverflowReclaimRowPlanV1:
    page_reads: Number
    history_records: Number

fn yaza_db_overflow_reclaim_seen_capacity_v1() -> Number:
    return 131072

fn yaza_db_overflow_reclaim_slot_needs_decode_v1(page: Bytes, slot_index: Number) -> Result[Boolean, Text]:
    let descriptor: Number = yaza_db_page_header_size_v1() + slot_index * yaza_db_page_slot_size_v1()
    let slot_offset: Number = yaza_db_read_uint_le_v1(page, descriptor, 2)?
    let key_length: Number = yaza_db_read_uint_le_v1(page, descriptor + 2, 2)?
    let payload_length: Number = yaza_db_read_uint_le_v1(page, descriptor + 4, 2)?
    let payload_start: Number = slot_offset + key_length
    if payload_start < yaza_db_page_header_size_v1() or payload_length < yaza_db_row_header_size_v1() or payload_length > yaza_db_row_max_inline_size_v1() or payload_start > bytes_length(page) - payload_length: return err("YDBv1 DROP TABLE found a row payload outside the inline tuple bound")
    let undo_ref: Number = yaza_db_read_uint_le_v1(page, payload_start + 8, 8)?
    if undo_ref > yaza_db_row_max_undo_ref_v1(): return err("YDBv1 DROP TABLE row undo reference is outside its WAL bound")
    if undo_ref > 0: return ok(true)
    # A valid external TEXT reference contains the four-byte all-ones length
    # marker. Only candidate rows pay for full row decoding and list creation.
    var offset: Number = yaza_db_row_header_size_v1()
    while offset + 4 <= payload_length:
        if bytes_get(page, payload_start + offset) == 255 and bytes_get(page, payload_start + offset + 1) == 255 and bytes_get(page, payload_start + offset + 2) == 255 and bytes_get(page, payload_start + offset + 3) == 255:
            return ok(true)
        set offset = offset + 1
    return ok(false)

fn yaza_db_overflow_reclaim_max_history_records_v1() -> Number:
    return 1000000

fn yaza_db_overflow_reclaim_seen_status_v1(seen: List[Number], page_id: Number) -> Number:
    let capacity: Number = yaza_db_overflow_reclaim_seen_capacity_v1()
    if list_count(seen) != capacity or page_id < 2: return 0
    var slot: Number = ((page_id % capacity) * 2654435761) % capacity
    var probes: Number = 0
    while probes < 4096 and probes < capacity:
        let stored_page_id: Number = list_get(seen, slot)
        if stored_page_id == page_id: return 1
        if stored_page_id == 0:
            if not list_try_set(seen, slot, page_id): return 0
            return 2
        set slot = (slot + 1) % capacity
        set probes = probes + 1
    return 0

fn yaza_db_overflow_reclaim_add_reference_v1(file: Number, file_header: YazaDbFileHeaderV1, reference: YazaDbOverflowRefV1, seen: List[Number], page_ids: List[Number]) -> Result[Number, Text]:
    if reference.first_page_id == 0:
        if reference.total_length != 0 or reference.checksum != 0 or reference.reserved != 0: return err("YDBv1 DROP TABLE found a non-canonical empty overflow reference")
        return ok(0)
    let ignored_reference: Bytes = yaza_db_overflow_ref_encode_v1(reference)?
    let capacity: Number = yaza_db_overflow_payload_capacity_v1()
    let expected_count: Number = (reference.total_length + capacity - 1) / capacity
    if expected_count < 1 or expected_count > yaza_db_btree_reclaim_max_pages_v1(): return err("YDBv1 DROP TABLE overflow chain exceeds its bounded page profile")
    if list_count(seen) == 0:
        let seen_capacity: Number = yaza_db_overflow_reclaim_seen_capacity_v1()
        if not list_try_reserve(seen, seen_capacity): return err("YDBv1 DROP TABLE could not reserve its overflow-page guard")
        var seen_index: Number = 0
        while seen_index < seen_capacity:
            if not list_try_push(seen, 0): return err("YDBv1 DROP TABLE could not initialize its overflow-page guard")
            set seen_index = seen_index + 1
    var page_id: Number = reference.first_page_id
    var previous_page_id: Number = 1
    var offset: Number = 0
    var page_index: Number = 0
    while page_index < expected_count:
        if page_id <= previous_page_id or page_id < 2 or page_id >= file_header.page_count: return err("YDBv1 DROP TABLE overflow chain page ID is invalid or non-canonical")
        let page: Bytes = yaza_db_storage_read_page_v1(file, file_header, page_id)?
        let decoded: YazaDbOverflowPageV1 = yaza_db_overflow_page_decode_v1(page, page_id)?
        var expected_payload_length: Number = capacity
        if expected_payload_length > reference.total_length - offset: set expected_payload_length = reference.total_length - offset
        if bytes_length(decoded.payload) != expected_payload_length: return err("YDBv1 DROP TABLE overflow payload length does not match its row reference")
        if page_index + 1 == expected_count:
            if decoded.next_page_id != 0: return err("YDBv1 DROP TABLE overflow chain extends beyond its declared length")
        else:
            if decoded.next_page_id <= page_id or decoded.next_page_id >= file_header.page_count: return err("YDBv1 DROP TABLE overflow chain has an invalid next-page link")
        let seen_status: Number = yaza_db_overflow_reclaim_seen_status_v1(seen, page_id)
        if seen_status == 0: return err("YDBv1 DROP TABLE overflow page-set guard is malformed or exhausted")
        if seen_status == 2:
            if list_count(page_ids) >= yaza_db_btree_reclaim_max_pages_v1() or not list_try_push(page_ids, page_id): return err("YDBv1 DROP TABLE overflow page set exceeds its bounded profile")
        set offset = offset + expected_payload_length
        set previous_page_id = page_id
        set page_id = decoded.next_page_id
        set page_index = page_index + 1
    if offset != reference.total_length: return err("YDBv1 DROP TABLE overflow chain does not cover its declared length")
    return ok(expected_count)

fn yaza_db_overflow_reclaim_collect_row_history_v1(root: Number, db_uuid: Bytes, log_end_lsn: Number, file: Number, file_header: YazaDbFileHeaderV1, key: Bytes, current_row: YazaDbRowV1, columns: List[YazaSqlColumnSchemaV1], schema_version: Number, seen: List[Number], page_ids: List[Number]) -> Result[YazaDbOverflowReclaimRowPlanV1, Text]:
    if root < 0 or bytes_length(db_uuid) != 16 or log_end_lsn < 0 or bytes_length(key) < 1 or bytes_length(key) > 2048: return err("YDBv1 DROP TABLE overflow-history identity is invalid")
    if schema_version < 1 or list_count(columns) < 1 or list_count(columns) > 1024: return err("YDBv1 DROP TABLE overflow-history schema is outside its bound")
    var row: YazaDbRowV1 = current_row
    var previous_lsn: Number = log_end_lsn
    var page_reads: Number = 0
    var history_records: Number = 0
    var step: Number = 0
    while true:
        if list_count(row.values) != list_count(columns) or list_count(row.nulls) != list_count(columns) or list_count(row.overflow_refs) != list_count(columns): return err("YDBv1 DROP TABLE row history width does not match the table schema")
        if row.version_ts < 1 or row.version_ts >= file_header.next_commit_ts: return err("YDBv1 DROP TABLE found an unpublished or invalid row version")
        var column_index: Number = 0
        while column_index < list_count(columns):
            let column: YazaSqlColumnSchemaV1 = list_get(columns, column_index)
            let reference: YazaDbOverflowRefV1 = list_get(row.overflow_refs, column_index)
            if reference.first_page_id > 0:
                if (column.type_id != 9 and column.type_id != 16) or list_get(row.nulls, column_index): return err("YDBv1 DROP TABLE overflow reference is attached to a non-TEXT/BLOB or NULL value")
                let chain_reads: Number = yaza_db_overflow_reclaim_add_reference_v1(file, file_header, reference, seen, page_ids)?
                if chain_reads > yaza_db_btree_max_page_reads_v1() - page_reads: return err("YDBv1 DROP TABLE overflow validation exceeds its page-read budget")
                set page_reads = page_reads + chain_reads
            set column_index = column_index + 1
        if row.undo_ref == 0: break
        if step >= yaza_db_mvcc_max_undo_steps_v1(): return err("YDBv1 DROP TABLE row history exceeds the 128-version reclamation bound")
        if row.undo_ref < 1 or row.undo_ref >= previous_lsn or row.undo_ref > yaza_db_row_max_undo_ref_v1(): return err("YDBv1 DROP TABLE undo chain is non-monotonic or outside its WAL bound")
        if history_records >= yaza_db_overflow_reclaim_max_history_records_v1(): return err("YDBv1 DROP TABLE exceeds its one-million-record history reclamation bound")
        let record: YazaDbWalRecordV1 = yaza_db_wal_read_record_at_v1(root, db_uuid, row.undo_ref, log_end_lsn)?
        if record.lsn != row.undo_ref or record.rec_type != yaza_db_wal_type_leaf_update_v1(): return err("YDBv1 DROP TABLE undo reference does not identify a LEAF_UPDATE")
        if row.version_ts < 0:
            let current_txn_id: Number = yaza_db_row_version_txn_decode_v1(row.version_ts)?
            if current_txn_id != record.txn_id: return err("YDBv1 DROP TABLE row transaction tag does not match its undo record")
        let mutation: YazaDbWalLeafMutationV1 = yaza_db_wal_leaf_mutation_payload_decode_v1(record)?
        if mutation.page_id < 2: return err("YDBv1 DROP TABLE undo record has an invalid leaf page ID")
        let recorded_after: YazaDbRowV1 = yaza_db_mvcc_history_row_from_page_v1(mutation.after_image, mutation.page_id, key, columns, schema_version)?
        let expected_after: Bytes = yaza_db_mvcc_row_encode_exact_v1(row, columns)?
        let actual_after: Bytes = yaza_db_mvcc_row_encode_exact_v1(recorded_after, columns)?
        if not bytes_equal(expected_after, actual_after): return err("YDBv1 DROP TABLE undo after-image does not match the row version")
        let previous_row: YazaDbRowV1 = yaza_db_mvcc_history_row_from_page_v1(mutation.before_image, mutation.page_id, key, columns, schema_version)?
        if previous_row.version_ts == 0 or (previous_row.undo_ref >= record.lsn and previous_row.undo_ref != 0): return err("YDBv1 DROP TABLE undo before-image has an invalid version link")
        if previous_row.version_ts < 0 and previous_row.undo_ref == 0:
            let previous_txn_id: Number = yaza_db_row_version_txn_decode_v1(previous_row.version_ts)?
            if previous_txn_id != record.txn_id: return err("YDBv1 DROP TABLE inserted before-image has an inconsistent transaction tag")
        set row = previous_row
        set previous_lsn = record.lsn
        set step = step + 1
        set history_records = history_records + 1
    return ok(YazaDbOverflowReclaimRowPlanV1(page_reads, history_records))

fn yaza_db_overflow_reclaim_plan_table_v1(root: Number, db_uuid: Bytes, log_end_lsn: Number, file: Number, file_header: YazaDbFileHeaderV1, primary_plan: YazaDbBtreeReclaimPlanV1, columns: List[YazaSqlColumnSchemaV1], schema_version: Number, key_ordinals: List[Number]) -> Result[YazaDbOverflowReclaimPlanV1, Text]:
    if primary_plan.page_reads < 1 or list_count(primary_plan.page_ids) < 1 or schema_version < 1: return err("YDBv1 DROP TABLE primary-tree reclaim plan is malformed")
    let page_ids_result: Result[List[Number], Text] = list_try_new()
    let seen_result: Result[List[Number], Text] = list_try_new()
    if not result_is_ok(page_ids_result) or not result_is_ok(seen_result): return err("YDBv1 DROP TABLE could not allocate overflow-reclaim state")
    let page_ids: List[Number] = result_unwrap(page_ids_result)
    let seen: List[Number] = result_unwrap(seen_result)
    if not list_try_reserve(page_ids, 256): return err("YDBv1 DROP TABLE could not reserve overflow-reclaim state")
    var page_reads: Number = 0
    var history_records: Number = 0
    var row_count: Number = 0
    var plan_index: Number = 0
    while plan_index < list_count(primary_plan.page_ids):
        let page_id: Number = list_get(primary_plan.page_ids, plan_index)
        let page: Bytes = yaza_db_storage_read_page_v1(file, file_header, page_id)?
        set page_reads = page_reads + 1
        let page_header: YazaDbPageHeaderV1 = yaza_db_page_header_decode_v1(page, page_id)?
        if page_header.page_type == 1:
            if page_header.level != 0: return err("YDBv1 DROP TABLE row page has a nonzero leaf level")
            var slot_index: Number = 0
            while slot_index < page_header.count:
                if row_count >= yaza_db_btree_max_rows_v1(): return err("YDBv1 DROP TABLE overflow reclamation exceeds the 65,536-row bound")
                let needs_decode: Boolean = yaza_db_overflow_reclaim_slot_needs_decode_v1(page, slot_index)?
                if needs_decode:
                    let key: Bytes = yaza_db_page_slot_key_v1(page, slot_index, page_id)?
                    let slot: YazaDbPageSlotV1 = yaza_db_page_slot_v1(page, slot_index, page_id)?
                    let decoded: YazaDbRowV1 = yaza_db_row_decode_for_schema_v1(slot.payload, columns, schema_version)?
                    let encoded_key: Bytes = yaza_db_key_encode_composite_v1(decoded.values, decoded.nulls, columns, key_ordinals)?
                    if not bytes_equal(encoded_key, key): return err("YDBv1 DROP TABLE row key does not match its stored tuple")
                    let row_plan: YazaDbOverflowReclaimRowPlanV1 = yaza_db_overflow_reclaim_collect_row_history_v1(root, db_uuid, log_end_lsn, file, file_header, key, decoded, columns, schema_version, seen, page_ids)?
                    if row_plan.page_reads > yaza_db_btree_max_page_reads_v1() - page_reads: return err("YDBv1 DROP TABLE overflow reclamation exceeds its page-read budget")
                    if row_plan.history_records > yaza_db_overflow_reclaim_max_history_records_v1() - history_records: return err("YDBv1 DROP TABLE exceeds its one-million-record history reclamation bound")
                    set page_reads = page_reads + row_plan.page_reads
                    set history_records = history_records + row_plan.history_records
                set row_count = row_count + 1
                set slot_index = slot_index + 1
        elif page_header.page_type != 2:
            return err("YDBv1 DROP TABLE primary reclaim plan contains a non-index page")
        set plan_index = plan_index + 1
        if page_reads > yaza_db_btree_max_page_reads_v1(): return err("YDBv1 DROP TABLE overflow reclamation exceeds its page-read budget")
    return ok(YazaDbOverflowReclaimPlanV1(page_ids, page_reads, history_records))
