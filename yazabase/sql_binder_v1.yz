# YAZA Base binder v1: bounded SELECT binding for one table or a left-deep join chain.
# This slice intentionally rejects grammar that has no catalog/execution contract yet.
use "sql_parser_v3"
use "./sql_decimal_v1"
use "./sql_date_v1"
use "./sql_uuid_v1"
use "./sql_temporal_v1"
use "./sql_literal_v1"

shape YazaSqlColumnSchemaV1:
    name: Text
    type_id: Number
    nullable: Boolean
    ordinal: Number
    precision: Number
    scale: Number
    default_expression: Text

shape YazaSqlTableSchemaV1:
    table_id: Number
    name: Text
    columns: List[YazaSqlColumnSchemaV1]

shape YazaSqlColumnDefaultV1:
    table_id: Number
    column_ordinal: Number
    expression: Text

shape YazaSqlCatalogSnapshotV1:
    version: Number
    tables: List[YazaSqlTableSchemaV1]
    column_defaults: List[YazaSqlColumnDefaultV1]

fn yaza_sql_catalog_default_expression_v1(catalog: YazaSqlCatalogSnapshotV1, table_id: Number, column_ordinal: Number) -> Text:
    var index: Number = 0
    while index < list_count(catalog.column_defaults):
        let item: YazaSqlColumnDefaultV1 = list_get(catalog.column_defaults, index)
        if item.table_id == table_id and item.column_ordinal == column_ordinal: return item.expression
        set index = index + 1
    return ""

shape YazaSqlVisibleSourceV1:
    table: YazaSqlTableSchemaV1
    has_alias: Boolean
    alias: YazaSqlTokenV1
    column_offset: Number

shape YazaSqlBoundProjectionV1:
    column_ordinal: Number
    type_id: Number
    nullable: Boolean
    output_name: Text
    source_start_byte: Number
    source_end_byte: Number
    aggregate_kind: Number
    precision: Number
    scale: Number

shape YazaSqlBoundOrderTermV1:
    projection_ordinal: Number
    descending: Boolean

shape YazaSqlBoundExpressionNodeV1:
    kind: Number
    operator: Number
    left_index: Number
    right_index: Number
    column_ordinal: Number
    value_kind: Number
    parameter_ordinal: Number
    type_id: Number
    start_byte: Number
    end_byte: Number
    operator_start_byte: Number
    operator_end_byte: Number
    value_start_byte: Number
    value_end_byte: Number
    precision: Number
    scale: Number
    correlation_column_ordinal: Number
    correlation_type_id: Number
    correlation_precision: Number
    correlation_scale: Number

shape YazaSqlCorrelatedInBindingV1:
    source: Text
    outer_value_ordinal: Number
    value_type_id: Number
    value_precision: Number
    value_scale: Number
    outer_key_ordinal: Number
    key_type_id: Number
    key_precision: Number
    key_scale: Number

shape YazaSqlCorrelatedExistsBindingV1:
    source: Text
    outer_column_ordinal: Number
    type_id: Number
    precision: Number
    scale: Number
    output_type_id: Number
    output_precision: Number
    output_scale: Number

shape YazaSqlBoundParameterV1:
    style: Number
    ordinal: Number
    key: Text
    type_id: Number
    first_start_byte: Number
    occurrence_count: Number

shape YazaSqlSubqueryParameterBindingV1:
    global_ordinals: List[Number]
    parameter_style: Number

shape YazaSqlSubquerySourceMappingV1:
    source: Text
    positional_global_ordinals: List[Number]

shape YazaSqlBoundJoinStageV1:
    table_id: Number
    column_count: Number
    join_kind: Number
    left_key_ordinal: Number
    right_key_ordinal: Number
    comparison_operator: Number

fn yaza_sql_operator_aggregate_v1() -> Number:
    return 7

fn yaza_sql_operator_inner_join_v1() -> Number:
    return 9

fn yaza_sql_operator_left_join_v1() -> Number:
    return 10

fn yaza_sql_operator_right_join_v1() -> Number:
    return 11

fn yaza_sql_operator_full_join_v1() -> Number:
    return 12

fn yaza_sql_operator_cross_join_v1() -> Number:
    return 13

fn yaza_sql_operator_theta_join_v1() -> Number:
    return 14

fn yaza_sql_bind_v1_reverse_comparison_operator(operator: Number) -> Number:
    if operator == 3: return 5
    if operator == 4: return 6
    if operator == 5: return 3
    if operator == 6: return 4
    return operator

shape YazaSqlLogicalOperatorV1:
    kind: Number
    input_index: Number
    table_id: Number
    expression_root: Number
    item_start: Number
    item_count: Number
    limit: Number

shape YazaSqlBoundPlanV1:
    version: Number
    catalog_version: Number
    table_id: Number
    right_table_id: Number
    left_column_count: Number
    right_column_count: Number
    join_left_column_ordinal: Number
    join_right_column_ordinal: Number
    join_comparison_operator: Number
    join_stages: List[YazaSqlBoundJoinStageV1]
    source: Text
    distinct: Boolean
    projections: List[YazaSqlBoundProjectionV1]
    group_by_columns: List[Number]
    order_by: List[YazaSqlBoundOrderTermV1]
    expressions: List[YazaSqlBoundExpressionNodeV1]
    subqueries: List[Text]
    subquery_parameter_ordinals: List[List[Number]]
    having_start_index: Number
    having_root: Number
    parameters: List[YazaSqlBoundParameterV1]
    operators: List[YazaSqlLogicalOperatorV1]
    where_root: Number
    root_operator: Number
    has_limit: Boolean
    limit: Number
    parameter_style: Number

fn yaza_sql_bind_v1_span_valid(source: Text, start_byte: Number, end_byte: Number) -> Boolean:
    return start_byte >= 0 and end_byte >= start_byte and end_byte <= text_length(source)

fn yaza_sql_bind_v1_token_valid(source: Text, token: YazaSqlTokenV1) -> Boolean:
    return token.kind > 0 and token.kind <= 8 and token.end_byte > token.start_byte and yaza_sql_bind_v1_span_valid(source, token.start_byte, token.end_byte)

fn yaza_sql_bind_v1_name_valid(source: Text, name: YazaSqlNameV2) -> Boolean:
    if name.wildcard:
        if not yaza_sql_bind_v1_span_valid(source, name.start_byte, name.end_byte): return false
        if name.part_count == 0:
            return name.end_byte - name.start_byte == 1 and text_byte(source, name.start_byte) == 42
        if name.part_count != 1 or not yaza_sql_bind_v1_token_valid(source, name.first_token): return false
        if name.start_byte != name.first_token.start_byte or text_byte(source, name.end_byte - 1) != 42: return false
        var offset: Number = name.first_token.end_byte
        var found_dot: Boolean = false
        while offset < name.end_byte - 1:
            let byte: Number = text_byte(source, offset)
            if byte == 46:
                if found_dot: return false
                set found_dot = true
            elif byte != 32 and byte != 9 and byte != 10 and byte != 13:
                return false
            set offset = offset + 1
        return found_dot
    if name.part_count < 1 or name.part_count > 3: return false
    if not yaza_sql_bind_v1_span_valid(source, name.start_byte, name.end_byte): return false
    if not yaza_sql_bind_v1_token_valid(source, name.first_token): return false
    if name.part_count >= 2 and not yaza_sql_bind_v1_token_valid(source, name.second_token): return false
    if name.part_count >= 3 and not yaza_sql_bind_v1_token_valid(source, name.third_token): return false
    return true

fn yaza_sql_bind_v1_identifier_matches(source: Text, token: YazaSqlTokenV1, expected: Text) -> Boolean:
    if not yaza_sql_bind_v1_token_valid(source, token): return false
    if token.kind != 1 and token.kind != 2: return false
    var source_offset: Number = token.start_byte
    var source_end: Number = token.end_byte
    if token.kind == 2:
        if source_end - source_offset < 2: return false
        if text_byte(source, source_offset) != 34 or text_byte(source, source_end - 1) != 34: return false
        set source_offset = source_offset + 1
        set source_end = source_end - 1

    var expected_offset: Number = 0
    var equal: Boolean = true
    while equal and source_offset < source_end and expected_offset < text_length(expected):
        var source_byte: Number = text_byte(source, source_offset)
        if token.kind == 2 and source_byte == 34 and source_offset + 1 < source_end and text_byte(source, source_offset + 1) == 34:
            set source_offset = source_offset + 1
        elif token.kind == 1 and source_byte >= 65 and source_byte <= 90:
            set source_byte = source_byte + 32
        if source_byte != text_byte(expected, expected_offset):
            set equal = false
        set source_offset = source_offset + 1
        set expected_offset = expected_offset + 1
    return equal and source_offset == source_end and expected_offset == text_length(expected)

fn yaza_sql_bind_v1_unquoted_identifier_value(source: Text, token: YazaSqlTokenV1) -> Result[Text, Text]:
    if token.kind != 1 or not yaza_sql_bind_v1_token_valid(source, token): return err("SQL binder expected a valid unquoted identifier token")
    let byte_count: Number = token.end_byte - token.start_byte
    if byte_count < 1 or byte_count > 128: return err("SQL binder unquoted identifier exceeds its 128-byte limit")
    let bytes_result: Result[Bytes, Text] = bytes_try_new_zeroed(byte_count)
    if not result_is_ok(bytes_result): return err("SQL binder could not normalize an unquoted identifier")
    let bytes: Bytes = result_unwrap(bytes_result)
    var offset: Number = 0
    while offset < byte_count:
        var byte: Number = text_byte(source, token.start_byte + offset)
        if byte >= 65 and byte <= 90: set byte = byte + 32
        if not bytes_try_set(bytes, offset, byte): return err("SQL binder could not normalize an unquoted identifier")
        set offset = offset + 1
    return bytes_try_to_text(bytes)

fn yaza_sql_bind_v1_name_token(name: YazaSqlNameV2) -> YazaSqlTokenV1:
    return name.first_token

fn yaza_sql_bind_v1_name_column(name: YazaSqlNameV2) -> YazaSqlTokenV1:
    if name.part_count == 1: return name.first_token
    if name.part_count == 2: return name.second_token
    return name.third_token

fn yaza_sql_bind_v1_error(source: Text, byte_offset: Number, message: Text) -> Text:
    let location_result: Result[YazaSqlSourceLocationV1, Text] = yaza_sql_v1_location(source, byte_offset)
    if not result_is_ok(location_result): return "YAZA Base binder could not locate diagnostic"
    let location: YazaSqlSourceLocationV1 = result_unwrap(location_result)
    let byte_text: Result[Text, Text] = number_try_text(byte_offset)
    let line_text: Result[Text, Text] = number_try_text(location.line)
    let column_text: Result[Text, Text] = number_try_text(location.column)
    if not result_is_ok(byte_text) or not result_is_ok(line_text) or not result_is_ok(column_text):
        return "YAZA Base binder could not allocate diagnostic"
    var result: Result[Text, Text] = text_try_concat(message, " at byte ")
    if not result_is_ok(result): return "YAZA Base binder could not allocate diagnostic"
    set result = text_try_concat(result_unwrap(result), result_unwrap(byte_text))
    if not result_is_ok(result): return "YAZA Base binder could not allocate diagnostic"
    set result = text_try_concat(result_unwrap(result), " (line ")
    if not result_is_ok(result): return "YAZA Base binder could not allocate diagnostic"
    set result = text_try_concat(result_unwrap(result), result_unwrap(line_text))
    if not result_is_ok(result): return "YAZA Base binder could not allocate diagnostic"
    set result = text_try_concat(result_unwrap(result), ", column ")
    if not result_is_ok(result): return "YAZA Base binder could not allocate diagnostic"
    set result = text_try_concat(result_unwrap(result), result_unwrap(column_text))
    if not result_is_ok(result): return "YAZA Base binder could not allocate diagnostic"
    set result = text_try_concat(result_unwrap(result), ")")
    if not result_is_ok(result): return "YAZA Base binder could not allocate diagnostic"
    return result_unwrap(result)

fn yaza_sql_bind_v1_keyword(source: Text, token: YazaSqlTokenV1, keyword: Text) -> Boolean:
    if not yaza_sql_bind_v1_token_valid(source, token): return false
    if token.kind != 1 or token.end_byte - token.start_byte != text_length(keyword): return false
    var offset: Number = 0
    while offset < text_length(keyword):
        var actual: Number = text_byte(source, token.start_byte + offset)
        let expected: Number = text_byte(keyword, offset)
        if actual >= 97 and actual <= 122: set actual = actual - 32
        if actual != expected: return false
        set offset = offset + 1
    return true

fn yaza_sql_bind_v1_resolve_column(source: Text, table: YazaSqlTableSchemaV1, name: YazaSqlNameV2) -> Result[YazaSqlColumnSchemaV1, Text]:
    if not yaza_sql_bind_v1_name_valid(source, name):
        return err("SQL binder received an invalid column name span")
    if name.wildcard:
        return err(yaza_sql_bind_v1_error(source, name.start_byte, "SQL binder wildcard is only valid as a projection"))
    if name.part_count != 1:
        return err(yaza_sql_bind_v1_error(source, name.start_byte, "SQL binder v1 supports unqualified column names only"))
    let token: YazaSqlTokenV1 = name.first_token
    var found: Boolean = false
    var resolved: YazaSqlColumnSchemaV1 = YazaSqlColumnSchemaV1("", 0, true, -1, 0, 0, "")
    var ordinal: Number = 0
    while ordinal < list_count(table.columns):
        let column: YazaSqlColumnSchemaV1 = list_get(table.columns, ordinal)
        if yaza_sql_bind_v1_identifier_matches(source, token, column.name):
            if found:
                return err(yaza_sql_bind_v1_error(source, name.start_byte, "SQL binder found an ambiguous column name"))
            set found = true
            set resolved = column
        set ordinal = ordinal + 1
    if not found:
        return err(yaza_sql_bind_v1_error(source, name.start_byte, "SQL binder could not resolve column"))
    return ok(resolved)

fn yaza_sql_bind_v1_identifier_tokens_match(source: Text, left: YazaSqlTokenV1, right: YazaSqlTokenV1) -> Boolean:
    if not yaza_sql_bind_v1_token_valid(source, left) or not yaza_sql_bind_v1_token_valid(source, right): return false
    if (left.kind != 1 and left.kind != 2) or (right.kind != 1 and right.kind != 2): return false
    var left_offset: Number = left.start_byte
    var left_end: Number = left.end_byte
    var right_offset: Number = right.start_byte
    var right_end: Number = right.end_byte
    if left.kind == 2:
        if left_end - left_offset < 2 or text_byte(source, left_offset) != 34 or text_byte(source, left_end - 1) != 34: return false
        set left_offset = left_offset + 1
        set left_end = left_end - 1
    if right.kind == 2:
        if right_end - right_offset < 2 or text_byte(source, right_offset) != 34 or text_byte(source, right_end - 1) != 34: return false
        set right_offset = right_offset + 1
        set right_end = right_end - 1
    var equal: Boolean = true
    while equal and left_offset < left_end and right_offset < right_end:
        var left_byte: Number = text_byte(source, left_offset)
        var right_byte: Number = text_byte(source, right_offset)
        if left.kind == 2 and left_byte == 34 and left_offset + 1 < left_end and text_byte(source, left_offset + 1) == 34: set left_offset = left_offset + 1
        elif left.kind == 1 and left_byte >= 65 and left_byte <= 90: set left_byte = left_byte + 32
        if right.kind == 2 and right_byte == 34 and right_offset + 1 < right_end and text_byte(source, right_offset + 1) == 34: set right_offset = right_offset + 1
        elif right.kind == 1 and right_byte >= 65 and right_byte <= 90: set right_byte = right_byte + 32
        if left_byte != right_byte: set equal = false
        set left_offset = left_offset + 1
        set right_offset = right_offset + 1
    return equal and left_offset == left_end and right_offset == right_end

fn yaza_sql_bind_v1_qualifier_matches(source: Text, table: YazaSqlTableSchemaV1, query: YazaSqlSelectAstV3, qualifier: YazaSqlTokenV1) -> Boolean:
    if not yaza_sql_bind_v1_token_valid(source, qualifier): return false
    if query.has_table_alias: return yaza_sql_bind_v1_identifier_tokens_match(source, qualifier, query.table_alias)
    return yaza_sql_bind_v1_identifier_matches(source, qualifier, table.name)

fn yaza_sql_bind_v1_right_qualifier_matches(source: Text, table: YazaSqlTableSchemaV1, query: YazaSqlSelectAstV3, qualifier: YazaSqlTokenV1) -> Boolean:
    if query.join_type == 0 or not yaza_sql_bind_v1_token_valid(source, qualifier): return false
    if query.has_join_table_alias: return yaza_sql_bind_v1_identifier_tokens_match(source, qualifier, query.join_table_alias)
    return yaza_sql_bind_v1_identifier_matches(source, qualifier, table.name)

fn yaza_sql_bind_v1_resolve_query_column(source: Text, table: YazaSqlTableSchemaV1, query: YazaSqlSelectAstV3, name: YazaSqlNameV2) -> Result[YazaSqlColumnSchemaV1, Text]:
    if not yaza_sql_bind_v1_name_valid(source, name): return err("SQL binder received an invalid column name span")
    if name.wildcard: return err(yaza_sql_bind_v1_error(source, name.start_byte, "SQL binder wildcard is only valid as a projection"))
    if name.part_count == 1: return yaza_sql_bind_v1_resolve_column(source, table, name)
    if name.part_count != 2: return err(yaza_sql_bind_v1_error(source, name.start_byte, "SQL binder supports one table qualifier and one column name"))
    if not yaza_sql_bind_v1_qualifier_matches(source, table, query, name.first_token):
        return err(yaza_sql_bind_v1_error(source, name.first_token.start_byte, "SQL binder column qualifier does not match the visible table name"))
    var found: Boolean = false
    var resolved: YazaSqlColumnSchemaV1 = YazaSqlColumnSchemaV1("", 0, true, -1, 0, 0, "")
    var ordinal: Number = 0
    while ordinal < list_count(table.columns):
        let column: YazaSqlColumnSchemaV1 = list_get(table.columns, ordinal)
        if yaza_sql_bind_v1_identifier_matches(source, name.second_token, column.name):
            if found: return err(yaza_sql_bind_v1_error(source, name.start_byte, "SQL binder found an ambiguous column name"))
            set found = true
            set resolved = column
        set ordinal = ordinal + 1
    if not found: return err(yaza_sql_bind_v1_error(source, name.second_token.start_byte, "SQL binder could not resolve column"))
    return ok(resolved)

fn yaza_sql_bind_v1_resolve_select_column(source: Text, table: YazaSqlTableSchemaV1, right_table: YazaSqlTableSchemaV1, query: YazaSqlSelectAstV3, name: YazaSqlNameV2) -> Result[YazaSqlColumnSchemaV1, Text]:
    if query.join_type == 0: return yaza_sql_bind_v1_resolve_query_column(source, table, query, name)
    if not yaza_sql_bind_v1_name_valid(source, name): return err("SQL binder received an invalid joined column name span")
    if name.wildcard: return err(yaza_sql_bind_v1_error(source, name.start_byte, "SQL binder wildcard is only valid as a projection"))
    if name.part_count != 1 and name.part_count != 2:
        return err(yaza_sql_bind_v1_error(source, name.start_byte, "SQL binder JOIN supports one optional table qualifier and one column name"))
    var search_left: Boolean = name.part_count == 1
    var search_right: Boolean = name.part_count == 1
    var column_token: YazaSqlTokenV1 = name.first_token
    if name.part_count == 2:
        let left_qualified: Boolean = yaza_sql_bind_v1_qualifier_matches(source, table, query, name.first_token)
        let right_qualified: Boolean = yaza_sql_bind_v1_right_qualifier_matches(source, right_table, query, name.first_token)
        if not left_qualified and not right_qualified:
            return err(yaza_sql_bind_v1_error(source, name.first_token.start_byte, "SQL binder column qualifier does not match either visible joined table"))
        if left_qualified and right_qualified:
            return err(yaza_sql_bind_v1_error(source, name.first_token.start_byte, "SQL binder found an ambiguous joined table qualifier"))
        set search_left = left_qualified
        set search_right = right_qualified
        set column_token = name.second_token

    var found: Boolean = false
    var resolved: YazaSqlColumnSchemaV1 = YazaSqlColumnSchemaV1("", 0, true, -1, 0, 0, "")
    if search_left:
        var left_index: Number = 0
        while left_index < list_count(table.columns):
            let column: YazaSqlColumnSchemaV1 = list_get(table.columns, left_index)
            if yaza_sql_bind_v1_identifier_matches(source, column_token, column.name):
                if found: return err(yaza_sql_bind_v1_error(source, name.start_byte, "SQL binder found an ambiguous joined column name"))
                set found = true
                set resolved = column
            set left_index = left_index + 1
    if search_right:
        var right_index: Number = 0
        while right_index < list_count(right_table.columns):
            let column: YazaSqlColumnSchemaV1 = list_get(right_table.columns, right_index)
            if yaza_sql_bind_v1_identifier_matches(source, column_token, column.name):
                if found: return err(yaza_sql_bind_v1_error(source, name.start_byte, "SQL binder found an ambiguous joined column name"))
                set found = true
                set resolved = YazaSqlColumnSchemaV1(column.name, column.type_id, column.nullable, list_count(table.columns) + column.ordinal, column.precision, column.scale, column.default_expression)
            set right_index = right_index + 1
    if not found: return err(yaza_sql_bind_v1_error(source, column_token.start_byte, "SQL binder could not resolve joined column"))
    return ok(resolved)

fn yaza_sql_bind_v1_visible_source_qualifier_matches(source: Text, visible: YazaSqlVisibleSourceV1, qualifier: YazaSqlTokenV1) -> Boolean:
    if not yaza_sql_bind_v1_token_valid(source, qualifier): return false
    if visible.has_alias: return yaza_sql_bind_v1_identifier_tokens_match(source, qualifier, visible.alias)
    return yaza_sql_bind_v1_identifier_matches(source, qualifier, visible.table.name)

fn yaza_sql_bind_v1_resolve_source_column(source: Text, visible_sources: List[YazaSqlVisibleSourceV1], name: YazaSqlNameV2) -> Result[YazaSqlColumnSchemaV1, Text]:
    if not yaza_sql_bind_v1_name_valid(source, name): return err("SQL binder received an invalid multi-table column span")
    if name.wildcard: return err(yaza_sql_bind_v1_error(source, name.start_byte, "SQL binder wildcard is only valid as a projection"))
    if name.part_count != 1 and name.part_count != 2:
        return err(yaza_sql_bind_v1_error(source, name.start_byte, "SQL binder supports one visible table qualifier and one column name"))
    var selected_source: Number = -1
    var column_token: YazaSqlTokenV1 = name.first_token
    if name.part_count == 2:
        var qualifier_matches: Number = 0
        var source_index: Number = 0
        while source_index < list_count(visible_sources):
            if yaza_sql_bind_v1_visible_source_qualifier_matches(source, list_get(visible_sources, source_index), name.first_token):
                set selected_source = source_index
                set qualifier_matches = qualifier_matches + 1
            set source_index = source_index + 1
        if qualifier_matches == 0:
            return err(yaza_sql_bind_v1_error(source, name.first_token.start_byte, "SQL binder column qualifier does not match a visible table"))
        if qualifier_matches > 1:
            return err(yaza_sql_bind_v1_error(source, name.first_token.start_byte, "SQL binder found an ambiguous table qualifier"))
        set column_token = name.second_token

    var found: Boolean = false
    var resolved: YazaSqlColumnSchemaV1 = YazaSqlColumnSchemaV1("", 0, true, -1, 0, 0, "")
    var source_index: Number = 0
    while source_index < list_count(visible_sources):
        if name.part_count == 1 or source_index == selected_source:
            let visible: YazaSqlVisibleSourceV1 = list_get(visible_sources, source_index)
            var column_index: Number = 0
            while column_index < list_count(visible.table.columns):
                let column: YazaSqlColumnSchemaV1 = list_get(visible.table.columns, column_index)
                if yaza_sql_bind_v1_identifier_matches(source, column_token, column.name):
                    if found: return err(yaza_sql_bind_v1_error(source, name.start_byte, "SQL binder found an ambiguous multi-table column name"))
                    set found = true
                    set resolved = YazaSqlColumnSchemaV1(column.name, column.type_id, column.nullable, visible.column_offset + column.ordinal, column.precision, column.scale, column.default_expression)
                set column_index = column_index + 1
        set source_index = source_index + 1
    if not found: return err(yaza_sql_bind_v1_error(source, column_token.start_byte, "SQL binder could not resolve multi-table column"))
    return ok(resolved)

fn yaza_sql_bind_v1_identifier_tokens_match_across_sources(left_source: Text, left: YazaSqlTokenV1, right_source: Text, right: YazaSqlTokenV1) -> Boolean:
    if not yaza_sql_bind_v1_token_valid(left_source, left) or not yaza_sql_bind_v1_token_valid(right_source, right): return false
    if (left.kind != 1 and left.kind != 2) or (right.kind != 1 and right.kind != 2): return false
    var left_offset: Number = left.start_byte
    var left_end: Number = left.end_byte
    var right_offset: Number = right.start_byte
    var right_end: Number = right.end_byte
    if left.kind == 2:
        if left_end - left_offset < 2 or text_byte(left_source, left_offset) != 34 or text_byte(left_source, left_end - 1) != 34: return false
        set left_offset = left_offset + 1
        set left_end = left_end - 1
    if right.kind == 2:
        if right_end - right_offset < 2 or text_byte(right_source, right_offset) != 34 or text_byte(right_source, right_end - 1) != 34: return false
        set right_offset = right_offset + 1
        set right_end = right_end - 1
    var equal: Boolean = true
    while equal and left_offset < left_end and right_offset < right_end:
        var left_byte: Number = text_byte(left_source, left_offset)
        var right_byte: Number = text_byte(right_source, right_offset)
        if left.kind == 2 and left_byte == 34 and left_offset + 1 < left_end and text_byte(left_source, left_offset + 1) == 34: set left_offset = left_offset + 1
        elif left.kind == 1 and left_byte >= 65 and left_byte <= 90: set left_byte = left_byte + 32
        if right.kind == 2 and right_byte == 34 and right_offset + 1 < right_end and text_byte(right_source, right_offset + 1) == 34: set right_offset = right_offset + 1
        elif right.kind == 1 and right_byte >= 65 and right_byte <= 90: set right_byte = right_byte + 32
        if left_byte != right_byte: set equal = false
        set left_offset = left_offset + 1
        set right_offset = right_offset + 1
    return equal and left_offset == left_end and right_offset == right_end

fn yaza_sql_bind_v1_resolve_outer_reference(parent_source: Text, nested_source: Text, outer_sources: List[YazaSqlVisibleSourceV1], name: YazaSqlNameV2) -> Result[YazaSqlColumnSchemaV1, Text]:
    if not yaza_sql_bind_v1_name_valid(nested_source, name) or name.wildcard or name.part_count != 2:
        return err("SQL binder correlated references must qualify an outer column with its visible table or alias")
    var selected_source: Number = -1
    var qualifier_matches: Number = 0
    var source_index: Number = 0
    while source_index < list_count(outer_sources):
        let visible: YazaSqlVisibleSourceV1 = list_get(outer_sources, source_index)
        var matches: Boolean = false
        if visible.has_alias:
            set matches = yaza_sql_bind_v1_identifier_tokens_match_across_sources(nested_source, name.first_token, parent_source, visible.alias)
        else:
            set matches = yaza_sql_bind_v1_identifier_matches(nested_source, name.first_token, visible.table.name)
        if matches:
            set selected_source = source_index
            set qualifier_matches = qualifier_matches + 1
        set source_index = source_index + 1
    if qualifier_matches == 0: return err("SQL binder correlated column qualifier does not match an outer table")
    if qualifier_matches > 1: return err("SQL binder found an ambiguous correlated table qualifier")
    let selected: YazaSqlVisibleSourceV1 = list_get(outer_sources, selected_source)
    var found: Boolean = false
    var resolved: YazaSqlColumnSchemaV1 = YazaSqlColumnSchemaV1("", 0, true, -1, 0, 0, "")
    var column_index: Number = 0
    while column_index < list_count(selected.table.columns):
        let candidate: YazaSqlColumnSchemaV1 = list_get(selected.table.columns, column_index)
        if yaza_sql_bind_v1_identifier_matches(nested_source, name.second_token, candidate.name):
            if found: return err("SQL binder found an ambiguous correlated column name")
            set found = true
            set resolved = YazaSqlColumnSchemaV1(candidate.name, candidate.type_id, candidate.nullable, selected.column_offset + candidate.ordinal, candidate.precision, candidate.scale, candidate.default_expression)
        set column_index = column_index + 1
    if not found: return err("SQL binder could not resolve correlated outer column")
    return ok(resolved)

fn yaza_sql_bind_v1_correlated_exists(parent_source: Text, nested_source: Text, nested_query: YazaSqlSelectAstV3, catalog: YazaSqlCatalogSnapshotV1, outer_sources: List[YazaSqlVisibleSourceV1], include_projection: Boolean) -> Result[YazaSqlCorrelatedExistsBindingV1, Text]:
    if list_count(outer_sources) != 1:
        return err("SQL binder first correlated EXISTS profile requires one outer table and no outer JOINs")
    if nested_query.join_type != 0 or list_count(nested_query.additional_joins) != 0 or list_count(nested_query.group_by) != 0 or nested_query.has_having or list_count(nested_query.order_by) != 0 or nested_query.has_limit:
        return err("SQL binder first correlated EXISTS profile requires a single inner table without grouping, ordering, or LIMIT")
    if list_count(nested_query.where_nodes) == 0 or nested_query.where_root < 0 or nested_query.where_root >= list_count(nested_query.where_nodes):
        return err("SQL binder correlated EXISTS requires a valid WHERE correlation predicate")
    var correlation: YazaSqlExpressionNodeV3 = list_get(nested_query.where_nodes, nested_query.where_root)
    var local_predicate: YazaSqlExpressionNodeV3 = correlation
    var has_local_predicate: Boolean = false
    if list_count(nested_query.where_nodes) == 1 and nested_query.where_root == 0:
        set correlation = list_get(nested_query.where_nodes, 0)
    elif list_count(nested_query.where_nodes) == 3:
        if correlation.kind != 2 or correlation.left_index < 0 or correlation.left_index >= list_count(nested_query.where_nodes) or correlation.right_index < 0 or correlation.right_index >= list_count(nested_query.where_nodes):
            return err("SQL binder correlated EXISTS permits one local predicate joined with AND")
        let left_predicate: YazaSqlExpressionNodeV3 = list_get(nested_query.where_nodes, correlation.left_index)
        let right_predicate: YazaSqlExpressionNodeV3 = list_get(nested_query.where_nodes, correlation.right_index)
        if left_predicate.kind == 8 and right_predicate.kind == 1:
            set correlation = left_predicate
            set local_predicate = right_predicate
            set has_local_predicate = true
        elif right_predicate.kind == 8 and left_predicate.kind == 1:
            set correlation = right_predicate
            set local_predicate = left_predicate
            set has_local_predicate = true
        else:
            return err("SQL binder correlated EXISTS requires one outer equality and one inner-local comparison")
    else:
        return err("SQL binder correlated EXISTS permits one direct equality or one equality plus one local AND predicate")
    if correlation.kind != 8 or correlation.operator != 1 or correlation.aggregate_kind != 0:
        return err("SQL binder first correlated EXISTS profile requires a typed column equality predicate")
    if not yaza_sql_bind_v1_name_valid(nested_source, nested_query.table_name) or nested_query.table_name.part_count != 1:
        return err("SQL binder correlated EXISTS inner table name is invalid")
    var inner_table_index: Number = -1
    var catalog_index: Number = 0
    while catalog_index < list_count(catalog.tables):
        if yaza_sql_bind_v1_identifier_matches(nested_source, nested_query.table_name.first_token, list_get(catalog.tables, catalog_index).name):
            if inner_table_index >= 0: return err("SQL binder found an ambiguous correlated EXISTS inner table")
            set inner_table_index = catalog_index
        set catalog_index = catalog_index + 1
    if inner_table_index < 0: return err("SQL binder could not resolve correlated EXISTS inner table")
    let inner_table: YazaSqlTableSchemaV1 = list_get(catalog.tables, inner_table_index)
    if list_count(inner_table.columns) == 0 or list_count(inner_table.columns) > 1024:
        return err("SQL binder correlated EXISTS inner schema exceeds its column bound")
    if nested_query.has_table_alias and (not yaza_sql_bind_v1_token_valid(nested_source, nested_query.table_alias) or (nested_query.table_alias.kind != 1 and nested_query.table_alias.kind != 2)):
        return err("SQL binder correlated EXISTS inner alias is invalid")
    let inner_sources_result: Result[List[YazaSqlVisibleSourceV1], Text] = list_try_new()
    if not result_is_ok(inner_sources_result): return err("SQL binder could not allocate correlated EXISTS inner scope")
    let inner_sources: List[YazaSqlVisibleSourceV1] = result_unwrap(inner_sources_result)
    if not list_try_push(inner_sources, YazaSqlVisibleSourceV1(inner_table, nested_query.has_table_alias, nested_query.table_alias, 0)):
        return err("SQL binder could not initialize correlated EXISTS inner scope")
    var local_column: YazaSqlColumnSchemaV1 = YazaSqlColumnSchemaV1("", 0, true, -1, 0, 0, "")
    if has_local_predicate:
        if local_predicate.kind != 1 or local_predicate.aggregate_kind != 0 or local_predicate.operator < 1 or local_predicate.operator > 6:
            return err("SQL binder correlated EXISTS local predicate must be a scalar comparison")
        if not yaza_sql_bind_v1_name_valid(nested_source, local_predicate.column) or not yaza_sql_bind_v1_token_valid(nested_source, local_predicate.value):
            return err("SQL binder correlated EXISTS local predicate has an invalid identifier or value span")
        let local_column_result: Result[YazaSqlColumnSchemaV1, Text] = yaza_sql_bind_v1_resolve_source_column(nested_source, inner_sources, local_predicate.column)
        if not result_is_ok(local_column_result): return err(result_unwrap_error(local_column_result))
        set local_column = result_unwrap(local_column_result)
        if not yaza_sql_bind_v1_comparison_valid(local_column.type_id, local_predicate.operator):
            return err("SQL binder correlated EXISTS local comparison operator is invalid for its inner column")
        if local_predicate.value.kind != 5 and not yaza_sql_bind_v1_keyword(nested_source, local_predicate.value, "NULL") and not yaza_sql_bind_v1_value_compatible(nested_source, local_predicate.value, local_column.type_id, local_column.precision, local_column.scale):
            return err("SQL binder correlated EXISTS local comparison value does not match its inner column")

    if correlation.column.part_count != 2 or correlation.right_column.part_count != 2:
        return err("SQL binder correlated EXISTS comparison must qualify both columns")
    let left_inner: Result[YazaSqlColumnSchemaV1, Text] = yaza_sql_bind_v1_resolve_source_column(nested_source, inner_sources, correlation.column)
    let left_outer: Result[YazaSqlColumnSchemaV1, Text] = yaza_sql_bind_v1_resolve_outer_reference(parent_source, nested_source, outer_sources, correlation.column)
    let right_inner: Result[YazaSqlColumnSchemaV1, Text] = yaza_sql_bind_v1_resolve_source_column(nested_source, inner_sources, correlation.right_column)
    let right_outer: Result[YazaSqlColumnSchemaV1, Text] = yaza_sql_bind_v1_resolve_outer_reference(parent_source, nested_source, outer_sources, correlation.right_column)
    var outer_column: YazaSqlColumnSchemaV1 = YazaSqlColumnSchemaV1("", 0, true, -1, 0, 0, "")
    var outer_name: YazaSqlNameV2 = correlation.column
    var inner_name: YazaSqlNameV2 = correlation.column
    var inner_column: YazaSqlColumnSchemaV1 = YazaSqlColumnSchemaV1("", 0, true, -1, 0, 0, "")
    var resolved_pair: Boolean = false
    if result_is_ok(left_inner) and result_is_ok(right_outer):
        set inner_column = result_unwrap(left_inner)
        set outer_column = result_unwrap(right_outer)
        set outer_name = correlation.right_column
        set inner_name = correlation.column
        set resolved_pair = true
    elif result_is_ok(right_inner) and result_is_ok(left_outer):
        set inner_column = result_unwrap(right_inner)
        set outer_column = result_unwrap(left_outer)
        set outer_name = correlation.column
        set inner_name = correlation.right_column
        set resolved_pair = true
    if not resolved_pair:
        return err("SQL binder correlated EXISTS equality must pair one inner column with one visible outer column")
    if inner_column.type_id != outer_column.type_id or inner_column.precision != outer_column.precision or inner_column.scale != outer_column.scale:
        return err("SQL binder correlated EXISTS columns must have identical SQL types and DECIMAL metadata")
    var output_column: YazaSqlColumnSchemaV1 = inner_column
    var output_name: YazaSqlNameV2 = inner_name
    if include_projection:
        if list_count(nested_query.projections) != 1:
            return err("SQL binder correlated IN requires exactly one projected column")
        let requested_projection: YazaSqlProjectionV2 = list_get(nested_query.projections, 0)
        if requested_projection.aggregate_kind != 0 or requested_projection.name.wildcard or not yaza_sql_bind_v1_name_valid(nested_source, requested_projection.name):
            return err("SQL binder correlated IN requires one direct inner-column projection")
        let resolved_output: Result[YazaSqlColumnSchemaV1, Text] = yaza_sql_bind_v1_resolve_source_column(nested_source, inner_sources, requested_projection.name)
        if not result_is_ok(resolved_output): return err(result_unwrap_error(resolved_output))
        set output_column = result_unwrap(resolved_output)
        set output_name = requested_projection.name
    var projection_index: Number = 0
    while projection_index < list_count(nested_query.projections):
        if list_get(nested_query.projections, projection_index).aggregate_kind != 0:
            return err("SQL binder first correlated EXISTS profile does not support aggregate projections")
        set projection_index = projection_index + 1
    let inner_expression_result: Result[Text, Text] = text_try_slice(nested_source, inner_name.start_byte, inner_name.end_byte - inner_name.start_byte)
    let output_expression_result: Result[Text, Text] = text_try_slice(nested_source, output_name.start_byte, output_name.end_byte - output_name.start_byte)
    let inner_table_result: Result[Text, Text] = text_try_slice(nested_source, nested_query.table_name.start_byte, nested_query.table_name.end_byte - nested_query.table_name.start_byte)
    if not result_is_ok(inner_expression_result) or not result_is_ok(output_expression_result) or not result_is_ok(inner_table_result): return err("SQL binder could not read correlated subquery source identifiers")
    var scan_source_result: Result[Text, Text] = text_try_concat("SELECT ", result_unwrap(inner_expression_result))
    if not result_is_ok(scan_source_result): return err("SQL binder could not build correlated EXISTS scan projection")
    if include_projection:
        set scan_source_result = text_try_concat(result_unwrap(scan_source_result), ", ")
        if not result_is_ok(scan_source_result): return err("SQL binder could not add correlated IN value projection")
        set scan_source_result = text_try_concat(result_unwrap(scan_source_result), result_unwrap(output_expression_result))
        if not result_is_ok(scan_source_result): return err("SQL binder could not complete correlated IN value projection")
    set scan_source_result = text_try_concat(result_unwrap(scan_source_result), " FROM ")
    if not result_is_ok(scan_source_result): return err("SQL binder could not build correlated EXISTS scan source")
    set scan_source_result = text_try_concat(result_unwrap(scan_source_result), result_unwrap(inner_table_result))
    if not result_is_ok(scan_source_result): return err("SQL binder could not build correlated EXISTS table reference")
    if nested_query.has_table_alias:
        let alias_result: Result[Text, Text] = text_try_slice(nested_source, nested_query.table_alias.start_byte, nested_query.table_alias.end_byte - nested_query.table_alias.start_byte)
        if not result_is_ok(alias_result): return err("SQL binder could not read correlated EXISTS table alias")
        set scan_source_result = text_try_concat(result_unwrap(scan_source_result), " AS ")
        if not result_is_ok(scan_source_result): return err("SQL binder could not build correlated EXISTS alias")
        set scan_source_result = text_try_concat(result_unwrap(scan_source_result), result_unwrap(alias_result))
        if not result_is_ok(scan_source_result): return err("SQL binder could not complete correlated EXISTS alias")
    if has_local_predicate:
        let local_source_result: Result[Text, Text] = text_try_slice(nested_source, local_predicate.start_byte, local_predicate.end_byte - local_predicate.start_byte)
        if not result_is_ok(local_source_result): return err("SQL binder could not read correlated EXISTS local predicate")
        set scan_source_result = text_try_concat(result_unwrap(scan_source_result), " WHERE ")
        if not result_is_ok(scan_source_result): return err("SQL binder could not add correlated EXISTS local predicate")
        set scan_source_result = text_try_concat(result_unwrap(scan_source_result), result_unwrap(local_source_result))
        if not result_is_ok(scan_source_result): return err("SQL binder could not complete correlated EXISTS local predicate")
    set scan_source_result = text_try_concat(result_unwrap(scan_source_result), " ORDER BY ")
    if not result_is_ok(scan_source_result): return err("SQL binder could not add correlated EXISTS ordering")
    set scan_source_result = text_try_concat(result_unwrap(scan_source_result), result_unwrap(inner_expression_result))
    if not result_is_ok(scan_source_result): return err("SQL binder could not complete correlated EXISTS key scan")
    if include_projection:
        set scan_source_result = text_try_concat(result_unwrap(scan_source_result), ", ")
        if not result_is_ok(scan_source_result): return err("SQL binder could not add correlated IN value ordering")
        set scan_source_result = text_try_concat(result_unwrap(scan_source_result), result_unwrap(output_expression_result))
        if not result_is_ok(scan_source_result): return err("SQL binder could not complete correlated IN pair ordering")
    var output_type_id: Number = 0
    var output_precision: Number = 0
    var output_scale: Number = 0
    if include_projection:
        set output_type_id = output_column.type_id
        set output_precision = output_column.precision
        set output_scale = output_column.scale
    return ok(YazaSqlCorrelatedExistsBindingV1(result_unwrap(scan_source_result), outer_column.ordinal, outer_column.type_id, outer_column.precision, outer_column.scale, output_type_id, output_precision, output_scale))

fn yaza_sql_bind_v1_source_wildcard_target(source: Text, visible_sources: List[YazaSqlVisibleSourceV1], name: YazaSqlNameV2) -> Number:
    if not name.wildcard or not yaza_sql_bind_v1_name_valid(source, name): return -1
    if name.part_count == 0: return -2
    if name.part_count != 1: return -1
    var selected_source: Number = -1
    var qualifier_matches: Number = 0
    var source_index: Number = 0
    while source_index < list_count(visible_sources):
        if yaza_sql_bind_v1_visible_source_qualifier_matches(source, list_get(visible_sources, source_index), name.first_token):
            set selected_source = source_index
            set qualifier_matches = qualifier_matches + 1
        set source_index = source_index + 1
    if qualifier_matches != 1: return -1
    return selected_source

fn yaza_sql_bind_v1_source_nullable(query: YazaSqlSelectAstV3, source_index: Number, original_nullable: Boolean) -> Boolean:
    if original_nullable: return true
    if query.join_type == 4: return true
    if query.join_type == 2 and source_index == 1: return true
    if query.join_type == 3 and source_index == 0: return true
    var stage_index: Number = 0
    while stage_index < list_count(query.additional_joins):
        let stage: YazaSqlAdditionalJoinV3 = list_get(query.additional_joins, stage_index)
        let added_source_index: Number = stage_index + 2
        if stage.join_type == 2 and source_index == added_source_index: return true
        if stage.join_type == 3 and source_index < added_source_index: return true
        if stage.join_type == 4 and source_index <= added_source_index: return true
        set stage_index = stage_index + 1
    return false

fn yaza_sql_bind_v1_wildcard_target(source: Text, table: YazaSqlTableSchemaV1, right_table: YazaSqlTableSchemaV1, query: YazaSqlSelectAstV3, name: YazaSqlNameV2) -> Number:
    if not name.wildcard or not yaza_sql_bind_v1_name_valid(source, name): return -1
    if name.part_count == 0: return 0
    if name.part_count != 1: return -1
    let left_qualified: Boolean = yaza_sql_bind_v1_qualifier_matches(source, table, query, name.first_token)
    let right_qualified: Boolean = yaza_sql_bind_v1_right_qualifier_matches(source, right_table, query, name.first_token)
    if left_qualified and right_qualified: return -1
    if left_qualified: return 1
    if right_qualified: return 2
    return -1

fn yaza_sql_bind_v1_wildcard_qualifier_valid(source: Text, table: YazaSqlTableSchemaV1, query: YazaSqlSelectAstV3, name: YazaSqlNameV2) -> Boolean:
    if not name.wildcard or not yaza_sql_bind_v1_name_valid(source, name): return false
    if name.part_count == 0: return true
    return yaza_sql_bind_v1_qualifier_matches(source, table, query, name.first_token)

fn yaza_sql_bind_v1_resolve_output_projection(source: Text, projections: List[YazaSqlBoundProjectionV1], name: YazaSqlNameV2) -> Result[Number, Text]:
    if not yaza_sql_bind_v1_name_valid(source, name): return err("SQL binder received an invalid HAVING output name span")
    if name.wildcard or name.part_count != 1:
        return err(yaza_sql_bind_v1_error(source, name.start_byte, "SQL binder HAVING requires an unqualified projected output name"))
    var found_projection: Number = -1
    var projection_index: Number = 0
    while projection_index < list_count(projections):
        let projection: YazaSqlBoundProjectionV1 = list_get(projections, projection_index)
        if yaza_sql_bind_v1_identifier_matches(source, name.first_token, projection.output_name):
            if found_projection >= 0:
                return err(yaza_sql_bind_v1_error(source, name.start_byte, "SQL binder found an ambiguous HAVING output name"))
            set found_projection = projection_index
        set projection_index = projection_index + 1
    if found_projection < 0:
        return err(yaza_sql_bind_v1_error(source, name.start_byte, "SQL binder HAVING name must refer to a projected output"))
    return ok(found_projection)

fn yaza_sql_bind_v1_resolve_having_aggregate_projection(source: Text, projections: List[YazaSqlBoundProjectionV1], visible_sources: List[YazaSqlVisibleSourceV1], aggregate_kind: Number, name: YazaSqlNameV2) -> Result[Number, Text]:
    if aggregate_kind < 1 or aggregate_kind > 5:
        return err("SQL binder received an invalid HAVING aggregate kind")
    var source_ordinal: Number = -1
    if aggregate_kind != 1:
        if not yaza_sql_bind_v1_name_valid(source, name): return err("SQL binder received an invalid HAVING aggregate column")
        let column_result: Result[YazaSqlColumnSchemaV1, Text] = yaza_sql_bind_v1_resolve_source_column(source, visible_sources, name)
        if not result_is_ok(column_result): return err(result_unwrap_error(column_result))
        set source_ordinal = result_unwrap(column_result).ordinal
    var projection_index: Number = 0
    while projection_index < list_count(projections):
        let projection: YazaSqlBoundProjectionV1 = list_get(projections, projection_index)
        if projection.aggregate_kind == aggregate_kind and (aggregate_kind == 1 or projection.column_ordinal == source_ordinal):
            return ok(projection_index)
        set projection_index = projection_index + 1
    return err("SQL binder HAVING aggregate must match a projected aggregate")

fn yaza_sql_bind_v1_numeric_type(type_id: Number) -> Boolean:
    return (type_id >= 2 and type_id <= 7) or type_id == 10

fn yaza_sql_bind_v1_type_name_supported(type_id: Number) -> Boolean:
    return type_id == 1 or type_id == 2 or type_id == 3 or type_id == 4 or type_id == 6 or type_id == 9 or type_id == 10 or type_id == 11 or type_id == 12 or type_id == 13 or type_id == 14 or type_id == 15 or type_id == 16

fn yaza_sql_bind_v1_comparison_valid(type_id: Number, operator: Number) -> Boolean:
    if operator == 1 or operator == 2:
        return yaza_sql_bind_v1_type_name_supported(type_id)
    if operator >= 7 and operator <= 10:
        return type_id == 9
    if yaza_sql_bind_v1_numeric_type(type_id) or type_id == 9 or type_id == 11 or type_id == 12 or type_id == 13 or type_id == 14 or type_id == 15 or type_id == 16:
        return operator >= 3 and operator <= 6
    return false

fn yaza_sql_bind_v1_positional_index(source: Text, token: YazaSqlTokenV1) -> Number:
    if token.end_byte - token.start_byte < 2: return -1
    if text_byte(source, token.start_byte) != 36: return -1
    if text_byte(source, token.start_byte + 1) == 48: return -1
    var offset: Number = token.start_byte + 1
    var value: Number = 0
    while offset < token.end_byte:
        let byte: Number = text_byte(source, offset)
        if byte < 48 or byte > 57: return -1
        let digit: Number = byte - 48
        if value > 4095: return -1
        set value = value * 10 + digit
        if value > 4096: return -1
        set offset = offset + 1
    if value < 1: return -1
    return value - 1

fn yaza_sql_bind_v1_find_number(values: List[Number], requested: Number) -> Number:
    var index: Number = 0
    while index < list_count(values):
        if list_get(values, index) == requested: return index
        set index = index + 1
    return -1

fn yaza_sql_bind_v1_normalize_subquery_positional_parameters(source: Text) -> Result[YazaSqlSubquerySourceMappingV1, Text]:
    let empty_ordinals_result: Result[List[Number], Text] = list_try_new()
    if not result_is_ok(empty_ordinals_result): return err("SQL binder could not allocate nested positional parameter mapping")
    let empty_ordinals: List[Number] = result_unwrap(empty_ordinals_result)
    let tokens_result: Result[List[YazaSqlTokenV1], Text] = yaza_sql_lex_v1(source)
    if not result_is_ok(tokens_result): return err(result_unwrap_error(tokens_result))
    let tokens: List[YazaSqlTokenV1] = result_unwrap(tokens_result)
    var parameter_style: Number = 0
    var has_mixed_styles: Boolean = false
    var has_positional: Boolean = false
    var positional_ordinals_result: Result[List[Number], Text] = list_try_new()
    if not result_is_ok(positional_ordinals_result): return err("SQL binder could not allocate nested positional parameter ordinals")
    let positional_ordinals: List[Number] = result_unwrap(positional_ordinals_result)
    if not list_try_reserve(positional_ordinals, 4096): return err("SQL binder could not reserve nested positional parameter ordinals")
    var token_index: Number = 0
    while token_index < list_count(tokens):
        let token: YazaSqlTokenV1 = list_get(tokens, token_index)
        if token.kind == 5:
            let first_byte: Number = text_byte(source, token.start_byte)
            var token_style: Number = 0
            if first_byte == 63: set token_style = 1
            elif first_byte == 36:
                set token_style = 2
                set has_positional = true
                let positional_index: Number = yaza_sql_bind_v1_positional_index(source, token)
                if positional_index < 0: return err(yaza_sql_bind_v1_error(source, token.start_byte, "SQL binder positional parameters must be numbered from $1 through $4096"))
                if yaza_sql_bind_v1_find_number(positional_ordinals, positional_index) < 0:
                    if list_count(positional_ordinals) >= 4096 or not list_try_push(positional_ordinals, positional_index):
                        return err(yaza_sql_bind_v1_error(source, token.start_byte, "SQL subquery exceeds the 4096 positional bind limit"))
            elif first_byte == 58: set token_style = 3
            else: return err(yaza_sql_bind_v1_error(source, token.start_byte, "SQL binder does not recognize this parameter style"))
            if parameter_style != 0 and parameter_style != token_style:
                set has_mixed_styles = true
            set parameter_style = token_style
        set token_index = token_index + 1
    if not has_positional or has_mixed_styles:
        return ok(YazaSqlSubquerySourceMappingV1(source, empty_ordinals))
    var normalized_source: Text = ""
    var source_cursor: Number = 0
    set token_index = 0
    while token_index < list_count(tokens):
        let token: YazaSqlTokenV1 = list_get(tokens, token_index)
        if token.kind == 5 and text_byte(source, token.start_byte) == 36:
            let positional_index: Number = yaza_sql_bind_v1_positional_index(source, token)
            let local_index: Number = yaza_sql_bind_v1_find_number(positional_ordinals, positional_index)
            if local_index < 0: return err("SQL binder lost a nested positional parameter while normalizing")
            if token.start_byte < source_cursor or token.end_byte <= token.start_byte or token.end_byte > text_length(source):
                return err("SQL binder received overlapping nested positional parameter spans")
            if token.start_byte > source_cursor:
                let prefix_result: Result[Text, Text] = text_try_slice(source, source_cursor, token.start_byte - source_cursor)
                if not result_is_ok(prefix_result): return err("SQL binder could not preserve nested SQL while remapping positional parameters")
                let prefix_append_result: Result[Text, Text] = text_try_concat(normalized_source, result_unwrap(prefix_result))
                if not result_is_ok(prefix_append_result): return err("SQL binder could not rebuild nested SQL while remapping positional parameters")
                set normalized_source = result_unwrap(prefix_append_result)
            let local_number_result: Result[Text, Text] = number_try_text(local_index + 1)
            if not result_is_ok(local_number_result): return err("SQL binder could not format a normalized nested parameter ordinal")
            let local_token_result: Result[Text, Text] = text_try_concat("$", result_unwrap(local_number_result))
            if not result_is_ok(local_token_result): return err("SQL binder could not format a normalized nested parameter token")
            let token_append_result: Result[Text, Text] = text_try_concat(normalized_source, result_unwrap(local_token_result))
            if not result_is_ok(token_append_result): return err("SQL binder could not rebuild nested SQL while remapping positional parameters")
            set normalized_source = result_unwrap(token_append_result)
            set source_cursor = token.end_byte
        set token_index = token_index + 1
    if source_cursor < text_length(source):
        let suffix_result: Result[Text, Text] = text_try_slice(source, source_cursor, text_length(source) - source_cursor)
        if not result_is_ok(suffix_result): return err("SQL binder could not preserve the end of nested SQL while remapping positional parameters")
        let suffix_append_result: Result[Text, Text] = text_try_concat(normalized_source, result_unwrap(suffix_result))
        if not result_is_ok(suffix_append_result): return err("SQL binder could not finish rebuilding nested SQL with remapped positional parameters")
        set normalized_source = result_unwrap(suffix_append_result)
    return ok(YazaSqlSubquerySourceMappingV1(normalized_source, positional_ordinals))

fn yaza_sql_bind_v1_find_parameter(parameters: List[YazaSqlBoundParameterV1], key: Text) -> Number:
    var ordinal: Number = 0
    while ordinal < list_count(parameters):
        let parameter: YazaSqlBoundParameterV1 = list_get(parameters, ordinal)
        if parameter.key == key: return ordinal
        set ordinal = ordinal + 1
    return -1

fn yaza_sql_bind_v1_merge_subquery_parameters(source: Text, anchor: Number, nested_parameters: List[YazaSqlBoundParameterV1], parameters: List[YazaSqlBoundParameterV1], current_style: Number, positional_global_ordinals: List[Number]) -> Result[YazaSqlSubqueryParameterBindingV1, Text]:
    if anchor < 0 or anchor > text_length(source) or current_style < 0 or current_style > 3 or list_count(nested_parameters) > 4096 or list_count(parameters) > 4096 or list_count(positional_global_ordinals) > 4096:
        return err("SQL binder subquery parameter merge exceeds its bounded profile")
    let ordinals_created: Result[List[Number], Text] = list_try_new()
    if not result_is_ok(ordinals_created): return err("SQL binder could not allocate subquery parameter mapping")
    let global_ordinals: List[Number] = result_unwrap(ordinals_created)
    if not list_try_reserve(global_ordinals, list_count(nested_parameters)): return err("SQL binder could not reserve subquery parameter mapping")
    var parameter_style: Number = current_style
    var local_index: Number = 0
    while local_index < list_count(nested_parameters):
        let local: YazaSqlBoundParameterV1 = list_get(nested_parameters, local_index)
        if local.ordinal != local_index or local.type_id < 1 or local.type_id > 16 or local.occurrence_count < 1 or local.style < 1 or local.style > 3:
            return err(yaza_sql_bind_v1_error(source, anchor, "SQL binder nested plan has invalid bind metadata"))
        if parameter_style != 0 and local.style != parameter_style:
            return err(yaza_sql_bind_v1_error(source, anchor, "SQL binder does not allow mixed bind parameter styles across a statement and its subqueries"))
        set parameter_style = local.style
        var global_ordinal: Number = -1
        if local.style == 1:
            set global_ordinal = list_count(parameters)
            if global_ordinal >= 4096: return err(yaza_sql_bind_v1_error(source, anchor, "SQL statement exceeds the 4096 anonymous bind parameter limit"))
            let number_result: Result[Text, Text] = number_try_text(global_ordinal + 1)
            if not result_is_ok(number_result): return err("SQL binder could not allocate anonymous subquery parameter metadata")
            let key_result: Result[Text, Text] = text_try_concat("?", result_unwrap(number_result))
            if not result_is_ok(key_result): return err("SQL binder could not allocate anonymous subquery parameter metadata")
            if not list_try_push(parameters, YazaSqlBoundParameterV1(1, global_ordinal, result_unwrap(key_result), local.type_id, anchor, local.occurrence_count)):
                return err("SQL binder could not merge anonymous subquery parameter metadata")
        elif local.style == 2:
            set global_ordinal = local.ordinal
            if list_count(positional_global_ordinals) > 0:
                if local.ordinal < 0 or local.ordinal >= list_count(positional_global_ordinals): return err(yaza_sql_bind_v1_error(source, anchor, "SQL binder nested positional mapping does not cover every bound parameter"))
                set global_ordinal = list_get(positional_global_ordinals, local.ordinal)
            if global_ordinal < 0 or global_ordinal > list_count(parameters):
                return err(yaza_sql_bind_v1_error(source, anchor, "SQL statement positional parameters must be contiguous from $1 across subqueries"))
            let global_number_result: Result[Text, Text] = number_try_text(global_ordinal + 1)
            if not result_is_ok(global_number_result): return err("SQL binder could not format a statement positional parameter key")
            let global_key_result: Result[Text, Text] = text_try_concat("$", result_unwrap(global_number_result))
            if not result_is_ok(global_key_result): return err("SQL binder could not format a statement positional parameter key")
            let global_key: Text = result_unwrap(global_key_result)
            if global_ordinal == list_count(parameters):
                if not list_try_push(parameters, YazaSqlBoundParameterV1(2, global_ordinal, global_key, local.type_id, anchor, local.occurrence_count)):
                    return err("SQL binder could not merge positional subquery parameter metadata")
            else:
                let existing: YazaSqlBoundParameterV1 = list_get(parameters, global_ordinal)
                if existing.style != 2 or existing.key != global_key or (existing.type_id != -1 and existing.type_id != local.type_id):
                    return err(yaza_sql_bind_v1_error(source, anchor, "SQL binder inferred incompatible uses of a positional parameter across subqueries"))
                if not list_try_set(parameters, global_ordinal, YazaSqlBoundParameterV1(2, global_ordinal, global_key, local.type_id, existing.first_start_byte, existing.occurrence_count + local.occurrence_count)):
                    return err("SQL binder could not merge positional subquery parameter metadata")
        else:
            set global_ordinal = yaza_sql_bind_v1_find_parameter(parameters, local.key)
            if global_ordinal < 0:
                set global_ordinal = list_count(parameters)
                if global_ordinal >= 4096: return err(yaza_sql_bind_v1_error(source, anchor, "SQL statement exceeds the 4096 named bind parameter limit"))
                if not list_try_push(parameters, YazaSqlBoundParameterV1(3, global_ordinal, local.key, local.type_id, anchor, local.occurrence_count)):
                    return err("SQL binder could not merge named subquery parameter metadata")
            else:
                let existing: YazaSqlBoundParameterV1 = list_get(parameters, global_ordinal)
                if existing.style != 3 or (existing.type_id != -1 and existing.type_id != local.type_id):
                    return err(yaza_sql_bind_v1_error(source, anchor, "SQL binder inferred incompatible uses of a named parameter across subqueries"))
                if not list_try_set(parameters, global_ordinal, YazaSqlBoundParameterV1(3, global_ordinal, local.key, local.type_id, existing.first_start_byte, existing.occurrence_count + local.occurrence_count)):
                    return err("SQL binder could not merge named subquery parameter metadata")
        if global_ordinal < 0 or not list_try_push(global_ordinals, global_ordinal):
            return err("SQL binder could not store a subquery parameter mapping")
        set local_index = local_index + 1
    return ok(YazaSqlSubqueryParameterBindingV1(global_ordinals, parameter_style))

fn yaza_sql_bind_v1_register_parameter(source: Text, token: YazaSqlTokenV1, type_id: Number, parameters: List[YazaSqlBoundParameterV1], current_style: Number) -> Result[Number, Text]:
    if not yaza_sql_bind_v1_token_valid(source, token):
        return err("SQL binder received an invalid parameter token span")
    if token.kind != 5:
        return err(yaza_sql_bind_v1_error(source, token.start_byte, "SQL binder expected a bind parameter"))
    let first_byte: Number = text_byte(source, token.start_byte)
    var style: Number = 0
    var key: Text = ""
    var requested_ordinal: Number = -1
    if first_byte == 63:
        set style = 1
        let index_result: Result[Text, Text] = number_try_text(list_count(parameters) + 1)
        if not result_is_ok(index_result): return err("SQL binder could not allocate parameter metadata")
        let key_result: Result[Text, Text] = text_try_concat("?", result_unwrap(index_result))
        if not result_is_ok(key_result): return err("SQL binder could not allocate parameter metadata")
        set key = result_unwrap(key_result)
        set requested_ordinal = list_count(parameters)
    elif first_byte == 36:
        set style = 2
        let key_result: Result[Text, Text] = text_try_slice(source, token.start_byte, token.end_byte - token.start_byte)
        if not result_is_ok(key_result): return err("SQL binder could not allocate parameter metadata")
        set key = result_unwrap(key_result)
        set requested_ordinal = yaza_sql_bind_v1_positional_index(source, token)
        if requested_ordinal < 0:
            return err(yaza_sql_bind_v1_error(source, token.start_byte, "SQL binder positional parameters must be numbered from $1 through $4096"))
    elif first_byte == 58:
        set style = 3
        let key_result: Result[Text, Text] = text_try_slice(source, token.start_byte + 1, token.end_byte - token.start_byte - 1)
        if not result_is_ok(key_result): return err("SQL binder could not allocate parameter metadata")
        set key = result_unwrap(key_result)
    else:
        return err(yaza_sql_bind_v1_error(source, token.start_byte, "SQL binder does not recognize this parameter style"))

    if current_style != 0 and style != current_style:
        return err(yaza_sql_bind_v1_error(source, token.start_byte, "SQL binder does not allow mixed bind parameter styles"))

    if style == 1:
        if not list_try_push(parameters, YazaSqlBoundParameterV1(style, requested_ordinal, key, type_id, token.start_byte, 1)):
            return err("SQL binder could not allocate parameter metadata")
        return ok(requested_ordinal)

    if style == 2:
        if requested_ordinal > list_count(parameters):
            return err(yaza_sql_bind_v1_error(source, token.start_byte, "SQL binder positional parameters must be used contiguously from $1"))
        if requested_ordinal == list_count(parameters):
            if not list_try_push(parameters, YazaSqlBoundParameterV1(style, requested_ordinal, key, type_id, token.start_byte, 1)):
                return err("SQL binder could not allocate parameter metadata")
            return ok(requested_ordinal)
        let existing: YazaSqlBoundParameterV1 = list_get(parameters, requested_ordinal)
        if existing.type_id != -1 and existing.type_id != type_id:
            return err(yaza_sql_bind_v1_error(source, token.start_byte, "SQL binder inferred incompatible types for the same positional parameter"))
        let updated: YazaSqlBoundParameterV1 = YazaSqlBoundParameterV1(style, requested_ordinal, key, type_id, existing.first_start_byte, existing.occurrence_count + 1)
        list_set(parameters, requested_ordinal, updated)
        return ok(requested_ordinal)

    let found: Number = yaza_sql_bind_v1_find_parameter(parameters, key)
    if found >= 0:
        let existing: YazaSqlBoundParameterV1 = list_get(parameters, found)
        if existing.type_id != type_id:
            return err(yaza_sql_bind_v1_error(source, token.start_byte, "SQL binder inferred incompatible types for the same named parameter"))
        list_set(parameters, found, YazaSqlBoundParameterV1(style, found, key, type_id, existing.first_start_byte, existing.occurrence_count + 1))
        return ok(found)
    let ordinal: Number = list_count(parameters)
    if not list_try_push(parameters, YazaSqlBoundParameterV1(style, ordinal, key, type_id, token.start_byte, 1)):
        return err("SQL binder could not allocate parameter metadata")
    return ok(ordinal)

fn yaza_sql_bind_v1_value_compatible(source: Text, token: YazaSqlTokenV1, type_id: Number, precision: Number, scale: Number) -> Boolean:
    if token.kind == 3:
        if not yaza_sql_bind_v1_numeric_type(type_id): return false
        if type_id == 10:
            let literal: Result[Text, Text] = text_try_slice(source, token.start_byte, token.end_byte - token.start_byte)
            if not result_is_ok(literal): return false
            return result_is_ok(yaza_sql_decimal_parse_v1(result_unwrap(literal), precision, scale))
        return true
    if token.kind == 4:
        if type_id == 9: return true
        if type_id == 11:
            let literal: Text = text_slice(source, token.start_byte + 1, token.end_byte - token.start_byte - 2)
            return result_is_ok(yaza_sql_date_parse_v1(literal))
        if type_id == 12:
            let literal: Text = text_slice(source, token.start_byte + 1, token.end_byte - token.start_byte - 2)
            return result_is_ok(yaza_sql_uuid_parse_v1(literal))
        if type_id == 13:
            let literal: Text = text_slice(source, token.start_byte + 1, token.end_byte - token.start_byte - 2)
            return result_is_ok(yaza_sql_time_parse_v1(literal))
        if type_id == 14:
            let literal: Text = text_slice(source, token.start_byte + 1, token.end_byte - token.start_byte - 2)
            return result_is_ok(yaza_sql_timestamp_parse_v1(literal))
        if type_id == 15:
            let literal: Text = text_slice(source, token.start_byte + 1, token.end_byte - token.start_byte - 2)
            return result_is_ok(yaza_sql_timestamptz_parse_v1(literal))
        return false
    if token.kind == 8:
        if type_id != 16: return false
        return result_is_ok(yaza_sql_decode_blob_literal_v1(source, token.start_byte, token.end_byte))
    if yaza_sql_bind_v1_keyword(source, token, "TRUE") or yaza_sql_bind_v1_keyword(source, token, "FALSE"):
        return type_id == 1
    return false

fn yaza_sql_bind_select_depth_v1(source: Text, query: YazaSqlSelectAstV3, catalog: YazaSqlCatalogSnapshotV1, subquery_depth: Number) -> Result[YazaSqlBoundPlanV1, Text]:
    if subquery_depth < 0 or subquery_depth > 8:
        return err(yaza_sql_bind_v1_error(source, query.start_byte, "SQL binder subquery nesting exceeds its bounded depth of 8"))
    if query.version != 3:
        return err("SQL binder v1 requires a version 3 SELECT syntax tree")
    if query.join_type != 0 and query.join_type != 1 and query.join_type != 2 and query.join_type != 3 and query.join_type != 4 and query.join_type != 5:
        return err(yaza_sql_bind_v1_error(source, query.start_byte, "SQL binder received an unknown JOIN kind"))
    if (query.join_type == 0 and query.join_comparison_operator != 0) or (query.join_type == 5 and query.join_comparison_operator != 0) or ((query.join_type == 1 or query.join_type == 2 or query.join_type == 3 or query.join_type == 4) and (query.join_comparison_operator < 1 or query.join_comparison_operator > 6)):
        return err(yaza_sql_bind_v1_error(source, query.start_byte, "SQL binder received an invalid JOIN comparison operator"))
    if query.join_type != 1 and query.join_type != 0 and query.join_type != 5 and query.join_comparison_operator != 1:
        return err(yaza_sql_bind_v1_error(source, query.start_byte, "SQL binder currently supports non-equality ON predicates only for INNER JOIN"))
    if not yaza_sql_bind_v1_span_valid(source, query.start_byte, query.end_byte):
        return err("SQL binder received an invalid statement span")
    if catalog.version <= 0:
        return err("SQL binder requires a positive catalog snapshot version")
    if list_count(catalog.tables) > 1024:
        return err("SQL binder catalog snapshot exceeds the 1024 table profile limit")
    if list_count(query.projections) == 0 or list_count(query.projections) > 1024 or list_count(query.group_by) > 64 or list_count(query.order_by) > 1024 or list_count(query.where_nodes) + list_count(query.having_nodes) > 4095:
        return err("SQL binder syntax tree exceeds its structural limits")
    if not yaza_sql_bind_v1_name_valid(source, query.table_name):
        return err("SQL binder received an invalid table name span")
    if query.table_name.part_count != 1:
        return err(yaza_sql_bind_v1_error(source, query.table_name.start_byte, "SQL binder v1 supports one-part table names only"))
    if query.has_table_alias:
        if not yaza_sql_bind_v1_token_valid(source, query.table_alias) or (query.table_alias.kind != 1 and query.table_alias.kind != 2):
            return err("SQL binder received an invalid table alias span")

    var resolved_table_index: Number = -1
    var table_index: Number = 0
    while table_index < list_count(catalog.tables):
        let candidate: YazaSqlTableSchemaV1 = list_get(catalog.tables, table_index)
        if candidate.table_id <= 0 or text_length(candidate.name) == 0:
            return err("SQL binder received an invalid catalog table record")
        if list_count(candidate.columns) > 1024:
            return err("SQL binder catalog table exceeds the 1024 column profile limit")
        var prior_table_index: Number = 0
        while prior_table_index < table_index:
            if list_get(catalog.tables, prior_table_index).table_id == candidate.table_id:
                return err("SQL binder catalog contains a duplicate table ID")
            set prior_table_index = prior_table_index + 1
        if yaza_sql_bind_v1_identifier_matches(source, query.table_name.first_token, candidate.name):
            if resolved_table_index >= 0:
                return err(yaza_sql_bind_v1_error(source, query.table_name.start_byte, "SQL binder found an ambiguous table name"))
            set resolved_table_index = table_index
        set table_index = table_index + 1
    if resolved_table_index < 0:
        return err(yaza_sql_bind_v1_error(source, query.table_name.start_byte, "SQL binder could not resolve table"))
    let table: YazaSqlTableSchemaV1 = list_get(catalog.tables, resolved_table_index)
    if list_count(table.columns) == 0 or list_count(table.columns) > 1024:
        return err("SQL binder table schema must contain between 1 and 1024 columns")
    var schema_ordinal: Number = 0
    while schema_ordinal < list_count(table.columns):
        let schema_column: YazaSqlColumnSchemaV1 = list_get(table.columns, schema_ordinal)
        if schema_column.ordinal != schema_ordinal or text_length(schema_column.name) == 0 or not yaza_sql_bind_v1_type_name_supported(schema_column.type_id):
            return err("SQL binder received an invalid catalog column record")
        set schema_ordinal = schema_ordinal + 1

    let visible_sources_created: Result[List[YazaSqlVisibleSourceV1], Text] = list_try_new()
    let join_stage_result: Result[List[YazaSqlBoundJoinStageV1], Text] = list_try_new()
    if not result_is_ok(visible_sources_created) or not result_is_ok(join_stage_result):
        return err("SQL binder could not allocate multi-table source metadata")
    var visible_sources: List[YazaSqlVisibleSourceV1] = result_unwrap(visible_sources_created)
    var join_stages: List[YazaSqlBoundJoinStageV1] = result_unwrap(join_stage_result)
    var total_join_column_count: Number = list_count(table.columns)
    if not list_try_push(visible_sources, YazaSqlVisibleSourceV1(table, query.has_table_alias, query.table_alias, 0)):
        return err("SQL binder could not append the base table source")

    var right_table: YazaSqlTableSchemaV1 = YazaSqlTableSchemaV1(0, "", List[YazaSqlColumnSchemaV1]())
    var join_left_column_ordinal: Number = -1
    var join_right_column_ordinal: Number = -1
    var join_comparison_operator: Number = query.join_comparison_operator
    if query.join_type != 0:
        if not yaza_sql_bind_v1_name_valid(source, query.join_table_name) or query.join_table_name.part_count != 1:
            return err(yaza_sql_bind_v1_error(source, query.join_table_name.start_byte, "SQL binder JOIN supports one-part table names only"))
        if query.has_join_table_alias and (not yaza_sql_bind_v1_token_valid(source, query.join_table_alias) or (query.join_table_alias.kind != 1 and query.join_table_alias.kind != 2)):
            return err("SQL binder received an invalid joined table alias span")
        var resolved_right_table_index: Number = -1
        var right_table_index: Number = 0
        while right_table_index < list_count(catalog.tables):
            let candidate: YazaSqlTableSchemaV1 = list_get(catalog.tables, right_table_index)
            if yaza_sql_bind_v1_identifier_matches(source, query.join_table_name.first_token, candidate.name):
                if resolved_right_table_index >= 0:
                    return err(yaza_sql_bind_v1_error(source, query.join_table_name.start_byte, "SQL binder found an ambiguous joined table name"))
                set resolved_right_table_index = right_table_index
            set right_table_index = right_table_index + 1
        if resolved_right_table_index < 0:
            return err(yaza_sql_bind_v1_error(source, query.join_table_name.start_byte, "SQL binder could not resolve joined table"))
        set right_table = list_get(catalog.tables, resolved_right_table_index)
        if list_count(right_table.columns) == 0 or list_count(right_table.columns) > 1024 or list_count(table.columns) + list_count(right_table.columns) > 1024:
            return err("SQL binder joined schema must contain between 2 and 1024 columns")
        var right_schema_ordinal: Number = 0
        while right_schema_ordinal < list_count(right_table.columns):
            let right_schema_column: YazaSqlColumnSchemaV1 = list_get(right_table.columns, right_schema_ordinal)
            if right_schema_column.ordinal != right_schema_ordinal or text_length(right_schema_column.name) == 0 or not yaza_sql_bind_v1_type_name_supported(right_schema_column.type_id):
                return err("SQL binder received an invalid joined catalog column record")
            set right_schema_ordinal = right_schema_ordinal + 1
        if not list_try_push(visible_sources, YazaSqlVisibleSourceV1(right_table, query.has_join_table_alias, query.join_table_alias, total_join_column_count)):
            return err("SQL binder could not append the first joined table source")
        set total_join_column_count = total_join_column_count + list_count(right_table.columns)
        if query.has_table_alias and query.has_join_table_alias and yaza_sql_bind_v1_identifier_tokens_match(source, query.table_alias, query.join_table_alias):
            return err(yaza_sql_bind_v1_error(source, query.join_table_alias.start_byte, "SQL binder joined table aliases must be distinct"))
        if query.join_type != 5:
            if query.join_left_column.part_count != 2 or query.join_right_column.part_count != 2:
                return err(yaza_sql_bind_v1_error(source, query.join_left_column.start_byte, "SQL binder JOIN ON columns must be qualified by their table or alias"))
            if not yaza_sql_bind_v1_name_valid(source, query.join_left_column) or not yaza_sql_bind_v1_name_valid(source, query.join_right_column):
