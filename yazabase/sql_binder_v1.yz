                if not list_try_push(expressions, YazaSqlBoundExpressionNodeV1(node.kind, node.operator, -1, -1, having_null_projection_index, 0, -1, having_null_projection.type_id, node.start_byte, node.end_byte, node.operator_start_byte, node.operator_end_byte, 0, 0, having_null_projection.precision, having_null_projection.scale, -1, 0, 0, 0)):
                    return err("SQL binder could not allocate HAVING expression metadata")
            else:
                if node.aggregate_kind != 0: return err("SQL binder HAVING Boolean expression node contains an aggregate kind")
                if node.left_index < 0 or node.left_index >= having_node_index:
                    return err("SQL binder found an invalid HAVING left expression reference")
                if node.kind == 2 or node.kind == 3:
                    if node.right_index < 0 or node.right_index >= having_node_index: return err("SQL binder found an invalid HAVING right expression reference")
                elif node.kind == 4:
                    if node.right_index != -1: return err("SQL binder found an invalid HAVING NOT expression")
                else:
                    return err(yaza_sql_bind_v1_error(source, node.start_byte, "SQL binder encountered an unknown HAVING expression node"))
                var absolute_left: Number = having_start_index + node.left_index
                var absolute_right: Number = -1
                if node.kind == 2 or node.kind == 3: set absolute_right = having_start_index + node.right_index
                if not list_try_push(expressions, YazaSqlBoundExpressionNodeV1(node.kind, node.operator, absolute_left, absolute_right, -1, 0, -1, 1, node.start_byte, node.end_byte, node.operator_start_byte, node.operator_end_byte, 0, 0, 0, 0, -1, 0, 0, 0)):
                    return err("SQL binder could not allocate HAVING expression metadata")
            set having_node_index = having_node_index + 1
        set having_root = having_start_index + query.having_root

    var input_index: Number = list_count(operators) - 1
    if saw_aggregate or list_count(group_by_columns) > 0:
        if not list_try_push(operators, YazaSqlLogicalOperatorV1(yaza_sql_operator_aggregate_v1(), input_index, table.table_id, -1, list_count(group_by_columns), list_count(projections), 0)):
            return err("SQL binder could not allocate aggregate operator")
    else:
        if not list_try_push(operators, YazaSqlLogicalOperatorV1(3, input_index, table.table_id, -1, 0, list_count(projections), 0)):
            return err("SQL binder could not allocate logical operators")
    set input_index = list_count(operators) - 1
    if having_root >= 0:
        if not list_try_push(operators, YazaSqlLogicalOperatorV1(8, input_index, table.table_id, having_root, 0, 0, 0)):
            return err("SQL binder could not allocate HAVING operator")
        set input_index = list_count(operators) - 1
    if query.distinct:
        if not list_try_push(operators, YazaSqlLogicalOperatorV1(4, input_index, table.table_id, -1, 0, list_count(projections), 0)):
            return err("SQL binder could not allocate logical operators")
        set input_index = list_count(operators) - 1

    var order_index: Number = 0
    while order_index < list_count(query.order_by):
        let order_term: YazaSqlOrderTermV2 = list_get(query.order_by, order_index)
        if not yaza_sql_bind_v1_name_valid(source, order_term.name):
            return err("SQL binder received an invalid ORDER BY name span")
        let order_column_result: Result[YazaSqlColumnSchemaV1, Text] = yaza_sql_bind_v1_resolve_source_column(source, visible_sources, order_term.name)
        if not result_is_ok(order_column_result): return err(result_unwrap_error(order_column_result))
        let order_column: YazaSqlColumnSchemaV1 = result_unwrap(order_column_result)
        var order_projection: Number = -1
        var candidate_index: Number = 0
        while candidate_index < list_count(projections):
            if list_get(projections, candidate_index).aggregate_kind == 0 and list_get(projections, candidate_index).column_ordinal == order_column.ordinal:
                if order_projection >= 0:
                    return err(yaza_sql_bind_v1_error(source, order_term.name.start_byte, "SQL binder ORDER BY column is ambiguous in the projection"))
                set order_projection = candidate_index
            set candidate_index = candidate_index + 1
        if order_projection < 0:
            return err(yaza_sql_bind_v1_error(source, order_term.name.start_byte, "SQL binder v1 requires ORDER BY columns to appear in the projection"))
        if not list_try_push(order_by, YazaSqlBoundOrderTermV1(order_projection, order_term.descending)):
            return err("SQL binder could not allocate ordering metadata")
        set order_index = order_index + 1
    if list_count(order_by) > 0:
        if not list_try_push(operators, YazaSqlLogicalOperatorV1(5, input_index, table.table_id, -1, 0, list_count(order_by), 0)):
            return err("SQL binder could not allocate logical operators")
        set input_index = list_count(operators) - 1

    if query.has_limit:
        if query.limit < 0 or query.limit > 1000000:
            return err("SQL binder received a LIMIT outside the parser profile")
        if not list_try_push(operators, YazaSqlLogicalOperatorV1(6, input_index, table.table_id, -1, 0, 0, query.limit)):
            return err("SQL binder could not allocate logical operators")
        set input_index = list_count(operators) - 1

    var parameter_index: Number = 0
    while parameter_index < list_count(parameters):
        let parameter: YazaSqlBoundParameterV1 = list_get(parameters, parameter_index)
        if parameter.type_id < 1:
            return err(yaza_sql_bind_v1_error(source, query.start_byte, "SQL binder positional parameter numbers must be contiguous from $1"))
        set parameter_index = parameter_index + 1

    if list_count(subquery_parameter_ordinals) != list_count(subqueries): return err("SQL binder subquery parameter mappings do not match its subquery list")
    return ok(YazaSqlBoundPlanV1(1, catalog.version, table.table_id, right_table.table_id, list_count(table.columns), list_count(right_table.columns), join_left_column_ordinal, join_right_column_ordinal, join_comparison_operator, join_stages, source, query.distinct, projections, group_by_columns, order_by, expressions, subqueries, subquery_parameter_ordinals, having_start_index, having_root, parameters, operators, query.where_root, input_index, query.has_limit, query.limit, parameter_style))

fn yaza_sql_bind_select_v1(source: Text, query: YazaSqlSelectAstV3, catalog: YazaSqlCatalogSnapshotV1) -> Result[YazaSqlBoundPlanV1, Text]:
    return yaza_sql_bind_select_depth_v1(source, query, catalog, 0)

fn yaza_sql_bind_v1_diagnostic_code(message: Text) -> Number:
    if text_starts_with(message, "SQL binder could not allocate"): return 3005
    if text_starts_with(message, "SQL binder subquery nesting exceeds"): return 3001
    if text_starts_with(message, "SQL binder catalog") or text_starts_with(message, "SQL binder table schema") or text_starts_with(message, "SQL binder received an invalid catalog"): return 3004
    if text_starts_with(message, "SQL binder could not resolve") or text_starts_with(message, "SQL binder found an ambiguous"): return 3002
    if text_starts_with(message, "SQL binder HAVING name must") or text_starts_with(message, "SQL binder found an ambiguous HAVING"): return 3002
    if text_starts_with(message, "SQL binder literal type") or text_starts_with(message, "SQL binder comparison operator") or text_starts_with(message, "SQL binder inferred incompatible") or text_starts_with(message, "SQL binder does not allow mixed") or text_starts_with(message, "SQL binder positional parameters") or text_starts_with(message, "SQL binder positional parameter numbers"): return 3003
    if text_starts_with(message, "SQL binder HAVING literal type") or text_starts_with(message, "SQL binder HAVING comparison operator"): return 3003
    if text_starts_with(message, "SQL binder v1 supports") or text_starts_with(message, "SQL binder v1 does not yet support") or text_starts_with(message, "SQL binder v1 parses") or text_starts_with(message, "SQL binder v1 requires"): return 3001
    if text_starts_with(message, "SQL binder v1 does not allow aggregate expressions in WHERE"): return 3001
    if text_starts_with(message, "SQL binder HAVING requires"): return 3001
    if text_starts_with(message, "SQL binder HAVING aggregate must"): return 3001
    if text_starts_with(message, "SQL binder received an invalid") or text_starts_with(message, "SQL binder found an invalid") or text_starts_with(message, "SQL binder received WHERE") or text_starts_with(message, "SQL binder received HAVING") or text_starts_with(message, "SQL binder encountered an unknown"): return 3006
    if text_starts_with(message, "SQL binder could not") or text_starts_with(message, "SQL binder projection expansion"): return 3005
    return 3099

fn yaza_sql_bind_select_structured_v1(source: Text, query: YazaSqlSelectAstV3, catalog: YazaSqlCatalogSnapshotV1) -> Result[YazaSqlBoundPlanV1, YazaSqlDiagnosticV1]:
    let bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(source, query, catalog)
    if result_is_ok(bound): return ok(result_unwrap(bound))
    let message: Text = result_unwrap_error(bound)
    return err(yaza_sql_v1_diagnostic(source, message, 3, yaza_sql_bind_v1_diagnostic_code(message)))
