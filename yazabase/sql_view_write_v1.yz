# Transactional persistence for bounded, read-only views.
# View metadata is committed in sys_tables, sys_columns, and sys_views together.
use "./catalog_migration_v1"
use "./catalog_schema_v1"
use "./catalog_snapshot_v1"
use "./catalog_storage_v1"
use "./btree_scan_v1"
use "./key_codec_v1"
use "./page_v1"
use "./row_v1"
use "./sql_create_table_write_v1"
use "./sql_insert_write_v1"
use "./sql_view_v1"
use "./storage_v1"
use "./transaction_v1"
use "./wal_v1"

shape YazaDbSqlViewDropTargetV1:
    page_id: Number
    key: Bytes
    tombstone_payload: Bytes

fn yaza_db_sql_view_close_v1(storage: YazaDbStorageHandleV1, wal: YazaDbWalLogV1) -> Unit:
    let ignored_wal_close: Result[Boolean, Text] = yaza_db_wal_log_close_v1(wal)
    let ignored_storage_close: Result[Boolean, Text] = yaza_db_storage_close_v1(storage)
    return

fn yaza_db_sql_view_table_row_v1(view_id: Number, view_name: Text) -> Result[YazaSqlInsertMaterializedRowV1, Text]:
    let values: List[YazaSqlValueV1] = yaza_db_sql_create_table_values_v1()?
    if not yaza_db_sql_create_table_push_integer_v1(values, 4, view_id) or not yaza_db_sql_create_table_push_text_v1(values, "public") or not yaza_db_sql_create_table_push_text_v1(values, view_name) or not yaza_db_sql_create_table_push_integer_v1(values, 4, 0) or not yaza_db_sql_create_table_push_integer_v1(values, 2, 2) or not yaza_db_sql_create_table_push_integer_v1(values, 3, 0) or not yaza_db_sql_create_table_push_integer_v1(values, 4, 1):
        return err("YDBv1 CREATE VIEW sys_tables row could not be built")
    return yaza_db_sql_create_table_row_v1(values, [false, false, false, false, false, false, false])

fn yaza_db_sql_view_column_row_v1(view_id: Number, column: YazaSqlColumnSchemaV1) -> Result[YazaSqlInsertMaterializedRowV1, Text]:
    let values: List[YazaSqlValueV1] = yaza_db_sql_create_table_values_v1()?
    let type_flags: Number = yaza_db_catalog_column_type_flags_encode_v1(column.type_id, column.precision, column.scale)?
    if not yaza_db_sql_create_table_push_integer_v1(values, 4, view_id) or not yaza_db_sql_create_table_push_integer_v1(values, 3, column.ordinal) or not yaza_db_sql_create_table_push_text_v1(values, column.name) or not yaza_db_sql_create_table_push_integer_v1(values, 2, column.type_id) or not yaza_db_sql_create_table_push_boolean_v1(values, column.nullable) or not yaza_db_sql_create_table_push_null_v1(values, 2) or not yaza_db_sql_create_table_push_integer_v1(values, 3, type_flags) or not yaza_db_sql_create_table_push_null_v1(values, 9):
        return err("YDBv1 CREATE VIEW sys_columns row could not be built")
    return yaza_db_sql_create_table_row_v1(values, [false, false, false, false, false, true, false, true])

fn yaza_db_sql_view_definition_row_v1(view_id: Number, definition: Text, dependency_table_id: Number) -> Result[YazaSqlInsertMaterializedRowV1, Text]:
    let values: List[YazaSqlValueV1] = yaza_db_sql_create_table_values_v1()?
    if not yaza_db_sql_create_table_push_integer_v1(values, 4, view_id) or not yaza_db_sql_create_table_push_text_v1(values, definition) or not yaza_db_sql_create_table_push_integer_v1(values, 4, dependency_table_id):
        return err("YDBv1 CREATE VIEW sys_views row could not be built")
    return yaza_db_sql_create_table_row_v1(values, [false, false, false])

fn yaza_db_sql_view_duplicate_name_v1(loaded: YazaDbCatalogSnapshotWithRootsV1, name: Text) -> Boolean:
    var index: Number = 0
    while index < list_count(loaded.views):
        if list_get(loaded.views, index).name == name: return true
        set index = index + 1
    return false

fn yaza_db_sql_create_view_write_v1(storage: YazaDbStorageHandleV1, wal: YazaDbWalLogV1, plan: YazaSqlCreateViewPlanV1) -> Result[YazaDbWriteCommitV1, Text]:
    if storage.root != wal.root or not bytes_equal(storage.header.db_uuid, wal.db_uuid): return err("YDBv1 CREATE VIEW storage and WAL handles belong to different databases")
    if not yaza_sql_create_view_plan_valid_v1(plan): return err("YDBv1 CREATE VIEW received an invalid bound plan")
    let initial_loaded: YazaDbCatalogSnapshotWithRootsV1 = yaza_db_catalog_snapshot_load_with_roots_v1(storage.file, storage.header)?
    if initial_loaded.sql_snapshot.version != plan.catalog_version: return err("YDBv1 CREATE VIEW plan was bound against a stale catalog snapshot")
    if list_count(initial_loaded.sql_snapshot.tables) + list_count(initial_loaded.views) >= yaza_db_catalog_max_table_records_v1(): return err("YDBv1 CREATE VIEW reached the bounded sys_tables record limit")
    if yaza_db_sql_view_duplicate_name_v1(initial_loaded, plan.view_name): return err("YDBv1 CREATE VIEW name already exists in the current catalog")
    var current_storage: YazaDbStorageHandleV1 = storage
    var current_wal: YazaDbWalLogV1 = wal
    var view_catalog: YazaDbCatalogRootV1 = initial_loaded.catalog
    var expected_catalog_version: Number = plan.catalog_version
    if view_catalog.sys_views_root == 0:
        let migration_result: Result[YazaDbCatalogMigrationV1, Text] = yaza_db_catalog_migrate_views_opened_v1(current_storage, current_wal)
        if not result_is_ok(migration_result): return err("YDBv1 CREATE VIEW catalog migration failed: " + result_unwrap_error(migration_result))
        let migration: YazaDbCatalogMigrationV1 = result_unwrap(migration_result)
        set current_storage = migration.storage
        set current_wal = migration.wal
        set view_catalog = migration.catalog
        if migration.migrated: set expected_catalog_version = expected_catalog_version + 1
    let loaded: YazaDbCatalogSnapshotWithRootsV1 = yaza_db_catalog_snapshot_load_with_roots_v1(current_storage.file, current_storage.header)?
    if loaded.sql_snapshot.version != expected_catalog_version or loaded.catalog.sys_views_root < 2:
        yaza_db_sql_view_close_v1(current_storage, current_wal)
        return err("YDBv1 CREATE VIEW catalog changed unexpectedly during sys_views migration; reopen before retrying")
    if list_count(loaded.sql_snapshot.tables) + list_count(loaded.views) >= yaza_db_catalog_max_table_records_v1() or yaza_db_sql_view_duplicate_name_v1(loaded, plan.view_name):
        yaza_db_sql_view_close_v1(current_storage, current_wal)
        return err("YDBv1 CREATE VIEW target name or catalog capacity changed during migration; reopen before retrying")
    let catalog: YazaDbCatalogRootV1 = loaded.catalog
    if catalog.next_object_id < 13 or catalog.next_object_id > yaza_db_catalog_max_object_id_v1() or catalog.generation >= yaza_db_catalog_max_page_id_v1():
        yaza_db_sql_view_close_v1(current_storage, current_wal)
        return err("YDBv1 CREATE VIEW catalog object-ID or generation space is exhausted")
    if plan.dependency_table_id <= 4 or yaza_db_catalog_snapshot_table_index_v1(loaded.sql_snapshot.tables, plan.dependency_table_id) < 0:
        yaza_db_sql_view_close_v1(current_storage, current_wal)
        return err("YDBv1 CREATE VIEW dependency is no longer a physical table")

    let view_id: Number = catalog.next_object_id
    let next_catalog: YazaDbCatalogRootV1 = YazaDbCatalogRootV1(catalog.sys_tables_root, catalog.sys_columns_root, catalog.sys_indexes_root, catalog.sys_constraints_root, view_id + 1, catalog.generation + 1, catalog.sys_views_root)
    let tables_schema: List[YazaSqlColumnSchemaV1] = yaza_db_catalog_table_schema_v1(1)?
    let columns_schema: List[YazaSqlColumnSchemaV1] = yaza_db_catalog_table_schema_v1(2)?
    let views_schema: List[YazaSqlColumnSchemaV1] = yaza_db_catalog_table_schema_v1(5)?
    let table_row: YazaSqlInsertMaterializedRowV1 = yaza_db_sql_view_table_row_v1(view_id, plan.view_name)?
    let view_row: YazaSqlInsertMaterializedRowV1 = yaza_db_sql_view_definition_row_v1(view_id, plan.definition, plan.dependency_table_id)?
    let column_rows_created: Result[List[YazaSqlInsertMaterializedRowV1], Text] = list_try_new()
    if not result_is_ok(column_rows_created): return err(result_unwrap_error(column_rows_created))
    let column_rows: List[YazaSqlInsertMaterializedRowV1] = result_unwrap(column_rows_created)
    if not list_try_reserve(column_rows, list_count(plan.output_columns)): return err("YDBv1 CREATE VIEW could not reserve output catalog rows")
    var column_index: Number = 0
    while column_index < list_count(plan.output_columns):
        let output_column: YazaSqlColumnSchemaV1 = list_get(plan.output_columns, column_index)
        let column_row: YazaSqlInsertMaterializedRowV1 = yaza_db_sql_view_column_row_v1(view_id, output_column)?
        if not list_try_push(column_rows, column_row): return err("YDBv1 CREATE VIEW could not stage output schema metadata")
        set column_index = column_index + 1

    let table_batch: YazaSqlInsertMaterializedV1 = yaza_db_sql_create_table_batch_v1(1, loaded.sql_snapshot.version, tables_schema, [table_row])?
    let columns_batch: YazaSqlInsertMaterializedV1 = yaza_db_sql_create_table_batch_v1(2, loaded.sql_snapshot.version, columns_schema, column_rows)?
    let table_preflight: Boolean = yaza_db_sql_insert_preflight_v1(current_storage, catalog.sys_tables_root, [0], table_batch)?
    let columns_preflight: Boolean = yaza_db_sql_insert_preflight_v1(current_storage, catalog.sys_columns_root, [0, 1], columns_batch)?
    if not table_preflight or not columns_preflight:
        yaza_db_sql_view_close_v1(current_storage, current_wal)
        return err("YDBv1 CREATE VIEW catalog preflight was incomplete")

    let reserve_pages: Number = yaza_db_write_transaction_default_free_page_reserve_v1()
    let begun_result: Result[YazaDbWriteTransactionV1, Text] = yaza_db_write_transaction_begin_with_reserve_v1(current_storage, current_wal, reserve_pages)
    if not result_is_ok(begun_result): return err("YDBv1 CREATE VIEW could not begin its bounded catalog transaction: " + result_unwrap_error(begun_result))
    let begun: YazaDbWriteTransactionV1 = result_unwrap(begun_result)
    if begun.commit_ts != loaded.sql_snapshot.version + 1:
        yaza_db_sql_view_close_v1(begun.storage, begun.wal)
        return err("YDBv1 CREATE VIEW commit timestamp changed after catalog preflight; reopen through recovery")
    let descriptor_result: Result[YazaDbWalAppendV1, Text] = yaza_db_sql_create_table_append_catalog_root_v1(begun.storage, begun.wal, begun.storage.header.catalog_root, next_catalog)
    if not result_is_ok(descriptor_result):
        yaza_db_sql_view_close_v1(begun.storage, begun.wal)
        return err("YDBv1 CREATE VIEW catalog generation update failed; reopen through recovery: " + result_unwrap_error(descriptor_result))
    let descriptor: YazaDbWalAppendV1 = result_unwrap(descriptor_result)
    var current: YazaDbWriteTransactionV1 = YazaDbWriteTransactionV1(begun.storage, descriptor.log, begun.txn_id, begun.commit_ts, begun.last_lsn, begun.pending_pages, begun.pending_keys_hex, begun.pending_rows_hex, begun.active)
    let table_insert: Result[YazaDbWriteTransactionV1, Text] = yaza_db_write_transaction_insert_committed_row_v1(current, catalog.sys_tables_root, table_row.values, table_row.nulls, tables_schema, [0])
    if not result_is_ok(table_insert):
        yaza_db_sql_view_close_v1(current.storage, current.wal)
        return err("YDBv1 CREATE VIEW sys_tables insert failed; reopen through recovery: " + result_unwrap_error(table_insert))
    set current = result_unwrap(table_insert)
    set column_index = 0
    while column_index < list_count(column_rows):
        let row: YazaSqlInsertMaterializedRowV1 = list_get(column_rows, column_index)
        let inserted: Result[YazaDbWriteTransactionV1, Text] = yaza_db_write_transaction_insert_committed_row_v1(current, catalog.sys_columns_root, row.values, row.nulls, columns_schema, [0, 1])
        if not result_is_ok(inserted):
            yaza_db_sql_view_close_v1(current.storage, current.wal)
            return err("YDBv1 CREATE VIEW sys_columns insert failed; reopen through recovery: " + result_unwrap_error(inserted))
        set current = result_unwrap(inserted)
        set column_index = column_index + 1
    let staged_result: Result[YazaDbWriteOverflowRowV1, Text] = yaza_db_write_transaction_stage_overflow_text_v1(current, view_row.values, view_row.nulls, views_schema)
    if not result_is_ok(staged_result):
        yaza_db_sql_view_close_v1(current.storage, current.wal)
        return err("YDBv1 CREATE VIEW definition staging failed; reopen through recovery: " + result_unwrap_error(staged_result))
    let staged: YazaDbWriteOverflowRowV1 = result_unwrap(staged_result)
    let view_insert: Result[YazaDbWriteTransactionV1, Text] = yaza_db_write_transaction_insert_committed_row_with_overflow_for_schema_v1(staged.transaction, catalog.sys_views_root, view_row.values, view_row.nulls, staged.references, views_schema, 1, [0])
    if not result_is_ok(view_insert):
        yaza_db_sql_view_close_v1(staged.transaction.storage, staged.transaction.wal)
        return err("YDBv1 CREATE VIEW sys_views insert failed; reopen through recovery: " + result_unwrap_error(view_insert))
    let committed: Result[YazaDbWriteCommitV1, Text] = yaza_db_write_transaction_commit_v1(result_unwrap(view_insert))
    if not result_is_ok(committed): return err("YDBv1 CREATE VIEW commit failed; reopen through recovery: " + result_unwrap_error(committed))
    return ok(result_unwrap(committed))

fn yaza_db_sql_view_stage_drop_target_v1(file: Number, file_header: YazaDbFileHeaderV1, root_page_id: Number, row: YazaDbRowV1, columns: List[YazaSqlColumnSchemaV1], key_ordinals: List[Number], commit_ts: Number, targets: List[YazaDbSqlViewDropTargetV1]) -> Result[Boolean, Text]:
    if row.deleted or row.version_ts < 1 or row.version_ts >= commit_ts or list_count(row.values) != list_count(columns) or list_count(row.nulls) != list_count(columns): return err("YDBv1 DROP VIEW catalog row is not a current committed row")
    let key: Bytes = yaza_db_key_encode_composite_v1(row.values, row.nulls, columns, key_ordinals)?
    let encoded: Bytes = yaza_db_row_encode_v1(row.values, row.nulls, columns, commit_ts)?
    let tombstone: Bytes = yaza_db_row_set_deleted_v1(encoded, true)?
    let seek: YazaDbBtreeSeekV1 = yaza_db_btree_seek_leaf_v1(file, file_header, root_page_id, key)?
    let page_header: YazaDbPageHeaderV1 = yaza_db_page_header_decode_v1(seek.leaf_page, seek.leaf_page_id)?
    let slot_index: Number = yaza_db_page_lower_bound_v1(seek.leaf_page, key, seek.leaf_page_id)?
    if slot_index >= page_header.count: return err("YDBv1 DROP VIEW catalog row disappeared during preflight")
    let stored_key: Bytes = yaza_db_page_slot_key_v1(seek.leaf_page, slot_index, seek.leaf_page_id)?
    if not bytes_equal(stored_key, key): return err("YDBv1 DROP VIEW catalog key changed during preflight")
    if not list_try_push(targets, YazaDbSqlViewDropTargetV1(seek.leaf_page_id, key, tombstone)): return err("YDBv1 DROP VIEW could not retain its catalog tombstone")
    return ok(true)

fn yaza_db_sql_drop_view_stage_targets_v1(file: Number, file_header: YazaDbFileHeaderV1, root_page_id: Number, rows: List[YazaDbRowV1], columns: List[YazaSqlColumnSchemaV1], key_ordinals: List[Number], id_ordinal: Number, view_id: Number, commit_ts: Number, targets: List[YazaDbSqlViewDropTargetV1]) -> Result[Number, Text]:
    var count: Number = 0
    var row_index: Number = 0
    while row_index < list_count(rows):
        let row: YazaDbRowV1 = list_get(rows, row_index)
        if list_count(row.values) != list_count(columns) or list_count(row.nulls) != list_count(columns) or id_ordinal < 0 or id_ordinal >= list_count(columns): return err("YDBv1 DROP VIEW catalog row is malformed")
        if not list_get(row.nulls, id_ordinal) and list_get(row.values, id_ordinal).integer_value == view_id:
            let staged: Boolean = yaza_db_sql_view_stage_drop_target_v1(file, file_header, root_page_id, row, columns, key_ordinals, commit_ts, targets)?
            if not staged: return err("YDBv1 DROP VIEW could not stage a catalog tombstone")
            set count = count + 1
        set row_index = row_index + 1
    return ok(count)

fn yaza_db_sql_drop_view_v1(storage: YazaDbStorageHandleV1, wal: YazaDbWalLogV1, view_name: Text) -> Result[YazaDbWriteCommitV1, Text]:
    if storage.root != wal.root or not bytes_equal(storage.header.db_uuid, wal.db_uuid): return err("YDBv1 DROP VIEW storage and WAL handles belong to different databases")
    let loaded: YazaDbCatalogSnapshotWithRootsV1 = yaza_db_catalog_snapshot_load_with_roots_v1(storage.file, storage.header)?
    var view_index: Number = 0
    while view_index < list_count(loaded.views) and list_get(loaded.views, view_index).name != view_name:
        set view_index = view_index + 1
    if view_index >= list_count(loaded.views): return err("YDBv1 DROP VIEW target does not exist")
    if loaded.catalog.sys_views_root < 2 or loaded.catalog.generation >= yaza_db_catalog_max_page_id_v1(): return err("YDBv1 DROP VIEW catalog root or generation is invalid")
    let view: YazaDbCatalogViewV1 = list_get(loaded.views, view_index)
    let visible_ts: Number = loaded.sql_snapshot.version
    let commit_ts: Number = storage.header.next_commit_ts
    let tables_schema: List[YazaSqlColumnSchemaV1] = yaza_db_catalog_table_schema_v1(1)?
    let columns_schema: List[YazaSqlColumnSchemaV1] = yaza_db_catalog_table_schema_v1(2)?
    let views_schema: List[YazaSqlColumnSchemaV1] = yaza_db_catalog_table_schema_v1(5)?
    let stored_tables: List[YazaDbRowV1] = yaza_db_catalog_snapshot_read_tree_v1(storage.file, storage.header, loaded.catalog.sys_tables_root, tables_schema, [0], visible_ts, yaza_db_catalog_max_table_records_v1())?
    let stored_columns: List[YazaDbRowV1] = yaza_db_catalog_snapshot_read_tree_v1(storage.file, storage.header, loaded.catalog.sys_columns_root, columns_schema, [0, 1], visible_ts, yaza_db_catalog_max_column_rows_v1())?
    let stored_views: List[YazaDbRowV1] = yaza_db_catalog_snapshot_read_tree_v1(storage.file, storage.header, loaded.catalog.sys_views_root, views_schema, [0], visible_ts, yaza_db_catalog_max_table_records_v1())?
    let targets_created: Result[List[YazaDbSqlViewDropTargetV1], Text] = list_try_new()
    if not result_is_ok(targets_created): return err(result_unwrap_error(targets_created))
    let targets: List[YazaDbSqlViewDropTargetV1] = result_unwrap(targets_created)
    if not list_try_reserve(targets, list_count(view.output_columns) + 2): return err("YDBv1 DROP VIEW could not reserve catalog tombstones")
    let table_count: Number = yaza_db_sql_drop_view_stage_targets_v1(storage.file, storage.header, loaded.catalog.sys_tables_root, stored_tables, tables_schema, [0], 0, view.view_id, commit_ts, targets)?
    let column_count: Number = yaza_db_sql_drop_view_stage_targets_v1(storage.file, storage.header, loaded.catalog.sys_columns_root, stored_columns, columns_schema, [0, 1], 0, view.view_id, commit_ts, targets)?
    let definition_count: Number = yaza_db_sql_drop_view_stage_targets_v1(storage.file, storage.header, loaded.catalog.sys_views_root, stored_views, views_schema, [0], 0, view.view_id, commit_ts, targets)?
    if table_count != 1 or column_count != list_count(view.output_columns) or definition_count != 1 or list_count(targets) > 900: return err("YDBv1 DROP VIEW catalog rows do not match the validated view schema")
    let begun_result: Result[YazaDbWriteTransactionV1, Text] = yaza_db_write_transaction_begin_with_reserve_v1(storage, wal, yaza_db_write_transaction_default_free_page_reserve_v1())
    if not result_is_ok(begun_result): return err("YDBv1 DROP VIEW could not begin its catalog transaction: " + result_unwrap_error(begun_result))
    let begun: YazaDbWriteTransactionV1 = result_unwrap(begun_result)
    if begun.commit_ts != commit_ts:
        yaza_db_sql_view_close_v1(begun.storage, begun.wal)
        return err("YDBv1 DROP VIEW commit timestamp changed after preflight; reopen through recovery")
    let leaf_record_bytes: Number = yaza_db_wal_header_size_v1() + yaza_db_wal_leaf_mutation_payload_size_v1()
    let catalog_image_bytes: Number = yaza_db_wal_header_size_v1() + yaza_db_wal_page_image_payload_size_v1()
    if leaf_record_bytes < 1 or list_count(targets) > (9223372036854775807 - catalog_image_bytes) / leaf_record_bytes:
        yaza_db_sql_view_close_v1(begun.storage, begun.wal)
        return err("YDBv1 DROP VIEW WAL reservation arithmetic overflowed")
    if not yaza_db_write_transaction_tail_fits_bytes_v1(begun, list_count(targets) * leaf_record_bytes + catalog_image_bytes):
        yaza_db_sql_view_close_v1(begun.storage, begun.wal)
        return err("YDBv1 DROP VIEW exceeds the bounded WAL recovery-tail budget")
    let next_catalog: YazaDbCatalogRootV1 = YazaDbCatalogRootV1(loaded.catalog.sys_tables_root, loaded.catalog.sys_columns_root, loaded.catalog.sys_indexes_root, loaded.catalog.sys_constraints_root, loaded.catalog.next_object_id, loaded.catalog.generation + 1, loaded.catalog.sys_views_root)
    let descriptor_result: Result[YazaDbWalAppendV1, Text] = yaza_db_sql_create_table_append_catalog_root_v1(begun.storage, begun.wal, begun.storage.header.catalog_root, next_catalog)
    if not result_is_ok(descriptor_result):
        yaza_db_sql_view_close_v1(begun.storage, begun.wal)
        return err("YDBv1 DROP VIEW catalog generation update failed; reopen through recovery: " + result_unwrap_error(descriptor_result))
    let descriptor: YazaDbWalAppendV1 = result_unwrap(descriptor_result)
    var current: YazaDbWriteTransactionV1 = YazaDbWriteTransactionV1(begun.storage, descriptor.log, begun.txn_id, begun.commit_ts, begun.last_lsn, begun.pending_pages, begun.pending_keys_hex, begun.pending_rows_hex, begun.active)
    var target_index: Number = 0
    while target_index < list_count(targets):
        let target: YazaDbSqlViewDropTargetV1 = list_get(targets, target_index)
        let mutation: Result[YazaDbWriteTransactionV1, Text] = yaza_db_write_transaction_mutate_leaf_v1(current, yaza_db_wal_type_leaf_update_v1(), target.page_id, target.key, target.tombstone_payload)
        if not result_is_ok(mutation):
            yaza_db_sql_view_close_v1(current.storage, current.wal)
            return err("YDBv1 DROP VIEW catalog tombstone failed; reopen through recovery: " + result_unwrap_error(mutation))
        set current = result_unwrap(mutation)
        set target_index = target_index + 1
    let committed: Result[YazaDbWriteCommitV1, Text] = yaza_db_write_transaction_commit_v1(current)
    if not result_is_ok(committed):
        yaza_db_sql_view_close_v1(current.storage, current.wal)
        return err("YDBv1 DROP VIEW commit failed; reopen through recovery: " + result_unwrap_error(committed))
    return ok(result_unwrap(committed))
