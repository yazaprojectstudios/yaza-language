        let check_literal_result: Result[Text, Text] = text_try_slice(source, check_ast.literal_start_byte, check_ast.literal_end_byte - check_ast.literal_start_byte)
        if not result_is_ok(check_literal_result): return err(yaza_sql_create_table_diagnostic_at_v1(source, check_ast.literal_start_byte, check_ast.literal_end_byte, 3005, "SQL CREATE TABLE could not retain its CHECK literal"))
        if not list_try_push(check_constraints, YazaSqlCreateCheckPlanV1(check_ordinal, check_ast.comparison_operator, result_unwrap(check_literal_result))): return err(yaza_sql_create_table_diagnostic_at_v1(source, check_ast.column_name.start_byte, check_ast.literal_end_byte, 3005, "SQL CREATE TABLE could not retain a CHECK constraint"))
