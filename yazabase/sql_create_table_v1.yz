            set duplicate_key = duplicate_key + 1
        if not list_try_push(key_ordinals, matched_ordinal):
            return err(yaza_sql_create_table_diagnostic_at_v1(source, key_name.start_byte, key_name.end_byte, 3005, "SQL CREATE TABLE binder could not record a primary-key column"))
        set key_index = key_index + 1
    if list_count(key_ordinals) == 0:
