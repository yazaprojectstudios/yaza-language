    let names: List[Text] = result_unwrap(names_result)
    let key_ordinals: List[Number] = result_unwrap(key_result)
    let unique_ordinals: List[Number] = result_unwrap(unique_result)
    let default_expressions: List[Text] = result_unwrap(defaults_result)
    let foreign_keys: List[YazaSqlCreateForeignKeyPlanV1] = result_unwrap(foreign_keys_result)
    let check_constraints: List[YazaSqlCreateCheckPlanV1] = result_unwrap(checks_result)
    let column_count: Number = list_count(create.columns)
