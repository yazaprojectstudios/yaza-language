# Bounded CREATE TABLE parser/binder for the YDBv1 scalar profile.
# Execution and persistent catalog publication are separate operations.
use "./sql_binder_v1"
use "./sql_insert_bind_v1"
use "./sql_literal_v1"
use "./sql_decimal_v1"
use "./sql_date_v1"
use "./sql_temporal_v1"

shape YazaSqlCreateColumnAstV1:
    name: YazaSqlNameV2
    type_id: Number
    precision: Number
    scale: Number
    nullable: Boolean
    default_kind: Number
    default_start_byte: Number
    default_end_byte: Number

shape YazaSqlCreateTypeParseV1:
    type_id: Number
    consumed_tokens: Number
    precision: Number
    scale: Number

shape YazaSqlCreateForeignKeyAstV1:
    local_column: YazaSqlNameV2
    referenced_table: YazaSqlNameV2
    referenced_column: YazaSqlNameV2

shape YazaSqlCreateForeignKeyPlanV1:
    local_column_ordinal: Number
    referenced_table_id: Number
    referenced_column_ordinal: Number

shape YazaSqlCreateCheckAstV1:
    column_name: YazaSqlNameV2
    comparison_operator: Number
    literal_kind: Number
    literal_start_byte: Number
    literal_end_byte: Number

shape YazaSqlCreateCheckPlanV1:
    column_ordinal: Number
    comparison_operator: Number
    literal: Text

shape YazaSqlCreateCheckClauseParseV1:
    clause: YazaSqlCreateCheckAstV1
    consumed_tokens: Number

shape YazaSqlCreateTableAstV1:
    version: Number
    start_byte: Number
    end_byte: Number
    table_name: YazaSqlNameV2
    columns: List[YazaSqlCreateColumnAstV1]
    primary_key_columns: List[YazaSqlNameV2]
    unique_columns: List[YazaSqlNameV2]
    foreign_keys: List[YazaSqlCreateForeignKeyAstV1]
    check_constraints: List[YazaSqlCreateCheckAstV1]

shape YazaSqlCreateTablePlanV1:
    version: Number
    catalog_version: Number
    table_name: Text
    columns: List[YazaSqlColumnSchemaV1]
    key_ordinals: List[Number]
    unique_ordinals: List[Number]
    default_expressions: List[Text]
    foreign_keys: List[YazaSqlCreateForeignKeyPlanV1]
    check_constraints: List[YazaSqlCreateCheckPlanV1]

fn yaza_sql_create_table_type_parameter_v1(source: Text, tokens: List[YazaSqlTokenV1], cursor: Number) -> Result[Number, Text]:
    if cursor < 0 or cursor >= list_count(tokens): return err("SQL DECIMAL type parameter is missing")
    let token: YazaSqlTokenV1 = list_get(tokens, cursor)
    if token.kind != 3 or token.start_byte < 0 or token.end_byte <= token.start_byte or token.end_byte > text_length(source):
        return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL DECIMAL precision and scale must be unsigned integer literals at byte "))
    var value: Number = 0
    var offset: Number = token.start_byte
    while offset < token.end_byte:
        let byte: Number = text_byte(source, offset)
        if byte < 48 or byte > 57:
            return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL DECIMAL precision and scale must be unsigned integer literals at byte "))
        let digit: Number = byte - 48
        if value > 38 or value * 10 + digit > 38:
            return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL DECIMAL precision and scale are limited to 38 at byte "))
        set value = value * 10 + digit
        set offset = offset + 1
    return ok(value)

fn yaza_sql_create_table_type_v1(source: Text, tokens: List[YazaSqlTokenV1], cursor: Number) -> Result[YazaSqlCreateTypeParseV1, Text]:
    if cursor < 0 or cursor >= list_count(tokens): return err("SQL CREATE TABLE parser expected a column type at end of input")
    var type_id: Number = 0
    var consumed_type_tokens: Number = 1
    if yaza_sql_v2_is_keyword(source, tokens, cursor, "BOOLEAN") or yaza_sql_v2_is_keyword(source, tokens, cursor, "BOOL"):
        set type_id = 1
    elif yaza_sql_v2_is_keyword(source, tokens, cursor, "SMALLINT"):
        set type_id = 2
    elif yaza_sql_v2_is_keyword(source, tokens, cursor, "INTEGER") or yaza_sql_v2_is_keyword(source, tokens, cursor, "INT"):
        set type_id = 3
    elif yaza_sql_v2_is_keyword(source, tokens, cursor, "BIGINT"):
        set type_id = 4
    elif yaza_sql_v2_is_keyword(source, tokens, cursor, "DOUBLE"):
        set type_id = 6
    elif yaza_sql_v2_is_keyword(source, tokens, cursor, "TEXT"):
        set type_id = 9
    elif yaza_sql_v2_is_keyword(source, tokens, cursor, "BLOB") or yaza_sql_v2_is_keyword(source, tokens, cursor, "BYTES"):
        set type_id = 16
    elif yaza_sql_v2_is_keyword(source, tokens, cursor, "DATE"):
        set type_id = 11
    elif yaza_sql_v2_is_keyword(source, tokens, cursor, "UUID"):
        set type_id = 12
    elif yaza_sql_v2_is_keyword(source, tokens, cursor, "TIME"):
        set type_id = 13
    elif yaza_sql_v2_is_keyword(source, tokens, cursor, "TIMESTAMPTZ"):
        set type_id = 15
    elif yaza_sql_v2_is_keyword(source, tokens, cursor, "TIMESTAMP"):
        set type_id = 14
        if yaza_sql_v2_is_keyword(source, tokens, cursor + 1, "WITH") or yaza_sql_v2_is_keyword(source, tokens, cursor + 1, "WITHOUT"):
            let qualifier: Boolean = yaza_sql_v2_is_keyword(source, tokens, cursor + 1, "WITH")
            if not yaza_sql_v2_is_keyword(source, tokens, cursor + 2, "TIME") or not yaza_sql_v2_is_keyword(source, tokens, cursor + 3, "ZONE"):
                return err(yaza_sql_v2_parse_error(source, tokens, cursor + 1, "SQL TIMESTAMP zone qualifier must be WITH TIME ZONE or WITHOUT TIME ZONE at byte "))
            if qualifier: set type_id = 15
            set consumed_type_tokens = 4
    elif yaza_sql_v2_is_keyword(source, tokens, cursor, "DECIMAL") or yaza_sql_v2_is_keyword(source, tokens, cursor, "NUMERIC"):
        if not yaza_sql_v2_is_symbol(source, tokens, cursor + 1, 40):
            return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL DECIMAL requires explicit precision, for example DECIMAL(18, 2), at byte "))
        let precision_result: Result[Number, Text] = yaza_sql_create_table_type_parameter_v1(source, tokens, cursor + 2)
        if not result_is_ok(precision_result): return err(result_unwrap_error(precision_result))
        let precision: Number = result_unwrap(precision_result)
        if precision < 1: return err(yaza_sql_v2_parse_error(source, tokens, cursor + 2, "SQL DECIMAL precision must be between 1 and 38 at byte "))
        var scale: Number = 0
        var consumed: Number = 4
        if yaza_sql_v2_is_symbol(source, tokens, cursor + 3, 44):
            let scale_result: Result[Number, Text] = yaza_sql_create_table_type_parameter_v1(source, tokens, cursor + 4)
            if not result_is_ok(scale_result): return err(result_unwrap_error(scale_result))
            set scale = result_unwrap(scale_result)
            if not yaza_sql_v2_is_symbol(source, tokens, cursor + 5, 41):
                return err(yaza_sql_v2_parse_error(source, tokens, cursor + 5, "SQL DECIMAL expected ')' after scale at byte "))
            set consumed = 6
        elif not yaza_sql_v2_is_symbol(source, tokens, cursor + 3, 41):
            return err(yaza_sql_v2_parse_error(source, tokens, cursor + 3, "SQL DECIMAL expected ')' or ',' after precision at byte "))
        if scale > precision: return err(yaza_sql_v2_parse_error(source, tokens, cursor + 4, "SQL DECIMAL scale cannot exceed precision at byte "))
        return ok(YazaSqlCreateTypeParseV1(10, consumed, precision, scale))
    else:
        return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL CREATE TABLE type is outside the supported scalar profile at byte "))
    return ok(YazaSqlCreateTypeParseV1(type_id, consumed_type_tokens, 0, 0))

fn yaza_sql_parse_create_check_clause_v1(source: Text, tokens: List[YazaSqlTokenV1], cursor: Number) -> Result[YazaSqlCreateCheckClauseParseV1, Text]:
    let token_count: Number = list_count(tokens)
    if cursor < 0 or cursor >= token_count: return err("SQL CREATE TABLE CHECK clause is missing its column")
    let column_result: Result[YazaSqlNameV2, Text] = yaza_sql_v2_parse_name(source, tokens, cursor, false)
    if not result_is_ok(column_result): return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL CREATE TABLE CHECK requires a column name at byte "))
    let column: YazaSqlNameV2 = result_unwrap(column_result)
    if column.part_count != 1: return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL CREATE TABLE CHECK column name must be unqualified at byte "))
    let operator_index: Number = cursor + column.consumed_tokens
    let comparison_operator: Number = yaza_sql_v2_comparison_code(source, tokens, operator_index)
    if comparison_operator == 0: return err(yaza_sql_v2_parse_error(source, tokens, operator_index, "SQL CREATE TABLE CHECK requires a scalar comparison operator at byte "))
    var literal_index: Number = operator_index + 1
    if literal_index < 0 or literal_index >= token_count: return err(yaza_sql_v2_parse_error(source, tokens, literal_index, "SQL CREATE TABLE CHECK requires a scalar literal at byte "))
    var literal_kind: Number = 0
    var literal_start_byte: Number = -1
    var literal_end_byte: Number = -1
    let literal_token: YazaSqlTokenV1 = list_get(tokens, literal_index)
    if yaza_sql_v2_is_symbol(source, tokens, literal_index, 43) or yaza_sql_v2_is_symbol(source, tokens, literal_index, 45):
        if literal_index + 1 >= token_count or list_get(tokens, literal_index + 1).kind != 3: return err(yaza_sql_v2_parse_error(source, tokens, literal_index, "SQL CREATE TABLE CHECK sign must precede an integer or numeric literal at byte "))
        set literal_kind = 3
        set literal_start_byte = literal_token.start_byte
        set literal_end_byte = list_get(tokens, literal_index + 1).end_byte
        set literal_index = literal_index + 2
    else:
        let is_null_literal: Boolean = literal_token.kind == 1 and yaza_sql_v2_is_keyword(source, tokens, literal_index, "NULL")
        let is_boolean_literal: Boolean = literal_token.kind == 1 and (yaza_sql_v2_is_keyword(source, tokens, literal_index, "TRUE") or yaza_sql_v2_is_keyword(source, tokens, literal_index, "FALSE"))
        if literal_token.kind != 3 and literal_token.kind != 4 and literal_token.kind != 8 and not is_null_literal and not is_boolean_literal: return err(yaza_sql_v2_parse_error(source, tokens, literal_index, "SQL CREATE TABLE CHECK right operand must be a scalar literal at byte "))
        set literal_kind = literal_token.kind
        set literal_start_byte = literal_token.start_byte
        set literal_end_byte = literal_token.end_byte
        set literal_index = literal_index + 1
    let clause: YazaSqlCreateCheckAstV1 = YazaSqlCreateCheckAstV1(column, comparison_operator, literal_kind, literal_start_byte, literal_end_byte)
    return ok(YazaSqlCreateCheckClauseParseV1(clause, literal_index - cursor))

fn yaza_sql_parse_create_table_v1(source: Text) -> Result[YazaSqlCreateTableAstV1, Text]:
    let lexed: Result[List[YazaSqlTokenV1], Text] = yaza_sql_lex_v1(source)
    if not result_is_ok(lexed): return err(result_unwrap_error(lexed))
    let tokens: List[YazaSqlTokenV1] = result_unwrap(lexed)
    let token_count: Number = list_count(tokens)
    if token_count < 2: return err("SQL parser received an invalid token stream")
    if not yaza_sql_v2_is_keyword(source, tokens, 0, "CREATE"):
        return err(yaza_sql_v2_parse_error(source, tokens, 0, "SQL parser expected CREATE at byte "))
    if not yaza_sql_v2_is_keyword(source, tokens, 1, "TABLE"):
        return err(yaza_sql_v2_parse_error(source, tokens, 1, "SQL parser expected TABLE after CREATE at byte "))

    var name_cursor: Number = 2
    if yaza_sql_v2_is_keyword(source, tokens, name_cursor, "IF"):
        if not yaza_sql_v2_is_keyword(source, tokens, name_cursor + 1, "NOT"):
            return err(yaza_sql_v2_parse_error(source, tokens, name_cursor + 1, "SQL CREATE TABLE expected NOT after IF at byte "))
        if not yaza_sql_v2_is_keyword(source, tokens, name_cursor + 2, "EXISTS"):
            return err(yaza_sql_v2_parse_error(source, tokens, name_cursor + 2, "SQL CREATE TABLE expected EXISTS after IF NOT at byte "))
        set name_cursor = name_cursor + 3
    let table_result: Result[YazaSqlNameV2, Text] = yaza_sql_v2_parse_name(source, tokens, name_cursor, false)
    if not result_is_ok(table_result): return err(result_unwrap_error(table_result))
    let table_name: YazaSqlNameV2 = result_unwrap(table_result)
    var cursor: Number = name_cursor + table_name.consumed_tokens
    if not yaza_sql_v2_is_symbol(source, tokens, cursor, 40):
        return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL parser expected '(' before CREATE TABLE columns at byte "))
    set cursor = cursor + 1

    let columns_created: Result[List[YazaSqlCreateColumnAstV1], Text] = list_try_new()
    let keys_created: Result[List[YazaSqlNameV2], Text] = list_try_new()
    let unique_columns_created: Result[List[YazaSqlNameV2], Text] = list_try_new()
    let foreign_keys_created: Result[List[YazaSqlCreateForeignKeyAstV1], Text] = list_try_new()
    let checks_created: Result[List[YazaSqlCreateCheckAstV1], Text] = list_try_new()
    if not result_is_ok(columns_created) or not result_is_ok(keys_created) or not result_is_ok(unique_columns_created) or not result_is_ok(foreign_keys_created) or not result_is_ok(checks_created): return err("SQL CREATE TABLE parser could not allocate bounded schema metadata")
    let columns: List[YazaSqlCreateColumnAstV1] = result_unwrap(columns_created)
    let primary_key_columns: List[YazaSqlNameV2] = result_unwrap(keys_created)
    let unique_columns: List[YazaSqlNameV2] = result_unwrap(unique_columns_created)
    let foreign_keys: List[YazaSqlCreateForeignKeyAstV1] = result_unwrap(foreign_keys_created)
    let check_constraints: List[YazaSqlCreateCheckAstV1] = result_unwrap(checks_created)
    if yaza_sql_v2_is_symbol(source, tokens, cursor, 41):
        return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL CREATE TABLE column list cannot be empty at byte "))

    var table_primary_key_seen: Boolean = false
    var table_unique_seen: Boolean = false
    var definitions_done: Boolean = false
    while not definitions_done:
        if yaza_sql_v2_is_keyword(source, tokens, cursor, "PRIMARY"):
            if table_primary_key_seen or list_count(primary_key_columns) > 0:
                return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL CREATE TABLE may declare only one primary key at byte "))
            if not yaza_sql_v2_is_keyword(source, tokens, cursor + 1, "KEY"):
                return err(yaza_sql_v2_parse_error(source, tokens, cursor + 1, "SQL CREATE TABLE expected KEY after PRIMARY at byte "))
            set table_primary_key_seen = true
            set cursor = cursor + 2
            if not yaza_sql_v2_is_symbol(source, tokens, cursor, 40):
                return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL CREATE TABLE expected '(' after PRIMARY KEY at byte "))
            set cursor = cursor + 1
            var key_done: Boolean = false
            while not key_done:
                let key_name_result: Result[YazaSqlNameV2, Text] = yaza_sql_v2_parse_name(source, tokens, cursor, false)
                if not result_is_ok(key_name_result): return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL CREATE TABLE expected a primary-key column at byte "))
                let key_name: YazaSqlNameV2 = result_unwrap(key_name_result)
                if key_name.part_count != 1: return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL CREATE TABLE primary-key columns must be unqualified at byte "))
                if list_count(primary_key_columns) >= 1024 or not list_try_push(primary_key_columns, key_name):
                    return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL CREATE TABLE primary-key list limit or allocation failure at byte "))
                set cursor = cursor + key_name.consumed_tokens
                if yaza_sql_v2_is_symbol(source, tokens, cursor, 44):
                    set cursor = cursor + 1
                elif yaza_sql_v2_is_symbol(source, tokens, cursor, 41):
                    set cursor = cursor + 1
                    set key_done = true
                else:
                    return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL CREATE TABLE expected ',' or ')' in PRIMARY KEY at byte "))
            if list_count(primary_key_columns) == 0: return err("SQL CREATE TABLE primary key cannot be empty")
            if yaza_sql_v2_is_symbol(source, tokens, cursor, 44):
                set cursor = cursor + 1
            elif yaza_sql_v2_is_symbol(source, tokens, cursor, 41):
                set cursor = cursor + 1
                set definitions_done = true
            else:
                return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL CREATE TABLE expected ',' or ')' after PRIMARY KEY at byte "))
        elif yaza_sql_v2_is_keyword(source, tokens, cursor, "FOREIGN"):
            if list_count(columns) == 0: return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL CREATE TABLE FOREIGN KEY must follow its column definitions at byte "))
            if list_count(foreign_keys) >= 64: return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL CREATE TABLE exceeds the 64 FOREIGN KEY constraint profile at byte "))
            if not yaza_sql_v2_is_keyword(source, tokens, cursor + 1, "KEY"): return err(yaza_sql_v2_parse_error(source, tokens, cursor + 1, "SQL CREATE TABLE expected KEY after FOREIGN at byte "))
            let key_open: Number = cursor + 2
            if not yaza_sql_v2_is_symbol(source, tokens, key_open, 40): return err(yaza_sql_v2_parse_error(source, tokens, key_open, "SQL CREATE TABLE expected '(' after FOREIGN KEY at byte "))
            let local_name_result: Result[YazaSqlNameV2, Text] = yaza_sql_v2_parse_name(source, tokens, key_open + 1, false)
            if not result_is_ok(local_name_result): return err(yaza_sql_v2_parse_error(source, tokens, key_open + 1, "SQL CREATE TABLE FOREIGN KEY requires one local column at byte "))
            let local_name: YazaSqlNameV2 = result_unwrap(local_name_result)
            if local_name.part_count != 1 or not yaza_sql_v2_is_symbol(source, tokens, key_open + 1 + local_name.consumed_tokens, 41): return err(yaza_sql_v2_parse_error(source, tokens, key_open + 1, "SQL CREATE TABLE currently supports one local FOREIGN KEY column at byte "))
            let references_cursor: Number = key_open + 2 + local_name.consumed_tokens
            if not yaza_sql_v2_is_keyword(source, tokens, references_cursor, "REFERENCES"): return err(yaza_sql_v2_parse_error(source, tokens, references_cursor, "SQL CREATE TABLE FOREIGN KEY expected REFERENCES at byte "))
            let parent_table_result: Result[YazaSqlNameV2, Text] = yaza_sql_v2_parse_name(source, tokens, references_cursor + 1, false)
            if not result_is_ok(parent_table_result): return err(yaza_sql_v2_parse_error(source, tokens, references_cursor + 1, "SQL CREATE TABLE FOREIGN KEY expected a referenced table at byte "))
            let parent_table: YazaSqlNameV2 = result_unwrap(parent_table_result)
            let parent_open: Number = references_cursor + 1 + parent_table.consumed_tokens
            if parent_table.part_count != 1 or not yaza_sql_v2_is_symbol(source, tokens, parent_open, 40): return err(yaza_sql_v2_parse_error(source, tokens, parent_open, "SQL CREATE TABLE FOREIGN KEY requires one unqualified referenced table and '(' at byte "))
            let parent_column_result: Result[YazaSqlNameV2, Text] = yaza_sql_v2_parse_name(source, tokens, parent_open + 1, false)
            if not result_is_ok(parent_column_result): return err(yaza_sql_v2_parse_error(source, tokens, parent_open + 1, "SQL CREATE TABLE FOREIGN KEY expected one referenced column at byte "))
            let parent_column: YazaSqlNameV2 = result_unwrap(parent_column_result)
            let parent_close: Number = parent_open + 1 + parent_column.consumed_tokens
            if parent_column.part_count != 1 or not yaza_sql_v2_is_symbol(source, tokens, parent_close, 41): return err(yaza_sql_v2_parse_error(source, tokens, parent_close, "SQL CREATE TABLE currently supports one referenced FOREIGN KEY column at byte "))
            var cursor_after_reference: Number = parent_close + 1
            var delete_action_seen: Boolean = false
            var update_action_seen: Boolean = false
            while yaza_sql_v2_is_keyword(source, tokens, cursor_after_reference, "ON"):
                if yaza_sql_v2_is_keyword(source, tokens, cursor_after_reference + 1, "DELETE"):
                    if delete_action_seen: return err(yaza_sql_v2_parse_error(source, tokens, cursor_after_reference, "SQL CREATE TABLE repeats its FOREIGN KEY ON DELETE action at byte "))
                    set delete_action_seen = true
                elif yaza_sql_v2_is_keyword(source, tokens, cursor_after_reference + 1, "UPDATE"):
                    if update_action_seen: return err(yaza_sql_v2_parse_error(source, tokens, cursor_after_reference, "SQL CREATE TABLE repeats its FOREIGN KEY ON UPDATE action at byte "))
                    set update_action_seen = true
                else:
                    return err(yaza_sql_v2_parse_error(source, tokens, cursor_after_reference + 1, "SQL CREATE TABLE FOREIGN KEY action must be ON DELETE or ON UPDATE at byte "))
                if not yaza_sql_v2_is_keyword(source, tokens, cursor_after_reference + 2, "RESTRICT") and not yaza_sql_v2_is_keyword(source, tokens, cursor_after_reference + 2, "CASCADE") and not yaza_sql_v2_is_keyword(source, tokens, cursor_after_reference + 2, "SET"):
                    return err(yaza_sql_v2_parse_error(source, tokens, cursor_after_reference + 2, "SQL CREATE TABLE currently supports RESTRICT, CASCADE, or SET NULL at byte "))
                if yaza_sql_v2_is_keyword(source, tokens, cursor_after_reference + 2, "SET"):
                    if not yaza_sql_v2_is_keyword(source, tokens, cursor_after_reference + 3, "NULL"):
                        return err(yaza_sql_v2_parse_error(source, tokens, cursor_after_reference + 3, "SQL CREATE TABLE expected NULL after SET at byte "))
                    set cursor_after_reference = cursor_after_reference + 4
                else:
                    set cursor_after_reference = cursor_after_reference + 3
            if not list_try_push(foreign_keys, YazaSqlCreateForeignKeyAstV1(local_name, parent_table, parent_column)): return err("SQL CREATE TABLE could not retain FOREIGN KEY metadata")
            set table_unique_seen = true
            set cursor = cursor_after_reference
            if yaza_sql_v2_is_symbol(source, tokens, cursor, 44):
                set cursor = cursor + 1
            elif yaza_sql_v2_is_symbol(source, tokens, cursor, 41):
                set cursor = cursor + 1
                set definitions_done = true
            else:
                return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL CREATE TABLE expected ',' or ')' after FOREIGN KEY at byte "))
        elif yaza_sql_v2_is_keyword(source, tokens, cursor, "CHECK"):
            if list_count(columns) == 0: return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL CREATE TABLE CHECK must follow its column definitions at byte "))
            if list_count(check_constraints) >= 64: return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL CREATE TABLE exceeds the 64 CHECK constraint profile at byte "))
            let check_open: Number = cursor + 1
            if not yaza_sql_v2_is_symbol(source, tokens, check_open, 40): return err(yaza_sql_v2_parse_error(source, tokens, check_open, "SQL CREATE TABLE expected '(' after CHECK at byte "))
            var clause_cursor: Number = check_open + 1
            var check_done: Boolean = false
            while not check_done:
                if list_count(check_constraints) >= 64: return err(yaza_sql_v2_parse_error(source, tokens, clause_cursor, "SQL CREATE TABLE CHECK conjunction exceeds the 64-clause profile at byte "))
                let parsed_clause: YazaSqlCreateCheckClauseParseV1 = yaza_sql_parse_create_check_clause_v1(source, tokens, clause_cursor)?
                if not list_try_push(check_constraints, parsed_clause.clause): return err("SQL CREATE TABLE could not retain CHECK metadata")
                set clause_cursor = clause_cursor + parsed_clause.consumed_tokens
                if yaza_sql_v2_is_symbol(source, tokens, clause_cursor, 41):
                    set check_done = true
                elif yaza_sql_v2_is_keyword(source, tokens, clause_cursor, "AND"):
                    set clause_cursor = clause_cursor + 1
                else:
                    return err(yaza_sql_v2_parse_error(source, tokens, clause_cursor, "SQL CREATE TABLE CHECK supports comparison terms joined by AND at byte "))
            set table_unique_seen = true
            set cursor = clause_cursor + 1
            if yaza_sql_v2_is_symbol(source, tokens, cursor, 44):
                set cursor = cursor + 1
            elif yaza_sql_v2_is_symbol(source, tokens, cursor, 41):
                set cursor = cursor + 1
                set definitions_done = true
            else:
                return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL CREATE TABLE expected ',' or ')' after CHECK at byte "))
        elif yaza_sql_v2_is_keyword(source, tokens, cursor, "UNIQUE"):
            if list_count(columns) == 0:
                return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL CREATE TABLE table-level UNIQUE must follow its column definitions at byte "))
