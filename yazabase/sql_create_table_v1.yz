        let parent_table: YazaSqlTableSchemaV1 = list_get(catalog.tables, parent_table_index)
        var parent_ordinal: Number = 0
        while parent_ordinal < list_count(parent_table.columns) and not yaza_sql_bind_v1_identifier_matches(source, foreign_ast.referenced_column.first_token, list_get(parent_table.columns, parent_ordinal).name):
            set parent_ordinal = parent_ordinal + 1
        if parent_ordinal >= list_count(parent_table.columns): return err(yaza_sql_create_table_diagnostic_at_v1(source, foreign_ast.referenced_column.start_byte, foreign_ast.referenced_column.end_byte, 3002, "SQL CREATE TABLE FOREIGN KEY references an unknown parent column"))
        let local_column: YazaSqlColumnSchemaV1 = YazaSqlColumnSchemaV1(local_text, list_get(create.columns, local_ordinal).type_id, list_get(create.columns, local_ordinal).nullable, local_ordinal, list_get(create.columns, local_ordinal).precision, list_get(create.columns, local_ordinal).scale, "")
        let parent_column: YazaSqlColumnSchemaV1 = list_get(parent_table.columns, parent_ordinal)
        if local_column.type_id != parent_column.type_id or local_column.precision != parent_column.precision or local_column.scale != parent_column.scale:
            return err(yaza_sql_create_table_diagnostic_at_v1(source, foreign_ast.local_column.start_byte, foreign_ast.referenced_column.end_byte, 3003, "SQL CREATE TABLE FOREIGN KEY columns must have identical scalar type and DECIMAL dimensions"))
        var prior_foreign: Number = 0
        while prior_foreign < list_count(foreign_keys):
            if list_get(foreign_keys, prior_foreign).local_column_ordinal == local_ordinal and list_get(foreign_keys, prior_foreign).referenced_table_id == parent_table.table_id and list_get(foreign_keys, prior_foreign).referenced_column_ordinal == parent_ordinal:
                return err(yaza_sql_create_table_diagnostic_at_v1(source, foreign_ast.local_column.start_byte, foreign_ast.referenced_column.end_byte, 3002, "SQL CREATE TABLE repeats a FOREIGN KEY relationship"))
            set prior_foreign = prior_foreign + 1
        if not list_try_push(foreign_keys, YazaSqlCreateForeignKeyPlanV1(local_ordinal, parent_table.table_id, parent_ordinal)):
            return err(yaza_sql_create_table_diagnostic_at_v1(source, foreign_ast.local_column.start_byte, foreign_ast.referenced_column.end_byte, 3005, "SQL CREATE TABLE binder could not record a FOREIGN KEY"))
        set foreign_index = foreign_index + 1

    var check_index: Number = 0
    while check_index < list_count(create.check_constraints):
        let check_ast: YazaSqlCreateCheckAstV1 = list_get(create.check_constraints, check_index)
        if not yaza_sql_bind_v1_name_valid(source, check_ast.column_name) or check_ast.column_name.part_count != 1 or check_ast.comparison_operator < 1 or check_ast.comparison_operator > 6 or check_ast.literal_start_byte < 0 or check_ast.literal_end_byte <= check_ast.literal_start_byte or check_ast.literal_end_byte > text_length(source):
