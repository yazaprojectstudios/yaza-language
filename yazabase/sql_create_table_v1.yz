            return err(yaza_sql_create_table_diagnostic_at_v1(source, definition.name.start_byte, definition.name.end_byte, 3002, result_unwrap_error(name_result)))
        let name: Text = result_unwrap(name_result)
        var earlier: Number = 0
        while earlier < list_count(names):
            if list_get(names, earlier) == name:
                return err(yaza_sql_create_table_diagnostic_at_v1(source, definition.name.start_byte, definition.name.end_byte, 3002, "SQL CREATE TABLE has duplicate column names"))
            set earlier = earlier + 1
        if not list_try_push(names, name):
            return err(yaza_sql_create_table_diagnostic_at_v1(source, definition.name.start_byte, definition.name.end_byte, 3005, "SQL CREATE TABLE binder could not record a column name"))
        set column_index = column_index + 1

    var key_index: Number = 0
    while key_index < list_count(create.primary_key_columns):
        let key_name: YazaSqlNameV2 = list_get(create.primary_key_columns, key_index)
        if not yaza_sql_bind_v1_name_valid(source, key_name) or key_name.part_count != 1:
