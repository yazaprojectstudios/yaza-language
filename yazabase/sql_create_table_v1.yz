                return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL CREATE TABLE expected '(' after UNIQUE at byte "))
            set cursor = cursor + 1
            let unique_name_result: Result[YazaSqlNameV2, Text] = yaza_sql_v2_parse_name(source, tokens, cursor, false)
            if not result_is_ok(unique_name_result): return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL CREATE TABLE expected one UNIQUE column at byte "))
            let unique_name: YazaSqlNameV2 = result_unwrap(unique_name_result)
            if unique_name.part_count != 1: return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL CREATE TABLE UNIQUE column names must be unqualified at byte "))
            if not list_try_push(unique_columns, unique_name): return err("SQL CREATE TABLE UNIQUE metadata allocation failed")
            set cursor = cursor + unique_name.consumed_tokens
            if not yaza_sql_v2_is_symbol(source, tokens, cursor, 41):
                return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL CREATE TABLE currently supports one column per UNIQUE constraint at byte "))
            set cursor = cursor + 1
            if yaza_sql_v2_is_symbol(source, tokens, cursor, 44):
