                    if default_kind != 0: return err(yaza_sql_v2_parse_error(source, tokens, cursor, "SQL CREATE TABLE column repeats DEFAULT at byte "))
                    let value_cursor: Number = cursor + 1
                    if (yaza_sql_v2_is_symbol(source, tokens, value_cursor, 45) or yaza_sql_v2_is_symbol(source, tokens, value_cursor, 43)) and list_get(tokens, value_cursor + 1).kind == 3:
                        let sign_token: YazaSqlTokenV1 = list_get(tokens, value_cursor)
                        let number_token: YazaSqlTokenV1 = list_get(tokens, value_cursor + 1)
                        set default_kind = 3
                        set default_start_byte = sign_token.start_byte
                        set default_end_byte = number_token.end_byte
