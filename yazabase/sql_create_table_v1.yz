                let decoded_default: Result[Text, Text] = yaza_sql_decode_text_literal_v1(source, definition.default_start_byte, definition.default_end_byte)
                if not result_is_ok(decoded_default): return err(yaza_sql_create_table_diagnostic_at_v1(source, definition.default_start_byte, definition.default_end_byte, 3003, "SQL CREATE TABLE DEFAULT text literal is not valid bounded UTF-8"))
            let default_slice: Result[Text, Text] = text_try_slice(source, definition.default_start_byte, definition.default_end_byte - definition.default_start_byte)
            if not result_is_ok(default_slice): return err(yaza_sql_create_table_diagnostic_at_v1(source, definition.default_start_byte, definition.default_end_byte, 3005, "SQL CREATE TABLE could not retain its DEFAULT literal"))
            set default_expression = result_unwrap(default_slice)
        if not list_try_push(columns, YazaSqlColumnSchemaV1(list_get(names, column_index), definition.type_id, nullable, column_index, definition.precision, definition.scale, default_expression)):
            return err(yaza_sql_create_table_diagnostic_at_v1(source, definition.name.start_byte, definition.name.end_byte, 3005, "SQL CREATE TABLE binder could not build its bound columns"))
        if not list_try_push(default_expressions, default_expression): return err(yaza_sql_create_table_diagnostic_at_v1(source, definition.name.start_byte, definition.name.end_byte, 3005, "SQL CREATE TABLE binder could not retain column defaults"))
        set column_index = column_index + 1
    return ok(YazaSqlCreateTablePlanV1(1, catalog.version, table_name, columns, key_ordinals, unique_ordinals, default_expressions, foreign_keys, check_constraints))
