    if list_count(create.unique_columns) > 64:
        return err(yaza_sql_create_table_diagnostic_at_v1(source, create.start_byte, create.end_byte, 3004, "SQL CREATE TABLE exceeds the 64 active secondary-index profile for UNIQUE constraints"))
    var unique_index: Number = 0
    while unique_index < list_count(create.unique_columns):
        let unique_name: YazaSqlNameV2 = list_get(create.unique_columns, unique_index)
        if not yaza_sql_bind_v1_name_valid(source, unique_name) or unique_name.part_count != 1:
