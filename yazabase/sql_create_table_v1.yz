    if list_count(create.check_constraints) > 64: return err(yaza_sql_create_table_diagnostic_at_v1(source, create.start_byte, create.end_byte, 3004, "SQL CREATE TABLE exceeds the 64 CHECK constraint profile"))
    if not list_try_reserve(columns, column_count) or not list_try_reserve(names, column_count) or not list_try_reserve(key_ordinals, list_count(create.primary_key_columns)) or not list_try_reserve(unique_ordinals, list_count(create.unique_columns)) or not list_try_reserve(default_expressions, column_count) or not list_try_reserve(foreign_keys, list_count(create.foreign_keys)) or not list_try_reserve(check_constraints, list_count(create.check_constraints)):
        return err(yaza_sql_create_table_diagnostic_at_v1(source, create.start_byte, create.end_byte, 3005, "SQL CREATE TABLE binder could not reserve schema metadata"))

