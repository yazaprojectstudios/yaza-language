        if definition.type_id != 1 and definition.type_id != 2 and definition.type_id != 3 and definition.type_id != 4 and definition.type_id != 6 and definition.type_id != 9 and definition.type_id != 10 and definition.type_id != 11 and definition.type_id != 12 and definition.type_id != 13 and definition.type_id != 14 and definition.type_id != 15 and definition.type_id != 16:
            return err(yaza_sql_create_table_diagnostic_at_v1(source, definition.name.start_byte, definition.name.end_byte, 3003, "SQL CREATE TABLE type is outside the supported scalar profile"))
        if definition.type_id == 10 and not yaza_sql_decimal_parameters_valid_v1(definition.precision, definition.scale):
            return err(yaza_sql_create_table_diagnostic_at_v1(source, definition.name.start_byte, definition.name.end_byte, 3003, "SQL CREATE TABLE DECIMAL precision or scale is invalid"))
        elif definition.type_id != 10 and (definition.precision != 0 or definition.scale != 0):
            return err(yaza_sql_create_table_diagnostic_at_v1(source, definition.name.start_byte, definition.name.end_byte, 3006, "SQL CREATE TABLE non-DECIMAL type has unexpected precision metadata"))
        let name_result: Result[Text, Text] = yaza_sql_create_table_identifier_v1(source, definition.name.first_token)
