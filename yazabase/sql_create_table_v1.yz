            if not result_is_ok(type_result): return err(result_unwrap_error(type_result))
            let parsed_type: YazaSqlCreateTypeParseV1 = result_unwrap(type_result)
            set cursor = cursor + parsed_type.consumed_tokens

            var nullable: Boolean = true
            var nullability_seen: Boolean = false
            var column_primary_key_seen: Boolean = false
            var column_unique_seen: Boolean = false
            var default_kind: Number = 0
            var default_start_byte: Number = -1
            var default_end_byte: Number = -1
            var constraints_done: Boolean = false
            while not constraints_done:
                if yaza_sql_v2_is_keyword(source, tokens, cursor, "NOT"):
