        let check_name_result: Result[Text, Text] = yaza_sql_create_table_identifier_v1(source, check_ast.column_name.first_token)
        if not result_is_ok(check_name_result): return err(yaza_sql_create_table_diagnostic_at_v1(source, check_ast.column_name.start_byte, check_ast.column_name.end_byte, 3002, result_unwrap_error(check_name_result)))
        let check_name: Text = result_unwrap(check_name_result)
        var check_ordinal: Number = 0
        while check_ordinal < list_count(names) and list_get(names, check_ordinal) != check_name:
            set check_ordinal = check_ordinal + 1
        if check_ordinal >= list_count(names): return err(yaza_sql_create_table_diagnostic_at_v1(source, check_ast.column_name.start_byte, check_ast.column_name.end_byte, 3002, "SQL CREATE TABLE CHECK references an unknown column"))
        let check_definition: YazaSqlCreateColumnAstV1 = list_get(create.columns, check_ordinal)
        var check_nullable: Boolean = check_definition.nullable
        var check_key_index: Number = 0
        while check_key_index < list_count(key_ordinals):
            if list_get(key_ordinals, check_key_index) == check_ordinal: set check_nullable = false
            set check_key_index = check_key_index + 1
        let check_column: YazaSqlColumnSchemaV1 = YazaSqlColumnSchemaV1(check_name, check_definition.type_id, check_nullable, check_ordinal, check_definition.precision, check_definition.scale, "")
        if not yaza_sql_bind_v1_comparison_valid(check_column.type_id, check_ast.comparison_operator): return err(yaza_sql_create_table_diagnostic_at_v1(source, check_ast.column_name.start_byte, check_ast.literal_end_byte, 3003, "SQL CREATE TABLE CHECK comparison is not supported for this scalar type"))
        let check_token: YazaSqlTokenV1 = YazaSqlTokenV1(check_ast.literal_kind, check_ast.literal_start_byte, check_ast.literal_end_byte)
