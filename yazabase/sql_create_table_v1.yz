        if unique_ordinal >= list_count(names): return err(yaza_sql_create_table_diagnostic_at_v1(source, unique_name.start_byte, unique_name.end_byte, 3002, "SQL CREATE TABLE UNIQUE constraint references an unknown column"))
        var earlier_unique: Number = 0
