fn yaza_sql_create_table_identifier_v1(source: Text, token: YazaSqlTokenV1) -> Result[Text, Text]:
    if token.kind != 1 or token.start_byte < 0 or token.end_byte <= token.start_byte or token.end_byte > text_length(source):
        return err("SQL CREATE TABLE binder supports bounded unquoted identifiers only")
    let byte_count: Number = token.end_byte - token.start_byte
    if byte_count > 128: return err("SQL CREATE TABLE identifier exceeds 128 bytes")
    let bytes_result: Result[Bytes, Text] = bytes_try_new_zeroed(byte_count)
    if not result_is_ok(bytes_result): return err(result_unwrap_error(bytes_result))
    let bytes: Bytes = result_unwrap(bytes_result)
    var index: Number = 0
    while index < byte_count:
        var byte: Number = text_byte(source, token.start_byte + index)
        if (index == 0 and not ((byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95)) or (index > 0 and not ((byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or (byte >= 48 and byte <= 57) or byte == 95 or byte == 36)):
            return err("SQL CREATE TABLE identifiers must use ASCII letters, digits, '_' or '$'")
        if byte >= 65 and byte <= 90: set byte = byte + 32
        if not bytes_try_set(bytes, index, byte): return err("SQL CREATE TABLE identifier normalization failed")
        set index = index + 1
    return bytes_try_to_text(bytes)

fn yaza_sql_create_table_diagnostic_at_v1(source: Text, start_byte: Number, end_byte: Number, code: Number, message: Text) -> YazaSqlDiagnosticV1:
    var bounded_start: Number = start_byte
    if bounded_start < 0: set bounded_start = 0
    if bounded_start > text_length(source): set bounded_start = text_length(source)
    var bounded_end: Number = end_byte
    if bounded_end < bounded_start: set bounded_end = bounded_start
    if bounded_end > text_length(source): set bounded_end = text_length(source)
    let location_result: Result[YazaSqlSourceLocationV1, Text] = yaza_sql_v1_location(source, bounded_start)
    var line: Number = 1
    var column: Number = 1
    if result_is_ok(location_result):
        let location: YazaSqlSourceLocationV1 = result_unwrap(location_result)
        set line = location.line
        set column = location.column
    return YazaSqlDiagnosticV1(3, code, bounded_start, bounded_end, line, column, message)

fn yaza_sql_bind_create_table_v1(source: Text, create: YazaSqlCreateTableAstV1, catalog: YazaSqlCatalogSnapshotV1) -> Result[YazaSqlCreateTablePlanV1, YazaSqlDiagnosticV1]:
    if create.version != 1 or not yaza_sql_bind_v1_span_valid(source, create.start_byte, create.end_byte):
        return err(yaza_sql_create_table_diagnostic_at_v1(source, create.start_byte, create.end_byte, 3006, "SQL CREATE TABLE binder received an invalid AST version or source span"))
    if catalog.version < 1 or list_count(catalog.tables) > 1024 or list_count(create.columns) < 1 or list_count(create.columns) > 1024:
        return err(yaza_sql_create_table_diagnostic_at_v1(source, create.start_byte, create.end_byte, 3004, "SQL CREATE TABLE catalog or schema exceeds its supported bound"))
    if not yaza_sql_bind_v1_name_valid(source, create.table_name) or create.table_name.part_count != 1:
        return err(yaza_sql_create_table_diagnostic_at_v1(source, create.table_name.start_byte, create.table_name.end_byte, 3002, "SQL CREATE TABLE supports one-part table names only"))
    let table_name_result: Result[Text, Text] = yaza_sql_create_table_identifier_v1(source, create.table_name.first_token)
