    let columns_result: Result[List[YazaSqlColumnSchemaV1], Text] = list_try_new()
    let names_result: Result[List[Text], Text] = list_try_new()
    let key_result: Result[List[Number], Text] = list_try_new()
    let unique_result: Result[List[Number], Text] = list_try_new()
    let defaults_result: Result[List[Text], Text] = list_try_new()
    let foreign_keys_result: Result[List[YazaSqlCreateForeignKeyPlanV1], Text] = list_try_new()
    let checks_result: Result[List[YazaSqlCreateCheckPlanV1], Text] = list_try_new()
    if not result_is_ok(columns_result) or not result_is_ok(names_result) or not result_is_ok(key_result) or not result_is_ok(unique_result) or not result_is_ok(defaults_result) or not result_is_ok(foreign_keys_result) or not result_is_ok(checks_result):
        return err(yaza_sql_create_table_diagnostic_at_v1(source, create.start_byte, create.end_byte, 3005, "SQL CREATE TABLE binder could not allocate schema metadata"))
