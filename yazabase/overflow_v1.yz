use "./page_v1"

shape YazaDbOverflowRefV1:
    first_page_id: Number
    total_length: Number
    checksum: Number
    reserved: Number

shape YazaDbOverflowPageV1:
    header: YazaDbPageHeaderV1
    next_page_id: Number
    payload: Bytes

shape YazaDbOverflowChainV1:
    reference: YazaDbOverflowRefV1
    pages: List[Bytes]

fn yaza_db_overflow_threshold_v1() -> Number:
    return 4096

fn yaza_db_overflow_payload_capacity_v1() -> Number:
    return yaza_db_page_size_v1() - yaza_db_page_header_size_v1()

fn yaza_db_overflow_ref_encode_v1(reference: YazaDbOverflowRefV1) -> Result[Bytes, Text]:
    if reference.first_page_id < 2 or reference.first_page_id > 4611686018427387903: return err("YDBv1 overflow reference has an invalid first page ID")
    if reference.total_length <= yaza_db_overflow_threshold_v1() or reference.total_length > 67108864: return err("YDBv1 overflow reference length is outside its supported bound")
    if reference.checksum < 0 or reference.checksum > 4294967295 or reference.reserved != 0: return err("YDBv1 overflow reference checksum or reserved field is invalid")
    let encoded: Bytes = bytes_try_new_zeroed(24)?
    if not yaza_db_write_uint_le_v1(encoded, 0, reference.first_page_id, 8): return err("YDBv1 overflow first page ID could not be encoded")
    if not yaza_db_write_uint_le_v1(encoded, 8, reference.total_length, 8): return err("YDBv1 overflow total length could not be encoded")
    if not yaza_db_write_uint_le_v1(encoded, 16, reference.checksum, 4): return err("YDBv1 overflow checksum could not be encoded")
    if not yaza_db_write_uint_le_v1(encoded, 20, 0, 4): return err("YDBv1 overflow reserved field could not be cleared")
    return ok(encoded)

fn yaza_db_overflow_ref_decode_v1(encoded: Bytes) -> Result[YazaDbOverflowRefV1, Text]:
    if bytes_length(encoded) != 24: return err("YDBv1 overflow reference must be exactly 24 bytes")
    let first_page_id: Number = yaza_db_read_uint_le_v1(encoded, 0, 8)?
    let total_length: Number = yaza_db_read_uint_le_v1(encoded, 8, 8)?
    let checksum: Number = yaza_db_read_uint_le_v1(encoded, 16, 4)?
    let reserved: Number = yaza_db_read_uint_le_v1(encoded, 20, 4)?
    let reference: YazaDbOverflowRefV1 = YazaDbOverflowRefV1(first_page_id, total_length, checksum, reserved)
    let ignored_validation: Bytes = yaza_db_overflow_ref_encode_v1(reference)?
    return ok(reference)

fn yaza_db_overflow_page_encode_v1(page_id: Number, page_lsn: Number, next_page_id: Number, payload: Bytes) -> Result[Bytes, Text]:
    let payload_length: Number = bytes_length(payload)
    if page_id < 2 or page_id > 4611686018427387903 or page_lsn < 0: return err("YDBv1 overflow page identity or LSN is invalid")
    if next_page_id != 0 and (next_page_id < 2 or next_page_id > 4611686018427387903 or next_page_id == page_id): return err("YDBv1 overflow next page ID is invalid")
    if payload_length < 1 or payload_length > yaza_db_overflow_payload_capacity_v1(): return err("YDBv1 overflow page payload length is invalid")
    let page: Bytes = yaza_db_page_new_v1(page_id, page_lsn, 3, 0)?
    let data_start: Number = yaza_db_page_size_v1() - payload_length
    var encoded_next: Number = 0
    if next_page_id != 0: set encoded_next = next_page_id * 2
    if not yaza_db_write_uint_le_v1(page, 16, payload_length, 2): return err("YDBv1 overflow space_used could not be written")
    if not yaza_db_write_uint_le_v1(page, 18, data_start, 2): return err("YDBv1 overflow data_start could not be written")
    if not yaza_db_write_uint_le_v1(page, 32, encoded_next, 8): return err("YDBv1 overflow next pointer could not be written")
    if not yaza_db_write_bytes_v1(page, data_start, payload): return err("YDBv1 overflow payload could not be copied")
    return yaza_db_page_finalize_v1(page)

fn yaza_db_overflow_page_decode_v1(page: Bytes, expected_page_id: Number) -> Result[YazaDbOverflowPageV1, Text]:
    let header: YazaDbPageHeaderV1 = yaza_db_page_header_decode_v1(page, expected_page_id)?
    if header.page_type != 3: return err("YDBv1 page is not an OVERFLOW page")
    let payload_length: Number = yaza_db_page_size_v1() - header.data_start
    if payload_length < 1 or payload_length > yaza_db_overflow_payload_capacity_v1(): return err("YDBv1 overflow payload range is invalid")
    let payload: Bytes = bytes_try_slice(page, header.data_start, payload_length)?
    return ok(YazaDbOverflowPageV1(header, header.upper / 2, payload))

fn yaza_db_overflow_encode_chain_v1(value: Bytes, page_ids: List[Number], page_lsn: Number) -> Result[YazaDbOverflowChainV1, Text]:
    let total_length: Number = bytes_length(value)
    if page_lsn < 0 or total_length <= yaza_db_overflow_threshold_v1(): return err("YDBv1 overflow chain requires a value larger than 4 KiB and a non-negative LSN")
    let capacity: Number = yaza_db_overflow_payload_capacity_v1()
    let expected_count: Number = (total_length + capacity - 1) / capacity
    if list_count(page_ids) != expected_count: return err("YDBv1 overflow page-ID count does not match the value length")
    var previous_page_id: Number = 1
    var index: Number = 0
    while index < expected_count:
        let page_id: Number = list_get(page_ids, index)
        if page_id < 2 or page_id > 4611686018427387903 or page_id <= previous_page_id: return err("YDBv1 overflow page IDs must be valid and strictly increasing")
        set previous_page_id = page_id
        set index = index + 1
    let pages_result: Result[List[Bytes], Text] = list_try_new()
    if not result_is_ok(pages_result): return err(result_unwrap_error(pages_result))
    let pages: List[Bytes] = result_unwrap(pages_result)
    if not list_try_reserve(pages, expected_count): return err("YDBv1 overflow page-list reservation failed")
    var offset: Number = 0
    set index = 0
    while index < expected_count:
        let page_id: Number = list_get(page_ids, index)
        var next_page_id: Number = 0
        if index + 1 < expected_count: set next_page_id = list_get(page_ids, index + 1)
        var payload_length: Number = capacity
        if payload_length > total_length - offset: set payload_length = total_length - offset
        let payload: Bytes = bytes_try_slice(value, offset, payload_length)?
        let page: Bytes = yaza_db_overflow_page_encode_v1(page_id, page_lsn, next_page_id, payload)?
        if not list_try_push(pages, page): return err("YDBv1 overflow page-list growth failed")
        set offset = offset + payload_length
        set index = index + 1
    let reference: YazaDbOverflowRefV1 = YazaDbOverflowRefV1(list_get(page_ids, 0), total_length, bytes_ydbv1_checksum(value), 0)
    return ok(YazaDbOverflowChainV1(reference, pages))

fn yaza_db_overflow_decode_chain_v1(pages: List[Bytes], reference: YazaDbOverflowRefV1) -> Result[Bytes, Text]:
    let ignored_reference_bytes: Bytes = yaza_db_overflow_ref_encode_v1(reference)?
    let capacity: Number = yaza_db_overflow_payload_capacity_v1()
    let expected_count: Number = (reference.total_length + capacity - 1) / capacity
    if list_count(pages) != expected_count: return err("YDBv1 overflow chain page count does not match its reference")
    let output: Bytes = bytes_try_new_zeroed(reference.total_length)?
    var expected_page_id: Number = reference.first_page_id
    var offset: Number = 0
    var index: Number = 0
    while index < expected_count:
        let page: Bytes = list_get(pages, index)
        let decoded: YazaDbOverflowPageV1 = yaza_db_overflow_page_decode_v1(page, expected_page_id)?
        var expected_payload_length: Number = capacity
        if expected_payload_length > reference.total_length - offset: set expected_payload_length = reference.total_length - offset
        if bytes_length(decoded.payload) != expected_payload_length: return err("YDBv1 overflow page has an unexpected payload length")
        if not yaza_db_write_bytes_v1(output, offset, decoded.payload): return err("YDBv1 overflow payload could not be reconstructed")
        if index + 1 == expected_count:
            if decoded.next_page_id != 0: return err("YDBv1 overflow chain has pages after its declared end")
        else:
            if decoded.next_page_id <= expected_page_id: return err("YDBv1 overflow chain is cyclic or non-canonical")
            set expected_page_id = decoded.next_page_id
        set offset = offset + expected_payload_length
        set index = index + 1
    if bytes_ydbv1_checksum(output) != reference.checksum: return err("YDBv1 overflow value checksum mismatch")
    return ok(output)
