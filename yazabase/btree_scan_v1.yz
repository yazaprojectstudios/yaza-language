    return ok(scan.rows)

# Bounded continuation read for streaming scans and resumable index builds.
# The physical cursor seeks by the full clustered key and returns rows strictly
# after it, retaining at most `row_limit` visible rows in the arena.
fn yaza_db_btree_read_rows_after_key_for_schema_v1(file: Number, file_header: YazaDbFileHeaderV1, root_page_id: Number, columns: List[YazaSqlColumnSchemaV1], schema_version: Number, key_ordinals: List[Number], visible_ts: Number, start_after_key: Bytes, row_limit: Number) -> Result[List[YazaDbRowV1], Text]:
    let has_start_after: Boolean = bytes_length(start_after_key) > 0
    let scan: YazaDbBtreeScanResultV1 = yaza_db_btree_read_rows_internal_v1(0, bytes_from_text(""), 0, file, file_header, root_page_id, columns, schema_version, key_ordinals, visible_ts, row_limit, true, 0, List[YazaDbTxnStatusV1](), false, has_start_after, start_after_key)?
    return ok(scan.rows)

fn yaza_db_btree_key_has_prefix_v1(key: Bytes, prefix: Bytes) -> Boolean:
    if bytes_length(prefix) < 1 or bytes_length(prefix) > bytes_length(key): return false
    var index: Number = 0
    while index < bytes_length(prefix):
        if bytes_get(key, index) != bytes_get(prefix, index): return false
        set index = index + 1
    return true

# Bounded equality-range scan for composite keys whose leading component is
# known. The prefix is encoded with the same key codec as the full index key;
# ordered byte comparison lets the cursor seek once, then stop at the first
# key outside that leading-component range.
fn yaza_db_btree_read_rows_with_key_prefix_and_pool_v1(file: Number, file_header: YazaDbFileHeaderV1, root_page_id: Number, columns: List[YazaSqlColumnSchemaV1], schema_version: Number, key_ordinals: List[Number], visible_ts: Number, prefix: Bytes, row_limit: Number, buffer_pool: Option[YazaDbBufferPoolV1]) -> Result[List[YazaDbRowV1], Text]:
    if visible_ts < 1 or bytes_length(prefix) < 1 or bytes_length(prefix) > 2048 or row_limit < 0 or row_limit > yaza_db_btree_max_rows_v1():
        return err("YDBv1 B+Tree prefix-scan bounds are invalid")
    let rows_result: Result[List[YazaDbRowV1], Text] = list_try_new()
    if not result_is_ok(rows_result): return err(result_unwrap_error(rows_result))
    let rows: List[YazaDbRowV1] = result_unwrap(rows_result)
    if row_limit == 0: return ok(rows)
    let cache: YazaDbBtreePageValidationCacheV1 = yaza_db_btree_page_validation_cache_new_with_pool_v1(file, file_header, buffer_pool, List[Number]())?
    let cursor: YazaDbBtreeSeekPathV1 = yaza_db_btree_seek_leaf_internal_cached_v1(file, file_header, root_page_id, prefix, true, cache)?
    var current: YazaDbBtreeSeekPathV1 = cursor
    var total_page_reads: Number = cursor.page_reads
    var pages_scanned: Number = 0
    var first_leaf: Boolean = true
    var has_last_key: Boolean = false
    var last_key: Bytes = bytes_from_text("")
    while true:
        if pages_scanned >= yaza_db_btree_max_pages_v1() or pages_scanned >= file_header.page_count - 2:
            return err("YDBv1 B+Tree prefix scan exceeded its page-visit budget")
        if total_page_reads > yaza_db_btree_max_page_reads_v1(): return err("YDBv1 B+Tree prefix scan exceeded its page-read budget")
        let page: Bytes = current.leaf_page
        let page_id: Number = current.leaf_page_id
        let header: YazaDbPageHeaderV1 = current.leaf_header
        if header.page_type != 1 or header.level != 0: return err("YDBv1 B+Tree prefix cursor did not resolve to a leaf")
        let low_fence: Bytes = yaza_db_btree_fence_bytes_v1(page, header, true)?
        let high_fence: Bytes = yaza_db_btree_fence_bytes_v1(page, header, false)?
        var slot_index: Number = 0
        if first_leaf:
            set slot_index = yaza_db_page_lower_bound_validated_header_v1(page, header, prefix)?
            set first_leaf = false
        while slot_index < header.count:
            let slot: YazaDbPageSlotV1 = yaza_db_page_slot_from_validated_header_v1(page, header, slot_index)?
            let key: Bytes = yaza_db_page_slot_key_from_validated_header_v1(page, header, slot)?
            if header.low_fence_len > 0 and yaza_db_compare_bytes_v1(key, low_fence) < 0: return err("YDBv1 B+Tree prefix key is below its leaf fence")
            if header.high_fence_len > 0 and yaza_db_compare_bytes_v1(key, high_fence) >= 0: return err("YDBv1 B+Tree prefix key is at or above its leaf fence")
            if has_last_key and yaza_db_compare_bytes_v1(key, last_key) <= 0: return err("YDBv1 B+Tree prefix scan keys are not globally increasing")
            if not yaza_db_btree_key_has_prefix_v1(key, prefix): return ok(rows)
            let decoded_row: YazaDbRowV1 = yaza_db_row_decode_for_schema_v1(slot.payload, columns, schema_version)?
            let row: YazaDbRowV1 = yaza_db_row_materialize_overflow_text_v1(file, file_header, decoded_row, columns)?
            let row_key: Bytes = yaza_db_key_encode_composite_v1(row.values, row.nulls, columns, key_ordinals)?
            if not bytes_equal(row_key, key): return err("YDBv1 B+Tree prefix row key does not match its stored tuple")
            if row.version_ts < 0 or row.version_ts > visible_ts: return err("YDBv1 B+Tree prefix scan found an unpublished row version")
            if not row.deleted:
                if list_count(rows) >= row_limit: return err("YDBv1 B+Tree prefix scan exceeded its row limit")
                if not list_try_push(rows, row): return err("YDBv1 B+Tree prefix scan could not append a visible row")
            set has_last_key = true
            set last_key = key
            set slot_index = slot_index + 1
        if header.high_fence_len == 0: return ok(rows)
        let next_leaf: YazaDbBtreeNextLeafV1 = yaza_db_btree_next_leaf_from_path_v1(file, file_header, current, cache)?
        if not next_leaf.has_next: return err("YDBv1 B+Tree prefix leaf advertises a missing next leaf")
        if next_leaf.path.leaf_page_id == page_id: return err("YDBv1 B+Tree prefix cursor returned the same leaf twice")
        set total_page_reads = total_page_reads + next_leaf.page_reads
        set current = next_leaf.path
        set pages_scanned = pages_scanned + 1
    return ok(rows)

fn yaza_db_btree_read_rows_with_key_prefix_v1(file: Number, file_header: YazaDbFileHeaderV1, root_page_id: Number, columns: List[YazaSqlColumnSchemaV1], schema_version: Number, key_ordinals: List[Number], visible_ts: Number, prefix: Bytes, row_limit: Number) -> Result[List[YazaDbRowV1], Text]:
    return yaza_db_btree_read_rows_with_key_prefix_and_pool_v1(file, file_header, root_page_id, columns, schema_version, key_ordinals, visible_ts, prefix, row_limit, none)

# Point lookup for a complete clustered key. It descends directly to one leaf
# and validates the selected tuple before returning it; callers still run the
# bound predicate and projection so this access path cannot change SQL results.
fn yaza_db_btree_read_rows_from_seek_for_schema_v1(file: Number, file_header: YazaDbFileHeaderV1, columns: List[YazaSqlColumnSchemaV1], schema_version: Number, key_ordinals: List[Number], visible_ts: Number, search_key: Bytes, seek: YazaDbBtreeSeekV1) -> Result[List[YazaDbRowV1], Text]:
    if visible_ts < 1 or bytes_length(search_key) == 0 or bytes_length(search_key) > 2048: return err("YDBv1 B+Tree point-lookup bounds are invalid")
    let rows_result: Result[List[YazaDbRowV1], Text] = list_try_new()
    if not result_is_ok(rows_result): return err(result_unwrap_error(rows_result))
    let rows: List[YazaDbRowV1] = result_unwrap(rows_result)
    let page: Bytes = seek.leaf_page
    let header: YazaDbPageHeaderV1 = seek.leaf_header
    if header.page_type != 1 or header.level != 0: return err("YDBv1 B+Tree point lookup did not resolve to a leaf")
    if header.low_fence_len > 0:
        let low_fence: Bytes = yaza_db_btree_fence_bytes_v1(page, header, true)?
        if yaza_db_compare_bytes_v1(search_key, low_fence) < 0: return err("YDBv1 B+Tree point key is below its selected leaf fence")
    if header.high_fence_len > 0:
        let high_fence: Bytes = yaza_db_btree_fence_bytes_v1(page, header, false)?
        if yaza_db_compare_bytes_v1(search_key, high_fence) >= 0: return err("YDBv1 B+Tree point key is at or above its selected leaf fence")
    let slot_index: Number = yaza_db_page_lower_bound_validated_header_v1(page, header, search_key)?
    if slot_index >= header.count: return ok(rows)
    let slot: YazaDbPageSlotV1 = yaza_db_page_slot_from_validated_header_v1(page, header, slot_index)?
    let stored_key: Bytes = yaza_db_page_slot_key_from_validated_header_v1(page, header, slot)?
    if yaza_db_compare_bytes_v1(stored_key, search_key) != 0: return ok(rows)
    let decoded_row: YazaDbRowV1 = yaza_db_row_decode_for_schema_v1(slot.payload, columns, schema_version)?
    let row: YazaDbRowV1 = yaza_db_row_materialize_overflow_text_v1(file, file_header, decoded_row, columns)?
    if row.version_ts < 0: return err("YDBv1 B+Tree point lookup found an in-progress row without transaction visibility support")
    if row.version_ts > visible_ts: return err("YDBv1 B+Tree point lookup found a row newer than its published commit timestamp")
    let expected_key: Bytes = yaza_db_key_encode_composite_v1(row.values, row.nulls, columns, key_ordinals)?
    if not bytes_equal(expected_key, stored_key): return err("YDBv1 B+Tree point row key does not match its stored tuple")
    if not row.deleted and not list_try_push(rows, row): return err("YDBv1 B+Tree point lookup could not return its row")
    return ok(rows)

fn yaza_db_btree_read_rows_by_key_with_pool_for_schema_v1(file: Number, file_header: YazaDbFileHeaderV1, root_page_id: Number, columns: List[YazaSqlColumnSchemaV1], schema_version: Number, key_ordinals: List[Number], visible_ts: Number, search_key: Bytes, buffer_pool: Option[YazaDbBufferPoolV1]) -> Result[List[YazaDbRowV1], Text]:
    let seek: YazaDbBtreeSeekV1 = yaza_db_btree_seek_leaf_with_pool_v1(file, file_header, root_page_id, search_key, buffer_pool)?
    return yaza_db_btree_read_rows_from_seek_for_schema_v1(file, file_header, columns, schema_version, key_ordinals, visible_ts, search_key, seek)

fn yaza_db_btree_read_rows_by_key_for_schema_v1(file: Number, file_header: YazaDbFileHeaderV1, root_page_id: Number, columns: List[YazaSqlColumnSchemaV1], schema_version: Number, key_ordinals: List[Number], visible_ts: Number, search_key: Bytes) -> Result[List[YazaDbRowV1], Text]:
    return yaza_db_btree_read_rows_by_key_with_pool_for_schema_v1(file, file_header, root_page_id, columns, schema_version, key_ordinals, visible_ts, search_key, none)


fn yaza_db_btree_read_rows_by_key_v1(file: Number, file_header: YazaDbFileHeaderV1, root_page_id: Number, columns: List[YazaSqlColumnSchemaV1], key_ordinals: List[Number], visible_ts: Number, search_key: Bytes) -> Result[List[YazaDbRowV1], Text]:
    return yaza_db_btree_read_rows_by_key_for_schema_v1(file, file_header, root_page_id, columns, 1, key_ordinals, visible_ts, search_key)
