# Gregorian SQL DATE codec for the YazaBase scalar profile.
# The canonical value is a signed day count from 1970-01-01. DATE has no time
# zone; accepted civil dates are 0001-01-01 through 9999-12-31.

fn yaza_sql_date_epoch_offset_v1() -> Number:
    return 719162

fn yaza_sql_date_days_before_year_v1(year: Number) -> Number:
    let previous_year: Number = year - 1
    return previous_year * 365 + previous_year / 4 - previous_year / 100 + previous_year / 400

fn yaza_sql_date_is_leap_year_v1(year: Number) -> Boolean:
    return year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)

fn yaza_sql_date_days_in_month_v1(year: Number, month: Number) -> Number:
    if month == 1 or month == 3 or month == 5 or month == 7 or month == 8 or month == 10 or month == 12: return 31
    if month == 4 or month == 6 or month == 9 or month == 11: return 30
    if month == 2:
        if yaza_sql_date_is_leap_year_v1(year): return 29
        return 28
    return 0

fn yaza_sql_date_valid_days_v1(days_since_epoch: Number) -> Boolean:
    return days_since_epoch >= -719162 and days_since_epoch <= 2932896

fn yaza_sql_date_parse_digits_v1(source: Text, offset: Number, count: Number) -> Number:
    var value: Number = 0
    var index: Number = 0
    while index < count:
        let byte: Number = text_byte(source, offset + index)
        if byte < 48 or byte > 57: return -1
        set value = value * 10 + byte - 48
        set index = index + 1
    return value

fn yaza_sql_date_parse_v1(source: Text) -> Result[Number, Text]:
    if text_length(source) != 10: return err("YazaBase DATE requires canonical YYYY-MM-DD text")
    if text_byte(source, 4) != 45 or text_byte(source, 7) != 45: return err("YazaBase DATE requires canonical YYYY-MM-DD text")
    let year: Number = yaza_sql_date_parse_digits_v1(source, 0, 4)
    let month: Number = yaza_sql_date_parse_digits_v1(source, 5, 2)
    let day: Number = yaza_sql_date_parse_digits_v1(source, 8, 2)
    if year < 1 or year > 9999 or month < 1 or month > 12 or day < 1: return err("YazaBase DATE is outside the supported Gregorian calendar")
    if day > yaza_sql_date_days_in_month_v1(year, month): return err("YazaBase DATE day is invalid for its month")
    var days_of_year: Number = day - 1
    var prior_month: Number = 1
    while prior_month < month:
        set days_of_year = days_of_year + yaza_sql_date_days_in_month_v1(year, prior_month)
        set prior_month = prior_month + 1
    let days_since_epoch: Number = yaza_sql_date_days_before_year_v1(year) + days_of_year - yaza_sql_date_epoch_offset_v1()
    if not yaza_sql_date_valid_days_v1(days_since_epoch): return err("YazaBase DATE day count is outside its signed v1 range")
    return ok(days_since_epoch)

fn yaza_sql_date_year_text_v1(year: Number) -> Text:
    let digits: Text = number_text(year)
    if year < 10: return "000" + digits
    if year < 100: return "00" + digits
    if year < 1000: return "0" + digits
    return digits

fn yaza_sql_date_two_digits_v1(value: Number) -> Text:
    if value < 10: return "0" + number_text(value)
    return number_text(value)

fn yaza_sql_date_to_text_v1(days_since_epoch: Number) -> Result[Text, Text]:
    if not yaza_sql_date_valid_days_v1(days_since_epoch): return err("YazaBase DATE day count is outside 0001-01-01 through 9999-12-31")
    let ordinal: Number = days_since_epoch + yaza_sql_date_epoch_offset_v1()
    var lower_year: Number = 1
    var upper_year: Number = 10000
    while upper_year - lower_year > 1:
        let middle_year: Number = (lower_year + upper_year) / 2
        if yaza_sql_date_days_before_year_v1(middle_year) <= ordinal:
            set lower_year = middle_year
        else:
            set upper_year = middle_year
    var remaining_days: Number = ordinal - yaza_sql_date_days_before_year_v1(lower_year)
    var month: Number = 1
    while month < 12 and remaining_days >= yaza_sql_date_days_in_month_v1(lower_year, month):
        set remaining_days = remaining_days - yaza_sql_date_days_in_month_v1(lower_year, month)
        set month = month + 1
    let day: Number = remaining_days + 1
    return ok(yaza_sql_date_year_text_v1(lower_year) + "-" + yaza_sql_date_two_digits_v1(month) + "-" + yaza_sql_date_two_digits_v1(day))
