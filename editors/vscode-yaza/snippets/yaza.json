{
  "YAZA CLI program": {
    "prefix": "yaza-start",
    "description": "Create a minimal YAZA CLI program",
    "body": [
      "start:",
      "    let message: Text = \"${1:Hello, world!}\"",
      "    say message"
    ]
  },
  "YAZA function": {
    "prefix": "yaza-fn",
    "description": "Create a typed function with a final return",
    "body": [
      "fn ${1:calculate}(${2:value}: Number) -> Number:",
      "    return ${3:value}"
    ]
  },
  "YAZA Arena-SSR View": {
    "prefix": "yaza-view",
    "description": "Create a compiled HTML5 view with auto-escaped {{ expr }} and trusted {! raw !} interpolation",
    "body": [
      "use \"std/web/view\"",
      "",
      "view ${1:render_card}(${2:title}: Text, ${3:body_html}: Text):",
      "    <section class=\"yz-card\">",
      "      <h2>{{ ${2:title} }}</h2>",
      "      {! ${3:body_html} !}",
      "    </section>"
    ]
  },
  "YAZA Minimal API": {
    "prefix": "yaza-minimal-api",
    "description": "Create a modern minimal API endpoint handler",
    "body": [
      "use \"std/http\"",
      "",
      "fn handle_route(method: Text, path: Text, body: Text) -> HttpResponse:",
      "    if path == \"/healthz\":",
      "        return http_response_ok_json(\"{\\\"status\\\":\\\"UP\\\"}\")",
      "    if path == \"/api/v1/${1:items}\":",
      "        if method == \"GET\":",
      "            return http_response_ok_json(\"[{\\\"id\\\":1}] \")",
      "        return http_response_method_not_allowed(\"Method not allowed\", true)",
      "    return http_response_not_found(\"Route not found\", true)",
      "",
      "start:",
      "    say \"Server listening on http://127.0.0.1:8080\""
    ]
  },
  "YAZA Cloud-Native Microservice": {
    "prefix": "yaza-microservice",
    "description": "Create a cloud-native microservice router with health and Prometheus metrics",
    "body": [
      "use \"std/http\"",
      "",
      "fn handle_microservice(method: Text, path: Text, body: Text) -> HttpResponse:",
      "    if path == \"/healthz\" or path == \"/livez\":",
      "        return http_response_ok_json(\"{\\\"status\\\":\\\"UP\\\"}\")",
      "    if path == \"/readyz\":",
      "        return http_response_ok_json(\"{\\\"status\\\":\\\"READY\\\",\\\"database\\\":\\\"connected\\\"}\")",
      "    if path == \"/metrics\":",
      "        return HttpResponse(200, \"OK\", \"text/plain; version=0.0.4\", bytes_from_text(\"# HELP http_requests_total\\nhttp_requests_total 1\\n\"))",
      "    return http_response_not_found(\"Not found\", true)",
      "",
      "start:",
      "    say \"Microservice initialized with AQB throughput profile.\""
    ]
  },
  "YAZA YazaBase Embedded Database": {
    "prefix": "yaza-yazabase",
    "description": "Connect to YazaBase using default or environment credentials",
    "body": [
      "use \"std/db/yazabase\"",
      "",
      "let conn: YazaBaseConnection = yazabase_connect_default(\"${1:./data}\", \"${2:app}\")?"
    ]
  },
  "YAZA Async Spawn/Await": {
    "prefix": "yaza-async",
    "description": "Declare an async function and invoke it concurrently via spawn/await",
    "body": [
      "async fn ${1:work_async}(${2:input}: Text) -> Text:",
      "    return ${2:input}",
      "",
      "let task: Task[Text] = spawn ${1:work_async}(\"${3:hello}\")",
      "let result: Text = await task"
    ]
  },
  "YAZA Middleware JWT & RBAC": {
    "prefix": "yaza-middleware-jwt-rbac",
    "description": "Verify Bearer JWT HS256 and enforce role-based access in a controller",
    "body": [
      "use \"std/middleware\"",
      "",
      "var ctx: MiddlewareContext = middleware_begin(${1:req})",
      "set ctx = middleware_cors_preflight(ctx)",
      "set ctx = middleware_auth_jwt(ctx, \"${2:yaza-api}\", \"${3:yaza-clients}\", ${4:secret})",
      "set ctx = middleware_require_any_role(ctx, \"${5:admin,editor}\")",
      "if ctx.rejected:",
      "    return ctx.reject_response"
    ]
  },
  "YAZA conditional": {
    "prefix": "yaza-if",
    "description": "Create an if/else block",
    "body": [
      "if ${1:condition}:",
      "    ${2:say \"true\"}",
      "else:",
      "    ${3:say \"false\"}"
    ]
  },
  "YAZA pattern match": {
    "prefix": "yaza-match",
    "description": "Match against variants",
    "body": [
      "match ${1:value}:",
      "    ${2:CaseOne}:",
      "        return ${3:1}",
      "    ${4:CaseTwo}(inner):",
      "        return inner"
    ]
  },
  "YAZA while loop": {
    "prefix": "yaza-while",
    "description": "Create a while loop",
    "body": [
      "while ${1:condition}:",
      "    ${2:say \"loop\"}"
    ]
  },
  "YAZA shape": {
    "prefix": "yaza-shape",
    "description": "Declare a typed data shape",
    "body": [
      "shape ${1:User}:",
      "    id: Number",
      "    name: Text",
      "    active: Boolean"
    ]
  },
  "YAZA variant": {
    "prefix": "yaza-variant",
    "description": "Declare an algebraic variant",
    "body": [
      "variant ${1:Status}:",
      "    Pending",
      "    Active(timestamp: Number)",
      "    Failed(reason: Text)"
    ]
  },
  "YAZA assert": {
    "prefix": "yaza-assert",
    "description": "Fail the current test when a Boolean condition is false",
    "body": [
      "assert ${1:condition}"
    ]
  }
}
