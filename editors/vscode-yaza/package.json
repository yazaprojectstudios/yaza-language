{
  "name": "yaza-language-support",
  "displayName": "YAZA Language Support",
  "description": "YAZA 1.0.0 syntax (async/spawn/await & borrow), formatting, diagnostics, completion, navigation, and snippets.",
  "version": "1.0.0",
  "publisher": "yaza-language",
  "license": "UNLICENSED",
  "icon": "images/yaza-logo.png",
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:yaza"
  ],
  "scripts": {
    "test": "node ./test/formatter.test.js && node ./test/extension-diagnostics.test.js"
  },
  "contributes": {
    "commands": [
      { "command": "yaza.checkCurrentFile", "title": "YAZA: Check Current File" },
      { "command": "yaza.showOutput", "title": "YAZA: Show Language Output" }
    ],
    "configuration": {
      "title": "YAZA",
      "properties": {
        "yaza.executablePath": {
          "type": "string",
          "default": "yaza",
          "description": "Path or command name for the YAZA compiler CLI."
        },
        "yaza.standardLibraryPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to the YAZA standard library."
        },
        "yaza.diagnosticsTimeoutMs": {
          "type": "number",
          "default": 10000,
          "minimum": 1000,
          "maximum": 120000,
          "description": "Maximum time to wait for one YAZA compiler check."
        }
      }
    },
    "configurationDefaults": {
      "[yaza]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.defaultFormatter": "yaza-language.yaza-language-support"
      }
    },
    "languages": [
      {
        "id": "yaza",
        "aliases": [
          "YAZA",
          "yaza"
        ],
        "extensions": [
          ".yz"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/yaza-logo.png",
          "dark": "./images/yaza-logo.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "yaza",
        "scopeName": "source.yz",
        "path": "./syntaxes/yaza.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "yaza",
        "path": "./snippets/yaza.json"
      }
    ]
  }
}
