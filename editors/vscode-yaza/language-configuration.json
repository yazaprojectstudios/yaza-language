{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:start|api|fn|shape|variant|impl|controller|service|repository|model|interface|if|elif|else|while|for|match)\\b.*|[A-Za-z_][A-Za-z0-9_]*(?:\\([^\\n]*\\))?)\\s*:\\s*(?:#.*)?$",
    "decreaseIndentPattern": "^\\s*(?:elif\\b.*:|else:|[}\\]])"
  }
}
