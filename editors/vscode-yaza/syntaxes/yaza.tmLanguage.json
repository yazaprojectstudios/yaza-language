{
  "scopeName": "source.yz",
  "patterns": [
    { "include": "#comments" },
    { "include": "#view-interpolations" },
    { "include": "#strings" },
    { "include": "#block-headings" },
    { "include": "#http-methods" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.yz",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.yz",
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.yz" }
      },
      "end": "\"",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.yz" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.yz",
          "match": "\\\\."
        },
        {
          "name": "variable.other.interpolation.yz",
          "match": "\\{[A-Za-z_][A-Za-z0-9_]*\\}"
        }
      ]
    },
    "view-interpolations": {
      "patterns": [
        {
          "name": "meta.embedded.expression.yz",
          "begin": "\\{\\{|\\{!",
          "beginCaptures": {
            "0": { "name": "punctuation.section.embedded.begin.yz" }
          },
          "end": "\\}\\}|!\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.embedded.end.yz" }
          },
          "patterns": [
            { "include": "#strings" },
            { "include": "#keywords" },
            { "include": "#constants" },
            { "include": "#numbers" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "block-headings": {
      "match": "^\\s*(start|api|(?:async\\s+)?fn|view|shape|variant|impl|controller|service|repository|model|interface|group)\\b",
      "captures": {
        "1": { "name": "storage.type.block.yz" }
      }
    },
    "http-methods": {
      "name": "constant.language.http-method.yz",
      "match": "\\b(?:GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS)\\b"
    },
    "keywords": {
      "name": "keyword.control.yz",
      "match": "\\b(?:async|spawn|await|borrow|mut|move|listen|routes|route|status|group|implements|method|call|list|record|field|body|path|query|header|json|say|assert|let|var|set|if|elif|else|while|for|break|continue|match|fn|return|defer|example|use|get|arg_count|arg|monotonic_ms|monotonic_ns|time_now_unix_ms|env_get|env_set|file_read|file_write|file_exists|file_remove|directory_create|directory_list|path_join|text_list|list_new|list_push|list_count|list_get|text_length|text_byte|text_slice|text_find|text_join|text_split|text_lines|text_trim|text_starts_with|text_ends_with|process|option_is_some|option_unwrap|result_is_ok|result_unwrap|result_unwrap_error|some|ok|err|exit|fail|from)\\b"
    },
    "types": {
      "name": "support.type.yz",
      "match": "\\b(?:Text|Number|Int32|Float64|Boolean|TextList|Bytes|Option|Result|Task|List)\\b"
    },
    "constants": {
      "name": "constant.language.boolean.yz",
      "match": "\\b(?:true|false|none|null)\\b"
    },
    "numbers": {
      "name": "constant.numeric.yz",
      "match": "\\b\\d+(?:\\.\\d+)?\\b"
    },
    "operators": {
      "name": "keyword.operator.yz",
      "match": "=>|->|\\?|="
    },
    "punctuation": {
      "name": "punctuation.separator.yz",
      "match": "[:,.()\\[\\]{}]"
    }
  }
}
