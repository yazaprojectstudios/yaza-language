fn core_llvm_nested_mut_safe_expr(expression: YirExpr, root: Text, functions: List[YirFunction]) -> Boolean:
    if expression.kind == "" or expression.kind == "unit": return true
    if expression.kind == "call":
        let inlined: YirExpr = core_llvm_inline_accessor(expression, functions)
        if inlined.kind == "": return false
