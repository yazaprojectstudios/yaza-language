fn core_llvm_find_active_nested_mut_root_view(collection: YirExpr, defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList) -> Text:
    var parent: YirExpr = collection
    if collection.kind != "variable": set parent = core_llvm_nested_mut_parent(collection)
    if parent.kind != "variable": return ""
    var index: Number = number_parse(list_get(defer_depth, 0)) - 1
    while index >= 0:
        let record_index: Number = number_parse(list_get(defer_stack, index))
        let record: YirStatement = list_get(defer_records, record_index)
        if record.expression.value == "__yaza_list_nested_mut_view_end" and record.slot == "nested:" + parent.value:
            return list_get(record.expression.children, 0).value
        set index = index - 1
    return ""

fn core_llvm_find_active_nested_mut_view(collection: YirExpr, defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList) -> Text:
    let parent: YirExpr = core_llvm_nested_mut_parent(collection)
    if parent.kind != "variable": return ""
    var index: Number = number_parse(list_get(defer_depth, 0)) - 1
    while index >= 0:
        let record_index: Number = number_parse(list_get(defer_stack, index))
        let record: YirStatement = list_get(defer_records, record_index)
        if record.expression.value == "__yaza_list_nested_mut_view_end" and record.slot == "nested:" + parent.value:
            return list_get(record.expression.children, 0).value
        set index = index - 1
    return ""

fn core_llvm_nested_mut_static_mode(view: Text, defer_records: List[YirStatement]) -> Text:
    var index: Number = list_count(defer_records) - 1
    while index >= 0:
        let record: YirStatement = list_get(defer_records, index)
        if record.kind == "__yaza_nested_mut_static_mode" and record.slot == view:
            return record.value_type
        set index = index - 1
    return ""

fn core_llvm_is_list_parameter(function: YirFunction, candidate: YirExpr) -> Boolean:
    var index: Number = 0
    while index < list_count(function.parameters):
        let parameter: YirParameter = list_get(function.parameters, index)
        if parameter.slot == candidate.value and core_llvm_is_list_type(parameter.value_type): return true
        set index = index + 1
    return false

fn core_llvm_collect_function_read_views(block: List[YirStatement], candidates: List[YirExpr], function: YirFunction, functions: List[YirFunction]) -> Number:
    var index: Number = 0
    while index < list_count(block):
        let statement: YirStatement = list_get(block, index)
        if statement.kind == "while" or statement.kind == "for_range" or statement.kind == "for_each":
            let loop_candidates: List[YirExpr] = core_llvm_while_read_view_candidates(statement, functions)
            var candidate_index: Number = 0
            while candidate_index < list_count(loop_candidates):
                let candidate: YirExpr = list_get(loop_candidates, candidate_index)
                if candidate.kind == "variable" and core_llvm_is_list_parameter(function, candidate): core_llvm_add_read_view_candidate(candidate, candidates)
                set candidate_index = candidate_index + 1
        core_llvm_collect_function_read_views(statement.body, candidates, function, functions)
        core_llvm_collect_function_read_views(statement.alternate, candidates, function, functions)
        var branch_index: Number = 0
        while branch_index < list_count(statement.branches):
            core_llvm_collect_function_read_views(list_get(statement.branches, branch_index).body, candidates, function, functions)
            set branch_index = branch_index + 1
        var arm_index: Number = 0
        while arm_index < list_count(statement.match_arms):
            core_llvm_collect_function_read_views(list_get(statement.match_arms, arm_index).body, candidates, function, functions)
            set arm_index = arm_index + 1
        set index = index + 1
    return 0

fn core_llvm_function_direct_read_view_candidates(function: YirFunction, functions: List[YirFunction]) -> List[YirExpr]:
    let candidates: List[YirExpr] = List[YirExpr]()
    core_llvm_collect_function_read_views(function.body, candidates, function, functions)
    return candidates

fn core_llvm_collect_forwarded_read_views_expr(expression: YirExpr, candidates: List[YirExpr], function: YirFunction, functions: List[YirFunction]) -> Number:
    if expression.kind == "call":
        var callee_index: Number = 0
        while callee_index < list_count(functions) and list_get(functions, callee_index).name != expression.value:
            set callee_index = callee_index + 1
        if callee_index < list_count(functions):
            let callee: YirFunction = list_get(functions, callee_index)
            let callee_candidates: List[YirExpr] = core_llvm_function_direct_read_view_candidates(callee, functions)
            var candidate_index: Number = 0
            while candidate_index < list_count(callee_candidates):
                let candidate: YirExpr = list_get(callee_candidates, candidate_index)
                var parameter_index: Number = 0
                while parameter_index < list_count(callee.parameters) and list_get(callee.parameters, parameter_index).slot != candidate.value:
                    set parameter_index = parameter_index + 1
                if parameter_index < list_count(expression.children):
                    let argument: YirExpr = list_get(expression.children, parameter_index)
                    if argument.kind == "variable" and argument.value_type == candidate.value_type and core_llvm_is_list_parameter(function, argument):
                        core_llvm_add_read_view_candidate(argument, candidates)
                set candidate_index = candidate_index + 1
    var child_index: Number = 0
    while child_index < list_count(expression.children):
        core_llvm_collect_forwarded_read_views_expr(list_get(expression.children, child_index), candidates, function, functions)
        set child_index = child_index + 1
    return 0

fn core_llvm_collect_forwarded_read_views_block(block: List[YirStatement], candidates: List[YirExpr], function: YirFunction, functions: List[YirFunction]) -> Number:
    var index: Number = 0
    while index < list_count(block):
        let statement: YirStatement = list_get(block, index)
        core_llvm_collect_forwarded_read_views_expr(statement.expression, candidates, function, functions)
        core_llvm_collect_forwarded_read_views_expr(statement.expression2, candidates, function, functions)
        core_llvm_collect_forwarded_read_views_block(statement.body, candidates, function, functions)
        core_llvm_collect_forwarded_read_views_block(statement.alternate, candidates, function, functions)
        var branch_index: Number = 0
        while branch_index < list_count(statement.branches):
            let branch: YirBranch = list_get(statement.branches, branch_index)
            core_llvm_collect_forwarded_read_views_expr(branch.condition, candidates, function, functions)
            core_llvm_collect_forwarded_read_views_block(branch.body, candidates, function, functions)
            set branch_index = branch_index + 1
        var arm_index: Number = 0
        while arm_index < list_count(statement.match_arms):
            let arm: YirMatchArm = list_get(statement.match_arms, arm_index)
            core_llvm_collect_forwarded_read_views_expr(arm.pattern_value, candidates, function, functions)
            core_llvm_collect_forwarded_read_views_expr(arm.result_expression, candidates, function, functions)
            core_llvm_collect_forwarded_read_views_block(arm.body, candidates, function, functions)
            set arm_index = arm_index + 1
        set index = index + 1
    return 0

fn core_llvm_function_read_view_candidates(function: YirFunction, functions: List[YirFunction]) -> List[YirExpr]:
    let candidates: List[YirExpr] = core_llvm_function_direct_read_view_candidates(function, functions)
    let forwarded: List[YirExpr] = List[YirExpr]()
    core_llvm_collect_forwarded_read_views_block(function.body, forwarded, function, functions)
    var index: Number = 0
    while index < list_count(forwarded):
        let candidate: YirExpr = list_get(forwarded, index)
        if not core_llvm_block_assigns_slot(function.body, candidate.value):
            core_llvm_add_read_view_candidate(candidate, candidates)
        set index = index + 1
    return candidates

fn core_llvm_function_read_view_slot(candidate_index: Number) -> Text:
    return "%yaza.function.read.use." + number_text(candidate_index)

fn core_llvm_function_read_view_local_slot(candidate_index: Number) -> Text:
    return "%yaza.function.read.local." + number_text(candidate_index)

fn core_llvm_function_read_view_argument(candidate_index: Number) -> Text:
    return "%yaza.shared.read." + number_text(candidate_index)

fn core_llvm_function_nested_read_view_candidate(function: YirFunction, candidate: YirExpr, functions: List[YirFunction]) -> Boolean:
    if candidate.value_type != "List[List[Number]]": return false
    let reads: TextList = text_list()
    let writes: TextList = text_list()
    let invalid: TextList = text_list()
    core_llvm_collect_nested_mut_block(function.body, reads, writes, invalid, functions)
    var index: Number = 0
    while index < list_count(writes):
        if list_get(writes, index) == candidate.value: return false
        set index = index + 1
    set index = 0
    while index < list_count(invalid):
        if list_get(invalid, index) == candidate.value: return false
        set index = index + 1
    return true

fn core_llvm_function_read_view_storage_type(function: YirFunction, candidate: YirExpr, functions: List[YirFunction]) -> Text:
    if core_llvm_function_nested_read_view_candidate(function, candidate, functions): return "YazaListNestedReadBorrowV1"
    return "YazaListBorrowV1"

fn core_llvm_collect_shared_read_call_expr(expression: YirExpr, target: YirFunction, target_parameter_index: Number, caller: YirFunction, functions: List[YirFunction], call_count: TextList, all_shared: TextList) -> Number:
    if expression.kind == "call" and expression.value == target.name:
        let count: Number = number_parse(list_get(call_count, 0))
        list_set(call_count, 0, number_text(count + 1))
        if target_parameter_index >= list_count(expression.children):
            list_set(all_shared, 0, "false")
        else:
            let argument: YirExpr = list_get(expression.children, target_parameter_index)
            var found: Boolean = false
            if argument.kind == "variable" and not core_llvm_block_assigns_slot(caller.body, argument.value):
                let caller_candidates: List[YirExpr] = core_llvm_function_read_view_candidates(caller, functions)
                var candidate_index: Number = 0
                while candidate_index < list_count(caller_candidates) and not found:
                    let candidate: YirExpr = list_get(caller_candidates, candidate_index)
                    if candidate.value == argument.value and candidate.value_type == argument.value_type: set found = true
                    set candidate_index = candidate_index + 1
            if not found: list_set(all_shared, 0, "false")
    var child_index: Number = 0
    while child_index < list_count(expression.children):
        core_llvm_collect_shared_read_call_expr(list_get(expression.children, child_index), target, target_parameter_index, caller, functions, call_count, all_shared)
        set child_index = child_index + 1
    return 0

fn core_llvm_collect_shared_read_call_block(block: List[YirStatement], target: YirFunction, target_parameter_index: Number, caller: YirFunction, functions: List[YirFunction], call_count: TextList, all_shared: TextList) -> Number:
    var index: Number = 0
    while index < list_count(block):
        let statement: YirStatement = list_get(block, index)
        core_llvm_collect_shared_read_call_expr(statement.expression, target, target_parameter_index, caller, functions, call_count, all_shared)
        core_llvm_collect_shared_read_call_expr(statement.expression2, target, target_parameter_index, caller, functions, call_count, all_shared)
        core_llvm_collect_shared_read_call_block(statement.body, target, target_parameter_index, caller, functions, call_count, all_shared)
        core_llvm_collect_shared_read_call_block(statement.alternate, target, target_parameter_index, caller, functions, call_count, all_shared)
        var branch_index: Number = 0
        while branch_index < list_count(statement.branches):
            let branch: YirBranch = list_get(statement.branches, branch_index)
            core_llvm_collect_shared_read_call_expr(branch.condition, target, target_parameter_index, caller, functions, call_count, all_shared)
            core_llvm_collect_shared_read_call_block(branch.body, target, target_parameter_index, caller, functions, call_count, all_shared)
            set branch_index = branch_index + 1
        var arm_index: Number = 0
        while arm_index < list_count(statement.match_arms):
            let arm: YirMatchArm = list_get(statement.match_arms, arm_index)
            core_llvm_collect_shared_read_call_expr(arm.pattern_value, target, target_parameter_index, caller, functions, call_count, all_shared)
            core_llvm_collect_shared_read_call_expr(arm.result_expression, target, target_parameter_index, caller, functions, call_count, all_shared)
            core_llvm_collect_shared_read_call_block(arm.body, target, target_parameter_index, caller, functions, call_count, all_shared)
            set arm_index = arm_index + 1
        set index = index + 1
    return 0

fn core_llvm_expr_calls_named_function(expression: YirExpr, name: Text) -> Boolean:
    if expression.kind == "call" and expression.value == name: return true
    var child_index: Number = 0
    while child_index < list_count(expression.children):
        if core_llvm_expr_calls_named_function(list_get(expression.children, child_index), name): return true
        set child_index = child_index + 1
    return false

fn core_llvm_block_calls_named_function(block: List[YirStatement], name: Text) -> Boolean:
    var index: Number = 0
    while index < list_count(block):
        let statement: YirStatement = list_get(block, index)
        if core_llvm_expr_calls_named_function(statement.expression, name) or core_llvm_expr_calls_named_function(statement.expression2, name): return true
        if core_llvm_block_calls_named_function(statement.body, name) or core_llvm_block_calls_named_function(statement.alternate, name): return true
        var branch_index: Number = 0
        while branch_index < list_count(statement.branches):
            let branch: YirBranch = list_get(statement.branches, branch_index)
            if core_llvm_expr_calls_named_function(branch.condition, name) or core_llvm_block_calls_named_function(branch.body, name): return true
            set branch_index = branch_index + 1
        var arm_index: Number = 0
        while arm_index < list_count(statement.match_arms):
            let arm: YirMatchArm = list_get(statement.match_arms, arm_index)
            if core_llvm_expr_calls_named_function(arm.pattern_value, name) or core_llvm_expr_calls_named_function(arm.result_expression, name) or core_llvm_block_calls_named_function(arm.body, name): return true
            set arm_index = arm_index + 1
        set index = index + 1
    return false

fn core_llvm_function_read_view_always_shared(function: YirFunction, candidate: YirExpr, functions: List[YirFunction], program_body: List[YirStatement]) -> Boolean:
    var parameter_index: Number = 0
    while parameter_index < list_count(function.parameters) and list_get(function.parameters, parameter_index).slot != candidate.value:
        set parameter_index = parameter_index + 1
    if parameter_index >= list_count(function.parameters): return false
    let call_count: TextList = text_list()
    let all_shared: TextList = text_list()
    list_push(call_count, "0")
    list_push(all_shared, "true")
    var caller_index: Number = 0
    while caller_index < list_count(functions):
        core_llvm_collect_shared_read_call_block(list_get(functions, caller_index).body, function, parameter_index, list_get(functions, caller_index), functions, call_count, all_shared)
        set caller_index = caller_index + 1
    if core_llvm_block_calls_named_function(program_body, function.name): list_set(all_shared, 0, "false")
    return number_parse(list_get(call_count, 0)) > 0 and list_get(all_shared, 0) == "true"

fn core_llvm_read_view_slot(statement: YirStatement, candidate_index: Number) -> Text:
    return "%yaza.read." + number_text(statement.source_line) + "." + number_text(statement.source_column) + "." + number_text(statement.source_end_column) + "." + number_text(candidate_index)

fn core_llvm_find_active_read_view(collection: YirExpr, defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList) -> Text:
    let key: Text = core_llvm_read_view_key(collection)
    var index: Number = number_parse(list_get(defer_depth, 0)) - 1
    while index >= 0:
        let record_index: Number = number_parse(list_get(defer_stack, index))
        let record: YirStatement = list_get(defer_records, record_index)
        if (record.expression.value == "__yaza_list_read_view_end" or record.expression.value == "__yaza_list_read_view_shared" or record.expression.value == "__yaza_list_nested_read_view_end" or record.expression.value == "__yaza_list_nested_read_view_shared") and record.slot == key:
            return list_get(record.expression.children, 0).value
        set index = index - 1
    return ""

fn core_llvm_find_active_nested_read_view(collection: YirExpr, defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList) -> Text:
    let parent: YirExpr = core_llvm_nested_mut_parent(collection)
    if parent.kind != "variable": return ""
    let key: Text = core_llvm_read_view_key(parent)
    var index: Number = number_parse(list_get(defer_depth, 0)) - 1
    while index >= 0:
        let record_index: Number = number_parse(list_get(defer_stack, index))
        let record: YirStatement = list_get(defer_records, record_index)
        if (record.expression.value == "__yaza_list_nested_read_view_end" or record.expression.value == "__yaza_list_nested_read_view_shared") and record.slot == key:
            return list_get(record.expression.children, 0).value
        set index = index - 1
    return ""

fn core_llvm_add_string_global(value: Text, strings: TextList) -> Text:
    var index: Number = 0
    while index < list_count(strings):
        if list_get(strings, index) == value:
            return "@.yaza.core.str." + number_text(index)
        set index = index + 1
    list_push(strings, value)
    return "@.yaza.core.str." + number_text(list_count(strings) - 1)

fn core_llvm_pointer_to_string(value: Text, strings: TextList) -> Text:
    return core_llvm_add_string_global(core_llvm_decode_text(value), strings)

fn core_llvm_c_string_pointer(value: Text, strings: TextList) -> Text:
    let global_name: Text = core_llvm_add_string_global(core_llvm_decode_text(value), strings)
    let global_index: Number = number_parse(text_slice(global_name, text_length("@.yaza.core.str."), text_length(global_name) - text_length("@.yaza.core.str.")))
    let content: Text = list_get(strings, global_index)
    let byte_count: Number = bytes_length(bytes_from_text(content)) + 1
    return "getelementptr inbounds ([" + number_text(byte_count) + " x i8], ptr " + global_name + ".bytes, i64 0, i64 0)"

fn core_llvm_interpolation_text(value: TextList, lines: TextList, temp_serial: TextList) -> Text:
    let value_type: Text = list_get(value, 0)
    let value_code: Text = list_get(value, 1)
    if value_type == "Text": return value_code
    if value_type == "Number" or value_type == "Int32" or value_type == "Float64":
        var helper: Text = "@yaza_rt_v1_number_text"
        if value_type == "Int32": set helper = "@yaza_rt_v1_int32_text"
        if value_type == "Float64": set helper = "@yaza_rt_v1_float64_text"
        let result: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + result + " = call ptr " + helper + "(" + core_llvm_type(value_type) + " " + value_code + ")")
        return result
    fail("LLVM backend: unsupported interpolation type '" + value_type + "'")
    return ""

fn core_llvm_interpolation_try_text(value: TextList, lines: TextList, temp_serial: TextList) -> Text:
    let value_type: Text = list_get(value, 0)
    let value_code: Text = list_get(value, 1)
    if value_type == "Text": return value_code
    var helper: Text = "@yaza_rt_v1_try_number_text"
    if value_type == "Int32": set helper = "@yaza_rt_v1_try_int32_text"
    if value_type == "Float64": set helper = "@yaza_rt_v1_try_float64_text"
    let result: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + result + " = call ptr " + helper + "(" + core_llvm_type(value_type) + " " + value_code + ")")
    return result

fn core_llvm_emit_try_interpolation_piece(piece: Text, result: TextList, has_result: TextList, lines: TextList, label_serial: TextList, strings: TextList, temp_serial: TextList, current: TextList, terminated: TextList, is_static: Boolean) -> Number:
    if is_static and text_length(piece) == 0: return 0
    var candidate: Text = piece
    if is_static: set candidate = core_llvm_pointer_to_string(piece, strings)
    let piece_succeeded: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + piece_succeeded + " = icmp ne ptr " + candidate + ", null")
    let piece_label: Text = core_llvm_label(label_serial, "interpolate.try.piece.")
    let error_label: Text = list_get(result, 1)
    list_push(lines, "  br i1 " + piece_succeeded + ", label %" + piece_label + ", label %" + error_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, piece_label)
    if list_get(has_result, 0) == "true":
        let joined: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + joined + " = call ptr @yaza_rt_v1_try_text_concat(ptr " + list_get(result, 0) + ", ptr " + candidate + ")")
        set candidate = joined
        let joined_succeeded: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + joined_succeeded + " = icmp ne ptr " + candidate + ", null")
        let joined_label: Text = core_llvm_label(label_serial, "interpolate.try.joined.")
        list_push(lines, "  br i1 " + joined_succeeded + ", label %" + joined_label + ", label %" + error_label)
        list_set(terminated, 0, "true")
        core_llvm_emit_label(lines, current, terminated, joined_label)
    list_set(result, 0, candidate)
    list_set(has_result, 0, "true")
    return 0

fn core_llvm_emit_fallible_interpolate_expr(expression: YirExpr, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList, functions: List[YirFunction], defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList) -> TextList:
    let result: TextList = text_list()
    list_push(result, "")
    let has_result: TextList = text_list()
    list_push(has_result, "false")
    let error_label: Text = core_llvm_label(label_serial, "interpolate.try.error.")
    list_push(result, error_label)
    var cursor: Number = 0
    var child_index: Number = 0
    var parsing: Boolean = true
    while parsing:
        let remaining: Text = text_slice(expression.value, cursor, text_length(expression.value) - cursor)
        let open_brace: Number = text_find(remaining, "{")
        if open_brace < 0:
            core_llvm_emit_try_interpolation_piece(remaining, result, has_result, lines, label_serial, strings, temp_serial, current, terminated, true)
            set parsing = false
        else:
            let prefix: Text = text_slice(remaining, 0, open_brace)
            core_llvm_emit_try_interpolation_piece(prefix, result, has_result, lines, label_serial, strings, temp_serial, current, terminated, true)
            let close_brace: Number = text_find(remaining, "}")
            let value: TextList = core_llvm_emit_expr(list_get(expression.children, child_index), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
            let rendered: Text = core_llvm_interpolation_try_text(value, lines, temp_serial)
            core_llvm_emit_try_interpolation_piece(rendered, result, has_result, lines, label_serial, strings, temp_serial, current, terminated, false)
            set cursor = cursor + close_brace + 1
            set child_index = child_index + 1
    if list_get(has_result, 0) == "false": list_set(result, 0, core_llvm_pointer_to_string("", strings))
    let success_result: Text = core_llvm_sum_construct("%yaza.result", "1", "Text", list_get(result, 0), lines, temp_serial)
    let success_predecessor: Text = list_get(current, 0)
    let merge_label: Text = core_llvm_label(label_serial, "interpolate.try.end.")
    list_push(lines, "  br label %" + merge_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, error_label)
    let error_result: Text = core_llvm_emit_static_text_result_error(lines, temp_serial)
    let error_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, merge_label)
    let merged: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + merged + " = phi %yaza.result [ " + success_result + ", %" + success_predecessor + " ], [ " + error_result + ", %" + error_predecessor + " ]")
    return core_llvm_value(expression.value_type, merged)

fn core_llvm_append_interpolation_piece(piece: Text, result: TextList, has_result: TextList, lines: TextList, strings: TextList, temp_serial: TextList) -> Number:
    if text_length(piece) > 0:
        let pointer: Text = core_llvm_pointer_to_string(piece, strings)
        if list_get(has_result, 0) == "true":
            let joined: Text = core_llvm_temp(temp_serial)
            list_push(lines, "  " + joined + " = call ptr @yaza_rt_v1_text_concat(ptr " + list_get(result, 0) + ", ptr " + pointer + ")")
            list_set(result, 0, joined)
        else:
            list_set(result, 0, pointer)
            list_set(has_result, 0, "true")
    return 0

fn core_llvm_emit(lines: TextList, text: Text) -> Number:
    return list_push(lines, text)

fn core_llvm_set_current(current: TextList, terminated: TextList, block: Text) -> Number:
    list_set(current, 0, block)
    list_set(terminated, 0, "false")
    return 0

fn core_llvm_emit_label(lines: TextList, current: TextList, terminated: TextList, block: Text) -> Number:
    list_push(lines, block + ":")
    return core_llvm_set_current(current, terminated, block)

fn core_llvm_emit_trap_if(lines: TextList, current: TextList, terminated: TextList, labels: TextList, serial: TextList, strings: TextList, condition: Text, reason: Text) -> Number:
    let trap_label: Text = core_llvm_label(serial, "trap.")
    let ok_label: Text = core_llvm_label(serial, "ok.")
    let reason_pointer: Text = core_llvm_pointer_to_string(reason, strings)
    list_push(lines, "  br i1 " + condition + ", label %" + trap_label + ", label %" + ok_label)
    list_push(lines, trap_label + ":")
    list_push(lines, "  call i64 @yaza_rt_v1_fail_text(ptr " + reason_pointer + ")")
    list_push(lines, "  unreachable")
    list_push(lines, ok_label + ":")
    list_set(current, 0, ok_label)
    list_set(terminated, 0, "false")
    return 0

fn core_llvm_emit_assert_if(lines: TextList, current: TextList, terminated: TextList, serial: TextList, strings: TextList, condition: Text, reason: Text) -> Number:
    let trap_label: Text = core_llvm_label(serial, "assert.fail.")
    let ok_label: Text = core_llvm_label(serial, "assert.ok.")
    let reason_pointer: Text = core_llvm_pointer_to_string(reason, strings)
    list_push(lines, "  br i1 " + condition + ", label %" + trap_label + ", label %" + ok_label)
    list_push(lines, trap_label + ":")
    list_push(lines, "  call i64 @yaza_rt_v1_assert_fail_text(ptr " + reason_pointer + ")")
    list_push(lines, "  unreachable")
    list_push(lines, ok_label + ":")
    list_set(current, 0, ok_label)
    list_set(terminated, 0, "false")
    return 0

fn core_llvm_emit_read_view_get(borrow: Text, index: Text, item_type: Text, lines: TextList, temp_serial: TextList, label_serial: TextList, current: TextList, terminated: TextList) -> Text:
    let items_field: Text = core_llvm_temp(temp_serial)
    let items: Text = core_llvm_temp(temp_serial)
    let generation_address_field: Text = core_llvm_temp(temp_serial)
    let generation_address: Text = core_llvm_temp(temp_serial)
    let count_field: Text = core_llvm_temp(temp_serial)
    let count: Text = core_llvm_temp(temp_serial)
    let captured_generation_field: Text = core_llvm_temp(temp_serial)
    let captured_generation: Text = core_llvm_temp(temp_serial)
    let current_generation: Text = core_llvm_temp(temp_serial)
    let generation_matches: Text = core_llvm_temp(temp_serial)
    let index_in_bounds: Text = core_llvm_temp(temp_serial)
    let fast_read: Text = core_llvm_temp(temp_serial)
    let fast_label: Text = core_llvm_label(label_serial, "list.read.fast.")
    let slow_label: Text = core_llvm_label(label_serial, "list.read.slow.")
    let merge_label: Text = core_llvm_label(label_serial, "list.read.merge.")
    list_push(lines, "  " + items_field + " = getelementptr %yaza.list.borrow, ptr " + borrow + ", i32 0, i32 2")
    list_push(lines, "  " + items + " = load ptr, ptr " + items_field)
    list_push(lines, "  " + generation_address_field + " = getelementptr %yaza.list.borrow, ptr " + borrow + ", i32 0, i32 3")
    list_push(lines, "  " + generation_address + " = load ptr, ptr " + generation_address_field)
    list_push(lines, "  " + count_field + " = getelementptr %yaza.list.borrow, ptr " + borrow + ", i32 0, i32 4")
    list_push(lines, "  " + count + " = load i64, ptr " + count_field)
    list_push(lines, "  " + captured_generation_field + " = getelementptr %yaza.list.borrow, ptr " + borrow + ", i32 0, i32 7")
    list_push(lines, "  " + captured_generation + " = load i64, ptr " + captured_generation_field)
    list_push(lines, "  " + current_generation + " = load atomic i64, ptr " + generation_address + " acquire, align 8")
    list_push(lines, "  " + generation_matches + " = icmp eq i64 " + current_generation + ", " + captured_generation)
    list_push(lines, "  " + index_in_bounds + " = icmp ult i64 " + index + ", " + count)
    list_push(lines, "  " + fast_read + " = and i1 " + generation_matches + ", " + index_in_bounds)
    list_push(lines, "  br i1 " + fast_read + ", label %" + fast_label + ", label %" + slow_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, fast_label)
    let item_pointer: Text = core_llvm_temp(temp_serial)
    var fast_value: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + item_pointer + " = getelementptr " + core_llvm_type(item_type) + ", ptr " + items + ", i64 " + index)
    list_push(lines, "  " + fast_value + " = load " + core_llvm_type(item_type) + ", ptr " + item_pointer)
    list_push(lines, "  br label %" + merge_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, slow_label)
    let scratch: Text = core_llvm_scratch_name(item_type)
    let ignored: Text = core_llvm_temp(temp_serial)
    let slow_value: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + ignored + " = call i32 @yaza_list_v1_read_get_typed(ptr " + borrow + ", i64 " + index + ", ptr " + scratch + ")")
    list_push(lines, "  " + slow_value + " = load " + core_llvm_type(item_type) + ", ptr " + scratch)
    list_push(lines, "  br label %" + merge_label)
    list_set(terminated, 0, "true")
    let fast_predecessor: Text = fast_label
    let slow_predecessor: Text = slow_label
    core_llvm_emit_label(lines, current, terminated, merge_label)
    let result: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + result + " = phi " + core_llvm_type(item_type) + " [ " + fast_value + ", %" + fast_predecessor + " ], [ " + slow_value + ", %" + slow_predecessor + " ]")
    return result

fn core_llvm_emit_active_read_view_get(borrow: Text, collection: YirExpr, index: Text, item_type: Text, lines: TextList, temp_serial: TextList, label_serial: TextList, current: TextList, terminated: TextList, defer_records: List[YirStatement]) -> Text:
    # Unique local Number Lists cannot be reached by another thread or mutated
    # through an alias, so their pinned COW storage can be read without a version check.
    if collection.kind == "variable" and collection.value_type == "List[Number]" and item_type == "Number" and core_llvm_is_local_mutable_list(defer_records, collection.value):
        return core_llvm_emit_snapshot_read_view_get(borrow, index, item_type, lines, temp_serial, label_serial, current, terminated)
    return core_llvm_emit_read_view_get(borrow, index, item_type, lines, temp_serial, label_serial, current, terminated)

fn core_llvm_emit_read_view_switch(borrow: Text, collection: Text, collection_type: Text, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList) -> Number:
    let list_field: Text = core_llvm_temp(temp_serial)
    let active_list: Text = core_llvm_temp(temp_serial)
    let is_current: Text = core_llvm_temp(temp_serial)
    let reuse_label: Text = core_llvm_label(label_serial, "list.read.reuse.")
    let switch_label: Text = core_llvm_label(label_serial, "list.read.switch.")
    let merge_label: Text = core_llvm_label(label_serial, "list.read.select.")
    let item_type: Text = core_yir_list_element_type(collection_type)
    let element_size: Text = core_llvm_size_of(item_type, lines, temp_serial)
    let signature: Text = core_llvm_c_string_pointer(collection_type, strings)
    list_push(lines, "  " + list_field + " = getelementptr %yaza.list.borrow, ptr " + borrow + ", i32 0, i32 0")
    list_push(lines, "  " + active_list + " = load ptr, ptr " + list_field)
    list_push(lines, "  " + is_current + " = icmp eq ptr " + active_list + ", " + collection)
    list_push(lines, "  br i1 " + is_current + ", label %" + reuse_label + ", label %" + switch_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, reuse_label)
    list_push(lines, "  br label %" + merge_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, switch_label)
    list_push(lines, "  call void @yaza_list_v1_read_end(ptr " + borrow + ")")
    list_push(lines, "  call void @yaza_list_v1_read_begin_typed(ptr " + collection + ", ptr " + signature + ", i64 " + element_size + ", ptr " + borrow + ")")
    list_push(lines, "  br label %" + merge_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, merge_label)
    return 0

# Compiler read views pin immutable COW buffers. This path is used only when
# local escape/mutation analysis proves that live updates cannot be observed.
fn core_llvm_emit_snapshot_read_view_get(borrow: Text, index: Text, item_type: Text, lines: TextList, temp_serial: TextList, label_serial: TextList, current: TextList, terminated: TextList) -> Text:
    let items_field: Text = core_llvm_temp(temp_serial)
    let items: Text = core_llvm_temp(temp_serial)
    let count_field: Text = core_llvm_temp(temp_serial)
    let count: Text = core_llvm_temp(temp_serial)
    let in_bounds: Text = core_llvm_temp(temp_serial)
    let fast_label: Text = core_llvm_label(label_serial, "list.snapshot.fast.")
    let fail_label: Text = core_llvm_label(label_serial, "list.snapshot.bounds.fail.")
    let merge_label: Text = core_llvm_label(label_serial, "list.snapshot.merge.")
    list_push(lines, "  " + items_field + " = getelementptr %yaza.list.borrow, ptr " + borrow + ", i32 0, i32 2")
    list_push(lines, "  " + items + " = load ptr, ptr " + items_field)
    list_push(lines, "  " + count_field + " = getelementptr %yaza.list.borrow, ptr " + borrow + ", i32 0, i32 4")
    list_push(lines, "  " + count + " = load i64, ptr " + count_field)
    list_push(lines, "  " + in_bounds + " = icmp ult i64 " + index + ", " + count)
    list_push(lines, "  br i1 " + in_bounds + ", label %" + fast_label + ", label %" + fail_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, fast_label)
    let item_pointer: Text = core_llvm_temp(temp_serial)
    let value: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + item_pointer + " = getelementptr " + core_llvm_type(item_type) + ", ptr " + items + ", i64 " + index)
    list_push(lines, "  " + value + " = load " + core_llvm_type(item_type) + ", ptr " + item_pointer)
    list_push(lines, "  br label %" + merge_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, fail_label)
    list_push(lines, "  call void @yaza_list_v1_read_fail_bounds(ptr " + borrow + ", i64 " + index + ")")
    list_push(lines, "  unreachable")
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, merge_label)
    return value

fn core_llvm_emit_nested_read_get(view: Text, collection_expression: YirExpr, index_expression: YirExpr, item_type: Text, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList, functions: List[YirFunction], defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList) -> Text:
    let outer_index: TextList = core_llvm_emit_expr(list_get(collection_expression.children, 1), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    let active_field: Text = core_llvm_temp(temp_serial)
    let active_value: Text = core_llvm_temp(temp_serial)
    let active: Text = core_llvm_temp(temp_serial)
    let outer_borrow: Text = core_llvm_temp(temp_serial)
    let count_field: Text = core_llvm_temp(temp_serial)
    let count: Text = core_llvm_temp(temp_serial)
    let outer_in_bounds: Text = core_llvm_temp(temp_serial)
    let fast_read: Text = core_llvm_temp(temp_serial)
    let fast_label: Text = core_llvm_label(label_serial, "list.nested.read.fast.")
    let fallback_label: Text = core_llvm_label(label_serial, "list.nested.read.fallback.")
    let child_label: Text = core_llvm_label(label_serial, "list.nested.read.child.")
    let merge_label: Text = core_llvm_label(label_serial, "list.nested.read.merge.")
    list_push(lines, "  " + active_field + " = getelementptr %yaza.list.nested.readborrow, ptr " + view + ", i32 0, i32 5")
    list_push(lines, "  " + active_value + " = load i32, ptr " + active_field)
    list_push(lines, "  " + active + " = icmp ne i32 " + active_value + ", 0")
    list_push(lines, "  " + outer_borrow + " = getelementptr %yaza.list.nested.readborrow, ptr " + view + ", i32 0, i32 0")
    list_push(lines, "  " + count_field + " = getelementptr %yaza.list.borrow, ptr " + outer_borrow + ", i32 0, i32 4")
    list_push(lines, "  " + count + " = load i64, ptr " + count_field)
    list_push(lines, "  " + outer_in_bounds + " = icmp ult i64 " + list_get(outer_index, 1) + ", " + count)
    list_push(lines, "  " + fast_read + " = and i1 " + active + ", " + outer_in_bounds)
    list_push(lines, "  br i1 " + fast_read + ", label %" + fast_label + ", label %" + fallback_label)
    list_set(terminated, 0, "true")

    core_llvm_emit_label(lines, current, terminated, fast_label)
    let mapping_field: Text = core_llvm_temp(temp_serial)
    let mapping_slot: Text = core_llvm_temp(temp_serial)
    let child_index: Text = core_llvm_temp(temp_serial)
    let child_count_field: Text = core_llvm_temp(temp_serial)
    let child_count: Text = core_llvm_temp(temp_serial)
    let child_index_valid: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + mapping_field + " = getelementptr %yaza.list.nested.readborrow, ptr " + view + ", i32 0, i32 2")
    list_push(lines, "  " + mapping_slot + " = getelementptr [32 x i64], ptr " + mapping_field + ", i32 0, i64 " + list_get(outer_index, 1))
    list_push(lines, "  " + child_index + " = load i64, ptr " + mapping_slot)
    list_push(lines, "  " + child_count_field + " = getelementptr %yaza.list.nested.readborrow, ptr " + view + ", i32 0, i32 3")
    list_push(lines, "  " + child_count + " = load i64, ptr " + child_count_field)
    list_push(lines, "  " + child_index_valid + " = icmp ult i64 " + child_index + ", " + child_count)
    list_push(lines, "  br i1 " + child_index_valid + ", label %" + child_label + ", label %" + fallback_label)
    list_set(terminated, 0, "true")

    core_llvm_emit_label(lines, current, terminated, child_label)
    let children_field: Text = core_llvm_temp(temp_serial)
    let child_borrow: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + children_field + " = getelementptr %yaza.list.nested.readborrow, ptr " + view + ", i32 0, i32 1")
    list_push(lines, "  " + child_borrow + " = getelementptr [32 x %yaza.list.borrow], ptr " + children_field + ", i32 0, i64 " + child_index)
    let inner_index: TextList = core_llvm_emit_expr(index_expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    let fast_value: Text = core_llvm_emit_snapshot_read_view_get(child_borrow, list_get(inner_index, 1), item_type, lines, temp_serial, label_serial, current, terminated)
    let fast_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    list_set(terminated, 0, "true")

    core_llvm_emit_label(lines, current, terminated, fallback_label)
    let fallback_child: Text = core_llvm_emit_read_view_get(outer_borrow, list_get(outer_index, 1), "List[Number]", lines, temp_serial, label_serial, current, terminated)
    let fallback_index: TextList = core_llvm_emit_expr(index_expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    let fallback_type_signature: Text = core_llvm_c_string_pointer("List[Number]", strings)
    let fallback_type_size: Text = core_llvm_size_of(item_type, lines, temp_serial)
    let fallback_type_scratch: Text = core_llvm_scratch_name(item_type)
    let fallback_type_status: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + fallback_type_status + " = call i32 @yaza_list_v1_get_typed(ptr " + fallback_child + ", i64 " + list_get(fallback_index, 1) + ", ptr " + fallback_type_signature + ", i64 " + fallback_type_size + ", ptr " + fallback_type_scratch + ")")
    let fallback_type_value: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + fallback_type_value + " = load " + core_llvm_type(item_type) + ", ptr " + fallback_type_scratch)
    let fallback_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    list_set(terminated, 0, "true")

    core_llvm_emit_label(lines, current, terminated, merge_label)
    let result: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + result + " = phi " + core_llvm_type(item_type) + " [ " + fast_value + ", %" + fast_predecessor + " ], [ " + fallback_type_value + ", %" + fallback_predecessor + " ]")
    return result

fn core_llvm_value(value_type: Text, code: Text) -> TextList:
    let value: TextList = text_list()
    list_push(value, value_type)
    list_push(value, code)
    return value

fn core_llvm_bytes_fields(value: Text, lines: TextList, temp_serial: TextList) -> TextList:
    let fields: TextList = text_list()
    let data: Text = core_llvm_temp(temp_serial)
    let length: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + data + " = extractvalue %yaza.bytes " + value + ", 0")
    list_push(lines, "  " + length + " = extractvalue %yaza.bytes " + value + ", 1")
    list_push(fields, data)
    list_push(fields, length)
    return fields

fn core_llvm_sum_payload_mode(value_type: Text) -> Number:
    if value_type == "Unit": return 0
    if value_type == "Number" or value_type == "Int32" or value_type == "Float64" or value_type == "Boolean": return 1
    if value_type == "Text" or value_type == "TextList" or text_starts_with(value_type, "List["): return 2
    return 3

fn core_llvm_sum_has_inline_bytes(descriptor_type: Text, payload_type: Text) -> Boolean:
    if payload_type != "Bytes": return false
    return descriptor_type == "%yaza.option.bytes" or descriptor_type == "%yaza.result.bytes"

fn core_llvm_sum_construct(descriptor_type: Text, tag: Text, payload_type: Text, payload_value: Text, lines: TextList, temp_serial: TextList) -> Text:
    let mode: Number = core_llvm_sum_payload_mode(payload_type)
    let inline_bytes: Boolean = core_llvm_sum_has_inline_bytes(descriptor_type, payload_type)
    var payload_bits: Text = "0"
    if mode == 1:
        set payload_bits = payload_value
        if payload_type == "Int32":
            set payload_bits = core_llvm_temp(temp_serial)
            list_push(lines, "  " + payload_bits + " = sext i32 " + payload_value + " to i64")
        if payload_type == "Boolean":
            set payload_bits = core_llvm_temp(temp_serial)
            list_push(lines, "  " + payload_bits + " = zext i1 " + payload_value + " to i64")
        if payload_type == "Float64":
            set payload_bits = core_llvm_temp(temp_serial)
            list_push(lines, "  " + payload_bits + " = bitcast double " + payload_value + " to i64")
    else:
        if mode == 2:
            let payload_pointer: Text = payload_value
            set payload_bits = core_llvm_temp(temp_serial)
            list_push(lines, "  " + payload_bits + " = ptrtoint ptr " + payload_pointer + " to i64")
        if mode == 3:
            if inline_bytes:
                let bytes_data: Text = core_llvm_temp(temp_serial)
                set payload_bits = core_llvm_temp(temp_serial)
                list_push(lines, "  " + bytes_data + " = extractvalue %yaza.bytes " + payload_value + ", 0")
                list_push(lines, "  " + payload_bits + " = ptrtoint ptr " + bytes_data + " to i64")
            else:
                let payload_size: Text = core_llvm_size_of(payload_type, lines, temp_serial)
                let payload_pointer: Text = core_llvm_temp(temp_serial)
                set payload_bits = core_llvm_temp(temp_serial)
                list_push(lines, "  " + payload_pointer + " = call ptr @yaza_rt_v1_alloc(i64 " + payload_size + ")")
                list_push(lines, "  store " + core_llvm_type(payload_type) + " " + payload_value + ", ptr " + payload_pointer)
                list_push(lines, "  " + payload_bits + " = ptrtoint ptr " + payload_pointer + " to i64")
    let with_tag: Text = core_llvm_temp(temp_serial)
    let with_payload: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + with_tag + " = insertvalue " + descriptor_type + " undef, i32 " + tag + ", 0")
    list_push(lines, "  " + with_payload + " = insertvalue " + descriptor_type + " " + with_tag + ", i64 " + payload_bits + ", 1")
    if inline_bytes:
        let bytes_length: Text = core_llvm_temp(temp_serial)
        let with_length: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + bytes_length + " = extractvalue %yaza.bytes " + payload_value + ", 1")
        list_push(lines, "  " + with_length + " = insertvalue " + descriptor_type + " " + with_payload + ", i64 " + bytes_length + ", 2")
        return with_length
    return with_payload

fn core_llvm_sum_try_construct(descriptor_type: Text, tag: Text, payload_type: Text, payload_value: Text, allocation_error_label: Text, lines: TextList, temp_serial: TextList, label_serial: TextList, current: TextList, terminated: TextList) -> Text:
    let mode: Number = core_llvm_sum_payload_mode(payload_type)
    let inline_bytes: Boolean = core_llvm_sum_has_inline_bytes(descriptor_type, payload_type)
    if mode != 3 or inline_bytes: return core_llvm_sum_construct(descriptor_type, tag, payload_type, payload_value, lines, temp_serial)
    let payload_size: Text = core_llvm_size_of(payload_type, lines, temp_serial)
    let payload_pointer: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + payload_pointer + " = call ptr @yaza_rt_v1_try_alloc(i64 " + payload_size + ")")
    let allocated: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + allocated + " = icmp ne ptr " + payload_pointer + ", null")
    let success_label: Text = core_llvm_label(label_serial, "sum.alloc.ok.")
    list_push(lines, "  br i1 " + allocated + ", label %" + success_label + ", label %" + allocation_error_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, success_label)
    list_push(lines, "  store " + core_llvm_type(payload_type) + " " + payload_value + ", ptr " + payload_pointer)
    let payload_bits: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + payload_bits + " = ptrtoint ptr " + payload_pointer + " to i64")
    let with_tag: Text = core_llvm_temp(temp_serial)
    let with_payload: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + with_tag + " = insertvalue " + descriptor_type + " undef, i32 " + tag + ", 0")
    list_push(lines, "  " + with_payload + " = insertvalue " + descriptor_type + " " + with_tag + ", i64 " + payload_bits + ", 1")
    return with_payload

fn core_llvm_emit_fallible_sum_expr(expression: YirExpr, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList, functions: List[YirFunction], defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList) -> TextList:
    let payload: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    let error_label: Text = core_llvm_label(label_serial, "fallible.sum.error.")
    let merge_label: Text = core_llvm_label(label_serial, "fallible.sum.end.")
    var inner_tag: Text = "1"
    if expression.value2 == "err": set inner_tag = "0"
    let inner_value: Text = core_llvm_sum_try_construct(core_llvm_type(expression.value), inner_tag, list_get(payload, 0), list_get(payload, 1), error_label, lines, temp_serial, label_serial, current, terminated)
    let success_value: Text = core_llvm_sum_try_construct(core_llvm_type(expression.value_type), "1", expression.value, inner_value, error_label, lines, temp_serial, label_serial, current, terminated)
    let success_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, error_label)
    let error_text: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + error_text + " = call ptr @yaza_rt_v1_text_allocation_error()")
    let error_value: Text = core_llvm_sum_construct(core_llvm_type(expression.value_type), "0", "Text", error_text, lines, temp_serial)
    let error_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, merge_label)
    let result: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + result + " = phi " + core_llvm_type(expression.value_type) + " [ " + success_value + ", %" + success_predecessor + " ], [ " + error_value + ", %" + error_predecessor + " ]")
    return core_llvm_value(expression.value_type, result)

fn core_llvm_emit_fallible_variant_expr(expression: YirExpr, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList, functions: List[YirFunction], defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList) -> TextList:
    let payload_values: List[TextList] = List[TextList]()
    var field_index: Number = 0
    while field_index < list_count(expression.children):
        list_push(payload_values, core_llvm_emit_expr(list_get(expression.children, field_index), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth))
        set field_index = field_index + 1
    let variant_size: Text = core_llvm_size_of(expression.value, lines, temp_serial)
    var total_size: Text = variant_size
    var payload_type: Text = ""
    if list_count(expression.children) > 0:
        set payload_type = "%yaza.variantpayload." + expression.value + "." + expression.value2
        let size_pointer: Text = core_llvm_temp(temp_serial)
        let payload_size: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + size_pointer + " = getelementptr " + payload_type + ", ptr null, i32 1")
        list_push(lines, "  " + payload_size + " = ptrtoint ptr " + size_pointer + " to i64")
        set total_size = core_llvm_temp(temp_serial)
        list_push(lines, "  " + total_size + " = add i64 " + variant_size + ", " + payload_size)
    let memory: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + memory + " = call ptr @yaza_rt_v1_try_alloc(i64 " + total_size + ")")
    let allocated: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + allocated + " = icmp ne ptr " + memory + ", null")
    let success_label: Text = core_llvm_label(label_serial, "variant.result.ok.")
    let error_label: Text = core_llvm_label(label_serial, "variant.result.error.")
    let merge_label: Text = core_llvm_label(label_serial, "variant.result.end.")
    list_push(lines, "  br i1 " + allocated + ", label %" + success_label + ", label %" + error_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, success_label)
    var variant_payload_pointer: Text = "null"
    if list_count(expression.children) > 0:
        set variant_payload_pointer = core_llvm_temp(temp_serial)
        list_push(lines, "  " + variant_payload_pointer + " = getelementptr i8, ptr " + memory + ", i64 " + variant_size)
        var aggregate: Text = "undef"
        set field_index = 0
        while field_index < list_count(payload_values):
            let field_value: TextList = list_get(payload_values, field_index)
            let inserted: Text = core_llvm_temp(temp_serial)
            list_push(lines, "  " + inserted + " = insertvalue " + payload_type + " " + aggregate + ", " + core_llvm_type(list_get(field_value, 0)) + " " + list_get(field_value, 1) + ", " + number_text(field_index))
            set aggregate = inserted
            set field_index = field_index + 1
        list_push(lines, "  store " + payload_type + " " + aggregate + ", ptr " + variant_payload_pointer)
    let variant_with_tag: Text = core_llvm_temp(temp_serial)
    let variant_value: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + variant_with_tag + " = insertvalue " + core_llvm_type(expression.value) + " undef, i32 " + expression.value2 + ", 0")
    list_push(lines, "  " + variant_value + " = insertvalue " + core_llvm_type(expression.value) + " " + variant_with_tag + ", ptr " + variant_payload_pointer + ", 1")
    list_push(lines, "  store " + core_llvm_type(expression.value) + " " + variant_value + ", ptr " + memory)
    let memory_bits: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + memory_bits + " = ptrtoint ptr " + memory + " to i64")
    let result_tag: Text = core_llvm_temp(temp_serial)
    let success_value: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + result_tag + " = insertvalue " + core_llvm_type(expression.value_type) + " undef, i32 1, 0")
    list_push(lines, "  " + success_value + " = insertvalue " + core_llvm_type(expression.value_type) + " " + result_tag + ", i64 " + memory_bits + ", 1")
    let success_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, error_label)
    let error_text: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + error_text + " = call ptr @yaza_rt_v1_text_allocation_error()")
    let error_value: Text = core_llvm_sum_construct(core_llvm_type(expression.value_type), "0", "Text", error_text, lines, temp_serial)
    let error_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, merge_label)
    let result: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + result + " = phi " + core_llvm_type(expression.value_type) + " [ " + success_value + ", %" + success_predecessor + " ], [ " + error_value + ", %" + error_predecessor + " ]")
    return core_llvm_value(expression.value_type, result)

fn core_llvm_sum_extract(descriptor_type: Text, sum_value: Text, payload_type: Text, lines: TextList, temp_serial: TextList) -> Text:
    let mode: Number = core_llvm_sum_payload_mode(payload_type)
    let inline_bytes: Boolean = core_llvm_sum_has_inline_bytes(descriptor_type, payload_type)
    if mode == 0: return ""
    let payload_bits: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + payload_bits + " = extractvalue " + descriptor_type + " " + sum_value + ", 1")
    if mode == 2:
        let payload_pointer: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + payload_pointer + " = inttoptr i64 " + payload_bits + " to ptr")
        return payload_pointer
    if mode == 1:
        if payload_type == "Number": return payload_bits
        if payload_type == "Int32":
            let integer: Text = core_llvm_temp(temp_serial)
            list_push(lines, "  " + integer + " = trunc i64 " + payload_bits + " to i32")
            return integer
        if payload_type == "Boolean":
            let boolean: Text = core_llvm_temp(temp_serial)
            list_push(lines, "  " + boolean + " = icmp ne i64 " + payload_bits + ", 0")
            return boolean
        let floating: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + floating + " = bitcast i64 " + payload_bits + " to double")
        return floating
    if inline_bytes:
        let bytes_data: Text = core_llvm_temp(temp_serial)
        let bytes_length: Text = core_llvm_temp(temp_serial)
        let bytes_with_data: Text = core_llvm_temp(temp_serial)
        let bytes_value: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + bytes_data + " = inttoptr i64 " + payload_bits + " to ptr")
        list_push(lines, "  " + bytes_length + " = extractvalue " + descriptor_type + " " + sum_value + ", 2")
        list_push(lines, "  " + bytes_with_data + " = insertvalue %yaza.bytes undef, ptr " + bytes_data + ", 0")
        list_push(lines, "  " + bytes_value + " = insertvalue %yaza.bytes " + bytes_with_data + ", i64 " + bytes_length + ", 1")
        return bytes_value
    let payload_pointer: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + payload_pointer + " = inttoptr i64 " + payload_bits + " to ptr")
    let loaded: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + loaded + " = load " + core_llvm_type(payload_type) + ", ptr " + payload_pointer)
    return loaded

fn core_llvm_emit_static_bytes_result_error(lines: TextList, temp_serial: TextList) -> Text:
    return core_llvm_sum_construct("%yaza.result.bytes", "0", "Text", "@.yaza.core.result.bytes.fallback.text", lines, temp_serial)

fn core_llvm_emit_static_text_result_error(lines: TextList, temp_serial: TextList) -> Text:
    let error_text: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + error_text + " = call ptr @yaza_rt_v1_text_allocation_error()")
    return core_llvm_sum_construct("%yaza.result", "0", "Text", error_text, lines, temp_serial)

fn core_llvm_emit_static_list_result_error(lines: TextList, temp_serial: TextList) -> Text:
    let error_text: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + error_text + " = call ptr @yaza_rt_v1_list_allocation_error()")
    return core_llvm_sum_construct("%yaza.result", "0", "Text", error_text, lines, temp_serial)

fn core_llvm_emit_text_repeat_result(status: Text, text_scratch: Text, lines: TextList, temp_serial: TextList, label_serial: TextList, current: TextList, terminated: TextList) -> Text:
    let succeeded: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + succeeded + " = icmp eq i32 " + status + ", 1")
    let success_label: Text = core_llvm_label(label_serial, "text.repeat.ok.")
    let failure_label: Text = core_llvm_label(label_serial, "text.repeat.failure.")
    let count_error_label: Text = core_llvm_label(label_serial, "text.repeat.count.")
    let size_check_label: Text = core_llvm_label(label_serial, "text.repeat.size.check.")
    let size_error_label: Text = core_llvm_label(label_serial, "text.repeat.size.")
    let allocation_error_label: Text = core_llvm_label(label_serial, "text.repeat.allocation.")
    let merge_label: Text = core_llvm_label(label_serial, "text.repeat.end.")
    list_push(lines, "  br i1 " + succeeded + ", label %" + success_label + ", label %" + failure_label)
    list_set(terminated, 0, "true")

    core_llvm_emit_label(lines, current, terminated, success_label)
    let text_value: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + text_value + " = load ptr, ptr " + text_scratch)
    let success_result: Text = core_llvm_sum_construct("%yaza.result", "1", "Text", text_value, lines, temp_serial)
    let success_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    list_set(terminated, 0, "true")

    core_llvm_emit_label(lines, current, terminated, failure_label)
    let is_count_error: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + is_count_error + " = icmp eq i32 " + status + ", -1")
    list_push(lines, "  br i1 " + is_count_error + ", label %" + count_error_label + ", label %" + size_check_label)
    list_set(terminated, 0, "true")

    core_llvm_emit_label(lines, current, terminated, count_error_label)
    let count_error_text: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + count_error_text + " = call ptr @yaza_rt_v1_text_repeat_count_error()")
    let count_error_result: Text = core_llvm_sum_construct("%yaza.result", "0", "Text", count_error_text, lines, temp_serial)
    let count_error_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    list_set(terminated, 0, "true")

    core_llvm_emit_label(lines, current, terminated, size_check_label)
    let is_size_error: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + is_size_error + " = icmp eq i32 " + status + ", -2")
    list_push(lines, "  br i1 " + is_size_error + ", label %" + size_error_label + ", label %" + allocation_error_label)
    list_set(terminated, 0, "true")

    core_llvm_emit_label(lines, current, terminated, size_error_label)
    let size_error_text: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + size_error_text + " = call ptr @yaza_rt_v1_text_repeat_size_error()")
    let size_error_result: Text = core_llvm_sum_construct("%yaza.result", "0", "Text", size_error_text, lines, temp_serial)
    let size_error_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    list_set(terminated, 0, "true")

    core_llvm_emit_label(lines, current, terminated, allocation_error_label)
    let allocation_result: Text = core_llvm_emit_static_text_result_error(lines, temp_serial)
    let allocation_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    list_set(terminated, 0, "true")

    core_llvm_emit_label(lines, current, terminated, merge_label)
    let result: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + result + " = phi %yaza.result [ " + success_result + ", %" + success_predecessor + " ], [ " + count_error_result + ", %" + count_error_predecessor + " ], [ " + size_error_result + ", %" + size_error_predecessor + " ], [ " + allocation_result + ", %" + allocation_predecessor + " ]")
    return result

fn core_llvm_emit_text_pointer_result(text_pointer: Text, lines: TextList, temp_serial: TextList, label_serial: TextList, current: TextList, terminated: TextList) -> Text:
    let has_text: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + has_text + " = icmp ne ptr " + text_pointer + ", null")
    let success_label: Text = core_llvm_label(label_serial, "text.result.ok.")
    let error_label: Text = core_llvm_label(label_serial, "text.result.error.")
    let merge_label: Text = core_llvm_label(label_serial, "text.result.end.")
    list_push(lines, "  br i1 " + has_text + ", label %" + success_label + ", label %" + error_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, success_label)
    let success_result: Text = core_llvm_sum_construct("%yaza.result", "1", "Text", text_pointer, lines, temp_serial)
    let success_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    core_llvm_emit_label(lines, current, terminated, error_label)
    let error_result: Text = core_llvm_emit_static_text_result_error(lines, temp_serial)
    let error_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    core_llvm_emit_label(lines, current, terminated, merge_label)
    let result: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + result + " = phi %yaza.result [ " + success_result + ", %" + success_predecessor + " ], [ " + error_result + ", %" + error_predecessor + " ]")
    return result

fn core_llvm_emit_try_numeric_parse(helper: Text, payload_type: Text, error_message: Text, text_pointer: Text, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList) -> TextList:
    let output_slot: Text = core_llvm_scratch_name(payload_type)
    let status: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + status + " = call i32 " + helper + "(ptr " + text_pointer + ", ptr " + output_slot + ")")
    let succeeded: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + succeeded + " = icmp eq i32 " + status + ", 1")
    let success_label: Text = core_llvm_label(label_serial, "numeric.parse.ok.")
    let failure_label: Text = core_llvm_label(label_serial, "numeric.parse.error.")
    let merge_label: Text = core_llvm_label(label_serial, "numeric.parse.end.")
    list_push(lines, "  br i1 " + succeeded + ", label %" + success_label + ", label %" + failure_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, success_label)
    let parsed: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + parsed + " = load " + core_llvm_type(payload_type) + ", ptr " + output_slot)
    let success_value: Text = core_llvm_sum_construct("%yaza.result", "1", payload_type, parsed, lines, temp_serial)
    let success_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, failure_label)
    let error_pointer: Text = core_llvm_pointer_to_string(error_message, strings)
    let error_value: Text = core_llvm_sum_construct("%yaza.result", "0", "Text", error_pointer, lines, temp_serial)
    let error_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, merge_label)
    let result: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + result + " = phi %yaza.result [ " + success_value + ", %" + success_predecessor + " ], [ " + error_value + ", %" + error_predecessor + " ]")
    return core_llvm_value("Result[" + payload_type + ",Text]", result)

fn core_llvm_emit_text_list_status_result(status: Text, list_scratch: Text, lines: TextList, temp_serial: TextList, label_serial: TextList, current: TextList, terminated: TextList) -> Text:
    let succeeded: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + succeeded + " = icmp eq i32 " + status + ", 1")
    let success_label: Text = core_llvm_label(label_serial, "text.list.ok.")
    let failure_label: Text = core_llvm_label(label_serial, "text.list.error.")
    let allocation_error_label: Text = core_llvm_label(label_serial, "text.list.alloc.error.")
    let delimiter_error_label: Text = core_llvm_label(label_serial, "text.list.delimiter.error.")
    let merge_label: Text = core_llvm_label(label_serial, "text.list.end.")
    list_push(lines, "  br i1 " + succeeded + ", label %" + success_label + ", label %" + failure_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, success_label)
    let list_value: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + list_value + " = load ptr, ptr " + list_scratch)
    let success_result: Text = core_llvm_sum_construct("%yaza.result", "1", "TextList", list_value, lines, temp_serial)
    let success_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    core_llvm_emit_label(lines, current, terminated, failure_label)
    let invalid_delimiter: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + invalid_delimiter + " = icmp eq i32 " + status + ", -1")
    list_push(lines, "  br i1 " + invalid_delimiter + ", label %" + delimiter_error_label + ", label %" + allocation_error_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, allocation_error_label)
    let allocation_error: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + allocation_error + " = call ptr @yaza_rt_v1_list_allocation_error()")
    let allocation_result: Text = core_llvm_sum_construct("%yaza.result", "0", "Text", allocation_error, lines, temp_serial)
    let allocation_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    core_llvm_emit_label(lines, current, terminated, delimiter_error_label)
    let delimiter_error: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + delimiter_error + " = call ptr @yaza_rt_v1_text_split_delimiter_error()")
    let delimiter_result: Text = core_llvm_sum_construct("%yaza.result", "0", "Text", delimiter_error, lines, temp_serial)
    let delimiter_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    core_llvm_emit_label(lines, current, terminated, merge_label)
    let result: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + result + " = phi %yaza.result [ " + success_result + ", %" + success_predecessor + " ], [ " + allocation_result + ", %" + allocation_predecessor + " ], [ " + delimiter_result + ", %" + delimiter_predecessor + " ]")
    return result

fn core_llvm_emit_text_slice_result(status: Text, text_scratch: Text, lines: TextList, temp_serial: TextList, label_serial: TextList, current: TextList, terminated: TextList) -> Text:
    let succeeded: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + succeeded + " = icmp eq i32 " + status + ", 1")
    let success_label: Text = core_llvm_label(label_serial, "text.slice.ok.")
    let failure_label: Text = core_llvm_label(label_serial, "text.slice.error.")
    let allocation_error_label: Text = core_llvm_label(label_serial, "text.slice.alloc.error.")
    let range_error_label: Text = core_llvm_label(label_serial, "text.slice.range.error.")
    let merge_label: Text = core_llvm_label(label_serial, "text.slice.end.")
    list_push(lines, "  br i1 " + succeeded + ", label %" + success_label + ", label %" + failure_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, success_label)
    let text_value: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + text_value + " = load ptr, ptr " + text_scratch)
    let success_result: Text = core_llvm_sum_construct("%yaza.result", "1", "Text", text_value, lines, temp_serial)
    let success_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    core_llvm_emit_label(lines, current, terminated, failure_label)
    let allocation_failed: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + allocation_failed + " = icmp eq i32 " + status + ", 0")
    list_push(lines, "  br i1 " + allocation_failed + ", label %" + allocation_error_label + ", label %" + range_error_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, allocation_error_label)
    let allocation_error: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + allocation_error + " = call ptr @yaza_rt_v1_text_allocation_error()")
    let allocation_result: Text = core_llvm_sum_construct("%yaza.result", "0", "Text", allocation_error, lines, temp_serial)
    let allocation_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    core_llvm_emit_label(lines, current, terminated, range_error_label)
    let range_error: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + range_error + " = call ptr @yaza_rt_v1_text_slice_range_error()")
    let range_result: Text = core_llvm_sum_construct("%yaza.result", "0", "Text", range_error, lines, temp_serial)
    let range_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    core_llvm_emit_label(lines, current, terminated, merge_label)
    let result: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + result + " = phi %yaza.result [ " + success_result + ", %" + success_predecessor + " ], [ " + allocation_result + ", %" + allocation_predecessor + " ], [ " + range_result + ", %" + range_predecessor + " ]")
    return result

fn core_llvm_emit_text_status_result(success_code: Text, text_scratch: Text, error_scratch: Text, lines: TextList, temp_serial: TextList, label_serial: TextList, current: TextList, terminated: TextList) -> Text:
    let succeeded: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + succeeded + " = icmp ne i32 " + success_code + ", 0")
    let success_label: Text = core_llvm_label(label_serial, "text.status.ok.")
    let error_label: Text = core_llvm_label(label_serial, "text.status.error.")
    let error_text_label: Text = core_llvm_label(label_serial, "text.status.error.text.")
    let error_text_fail_label: Text = core_llvm_label(label_serial, "text.status.error.fallback.")
    let merge_label: Text = core_llvm_label(label_serial, "text.status.end.")
    list_push(lines, "  br i1 " + succeeded + ", label %" + success_label + ", label %" + error_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, success_label)
    let text_value: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + text_value + " = load ptr, ptr " + text_scratch)
    let success_result: Text = core_llvm_sum_construct("%yaza.result", "1", "Text", text_value, lines, temp_serial)
    let success_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    core_llvm_emit_label(lines, current, terminated, error_label)
    let error_message: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + error_message + " = load ptr, ptr " + error_scratch)
    let error_text: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + error_text + " = call ptr @yaza_rt_v1_try_text_from_cstr(ptr " + error_message + ")")
    let has_error_text: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + has_error_text + " = icmp ne ptr " + error_text + ", null")
    list_push(lines, "  br i1 " + has_error_text + ", label %" + error_text_label + ", label %" + error_text_fail_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, error_text_label)
    let error_result: Text = core_llvm_sum_construct("%yaza.result", "0", "Text", error_text, lines, temp_serial)
    let error_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    core_llvm_emit_label(lines, current, terminated, error_text_fail_label)
    let fallback_result: Text = core_llvm_emit_static_text_result_error(lines, temp_serial)
    let fallback_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    core_llvm_emit_label(lines, current, terminated, merge_label)
    let result: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + result + " = phi %yaza.result [ " + success_result + ", %" + success_predecessor + " ], [ " + error_result + ", %" + error_predecessor + " ], [ " + fallback_result + ", %" + fallback_predecessor + " ]")
    return result

fn core_llvm_emit_bytes_text_result(success_code: Text, bytes_scratch: Text, error_scratch: Text, lines: TextList, temp_serial: TextList, label_serial: TextList, current: TextList, terminated: TextList) -> Text:
    let has_bytes: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + has_bytes + " = icmp ne i32 " + success_code + ", 0")
    let ok_label: Text = core_llvm_label(label_serial, "bytes.result.ok.")
    let error_label: Text = core_llvm_label(label_serial, "bytes.result.error.")
    let error_text_label: Text = core_llvm_label(label_serial, "bytes.result.error.text.")
    let error_text_fail_label: Text = core_llvm_label(label_serial, "bytes.result.error.text.fail.")
    let merge_label: Text = core_llvm_label(label_serial, "bytes.result.end.")
    list_push(lines, "  br i1 " + has_bytes + ", label %" + ok_label + ", label %" + error_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, ok_label)
    let bytes_value: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + bytes_value + " = load %yaza.bytes, ptr " + bytes_scratch)
    let bytes_data: Text = core_llvm_temp(temp_serial)
    let bytes_length: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + bytes_data + " = extractvalue %yaza.bytes " + bytes_value + ", 0")
    list_push(lines, "  " + bytes_length + " = extractvalue %yaza.bytes " + bytes_value + ", 1")
    let ok_payload_bits: Text = core_llvm_temp(temp_serial)
    let ok_tag: Text = core_llvm_temp(temp_serial)
    let ok_payload: Text = core_llvm_temp(temp_serial)
    let ok_result: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + ok_payload_bits + " = ptrtoint ptr " + bytes_data + " to i64")
    list_push(lines, "  " + ok_tag + " = insertvalue %yaza.result.bytes undef, i32 1, 0")
    list_push(lines, "  " + ok_payload + " = insertvalue %yaza.result.bytes " + ok_tag + ", i64 " + ok_payload_bits + ", 1")
    list_push(lines, "  " + ok_result + " = insertvalue %yaza.result.bytes " + ok_payload + ", i64 " + bytes_length + ", 2")
    let ok_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    core_llvm_emit_label(lines, current, terminated, error_label)
    let error_message: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + error_message + " = load ptr, ptr " + error_scratch)
    let error_value: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + error_value + " = call ptr @yaza_rt_v1_try_text_from_cstr(ptr " + error_message + ")")
    let has_error_value: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + has_error_value + " = icmp ne ptr " + error_value + ", null")
    list_push(lines, "  br i1 " + has_error_value + ", label %" + error_text_label + ", label %" + error_text_fail_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, error_text_label)
    let error_result: Text = core_llvm_sum_construct("%yaza.result.bytes", "0", "Text", error_value, lines, temp_serial)
    let error_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    core_llvm_emit_label(lines, current, terminated, error_text_fail_label)
    let error_text_fail_result: Text = core_llvm_emit_static_bytes_result_error(lines, temp_serial)
    let error_text_fail_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    core_llvm_emit_label(lines, current, terminated, merge_label)
    let result: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + result + " = phi %yaza.result.bytes [ " + ok_result + ", %" + ok_predecessor + " ], [ " + error_result + ", %" + error_predecessor + " ], [ " + error_text_fail_result + ", %" + error_text_fail_predecessor + " ]")
    return result

fn core_llvm_emit_vfs_status_result(success_code: Text, result_type: Text, payload_type: Text, payload_value: Text, error_scratch: Text, lines: TextList, temp_serial: TextList, label_serial: TextList, current: TextList, terminated: TextList) -> Text:
    let descriptor: Text = core_llvm_type(result_type)
    let succeeded: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + succeeded + " = icmp ne i32 " + success_code + ", 0")
    let success_label: Text = core_llvm_label(label_serial, "vfs.result.ok.")
    let error_label: Text = core_llvm_label(label_serial, "vfs.result.error.")
    let error_text_label: Text = core_llvm_label(label_serial, "vfs.result.error.text.")
    let fallback_label: Text = core_llvm_label(label_serial, "vfs.result.error.fallback.")
    let merge_label: Text = core_llvm_label(label_serial, "vfs.result.end.")
    list_push(lines, "  br i1 " + succeeded + ", label %" + success_label + ", label %" + error_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, success_label)
    let success_result: Text = core_llvm_sum_construct(descriptor, "1", payload_type, payload_value, lines, temp_serial)
    let success_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    core_llvm_emit_label(lines, current, terminated, error_label)
    let error_message: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + error_message + " = load ptr, ptr " + error_scratch)
    let error_text: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + error_text + " = call ptr @yaza_rt_v1_try_text_from_cstr(ptr " + error_message + ")")
    let has_error_text: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + has_error_text + " = icmp ne ptr " + error_text + ", null")
    list_push(lines, "  br i1 " + has_error_text + ", label %" + error_text_label + ", label %" + fallback_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, error_text_label)
    let error_result: Text = core_llvm_sum_construct(descriptor, "0", "Text", error_text, lines, temp_serial)
    let error_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    core_llvm_emit_label(lines, current, terminated, fallback_label)
    let fallback_result: Text = core_llvm_emit_static_text_result_error(lines, temp_serial)
    let fallback_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    core_llvm_emit_label(lines, current, terminated, merge_label)
    let result: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + result + " = phi " + descriptor + " [ " + success_result + ", %" + success_predecessor + " ], [ " + error_result + ", %" + error_predecessor + " ], [ " + fallback_result + ", %" + fallback_predecessor + " ]")
    return result

fn core_llvm_size_of(value_type: Text, lines: TextList, temp_serial: TextList) -> Text:
    let size_pointer: Text = core_llvm_temp(temp_serial)
    let size: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + size_pointer + " = getelementptr " + core_llvm_type(value_type) + ", ptr null, i64 1")
    list_push(lines, "  " + size + " = ptrtoint ptr " + size_pointer + " to i64")
    return size

fn core_llvm_scratch_name(value_type: Text) -> Text:
    var encoded: Text = ""
    var index: Number = 0
    while index < text_length(value_type):
        let byte: Number = text_byte(value_type, index)
        set encoded = encoded + core_llvm_hex_digit(byte / 16) + core_llvm_hex_digit(byte % 16)
        set index = index + 1
    return "%yaza.scratch." + encoded

fn core_llvm_typed_list_create(collection_type: Text, lines: TextList, temp_serial: TextList, strings: TextList) -> Text:
    let item_type: Text = core_yir_list_element_type(collection_type)
    let element_size: Text = core_llvm_size_of(item_type, lines, temp_serial)
    let signature: Text = core_llvm_c_string_pointer(collection_type, strings)
    let result: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + result + " = call ptr @yaza_list_v1_create_typed(ptr " + signature + ", i64 " + element_size + ")")
    return result

fn core_llvm_typed_list_try_create(collection_type: Text, lines: TextList, temp_serial: TextList, strings: TextList) -> Text:
    let item_type: Text = core_yir_list_element_type(collection_type)
    let element_size: Text = core_llvm_size_of(item_type, lines, temp_serial)
    let signature: Text = core_llvm_c_string_pointer(collection_type, strings)
    let result: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + result + " = call ptr @yaza_list_v1_try_create_typed(ptr " + signature + ", i64 " + element_size + ")")
    return result

fn core_llvm_typed_list_push(list_pointer: Text, collection_type: Text, item_type: Text, item_value: Text, lines: TextList, temp_serial: TextList, strings: TextList) -> Text:
    let scratch: Text = core_llvm_scratch_name(item_type)
    let element_size: Text = core_llvm_size_of(item_type, lines, temp_serial)
    let signature: Text = core_llvm_c_string_pointer(collection_type, strings)
    list_push(lines, "  store " + core_llvm_type(item_type) + " " + item_value + ", ptr " + scratch)
    let result: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + result + " = call i64 @yaza_list_v1_push_typed(ptr " + list_pointer + ", ptr " + scratch + ", ptr " + signature + ", i64 " + element_size + ")")
    return result

fn core_llvm_typed_list_try_push(list_pointer: Text, collection_type: Text, item_type: Text, item_value: Text, lines: TextList, temp_serial: TextList, strings: TextList) -> Text:
    let scratch: Text = core_llvm_scratch_name(item_type)
    let element_size: Text = core_llvm_size_of(item_type, lines, temp_serial)
    let signature: Text = core_llvm_c_string_pointer(collection_type, strings)
    list_push(lines, "  store " + core_llvm_type(item_type) + " " + item_value + ", ptr " + scratch)
    let result: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + result + " = call i32 @yaza_list_v1_try_push_typed(ptr " + list_pointer + ", ptr " + scratch + ", ptr " + signature + ", i64 " + element_size + ")")
    return result

fn core_llvm_emit_fallible_list_literal_expr(expression: YirExpr, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList, functions: List[YirFunction], defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList) -> TextList:
    let collection_type: Text = expression.value
    let item_type: Text = core_yir_list_element_type(collection_type)
    let list_pointer: Text = core_llvm_typed_list_try_create(collection_type, lines, temp_serial, strings)
    let has_list: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + has_list + " = icmp ne ptr " + list_pointer + ", null")
    let items_label: Text = core_llvm_label(label_serial, "list.literal.items.")
    let error_label: Text = core_llvm_label(label_serial, "list.literal.error.")
    let merge_label: Text = core_llvm_label(label_serial, "list.literal.end.")
    list_push(lines, "  br i1 " + has_list + ", label %" + items_label + ", label %" + error_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, items_label)
    var item_index: Number = 0
    while item_index < list_count(expression.children):
        let item: TextList = core_llvm_emit_expr(list_get(expression.children, item_index), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let pushed: Text = core_llvm_typed_list_try_push(list_pointer, collection_type, item_type, list_get(item, 1), lines, temp_serial, strings)
        let item_stored: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + item_stored + " = icmp ne i32 " + pushed + ", 0")
        let next_item_label: Text = core_llvm_label(label_serial, "list.literal.next.")
        list_push(lines, "  br i1 " + item_stored + ", label %" + next_item_label + ", label %" + error_label)
        list_set(terminated, 0, "true")
        core_llvm_emit_label(lines, current, terminated, next_item_label)
        set item_index = item_index + 1
    let success_value: Text = core_llvm_sum_construct("%yaza.result", "1", collection_type, list_pointer, lines, temp_serial)
    let success_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, error_label)
    let error_value: Text = core_llvm_emit_static_list_result_error(lines, temp_serial)
    let error_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, merge_label)
    let result: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + result + " = phi %yaza.result [ " + success_value + ", %" + success_predecessor + " ], [ " + error_value + ", %" + error_predecessor + " ]")
    return core_llvm_value(expression.value_type, result)

fn core_llvm_emit_fallible_list_try_get_expr(expression: YirExpr, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList, functions: List[YirFunction], defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList) -> TextList:
    let collection: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    let collection_type: Text = list_get(collection, 0)
    let item_type: Text = core_yir_list_element_type(collection_type)
    let option_type: Text = expression.value
    let element_size: Text = core_llvm_size_of(item_type, lines, temp_serial)
    let signature: Text = core_llvm_c_string_pointer(collection_type, strings)
    let index: TextList = core_llvm_emit_expr(list_get(expression.children, 1), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    let out_pointer: Text = core_llvm_scratch_name(item_type)
    let status: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + status + " = call i32 @yaza_list_v1_try_get_typed(ptr " + list_get(collection, 1) + ", i64 " + list_get(index, 1) + ", ptr " + signature + ", i64 " + element_size + ", ptr " + out_pointer + ")")
    let has_value: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + has_value + " = icmp ne i32 " + status + ", 0")
    let some_label: Text = core_llvm_label(label_serial, "list.result.some.")
    let none_label: Text = core_llvm_label(label_serial, "list.result.none.")
    let error_label: Text = core_llvm_label(label_serial, "list.result.alloc.error.")
    let merge_label: Text = core_llvm_label(label_serial, "list.result.end.")
    list_push(lines, "  br i1 " + has_value + ", label %" + some_label + ", label %" + none_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, some_label)
    let item_value: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + item_value + " = load " + core_llvm_type(item_type) + ", ptr " + out_pointer)
    let option_value: Text = core_llvm_sum_try_construct(core_llvm_type(option_type), "1", item_type, item_value, error_label, lines, temp_serial, label_serial, current, terminated)
    let some_result: Text = core_llvm_sum_try_construct("%yaza.result", "1", option_type, option_value, error_label, lines, temp_serial, label_serial, current, terminated)
    let some_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, none_label)
    let none_option: Text = "zeroinitializer"
    let none_result: Text = core_llvm_sum_try_construct("%yaza.result", "1", option_type, none_option, error_label, lines, temp_serial, label_serial, current, terminated)
    let none_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, error_label)
    let error_result: Text = core_llvm_emit_static_list_result_error(lines, temp_serial)
    let error_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, merge_label)
    let result: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + result + " = phi %yaza.result [ " + some_result + ", %" + some_predecessor + " ], [ " + none_result + ", %" + none_predecessor + " ], [ " + error_result + ", %" + error_predecessor + " ]")
    return core_llvm_value(expression.value_type, result)

fn core_llvm_emit_defer_record(record: YirStatement, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList, functions: List[YirFunction], defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList) -> Number:
    if record.kind == "arena_scope_cleanup":
        let scope: Text = core_llvm_temp(temp_serial)
        let status: Text = core_llvm_temp(temp_serial)
        let failed: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + scope + " = load ptr, ptr " + record.slot)
        list_push(lines, "  " + status + " = call i32 @yaza_rt_v1_scope_leave(ptr " + scope + ")")
        list_push(lines, "  " + failed + " = icmp eq i32 " + status + ", 0")
        core_llvm_emit_trap_if(lines, current, terminated, label_serial, label_serial, strings, failed, "arena_scope could not close because a child scope or runtime lease is still active")
        return 0
    if record.expression.value == "__yaza_list_iter_end":
        let borrow: YirExpr = list_get(record.expression.children, 0)
        list_push(lines, "  call void @yaza_list_v1_iter_end(ptr " + borrow.value + ")")
        return 0
    if record.expression.value == "__yaza_list_read_view_end":
        let borrow: YirExpr = list_get(record.expression.children, 0)
        if list_count(record.expression.children) > 1:
            let local_borrow: YirExpr = list_get(record.expression.children, 1)
            list_push(lines, "  call void @yaza_list_v1_read_release_shared(ptr " + borrow.value + ", ptr " + local_borrow.value + ")")
        else:
            list_push(lines, "  call void @yaza_list_v1_read_end(ptr " + borrow.value + ")")
        return 0
    if record.expression.value == "__yaza_list_read_view_shared": return 0
    if record.expression.value == "__yaza_list_nested_read_view_end":
        let borrow: YirExpr = list_get(record.expression.children, 0)
        if list_count(record.expression.children) > 1:
            let local_borrow: YirExpr = list_get(record.expression.children, 1)
            list_push(lines, "  call void @yaza_list_v1_nested_read_release_shared(ptr " + borrow.value + ", ptr " + local_borrow.value + ")")
        else:
            list_push(lines, "  call void @yaza_list_v1_nested_read_end(ptr " + borrow.value + ")")
        return 0
    if record.expression.value == "__yaza_list_nested_read_view_shared": return 0
    if record.expression.value == "__yaza_list_mut_view_end":
        let borrow: YirExpr = list_get(record.expression.children, 0)
        list_push(lines, "  call void @yaza_list_v1_mut_end(ptr " + borrow.value + ")")
        return 0
    if record.expression.value == "__yaza_list_nested_mut_view_end":
        let borrow: YirExpr = list_get(record.expression.children, 0)
        list_push(lines, "  call void @yaza_list_v1_nested_mut_end(ptr " + borrow.value + ")")
        return 0
    let captured_arguments: List[YirExpr] = List[YirExpr]()
    var argument_index: Number = 0
    while argument_index < list_count(record.expression.children):
        let argument: YirExpr = list_get(record.expression.children, argument_index)
        let captured_slot: Text = record.slot + ".arg." + number_text(argument_index)
        list_push(captured_arguments, core_yir_expr("variable", captured_slot, argument.value_type, List[YirExpr](), record.source_line))
        set argument_index = argument_index + 1
    let deferred_call: YirExpr = core_yir_expr(record.expression.kind, record.expression.value, record.expression.value_type, captured_arguments, record.source_line)
    core_llvm_emit_expr(deferred_call, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    return 0

fn core_llvm_emit_defer_range(defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList, first: Number, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList, functions: List[YirFunction]) -> Number:
    var index: Number = number_parse(list_get(defer_depth, 0)) - 1
    while index >= first:
        let record_index: Number = number_parse(list_get(defer_stack, index))
        core_llvm_emit_defer_record(list_get(defer_records, record_index), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        set index = index - 1
    return 0

fn core_llvm_emit_try_expr(expression: YirExpr, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList, functions: List[YirFunction], defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList) -> TextList:
    let source_expression: YirExpr = list_get(expression.children, 0)
    let source: TextList = core_llvm_emit_expr(source_expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    let source_type: Text = source_expression.value_type
    let source_success: Text = core_yir_result_argument_type(source_type, 0)
    let source_error: Text = core_yir_result_argument_type(source_type, 1)
    let source_descriptor: Text = core_llvm_type(source_type)
    let target_descriptor: Text = core_llvm_type(expression.value)
    let tag: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + tag + " = extractvalue " + source_descriptor + " " + list_get(source, 1) + ", 0")
    let is_error: Text = core_llvm_temp(temp_serial)
    let is_success: Text = core_llvm_temp(temp_serial)
    let is_valid: Text = core_llvm_temp(temp_serial)
    let invalid: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + is_error + " = icmp eq i32 " + tag + ", 0")
    list_push(lines, "  " + is_success + " = icmp eq i32 " + tag + ", 1")
    list_push(lines, "  " + is_valid + " = or i1 " + is_error + ", " + is_success)
    list_push(lines, "  " + invalid + " = xor i1 " + is_valid + ", true")
    core_llvm_emit_trap_if(lines, current, terminated, label_serial, label_serial, strings, invalid, "invalid Result tag in postfix '?'")
    let error_label: Text = core_llvm_label(label_serial, "try.error.")
    let success_label: Text = core_llvm_label(label_serial, "try.success.")
    list_push(lines, "  br i1 " + is_success + ", label %" + success_label + ", label %" + error_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, error_label)
    let error_value: Text = core_llvm_sum_extract(source_descriptor, list_get(source, 1), source_error, lines, temp_serial)
    let target_error: Text = core_yir_result_argument_type(expression.value, 1)
    var error_result: Text = ""
    if expression.value2 != "":
        let converted_error: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + converted_error + " = call " + core_llvm_type(target_error) + " @yaza.core.fn." + expression.value2 + "(" + core_llvm_type(source_error) + " " + error_value + ")")
        set error_result = core_llvm_sum_construct(target_descriptor, "0", target_error, converted_error, lines, temp_serial)
    else:
        if source_descriptor == target_descriptor: set error_result = list_get(source, 1)
        else: set error_result = core_llvm_sum_construct(target_descriptor, "0", target_error, error_value, lines, temp_serial)
    core_llvm_emit_defer_range(defer_records, defer_stack, defer_depth, 0, lines, temp_serial, label_serial, strings, current, terminated, functions)
    list_push(lines, "  ret " + target_descriptor + " " + error_result + " ; propagated by ?")
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, success_label)
    let success_value: Text = core_llvm_sum_extract(source_descriptor, list_get(source, 1), source_success, lines, temp_serial)
    return core_llvm_value(source_success, success_value)

fn core_llvm_emit_try_return(expression: YirExpr, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList, functions: List[YirFunction], defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList) -> Number:
    let source_expression: YirExpr = list_get(expression.children, 0)
    let source: TextList = core_llvm_emit_expr(source_expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    let source_type: Text = source_expression.value_type
    let source_success: Text = core_yir_result_argument_type(source_type, 0)
    let source_error: Text = core_yir_result_argument_type(source_type, 1)
    let source_descriptor: Text = core_llvm_type(source_type)
    let target_descriptor: Text = core_llvm_type(expression.value)
    let tag: Text = core_llvm_temp(temp_serial)
    let is_error: Text = core_llvm_temp(temp_serial)
    let is_success: Text = core_llvm_temp(temp_serial)
    let is_valid: Text = core_llvm_temp(temp_serial)
    let invalid: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + tag + " = extractvalue " + source_descriptor + " " + list_get(source, 1) + ", 0")
    list_push(lines, "  " + is_error + " = icmp eq i32 " + tag + ", 0")
    list_push(lines, "  " + is_success + " = icmp eq i32 " + tag + ", 1")
    list_push(lines, "  " + is_valid + " = or i1 " + is_error + ", " + is_success)
    list_push(lines, "  " + invalid + " = xor i1 " + is_valid + ", true")
    core_llvm_emit_trap_if(lines, current, terminated, label_serial, label_serial, strings, invalid, "invalid Result tag in return '?'")
    let error_label: Text = core_llvm_label(label_serial, "try.return.error.")
    let success_label: Text = core_llvm_label(label_serial, "try.return.success.")
    list_push(lines, "  br i1 " + is_success + ", label %" + success_label + ", label %" + error_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, error_label)
    let error_value: Text = core_llvm_sum_extract(source_descriptor, list_get(source, 1), source_error, lines, temp_serial)
    let target_error: Text = core_yir_result_argument_type(expression.value, 1)
    var error_result: Text = ""
    if expression.value2 != "":
        let converted_error: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + converted_error + " = call " + core_llvm_type(target_error) + " @yaza.core.fn." + expression.value2 + "(" + core_llvm_type(source_error) + " " + error_value + ")")
        set error_result = core_llvm_sum_construct(target_descriptor, "0", target_error, converted_error, lines, temp_serial)
    else:
        if source_descriptor == target_descriptor: set error_result = list_get(source, 1)
        else: set error_result = core_llvm_sum_construct(target_descriptor, "0", target_error, error_value, lines, temp_serial)
    core_llvm_emit_defer_range(defer_records, defer_stack, defer_depth, 0, lines, temp_serial, label_serial, strings, current, terminated, functions)
    list_push(lines, "  ret " + target_descriptor + " " + error_result + " ; return propagated Result")
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, success_label)
    core_llvm_emit_defer_range(defer_records, defer_stack, defer_depth, 0, lines, temp_serial, label_serial, strings, current, terminated, functions)
    var success_result: Text = list_get(source, 1)
    if source_descriptor != target_descriptor:
        let success_value: Text = core_llvm_sum_extract(source_descriptor, list_get(source, 1), source_success, lines, temp_serial)
        set success_result = core_llvm_sum_construct(target_descriptor, "1", source_success, success_value, lines, temp_serial)
    list_push(lines, "  ret " + target_descriptor + " " + success_result + " ; return successful Result")
    list_set(terminated, 0, "true")
    return 0

fn core_llvm_emit_vfs_call(expression: YirExpr, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList, functions: List[YirFunction], defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList) -> TextList:
    let first: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    var second: TextList = text_list()
    var third: TextList = text_list()
    if list_count(expression.children) > 1: set second = core_llvm_emit_expr(list_get(expression.children, 1), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    if list_count(expression.children) > 2: set third = core_llvm_emit_expr(list_get(expression.children, 2), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    let error_scratch: Text = core_llvm_scratch_name("Text")
    var symbol: Text = ""
    var arguments: Text = ""
    var payload_scratch: Text = ""
    let payload_type: Text = core_yir_result_argument_type(expression.value_type, 0)
    if payload_type == "Number": set payload_scratch = core_llvm_scratch_name("Number")
    if payload_type == "Bytes": set payload_scratch = core_llvm_scratch_name("Bytes")
    if expression.value == "vfs_root_open":
        set symbol = "yaza_vfs_v1_root_open"
        set arguments = "ptr " + list_get(first, 1) + ", ptr " + payload_scratch + ", ptr " + error_scratch
    if expression.value == "vfs_open_read" or expression.value == "vfs_open_rw" or expression.value == "vfs_create_exclusive" or expression.value == "vfs_lock_exclusive":
        set symbol = "yaza_vfs_v1_open_read"
        if expression.value == "vfs_open_rw": set symbol = "yaza_vfs_v1_open_rw"
        if expression.value == "vfs_create_exclusive": set symbol = "yaza_vfs_v1_create_exclusive"
        if expression.value == "vfs_lock_exclusive": set symbol = "yaza_vfs_v1_lock_exclusive"
        set arguments = "i64 " + list_get(first, 1) + ", ptr " + list_get(second, 1) + ", ptr " + payload_scratch + ", ptr " + error_scratch
    if expression.value == "vfs_file_size":
        set symbol = "yaza_vfs_v1_file_size"
        set arguments = "i64 " + list_get(first, 1) + ", ptr " + payload_scratch + ", ptr " + error_scratch
    if expression.value == "vfs_list_names":
        set symbol = "yaza_vfs_v1_list_names"
        set arguments = "i64 " + list_get(first, 1) + ", ptr " + payload_scratch + ", ptr " + error_scratch
    if expression.value == "vfs_read_exact":
        set symbol = "yaza_vfs_v1_read_exact"
        set arguments = "i64 " + list_get(first, 1) + ", i64 " + list_get(second, 1) + ", i64 " + list_get(third, 1) + ", ptr " + payload_scratch + ", ptr " + error_scratch
    if expression.value == "vfs_write_exact":
        set symbol = "yaza_vfs_v1_write_exact"
        let bytes_scratch: Text = core_llvm_scratch_name("Bytes")
        list_push(lines, "  store %yaza.bytes " + list_get(third, 1) + ", ptr " + bytes_scratch)
        set arguments = "i64 " + list_get(first, 1) + ", i64 " + list_get(second, 1) + ", ptr " + bytes_scratch + ", ptr " + payload_scratch + ", ptr " + error_scratch
    if expression.value == "vfs_truncate":
        set symbol = "yaza_vfs_v1_truncate"
        set arguments = "i64 " + list_get(first, 1) + ", i64 " + list_get(second, 1) + ", ptr " + error_scratch
    if expression.value == "vfs_preallocate":
        set symbol = "yaza_vfs_v1_preallocate"
        set arguments = "i64 " + list_get(first, 1) + ", i64 " + list_get(second, 1) + ", ptr " + error_scratch
    if expression.value == "vfs_sync":
        set symbol = "yaza_vfs_v1_sync"
        set arguments = "i64 " + list_get(first, 1) + ", ptr " + error_scratch
    if expression.value == "vfs_sync_directory":
        set symbol = "yaza_vfs_v1_sync_directory"
        set arguments = "i64 " + list_get(first, 1) + ", ptr " + error_scratch
    if expression.value == "vfs_remove":
        set symbol = "yaza_vfs_v1_remove"
        set arguments = "i64 " + list_get(first, 1) + ", ptr " + list_get(second, 1) + ", ptr " + error_scratch
    if expression.value == "vfs_rename":
        set symbol = "yaza_vfs_v1_rename"
        set arguments = "i64 " + list_get(first, 1) + ", ptr " + list_get(second, 1) + ", ptr " + list_get(third, 1) + ", ptr " + error_scratch
    if expression.value == "vfs_close":
        set symbol = "yaza_vfs_v1_close"
        set arguments = "i64 " + list_get(first, 1) + ", ptr " + error_scratch
    let status: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + status + " = call i32 @" + symbol + "(" + arguments + ")")
    if payload_type == "Bytes":
        let bytes_result: Text = core_llvm_emit_bytes_text_result(status, payload_scratch, error_scratch, lines, temp_serial, label_serial, current, terminated)
        return core_llvm_value(expression.value_type, bytes_result)
    var payload_value: Text = "true"
    if payload_type == "Number":
        set payload_value = core_llvm_temp(temp_serial)
        list_push(lines, "  " + payload_value + " = load i64, ptr " + payload_scratch)
    let result: Text = core_llvm_emit_vfs_status_result(status, expression.value_type, payload_type, payload_value, error_scratch, lines, temp_serial, label_serial, current, terminated)
    return core_llvm_value(expression.value_type, result)

fn core_llvm_emit_net_call(expression: YirExpr, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList, functions: List[YirFunction], defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList) -> TextList:
    var first: TextList = text_list()
    var second: TextList = text_list()
    var third: TextList = text_list()
    if list_count(expression.children) > 0: set first = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    if list_count(expression.children) > 1: set second = core_llvm_emit_expr(list_get(expression.children, 1), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    if list_count(expression.children) > 2: set third = core_llvm_emit_expr(list_get(expression.children, 2), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    let error_scratch: Text = core_llvm_scratch_name("Text")
    var symbol: Text = ""
    var arguments: Text = ""
    var payload_scratch: Text = ""
    let payload_type: Text = core_yir_result_argument_type(expression.value_type, 0)
    if payload_type == "Number": set payload_scratch = core_llvm_scratch_name("Number")
    if payload_type == "Bytes": set payload_scratch = core_llvm_scratch_name("Bytes")
    if expression.value == "net_listen":
        set symbol = "yaza_net_v1_listen"
        set arguments = "ptr " + list_get(first, 1) + ", i64 " + list_get(second, 1) + ", i64 " + list_get(third, 1) + ", ptr " + payload_scratch + ", ptr " + error_scratch
    if expression.value == "net_connect":
        set symbol = "yaza_net_v1_connect"
        set arguments = "ptr " + list_get(first, 1) + ", i64 " + list_get(second, 1) + ", i64 " + list_get(third, 1) + ", ptr " + payload_scratch + ", ptr " + error_scratch
    if expression.value == "net_accept":
        set symbol = "yaza_net_v1_accept"
        set arguments = "i64 " + list_get(first, 1) + ", i64 " + list_get(second, 1) + ", ptr " + payload_scratch + ", ptr " + error_scratch
    if expression.value == "net_read":
        set symbol = "yaza_net_v1_read"
        set arguments = "i64 " + list_get(first, 1) + ", i64 " + list_get(second, 1) + ", i64 " + list_get(third, 1) + ", ptr " + payload_scratch + ", ptr " + error_scratch
    if expression.value == "net_write":
        set symbol = "yaza_net_v1_write"
        let bytes_scratch: Text = core_llvm_scratch_name("Bytes")
        list_push(lines, "  store %yaza.bytes " + list_get(second, 1) + ", ptr " + bytes_scratch)
        set arguments = "i64 " + list_get(first, 1) + ", ptr " + bytes_scratch + ", i64 " + list_get(third, 1) + ", ptr " + payload_scratch + ", ptr " + error_scratch
    if expression.value == "net_close":
        set symbol = "yaza_net_v1_close"
        set arguments = "i64 " + list_get(first, 1) + ", ptr " + error_scratch
    if expression.value == "net_pair_create":
        set symbol = "yaza_net_v1_pair_create"
        set arguments = "ptr " + payload_scratch + ", ptr " + error_scratch
    if expression.value == "net_pair_peer":
        set symbol = "yaza_net_v1_pair_peer"
        set arguments = "i64 " + list_get(first, 1) + ", ptr " + payload_scratch + ", ptr " + error_scratch
    let status: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + status + " = call i32 @" + symbol + "(" + arguments + ")")
    if payload_type == "Bytes":
        let bytes_result: Text = core_llvm_emit_bytes_text_result(status, payload_scratch, error_scratch, lines, temp_serial, label_serial, current, terminated)
        return core_llvm_value(expression.value_type, bytes_result)
    var payload_value: Text = "true"
    if payload_type == "Number":
        set payload_value = core_llvm_temp(temp_serial)
        list_push(lines, "  " + payload_value + " = load i64, ptr " + payload_scratch)
    let result: Text = core_llvm_emit_vfs_status_result(status, expression.value_type, payload_type, payload_value, error_scratch, lines, temp_serial, label_serial, current, terminated)
    return core_llvm_value(expression.value_type, result)

fn core_llvm_emit_call_view_expr(expression: YirExpr, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList, functions: List[YirFunction], defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList) -> TextList:
    if expression.value == "list_read_view" or expression.value == "list_read_view_prefix":
        let collection: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let collection_type: Text = list_get(collection, 0)
        let item_type: Text = core_yir_list_element_type(collection_type)
        let element_size: Text = core_llvm_size_of(item_type, lines, temp_serial)
        let signature: Text = core_llvm_c_string_pointer(collection_type, strings)
        let result: Text = core_llvm_temp(temp_serial)
        if expression.value == "list_read_view_prefix":
            let prefix_length: TextList = core_llvm_emit_expr(list_get(expression.children, 1), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
            list_push(lines, "  " + result + " = call ptr @yaza_list_v1_read_view_prefix_typed(ptr " + list_get(collection, 1) + ", ptr " + signature + ", i64 " + element_size + ", i64 " + list_get(prefix_length, 1) + ")")
        else:
            list_push(lines, "  " + result + " = call ptr @yaza_list_v1_read_view_begin_typed(ptr " + list_get(collection, 1) + ", ptr " + signature + ", i64 " + element_size + ")")
        return core_llvm_value("ListView[" + item_type + "]", result)
    if expression.value == "list_view_get":
        let view_expression: YirExpr = list_get(expression.children, 0)
        let view: TextList = core_llvm_emit_expr(view_expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let index: TextList = core_llvm_emit_expr(list_get(expression.children, 1), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let item_type: Text = core_yir_list_view_element_type(list_get(view, 0))
        var items: Text = core_llvm_temp(temp_serial)
        var count: Text = core_llvm_temp(temp_serial)
        if core_llvm_is_list_view_parameter(view_expression):
            set items = core_llvm_list_view_parameter_items(view_expression.value)
            set count = core_llvm_list_view_parameter_count(view_expression.value)
        else:
            let items_field: Text = core_llvm_temp(temp_serial)
            let count_field: Text = core_llvm_temp(temp_serial)
            list_push(lines, "  " + items_field + " = getelementptr %yaza.list.borrow, ptr " + list_get(view, 1) + ", i32 0, i32 2")
            list_push(lines, "  " + items + " = load ptr, ptr " + items_field)
            list_push(lines, "  " + count_field + " = getelementptr %yaza.list.borrow, ptr " + list_get(view, 1) + ", i32 0, i32 4")
            list_push(lines, "  " + count + " = load i64, ptr " + count_field)
        let in_bounds: Text = core_llvm_temp(temp_serial)
        let fast_label: Text = core_llvm_label(label_serial, "list.view.get.fast.")
        let fail_label: Text = core_llvm_label(label_serial, "list.view.get.fail.")
        let merge_label: Text = core_llvm_label(label_serial, "list.view.get.end.")
        list_push(lines, "  " + in_bounds + " = icmp ult i64 " + list_get(index, 1) + ", " + count)
        list_push(lines, "  br i1 " + in_bounds + ", label %" + fast_label + ", label %" + fail_label)
        list_set(terminated, 0, "true")
        core_llvm_emit_label(lines, current, terminated, fast_label)
        let item_pointer: Text = core_llvm_temp(temp_serial)
        let value: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + item_pointer + " = getelementptr " + core_llvm_type(item_type) + ", ptr " + items + ", i64 " + list_get(index, 1))
        list_push(lines, "  " + value + " = load " + core_llvm_type(item_type) + ", ptr " + item_pointer)
        list_push(lines, "  br label %" + merge_label)
        list_set(terminated, 0, "true")
        core_llvm_emit_label(lines, current, terminated, fail_label)
        list_push(lines, "  call void @yaza_list_v1_read_fail_bounds(ptr " + list_get(view, 1) + ", i64 " + list_get(index, 1) + ")")
        list_push(lines, "  unreachable")
        list_set(terminated, 0, "true")
        core_llvm_emit_label(lines, current, terminated, merge_label)
        return core_llvm_value(item_type, value)
    if expression.value == "list_view_count":
        let view_expression: YirExpr = list_get(expression.children, 0)
        let view: TextList = core_llvm_emit_expr(view_expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
