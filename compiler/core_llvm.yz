    if expression.kind == "list_get" and list_count(expression.children) > 0:
        let collection: YirExpr = list_get(expression.children, 0)
        if collection.kind == "variable" and collection.value == root and collection.value_type == "List[List[Number]]":
            return expression.value_type == "List[Number]" and core_llvm_nested_mut_safe_expr(list_get(expression.children, 1), root, functions)
        let parent: YirExpr = core_llvm_nested_mut_parent(collection)
        if parent.kind == "variable" and parent.value == root and expression.value_type == "Number":
            return core_llvm_nested_mut_safe_expr(list_get(expression.children, 1), root, functions)
        return false
    if expression.kind == "list_set" and list_count(expression.children) == 3:
        let parent: YirExpr = core_llvm_nested_mut_parent(list_get(expression.children, 0))
        if parent.kind != "variable" or parent.value != root: return false
        return core_llvm_nested_mut_safe_expr(list_get(expression.children, 1), root, functions) and core_llvm_nested_mut_safe_expr(list_get(expression.children, 2), root, functions)
    if expression.kind == "variable" or expression.kind == "number" or expression.kind == "float" or expression.kind == "boolean" or expression.kind == "text": return true
    if expression.kind != "binary" and expression.kind != "unary" and expression.kind != "sequence": return false
    var index: Number = 0
    while index < list_count(expression.children):
        if not core_llvm_nested_mut_safe_expr(list_get(expression.children, index), root, functions): return false
        set index = index + 1
    return true

fn core_llvm_nested_mut_safe_block(block: List[YirStatement], root: Text, functions: List[YirFunction]) -> Boolean:
    var index: Number = 0
    while index < list_count(block):
        let statement: YirStatement = list_get(block, index)
        if statement.kind == "break" or statement.kind == "continue":
            set index = index + 1
