# LLVM IR backend for the checked scalar/control-flow YIR profile.
use "core_yir"

fn core_llvm_type(value_type: Text) -> Text:
    if text_starts_with(value_type, "&mut "): return "ptr"
    if text_starts_with(value_type, "edit "): return "ptr"
    if text_starts_with(value_type, "&"): return "ptr"
    if text_starts_with(value_type, "move "): return core_llvm_type(text_slice(value_type, 5, text_length(value_type) - 5))
    if text_starts_with(value_type, "Task[") and text_ends_with(value_type, "]"):
        return "ptr"
    if text_starts_with(value_type, "Future[") and text_ends_with(value_type, "]"):
        return "ptr"
    if value_type == "Number": return "i64"
    if value_type == "Int32": return "i32"
    if value_type == "Float64": return "double"
    if value_type == "Boolean": return "i1"
    if value_type == "Text": return "ptr"
    if value_type == "Bytes": return "%yaza.bytes"
    if value_type == "YazaListBorrowV1": return "%yaza.list.borrow"
    if value_type == "YazaListNestedReadBorrowV1": return "%yaza.list.nested.readborrow"
    if value_type == "YazaListMutableBorrowV1": return "%yaza.list.mutborrow"
    if value_type == "YazaListNestedMutableBorrowV1": return "%yaza.list.nested.mutborrow"
    if value_type == "YazaArenaScopeV1": return "ptr"
    if value_type == "TextList" or text_starts_with(value_type, "List[") or text_starts_with(value_type, "ListView["): return "ptr"
    if text_starts_with(value_type, "Option["):
        if core_yir_option_payload_type(value_type) == "Bytes": return "%yaza.option.bytes"
        return "%yaza.option"
    if text_starts_with(value_type, "Result["):
        if core_yir_result_argument_type(value_type, 0) == "Bytes" or core_yir_result_argument_type(value_type, 1) == "Bytes": return "%yaza.result.bytes"
        return "%yaza.result"
    if value_type == "Unit": return "void"
    return "%yaza.shape." + value_type

fn core_llvm_float_literal(value: Text) -> Text:
    var exponent_index: Number = text_find(value, "e")
    if exponent_index < 0: set exponent_index = text_find(value, "E")
    if exponent_index < 0: return value
    var mantissa: Text = text_slice(value, 0, exponent_index)
    if text_find(mantissa, ".") < 0: set mantissa = mantissa + ".0"
    let exponent: Text = text_slice(value, exponent_index + 1, text_length(value) - exponent_index - 1)
    return mantissa + "e" + exponent

fn core_llvm_hex_digit(value: Number) -> Text:
    if value < 10: return number_text(value)
    if value == 10: return "A"
    if value == 11: return "B"
    if value == 12: return "C"
    if value == 13: return "D"
    if value == 14: return "E"
    return "F"

fn core_llvm_decode_text(value: Text) -> Text:
    var result: Text = ""
    var index: Number = 0
    var parsing: Boolean = true
    while index < text_length(value) and parsing:
        if text_byte(value, index) == 92 and index + 1 < text_length(value):
            let escaped: Text = text_slice(value, index + 1, 1)
            if escaped == "n": set result = result + "\n"
            else:
                if escaped == "r": set result = result + "\r"
                else:
                    if escaped == "t": set result = result + "\t"
                    else:
                        if escaped == "0": set parsing = false
                        else:
                            if escaped == "a": set result = result + "\a"
                            else:
                                if escaped == "b": set result = result + "\b"
                                else:
                                    if escaped == "f": set result = result + "\f"
                                    else:
                                        if escaped == "v": set result = result + "\v"
                                        else: set result = result + escaped
            set index = index + 2
        else:
            set result = result + text_slice(value, index, 1)
            set index = index + 1
    return result

fn core_llvm_escape_text(value: Text) -> Text:
    let bytes: Bytes = bytes_from_text(value)
    var output: Text = ""
    var index: Number = 0
    while index < bytes_length(bytes):
        let byte: Number = bytes_get(bytes, index)
        set output = output + "\\" + core_llvm_hex_digit(byte / 16) + core_llvm_hex_digit(byte % 16)
        set index = index + 1
    return output + "\\00"

fn core_llvm_temp(serial: TextList) -> Text:
    let index: Number = number_parse(list_get(serial, 0))
    list_set(serial, 0, number_text(index + 1))
    return "%v" + number_text(index)

fn core_llvm_label(serial: TextList, prefix: Text) -> Text:
    let index: Number = number_parse(list_get(serial, 0))
    list_set(serial, 0, number_text(index + 1))
    return prefix + number_text(index)

fn core_llvm_is_list_type(value_type: Text) -> Boolean:
    return value_type == "TextList" or text_starts_with(value_type, "List[")

fn core_llvm_arena_metric_symbol(name: Text) -> Text:
    if name == "arena_used": return "yaza_rt_v1_current_arena_used"
    if name == "arena_storage_used": return "yaza_rt_v1_current_arena_storage_used"
    if name == "arena_reserved": return "yaza_rt_v1_current_arena_reserved"
    if name == "arena_peak_used": return "yaza_rt_v1_current_arena_peak_used"
    if name == "arena_peak_storage_used": return "yaza_rt_v1_current_arena_peak_storage_used"
    if name == "arena_peak_reserved": return "yaza_rt_v1_current_arena_peak_reserved"
    if name == "arena_allocation_count": return "yaza_rt_v1_current_arena_allocation_count"
    if name == "arena_generation": return "yaza_rt_v1_current_arena_generation"
    if name == "arena_live_scopes": return "yaza_rt_v1_live_scope_count"
    return ""

fn core_llvm_inline_missing(expression: YirExpr) -> YirExpr:
    return YirExpr("", "", "", expression.value_type, List[YirExpr](), expression.source_line, expression.source_column, expression.source_end_column, expression.source_file)

fn core_llvm_inline_safe_expr(expression: YirExpr) -> Boolean:
    if expression.kind == "variable" or expression.kind == "number" or expression.kind == "float" or expression.kind == "boolean" or expression.kind == "text":
        return list_count(expression.children) == 0
    if expression.kind != "binary" and expression.kind != "unary" and expression.kind != "field" and expression.kind != "list_get" and expression.kind != "index": return false
    var index: Number = 0
    while index < list_count(expression.children):
        if not core_llvm_inline_safe_expr(list_get(expression.children, index)): return false
        set index = index + 1
    return true

fn core_llvm_inline_safe_argument(expression: YirExpr) -> Boolean:
    if expression.kind == "list_get" or expression.kind == "index" or expression.kind == "call": return false
    return core_llvm_inline_safe_expr(expression)

fn core_llvm_inline_safe_effect(expression: YirExpr) -> Boolean:
    if expression.kind != "list_set" or list_count(expression.children) != 3: return false
    var index: Number = 0
    while index < list_count(expression.children):
        if not core_llvm_inline_safe_expr(list_get(expression.children, index)): return false
        set index = index + 1
    return true

fn core_llvm_inline_atomic_argument(expression: YirExpr) -> Boolean:
    if expression.kind == "variable" or expression.kind == "number" or expression.kind == "float" or expression.kind == "boolean" or expression.kind == "text":
        return list_count(expression.children) == 0
    if expression.kind == "field" and list_count(expression.children) == 1:
        return core_llvm_inline_atomic_argument(list_get(expression.children, 0))
    return false

fn core_llvm_inline_slot_uses_expr(expression: YirExpr, sought: Text) -> Number:
    var count: Number = 0
    if expression.kind == "variable" and expression.value == sought: set count = 1
    var index: Number = 0
    while index < list_count(expression.children):
        set count = count + core_llvm_inline_slot_uses_expr(list_get(expression.children, index), sought)
        set index = index + 1
    return count

fn core_llvm_inline_slot_uses(function_body: List[YirStatement], sought: Text) -> Number:
    var count: Number = 0
    var index: Number = 0
    while index < list_count(function_body):
        let statement: YirStatement = list_get(function_body, index)
        set count = count + core_llvm_inline_slot_uses_expr(statement.expression, sought)
        set count = count + core_llvm_inline_slot_uses_expr(statement.expression2, sought)
        set index = index + 1
    return count

fn core_llvm_inline_pure_function(function: YirFunction) -> Boolean:
    if list_count(function.body) == 0: return false
    let last_index: Number = list_count(function.body) - 1
    let final_statement: YirStatement = list_get(function.body, last_index)
    if final_statement.kind != "return" or not core_llvm_inline_safe_expr(final_statement.expression): return false
    var index: Number = 0
    while index < last_index:
        let statement: YirStatement = list_get(function.body, index)
        if statement.kind != "let" or not core_llvm_inline_safe_expr(statement.expression): return false
        set index = index + 1
    return true

fn core_llvm_inline_substitute_expr(expression: YirExpr, slots: TextList, replacements: List[YirExpr]) -> YirExpr:
    if expression.kind == "variable":
        var index: Number = 0
        while index < list_count(slots):
            if list_get(slots, index) == expression.value: return list_get(replacements, index)
            set index = index + 1
    let children: List[YirExpr] = List[YirExpr]()
    var child_index: Number = 0
    while child_index < list_count(expression.children):
        list_push(children, core_llvm_inline_substitute_expr(list_get(expression.children, child_index), slots, replacements))
        set child_index = child_index + 1
    return YirExpr(expression.kind, expression.value, expression.value2, expression.value_type, children, expression.source_line, expression.source_column, expression.source_end_column, expression.source_file)

fn core_llvm_inline_accessor(expression: YirExpr, functions: List[YirFunction]) -> YirExpr:
    if expression.kind != "call" or list_count(expression.children) == 0: return core_llvm_inline_missing(expression)
    var function_index: Number = 0
    while function_index < list_count(functions) and list_get(functions, function_index).name != expression.value:
        set function_index = function_index + 1
    if function_index >= list_count(functions): return core_llvm_inline_missing(expression)
    let function: YirFunction = list_get(functions, function_index)
    if function.return_type == "Unit" or list_count(function.parameters) != list_count(expression.children) or list_count(function.body) == 0: return core_llvm_inline_missing(expression)
    let repeat_safe: Boolean = core_llvm_inline_pure_function(function)
    var index: Number = 0
    while index < list_count(expression.children):
        let argument: YirExpr = list_get(expression.children, index)
        if not core_llvm_inline_safe_argument(argument): return core_llvm_inline_missing(expression)
        let parameter: YirParameter = list_get(function.parameters, index)
        if core_llvm_inline_slot_uses(function.body, parameter.slot) != 1 and not core_llvm_inline_atomic_argument(argument) and not repeat_safe:
            return core_llvm_inline_missing(expression)
        set index = index + 1
    let last_index: Number = list_count(function.body) - 1
    let final_statement: YirStatement = list_get(function.body, last_index)
    if final_statement.kind != "return" or (not core_llvm_inline_safe_expr(final_statement.expression) and not core_llvm_inline_safe_effect(final_statement.expression)):
        return core_llvm_inline_missing(expression)
    set index = 0
    while index < last_index:
        let statement: YirStatement = list_get(function.body, index)
        if statement.kind == "let":
            if not core_llvm_inline_safe_expr(statement.expression) or core_llvm_inline_slot_uses(function.body, statement.slot) != 1:
                return core_llvm_inline_missing(expression)
        elif statement.kind == "expression":
            if not core_llvm_inline_safe_effect(statement.expression): return core_llvm_inline_missing(expression)
        else:
            return core_llvm_inline_missing(expression)
        set index = index + 1
    let slots: TextList = text_list()
    let replacements: List[YirExpr] = List[YirExpr]()
    set index = 0
    while index < list_count(function.parameters):
        list_push(slots, list_get(function.parameters, index).slot)
        list_push(replacements, list_get(expression.children, index))
        set index = index + 1
    set index = 0
    let effects: List[YirExpr] = List[YirExpr]()
    while index < last_index:
        let statement: YirStatement = list_get(function.body, index)
        let replacement: YirExpr = core_llvm_inline_substitute_expr(statement.expression, slots, replacements)
        if statement.kind == "let":
            list_push(slots, statement.slot)
            list_push(replacements, replacement)
        else:
            list_push(effects, replacement)
        set index = index + 1
    let result: YirExpr = core_llvm_inline_substitute_expr(final_statement.expression, slots, replacements)
    if list_count(effects) == 0: return result
    let sequence: List[YirExpr] = List[YirExpr]()
    var effect_index: Number = 0
    while effect_index < list_count(effects):
        list_push(sequence, list_get(effects, effect_index))
        set effect_index = effect_index + 1
    list_push(sequence, result)
    return YirExpr("sequence", "", "", result.value_type, sequence, result.source_line, result.source_column, result.source_end_column, result.source_file)

fn core_llvm_read_view_root(collection: YirExpr) -> Text:
    if collection.kind == "variable": return collection.value
    if (collection.kind == "list_get" or collection.kind == "index") and list_count(collection.children) > 0:
        return core_llvm_read_view_root(list_get(collection.children, 0))
    return ""

fn core_llvm_read_view_key(collection: YirExpr) -> Text:
    if collection.kind == "variable": return collection.value
    let root: Text = core_llvm_read_view_root(collection)
    if root != "": return "expr:" + collection.value_type + ":" + root
    return "expr:" + collection.source_file + ":" + number_text(collection.source_line) + ":" + number_text(collection.source_column) + ":" + number_text(collection.source_end_column) + ":" + core_yir_render_expr(collection)

fn core_llvm_add_read_view_candidate(collection: YirExpr, candidates: List[YirExpr]) -> Number:
    if not core_llvm_is_list_type(collection.value_type): return 0
    if collection.kind != "variable" and collection.kind != "list_get" and collection.kind != "index": return 0
    let key: Text = core_llvm_read_view_key(collection)
    var index: Number = 0
    while index < list_count(candidates):
        if core_llvm_read_view_key(list_get(candidates, index)) == key: return 0
        set index = index + 1
    list_push(candidates, collection)
    return 0

fn core_llvm_collect_read_view_expr(expression: YirExpr, candidates: List[YirExpr], functions: List[YirFunction]) -> Number:
    if expression.kind == "call":
        let inlined: YirExpr = core_llvm_inline_accessor(expression, functions)
        if inlined.kind != "":
            core_llvm_collect_read_view_expr(inlined, candidates, functions)
            return 0
    if (expression.kind == "list_get" or expression.kind == "index") and list_count(expression.children) > 0:
        core_llvm_add_read_view_candidate(list_get(expression.children, 0), candidates)
    var child_index: Number = 0
    while child_index < list_count(expression.children):
        core_llvm_collect_read_view_expr(list_get(expression.children, child_index), candidates, functions)
        set child_index = child_index + 1
    return 0

fn core_llvm_collect_read_view_block(block: List[YirStatement], candidates: List[YirExpr], functions: List[YirFunction]) -> Number:
    var index: Number = 0
    while index < list_count(block):
        let statement: YirStatement = list_get(block, index)
        core_llvm_collect_read_view_expr(statement.expression, candidates, functions)
        core_llvm_collect_read_view_expr(statement.expression2, candidates, functions)
        core_llvm_collect_read_view_block(statement.body, candidates, functions)
        core_llvm_collect_read_view_block(statement.alternate, candidates, functions)
        var branch_index: Number = 0
        while branch_index < list_count(statement.branches):
            let branch: YirBranch = list_get(statement.branches, branch_index)
            core_llvm_collect_read_view_expr(branch.condition, candidates, functions)
            core_llvm_collect_read_view_block(branch.body, candidates, functions)
            set branch_index = branch_index + 1
        var arm_index: Number = 0
        while arm_index < list_count(statement.match_arms):
            let arm: YirMatchArm = list_get(statement.match_arms, arm_index)
            core_llvm_collect_read_view_expr(arm.pattern_value, candidates, functions)
            core_llvm_collect_read_view_expr(arm.result_expression, candidates, functions)
            core_llvm_collect_read_view_block(arm.body, candidates, functions)
            set arm_index = arm_index + 1
        set index = index + 1
    return 0

# A candidate declared or rebound in the loop body cannot be borrowed before entry.
fn core_llvm_mutation_root_key(collection: YirExpr) -> Text:
    if collection.kind == "variable": return "var:" + collection.value
    let root: Text = core_llvm_read_view_root(collection)
    if root != "": return "root:" + root
    return "expr:" + collection.source_file + ":" + number_text(collection.source_line) + ":" + number_text(collection.source_column) + ":" + core_yir_render_expr(collection)

fn core_llvm_add_mutation_key(collection: YirExpr, keys: TextList) -> Number:
    let key: Text = core_llvm_mutation_root_key(collection)
    var index: Number = 0
    while index < list_count(keys):
        if list_get(keys, index) == key: return 0
        set index = index + 1
    list_push(keys, key)
    return 0

fn core_llvm_collect_mutation_keys_expr(expression: YirExpr, keys: TextList, functions: List[YirFunction]) -> Number:
    if expression.kind == "call":
        let inlined: YirExpr = core_llvm_inline_accessor(expression, functions)
        if inlined.kind != "":
            core_llvm_collect_mutation_keys_expr(inlined, keys, functions)
            return 0
    if (expression.kind == "list_set" or expression.kind == "list_try_set" or expression.kind == "list_push" or expression.kind == "list_try_push") and list_count(expression.children) > 0:
        core_llvm_add_mutation_key(list_get(expression.children, 0), keys)
    var child_index: Number = 0
    while child_index < list_count(expression.children):
        core_llvm_collect_mutation_keys_expr(list_get(expression.children, child_index), keys, functions)
        set child_index = child_index + 1
    return 0

fn core_llvm_collect_mutation_keys_block(block: List[YirStatement], keys: TextList, functions: List[YirFunction]) -> Number:
    var index: Number = 0
    while index < list_count(block):
        let statement: YirStatement = list_get(block, index)
        core_llvm_collect_mutation_keys_expr(statement.expression, keys, functions)
        core_llvm_collect_mutation_keys_expr(statement.expression2, keys, functions)
        core_llvm_collect_mutation_keys_block(statement.body, keys, functions)
        core_llvm_collect_mutation_keys_block(statement.alternate, keys, functions)
        var branch_index: Number = 0
        while branch_index < list_count(statement.branches):
            let branch: YirBranch = list_get(statement.branches, branch_index)
            core_llvm_collect_mutation_keys_expr(branch.condition, keys, functions)
            core_llvm_collect_mutation_keys_block(branch.body, keys, functions)
            set branch_index = branch_index + 1
        var arm_index: Number = 0
        while arm_index < list_count(statement.match_arms):
            let arm: YirMatchArm = list_get(statement.match_arms, arm_index)
            core_llvm_collect_mutation_keys_expr(arm.pattern_value, keys, functions)
            core_llvm_collect_mutation_keys_expr(arm.result_expression, keys, functions)
            core_llvm_collect_mutation_keys_block(arm.body, keys, functions)
            set arm_index = arm_index + 1
        set index = index + 1
    return 0

fn core_llvm_read_view_invalidated_by_loop(candidate: YirExpr, mutation_keys: TextList) -> Boolean:
    let key: Text = core_llvm_mutation_root_key(candidate)
    var index: Number = 0
    while index < list_count(mutation_keys):
        if list_get(mutation_keys, index) == key: return true
        set index = index + 1
    return false

fn core_llvm_block_assigns_slot(block: List[YirStatement], sought: Text) -> Boolean:
    var index: Number = 0
    while index < list_count(block):
        let statement: YirStatement = list_get(block, index)
        if (statement.kind == "let" or statement.kind == "var" or statement.kind == "set" or statement.kind == "for_range" or statement.kind == "for_each" or statement.kind == "match_expr") and statement.slot == sought:
            return true
        if core_llvm_block_assigns_slot(statement.body, sought) or core_llvm_block_assigns_slot(statement.alternate, sought): return true
        var branch_index: Number = 0
        while branch_index < list_count(statement.branches):
            if core_llvm_block_assigns_slot(list_get(statement.branches, branch_index).body, sought): return true
            set branch_index = branch_index + 1
        var arm_index: Number = 0
        while arm_index < list_count(statement.match_arms):
            let arm: YirMatchArm = list_get(statement.match_arms, arm_index)
            var binding_index: Number = 0
            while binding_index < list_count(arm.bindings):
                if list_get(arm.bindings, binding_index).slot == sought: return true
                set binding_index = binding_index + 1
            if core_llvm_block_assigns_slot(arm.body, sought): return true
            set arm_index = arm_index + 1
        set index = index + 1
    return false

fn core_llvm_while_read_view_candidates(statement: YirStatement, functions: List[YirFunction]) -> List[YirExpr]:
    let candidates: List[YirExpr] = List[YirExpr]()
    core_llvm_collect_read_view_expr(statement.expression, candidates, functions)
    core_llvm_collect_read_view_block(statement.body, candidates, functions)
    let mutation_keys: TextList = text_list()
    core_llvm_collect_mutation_keys_expr(statement.expression, mutation_keys, functions)
    core_llvm_collect_mutation_keys_block(statement.body, mutation_keys, functions)
    let safe_candidates: List[YirExpr] = List[YirExpr]()
    var index: Number = 0
    while index < list_count(candidates):
        let candidate: YirExpr = list_get(candidates, index)
        if (candidate.kind != "variable" or not core_llvm_block_assigns_slot(statement.body, candidate.value)) and not core_llvm_read_view_invalidated_by_loop(candidate, mutation_keys): list_push(safe_candidates, candidate)
        set index = index + 1
    return safe_candidates

fn core_llvm_add_direct_number_list(candidates: List[YirExpr], collection: YirExpr) -> Number:
    if collection.kind != "variable" or collection.value_type != "List[Number]": return 0
    var index: Number = 0
    while index < list_count(candidates):
        if list_get(candidates, index).value == collection.value: return 0
        set index = index + 1
    list_push(candidates, collection)
    return 0

fn core_llvm_collect_mut_access_expr(expression: YirExpr, reads: List[YirExpr], writes: List[YirExpr], functions: List[YirFunction]) -> Number:
    if expression.kind == "call":
        let inlined: YirExpr = core_llvm_inline_accessor(expression, functions)
        if inlined.kind != "":
            core_llvm_collect_mut_access_expr(inlined, reads, writes, functions)
            return 0
    if expression.kind == "list_get" and list_count(expression.children) > 0:
        core_llvm_add_direct_number_list(reads, list_get(expression.children, 0))
    if expression.kind == "list_set" and list_count(expression.children) > 0:
        core_llvm_add_direct_number_list(writes, list_get(expression.children, 0))
    var index: Number = 0
    while index < list_count(expression.children):
        core_llvm_collect_mut_access_expr(list_get(expression.children, index), reads, writes, functions)
        set index = index + 1
    return 0

fn core_llvm_collect_mut_access_block(block: List[YirStatement], reads: List[YirExpr], writes: List[YirExpr], functions: List[YirFunction]) -> Number:
    var index: Number = 0
    while index < list_count(block):
        let statement: YirStatement = list_get(block, index)
        core_llvm_collect_mut_access_expr(statement.expression, reads, writes, functions)
        core_llvm_collect_mut_access_expr(statement.expression2, reads, writes, functions)
        core_llvm_collect_mut_access_block(statement.body, reads, writes, functions)
        core_llvm_collect_mut_access_block(statement.alternate, reads, writes, functions)
        var branch_index: Number = 0
        while branch_index < list_count(statement.branches):
            let branch: YirBranch = list_get(statement.branches, branch_index)
            core_llvm_collect_mut_access_expr(branch.condition, reads, writes, functions)
            core_llvm_collect_mut_access_block(branch.body, reads, writes, functions)
            set branch_index = branch_index + 1
        var arm_index: Number = 0
        while arm_index < list_count(statement.match_arms):
            let arm: YirMatchArm = list_get(statement.match_arms, arm_index)
            core_llvm_collect_mut_access_expr(arm.pattern_value, reads, writes, functions)
            core_llvm_collect_mut_access_expr(arm.result_expression, reads, writes, functions)
