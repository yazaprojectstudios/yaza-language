fn core_llvm_emit_call_bytes_access_expr(expression: YirExpr, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList, functions: List[YirFunction], defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList) -> TextList:
    if expression.value == "bytes_length":
        let argument: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let length: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + length + " = extractvalue %yaza.bytes " + list_get(argument, 1) + ", 1")
        return core_llvm_value("Number", length)
    if expression.value == "bytes_crc32c" or expression.value == "bytes_ydbv1_checksum":
        let argument: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let fields: TextList = core_llvm_bytes_fields(list_get(argument, 1), lines, temp_serial)
        let result: Text = core_llvm_temp(temp_serial)
        var checksum_symbol: Text = "@yaza_bytes_v1_crc32c"
        if expression.value == "bytes_ydbv1_checksum": set checksum_symbol = "@yaza_bytes_v1_ydbv1_checksum"
        list_push(lines, "  " + result + " = call i64 " + checksum_symbol + "(ptr " + list_get(fields, 0) + ", i64 " + list_get(fields, 1) + ")")
        return core_llvm_value("Number", result)
    if expression.value == "bytes_crc32c_zeroed_range" or expression.value == "bytes_ydbv1_checksum_zeroed_range":
        let argument: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let zero_offset: TextList = core_llvm_emit_expr(list_get(expression.children, 1), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let zero_length: TextList = core_llvm_emit_expr(list_get(expression.children, 2), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let fields: TextList = core_llvm_bytes_fields(list_get(argument, 1), lines, temp_serial)
        let result: Text = core_llvm_temp(temp_serial)
        var checksum_symbol: Text = "@yaza_bytes_v1_crc32c_zeroed_range"
        if expression.value == "bytes_ydbv1_checksum_zeroed_range": set checksum_symbol = "@yaza_bytes_v1_ydbv1_checksum_zeroed_range"
        list_push(lines, "  " + result + " = call i64 " + checksum_symbol + "(ptr " + list_get(fields, 0) + ", i64 " + list_get(fields, 1) + ", i64 " + list_get(zero_offset, 1) + ", i64 " + list_get(zero_length, 1) + ")")
        return core_llvm_value("Number", result)
    if expression.value == "bytes_get":
        let argument: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let index: TextList = core_llvm_emit_expr(list_get(expression.children, 1), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let fields: TextList = core_llvm_bytes_fields(list_get(argument, 1), lines, temp_serial)
        let negative: Text = core_llvm_temp(temp_serial)
        let out_of_range: Text = core_llvm_temp(temp_serial)
        let invalid: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + negative + " = icmp slt i64 " + list_get(index, 1) + ", 0")
        list_push(lines, "  " + out_of_range + " = icmp uge i64 " + list_get(index, 1) + ", " + list_get(fields, 1))
        list_push(lines, "  " + invalid + " = or i1 " + negative + ", " + out_of_range)
        core_llvm_emit_trap_if(lines, current, terminated, label_serial, label_serial, strings, invalid, "Bytes index is out of range")
        let address: Text = core_llvm_temp(temp_serial)
        let byte: Text = core_llvm_temp(temp_serial)
        let number: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + address + " = getelementptr inbounds i8, ptr " + list_get(fields, 0) + ", i64 " + list_get(index, 1))
        list_push(lines, "  " + byte + " = load i8, ptr " + address)
        list_push(lines, "  " + number + " = zext i8 " + byte + " to i64")
        return core_llvm_value("Number", number)
    if expression.value == "bytes_slice":
        let argument: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let start: TextList = core_llvm_emit_expr(list_get(expression.children, 1), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let length: TextList = core_llvm_emit_expr(list_get(expression.children, 2), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let fields: TextList = core_llvm_bytes_fields(list_get(argument, 1), lines, temp_serial)
        let scratch: Text = core_llvm_scratch_name("Bytes")
        list_push(lines, "  call void @yaza_bytes_v1_slice(ptr " + list_get(fields, 0) + ", i64 " + list_get(fields, 1) + ", i64 " + list_get(start, 1) + ", i64 " + list_get(length, 1) + ", ptr " + scratch + ")")
        let value: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + value + " = load %yaza.bytes, ptr " + scratch)
        return core_llvm_value("Bytes", value)
    if expression.value == "bytes_concat":
        let left: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let right: TextList = core_llvm_emit_expr(list_get(expression.children, 1), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let left_fields: TextList = core_llvm_bytes_fields(list_get(left, 1), lines, temp_serial)
        let right_fields: TextList = core_llvm_bytes_fields(list_get(right, 1), lines, temp_serial)
        let scratch: Text = core_llvm_scratch_name("Bytes")
        list_push(lines, "  call void @yaza_bytes_v1_concat(ptr " + list_get(left_fields, 0) + ", i64 " + list_get(left_fields, 1) + ", ptr " + list_get(right_fields, 0) + ", i64 " + list_get(right_fields, 1) + ", ptr " + scratch + ")")
        let value: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + value + " = load %yaza.bytes, ptr " + scratch)
        return core_llvm_value("Bytes", value)
    if expression.value == "bytes_equal" or expression.value == "bytes_equal_constant_time":
        let left: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let right: TextList = core_llvm_emit_expr(list_get(expression.children, 1), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let left_fields: TextList = core_llvm_bytes_fields(list_get(left, 1), lines, temp_serial)
        let right_fields: TextList = core_llvm_bytes_fields(list_get(right, 1), lines, temp_serial)
        var helper: Text = "@yaza_bytes_v1_equal"
        if expression.value == "bytes_equal_constant_time": set helper = "@yaza_bytes_v1_equal_constant_time"
        let compared: Text = core_llvm_temp(temp_serial)
        let result: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + compared + " = call i32 " + helper + "(ptr " + list_get(left_fields, 0) + ", i64 " + list_get(left_fields, 1) + ", ptr " + list_get(right_fields, 0) + ", i64 " + list_get(right_fields, 1) + ")")
        list_push(lines, "  " + result + " = icmp ne i32 " + compared + ", 0")
        return core_llvm_value("Boolean", result)
    if expression.value == "bytes_to_text_checked":
        let argument: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let fields: TextList = core_llvm_bytes_fields(list_get(argument, 1), lines, temp_serial)
        let scratch: Text = core_llvm_scratch_name("Text")
        let converted: Text = core_llvm_temp(temp_serial)
        let has_text: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + converted + " = call i32 @yaza_bytes_v1_to_text_checked(ptr " + list_get(fields, 0) + ", i64 " + list_get(fields, 1) + ", ptr " + scratch + ")")
        list_push(lines, "  " + has_text + " = icmp ne i32 " + converted + ", 0")
        let some_label: Text = core_llvm_label(label_serial, "bytes.text.some.")
        let none_label: Text = core_llvm_label(label_serial, "bytes.text.none.")
        let merge_label: Text = core_llvm_label(label_serial, "bytes.text.end.")
        list_push(lines, "  br i1 " + has_text + ", label %" + some_label + ", label %" + none_label)
        list_set(terminated, 0, "true")
        core_llvm_emit_label(lines, current, terminated, some_label)
        let text_value: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + text_value + " = load ptr, ptr " + scratch)
        let some_value: Text = core_llvm_sum_construct("%yaza.option", "1", "Text", text_value, lines, temp_serial)
        let some_predecessor: Text = list_get(current, 0)
        list_push(lines, "  br label %" + merge_label)
        core_llvm_emit_label(lines, current, terminated, none_label)
        let none_value: Text = "zeroinitializer"
        let none_predecessor: Text = list_get(current, 0)
        list_push(lines, "  br label %" + merge_label)
        core_llvm_emit_label(lines, current, terminated, merge_label)
        let result: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + result + " = phi %yaza.option [ " + some_value + ", %" + some_predecessor + " ], [ " + none_value + ", %" + none_predecessor + " ]")
        return core_llvm_value("Option[Text]", result)
    if expression.value == "bytes_try_to_text":
        let argument: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let fields: TextList = core_llvm_bytes_fields(list_get(argument, 1), lines, temp_serial)
        let text_scratch: Text = core_llvm_temp(temp_serial)
        let error_scratch: Text = core_llvm_temp(temp_serial)
        let converted: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + text_scratch + " = alloca ptr, align 8")
        list_push(lines, "  " + error_scratch + " = alloca ptr, align 8")
        list_push(lines, "  " + converted + " = call i32 @yaza_bytes_v1_try_to_text(ptr " + list_get(fields, 0) + ", i64 " + list_get(fields, 1) + ", ptr " + text_scratch + ", ptr " + error_scratch + ")")
        let result: Text = core_llvm_emit_text_status_result(converted, text_scratch, error_scratch, lines, temp_serial, label_serial, current, terminated)
        return core_llvm_value("Result[Text,Text]", result)
    if expression.value == "bytes_to_text":
        let argument: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let fields: TextList = core_llvm_bytes_fields(list_get(argument, 1), lines, temp_serial)
        let result: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + result + " = call ptr @yaza_bytes_v1_to_text(ptr " + list_get(fields, 0) + ", i64 " + list_get(fields, 1) + ")")
        return core_llvm_value("Text", result)
    if expression.value == "bytes_zeroize":
        let argument: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let fields: TextList = core_llvm_bytes_fields(list_get(argument, 1), lines, temp_serial)
        let result: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + result + " = call i64 @yaza_bytes_v1_zeroize(ptr " + list_get(fields, 0) + ", i64 " + list_get(fields, 1) + ")")
        return core_llvm_value("Number", result)
    return text_list()

fn core_llvm_emit_call_text_ops_expr(expression: YirExpr, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList, functions: List[YirFunction], defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList) -> TextList:
    if expression.value == "text_length":
        let argument: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let result: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + result + " = call i64 @yaza_rt_v1_text_length(ptr " + list_get(argument, 1) + ")")
        return core_llvm_value("Number", result)
    if expression.value == "text_lines":
        let argument: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let result: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + result + " = call ptr @yaza_rt_v1_text_lines(ptr " + list_get(argument, 1) + ")")
        return core_llvm_value("TextList", result)
    if expression.value == "text_try_lines":
        let argument: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let list_scratch: Text = core_llvm_scratch_name("TextList")
        let status: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + status + " = call i32 @yaza_rt_v1_try_text_lines(ptr " + list_get(argument, 1) + ", ptr " + list_scratch + ")")
        let result: Text = core_llvm_emit_text_list_status_result(status, list_scratch, lines, temp_serial, label_serial, current, terminated)
        return core_llvm_value("Result[TextList,Text]", result)
    if expression.value == "text_trim":
        let argument: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let result: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + result + " = call ptr @yaza_rt_v1_text_trim(ptr " + list_get(argument, 1) + ")")
        return core_llvm_value("Text", result)
    if expression.value == "text_join":
        let collection: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let separator: TextList = core_llvm_emit_expr(list_get(expression.children, 1), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let result: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + result + " = call ptr @yaza_rt_v1_text_join(ptr " + list_get(collection, 1) + ", ptr " + list_get(separator, 1) + ")")
        return core_llvm_value("Text", result)
    if expression.value == "text_compare":
        let left: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let right: TextList = core_llvm_emit_expr(list_get(expression.children, 1), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let result: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + result + " = call i64 @yaza_rt_v1_text_compare(ptr " + list_get(left, 1) + ", ptr " + list_get(right, 1) + ")")
        return core_llvm_value("Number", result)
    if expression.value == "text_byte":
        let text: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let index: TextList = core_llvm_emit_expr(list_get(expression.children, 1), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let result: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + result + " = call i64 @yaza_rt_v1_text_byte(ptr " + list_get(text, 1) + ", i64 " + list_get(index, 1) + ")")
        return core_llvm_value("Number", result)
    if expression.value == "text_slice":
        let text: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let start: TextList = core_llvm_emit_expr(list_get(expression.children, 1), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let length: TextList = core_llvm_emit_expr(list_get(expression.children, 2), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let result: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + result + " = call ptr @yaza_rt_v1_text_slice(ptr " + list_get(text, 1) + ", i64 " + list_get(start, 1) + ", i64 " + list_get(length, 1) + ")")
        return core_llvm_value("Text", result)
    if expression.value == "text_find":
        let text: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let needle: TextList = core_llvm_emit_expr(list_get(expression.children, 1), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let result: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + result + " = call i64 @yaza_rt_v1_text_find(ptr " + list_get(text, 1) + ", ptr " + list_get(needle, 1) + ")")
        return core_llvm_value("Number", result)
    if expression.value == "text_starts_with" or expression.value == "text_ends_with":
        let text: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let affix: TextList = core_llvm_emit_expr(list_get(expression.children, 1), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        var function_name: Text = "@yaza_rt_v1_text_starts_with"
        if expression.value == "text_ends_with": set function_name = "@yaza_rt_v1_text_ends_with"
        let status: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + status + " = call i32 " + function_name + "(ptr " + list_get(text, 1) + ", ptr " + list_get(affix, 1) + ")")
        let result: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + result + " = icmp ne i32 " + status + ", 0")
        return core_llvm_value("Boolean", result)
    return text_list()

fn core_llvm_emit_call_number_expr(expression: YirExpr, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList, functions: List[YirFunction], defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList) -> TextList:
    if expression.value == "number_parse":
        let argument: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let result: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + result + " = call i64 @yaza_rt_v1_number_parse(ptr " + list_get(argument, 1) + ")")
        return core_llvm_value("Number", result)
    if expression.value == "number_try_parse" or expression.value == "int32_try_parse" or expression.value == "float64_try_parse":
        let argument: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        var helper: Text = "@yaza_rt_v1_try_number_parse"
        var payload_type: Text = "Number"
        var error_message: Text = "invalid or out-of-range Number text"
        if expression.value == "int32_try_parse":
            set helper = "@yaza_rt_v1_try_int32_parse"
            set payload_type = "Int32"
            set error_message = "invalid or out-of-range Int32 text"
        if expression.value == "float64_try_parse":
            set helper = "@yaza_rt_v1_try_float64_parse"
            set payload_type = "Float64"
            set error_message = "invalid or out-of-range Float64 text"
        return core_llvm_emit_try_numeric_parse(helper, payload_type, error_message, list_get(argument, 1), lines, temp_serial, label_serial, strings, current, terminated)
    if expression.value == "fail":
        let argument: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let result: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + result + " = call i64 @yaza_rt_v1_fail_text(ptr " + list_get(argument, 1) + ")")
        return core_llvm_value("Number", result)
    if expression.value == "exit":
        let argument: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let result: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + result + " = call i64 @yaza_rt_v1_exit(i64 " + list_get(argument, 1) + ")")
        return core_llvm_value("Number", result)
    if expression.value == "float64_parse":
        let argument: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let result: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + result + " = call double @yaza_rt_v1_float64_parse(ptr " + list_get(argument, 1) + ")")
        return core_llvm_value("Float64", result)
    if expression.value == "int32_from_number":
        let argument: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let low: Text = core_llvm_temp(temp_serial)
        let high: Text = core_llvm_temp(temp_serial)
        let invalid: Text = core_llvm_temp(temp_serial)
        let result: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + low + " = icmp slt i64 " + list_get(argument, 1) + ", -2147483648")
        list_push(lines, "  " + high + " = icmp sgt i64 " + list_get(argument, 1) + ", 2147483647")
        list_push(lines, "  " + invalid + " = or i1 " + low + ", " + high)
        core_llvm_emit_trap_if(lines, current, terminated, label_serial, label_serial, strings, invalid, "Number to Int32 conversion is out of range")
        list_push(lines, "  " + result + " = trunc i64 " + list_get(argument, 1) + " to i32")
        return core_llvm_value("Int32", result)
    if expression.value == "number_from_int32":
        let argument: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let result: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + result + " = sext i32 " + list_get(argument, 1) + " to i64")
        return core_llvm_value("Number", result)
    if expression.value == "float64_from_number":
        let argument: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let low: Text = core_llvm_temp(temp_serial)
        let high: Text = core_llvm_temp(temp_serial)
        let invalid: Text = core_llvm_temp(temp_serial)
        let result: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + low + " = icmp slt i64 " + list_get(argument, 1) + ", -9007199254740992")
        list_push(lines, "  " + high + " = icmp sgt i64 " + list_get(argument, 1) + ", 9007199254740992")
        list_push(lines, "  " + invalid + " = or i1 " + low + ", " + high)
        core_llvm_emit_trap_if(lines, current, terminated, label_serial, label_serial, strings, invalid, "invalid Float64 value or arithmetic error in Number to Float64 conversion would lose precision")
        list_push(lines, "  " + result + " = sitofp i64 " + list_get(argument, 1) + " to double")
        return core_llvm_value("Float64", result)
    if expression.value == "number_from_float64":
        let argument: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let non_finite: Text = core_llvm_temp(temp_serial)
        let below: Text = core_llvm_temp(temp_serial)
        let above: Text = core_llvm_temp(temp_serial)
        let out_of_range: Text = core_llvm_temp(temp_serial)
        let invalid: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + non_finite + " = call i1 @llvm.is.fpclass.f64(double " + list_get(argument, 1) + ", i32 519)")
        list_push(lines, "  " + below + " = fcmp olt double " + list_get(argument, 1) + ", -9.2233720368547758e+18")
        list_push(lines, "  " + above + " = fcmp oge double " + list_get(argument, 1) + ", 9.2233720368547758e+18")
        list_push(lines, "  " + out_of_range + " = or i1 " + below + ", " + above)
        list_push(lines, "  " + invalid + " = or i1 " + non_finite + ", " + out_of_range)
        core_llvm_emit_trap_if(lines, current, terminated, label_serial, label_serial, strings, invalid, "Number overflow or division error in Float64 to Number conversion range")
        let result: Text = core_llvm_temp(temp_serial)
        let restored: Text = core_llvm_temp(temp_serial)
        let fractional: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + result + " = fptosi double " + list_get(argument, 1) + " to i64")
        list_push(lines, "  " + restored + " = sitofp i64 " + result + " to double")
        list_push(lines, "  " + fractional + " = fcmp one double " + restored + ", " + list_get(argument, 1))
        core_llvm_emit_trap_if(lines, current, terminated, label_serial, label_serial, strings, fractional, "Number overflow or division error in Float64 to Number conversion precision")
        return core_llvm_value("Number", result)
    if expression.value == "float64_bits":
        let argument: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let result: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + result + " = bitcast double " + list_get(argument, 1) + " to i64")
        return core_llvm_value("Number", result)
    if expression.value == "float64_from_bits":
        let argument: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let result: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + result + " = bitcast i64 " + list_get(argument, 1) + " to double")
        return core_llvm_value("Float64", result)
    if expression.value == "number_try_text" or expression.value == "int32_try_text" or expression.value == "float64_try_text":
        let argument: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        var helper: Text = "@yaza_rt_v1_try_number_text"
        if expression.value == "int32_try_text": set helper = "@yaza_rt_v1_try_int32_text"
        if expression.value == "float64_try_text": set helper = "@yaza_rt_v1_try_float64_text"
        let text: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + text + " = call ptr " + helper + "(" + core_llvm_type(list_get(argument, 0)) + " " + list_get(argument, 1) + ")")
        let result: Text = core_llvm_emit_text_pointer_result(text, lines, temp_serial, label_serial, current, terminated)
        return core_llvm_value("Result[Text,Text]", result)
    if expression.value == "number_text" or expression.value == "int32_text" or expression.value == "float64_text":
        let argument: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        var helper: Text = "@yaza_rt_v1_number_text"
        if expression.value == "int32_text": set helper = "@yaza_rt_v1_int32_text"
        if expression.value == "float64_text": set helper = "@yaza_rt_v1_float64_text"
        let result: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + result + " = call ptr " + helper + "(" + core_llvm_type(list_get(argument, 0)) + " " + list_get(argument, 1) + ")")
        return core_llvm_value("Text", result)
    return text_list()

fn core_llvm_emit_call_generic_expr(expression: YirExpr, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList, functions: List[YirFunction], defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList) -> TextList:
    let inlined_accessor: YirExpr = core_llvm_inline_accessor(expression, functions)
    if inlined_accessor.kind != "":
        return core_llvm_emit_expr(inlined_accessor, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    var arguments: Text = ""
    var index: Number = 0
    while index < list_count(expression.children):
        let argument: TextList = core_llvm_emit_expr(list_get(expression.children, index), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        if index > 0: set arguments = arguments + ", "
        set arguments = arguments + core_llvm_type(list_get(argument, 0)) + " " + list_get(argument, 1)
        set index = index + 1
    var callee_index: Number = 0
    while callee_index < list_count(functions) and list_get(functions, callee_index).name != expression.value:
        set callee_index = callee_index + 1
    if callee_index < list_count(functions):
        let callee: YirFunction = list_get(functions, callee_index)
        let callee_read_views: List[YirExpr] = core_llvm_function_read_view_candidates(callee, functions)
        var read_index: Number = 0
        while read_index < list_count(callee_read_views):
            let candidate: YirExpr = list_get(callee_read_views, read_index)
            var parameter_index: Number = 0
            while parameter_index < list_count(callee.parameters) and list_get(callee.parameters, parameter_index).slot != candidate.value:
                set parameter_index = parameter_index + 1
            var shared_view: Text = ""
            if parameter_index < list_count(expression.children):
                set shared_view = core_llvm_find_active_read_view(list_get(expression.children, parameter_index), defer_records, defer_stack, defer_depth)
            if shared_view == "": set shared_view = "null"
            if arguments != "": set arguments = arguments + ", "
            set arguments = arguments + "ptr " + shared_view
            set read_index = read_index + 1
    let result_type: Text = core_llvm_type(expression.value_type)
    if result_type == "void":
        list_push(lines, "  call void @yaza.core.fn." + expression.value + "(" + arguments + ")")
        return core_llvm_value("Unit", "")
    let result_name: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + result_name + " = call " + result_type + " @yaza.core.fn." + expression.value + "(" + arguments + ")")
    return core_llvm_value(expression.value_type, result_name)

fn core_llvm_emit_call_expr(expression: YirExpr, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList, functions: List[YirFunction], defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList) -> TextList:
    let arena_metric: Text = core_llvm_arena_metric_symbol(expression.value)
    if arena_metric != "":
        let result: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + result + " = call i64 @" + arena_metric + "()")
        return core_llvm_value("Number", result)
    let view_result: TextList = core_llvm_emit_call_view_expr(expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    if list_count(view_result) > 0: return view_result
    let fs_result: TextList = core_llvm_emit_call_fs_expr(expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    if list_count(fs_result) > 0: return fs_result
    let text_result: TextList = core_llvm_emit_call_text_expr(expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    if list_count(text_result) > 0: return text_result
    let bytes_build_result: TextList = core_llvm_emit_call_bytes_build_expr(expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    if list_count(bytes_build_result) > 0: return bytes_build_result
    let bytes_access_result: TextList = core_llvm_emit_call_bytes_access_expr(expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    if list_count(bytes_access_result) > 0: return bytes_access_result
    let text_ops_result: TextList = core_llvm_emit_call_text_ops_expr(expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    if list_count(text_ops_result) > 0: return text_ops_result
    let number_result: TextList = core_llvm_emit_call_number_expr(expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    if list_count(number_result) > 0: return number_result
    return core_llvm_emit_call_generic_expr(expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)

fn core_llvm_text_hash(value: Text) -> Number:
    var hash: Number = 5381
    var index: Number = 0
    while index < text_length(value):
        set hash = ((hash * 33) + text_byte(value, index)) % 2147483647
        set index = index + 1
    return hash

fn core_llvm_spawn_id(expression: YirExpr) -> Text:
    return number_text(expression.source_line) + "_" + number_text(expression.source_column) + "_" + number_text(expression.source_end_column) + "_" + number_text(core_llvm_text_hash(expression.source_file))

fn core_llvm_type_has_pointers(value_type: Text) -> Text:
    if value_type == "Number" or value_type == "Int32" or value_type == "Float64" or value_type == "Boolean" or value_type == "Unit":
        return "0"
    return "1"

fn core_llvm_collect_expr_variables(expression: YirExpr, slots: TextList, types: TextList) -> Number:
    if expression.kind == "variable":
        var existing: Number = 0
        while existing < list_count(slots):
            if list_get(slots, existing) == expression.value: return 0
            set existing = existing + 1
        list_push(slots, expression.value)
        list_push(types, expression.value_type)
        return 0
    var child_index: Number = 0
    while child_index < list_count(expression.children):
        core_llvm_collect_expr_variables(list_get(expression.children, child_index), slots, types)
        set child_index = child_index + 1
    return 0

fn core_llvm_emit_expr(expression: YirExpr, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList, functions: List[YirFunction], defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList) -> TextList:
    if expression.kind == "sequence":
        var sequence_index: Number = 0
        while sequence_index + 1 < list_count(expression.children):
            core_llvm_emit_expr(list_get(expression.children, sequence_index), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
            set sequence_index = sequence_index + 1
        if list_count(expression.children) == 0: return core_llvm_value(expression.value_type, "")
        return core_llvm_emit_expr(list_get(expression.children, list_count(expression.children) - 1), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    if expression.kind == "move":
        return core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    if expression.kind == "await":
        let task_val: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        if expression.value_type == "Unit":
            list_push(lines, "  call void @yaza_rt_v1_task_await(ptr " + list_get(task_val, 1) + ", ptr null, i64 0)")
            return core_llvm_value("Unit", "")
        let scratch: Text = core_llvm_scratch_name(expression.value_type)
        let res_size: Text = core_llvm_size_of(expression.value_type, lines, temp_serial)
        list_push(lines, "  call void @yaza_rt_v1_task_await(ptr " + list_get(task_val, 1) + ", ptr " + scratch + ", i64 " + res_size + ")")
        let loaded: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + loaded + " = load " + core_llvm_type(expression.value_type) + ", ptr " + scratch)
        return core_llvm_value(expression.value_type, loaded)
    if expression.kind == "spawn":
        let spawn_id: Text = core_llvm_spawn_id(expression)
        let child: YirExpr = list_get(expression.children, 0)
        let result_type: Text = child.value_type
        let ctx_type_name: Text = "%__yaza.spawn.ctx." + spawn_id
        var ctx_pointer: Text = "null"
        if child.kind == "call":
            let argc: Number = list_count(child.children)
            if argc > 0:
                let arg_values: TextList = text_list()
                let arg_llvm_types: TextList = text_list()
                var arg_index: Number = 0
                while arg_index < argc:
                    let arg_node: YirExpr = list_get(child.children, arg_index)
                    let emitted_arg: TextList = core_llvm_emit_expr(arg_node, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
                    list_push(arg_values, list_get(emitted_arg, 1))
                    list_push(arg_llvm_types, core_llvm_type(list_get(emitted_arg, 0)))
                    set arg_index = arg_index + 1
                let size_ptr: Text = core_llvm_temp(temp_serial)
                let ctx_size: Text = core_llvm_temp(temp_serial)
                list_push(lines, "  " + size_ptr + " = getelementptr " + ctx_type_name + ", ptr null, i64 1")
                list_push(lines, "  " + ctx_size + " = ptrtoint ptr " + size_ptr + " to i64")
                set ctx_pointer = core_llvm_temp(temp_serial)
                list_push(lines, "  " + ctx_pointer + " = call ptr @yaza_rt_v1_task_ctx_alloc(i64 " + ctx_size + ")")
                set arg_index = 0
                while arg_index < argc:
                    let field_ptr: Text = core_llvm_temp(temp_serial)
                    list_push(lines, "  " + field_ptr + " = getelementptr inbounds " + ctx_type_name + ", ptr " + ctx_pointer + ", i32 0, i32 " + number_text(arg_index))
                    list_push(lines, "  store " + list_get(arg_llvm_types, arg_index) + " " + list_get(arg_values, arg_index) + ", ptr " + field_ptr)
                    set arg_index = arg_index + 1
        else:
            let var_slots: TextList = text_list()
            let var_types: TextList = text_list()
            core_llvm_collect_expr_variables(child, var_slots, var_types)
            let var_count: Number = list_count(var_slots)
            if var_count > 0:
                let var_values: TextList = text_list()
                var var_index: Number = 0
                while var_index < var_count:
                    let slot_name: Text = list_get(var_slots, var_index)
                    let slot_type: Text = list_get(var_types, var_index)
                    if text_starts_with(slot_name, "%arg"):
                        list_push(var_values, slot_name)
                    else:
                        let loaded_var: Text = core_llvm_temp(temp_serial)
                        list_push(lines, "  " + loaded_var + " = load " + core_llvm_type(slot_type) + ", ptr " + slot_name)
                        list_push(var_values, loaded_var)
                    set var_index = var_index + 1
                let size_ptr: Text = core_llvm_temp(temp_serial)
                let ctx_size: Text = core_llvm_temp(temp_serial)
                list_push(lines, "  " + size_ptr + " = getelementptr " + ctx_type_name + ", ptr null, i64 1")
                list_push(lines, "  " + ctx_size + " = ptrtoint ptr " + size_ptr + " to i64")
                set ctx_pointer = core_llvm_temp(temp_serial)
                list_push(lines, "  " + ctx_pointer + " = call ptr @yaza_rt_v1_task_ctx_alloc(i64 " + ctx_size + ")")
                set var_index = 0
                while var_index < var_count:
                    let field_ptr: Text = core_llvm_temp(temp_serial)
                    list_push(lines, "  " + field_ptr + " = getelementptr inbounds " + ctx_type_name + ", ptr " + ctx_pointer + ", i32 0, i32 " + number_text(var_index))
                    list_push(lines, "  store " + core_llvm_type(list_get(var_types, var_index)) + " " + list_get(var_values, var_index) + ", ptr " + field_ptr)
                    set var_index = var_index + 1
        var res_size: Text = "0"
        if result_type != "Unit":
            set res_size = core_llvm_size_of(result_type, lines, temp_serial)
        let has_pointers: Text = core_llvm_type_has_pointers(result_type)
        let task_handle: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + task_handle + " = call ptr @yaza_rt_v1_task_spawn(ptr @__yaza_spawn_thunk_" + spawn_id + ", ptr " + ctx_pointer + ", i64 " + res_size + ", i32 " + has_pointers + ")")
        return core_llvm_value(expression.value_type, task_handle)
    if expression.kind == "borrow" or expression.kind == "borrow_mut":
        let child: YirExpr = list_get(expression.children, 0)
        if child.kind == "variable":
            if text_starts_with(child.value, "%arg"):
                if core_yir_is_borrow_type(child.value_type) or core_yir_is_mut_borrow_type(child.value_type):
                    return core_llvm_value(expression.value_type, child.value)
            else:
                return core_llvm_value(expression.value_type, child.value)
        return core_llvm_emit_expr(child, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    if expression.kind == "try": return core_llvm_emit_try_expr(expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    if expression.kind == "fallible_sum": return core_llvm_emit_fallible_sum_expr(expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    if expression.kind == "fallible_variant": return core_llvm_emit_fallible_variant_expr(expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    if expression.kind == "fallible_interpolate": return core_llvm_emit_fallible_interpolate_expr(expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    if expression.kind == "fallible_list_try_get": return core_llvm_emit_fallible_list_try_get_expr(expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    if expression.kind == "list_try_literal": return core_llvm_emit_fallible_list_literal_expr(expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    if expression.kind == "number": return core_llvm_value("Number", expression.value)
    if expression.kind == "float": return core_llvm_value("Float64", core_llvm_float_literal(expression.value))
    if expression.kind == "boolean":
        if expression.value == "true": return core_llvm_value("Boolean", "1")
        return core_llvm_value("Boolean", "0")
    if expression.kind == "text": return core_llvm_value("Text", core_llvm_pointer_to_string(expression.value, strings))
    if expression.kind == "option_none":
        return core_llvm_value(expression.value_type, "zeroinitializer")
    if expression.kind == "option_some" or expression.kind == "result_ok" or expression.kind == "result_err":
        let payload: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let descriptor_type: Text = core_llvm_type(expression.value_type)
        var tag: Text = "1"
        if expression.kind == "result_err": set tag = "0"
        let sum_value: Text = core_llvm_sum_construct(descriptor_type, tag, list_get(payload, 0), list_get(payload, 1), lines, temp_serial)
        return core_llvm_value(expression.value_type, sum_value)
    if expression.kind == "option_is_some" or expression.kind == "result_is_ok" or expression.kind == "option_unwrap" or expression.kind == "result_unwrap" or expression.kind == "result_unwrap_error":
        let source: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let source_type: Text = list_get(source, 0)
        let descriptor_type: Text = core_llvm_type(source_type)
        let tag: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + tag + " = extractvalue " + descriptor_type + " " + list_get(source, 1) + ", 0")
        if expression.kind == "option_is_some" or expression.kind == "result_is_ok":
            let predicate: Text = core_llvm_temp(temp_serial)
            list_push(lines, "  " + predicate + " = icmp eq i32 " + tag + ", 1")
            return core_llvm_value("Boolean", predicate)
        var expected_tag: Text = "1"
        if expression.kind == "result_unwrap_error": set expected_tag = "0"
        let invalid: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + invalid + " = icmp ne i32 " + tag + ", " + expected_tag)
        var unwrap_failure_reason: Text = "attempted to unwrap none as " + expression.value2
        if expression.kind == "result_unwrap": set unwrap_failure_reason = "attempted to read Result's ok payload from the other variant"
        if expression.kind == "result_unwrap_error": set unwrap_failure_reason = "attempted to read Result's err payload from the other variant"
        core_llvm_emit_trap_if(lines, current, terminated, label_serial, label_serial, strings, invalid, unwrap_failure_reason)
        let payload: Text = core_llvm_sum_extract(descriptor_type, list_get(source, 1), expression.value_type, lines, temp_serial)
        return core_llvm_value(expression.value_type, payload)
    if expression.kind == "interpolate":
        let result: TextList = text_list()
        let has_result: TextList = text_list()
        list_push(result, "")
        list_push(has_result, "false")
        var cursor: Number = 0
        var child_index: Number = 0
        var parsing: Boolean = true
        while parsing:
            let remaining: Text = text_slice(expression.value, cursor, text_length(expression.value) - cursor)
            let open_brace: Number = text_find(remaining, "{")
            if open_brace < 0:
                core_llvm_append_interpolation_piece(remaining, result, has_result, lines, strings, temp_serial)
                set parsing = false
            else:
                let prefix: Text = text_slice(remaining, 0, open_brace)
                core_llvm_append_interpolation_piece(prefix, result, has_result, lines, strings, temp_serial)
                let close_brace: Number = text_find(remaining, "}")
                let value: TextList = core_llvm_emit_expr(list_get(expression.children, child_index), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
                let rendered: Text = core_llvm_interpolation_text(value, lines, temp_serial)
                if list_get(has_result, 0) == "true":
                    let joined: Text = core_llvm_temp(temp_serial)
                    list_push(lines, "  " + joined + " = call ptr @yaza_rt_v1_text_concat(ptr " + list_get(result, 0) + ", ptr " + rendered + ")")
                    list_set(result, 0, joined)
                else:
                    list_set(result, 0, rendered)
                    list_set(has_result, 0, "true")
                set cursor = cursor + close_brace + 1
                set child_index = child_index + 1
        return core_llvm_value("Text", list_get(result, 0))
    if expression.kind == "variable":
        if text_starts_with(expression.value, "%arg"):
            return core_llvm_value(expression.value_type, expression.value)
        let pointer_type: Text = core_llvm_type(expression.value_type)
        let loaded: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + loaded + " = load " + pointer_type + ", ptr " + expression.value)
        return core_llvm_value(expression.value_type, loaded)
    if expression.kind == "field":
        let base: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let base_type: Text = list_get(base, 0)
        let base_val: Text = list_get(base, 1)
        if core_yir_is_borrow_type(base_type) or core_yir_is_mut_borrow_type(base_type):
            let loaded: Text = core_llvm_temp(temp_serial)
            let shape_type: Text = core_llvm_type(core_yir_base_type(base_type))
            list_push(lines, "  " + loaded + " = load " + shape_type + ", ptr " + base_val)
            let result: Text = core_llvm_temp(temp_serial)
            list_push(lines, "  " + result + " = extractvalue " + shape_type + " " + loaded + ", " + expression.value)
            return core_llvm_value(expression.value_type, result)
        let result: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + result + " = extractvalue " + core_llvm_type(base_type) + " " + base_val + ", " + expression.value)
        return core_llvm_value(expression.value_type, result)
    if expression.kind == "index":
        let collection_expression: YirExpr = list_get(expression.children, 0)
        let read_view: Text = core_llvm_find_active_read_view(collection_expression, defer_records, defer_stack, defer_depth)
        let index: TextList = core_llvm_emit_expr(list_get(expression.children, 1), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        if read_view != "" and collection_expression.kind != "variable":
            let collection: TextList = core_llvm_emit_expr(collection_expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
            core_llvm_emit_read_view_switch(read_view, list_get(collection, 1), list_get(collection, 0), lines, temp_serial, label_serial, strings, current, terminated)
            let loaded: Text = core_llvm_emit_active_read_view_get(read_view, collection_expression, list_get(index, 1), expression.value_type, lines, temp_serial, label_serial, current, terminated, defer_records)
            return core_llvm_value(expression.value_type, loaded)
        if read_view != "":
            let loaded: Text = core_llvm_emit_active_read_view_get(read_view, collection_expression, list_get(index, 1), expression.value_type, lines, temp_serial, label_serial, current, terminated, defer_records)
            return core_llvm_value(expression.value_type, loaded)
        let scratch: Text = core_llvm_scratch_name(expression.value_type)
        let ignored: Text = core_llvm_temp(temp_serial)
        let collection: TextList = core_llvm_emit_expr(collection_expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let element_size: Text = core_llvm_size_of(expression.value_type, lines, temp_serial)
        let signature: Text = core_llvm_c_string_pointer(list_get(collection, 0), strings)
        list_push(lines, "  " + ignored + " = call i32 @yaza_list_v1_get_typed(ptr " + list_get(collection, 1) + ", i64 " + list_get(index, 1) + ", ptr " + signature + ", i64 " + element_size + ", ptr " + scratch + ")")
        let loaded: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + loaded + " = load " + core_llvm_type(expression.value_type) + ", ptr " + scratch)
        return core_llvm_value(expression.value_type, loaded)
    if expression.kind == "unary":
        let nested: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let nested_type: Text = list_get(nested, 0)
        let nested_value: Text = list_get(nested, 1)
        let result: Text = core_llvm_temp(temp_serial)
        if expression.value == "not" or expression.value == "!":
            list_push(lines, "  " + result + " = xor i1 " + nested_value + ", true")
            return core_llvm_value("Boolean", result)
        if nested_type == "Float64":
            list_push(lines, "  " + result + " = fneg double " + nested_value)
            return core_llvm_value("Float64", result)
        var intrinsic: Text = "@llvm.ssub.with.overflow.i64"
        var llvm_type: Text = "i64"
        if nested_type == "Int32":
            set intrinsic = "@llvm.ssub.with.overflow.i32"
            set llvm_type = "i32"
        let pair: Text = core_llvm_temp(temp_serial)
        let overflow: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + pair + " = call { " + llvm_type + ", i1 } " + intrinsic + "(" + llvm_type + " 0, " + llvm_type + " " + nested_value + ")")
