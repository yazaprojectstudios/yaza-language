            if operator == "%": set op = "srem"
            list_push(lines, "  " + result + " = " + op + " " + llvm_type + " " + left_value + ", " + right_value)
            return core_llvm_value(left_type, result)
        if left_type == "Text":
            if (operator == "==" or operator == "!=") and (left_expression.kind == "text" or right_expression.kind == "text"):
                let same_pointer: Text = core_llvm_temp(temp_serial)
                let same_label: Text = core_llvm_label(label_serial, "text.literal.same.")
                let compare_label: Text = core_llvm_label(label_serial, "text.literal.compare.")
                let merge_label: Text = core_llvm_label(label_serial, "text.literal.merge.")
                list_push(lines, "  " + same_pointer + " = icmp eq ptr " + left_value + ", " + right_value)
                list_push(lines, "  br i1 " + same_pointer + ", label %" + same_label + ", label %" + compare_label)
                list_set(terminated, 0, "true")
                core_llvm_emit_label(lines, current, terminated, same_label)
                var same_result: Text = "1"
                if operator == "!=": set same_result = "0"
                let same_predecessor: Text = list_get(current, 0)
                list_push(lines, "  br label %" + merge_label)
                list_set(terminated, 0, "true")
                core_llvm_emit_label(lines, current, terminated, compare_label)
                let compared_literal: Text = core_llvm_temp(temp_serial)
                list_push(lines, "  " + compared_literal + " = call i64 @yaza_rt_v1_text_compare(ptr " + left_value + ", ptr " + right_value + ")")
                let compare_value: Text = core_llvm_temp(temp_serial)
                var literal_predicate: Text = "eq"
                if operator == "!=": set literal_predicate = "ne"
                list_push(lines, "  " + compare_value + " = icmp " + literal_predicate + " i64 " + compared_literal + ", 0")
                let compare_predecessor: Text = list_get(current, 0)
                list_push(lines, "  br label %" + merge_label)
                list_set(terminated, 0, "true")
                core_llvm_emit_label(lines, current, terminated, merge_label)
                list_push(lines, "  " + result + " = phi i1 [ " + same_result + ", %" + same_predecessor + " ], [ " + compare_value + ", %" + compare_predecessor + " ]")
                return core_llvm_value("Boolean", result)
            let compared: Text = core_llvm_temp(temp_serial)
            list_push(lines, "  " + compared + " = call i64 @yaza_rt_v1_text_compare(ptr " + left_value + ", ptr " + right_value + ")")
            var text_predicate: Text = "eq"
            if operator == "!=": set text_predicate = "ne"
            if operator == "<": set text_predicate = "slt"
            if operator == ">": set text_predicate = "sgt"
            if operator == "<=": set text_predicate = "sle"
            if operator == ">=": set text_predicate = "sge"
            list_push(lines, "  " + result + " = icmp " + text_predicate + " i64 " + compared + ", 0")
            return core_llvm_value("Boolean", result)
        var predicate: Text = "eq"
        if operator == "!=": set predicate = "ne"
        if operator == "<": set predicate = "slt"
        if operator == ">": set predicate = "sgt"
        if operator == "<=": set predicate = "sle"
        if operator == ">=": set predicate = "sge"
        if left_type == "Boolean":
            if operator == "<": set predicate = "ult"
            if operator == ">": set predicate = "ugt"
            if operator == "<=": set predicate = "ule"
            if operator == ">=": set predicate = "uge"
        if left_type == "Float64":
            if operator == "==": set predicate = "oeq"
            if operator == "!=": set predicate = "une"
            if operator == "<": set predicate = "olt"
            if operator == ">": set predicate = "ogt"
            if operator == "<=": set predicate = "ole"
            if operator == ">=": set predicate = "oge"
            list_push(lines, "  " + result + " = fcmp " + predicate + " double " + left_value + ", " + right_value)
        else:
            list_push(lines, "  " + result + " = icmp " + predicate + " " + llvm_type + " " + left_value + ", " + right_value)
        return core_llvm_value("Boolean", result)
    fail("LLVM backend: unsupported YIR expression kind '" + expression.kind + "'")
    return core_llvm_value("Number", "0")

fn core_llvm_list_view_parameter_items(slot: Text) -> Text:
    return slot + ".yaza.view.items.cache"

fn core_llvm_list_view_parameter_count(slot: Text) -> Text:
    return slot + ".yaza.view.count.cache"

fn core_llvm_is_list_view_parameter(expression: YirExpr) -> Boolean:
    return expression.kind == "variable" and text_starts_with(expression.value, "%arg") and core_yir_list_view_element_type(expression.value_type) != ""

fn core_llvm_emit_list_view_parameter_caches(parameters: List[YirParameter], lines: TextList) -> Number:
    var index: Number = 0
    while index < list_count(parameters):
        let parameter: YirParameter = list_get(parameters, index)
        if core_yir_list_view_element_type(parameter.value_type) != "":
            let items_field: Text = parameter.slot + ".yaza.view.items.field"
            let count_field: Text = parameter.slot + ".yaza.view.count.field"
            list_push(lines, "  " + items_field + " = getelementptr %yaza.list.borrow, ptr " + parameter.slot + ", i32 0, i32 2")
            list_push(lines, "  " + core_llvm_list_view_parameter_items(parameter.slot) + " = load ptr, ptr " + items_field)
            list_push(lines, "  " + count_field + " = getelementptr %yaza.list.borrow, ptr " + parameter.slot + ", i32 0, i32 4")
            list_push(lines, "  " + core_llvm_list_view_parameter_count(parameter.slot) + " = load i64, ptr " + count_field)
        set index = index + 1
    return 0

fn core_llvm_mut_view_cached_items(view: Text) -> Text:
    return view + ".items.cache"

fn core_llvm_mut_view_cached_length(view: Text) -> Text:
    return view + ".length.cache"

fn core_llvm_emit_mut_view_cache(view: Text, lines: TextList, temp_serial: TextList) -> Number:
    let items_field: Text = core_llvm_temp(temp_serial)
    let length_field: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + items_field + " = getelementptr %yaza.list.mutborrow, ptr " + view + ", i32 0, i32 1")
    list_push(lines, "  " + core_llvm_mut_view_cached_items(view) + " = load ptr, ptr " + items_field)
    list_push(lines, "  " + length_field + " = getelementptr %yaza.list.mutborrow, ptr " + view + ", i32 0, i32 2")
    list_push(lines, "  " + core_llvm_mut_view_cached_length(view) + " = load i64, ptr " + length_field)
    return 0

fn core_llvm_emit_mut_view_bounds(view: Text, index: Text, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList) -> Number:
    let valid: Text = core_llvm_temp(temp_serial)
    let okay_label: Text = core_llvm_label(label_serial, "list.mut.bounds.ok.")
    let fail_label: Text = core_llvm_label(label_serial, "list.mut.bounds.fail.")
    list_push(lines, "  " + valid + " = icmp ult i64 " + index + ", " + core_llvm_mut_view_cached_length(view))
    list_push(lines, "  br i1 " + valid + ", label %" + okay_label + ", label %" + fail_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, fail_label)
    list_push(lines, "  call void @yaza_list_v1_mut_end(ptr " + view + ")")
    let reason: Text = core_llvm_pointer_to_string("typed List index is out of range", strings)
    list_push(lines, "  call i64 @yaza_rt_v1_fail_text(ptr " + reason + ")")
    list_push(lines, "  unreachable")
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, okay_label)
    return 0

fn core_llvm_emit_mut_view_get(view: Text, index: Text, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList) -> Text:
    core_llvm_emit_mut_view_bounds(view, index, lines, temp_serial, label_serial, strings, current, terminated)
    let address: Text = core_llvm_temp(temp_serial)
    let result: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + address + " = getelementptr i64, ptr " + core_llvm_mut_view_cached_items(view) + ", i64 " + index)
    list_push(lines, "  " + result + " = load i64, ptr " + address)
    return result

fn core_llvm_emit_mut_view_set(view: Text, index: Text, value: Text, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList) -> Number:
    core_llvm_emit_mut_view_bounds(view, index, lines, temp_serial, label_serial, strings, current, terminated)
    let address: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + address + " = getelementptr i64, ptr " + core_llvm_mut_view_cached_items(view) + ", i64 " + index)
    list_push(lines, "  store i64 " + value + ", ptr " + address)
    return 0

fn core_llvm_emit_nested_mut_access(view: Text, collection_expression: YirExpr, index_expression: YirExpr, item_expression: YirExpr, is_set: Boolean, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList, functions: List[YirFunction], defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList) -> Text:
    let active_value: Text = core_llvm_temp(temp_serial)
    let active: Text = core_llvm_temp(temp_serial)
    let fast_label: Text = core_llvm_label(label_serial, "list.nested.mut.fast.")
    let slow_label: Text = core_llvm_label(label_serial, "list.nested.mut.slow.")
    let outer_fail_label: Text = core_llvm_label(label_serial, "list.nested.mut.outer.fail.")
    let outer_ok_label: Text = core_llvm_label(label_serial, "list.nested.mut.outer.ok.")
    let inner_fail_label: Text = core_llvm_label(label_serial, "list.nested.mut.inner.fail.")
    let inner_ok_label: Text = core_llvm_label(label_serial, "list.nested.mut.inner.ok.")
    let merge_label: Text = core_llvm_label(label_serial, "list.nested.mut.end.")
    let static_mode: Text = core_llvm_nested_mut_static_mode(view, defer_records)
    if static_mode == "active":
        list_push(lines, "  br label %" + fast_label)
    elif static_mode == "inactive":
        list_push(lines, "  br label %" + slow_label)
    else:
        list_push(lines, "  " + active_value + " = load i32, ptr " + core_llvm_nested_mut_active_slot(view))
        list_push(lines, "  " + active + " = icmp ne i32 " + active_value + ", 0")
        list_push(lines, "  br i1 " + active + ", label %" + fast_label + ", label %" + slow_label)
    list_set(terminated, 0, "true")

    core_llvm_emit_label(lines, current, terminated, fast_label)
    let outer_index: TextList = core_llvm_emit_expr(list_get(collection_expression.children, 1), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    let outer_length_field: Text = core_llvm_temp(temp_serial)
    let outer_length: Text = core_llvm_temp(temp_serial)
    let outer_valid: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + outer_length_field + " = getelementptr %yaza.list.nested.mutborrow, ptr " + view + ", i32 0, i32 0, i32 2")
    list_push(lines, "  " + outer_length + " = load i64, ptr " + outer_length_field)
    list_push(lines, "  " + outer_valid + " = icmp ult i64 " + list_get(outer_index, 1) + ", " + outer_length)
    list_push(lines, "  br i1 " + outer_valid + ", label %" + outer_ok_label + ", label %" + outer_fail_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, outer_fail_label)
    let fail_message: Text = core_llvm_pointer_to_string("typed List index is out of range", strings)
    list_push(lines, "  call void @yaza_list_v1_nested_mut_end(ptr " + view + ")")
    list_push(lines, "  call i64 @yaza_rt_v1_fail_text(ptr " + fail_message + ")")
    list_push(lines, "  unreachable")
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, outer_ok_label)
    let items_field: Text = core_llvm_temp(temp_serial)
    let items_slot: Text = core_llvm_temp(temp_serial)
    let items: Text = core_llvm_temp(temp_serial)
    let lengths_field: Text = core_llvm_temp(temp_serial)
    let length_slot: Text = core_llvm_temp(temp_serial)
    let inner_length: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + items_field + " = getelementptr %yaza.list.nested.mutborrow, ptr " + view + ", i32 0, i32 2")
    list_push(lines, "  " + items_slot + " = getelementptr [32 x ptr], ptr " + items_field + ", i32 0, i64 " + list_get(outer_index, 1))
    list_push(lines, "  " + items + " = load ptr, ptr " + items_slot)
    list_push(lines, "  " + lengths_field + " = getelementptr %yaza.list.nested.mutborrow, ptr " + view + ", i32 0, i32 3")
    list_push(lines, "  " + length_slot + " = getelementptr [32 x i64], ptr " + lengths_field + ", i32 0, i64 " + list_get(outer_index, 1))
    list_push(lines, "  " + inner_length + " = load i64, ptr " + length_slot)
    let inner_index: TextList = core_llvm_emit_expr(index_expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    var item_value: Text = "0"
    if is_set:
        let item: TextList = core_llvm_emit_expr(item_expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        set item_value = list_get(item, 1)
    let inner_valid: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + inner_valid + " = icmp ult i64 " + list_get(inner_index, 1) + ", " + inner_length)
    list_push(lines, "  br i1 " + inner_valid + ", label %" + inner_ok_label + ", label %" + inner_fail_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, inner_fail_label)
    list_push(lines, "  call void @yaza_list_v1_nested_mut_end(ptr " + view + ")")
    list_push(lines, "  call i64 @yaza_rt_v1_fail_text(ptr " + fail_message + ")")
    list_push(lines, "  unreachable")
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, inner_ok_label)
    var fast_value: Text = core_llvm_temp(temp_serial)
    let item_pointer: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + item_pointer + " = getelementptr i64, ptr " + items + ", i64 " + list_get(inner_index, 1))
    if is_set:
        list_push(lines, "  store i64 " + item_value + ", ptr " + item_pointer)
        set fast_value = "0"
    else:
        list_push(lines, "  " + fast_value + " = load i64, ptr " + item_pointer)
    let fast_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    list_set(terminated, 0, "true")

    core_llvm_emit_label(lines, current, terminated, slow_label)
    let collection: TextList = core_llvm_emit_expr(collection_expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    let fallback_index: TextList = core_llvm_emit_expr(index_expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    let fallback_value: Text = core_llvm_temp(temp_serial)
    let signature: Text = core_llvm_c_string_pointer("List[Number]", strings)
    if is_set:
        let item: TextList = core_llvm_emit_expr(item_expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let scratch: Text = core_llvm_scratch_name("Number")
        list_push(lines, "  store i64 " + list_get(item, 1) + ", ptr " + scratch)
        list_push(lines, "  " + fallback_value + " = call i64 @yaza_list_v1_set_typed(ptr " + list_get(collection, 1) + ", i64 " + list_get(fallback_index, 1) + ", ptr " + scratch + ", ptr " + signature + ", i64 8)")
    else:
        let scratch: Text = core_llvm_scratch_name("Number")
        let ignored: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + ignored + " = call i32 @yaza_list_v1_get_typed(ptr " + list_get(collection, 1) + ", i64 " + list_get(fallback_index, 1) + ", ptr " + signature + ", i64 8, ptr " + scratch + ")")
        list_push(lines, "  " + fallback_value + " = load i64, ptr " + scratch)
    let slow_predecessor: Text = list_get(current, 0)
    list_push(lines, "  br label %" + merge_label)
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, merge_label)
    let result: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + result + " = phi i64 [ " + fast_value + ", %" + fast_predecessor + " ], [ " + fallback_value + ", %" + slow_predecessor + " ]")
    return result

fn core_llvm_emit_block(block: List[YirStatement], lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList, functions: List[YirFunction], loop_headers: TextList, loop_exits: TextList, active_loop: TextList, defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList, loop_defer_marks: TextList) -> Number:
    let scope_mark: Number = number_parse(list_get(defer_depth, 0))
    var index: Number = 0
    while index < list_count(block):
        if list_get(terminated, 0) != "true":
            core_llvm_emit_stmt(list_get(block, index), lines, temp_serial, label_serial, strings, current, terminated, functions, loop_headers, loop_exits, active_loop, defer_records, defer_stack, defer_depth, loop_defer_marks)
        set index = index + 1
    if list_get(terminated, 0) != "true":
        core_llvm_emit_defer_range(defer_records, defer_stack, defer_depth, scope_mark, lines, temp_serial, label_serial, strings, current, terminated, functions)
    list_set(defer_depth, 0, number_text(scope_mark))
    return 0

fn core_llvm_emit_match_stmt(statement: YirStatement, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList, functions: List[YirFunction], loop_headers: TextList, loop_exits: TextList, active_loop: TextList, defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList, loop_defer_marks: TextList) -> Number:
    let matched_value: TextList = core_llvm_emit_expr(statement.expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    let variant_name: Text = statement.expression.value_type
    let variant_type: Text = core_llvm_type(variant_name)
    let tag_value: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + tag_value + " = extractvalue " + variant_type + " " + list_get(matched_value, 1) + ", 0")
    let invalid_label: Text = core_llvm_label(label_serial, "match.invalid.")
    let merge_label: Text = core_llvm_label(label_serial, "match.end.")
    let arm_labels: TextList = text_list()
    var arm_index: Number = 0
    while arm_index < list_count(statement.match_arms):
        list_push(arm_labels, core_llvm_label(label_serial, "match.arm."))
        set arm_index = arm_index + 1
    list_push(lines, "  switch i32 " + tag_value + ", label %" + invalid_label + " [")
    set arm_index = 0
    while arm_index < list_count(statement.match_arms):
        let arm: YirMatchArm = list_get(statement.match_arms, arm_index)
        list_push(lines, "    i32 " + number_text(arm.tag) + ", label %" + list_get(arm_labels, arm_index))
        set arm_index = arm_index + 1
    list_push(lines, "  ]")
    list_set(terminated, 0, "true")
    core_llvm_emit_label(lines, current, terminated, invalid_label)
    list_push(lines, "  call void @llvm.trap() ; invalid variant tag")
    list_push(lines, "  unreachable")
    list_set(terminated, 0, "true")
    var has_fallthrough: Boolean = false
    set arm_index = 0
    while arm_index < list_count(statement.match_arms):
        let arm: YirMatchArm = list_get(statement.match_arms, arm_index)
        core_llvm_emit_label(lines, current, terminated, list_get(arm_labels, arm_index))
        if list_count(arm.bindings) > 0:
            let option_payload: Text = core_yir_option_payload_type(variant_name)
            let result_success: Text = core_yir_result_argument_type(variant_name, 0)
            let result_error: Text = core_yir_result_argument_type(variant_name, 1)
            let generic_payload: Boolean = option_payload != "" or (result_success != "" and result_error != "")
            var binding_index: Number = 0
            if generic_payload:
                while binding_index < list_count(arm.bindings):
                    let binding: YirMatchBinding = list_get(arm.bindings, binding_index)
                    let field_value: Text = core_llvm_sum_extract(variant_type, list_get(matched_value, 1), binding.value_type, lines, temp_serial)
                    list_push(lines, "  store " + core_llvm_type(binding.value_type) + " " + field_value + ", ptr " + binding.slot)
                    set binding_index = binding_index + 1
            else:
                let payload_pointer: Text = core_llvm_temp(temp_serial)
                list_push(lines, "  " + payload_pointer + " = extractvalue " + variant_type + " " + list_get(matched_value, 1) + ", 1")
                let payload_type: Text = "%yaza.variantpayload." + variant_name + "." + number_text(arm.tag)
                let payload_value: Text = core_llvm_temp(temp_serial)
                list_push(lines, "  " + payload_value + " = load " + payload_type + ", ptr " + payload_pointer)
                while binding_index < list_count(arm.bindings):
                    let binding: YirMatchBinding = list_get(arm.bindings, binding_index)
                    let field_value: Text = core_llvm_temp(temp_serial)
                    list_push(lines, "  " + field_value + " = extractvalue " + payload_type + " " + payload_value + ", " + number_text(binding.field_index))
                    list_push(lines, "  store " + core_llvm_type(binding.value_type) + " " + field_value + ", ptr " + binding.slot)
                    set binding_index = binding_index + 1
        core_llvm_emit_block(arm.body, lines, temp_serial, label_serial, strings, current, terminated, functions, loop_headers, loop_exits, active_loop, defer_records, defer_stack, defer_depth, loop_defer_marks)
        if list_get(terminated, 0) != "true":
            list_push(lines, "  br label %" + merge_label)
            list_set(terminated, 0, "true")
            set has_fallthrough = true
        set arm_index = arm_index + 1
    if has_fallthrough:
        core_llvm_emit_label(lines, current, terminated, merge_label)
    else:
        core_llvm_set_current(current, terminated, invalid_label)
        list_set(terminated, 0, "true")
    return 0

fn core_llvm_emit_match_expr_bindings(variant_name: Text, matched_value: Text, arm: YirMatchArm, lines: TextList, temp_serial: TextList) -> Number:
    if list_count(arm.bindings) == 0: return 0
    let variant_type: Text = core_llvm_type(variant_name)
    let option_payload: Text = core_yir_option_payload_type(variant_name)
    let result_success: Text = core_yir_result_argument_type(variant_name, 0)
    let result_error: Text = core_yir_result_argument_type(variant_name, 1)
    let generic_payload: Boolean = option_payload != "" or (result_success != "" and result_error != "")
    var binding_index: Number = 0
    if generic_payload:
        while binding_index < list_count(arm.bindings):
            let binding: YirMatchBinding = list_get(arm.bindings, binding_index)
            let field_value: Text = core_llvm_sum_extract(variant_type, matched_value, binding.value_type, lines, temp_serial)
            list_push(lines, "  store " + core_llvm_type(binding.value_type) + " " + field_value + ", ptr " + binding.slot)
            set binding_index = binding_index + 1
    else:
        let payload_pointer: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + payload_pointer + " = extractvalue " + variant_type + " " + matched_value + ", 1")
        let payload_type: Text = "%yaza.variantpayload." + variant_name + "." + number_text(arm.tag)
        let payload_value: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + payload_value + " = load " + payload_type + ", ptr " + payload_pointer)
        while binding_index < list_count(arm.bindings):
            let binding: YirMatchBinding = list_get(arm.bindings, binding_index)
            let field_value: Text = core_llvm_temp(temp_serial)
            list_push(lines, "  " + field_value + " = extractvalue " + payload_type + " " + payload_value + ", " + number_text(binding.field_index))
            list_push(lines, "  store " + core_llvm_type(binding.value_type) + " " + field_value + ", ptr " + binding.slot)
            set binding_index = binding_index + 1
    return 0

fn core_llvm_emit_match_expr_compare(subject_type: Text, subject_value: Text, arm: YirMatchArm, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList, functions: List[YirFunction], defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList) -> Text:
    let pattern: TextList = core_llvm_emit_expr(arm.pattern_value, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    let pattern_type: Text = list_get(pattern, 0)
    var compare_type: Text = "Number"
    if subject_type == "Float64" or pattern_type == "Float64": set compare_type = "Float64"
    else:
        if subject_type == "Number" or pattern_type == "Number": set compare_type = "Number"
        else: set compare_type = "Int32"
    var left_value: Text = subject_value
    var right_value: Text = list_get(pattern, 1)
    if compare_type == "Float64":
        if subject_type != "Float64":
            let converted: Text = core_llvm_temp(temp_serial)
            list_push(lines, "  " + converted + " = sitofp " + core_llvm_type(subject_type) + " " + left_value + " to double")
            set left_value = converted
        if pattern_type != "Float64":
            let converted: Text = core_llvm_temp(temp_serial)
            list_push(lines, "  " + converted + " = sitofp " + core_llvm_type(pattern_type) + " " + right_value + " to double")
            set right_value = converted
    else:
        if compare_type == "Number":
            if subject_type == "Int32":
                let converted: Text = core_llvm_temp(temp_serial)
                list_push(lines, "  " + converted + " = sext i32 " + left_value + " to i64")
                set left_value = converted
            if pattern_type == "Int32":
                let converted: Text = core_llvm_temp(temp_serial)
                list_push(lines, "  " + converted + " = sext i32 " + right_value + " to i64")
                set right_value = converted
        else:
            if subject_type == "Number":
                let converted: Text = core_llvm_temp(temp_serial)
                list_push(lines, "  " + converted + " = trunc i64 " + left_value + " to i32")
                set left_value = converted
            if pattern_type == "Number":
                let converted: Text = core_llvm_temp(temp_serial)
                list_push(lines, "  " + converted + " = trunc i64 " + right_value + " to i32")
                set right_value = converted
    var predicate: Text = "eq"
    if arm.pattern_operator == "!=": set predicate = "ne"
    if arm.pattern_operator == "<": set predicate = "slt"
    if arm.pattern_operator == ">": set predicate = "sgt"
    if arm.pattern_operator == "<=": set predicate = "sle"
    if arm.pattern_operator == ">=": set predicate = "sge"
    let comparison: Text = core_llvm_temp(temp_serial)
    if compare_type == "Float64":
        if arm.pattern_operator == "==": set predicate = "oeq"
        if arm.pattern_operator == "!=": set predicate = "une"
        if arm.pattern_operator == "<": set predicate = "olt"
        if arm.pattern_operator == ">": set predicate = "ogt"
        if arm.pattern_operator == "<=": set predicate = "ole"
        if arm.pattern_operator == ">=": set predicate = "oge"
        list_push(lines, "  " + comparison + " = fcmp " + predicate + " double " + left_value + ", " + right_value)
    else:
        list_push(lines, "  " + comparison + " = icmp " + predicate + " " + core_llvm_type(compare_type) + " " + left_value + ", " + right_value)
    return comparison

fn core_llvm_emit_match_expr(statement: YirStatement, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList, functions: List[YirFunction], defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList) -> TextList:
    let matched: TextList = core_llvm_emit_expr(statement.expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
    let variant_name: Text = statement.expression.value_type
    let numeric_match: Boolean = core_yir_numeric(variant_name)
    let invalid_label: Text = core_llvm_label(label_serial, "match.expr.invalid.")
    let merge_label: Text = core_llvm_label(label_serial, "match.expr.end.")
    let arm_labels: TextList = text_list()
    var arm_index: Number = 0
    while arm_index < list_count(statement.match_arms):
        list_push(arm_labels, core_llvm_label(label_serial, "match.expr.arm."))
        set arm_index = arm_index + 1
    if numeric_match:
        var guard_index: Number = 0
        while guard_index + 1 < list_count(statement.match_arms):
            let arm: YirMatchArm = list_get(statement.match_arms, guard_index)
            let condition: Text = core_llvm_emit_match_expr_compare(variant_name, list_get(matched, 1), arm, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
            let next_label: Text = core_llvm_label(label_serial, "match.expr.check.")
            list_push(lines, "  br i1 " + condition + ", label %" + list_get(arm_labels, guard_index) + ", label %" + next_label)
            list_set(terminated, 0, "true")
            core_llvm_emit_label(lines, current, terminated, next_label)
            set guard_index = guard_index + 1
        list_push(lines, "  br label %" + list_get(arm_labels, list_count(arm_labels) - 1))
        list_set(terminated, 0, "true")
    else:
        let variant_type: Text = core_llvm_type(variant_name)
        let tag_value: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + tag_value + " = extractvalue " + variant_type + " " + list_get(matched, 1) + ", 0")
        list_push(lines, "  switch i32 " + tag_value + ", label %" + invalid_label + " [")
        set arm_index = 0
        while arm_index < list_count(statement.match_arms):
            let arm: YirMatchArm = list_get(statement.match_arms, arm_index)
            list_push(lines, "    i32 " + number_text(arm.tag) + ", label %" + list_get(arm_labels, arm_index))
            set arm_index = arm_index + 1
        list_push(lines, "  ]")
        list_set(terminated, 0, "true")
        core_llvm_emit_label(lines, current, terminated, invalid_label)
        list_push(lines, "  call void @llvm.trap() ; invalid variant tag")
        list_push(lines, "  unreachable")
        list_set(terminated, 0, "true")
    let incoming_values: TextList = text_list()
    let incoming_blocks: TextList = text_list()
    set arm_index = 0
    while arm_index < list_count(statement.match_arms):
        let arm: YirMatchArm = list_get(statement.match_arms, arm_index)
        core_llvm_emit_label(lines, current, terminated, list_get(arm_labels, arm_index))
        if not numeric_match: core_llvm_emit_match_expr_bindings(variant_name, list_get(matched, 1), arm, lines, temp_serial)
        let arm_value: TextList = core_llvm_emit_expr(arm.result_expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        if list_get(terminated, 0) != "true":
            list_push(incoming_values, list_get(arm_value, 1))
            list_push(incoming_blocks, list_get(current, 0))
            list_push(lines, "  br label %" + merge_label)
            list_set(terminated, 0, "true")
        set arm_index = arm_index + 1
    core_llvm_emit_label(lines, current, terminated, merge_label)
    if list_count(incoming_values) == 0:
        list_push(lines, "  unreachable")
        list_set(terminated, 0, "true")
        return core_llvm_value(statement.value_type, "undef")
    let result_value: Text = core_llvm_temp(temp_serial)
    var phi: Text = "  " + result_value + " = phi " + core_llvm_type(statement.value_type) + " "
    var incoming_index: Number = 0
    while incoming_index < list_count(incoming_values):
        if incoming_index > 0: set phi = phi + ", "
        set phi = phi + "[ " + list_get(incoming_values, incoming_index) + ", %" + list_get(incoming_blocks, incoming_index) + " ]"
        set incoming_index = incoming_index + 1
    list_push(lines, phi)
    return core_llvm_value(statement.value_type, result_value)

fn core_llvm_set_indexed_text(values: TextList, index: Number, value: Text) -> Number:
    if index < list_count(values):
        list_set(values, index, value)
    else:
        if index == list_count(values): list_push(values, value)
        else: fail("LLVM backend: invalid emitter stack depth")
    return 0

fn core_llvm_emit_stmt(statement: YirStatement, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList, functions: List[YirFunction], loop_headers: TextList, loop_exits: TextList, active_loop: TextList, defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList, loop_defer_marks: TextList) -> Number:
    let source_comment: Text = "  ; YAZA line " + number_text(statement.source_line)
    if statement.kind == "defer":
        var argument_index: Number = 0
        while argument_index < list_count(statement.expression.children):
            let argument: YirExpr = list_get(statement.expression.children, argument_index)
            let value: TextList = core_llvm_emit_expr(argument, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
            let captured_slot: Text = statement.slot + ".arg." + number_text(argument_index)
            list_push(lines, "  store " + core_llvm_type(argument.value_type) + " " + list_get(value, 1) + ", ptr " + captured_slot + source_comment)
            set argument_index = argument_index + 1
        let record_index: Number = list_count(defer_records)
        list_push(defer_records, statement)
        let current_defer_depth: Number = number_parse(list_get(defer_depth, 0))
        if current_defer_depth < list_count(defer_stack):
            list_set(defer_stack, current_defer_depth, number_text(record_index))
        else:
            list_push(defer_stack, number_text(record_index))
        list_set(defer_depth, 0, number_text(current_defer_depth + 1))
        return 0
    if statement.kind == "arena_scope":
        let limit: TextList = core_llvm_emit_expr(statement.expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let negative_limit: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + negative_limit + " = icmp slt i64 " + list_get(limit, 1) + ", 0")
        core_llvm_emit_trap_if(lines, current, terminated, label_serial, label_serial, strings, negative_limit, "arena_scope limit cannot be negative")
        let handle: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + handle + " = call ptr @yaza_rt_v1_scope_enter_inplace(i64 " + list_get(limit, 1) + ", ptr " + statement.slot + ".storage, i64 512)")
        list_push(lines, "  store ptr " + handle + ", ptr " + statement.slot + source_comment)
        let missing_scope: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + missing_scope + " = icmp eq ptr " + handle + ", null")
        core_llvm_emit_trap_if(lines, current, terminated, label_serial, label_serial, strings, missing_scope, "arena_scope could not create its bounded child arena")
        let defer_mark: Number = number_parse(list_get(defer_depth, 0))
        var cleanup: YirStatement = core_yir_statement("arena_scope_cleanup", statement.source_line)
        set cleanup.slot = statement.slot
        set cleanup.source_column = statement.source_column
        set cleanup.source_end_column = statement.source_end_column
        set cleanup.source_file = statement.source_file
        let cleanup_index: Number = list_count(defer_records)
        list_push(defer_records, cleanup)
        if defer_mark < list_count(defer_stack): list_set(defer_stack, defer_mark, number_text(cleanup_index))
        else: list_push(defer_stack, number_text(cleanup_index))
        list_set(defer_depth, 0, number_text(defer_mark + 1))
        core_llvm_emit_block(statement.body, lines, temp_serial, label_serial, strings, current, terminated, functions, loop_headers, loop_exits, active_loop, defer_records, defer_stack, defer_depth, loop_defer_marks)
        if list_get(terminated, 0) != "true":
            core_llvm_emit_defer_range(defer_records, defer_stack, defer_depth, defer_mark, lines, temp_serial, label_serial, strings, current, terminated, functions)
        list_set(defer_depth, 0, number_text(defer_mark))
        return 0
    if statement.kind == "let" or statement.kind == "var":
        let value: TextList = core_llvm_emit_expr(statement.expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        list_push(lines, "  store " + core_llvm_type(statement.value_type) + " " + list_get(value, 1) + ", ptr " + statement.slot + source_comment)
        return 0
    if statement.kind == "set":
        let value: TextList = core_llvm_emit_expr(statement.expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        list_push(lines, "  store " + core_llvm_type(statement.value_type) + " " + list_get(value, 1) + ", ptr " + statement.slot + source_comment)
        return 0
    if statement.kind == "set_field":
        let root_type: Text = core_yir_base_type(statement.name)
        var current_type: Text = root_type
        var current_value: Text = core_llvm_temp(temp_serial)
        let field_value: TextList = core_llvm_emit_expr(statement.expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let parent_values: List[Text] = List[Text]()
        let path_count: Number = list_count(statement.field_path)
        var path_index: Number = 0
        list_push(lines, "  " + current_value + " = load " + core_llvm_type(root_type) + ", ptr " + statement.slot)
        while path_index + 1 < path_count:
            let step: YirFieldPathStep = list_get(statement.field_path, path_index)
            list_push(parent_values, current_value)
            let nested_value: Text = core_llvm_temp(temp_serial)
            list_push(lines, "  " + nested_value + " = extractvalue " + core_llvm_type(current_type) + " " + current_value + ", " + number_text(step.field_index))
            set current_value = nested_value
            set current_type = step.field_type
            set path_index = path_index + 1
        let final_step: YirFieldPathStep = list_get(statement.field_path, path_count - 1)
        let updated_value: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + updated_value + " = insertvalue " + core_llvm_type(current_type) + " " + current_value + ", " + core_llvm_type(statement.value_type) + " " + list_get(field_value, 1) + ", " + number_text(final_step.field_index))
        set current_value = updated_value
        set path_index = path_count - 2
        while path_index >= 0:
            let step: YirFieldPathStep = list_get(statement.field_path, path_index)
            let parent_value: Text = list_get(parent_values, path_index)
            let rebuilt_value: Text = core_llvm_temp(temp_serial)
            list_push(lines, "  " + rebuilt_value + " = insertvalue " + core_llvm_type(step.parent_type) + " " + parent_value + ", " + core_llvm_type(step.field_type) + " " + current_value + ", " + number_text(step.field_index))
            set current_value = rebuilt_value
            set path_index = path_index - 1
        list_push(lines, "  store " + core_llvm_type(root_type) + " " + current_value + ", ptr " + statement.slot + source_comment)
        return 0
    if statement.kind == "say":
        let value: TextList = core_llvm_emit_expr(statement.expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let value_type: Text = list_get(value, 0)
        if value_type == "Text":
            list_push(lines, "  %ignored." + number_text(number_parse(list_get(temp_serial, 0))) + " = call i32 @yaza_rt_v1_say_text(ptr " + list_get(value, 1) + ")" + source_comment)
            list_set(temp_serial, 0, number_text(number_parse(list_get(temp_serial, 0)) + 1))
        else:
            if value_type == "Number":
                let output_result: Text = "%ignored." + number_text(number_parse(list_get(temp_serial, 0)))
                list_push(lines, "  " + output_result + " = call i32 @yaza_rt_v1_say_number(i64 " + list_get(value, 1) + ")" + source_comment)
            else:
                if value_type == "Int32":
                    let output_result: Text = "%ignored." + number_text(number_parse(list_get(temp_serial, 0)))
                    list_push(lines, "  " + output_result + " = call i32 @yaza_rt_v1_say_int32(i32 " + list_get(value, 1) + ")" + source_comment)
                else:
                    if value_type == "Float64":
                        list_push(lines, "  %ignored." + number_text(number_parse(list_get(temp_serial, 0))) + " = call i32 (ptr, ...) @printf(ptr @.yaza.core.fmt.f64, double " + list_get(value, 1) + ")" + source_comment)
                    else:
                        let bool_text: Text = core_llvm_temp(temp_serial)
                        list_push(lines, "  " + bool_text + " = select i1 " + list_get(value, 1) + ", ptr @.yaza.core.true, ptr @.yaza.core.false")
                        list_push(lines, "  %ignored." + number_text(number_parse(list_get(temp_serial, 0))) + " = call i32 (ptr, ...) @printf(ptr @.yaza.core.fmt.text, ptr " + bool_text + ")" + source_comment)
        list_set(temp_serial, 0, number_text(number_parse(list_get(temp_serial, 0)) + 1))
        return 0
    if statement.kind == "assert":
        let value: TextList = core_llvm_emit_expr(statement.expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let failed: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + failed + " = xor i1 " + list_get(value, 1) + ", true")
        var assertion_text: Text = statement.name
        if assertion_text == "": set assertion_text = core_yir_render_expr(statement.expression)
        core_llvm_emit_assert_if(lines, current, terminated, label_serial, strings, failed, "Assertion failed: " + assertion_text)
        return 0
    if statement.kind == "return":
        if statement.expression.kind == "try_return":
            return core_llvm_emit_try_return(statement.expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        if statement.expression.value_type == "Unit":
            core_llvm_emit_defer_range(defer_records, defer_stack, defer_depth, 0, lines, temp_serial, label_serial, strings, current, terminated, functions)
            list_push(lines, "  ret void" + source_comment)
        else:
            let value: TextList = core_llvm_emit_expr(statement.expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
            core_llvm_emit_defer_range(defer_records, defer_stack, defer_depth, 0, lines, temp_serial, label_serial, strings, current, terminated, functions)
            list_push(lines, "  ret " + core_llvm_type(statement.expression.value_type) + " " + list_get(value, 1) + source_comment)
        list_set(terminated, 0, "true")
        return 0
    if statement.kind == "match":
        return core_llvm_emit_match_stmt(statement, lines, temp_serial, label_serial, strings, current, terminated, functions, loop_headers, loop_exits, active_loop, defer_records, defer_stack, defer_depth, loop_defer_marks)
    if statement.kind == "match_expr":
        let value: TextList = core_llvm_emit_match_expr(statement, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        if list_get(terminated, 0) == "true": return 0
        if statement.slot2 == "return":
            core_llvm_emit_defer_range(defer_records, defer_stack, defer_depth, 0, lines, temp_serial, label_serial, strings, current, terminated, functions)
            list_push(lines, "  ret " + core_llvm_type(statement.value_type) + " " + list_get(value, 1) + source_comment)
            list_set(terminated, 0, "true")
            return 0
        list_push(lines, "  store " + core_llvm_type(statement.value_type) + " " + list_get(value, 1) + ", ptr " + statement.slot + source_comment)
        return 0
    if statement.kind == "expression":
        core_llvm_emit_expr(statement.expression, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        return 0
    if statement.kind == "break" or statement.kind == "continue":
        let depth: Number = number_parse(list_get(active_loop, 0))
        if depth <= 0: fail("LLVM backend: loop control outside a loop")
        var destination: Text = list_get(loop_exits, depth - 1)
        if statement.kind == "continue": set destination = list_get(loop_headers, depth - 1)
        let defer_mark: Number = number_parse(list_get(loop_defer_marks, depth - 1))
        core_llvm_emit_defer_range(defer_records, defer_stack, defer_depth, defer_mark, lines, temp_serial, label_serial, strings, current, terminated, functions)
        list_push(lines, "  br label %" + destination + source_comment)
        list_set(terminated, 0, "true")
        return 0
    if statement.kind == "if":
        let merge_label: Text = core_llvm_label(label_serial, "if.end.")
        var branch_index: Number = 0
        while branch_index < list_count(statement.branches):
            let branch: YirBranch = list_get(statement.branches, branch_index)
            let condition: TextList = core_llvm_emit_expr(branch.condition, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
            let body_label: Text = core_llvm_label(label_serial, "if.body.")
            var next_label: Text = merge_label
            if branch_index + 1 < list_count(statement.branches) or statement.has_else:
                set next_label = core_llvm_label(label_serial, "if.next.")
            list_push(lines, "  br i1 " + list_get(condition, 1) + ", label %" + body_label + ", label %" + next_label)
            list_set(terminated, 0, "true")
            core_llvm_emit_label(lines, current, terminated, body_label)
            core_llvm_emit_block(branch.body, lines, temp_serial, label_serial, strings, current, terminated, functions, loop_headers, loop_exits, active_loop, defer_records, defer_stack, defer_depth, loop_defer_marks)
            if list_get(terminated, 0) != "true":
                list_push(lines, "  br label %" + merge_label)
                list_set(terminated, 0, "true")
            if next_label != merge_label:
                core_llvm_emit_label(lines, current, terminated, next_label)
            set branch_index = branch_index + 1
        if statement.has_else:
            core_llvm_emit_block(statement.alternate, lines, temp_serial, label_serial, strings, current, terminated, functions, loop_headers, loop_exits, active_loop, defer_records, defer_stack, defer_depth, loop_defer_marks)
            if list_get(terminated, 0) != "true":
                list_push(lines, "  br label %" + merge_label)
                list_set(terminated, 0, "true")
        else:
            if list_get(terminated, 0) != "true":
                list_push(lines, "  br label %" + merge_label)
                list_set(terminated, 0, "true")
        core_llvm_emit_label(lines, current, terminated, merge_label)
        return 0
    if statement.kind == "while":
        let header: Text = core_llvm_label(label_serial, "while.cond.")
        let body: Text = core_llvm_label(label_serial, "while.body.")
        let exit: Text = core_llvm_label(label_serial, "while.exit.")
        let fast_header: Text = core_llvm_label(label_serial, "while.nested.fast.cond.")
        let fast_body: Text = core_llvm_label(label_serial, "while.nested.fast.body.")
        let slow_header: Text = core_llvm_label(label_serial, "while.nested.slow.cond.")
        let slow_body: Text = core_llvm_label(label_serial, "while.nested.slow.body.")
        let read_view_candidates: List[YirExpr] = core_llvm_while_read_view_candidates(statement, functions)
        let read_view_cleanups: List[YirStatement] = List[YirStatement]()
        let previous_read_view_depth: Number = number_parse(list_get(defer_depth, 0))
        var read_view_index: Number = 0
        while read_view_index < list_count(read_view_candidates):
            let candidate: YirExpr = list_get(read_view_candidates, read_view_index)
            let active_mut_view: Text = core_llvm_find_active_mut_view(candidate, defer_records, defer_stack, defer_depth)
