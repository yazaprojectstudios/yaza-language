fn core_llvm_emit_call_bytes_build_expr(expression: YirExpr, lines: TextList, temp_serial: TextList, label_serial: TextList, strings: TextList, current: TextList, terminated: TextList, functions: List[YirFunction], defer_records: List[YirStatement], defer_stack: TextList, defer_depth: TextList) -> TextList:
    if expression.value == "bytes_empty":
        return core_llvm_value("Bytes", "zeroinitializer")
    if expression.value == "bytes_from_text_bounded":
        let text: TextList = core_llvm_emit_expr(list_get(expression.children, 0), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let maximum: TextList = core_llvm_emit_expr(list_get(expression.children, 1), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let bytes_scratch: Text = core_llvm_scratch_name("Bytes")
