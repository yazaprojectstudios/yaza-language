        let salt: TextList = core_llvm_emit_expr(list_get(expression.children, 1), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let password_fields: TextList = core_llvm_bytes_fields(list_get(password, 1), lines, temp_serial)
        let salt_fields: TextList = core_llvm_bytes_fields(list_get(salt, 1), lines, temp_serial)
        let text_scratch: Text = core_llvm_temp(temp_serial)
        let error_scratch: Text = core_llvm_temp(temp_serial)
        let status: Text = core_llvm_temp(temp_serial)
