        if statement.kind != "if" and statement.kind != "expression" and statement.kind != "let" and statement.kind != "var" and statement.kind != "set": return false
        if not core_llvm_nested_mut_safe_expr(statement.expression, root, functions) or not core_llvm_nested_mut_safe_expr(statement.expression2, root, functions): return false
