        let length: TextList = core_llvm_emit_expr(list_get(expression.children, 2), lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
        let text_scratch: Text = core_llvm_scratch_name("Text")
        let status: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + status + " = call i32 @yaza_rt_v1_try_text_slice(ptr " + list_get(text, 1) + ", i64 " + list_get(start, 1) + ", i64 " + list_get(length, 1) + ", ptr " + text_scratch + ")")
        let result: Text = core_llvm_emit_text_slice_result(status, text_scratch, lines, temp_serial, label_serial, current, terminated)
