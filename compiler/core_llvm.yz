            core_llvm_emit_label(lines, current, terminated, item_slow)
            let ignored: Text = core_llvm_temp(temp_serial)
            list_push(lines, "  " + ignored + " = call i32 @yaza_list_v1_iter_get_typed(ptr " + borrow_slot + ", i64 " + item_index + ", ptr " + statement.slot + ")")
            let slow_item: Text = core_llvm_temp(temp_serial)
            list_push(lines, "  " + slow_item + " = load " + core_llvm_type(item_type) + ", ptr " + statement.slot)
            list_push(lines, "  br label %" + item_merge)
            list_set(terminated, 0, "true")
            core_llvm_emit_label(lines, current, terminated, item_merge)
            let item_value: Text = core_llvm_temp(temp_serial)
            list_push(lines, "  " + item_value + " = phi " + core_llvm_type(item_type) + " [ " + fast_item + ", %" + item_fast + " ], [ " + slow_item + ", %" + item_slow + " ]")
            list_push(lines, "  store " + core_llvm_type(item_type) + " " + item_value + ", ptr " + statement.slot)
        let old_depth: Number = number_parse(list_get(active_loop, 0))
        core_llvm_set_indexed_text(loop_headers, old_depth, step)
        core_llvm_set_indexed_text(loop_exits, old_depth, exit)
        core_llvm_set_indexed_text(loop_defer_marks, old_depth, list_get(defer_depth, 0))
        list_set(active_loop, 0, number_text(old_depth + 1))
        core_llvm_emit_block(statement.body, lines, temp_serial, label_serial, strings, current, terminated, functions, loop_headers, loop_exits, active_loop, defer_records, defer_stack, defer_depth, loop_defer_marks)
        list_set(active_loop, 0, number_text(old_depth))
        if list_get(terminated, 0) != "true": list_push(lines, "  br label %" + step)
        list_set(terminated, 0, "true")
        core_llvm_emit_label(lines, current, terminated, step)
        let current_value: Text = core_llvm_temp(temp_serial)
        let next_value: Text = core_llvm_temp(temp_serial)
        list_push(lines, "  " + current_value + " = load i64, ptr " + statement.slot2)
        list_push(lines, "  " + next_value + " = add i64 " + current_value + ", 1")
        list_push(lines, "  store i64 " + next_value + ", ptr " + statement.slot2)
        list_push(lines, "  br label %" + header)
        list_set(terminated, 0, "true")
        core_llvm_emit_label(lines, current, terminated, exit)
        if not reuses_hoisted_borrow and not direct_view:
            core_llvm_emit_defer_record(cleanup_record, lines, temp_serial, label_serial, strings, current, terminated, functions, defer_records, defer_stack, defer_depth)
            list_set(defer_depth, 0, number_text(previous_defer_depth))
        return 0
    fail("LLVM backend: unsupported YIR statement kind '" + statement.kind + "'")
    return 0

fn core_llvm_add_scratch_type(value_type: Text, scratch_types: TextList) -> Number:
    let scratch_name: Text = core_llvm_scratch_name(value_type)
    var index: Number = 0
    while index < list_count(scratch_types):
        if core_llvm_scratch_name(list_get(scratch_types, index)) == scratch_name: return 0
        set index = index + 1
    list_push(scratch_types, value_type)
    return 0

fn core_llvm_collect_expr_scratch(expression: YirExpr, scratch_types: TextList, functions: List[YirFunction]) -> Number:
    if expression.kind == "call":
        let inlined: YirExpr = core_llvm_inline_accessor(expression, functions)
        if inlined.kind != "":
            core_llvm_collect_expr_scratch(inlined, scratch_types, functions)
            return 0
    if expression.kind == "index" or expression.kind == "list_get":
        core_llvm_add_scratch_type(expression.value_type, scratch_types)
    if expression.kind == "list_try_get" and list_count(expression.children) > 0:
        core_llvm_add_scratch_type(core_yir_list_element_type(list_get(expression.children, 0).value_type), scratch_types)
    if (expression.kind == "list_push" or expression.kind == "list_try_push") and list_count(expression.children) > 0:
        core_llvm_add_scratch_type(core_yir_list_element_type(list_get(expression.children, 0).value_type), scratch_types)
    if (expression.kind == "list_set" or expression.kind == "list_try_set") and list_count(expression.children) > 0:
        core_llvm_add_scratch_type(core_yir_list_element_type(list_get(expression.children, 0).value_type), scratch_types)
    if expression.kind == "list_literal":
        core_llvm_add_scratch_type(core_yir_list_element_type(expression.value_type), scratch_types)
    if expression.kind == "list_try_literal":
        core_llvm_add_scratch_type(core_yir_list_element_type(expression.value), scratch_types)
    if expression.kind == "call" and (expression.value == "bytes_from_text" or expression.value == "bytes_from_number" or expression.value == "secure_random_bytes" or expression.value == "bytes_slice" or expression.value == "bytes_concat"):
        core_llvm_add_scratch_type("Bytes", scratch_types)
    if expression.kind == "call" and expression.value == "bytes_to_text_checked":
        core_llvm_add_scratch_type("Text", scratch_types)
    if expression.kind == "call" and (expression.value == "text_try_slice" or expression.value == "text_try_repeat"):
        core_llvm_add_scratch_type("Text", scratch_types)
    if expression.kind == "call" and expression.value == "number_try_parse":
        core_llvm_add_scratch_type("Number", scratch_types)
    if expression.kind == "call" and expression.value == "int32_try_parse":
        core_llvm_add_scratch_type("Int32", scratch_types)
    if expression.kind == "call" and expression.value == "float64_try_parse":
        core_llvm_add_scratch_type("Float64", scratch_types)
    if expression.kind == "call" and (expression.value == "text_try_split" or expression.value == "text_try_lines"):
        core_llvm_add_scratch_type("TextList", scratch_types)
    if expression.kind == "call" and (expression.value == "bytes_from_text_bounded" or expression.value == "bytes_join" or expression.value == "bytes_try_from_text" or expression.value == "bytes_try_concat" or expression.value == "bytes_try_slice" or expression.value == "bytes_try_from_number" or expression.value == "bytes_try_new_zeroed"):
        core_llvm_add_scratch_type("Bytes", scratch_types)
        core_llvm_add_scratch_type("Text", scratch_types)
    if expression.kind == "call" and expression.value == "secure_random_bytes_try":
        core_llvm_add_scratch_type("Bytes", scratch_types)
        core_llvm_add_scratch_type("Text", scratch_types)
    if expression.kind == "call" and (expression.value == "crypto_sha256" or expression.value == "crypto_hmac_sha256"):
        core_llvm_add_scratch_type("Bytes", scratch_types)
    if expression.kind == "call" and expression.value == "crypto_pbkdf2_sha256":
        core_llvm_add_scratch_type("Bytes", scratch_types)
        core_llvm_add_scratch_type("Text", scratch_types)
    if expression.kind == "call" and expression.value == "crypto_argon2id_hash":
        core_llvm_add_scratch_type("Text", scratch_types)
    if expression.kind == "call" and core_yir_vfs_builtin(expression.value):
        core_llvm_add_scratch_type("Text", scratch_types)
        if core_yir_result_argument_type(expression.value_type, 0) == "Number": core_llvm_add_scratch_type("Number", scratch_types)
        if core_yir_result_argument_type(expression.value_type, 0) == "Bytes": core_llvm_add_scratch_type("Bytes", scratch_types)
        if expression.value == "vfs_write_exact": core_llvm_add_scratch_type("Bytes", scratch_types)
    if expression.kind == "await" and expression.value_type != "Unit":
        core_llvm_add_scratch_type(expression.value_type, scratch_types)
    if expression.kind == "call" and expression.value == "rt_channel_recv":
        core_llvm_add_scratch_type("Number", scratch_types)
    if expression.kind == "call" and core_yir_net_builtin(expression.value):
        core_llvm_add_scratch_type("Text", scratch_types)
        if core_yir_result_argument_type(expression.value_type, 0) == "Number": core_llvm_add_scratch_type("Number", scratch_types)
        if core_yir_result_argument_type(expression.value_type, 0) == "Bytes": core_llvm_add_scratch_type("Bytes", scratch_types)
        if expression.value == "net_write": core_llvm_add_scratch_type("Bytes", scratch_types)
    var child_index: Number = 0
    while child_index < list_count(expression.children):
        core_llvm_collect_expr_scratch(list_get(expression.children, child_index), scratch_types, functions)
        set child_index = child_index + 1
    return 0

fn core_llvm_collect_block_scratch(block: List[YirStatement], scratch_types: TextList, functions: List[YirFunction]) -> Number:
    var index: Number = 0
    while index < list_count(block):
        let statement: YirStatement = list_get(block, index)
        core_llvm_collect_expr_scratch(statement.expression, scratch_types, functions)
        core_llvm_collect_expr_scratch(statement.expression2, scratch_types, functions)
        core_llvm_collect_block_scratch(statement.body, scratch_types, functions)
        core_llvm_collect_block_scratch(statement.alternate, scratch_types, functions)
        var branch_index: Number = 0
        while branch_index < list_count(statement.branches):
            let branch: YirBranch = list_get(statement.branches, branch_index)
            core_llvm_collect_expr_scratch(branch.condition, scratch_types, functions)
            core_llvm_collect_block_scratch(branch.body, scratch_types, functions)
            set branch_index = branch_index + 1
        var arm_index: Number = 0
        while arm_index < list_count(statement.match_arms):
            let arm: YirMatchArm = list_get(statement.match_arms, arm_index)
            core_llvm_collect_expr_scratch(arm.pattern_value, scratch_types, functions)
            core_llvm_collect_expr_scratch(arm.result_expression, scratch_types, functions)
            core_llvm_collect_block_scratch(arm.body, scratch_types, functions)
            set arm_index = arm_index + 1
        set index = index + 1
    return 0

fn core_llvm_collect_hoisted_read_slots(block: List[YirStatement], function_body: List[YirStatement], slots: TextList, types: TextList, functions: List[YirFunction]) -> Number:
    var index: Number = 0
    while index < list_count(block):
        let statement: YirStatement = list_get(block, index)
        if statement.kind == "for_range":
            let candidates: List[YirExpr] = core_llvm_for_range_hoisted_read_slots(statement, function_body, functions)
            var candidate_index: Number = 0
            while candidate_index < list_count(candidates):
                list_push(slots, core_llvm_read_view_slot(statement, candidate_index))
                list_push(types, "YazaListBorrowV1")
                set candidate_index = candidate_index + 1
        core_llvm_collect_hoisted_read_slots(statement.body, function_body, slots, types, functions)
        core_llvm_collect_hoisted_read_slots(statement.alternate, function_body, slots, types, functions)
        var branch_index: Number = 0
        while branch_index < list_count(statement.branches):
            core_llvm_collect_hoisted_read_slots(list_get(statement.branches, branch_index).body, function_body, slots, types, functions)
            set branch_index = branch_index + 1
        var arm_index: Number = 0
        while arm_index < list_count(statement.match_arms):
            core_llvm_collect_hoisted_read_slots(list_get(statement.match_arms, arm_index).body, function_body, slots, types, functions)
            set arm_index = arm_index + 1
        set index = index + 1
    return 0

fn core_llvm_collect_slots(block: List[YirStatement], slots: TextList, types: TextList, functions: List[YirFunction]) -> Number:
    var index: Number = 0
    while index < list_count(block):
        let statement: YirStatement = list_get(block, index)
        if statement.kind == "while":
            let read_view_candidates: List[YirExpr] = core_llvm_while_read_view_candidates(statement, functions)
            var read_view_index: Number = 0
            while read_view_index < list_count(read_view_candidates):
                list_push(slots, core_llvm_read_view_slot(statement, read_view_index))
                list_push(types, "YazaListBorrowV1")
                set read_view_index = read_view_index + 1
            let mut_view_candidates: List[YirExpr] = core_llvm_while_mut_view_candidates(statement, functions)
            var mut_view_index: Number = 0
            while mut_view_index < list_count(mut_view_candidates):
                list_push(slots, core_llvm_mut_view_slot(statement, mut_view_index))
                list_push(types, "YazaListMutableBorrowV1")
                set mut_view_index = mut_view_index + 1
            let nested_mut_view_candidates: List[YirExpr] = core_llvm_while_nested_mut_view_candidates(statement, functions)
            var nested_mut_view_index: Number = 0
            while nested_mut_view_index < list_count(nested_mut_view_candidates):
                list_push(slots, core_llvm_nested_mut_view_slot(statement, nested_mut_view_index))
                list_push(types, "YazaListNestedMutableBorrowV1")
                list_push(slots, core_llvm_nested_mut_active_slot(core_llvm_nested_mut_view_slot(statement, nested_mut_view_index)))
                list_push(types, "Int32")
                set nested_mut_view_index = nested_mut_view_index + 1
        if statement.kind == "let" or statement.kind == "var" or statement.kind == "for_range" or statement.kind == "for_each" or statement.kind == "arena_scope" or (statement.kind == "match_expr" and (statement.slot2 == "let" or statement.slot2 == "var")):
            list_push(slots, statement.slot)
            if statement.kind == "arena_scope":
                list_push(types, "YazaArenaScopeV1")
                list_push(slots, statement.slot + ".storage")
                list_push(types, "YazaArenaScopeStorageV1")
            else: list_push(types, statement.value_type)
            if statement.kind == "for_each":
                list_push(slots, statement.slot2)
                list_push(types, "Number")
                list_push(slots, statement.slot + ".borrow")
                list_push(types, "YazaListBorrowV1")
        if statement.kind == "defer":
            var argument_index: Number = 0
            while argument_index < list_count(statement.expression.children):
                let argument: YirExpr = list_get(statement.expression.children, argument_index)
                list_push(slots, statement.slot + ".arg." + number_text(argument_index))
                list_push(types, argument.value_type)
                set argument_index = argument_index + 1
        core_llvm_collect_slots(statement.body, slots, types, functions)
        core_llvm_collect_slots(statement.alternate, slots, types, functions)
        var branch_index: Number = 0
        while branch_index < list_count(statement.branches):
            core_llvm_collect_slots(list_get(statement.branches, branch_index).body, slots, types, functions)
            set branch_index = branch_index + 1
        var arm_index: Number = 0
        while arm_index < list_count(statement.match_arms):
            let arm: YirMatchArm = list_get(statement.match_arms, arm_index)
            var binding_index: Number = 0
            while binding_index < list_count(arm.bindings):
                let binding: YirMatchBinding = list_get(arm.bindings, binding_index)
                list_push(slots, binding.slot)
                list_push(types, binding.value_type)
                set binding_index = binding_index + 1
            core_llvm_collect_slots(arm.body, slots, types, functions)
            set arm_index = arm_index + 1
        set index = index + 1
    return 0

fn core_llvm_emit_allocas(block: List[YirStatement], lines: TextList, functions: List[YirFunction]) -> Number:
    let slots: TextList = text_list()
    let types: TextList = text_list()
    core_llvm_collect_slots(block, slots, types, functions)
    core_llvm_collect_hoisted_read_slots(block, block, slots, types, functions)
    var index: Number = 0
    while index < list_count(slots):
        if list_get(types, index) == "YazaArenaScopeStorageV1":
            list_push(lines, "  " + list_get(slots, index) + " = alloca [512 x i8], align 16")
        else:
            list_push(lines, "  " + list_get(slots, index) + " = alloca " + core_llvm_type(list_get(types, index)))
        if list_get(types, index) == "YazaListBorrowV1":
            list_push(lines, "  store %yaza.list.borrow zeroinitializer, ptr " + list_get(slots, index))
        if list_get(types, index) == "YazaListNestedReadBorrowV1":
            list_push(lines, "  store %yaza.list.nested.readborrow zeroinitializer, ptr " + list_get(slots, index))
        if list_get(types, index) == "YazaListMutableBorrowV1":
            list_push(lines, "  store %yaza.list.mutborrow zeroinitializer, ptr " + list_get(slots, index))
        if list_get(types, index) == "YazaListNestedMutableBorrowV1":
            list_push(lines, "  store %yaza.list.nested.mutborrow zeroinitializer, ptr " + list_get(slots, index))
        set index = index + 1
    let scratch_types: TextList = text_list()
    core_llvm_collect_block_scratch(block, scratch_types, functions)
    var scratch_index: Number = 0
    while scratch_index < list_count(scratch_types):
        let value_type: Text = list_get(scratch_types, scratch_index)
        list_push(lines, "  " + core_llvm_scratch_name(value_type) + " = alloca " + core_llvm_type(value_type))
        set scratch_index = scratch_index + 1
    return 0

fn core_llvm_emit_function(function: YirFunction, lines: TextList, strings: TextList, functions: List[YirFunction], program_body: List[YirStatement]) -> Number:
    let function_read_views: List[YirExpr] = core_llvm_function_read_view_candidates(function, functions)
    var signature: Text = "define internal " + core_llvm_type(function.return_type) + " @yaza.core.fn." + function.name + "("
    var index: Number = 0
    while index < list_count(function.parameters):
        let parameter: YirParameter = list_get(function.parameters, index)
        if index > 0: set signature = signature + ", "
        if core_yir_list_view_element_type(parameter.value_type) != "":
            set signature = signature + "ptr readonly " + parameter.slot
        else:
            set signature = signature + core_llvm_type(parameter.value_type) + " " + parameter.slot
        set index = index + 1
    var hidden_read_index: Number = 0
    while hidden_read_index < list_count(function_read_views):
        if list_count(function.parameters) > 0 or hidden_read_index > 0: set signature = signature + ", "
        let candidate: YirExpr = list_get(function_read_views, hidden_read_index)
        if core_llvm_function_read_view_always_shared(function, candidate, functions, program_body):
            set signature = signature + "ptr nonnull " + core_llvm_function_read_view_argument(hidden_read_index)
        else:
            set signature = signature + "ptr " + core_llvm_function_read_view_argument(hidden_read_index)
        set hidden_read_index = hidden_read_index + 1
    list_push(lines, signature + ") {")
    list_push(lines, "entry:")
    core_llvm_emit_allocas(function.body, lines, functions)
    core_llvm_emit_list_view_parameter_caches(function.parameters, lines)
    var function_read_index: Number = 0
    while function_read_index < list_count(function_read_views):
        let candidate: YirExpr = list_get(function_read_views, function_read_index)
        if not core_llvm_function_read_view_always_shared(function, candidate, functions, program_body):
            let local_borrow_slot: Text = core_llvm_function_read_view_local_slot(function_read_index)
            let storage_type: Text = core_llvm_function_read_view_storage_type(function, candidate, functions)
            list_push(lines, "  " + local_borrow_slot + " = alloca " + core_llvm_type(storage_type))
            list_push(lines, "  store " + core_llvm_type(storage_type) + " zeroinitializer, ptr " + local_borrow_slot)
        set function_read_index = function_read_index + 1
    let temp_serial: TextList = text_list()
    let label_serial: TextList = text_list()
    let current: TextList = text_list()
    let terminated: TextList = text_list()
    let loop_headers: TextList = text_list()
    let loop_exits: TextList = text_list()
    let active_loop: TextList = text_list()
    let defer_records: List[YirStatement] = List[YirStatement]()
    let defer_stack: TextList = text_list()
    let defer_depth: TextList = text_list()
    let loop_defer_marks: TextList = text_list()
    list_push(temp_serial, "0")
    list_push(label_serial, "0")
    list_push(current, "entry")
    list_push(terminated, "false")
    list_push(active_loop, "0")
    list_push(defer_depth, "0")
    let local_number_lists: TextList = text_list()
    core_llvm_collect_local_number_list_slots(function.body, local_number_lists)
    var local_list_index: Number = 0
    while local_list_index < list_count(local_number_lists):
        let local_list_slot: Text = list_get(local_number_lists, local_list_index)
        if core_llvm_function_has_unique_local_number_list(function, local_list_slot):
            var local_list_record: YirStatement = core_yir_statement("__yaza_local_mutable_list", function.source_line)
            set local_list_record.slot = local_list_slot
            list_push(defer_records, local_list_record)
        set local_list_index = local_list_index + 1
    set function_read_index = 0
    while function_read_index < list_count(function_read_views):
        let candidate: YirExpr = list_get(function_read_views, function_read_index)
        let always_shared: Boolean = core_llvm_function_read_view_always_shared(function, candidate, functions, program_body)
        var borrow_slot: Text = core_llvm_function_read_view_slot(function_read_index)
        var cleanup_name: Text = "__yaza_list_read_view_end"
        let nested_read: Boolean = core_llvm_function_nested_read_view_candidate(function, candidate, functions)
        if nested_read: set cleanup_name = "__yaza_list_nested_read_view_end"
        if always_shared:
            set borrow_slot = core_llvm_function_read_view_argument(function_read_index)
            if nested_read: set cleanup_name = "__yaza_list_nested_read_view_shared"
            else: set cleanup_name = "__yaza_list_read_view_shared"
        else:
            let parent_borrow: Text = core_llvm_function_read_view_argument(function_read_index)
            let local_borrow_slot: Text = core_llvm_function_read_view_local_slot(function_read_index)
            if nested_read:
                let inner_signature: Text = core_llvm_c_string_pointer("List[Number]", strings)
                let outer_signature: Text = core_llvm_c_string_pointer(candidate.value_type, strings)
                let outer_element_size: Text = core_llvm_size_of("List[Number]", lines, temp_serial)
                let inner_element_size: Text = core_llvm_size_of("Number", lines, temp_serial)
                list_push(lines, "  " + borrow_slot + " = call ptr @yaza_list_v1_nested_read_begin_or_share_typed(ptr " + candidate.value + ", ptr " + outer_signature + ", i64 " + outer_element_size + ", ptr " + inner_signature + ", i64 " + inner_element_size + ", ptr " + parent_borrow + ", ptr " + local_borrow_slot + ")")
            else:
                let item_type: Text = core_yir_list_element_type(candidate.value_type)
                let element_size: Text = core_llvm_size_of(item_type, lines, temp_serial)
                let signature_pointer: Text = core_llvm_c_string_pointer(candidate.value_type, strings)
                list_push(lines, "  " + borrow_slot + " = call ptr @yaza_list_v1_read_begin_or_share_typed(ptr " + candidate.value + ", ptr " + signature_pointer + ", i64 " + element_size + ", ptr " + parent_borrow + ", ptr " + local_borrow_slot + ")")
        let cleanup_children: List[YirExpr] = List[YirExpr]()
        let borrow_type: Text = core_llvm_function_read_view_storage_type(function, candidate, functions)
        list_push(cleanup_children, core_yir_expr("variable", borrow_slot, borrow_type, List[YirExpr](), function.source_line))
        if not always_shared:
            list_push(cleanup_children, core_yir_expr("variable", core_llvm_function_read_view_local_slot(function_read_index), borrow_type, List[YirExpr](), function.source_line))
        let cleanup_expression: YirExpr = core_yir_expr("call", cleanup_name, "Unit", cleanup_children, function.source_line)
        let cleanup_record: YirStatement = YirStatement("defer", "", core_llvm_read_view_key(candidate), "", "Unit", cleanup_expression, core_yir_empty_expr(function.source_line), List[YirStatement](), List[YirStatement](), List[YirBranch](), List[YirMatchArm](), function.source_line, function.source_column, function.source_end_column, function.source_file, List[YirFieldPathStep](), 0, "", 1, 1, 0, "", 1, 1, false)
        let cleanup_record_index: Number = list_count(defer_records)
        list_push(defer_records, cleanup_record)
        list_push(defer_stack, number_text(cleanup_record_index))
        let current_defer_depth: Number = number_parse(list_get(defer_depth, 0))
        list_set(defer_depth, 0, number_text(current_defer_depth + 1))
        set function_read_index = function_read_index + 1
    core_llvm_emit_block(function.body, lines, temp_serial, label_serial, strings, current, terminated, functions, loop_headers, loop_exits, active_loop, defer_records, defer_stack, defer_depth, loop_defer_marks)
    if list_get(terminated, 0) != "true":
        core_llvm_emit_defer_range(defer_records, defer_stack, defer_depth, 0, lines, temp_serial, label_serial, strings, current, terminated, functions)
        if function.return_type == "Unit":
            list_push(lines, "  ret void")
        else:
            list_push(lines, "  call void @llvm.trap() ; missing return reached")
            list_push(lines, "  unreachable")
    list_push(lines, "}")
    return 0

fn core_llvm_render_strings(strings: TextList) -> Text:
    let output: TextList = text_list()
    var index: Number = 0
    while index < list_count(strings):
        let value: Text = list_get(strings, index)
        let data_bytes: Number = bytes_length(bytes_from_text(value))
        let storage_bytes: Number = data_bytes + 1
        let name: Text = "@.yaza.core.str." + number_text(index)
        list_push(output, name + ".bytes = private unnamed_addr constant [" + number_text(storage_bytes) + " x i8] c\"" + core_llvm_escape_text(value) + "\", align 1\n")
        list_push(output, name + " = private constant %yaza.text { ptr getelementptr inbounds ([" + number_text(storage_bytes) + " x i8], ptr " + name + ".bytes, i64 0, i64 0), i64 " + number_text(data_bytes) + " }, align 8\n")
        set index = index + 1
    return text_join(output, "")

fn core_llvm_global_constant(name: Text, value: Text) -> Text:
    let byte_count: Number = bytes_length(bytes_from_text(value)) + 1
    return name + " = private unnamed_addr constant [" + number_text(byte_count) + " x i8] c\"" + core_llvm_escape_text(value) + "\", align 1\n"

fn core_llvm_render_shape_types(shapes: List[HirShape], variants: List[HirVariant]) -> Text:
    let output: TextList = text_list()
    list_push(output, "%yaza.option = type { i32, i64 }\n%yaza.option.bytes = type { i32, i64, i64 }\n%yaza.result = type { i32, i64 }\n%yaza.result.bytes = type { i32, i64, i64 }\n%yaza.text = type { ptr, i64 }\n%yaza.bytes = type { ptr, i64 }\n%yaza.module.input = type { i32, i32, i32, i32, ptr, i64 }\n%yaza.module.result = type { i32, i32, i32, i32, ptr, i64 }\n%yaza.list.borrow = type { ptr, ptr, ptr, ptr, i64, i64, i64, i64 }\n%yaza.list.mutborrow = type { ptr, ptr, i64 }\n%yaza.list.nested.mutborrow = type { %yaza.list.mutborrow, [32 x %yaza.list.mutborrow], [32 x ptr], [32 x i64], i64, i32 }\n")
    list_push(output, "%yaza.list.nested.readborrow = type { %yaza.list.borrow, [32 x %yaza.list.borrow], [32 x i64], i64, i32, ptr, i64 }\n")
    var shape_index: Number = 0
    while shape_index < list_count(shapes):
        let shape: HirShape = list_get(shapes, shape_index)
        let field_types: TextList = text_list()
        var field_index: Number = 0
        while field_index < list_count(shape.fields):
            list_push(field_types, core_llvm_type(list_get(shape.fields, field_index).value_type))
            set field_index = field_index + 1
        list_push(output, "%yaza.shape." + shape.name + " = type { " + text_join(field_types, ", ") + " }\n")
        set shape_index = shape_index + 1
    var variant_index: Number = 0
    while variant_index < list_count(variants):
        let variant: HirVariant = list_get(variants, variant_index)
        list_push(output, "%yaza.shape." + variant.name + " = type { i32, ptr }\n")
        var case_index: Number = 0
        while case_index < list_count(variant.cases):
            let variant_case: HirVariantCase = list_get(variant.cases, case_index)
            if list_count(variant_case.fields) > 0:
                let payload_types: TextList = text_list()
                var field_index: Number = 0
                while field_index < list_count(variant_case.fields):
                    list_push(payload_types, core_llvm_type(list_get(variant_case.fields, field_index).value_type))
                    set field_index = field_index + 1
                list_push(output, "%yaza.variantpayload." + variant.name + "." + number_text(case_index) + " = type { " + text_join(payload_types, ", ") + " }\n")
            set case_index = case_index + 1
        set variant_index = variant_index + 1
    return text_join(output, "")

fn core_llvm_number_export_index(program: YirProgram, export_name: Text) -> Number:
    let function_index: Number = core_yir_find_lowered_function(program.functions, export_name)
    if function_index < 0: fail("LLVM module export: function '" + export_name + "' does not exist")
    let function: YirFunction = list_get(program.functions, function_index)
    if function.return_type != "Number": fail("LLVM module export: exported function must return Number")
    var parameter_index: Number = 0
    while parameter_index < list_count(function.parameters):
        if list_get(function.parameters, parameter_index).value_type != "Number": fail("LLVM module export: exported function parameters must all be Number")
        set parameter_index = parameter_index + 1
    let visited: TextList = text_list()
    let unsafe_allocation: Text = core_llvm_request_failfast_function(export_name, program.functions, visited)
    if unsafe_allocation != "": fail("LLVM module export: reachable worker uses a fail-fast allocating operation " + unsafe_allocation + "; use a fallible Core alternative so quota failure does not abort the host process")
    return function_index

fn core_llvm_request_effect_seen(function_name: Text, visited: TextList) -> Boolean:
    var index: Number = 0
    while index < list_count(visited):
        if list_get(visited, index) == function_name: return true
        set index = index + 1
    return false

fn core_llvm_request_effect_location(expression: YirExpr, operation: Text) -> Text:
    return operation + core_yir_yir_expression_location(expression)

fn core_llvm_request_failfast_builtin(expression: YirExpr) -> Text:
    if expression.kind != "call": return ""
    let name: Text = expression.value
    if name == "text_list" or name == "list_new": return name + " allocates a typed List"
    if name == "text_split" or name == "text_lines" or name == "text_trim" or name == "text_join" or name == "text_slice": return name + " allocates Text/List storage"
    if name == "number_text" or name == "int32_text" or name == "float64_text": return name + " allocates formatted Text"
    if name == "bytes_from_text" or name == "bytes_from_number" or name == "secure_random_bytes" or name == "bytes_slice" or name == "bytes_concat": return name + " allocates Bytes storage"
    if name == "bytes_to_text" or name == "bytes_to_text_checked": return name + " allocates converted Text"
    return ""

fn core_llvm_request_intrinsic_failfast_expr(expression: YirExpr) -> Text:
    if expression.kind == "binary" and expression.value == "+" and expression.value_type == "Text":
        return core_llvm_request_effect_location(expression, "Text '+' concatenation allocates")
    if expression.kind == "interpolate":
        return core_llvm_request_effect_location(expression, "Text interpolation allocates")
    if expression.kind == "list_create" or expression.kind == "list_literal":
        return core_llvm_request_effect_location(expression, "List construction allocates")
    if expression.kind == "list_push" or expression.kind == "list_set":
        return core_llvm_request_effect_location(expression, expression.kind + " can allocate or grow a List")
    if expression.kind == "list_try_get":
        let item_type: Text = core_yir_option_payload_type(expression.value_type)
        if item_type != "" and core_llvm_sum_payload_mode(item_type) == 3 and not core_llvm_sum_has_inline_bytes(core_llvm_type(expression.value_type), item_type):
            return core_llvm_request_effect_location(expression, "list_try_get boxes its aggregate payload and can fail fast")
    if expression.kind == "option_some":
        let payload_type: Text = core_yir_option_payload_type(expression.value_type)
        if core_llvm_sum_payload_mode(payload_type) == 3 and not core_llvm_sum_has_inline_bytes(core_llvm_type(expression.value_type), payload_type):
            return core_llvm_request_effect_location(expression, "some boxes its aggregate payload and can fail fast")
    if expression.kind == "result_ok" or expression.kind == "result_err":
        var payload_type: Text = core_yir_result_argument_type(expression.value_type, 0)
        if expression.kind == "result_err": set payload_type = core_yir_result_argument_type(expression.value_type, 1)
        if core_llvm_sum_payload_mode(payload_type) == 3 and not core_llvm_sum_has_inline_bytes(core_llvm_type(expression.value_type), payload_type):
            return core_llvm_request_effect_location(expression, expression.kind + " boxes its aggregate payload and can fail fast")
    if expression.kind == "variant_create" and list_count(expression.children) > 0:
        return core_llvm_request_effect_location(expression, "Variant payload construction allocates")
    if expression.kind == "call":
        let builtin_effect: Text = core_llvm_request_failfast_builtin(expression)
        if builtin_effect != "": return core_llvm_request_effect_location(expression, builtin_effect)
    return ""

fn core_llvm_request_failfast_function(function_name: Text, functions: List[YirFunction], visited: TextList) -> Text:
    if core_llvm_request_effect_seen(function_name, visited): return ""
    list_push(visited, function_name)
    let function_index: Number = core_yir_find_lowered_function(functions, function_name)
    if function_index < 0: return ""
    return core_llvm_request_failfast_block(list_get(functions, function_index).body, functions, visited)

fn core_llvm_request_scan_expr(expression: YirExpr, functions: List[YirFunction], visited: TextList) -> Text:
    var child_index: Number = 0
    while child_index < list_count(expression.children):
        let child_effect: Text = core_llvm_request_scan_expr(list_get(expression.children, child_index), functions, visited)
        if child_effect != "": return child_effect
        set child_index = child_index + 1
    if expression.kind == "call":
        if core_yir_builtin_call(expression.value): return core_llvm_request_intrinsic_failfast_expr(expression)
        let function_index: Number = core_yir_find_lowered_function(functions, expression.value)
        if function_index >= 0:
            let called_effect: Text = core_llvm_request_failfast_function(expression.value, functions, visited)
            if called_effect != "": return called_effect
    return core_llvm_request_intrinsic_failfast_expr(expression)

fn core_llvm_request_failfast_block(block: List[YirStatement], functions: List[YirFunction], visited: TextList) -> Text:
    var index: Number = 0
    while index < list_count(block):
        let statement: YirStatement = list_get(block, index)
        let expression_effect: Text = core_llvm_request_scan_expr(statement.expression, functions, visited)
        if expression_effect != "": return expression_effect
        let expression2_effect: Text = core_llvm_request_scan_expr(statement.expression2, functions, visited)
        if expression2_effect != "": return expression2_effect
        let body_effect: Text = core_llvm_request_failfast_block(statement.body, functions, visited)
        if body_effect != "": return body_effect
        let alternate_effect: Text = core_llvm_request_failfast_block(statement.alternate, functions, visited)
        if alternate_effect != "": return alternate_effect
        var branch_index: Number = 0
        while branch_index < list_count(statement.branches):
            let branch: YirBranch = list_get(statement.branches, branch_index)
            let condition_effect: Text = core_llvm_request_scan_expr(branch.condition, functions, visited)
            if condition_effect != "": return condition_effect
            let branch_effect: Text = core_llvm_request_failfast_block(branch.body, functions, visited)
            if branch_effect != "": return branch_effect
            set branch_index = branch_index + 1
        var arm_index: Number = 0
        while arm_index < list_count(statement.match_arms):
            let arm: YirMatchArm = list_get(statement.match_arms, arm_index)
            let pattern_effect: Text = core_llvm_request_scan_expr(arm.pattern_value, functions, visited)
            if pattern_effect != "": return pattern_effect
            let result_effect: Text = core_llvm_request_scan_expr(arm.result_expression, functions, visited)
            if result_effect != "": return result_effect
            let arm_effect: Text = core_llvm_request_failfast_block(arm.body, functions, visited)
            if arm_effect != "": return arm_effect
            set arm_index = arm_index + 1
        set index = index + 1
    return ""

fn core_llvm_request_export_index(program: YirProgram, export_name: Text) -> Number:
    let function_index: Number = core_yir_find_lowered_function(program.functions, export_name)
    if function_index < 0: fail("LLVM request export: function '" + export_name + "' does not exist")
    let function: YirFunction = list_get(program.functions, function_index)
    if list_count(function.parameters) == 0: fail("LLVM request export: handler must take at least one Text or Bytes parameter")
    var parameter_index: Number = 0
    while parameter_index < list_count(function.parameters):
        let parameter: YirParameter = list_get(function.parameters, parameter_index)
        if parameter.value_type != "Text" and parameter.value_type != "Bytes": fail("LLVM request export: handler parameters must be Text or Bytes")
        set parameter_index = parameter_index + 1
    let success_type: Text = core_yir_result_argument_type(function.return_type, 0)
    if (success_type != "Text" and success_type != "Bytes") or core_yir_result_argument_type(function.return_type, 1) != "Text": fail("LLVM request export: handler must return Result[Text,Text] or Result[Bytes,Text]")
    let visited: TextList = text_list()
    let unsafe_allocation: Text = core_llvm_request_failfast_function(export_name, program.functions, visited)
    if unsafe_allocation != "": fail("LLVM request export: reachable handler uses a fail-fast allocating operation " + unsafe_allocation + "; use its fallible Core alternative so request quota failure can return through Result")
    return function_index

fn core_llvm_module_result_store(out_pointer: Text, status: Text, data_pointer: Text, data_length: Text, lines: TextList, temp_serial: TextList) -> Number:
    let status_pointer: Text = core_llvm_temp(temp_serial)
    let reserved_pointer: Text = core_llvm_temp(temp_serial)
    let data_output_pointer: Text = core_llvm_temp(temp_serial)
    let length_pointer: Text = core_llvm_temp(temp_serial)
    list_push(lines, "  " + status_pointer + " = getelementptr inbounds %yaza.module.result, ptr " + out_pointer + ", i32 0, i32 2")
    list_push(lines, "  store i32 " + status + ", ptr " + status_pointer)
    list_push(lines, "  " + reserved_pointer + " = getelementptr inbounds %yaza.module.result, ptr " + out_pointer + ", i32 0, i32 3")
    list_push(lines, "  store i32 0, ptr " + reserved_pointer)
    list_push(lines, "  " + data_output_pointer + " = getelementptr inbounds %yaza.module.result, ptr " + out_pointer + ", i32 0, i32 4")
    list_push(lines, "  store ptr " + data_pointer + ", ptr " + data_output_pointer)
    list_push(lines, "  " + length_pointer + " = getelementptr inbounds %yaza.module.result, ptr " + out_pointer + ", i32 0, i32 5")
    list_push(lines, "  store i64 " + data_length + ", ptr " + length_pointer)
    return 0

fn core_llvm_module_result_error(out_pointer: Text, status: Text, global_name: Text, message: Text, lines: TextList, temp_serial: TextList, result_status: Text) -> Number:
    let data_pointer: Text = core_llvm_temp(temp_serial)
    let byte_length: Number = bytes_length(bytes_from_text(message))
    list_push(lines, "  " + data_pointer + " = getelementptr inbounds [" + number_text(byte_length + 1) + " x i8], ptr " + global_name + ", i64 0, i64 0")
    core_llvm_module_result_store(out_pointer, status, data_pointer, number_text(byte_length), lines, temp_serial)
    list_push(lines, "  ret i32 " + result_status)
    return 0

fn core_llvm_emit_request_export_wrapper(function: YirFunction, lines: TextList) -> Number:
    let symbol: Text = "yaza_export_" + function.name + "_v1"
    let temp_serial: TextList = text_list()
    list_push(temp_serial, "0")
    let input_count: Number = list_count(function.parameters)
    let call_arguments: TextList = text_list()
    list_push(lines, "define i32 @" + symbol + "(ptr %module.inputs, i64 %module.input.count, ptr %module.output) {")
    list_push(lines, "entry:")
    list_push(lines, "  %module.output.null = icmp eq ptr %module.output, null")
    list_push(lines, "  br i1 %module.output.null, label %module.invalid.output, label %module.check.abi")
    list_push(lines, "module.invalid.output:")
    list_push(lines, "  ret i32 -1")
    list_push(lines, "module.check.abi:")
    list_push(lines, "  %module.abi.pointer = getelementptr inbounds %yaza.module.result, ptr %module.output, i32 0, i32 0")
    list_push(lines, "  %module.abi = load i32, ptr %module.abi.pointer")
    list_push(lines, "  %module.abi.valid = icmp eq i32 %module.abi, 1")
    list_push(lines, "  br i1 %module.abi.valid, label %module.check.size, label %module.invalid.output")
    list_push(lines, "module.check.size:")
    list_push(lines, "  %module.size.pointer = getelementptr inbounds %yaza.module.result, ptr %module.output, i32 0, i32 1")
    list_push(lines, "  %module.size = load i32, ptr %module.size.pointer")
    list_push(lines, "  %module.size.valid = icmp uge i32 %module.size, 32")
    list_push(lines, "  br i1 %module.size.valid, label %module.check.input.count, label %module.invalid.output")
    list_push(lines, "module.check.input.count:")
    list_push(lines, "  %module.input.count.valid = icmp eq i64 %module.input.count, " + number_text(input_count))
    list_push(lines, "  br i1 %module.input.count.valid, label %module.check.inputs, label %module.input.invalid")
    list_push(lines, "module.check.inputs:")
    list_push(lines, "  %module.inputs.null = icmp eq ptr %module.inputs, null")
    list_push(lines, "  br i1 %module.inputs.null, label %module.input.invalid, label %module.copy.input.0")
    var parameter_index: Number = 0
    while parameter_index < input_count:
        let parameter: YirParameter = list_get(function.parameters, parameter_index)
        let index_text: Text = number_text(parameter_index)
        let input_pointer: Text = "%module.input.pointer." + index_text
        let parameter_slot: Text = "%module.parameter.slot." + index_text
        let input_status: Text = "%module.input.status." + index_text
        var copy_helper: Text = "@yaza_rt_v1_module_text_input_copy"
        var slot_type: Text = "ptr"
        if parameter.value_type == "Bytes":
            set copy_helper = "@yaza_rt_v1_module_bytes_input_copy"
            set slot_type = "%yaza.bytes"
        var next_block: Text = "module.copy.input." + number_text(parameter_index + 1)
        if parameter_index + 1 == input_count: set next_block = "module.invoke"
        list_push(lines, "module.copy.input." + index_text + ":")
        list_push(lines, "  " + input_pointer + " = getelementptr inbounds %yaza.module.input, ptr %module.inputs, i64 " + index_text)
        list_push(lines, "  " + parameter_slot + " = alloca " + slot_type + ", align 8")
        list_push(lines, "  " + input_status + " = call i32 " + copy_helper + "(ptr " + input_pointer + ", ptr " + parameter_slot + ")")
        list_push(lines, "  switch i32 " + input_status + ", label %module.input.invalid [ i32 0, label %" + next_block + " i32 2, label %module.input.invalid i32 3, label %module.no.scope i32 4, label %module.resource.limit ]")
        list_push(call_arguments, core_llvm_type(parameter.value_type) + " %module.parameter.value." + index_text)
        set parameter_index = parameter_index + 1
    list_push(lines, "module.invoke:")
    set parameter_index = 0
    while parameter_index < input_count:
        let parameter: YirParameter = list_get(function.parameters, parameter_index)
        let index_text: Text = number_text(parameter_index)
        var slot_type: Text = "ptr"
        if parameter.value_type == "Bytes": set slot_type = "%yaza.bytes"
        list_push(lines, "  %module.parameter.value." + index_text + " = load " + slot_type + ", ptr %module.parameter.slot." + index_text)
        set parameter_index = parameter_index + 1
    let module_result_type: Text = core_llvm_type(function.return_type)
    list_push(lines, "  %module.result.value = call " + module_result_type + " @yaza.core.fn." + function.name + "(" + text_join(call_arguments, ", ") + ")")
    list_push(lines, "  %module.result.tag = extractvalue " + module_result_type + " %module.result.value, 0")
    list_push(lines, "  %module.result.ok = icmp eq i32 %module.result.tag, 1")
    list_push(lines, "  br i1 %module.result.ok, label %module.result.success, label %module.result.application.error")
    list_push(lines, "module.result.success:")
    list_push(lines, "  %module.success.payload.bits = extractvalue " + module_result_type + " %module.result.value, 1")
    if core_yir_result_argument_type(function.return_type, 0) == "Text":
        list_push(lines, "  %module.success.payload.pointer = inttoptr i64 %module.success.payload.bits to ptr")
        list_push(lines, "  %module.success.data.pointer = getelementptr inbounds %yaza.text, ptr %module.success.payload.pointer, i32 0, i32 0")
        list_push(lines, "  %module.success.data = load ptr, ptr %module.success.data.pointer")
        list_push(lines, "  %module.success.length.pointer = getelementptr inbounds %yaza.text, ptr %module.success.payload.pointer, i32 0, i32 1")
        list_push(lines, "  %module.success.length = load i64, ptr %module.success.length.pointer")
    else:
        list_push(lines, "  %module.success.data = inttoptr i64 %module.success.payload.bits to ptr")
        list_push(lines, "  %module.success.length = extractvalue " + module_result_type + " %module.result.value, 2")
    core_llvm_module_result_store("%module.output", "0", "%module.success.data", "%module.success.length", lines, temp_serial)
    list_push(lines, "  ret i32 0")
    list_push(lines, "module.result.application.error:")
    list_push(lines, "  %module.error.payload.bits = extractvalue " + module_result_type + " %module.result.value, 1")
    list_push(lines, "  %module.error.payload = inttoptr i64 %module.error.payload.bits to ptr")
    list_push(lines, "  %module.error.data.pointer = getelementptr inbounds %yaza.text, ptr %module.error.payload, i32 0, i32 0")
    list_push(lines, "  %module.error.data = load ptr, ptr %module.error.data.pointer")
    list_push(lines, "  %module.error.length.pointer = getelementptr inbounds %yaza.text, ptr %module.error.payload, i32 0, i32 1")
    list_push(lines, "  %module.error.length = load i64, ptr %module.error.length.pointer")
    core_llvm_module_result_store("%module.output", "1", "%module.error.data", "%module.error.length", lines, temp_serial)
    list_push(lines, "  ret i32 0")
    list_push(lines, "module.input.invalid:")
    core_llvm_module_result_error("%module.output", "2", "@.yaza.module.error.input", "request input ABI/type is invalid, input is too large, or Text is not valid UTF-8", lines, temp_serial, "2")
    list_push(lines, "module.no.scope:")
    core_llvm_module_result_error("%module.output", "3", "@.yaza.module.error.scope", "request module requires an active reusable request cycle", lines, temp_serial, "3")
    list_push(lines, "module.resource.limit:")
    core_llvm_module_result_error("%module.output", "4", "@.yaza.module.error.resource", "request arena quota exhausted while copying input", lines, temp_serial, "4")
    list_push(lines, "}")
    return 0

fn core_llvm_emit_number_export_wrapper(function: YirFunction, lines: TextList) -> Number:
    let symbol: Text = "yaza_export_" + function.name
    var signature: Text = "define i64 @" + symbol + "("
    var call_arguments: TextList = text_list()
    var index: Number = 0
    while index < list_count(function.parameters):
        if index > 0:
            set signature = signature + ", "
            list_push(call_arguments, ", ")
        let argument_name: Text = "%export.arg." + number_text(index)
        set signature = signature + "i64 " + argument_name
        list_push(call_arguments, "i64 " + argument_name)
        set index = index + 1
    list_push(lines, signature + ") {")
    list_push(lines, "entry:")
    let result: Text = "%export.result"
    list_push(lines, "  " + result + " = call i64 @yaza.core.fn." + function.name + "(" + text_join(call_arguments, "") + ")")
    list_push(lines, "  ret i64 " + result)
    list_push(lines, "}")
    return 0

fn core_llvm_render_module_suffix(program: YirProgram, lines: TextList, strings: TextList) -> Text:
    let declarations: Text = "declare i32 @printf(ptr, ...)\ndeclare void @yaza_rt_v1_init()\ndeclare void @yaza_rt_v1_set_args(i32, ptr)\ndeclare i64 @yaza_rt_v1_arg_count()\ndeclare ptr @yaza_rt_v1_arg(i64)\ndeclare ptr @yaza_rt_v1_alloc(i64)\ndeclare ptr @yaza_rt_v1_try_alloc(i64)\ndeclare i32 @yaza_rt_v1_module_text_copy(ptr, ptr)\ndeclare i32 @yaza_rt_v1_module_bytes_copy(ptr, ptr)\ndeclare ptr @yaza_rt_v1_text_from_cstr(ptr)\ndeclare ptr @yaza_rt_v1_try_text_from_cstr(ptr)\ndeclare ptr @yaza_rt_v1_text_concat(ptr, ptr)\ndeclare i64 @yaza_rt_v1_text_length(ptr)\ndeclare i64 @yaza_rt_v1_text_byte(ptr, i64)\ndeclare ptr @yaza_rt_v1_text_slice(ptr, i64, i64)\ndeclare i64 @yaza_rt_v1_text_find(ptr, ptr)\ndeclare i32 @yaza_rt_v1_text_starts_with(ptr, ptr)\ndeclare i32 @yaza_rt_v1_text_ends_with(ptr, ptr)\ndeclare i64 @yaza_rt_v1_text_compare(ptr, ptr)\ndeclare ptr @yaza_rt_v1_text_trim(ptr)\ndeclare ptr @yaza_rt_v1_try_text_trim(ptr)\ndeclare ptr @yaza_rt_v1_text_lines(ptr)\ndeclare i32 @yaza_rt_v1_try_text_lines(ptr, ptr)\ndeclare i32 @yaza_rt_v1_try_text_split(ptr, ptr, ptr)\ndeclare ptr @yaza_rt_v1_text_split_delimiter_error()\ndeclare ptr @yaza_rt_v1_text_join(ptr, ptr)\ndeclare i32 @yaza_rt_v1_say_text(ptr)\ndeclare i64 @yaza_rt_v1_number_parse(ptr)\ndeclare double @yaza_rt_v1_float64_parse(ptr)\ndeclare i32 @yaza_rt_v1_say_number(i64)\ndeclare i32 @yaza_rt_v1_say_int32(i32)\ndeclare ptr @yaza_rt_v1_number_text(i64)\ndeclare ptr @yaza_rt_v1_int32_text(i32)\ndeclare ptr @yaza_rt_v1_float64_text(double)\ndeclare ptr @yaza_list_v1_create_typed(ptr, i64)\ndeclare i64 @yaza_list_v1_count_typed(ptr, ptr, i64)\ndeclare i64 @yaza_list_v1_push_typed(ptr, ptr, ptr, i64)\ndeclare i32 @yaza_list_v1_try_push_typed(ptr, ptr, ptr, i64)\ndeclare i32 @yaza_list_v1_try_reserve_typed(ptr, i64, ptr, i64)\ndeclare i32 @yaza_list_v1_get_typed(ptr, i64, ptr, i64, ptr)\ndeclare i32 @yaza_list_v1_try_get_typed(ptr, i64, ptr, i64, ptr)\ndeclare i64 @yaza_list_v1_set_typed(ptr, i64, ptr, ptr, i64)\ndeclare i32 @yaza_list_v1_try_set_typed(ptr, i64, ptr, ptr, i64)\ndeclare i64 @yaza_rt_v1_fail_text(ptr)\ndeclare i64 @yaza_rt_v1_assert_fail_text(ptr)\ndeclare void @llvm.trap()\ndeclare { i64, i1 } @llvm.sadd.with.overflow.i64(i64, i64)\ndeclare { i64, i1 } @llvm.ssub.with.overflow.i64(i64, i64)\ndeclare { i64, i1 } @llvm.smul.with.overflow.i64(i64, i64)\ndeclare { i32, i1 } @llvm.sadd.with.overflow.i32(i32, i32)\ndeclare { i32, i1 } @llvm.ssub.with.overflow.i32(i32, i32)\ndeclare { i32, i1 } @llvm.smul.with.overflow.i32(i32, i32)\ndeclare i1 @llvm.is.fpclass.f64(double, i32)\n"
    let extra_declarations: Text = "declare ptr @yaza_bytes_v1_to_text(ptr, i64)\ndeclare i64 @yaza_bytes_v1_zeroize(ptr, i64)\ndeclare i32 @yaza_rt_v1_module_text_input_copy(ptr, ptr)\ndeclare i32 @yaza_rt_v1_module_bytes_input_copy(ptr, ptr)\ndeclare ptr @yaza_rt_v1_try_text_concat(ptr, ptr)\ndeclare i32 @yaza_rt_v1_try_text_repeat(ptr, i64, ptr)\ndeclare ptr @yaza_rt_v1_text_repeat_count_error()\ndeclare ptr @yaza_rt_v1_text_repeat_size_error()\ndeclare i32 @yaza_rt_v1_try_number_parse(ptr, ptr)\ndeclare i32 @yaza_rt_v1_try_int32_parse(ptr, ptr)\ndeclare i32 @yaza_rt_v1_try_float64_parse(ptr, ptr)\ndeclare ptr @yaza_rt_v1_try_text_join(ptr, ptr)\ndeclare i32 @yaza_rt_v1_try_text_slice(ptr, i64, i64, ptr)\ndeclare ptr @yaza_rt_v1_text_slice_range_error()\ndeclare ptr @yaza_rt_v1_try_number_text(i64)\ndeclare ptr @yaza_rt_v1_try_int32_text(i32)\ndeclare ptr @yaza_rt_v1_try_float64_text(double)\ndeclare ptr @yaza_rt_v1_text_allocation_error()\ndeclare i64 @yaza_rt_v1_exit(i64)\ndeclare ptr @yaza_rt_v1_scope_enter(i64)\ndeclare ptr @yaza_rt_v1_scope_enter_inplace(i64, ptr, i64)\ndeclare i32 @yaza_rt_v1_scope_leave(ptr)\ndeclare i32 @yaza_rt_v1_file_exists(ptr)\ndeclare i32 @yaza_rt_v1_is_directory(ptr)\ndeclare ptr @yaza_rt_v1_file_read(ptr)\ndeclare i64 @yaza_rt_v1_file_write(ptr, ptr)\ndeclare i64 @yaza_rt_v1_file_remove(ptr)\ndeclare i64 @yaza_rt_v1_directory_create(ptr)\ndeclare ptr @yaza_rt_v1_directory_list(ptr)\ndeclare ptr @yaza_rt_v1_temp_directory()\ndeclare i64 @yaza_rt_v1_test_temp_directory_remove(ptr)\ndeclare i64 @yaza_rt_v1_env_set(ptr, ptr)\ndeclare i64 @yaza_rt_v1_process(ptr, ptr)\ndeclare i64 @yaza_rt_v1_monotonic_ms()\ndeclare i64 @yaza_rt_v1_monotonic_ns()\ndeclare ptr @yaza_rt_v1_executable_path()\n"
    let processor_declaration: Text = "declare i64 @yaza_rt_v1_processor_count()\n"
    let vfs_declarations: Text = "declare i32 @yaza_vfs_v1_root_open(ptr, ptr, ptr)\ndeclare i32 @yaza_vfs_v1_open_read(i64, ptr, ptr, ptr)\ndeclare i32 @yaza_vfs_v1_open_rw(i64, ptr, ptr, ptr)\ndeclare i32 @yaza_vfs_v1_create_exclusive(i64, ptr, ptr, ptr)\ndeclare i32 @yaza_vfs_v1_list_names(i64, ptr, ptr)\ndeclare i32 @yaza_vfs_v1_lock_exclusive(i64, ptr, ptr, ptr)\ndeclare i32 @yaza_vfs_v1_file_size(i64, ptr, ptr)\ndeclare i32 @yaza_vfs_v1_read_exact(i64, i64, i64, ptr, ptr)\ndeclare i32 @yaza_vfs_v1_write_exact(i64, i64, ptr, ptr, ptr)\ndeclare i32 @yaza_vfs_v1_truncate(i64, i64, ptr)\ndeclare i32 @yaza_vfs_v1_preallocate(i64, i64, ptr)\ndeclare i32 @yaza_vfs_v1_sync(i64, ptr)\ndeclare i32 @yaza_vfs_v1_sync_directory(i64, ptr)\ndeclare i32 @yaza_vfs_v1_remove(i64, ptr, ptr)\ndeclare i32 @yaza_vfs_v1_rename(i64, ptr, ptr, ptr)\ndeclare i32 @yaza_vfs_v1_close(i64, ptr)\n"
    let net_declarations: Text = "declare i32 @yaza_net_v1_listen(ptr, i64, i64, ptr, ptr)\ndeclare i32 @yaza_net_v1_connect(ptr, i64, i64, ptr, ptr)\ndeclare i32 @yaza_net_v1_accept(i64, i64, ptr, ptr)\ndeclare i32 @yaza_net_v1_read(i64, i64, i64, ptr, ptr)\ndeclare i32 @yaza_net_v1_write(i64, ptr, i64, ptr, ptr)\ndeclare i32 @yaza_net_v1_close(i64, ptr)\ndeclare i32 @yaza_net_v1_pair_create(ptr, ptr)\ndeclare i32 @yaza_net_v1_pair_peer(i64, ptr, ptr)\n"
    let bytes_declarations: Text = "declare ptr @yaza_text_v1_split(ptr, ptr)\ndeclare void @yaza_bytes_v1_from_text(ptr, ptr)\ndeclare i32 @yaza_bytes_v1_try_from_text(ptr, ptr, ptr)\ndeclare i32 @yaza_bytes_v1_try_new_zeroed(i64, ptr, ptr)\ndeclare void @yaza_bytes_v1_from_number(i64, ptr)\ndeclare i32 @yaza_bytes_v1_try_from_number(i64, ptr, ptr)\ndeclare void @yaza_bytes_v1_secure_random(i64, ptr)\ndeclare i32 @yaza_bytes_v1_try_secure_random(i64, ptr, ptr)\ndeclare void @yaza_bytes_v1_slice(ptr, i64, i64, i64, ptr)\ndeclare i32 @yaza_bytes_v1_try_slice(ptr, i64, i64, i64, ptr, ptr)\ndeclare void @yaza_bytes_v1_concat(ptr, i64, ptr, i64, ptr)\ndeclare i32 @yaza_bytes_v1_try_concat(ptr, i64, ptr, i64, ptr, ptr)\ndeclare i32 @yaza_bytes_v1_equal(ptr, i64, ptr, i64)\ndeclare i32 @yaza_bytes_v1_equal_constant_time(ptr, i64, ptr, i64)\ndeclare i32 @yaza_bytes_v1_to_text_checked(ptr, i64, ptr)\ndeclare i32 @yaza_bytes_v1_try_to_text(ptr, i64, ptr, ptr)\ndeclare i32 @yaza_bytes_v1_from_text_bounded(ptr, i64, ptr, ptr)\ndeclare i32 @yaza_bytes_v1_join(ptr, ptr, ptr)\ndeclare i64 @yaza_bytes_v1_crc32c(ptr, i64)\ndeclare i64 @yaza_bytes_v1_crc32c_zeroed_range(ptr, i64, i64, i64)\ndeclare i64 @yaza_bytes_v1_ydbv1_checksum(ptr, i64)\ndeclare i64 @yaza_bytes_v1_ydbv1_checksum_zeroed_range(ptr, i64, i64, i64)\ndeclare void @yaza_crypto_v1_sha256(ptr, i64, ptr)\ndeclare void @yaza_crypto_v1_hmac_sha256(ptr, i64, ptr, i64, ptr)\ndeclare i32 @yaza_crypto_v1_pbkdf2_sha256(ptr, i64, ptr, i64, i64, i64, ptr, ptr)\ndeclare i32 @yaza_crypto_v1_argon2id_hash(ptr, i64, ptr, i64, ptr, ptr)\ndeclare i32 @yaza_crypto_v1_argon2id_verify(ptr, i64, ptr)\ndeclare i32 @yaza_crypto_v1_argon2id_hash_format_is_current(ptr)\n"
    let list_iter_declarations: Text = "declare void @yaza_list_v1_iter_begin_typed(ptr, ptr, i64, ptr)\ndeclare i64 @yaza_list_v1_iter_count(ptr)\ndeclare i32 @yaza_list_v1_iter_get_typed(ptr, i64, ptr)\ndeclare void @yaza_list_v1_iter_end(ptr)\ndeclare void @yaza_list_v1_read_begin_typed(ptr, ptr, i64, ptr)\ndeclare i32 @yaza_list_v1_read_get_typed(ptr, i64, ptr)\ndeclare void @yaza_list_v1_read_end(ptr)\ndeclare void @yaza_list_v1_mut_begin_typed(ptr, ptr, i64, ptr)\ndeclare void @yaza_list_v1_mut_end(ptr)\ndeclare i32 @yaza_list_v1_nested_mut_begin_typed(ptr, ptr, i64, ptr, i64, ptr)\ndeclare void @yaza_list_v1_nested_mut_end(ptr)\n"
    let list_read_share_declarations: Text = "declare ptr @yaza_list_v1_read_begin_or_share_typed(ptr, ptr, i64, ptr, ptr)\ndeclare void @yaza_list_v1_read_release_shared(ptr, ptr)\ndeclare ptr @yaza_list_v1_nested_read_begin_or_share_typed(ptr, ptr, i64, ptr, i64, ptr, ptr)\ndeclare void @yaza_list_v1_nested_read_end(ptr)\ndeclare void @yaza_list_v1_nested_read_release_shared(ptr, ptr)\ndeclare void @yaza_list_v1_read_fail_bounds(ptr, i64)\n"
    let fallible_list_declarations: Text = "declare ptr @yaza_list_v1_try_create_typed(ptr, i64)\ndeclare ptr @yaza_rt_v1_list_allocation_error()\n"
    let arena_metric_declarations: Text = "declare i64 @yaza_rt_v1_current_arena_used()\ndeclare i64 @yaza_rt_v1_current_arena_storage_used()\ndeclare i64 @yaza_rt_v1_current_arena_reserved()\ndeclare i64 @yaza_rt_v1_current_arena_peak_used()\ndeclare i64 @yaza_rt_v1_current_arena_peak_storage_used()\ndeclare i64 @yaza_rt_v1_current_arena_peak_reserved()\ndeclare i64 @yaza_rt_v1_current_arena_allocation_count()\ndeclare i64 @yaza_rt_v1_current_arena_generation()\ndeclare i64 @yaza_rt_v1_live_scope_count()\n"
    let constants: Text = core_llvm_global_constant("@.yaza.core.fmt.f64", "%.17g\n") + core_llvm_global_constant("@.yaza.core.fmt.text", "%s\n") + core_llvm_global_constant("@.yaza.core.true", "true") + core_llvm_global_constant("@.yaza.core.false", "false")
    let env_get_declaration: Text = "declare ptr @yaza_rt_v1_env_get(ptr)\n"
    let console_input_declaration: Text = "declare ptr @yaza_rt_v1_console_read_line()\n"
    let module_error_constants: Text = core_llvm_global_constant("@.yaza.module.error.input", "request input ABI/type is invalid, input is too large, or Text is not valid UTF-8") + core_llvm_global_constant("@.yaza.module.error.scope", "request module requires an active reusable request cycle") + core_llvm_global_constant("@.yaza.module.error.resource", "request arena quota exhausted while copying input")
    let fallback_message: Text = "Could not allocate Bytes in the active arena"
    let list_view_declarations: Text = "declare ptr @yaza_list_v1_read_view_begin_typed(ptr, ptr, i64)\ndeclare ptr @yaza_list_v1_read_view_prefix_typed(ptr, ptr, i64, i64)\ndeclare i64 @yaza_list_v1_read_view_count(ptr)\ndeclare void @yaza_list_v1_read_view_end(ptr)\n"
    let concurrency_declarations: Text = "declare i64 @yaza_rt_v1_unix_ms()\ndeclare i32 @yaza_rt_v1_sleep_ms(i64)\ndeclare i32 @yaza_rt_v1_yield()\ndeclare ptr @yaza_rt_v1_task_ctx_alloc(i64)\ndeclare ptr @yaza_rt_v1_task_spawn(ptr, ptr, i64, i32)\ndeclare void @yaza_rt_v1_task_await(ptr, ptr, i64)\ndeclare i64 @yaza_rt_v1_mutex_handle_create()\ndeclare i32 @yaza_rt_v1_mutex_handle_lock(i64)\ndeclare i32 @yaza_rt_v1_mutex_handle_unlock(i64)\ndeclare i32 @yaza_rt_v1_mutex_handle_destroy(i64)\ndeclare i64 @yaza_rt_v1_atomic_handle_create(i64)\ndeclare i64 @yaza_rt_v1_atomic_handle_load(i64)\ndeclare i32 @yaza_rt_v1_atomic_handle_store(i64, i64)\ndeclare i64 @yaza_rt_v1_atomic_handle_add(i64, i64)\ndeclare i64 @yaza_rt_v1_channel_create(i64)\ndeclare i32 @yaza_rt_v1_channel_send(i64, i64)\ndeclare i32 @yaza_rt_v1_channel_recv(i64, ptr)\ndeclare i32 @yaza_rt_v1_channel_close(i64)\ndeclare i32 @yaza_rt_v1_channel_is_full(i64)\ndeclare i32 @yaza_rt_v1_channel_is_closed(i64)\n"
    let fallback_byte_length: Number = bytes_length(bytes_from_text(fallback_message))
    let fallback_storage_length: Number = fallback_byte_length + 1
    let fallback_data_name: Text = "@.yaza.core.result.bytes.fallback.bytes"
    let fallback_data: Text = fallback_data_name + " = private unnamed_addr constant [" + number_text(fallback_storage_length) + " x i8] c\"" + core_llvm_escape_text(fallback_message) + "\", align 1\n"
    let fallback_descriptor: Text = "@.yaza.core.result.bytes.fallback.text = private constant %yaza.text { ptr getelementptr inbounds ([" + number_text(fallback_storage_length) + " x i8], ptr " + fallback_data_name + ", i64 0, i64 0), i64 " + number_text(fallback_byte_length) + " }, align 8\n"
    return "; Generated from YAZA Core HIR -> YIR.\n" + declarations + fallible_list_declarations + extra_declarations + processor_declaration + concurrency_declarations + env_get_declaration + console_input_declaration + vfs_declarations + net_declarations + bytes_declarations + list_iter_declarations + list_read_share_declarations + list_view_declarations + arena_metric_declarations + core_llvm_render_shape_types(program.shapes, program.variants) + constants + module_error_constants + core_llvm_render_strings(strings) + fallback_data + fallback_descriptor + text_join(lines, "\n") + "\n"

fn core_llvm_collect_expr_spawns(expression: YirExpr, spawns: List[YirExpr], seen_ids: TextList) -> Number:
    if expression.kind == "spawn":
        let id: Text = core_llvm_spawn_id(expression)
        var already: Boolean = false
        var idx: Number = 0
        while idx < list_count(seen_ids):
            if list_get(seen_ids, idx) == id: set already = true
            set idx = idx + 1
        if not already:
            list_push(seen_ids, id)
            list_push(spawns, expression)
    var child_index: Number = 0
    while child_index < list_count(expression.children):
        core_llvm_collect_expr_spawns(list_get(expression.children, child_index), spawns, seen_ids)
        set child_index = child_index + 1
    return 0

fn core_llvm_collect_block_spawns(block: List[YirStatement], spawns: List[YirExpr], seen_ids: TextList) -> Number:
    var index: Number = 0
    while index < list_count(block):
        let statement: YirStatement = list_get(block, index)
        core_llvm_collect_expr_spawns(statement.expression, spawns, seen_ids)
        core_llvm_collect_expr_spawns(statement.expression2, spawns, seen_ids)
        core_llvm_collect_block_spawns(statement.body, spawns, seen_ids)
        core_llvm_collect_block_spawns(statement.alternate, spawns, seen_ids)
        var branch_index: Number = 0
        while branch_index < list_count(statement.branches):
            let branch: YirBranch = list_get(statement.branches, branch_index)
            core_llvm_collect_expr_spawns(branch.condition, spawns, seen_ids)
            core_llvm_collect_block_spawns(branch.body, spawns, seen_ids)
            set branch_index = branch_index + 1
        var arm_index: Number = 0
        while arm_index < list_count(statement.match_arms):
            let arm: YirMatchArm = list_get(statement.match_arms, arm_index)
            core_llvm_collect_expr_spawns(arm.pattern_value, spawns, seen_ids)
            core_llvm_collect_expr_spawns(arm.result_expression, spawns, seen_ids)
            core_llvm_collect_block_spawns(arm.body, spawns, seen_ids)
            set arm_index = arm_index + 1
        set index = index + 1
    return 0

fn core_llvm_emit_spawn_thunks(program: YirProgram, lines: TextList, strings: TextList) -> Number:
    let spawns: List[YirExpr] = List[YirExpr]()
    let seen_ids: TextList = text_list()
    var function_index: Number = 0
    while function_index < list_count(program.functions):
        core_llvm_collect_block_spawns(list_get(program.functions, function_index).body, spawns, seen_ids)
        set function_index = function_index + 1
    core_llvm_collect_block_spawns(program.body, spawns, seen_ids)

    var spawn_index: Number = 0
    while spawn_index < list_count(spawns):
        let sp: YirExpr = list_get(spawns, spawn_index)
        let id: Text = core_llvm_spawn_id(sp)
        let child: YirExpr = list_get(sp.children, 0)
        let ctx_type_name: Text = "%__yaza.spawn.ctx." + id
        let temp_serial: TextList = text_list()
        let label_serial: TextList = text_list()
        let current: TextList = text_list()
        let terminated: TextList = text_list()
        let defer_records: List[YirStatement] = List[YirStatement]()
        let defer_stack: TextList = text_list()
        let defer_depth: TextList = text_list()
        list_push(temp_serial, "0")
        list_push(label_serial, "0")
        list_push(current, "entry")
        list_push(terminated, "false")
        list_push(defer_depth, "0")

        if child.kind == "call":
            let argc: Number = list_count(child.children)
            if argc > 0:
                let field_types: TextList = text_list()
                var arg_index: Number = 0
                while arg_index < argc:
                    list_push(field_types, core_llvm_type(list_get(child.children, arg_index).value_type))
                    set arg_index = arg_index + 1
                list_push(lines, ctx_type_name + " = type { " + text_join(field_types, ", ") + " }")
            list_push(lines, "define void @__yaza_spawn_thunk_" + id + "(ptr %ctx, ptr %out) {")
            list_push(lines, "entry:")
            let synthetic_args: List[YirExpr] = List[YirExpr]()
            var arg_index: Number = 0
            while arg_index < argc:
                let arg_type: Text = list_get(child.children, arg_index).value_type
                let llvm_arg_type: Text = core_llvm_type(arg_type)
                let ptr_reg: Text = core_llvm_temp(temp_serial)
                let val_reg: Text = "%arg." + number_text(arg_index)
                list_push(lines, "  " + ptr_reg + " = getelementptr inbounds " + ctx_type_name + ", ptr %ctx, i32 0, i32 " + number_text(arg_index))
                list_push(lines, "  " + val_reg + " = load " + llvm_arg_type + ", ptr " + ptr_reg)
                list_push(synthetic_args, core_yir_expr("variable", val_reg, arg_type, List[YirExpr](), child.source_line))
                set arg_index = arg_index + 1
            var synthetic_call: YirExpr = core_yir_expr("call", child.value, child.value_type, synthetic_args, child.source_line)
            set synthetic_call.value2 = child.value2
            let scratch_types: TextList = text_list()
            core_llvm_collect_expr_scratch(synthetic_call, scratch_types, program.functions)
            var scratch_index: Number = 0
            while scratch_index < list_count(scratch_types):
                let s_type: Text = list_get(scratch_types, scratch_index)
                list_push(lines, "  " + core_llvm_scratch_name(s_type) + " = alloca " + core_llvm_type(s_type))
                set scratch_index = scratch_index + 1
            let res: TextList = core_llvm_emit_expr(synthetic_call, lines, temp_serial, label_serial, strings, current, terminated, program.functions, defer_records, defer_stack, defer_depth)
            if child.value_type != "Unit" and list_get(terminated, 0) != "true":
                list_push(lines, "  store " + core_llvm_type(child.value_type) + " " + list_get(res, 1) + ", ptr %out")
            if list_get(terminated, 0) != "true":
                list_push(lines, "  ret void")
            list_push(lines, "}")
        else:
            let var_slots: TextList = text_list()
            let var_types: TextList = text_list()
            core_llvm_collect_expr_variables(child, var_slots, var_types)
            let var_count: Number = list_count(var_slots)
            if var_count > 0:
                let field_types: TextList = text_list()
                var var_index: Number = 0
                while var_index < var_count:
                    list_push(field_types, core_llvm_type(list_get(var_types, var_index)))
                    set var_index = var_index + 1
                list_push(lines, ctx_type_name + " = type { " + text_join(field_types, ", ") + " }")
            list_push(lines, "define void @__yaza_spawn_thunk_" + id + "(ptr %ctx, ptr %out) {")
            list_push(lines, "entry:")
            var var_index: Number = 0
            while var_index < var_count:
                let slot_name: Text = list_get(var_slots, var_index)
                let slot_type: Text = list_get(var_types, var_index)
                let llvm_var_type: Text = core_llvm_type(slot_type)
                let ptr_reg: Text = core_llvm_temp(temp_serial)
                list_push(lines, "  " + ptr_reg + " = getelementptr inbounds " + ctx_type_name + ", ptr %ctx, i32 0, i32 " + number_text(var_index))
                if text_starts_with(slot_name, "%arg"):
                    list_push(lines, "  " + slot_name + " = load " + llvm_var_type + ", ptr " + ptr_reg)
                else:
                    let loaded_reg: Text = core_llvm_temp(temp_serial)
                    list_push(lines, "  " + loaded_reg + " = load " + llvm_var_type + ", ptr " + ptr_reg)
                    list_push(lines, "  " + slot_name + " = alloca " + llvm_var_type)
                    list_push(lines, "  store " + llvm_var_type + " " + loaded_reg + ", ptr " + slot_name)
                set var_index = var_index + 1
            let scratch_types: TextList = text_list()
            core_llvm_collect_expr_scratch(child, scratch_types, program.functions)
            var scratch_index: Number = 0
            while scratch_index < list_count(scratch_types):
                let s_type: Text = list_get(scratch_types, scratch_index)
                list_push(lines, "  " + core_llvm_scratch_name(s_type) + " = alloca " + core_llvm_type(s_type))
                set scratch_index = scratch_index + 1
            let res: TextList = core_llvm_emit_expr(child, lines, temp_serial, label_serial, strings, current, terminated, program.functions, defer_records, defer_stack, defer_depth)
            if child.value_type != "Unit" and list_get(terminated, 0) != "true":
                list_push(lines, "  store " + core_llvm_type(child.value_type) + " " + list_get(res, 1) + ", ptr %out")
            if list_get(terminated, 0) != "true":
                list_push(lines, "  ret void")
            list_push(lines, "}")
        set spawn_index = spawn_index + 1
    return 0

fn lower_core_yir_to_llvm(program: YirProgram) -> Text:
    let verified: Number = verify_core_yir(program)
    let lines: TextList = text_list()
    let strings: TextList = text_list()
    core_llvm_emit_spawn_thunks(program, lines, strings)
    var function_index: Number = 0
    while function_index < list_count(program.functions):
        core_llvm_emit_function(list_get(program.functions, function_index), lines, strings, program.functions, program.body)
        set function_index = function_index + 1
    list_push(lines, "define i32 @main(i32 %argc, ptr %argv) {")
    list_push(lines, "entry:")
    list_push(lines, "  call void @yaza_rt_v1_init()")
    list_push(lines, "  call void @yaza_rt_v1_set_args(i32 %argc, ptr %argv)")
    core_llvm_emit_allocas(program.body, lines, program.functions)
    let temp_serial: TextList = text_list()
    let label_serial: TextList = text_list()
    let current: TextList = text_list()
    let terminated: TextList = text_list()
    let loop_headers: TextList = text_list()
    let loop_exits: TextList = text_list()
    let active_loop: TextList = text_list()
    let defer_records: List[YirStatement] = List[YirStatement]()
    let defer_stack: TextList = text_list()
    let defer_depth: TextList = text_list()
    let loop_defer_marks: TextList = text_list()
    list_push(temp_serial, "0")
    list_push(label_serial, "0")
    list_push(current, "entry")
    list_push(terminated, "false")
    list_push(active_loop, "0")
    list_push(defer_depth, "0")
    let local_number_lists: TextList = text_list()
    core_llvm_collect_local_number_list_slots(program.body, local_number_lists)
    var local_list_index: Number = 0
    while local_list_index < list_count(local_number_lists):
        let local_list_slot: Text = list_get(local_number_lists, local_list_index)
        if core_llvm_block_has_unique_local_number_list(program.body, local_list_slot):
            var local_list_record: YirStatement = core_yir_statement("__yaza_local_mutable_list", 1)
            set local_list_record.slot = local_list_slot
            list_push(defer_records, local_list_record)
        set local_list_index = local_list_index + 1
    core_llvm_emit_block(program.body, lines, temp_serial, label_serial, strings, current, terminated, program.functions, loop_headers, loop_exits, active_loop, defer_records, defer_stack, defer_depth, loop_defer_marks)
    if list_get(terminated, 0) != "true": list_push(lines, "  ret i32 0")
    list_push(lines, "}")
    return core_llvm_render_module_suffix(program, lines, strings)

fn lower_core_yir_to_llvm_module(program: YirProgram, export_name: Text) -> Text:
    let verified: Number = verify_core_yir(program)
    let export_index: Number = core_llvm_number_export_index(program, export_name)
    let export_function: YirFunction = list_get(program.functions, export_index)
    let lines: TextList = text_list()
    let strings: TextList = text_list()
    core_llvm_emit_spawn_thunks(program, lines, strings)
    var function_index: Number = 0
    while function_index < list_count(program.functions):
        core_llvm_emit_function(list_get(program.functions, function_index), lines, strings, program.functions, program.body)
        set function_index = function_index + 1
    core_llvm_emit_number_export_wrapper(export_function, lines)
    return core_llvm_render_module_suffix(program, lines, strings)

fn lower_core_yir_to_llvm_request_module(program: YirProgram, export_name: Text) -> Text:
    let verified: Number = verify_core_yir(program)
    let export_index: Number = core_llvm_request_export_index(program, export_name)
    let export_function: YirFunction = list_get(program.functions, export_index)
    let lines: TextList = text_list()
    let strings: TextList = text_list()
    core_llvm_emit_spawn_thunks(program, lines, strings)
    var function_index: Number = 0
    while function_index < list_count(program.functions):
        core_llvm_emit_function(list_get(program.functions, function_index), lines, strings, program.functions, program.body)
        set function_index = function_index + 1
    core_llvm_emit_request_export_wrapper(export_function, lines)
    return core_llvm_render_module_suffix(program, lines, strings)
