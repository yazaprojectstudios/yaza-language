fn core_yir_verify_binary_expr(expression: YirExpr, child_types: List[Text]) -> Text:
    if list_count(child_types) != 2 or list_get(child_types, 0) != list_get(child_types, 1): fail("YIR verifier: binary operands must have matching types")
    let operand_type: Text = list_get(child_types, 0)
    if expression.kind == "wrapping_binary":
        if (operand_type != "Number" and operand_type != "Int32") or (expression.value != "+" and expression.value != "-" and expression.value != "*"):
            fail("YIR verifier: wrapping arithmetic requires integer operands and +, -, or *")
        return operand_type
    if expression.value == "and" or expression.value == "or":
        if operand_type != "Boolean": fail("YIR verifier: logical operands must be Boolean")
        return "Boolean"
    if expression.value == "==" or expression.value == "!=":
        if not core_yir_equality_type(operand_type): fail("YIR verifier: equality is not defined for this type")
        return "Boolean"
    if expression.value == "<" or expression.value == ">" or expression.value == "<=" or expression.value == ">=":
        if not core_yir_numeric(operand_type) and operand_type != "Text" and operand_type != "Boolean": fail("YIR verifier: ordered comparison requires numeric, Boolean, or Text operands")
        return "Boolean"
    if expression.value == "+" and operand_type == "Text": return "Text"
    if not core_yir_numeric(operand_type) or (operand_type == "Float64" and expression.value == "%") or (expression.value != "+" and expression.value != "-" and expression.value != "*" and expression.value != "/" and expression.value != "%"):
        fail("YIR verifier: invalid arithmetic operator or operand type")
    return operand_type

fn core_yir_verify_expr(expression: YirExpr, functions: List[YirFunction], shapes: List[HirShape], variants: List[HirVariant]) -> Text:
    if expression.source_line < 1 or expression.source_column < 1 or expression.source_end_column < expression.source_column:
        fail("YIR verifier: expression has an invalid source span")
    if not core_yir_known_type(expression.value_type, shapes, variants):
        fail("YIR verifier: expression has unsupported result type '" + expression.value_type + "'" + core_yir_source_location(expression.source_file, expression.source_line, expression.source_column, expression.source_end_column))
    let child_types: List[Text] = List[Text]()
    var child_index: Number = 0
    while child_index < list_count(expression.children):
        list_push(child_types, core_yir_verify_expr(list_get(expression.children, child_index), functions, shapes, variants))
        set child_index = child_index + 1
    let child_count: Number = list_count(child_types)
    if expression.kind == "call" and (expression.value == "list_read_view" or expression.value == "list_read_view_prefix" or expression.value == "list_view_get" or expression.value == "list_view_count" or expression.value == "list_view_end"):
        return core_yir_verify_list_view_call(expression, child_types)
    if expression.kind == "list_try_create":
        let success_type: Text = core_yir_result_argument_type(expression.value_type, 0)
        let error_type: Text = core_yir_result_argument_type(expression.value_type, 1)
        if child_count != 0 or expression.value != success_type or core_yir_list_element_type(success_type) == "" or not core_yir_known_type(success_type, shapes, variants) or error_type != "Text":
            fail("YIR verifier: malformed fallible List constructor" + core_yir_yir_expression_location(expression))
        return expression.value_type
    if expression.kind == "list_try_literal":
        let success_type: Text = core_yir_result_argument_type(expression.value_type, 0)
        let error_type: Text = core_yir_result_argument_type(expression.value_type, 1)
        let item_type: Text = core_yir_list_element_type(success_type)
        if expression.value != success_type or item_type == "" or not core_yir_known_type(success_type, shapes, variants) or error_type != "Text":
            fail("YIR verifier: malformed fallible List literal" + core_yir_yir_expression_location(expression))
        var item_index: Number = 0
        while item_index < child_count:
            if list_get(child_types, item_index) != item_type: fail("YIR verifier: fallible List literal item type mismatch" + core_yir_yir_expression_location(expression))
            set item_index = item_index + 1
        return expression.value_type
    if expression.kind == "fallible_interpolate":
        if core_yir_result_argument_type(expression.value_type, 0) != "Text" or core_yir_result_argument_type(expression.value_type, 1) != "Text": fail("YIR verifier: malformed fallible interpolation Result type" + core_yir_yir_expression_location(expression))
        var interpolation_index: Number = 0
        while interpolation_index < child_count:
            if not core_yir_interpolated_type(list_get(child_types, interpolation_index)): fail("YIR verifier: fallible interpolation child has an unsupported type" + core_yir_yir_expression_location(expression))
            set interpolation_index = interpolation_index + 1
        return expression.value_type
    if expression.kind == "fallible_list_try_get":
        let success_type: Text = core_yir_result_argument_type(expression.value_type, 0)
        let item_type: Text = core_yir_option_payload_type(success_type)
        if child_count != 2 or expression.value != success_type or core_yir_result_argument_type(expression.value_type, 1) != "Text" or item_type == "" or not core_yir_known_type(item_type, shapes, variants) or core_yir_list_element_type(list_get(child_types, 0)) != item_type or list_get(child_types, 1) != "Number":
            fail("YIR verifier: malformed fallible List read Result" + core_yir_yir_expression_location(expression))
        return expression.value_type
    var inferred_type: Text = ""

    if expression.kind == "number":
        if child_count != 0 or not core_yir_signed_number_literal_valid(expression.value): fail("YIR verifier: malformed or out-of-range Number literal")
        set inferred_type = "Number"
    else:
        if expression.kind == "float":
            if child_count != 0 or not core_yir_float_literal_valid(expression.value): fail("YIR verifier: malformed Float64 literal")
            set inferred_type = "Float64"
        else:
            if expression.kind == "text":
                if child_count != 0: fail("YIR verifier: malformed Text literal")
                set inferred_type = "Text"
            else:
                if expression.kind == "boolean":
                    if child_count != 0 or (expression.value != "true" and expression.value != "false"): fail("YIR verifier: malformed Boolean literal")
                    set inferred_type = "Boolean"
                else:
                    if expression.kind == "unit":
                        if child_count != 0: fail("YIR verifier: malformed Unit expression")
                        set inferred_type = "Unit"
                    else:
                        if expression.kind == "interpolate":
                            var interpolation_index: Number = 0
                            while interpolation_index < child_count:
                                if not core_yir_interpolated_type(list_get(child_types, interpolation_index)): fail("YIR verifier: interpolation child has an unsupported type")
                                set interpolation_index = interpolation_index + 1
                            set inferred_type = "Text"
                        else:
                            if expression.kind == "variable":
                                if child_count != 0 or expression.value == "": fail("YIR verifier: malformed variable reference")
                                set inferred_type = expression.value_type
                            else:
                                if expression.kind == "option_none":
                                    if child_count != 0 or core_yir_option_payload_type(expression.value_type) == "": fail("YIR verifier: malformed Option.none")
                                    set inferred_type = expression.value_type
                                else:
                                    if expression.kind == "fallible_sum" or expression.kind == "fallible_variant" or expression.kind == "option_some":
                                        if expression.kind == "fallible_sum":
                                            if child_count != 1 or core_yir_result_argument_type(expression.value_type, 0) != expression.value or core_yir_result_argument_type(expression.value_type, 1) != "Text" or not core_yir_known_type(expression.value, shapes, variants): fail("YIR verifier: malformed fallible sum constructor")
                                            var fallible_payload_type: Text = ""
                                            if expression.value2 == "some":
                                                set fallible_payload_type = core_yir_option_payload_type(expression.value)
                                                if fallible_payload_type == "Unit": fail("YIR verifier: Option payload cannot be Unit")
                                            else:
                                                if expression.value2 == "ok": set fallible_payload_type = core_yir_result_argument_type(expression.value, 0)
                                                else:
                                                    if expression.value2 == "err": set fallible_payload_type = core_yir_result_argument_type(expression.value, 1)
                                            if fallible_payload_type == "" or list_get(child_types, 0) != fallible_payload_type: fail("YIR verifier: fallible sum payload type mismatch")
                                        else:
                                            if expression.kind == "fallible_variant":
                                                if core_yir_result_argument_type(expression.value_type, 0) != expression.value or core_yir_result_argument_type(expression.value_type, 1) != "Text": fail("YIR verifier: malformed fallible variant Result context")
                                                let variant_index: Number = core_yir_find_variant(variants, expression.value)
                                                if variant_index < 0: fail("YIR verifier: unknown fallible variant type")
                                                else:
                                                    let variant: HirVariant = list_get(variants, variant_index)
                                                    let case_index: Number = number_parse(expression.value2)
                                                    if case_index < 0 or case_index >= list_count(variant.cases) or number_text(case_index) != expression.value2: fail("YIR verifier: invalid fallible variant tag")
                                                    else:
                                                        let variant_case: HirVariantCase = list_get(variant.cases, case_index)
                                                        if child_count != list_count(variant_case.fields): fail("YIR verifier: fallible variant payload count mismatch")
                                                        var variant_payload_index: Number = 0
                                                        while variant_payload_index < child_count and variant_payload_index < list_count(variant_case.fields):
                                                            if list_get(child_types, variant_payload_index) != list_get(variant_case.fields, variant_payload_index).value_type: fail("YIR verifier: fallible variant payload type mismatch")
                                                            set variant_payload_index = variant_payload_index + 1
                                            else:
                                                if child_count != 1 or core_yir_option_payload_type(expression.value_type) != list_get(child_types, 0): fail("YIR verifier: malformed Option.some payload")
                                        set inferred_type = expression.value_type
                                    else:
                                        if expression.kind == "result_ok" or expression.kind == "result_err":
                                            if child_count != 1 or core_yir_result_argument_type(expression.value_type, 0) == "" or core_yir_result_argument_type(expression.value_type, 1) == "": fail("YIR verifier: malformed Result constructor")
                                            var result_payload_index: Number = 0
                                            if expression.kind == "result_err": set result_payload_index = 1
                                            if list_get(child_types, 0) != core_yir_result_argument_type(expression.value_type, result_payload_index): fail("YIR verifier: Result payload type mismatch")
                                            set inferred_type = expression.value_type
                                        else:
                                            if expression.kind == "option_is_some" or expression.kind == "option_unwrap":
                                                if child_count != 1 or core_yir_option_payload_type(list_get(child_types, 0)) == "": fail("YIR verifier: Option operation requires one Option value")
                                                if expression.kind == "option_is_some": set inferred_type = "Boolean"
                                                else:
                                                    set inferred_type = core_yir_option_payload_type(list_get(child_types, 0))
                                                    if expression.value2 != core_yir_option_unwrap_error_type(inferred_type, shapes, variants): fail("YIR verifier: Option unwrap error type metadata mismatch")
                                            else:
                                                if expression.kind == "result_is_ok" or expression.kind == "result_unwrap" or expression.kind == "result_unwrap_error":
                                                    if child_count != 1 or core_yir_result_argument_type(list_get(child_types, 0), 0) == "" or core_yir_result_argument_type(list_get(child_types, 0), 1) == "": fail("YIR verifier: Result operation requires one Result value")
                                                    if expression.kind == "result_is_ok": set inferred_type = "Boolean"
                                                    else:
                                                        var result_index: Number = 0
                                                        if expression.kind == "result_unwrap_error": set result_index = 1
                                                        set inferred_type = core_yir_result_argument_type(list_get(child_types, 0), result_index)
                                                else:
                                                    if expression.kind == "unary" or expression.kind == "move" or expression.kind == "borrow" or expression.kind == "borrow_mut" or expression.kind == "await" or expression.kind == "spawn":
                                                        if child_count != 1: fail("YIR verifier: unary operation requires one operand")
                                                        if expression.kind == "move": set inferred_type = list_get(child_types, 0)
                                                        else:
                                                            if expression.kind == "spawn": set inferred_type = "Task[" + list_get(child_types, 0) + "]"
                                                            else:
                                                                if expression.kind == "await":
                                                                    let child_t: Text = list_get(child_types, 0)
                                                                    if text_starts_with(child_t, "Task[") and text_ends_with(child_t, "]"): set inferred_type = text_slice(child_t, 5, text_length(child_t) - 6)
                                                                    else:
                                                                        if text_starts_with(child_t, "Future[") and text_ends_with(child_t, "]"): set inferred_type = text_slice(child_t, 7, text_length(child_t) - 8)
                                                                        else:
                                                                            if child_t == "AsyncTask": set inferred_type = "Number"
                                                                            else: set inferred_type = child_t
                                                                else:
                                                                    if expression.kind == "borrow": set inferred_type = "&" + list_get(child_types, 0)
                                                                    else:
                                                                        if expression.kind == "borrow_mut": set inferred_type = "&mut " + list_get(child_types, 0)
                                                                        else:
                                                                            if expression.value == "-" and core_yir_numeric(list_get(child_types, 0)): set inferred_type = list_get(child_types, 0)
                                                                            else:
                                                                                if (expression.value == "!" or expression.value == "not") and list_get(child_types, 0) == "Boolean": set inferred_type = "Boolean"
                                                                                else: fail("YIR verifier: invalid unary operator or operand type")
                                                    else:
                                                        if expression.kind == "binary" or expression.kind == "wrapping_binary":
                                                            set inferred_type = core_yir_verify_binary_expr(expression, child_types)
                                                        else:
                                                            if expression.kind == "field":
                                                                if child_count != 1: fail("YIR verifier: field access requires one base value")
                                                                var base_shape_type: Text = list_get(child_types, 0)
                                                                if core_yir_is_borrow_type(base_shape_type) or core_yir_is_move_type(base_shape_type):
                                                                    set base_shape_type = core_yir_base_type(base_shape_type)
                                                                let shape_index: Number = core_yir_find_shape(shapes, base_shape_type)
                                                                if shape_index < 0: fail("YIR verifier: field access base is not a shape")
                                                                let field_index: Number = number_parse(expression.value)
                                                                if field_index < 0 or field_index >= list_count(list_get(shapes, shape_index).fields) or number_text(field_index) != expression.value: fail("YIR verifier: invalid shape field index")
                                                                set inferred_type = list_get(list_get(shapes, shape_index).fields, field_index).value_type
                                                            else:
                                                                if expression.kind == "index":
                                                                    if child_count != 2 or list_get(child_types, 0) != expression.value or list_get(child_types, 1) != "Number": fail("YIR verifier: malformed collection index")
                                                                    set inferred_type = core_yir_list_element_type(expression.value)
                                                                    if inferred_type == "": fail("YIR verifier: index source is not a supported list")
                                                                else:
                                                                    if expression.kind == "list_create":
                                                                        if child_count != 0 or expression.value != expression.value_type or core_yir_list_element_type(expression.value_type) == "": fail("YIR verifier: malformed list constructor")
                                                                        set inferred_type = expression.value_type
                                                                    else:
                                                                        if expression.kind == "list_literal":
                                                                            let item_type: Text = core_yir_list_element_type(expression.value_type)
                                                                            if expression.value != expression.value_type or item_type == "": fail("YIR verifier: malformed collection literal type")
                                                                            var item_index: Number = 0
                                                                            while item_index < child_count:
                                                                                if list_get(child_types, item_index) != item_type: fail("YIR verifier: collection literal element type mismatch")
                                                                                set item_index = item_index + 1
                                                                            set inferred_type = expression.value_type
                                                                        else:
                                                                            if expression.kind == "shape_create":
                                                                                let shape_index: Number = core_yir_find_shape(shapes, expression.value)
                                                                                if shape_index < 0 or expression.value_type != expression.value: fail("YIR verifier: unknown or malformed shape constructor")
                                                                                let shape: HirShape = list_get(shapes, shape_index)
                                                                                if child_count != list_count(shape.fields): fail("YIR verifier: shape constructor field count mismatch")
                                                                                var field_index: Number = 0
                                                                                while field_index < child_count:
                                                                                    if list_get(child_types, field_index) != list_get(shape.fields, field_index).value_type: fail("YIR verifier: shape constructor field type mismatch")
                                                                                    set field_index = field_index + 1
                                                                                set inferred_type = shape.name
                                                                            else:
                                                                                if expression.kind == "variant_create":
                                                                                    let variant_index: Number = core_yir_find_variant(variants, expression.value_type)
                                                                                    if variant_index < 0: fail("YIR verifier: unknown variant constructor type")
                                                                                    let case_index: Number = number_parse(expression.value)
                                                                                    let variant: HirVariant = list_get(variants, variant_index)
                                                                                    if case_index < 0 or case_index >= list_count(variant.cases) or number_text(case_index) != expression.value: fail("YIR verifier: invalid variant constructor tag")
                                                                                    let variant_case: HirVariantCase = list_get(variant.cases, case_index)
                                                                                    if child_count != list_count(variant_case.fields): fail("YIR verifier: variant payload count mismatch")
                                                                                    var payload_index: Number = 0
                                                                                    while payload_index < child_count:
                                                                                        if list_get(child_types, payload_index) != list_get(variant_case.fields, payload_index).value_type: fail("YIR verifier: variant payload type mismatch")
                                                                                        set payload_index = payload_index + 1
                                                                                    set inferred_type = variant.name
                                                                                else:
                                                                                    if expression.kind == "list_count" or expression.kind == "list_push" or expression.kind == "list_try_push" or expression.kind == "list_try_reserve" or expression.kind == "list_get" or expression.kind == "list_try_get" or expression.kind == "list_set" or expression.kind == "list_try_set":
                                                                                        let collection_type: Text = core_yir_list_element_type(expression.value)
                                                                                        if collection_type == "" or child_count < 1 or list_get(child_types, 0) != expression.value: fail("YIR verifier: malformed List operation collection")
                                                                                        if expression.kind == "list_count":
                                                                                            if child_count != 1: fail("YIR verifier: list_count arity mismatch")
                                                                                            set inferred_type = "Number"
                                                                                        else:
                                                                                            if expression.kind == "list_push" or expression.kind == "list_try_push":
                                                                                                if child_count != 2 or list_get(child_types, 1) != collection_type: fail("YIR verifier: list_push element type mismatch")
                                                                                                if expression.kind == "list_try_push": set inferred_type = "Boolean"
                                                                                                else: set inferred_type = "Number"
                                                                                            else:
                                                                                                if expression.kind == "list_try_reserve":
                                                                                                    if child_count != 2 or list_get(child_types, 1) != "Number": fail("YIR verifier: list_try_reserve signature mismatch")
                                                                                                    set inferred_type = "Boolean"
                                                                                                else:
                                                                                                    if expression.kind == "list_set" or expression.kind == "list_try_set":
                                                                                                        if child_count != 3 or list_get(child_types, 1) != "Number" or list_get(child_types, 2) != collection_type: fail("YIR verifier: " + expression.kind + " signature mismatch")
                                                                                                        if expression.kind == "list_try_set": set inferred_type = "Boolean"
                                                                                                        else: set inferred_type = "Number"
                                                                                                    else:
                                                                                                        if child_count != 2 or list_get(child_types, 1) != "Number": fail("YIR verifier: List read signature mismatch")
                                                                                                        if expression.kind == "list_get": set inferred_type = collection_type
                                                                                                        else: set inferred_type = "Option[" + collection_type + "]"
                                                                                    else:
                                                                                        if expression.kind == "try" or expression.kind == "try_return":
                                                                                            if child_count != 1: fail("YIR verifier: postfix ? requires one Result expression")
                                                                                            let source_success: Text = core_yir_result_argument_type(list_get(child_types, 0), 0)
                                                                                            let source_error: Text = core_yir_result_argument_type(list_get(child_types, 0), 1)
                                                                                            let target_success: Text = core_yir_result_argument_type(expression.value, 0)
                                                                                            let target_error: Text = core_yir_result_argument_type(expression.value, 1)
                                                                                            if source_success == "" or source_error == "" or target_success == "" or target_error == "": fail("YIR verifier: postfix ? Result types are incompatible")
                                                                                            if expression.kind == "try" and expression.value_type != source_success: fail("YIR verifier: postfix ? success type mismatch")
                                                                                            if expression.kind == "try_return" and source_success != target_success: fail("YIR verifier: postfix ? return success type mismatch")
                                                                                            if expression.value2 == "" and source_error != target_error: fail("YIR verifier: postfix ? is missing its error conversion")
                                                                                            if expression.value2 != "":
                                                                                                let conversion_index: Number = core_yir_find_lowered_function(functions, expression.value2)
                                                                                                if conversion_index < 0: fail("YIR verifier: postfix ? conversion function is missing")
                                                                                                let conversion: YirFunction = list_get(functions, conversion_index)
                                                                                                if list_count(conversion.parameters) != 1 or list_get(conversion.parameters, 0).value_type != source_error or conversion.return_type != target_error: fail("YIR verifier: postfix ? conversion signature mismatch")
                                                                                            if expression.kind == "try": set inferred_type = source_success
                                                                                            else:
                                                                                                if expression.value_type != expression.value: fail("YIR verifier: postfix ? return node has inconsistent result type")
                                                                                                set inferred_type = expression.value_type
                                                                                        else:
                                                                                            if expression.kind == "call":
                                                                                                set inferred_type = core_yir_verify_call(expression, child_types, functions)
                                                                                            else: fail("YIR verifier: unknown expression instruction '" + expression.kind + "'")

    if inferred_type == "" or inferred_type != expression.value_type:
        fail("YIR verifier: recorded expression type '" + expression.value_type + "' disagrees with inferred type '" + inferred_type + "'" + core_yir_source_location(expression.source_file, expression.source_line, expression.source_column, expression.source_end_column))
    return inferred_type

fn core_yir_verify_expr_scope(expression: YirExpr, slots: TextList, types: TextList, visible: Number) -> Number:
    if expression.kind == "variable":
        var slot_index: Number = visible - 1
        while slot_index >= 0:
            if list_get(slots, slot_index) == expression.value:
                if list_get(types, slot_index) != expression.value_type: fail("YIR verifier: variable slot type mismatch for '" + expression.value + "'" + core_yir_source_location(expression.source_file, expression.source_line, expression.source_column, expression.source_end_column))
                return 0
            set slot_index = slot_index - 1
        fail("YIR verifier: variable refers to an inactive or unknown slot '" + expression.value + "'" + core_yir_source_location(expression.source_file, expression.source_line, expression.source_column, expression.source_end_column))
    var child_index: Number = 0
    while child_index < list_count(expression.children):
        core_yir_verify_expr_scope(list_get(expression.children, child_index), slots, types, visible)
        set child_index = child_index + 1
    return 0

fn core_yir_verify_scoped_expr(expression: YirExpr, functions: List[YirFunction], shapes: List[HirShape], variants: List[HirVariant], slots: TextList, types: TextList, visible: Number) -> Text:
    let result_type: Text = core_yir_verify_expr(expression, functions, shapes, variants)
    core_yir_verify_expr_scope(expression, slots, types, visible)
    return result_type

fn core_yir_verify_find_slot(slots: TextList, visible: Number, sought: Text) -> Number:
    var slot_index: Number = visible - 1
    while slot_index >= 0:
        if list_get(slots, slot_index) == sought: return slot_index
        set slot_index = slot_index - 1
    return -1

fn core_yir_verify_bind(names: TextList, slots: TextList, types: TextList, mutabilities: TextList, visible: Number, name: Text, slot: Text, value_type: Text, mutability: Text, shapes: List[HirShape], variants: List[HirVariant], source_location: Text) -> Number:
    if name != "" and core_yir_visible_index(names, visible, name) >= 0: fail("YIR verifier: duplicate active local '" + name + "'" + source_location)
    if slot == "" or value_type == "Unit" or not core_yir_known_type(value_type, shapes, variants): fail("YIR verifier: malformed local slot or type" + source_location)
    if core_yir_verify_find_slot(slots, visible, slot) >= 0: fail("YIR verifier: duplicate active slot '" + slot + "'" + source_location)
    if mutability != "let" and mutability != "var": fail("YIR verifier: invalid local mutability" + source_location)
    core_yir_bind_local(names, slots, types, mutabilities, visible, name, slot, value_type, mutability)
    return visible + 1

fn core_yir_verify_match_arm(arm: YirMatchArm, matched_type: Text, expected_type: Text, expression_mode: Boolean, functions: List[YirFunction], shapes: List[HirShape], variants: List[HirVariant], names: TextList, slots: TextList, types: TextList, mutabilities: TextList, visible: Number, return_type: Text, loop_depth: Number, inside_function: Boolean) -> Number:
    if core_yir_expression_opens_list_view(arm.pattern_value) or core_yir_expression_opens_list_view(arm.result_expression): fail("YIR verifier: ListView creation must initialize a local binding" + core_yir_yir_match_arm_location(arm))
    let numeric_match: Boolean = core_yir_numeric(matched_type)
    let option_payload: Text = core_yir_option_payload_type(matched_type)
    let result_success: Text = core_yir_result_argument_type(matched_type, 0)
    let result_error: Text = core_yir_result_argument_type(matched_type, 1)
    let builtin_match: Boolean = option_payload != "" or (result_success != "" and result_error != "")
    let variant_index: Number = core_yir_find_variant(variants, matched_type)
    var expected_tag: Number = -1
    var expected_payload_count: Number = 0
    if numeric_match:
        if not expression_mode: fail("YIR verifier: block match cannot inspect numeric values" + core_yir_yir_match_arm_location(arm))
        if arm.case_name == "else":
            if arm.pattern_operator != "" or list_count(arm.bindings) != 0: fail("YIR verifier: malformed numeric match else arm" + core_yir_yir_match_arm_location(arm))
        else:
            if arm.pattern_operator != "<" and arm.pattern_operator != ">" and arm.pattern_operator != "<=" and arm.pattern_operator != ">=" and arm.pattern_operator != "==" and arm.pattern_operator != "!=": fail("YIR verifier: malformed numeric match guard" + core_yir_yir_match_arm_location(arm))
            if not core_yir_numeric(core_yir_verify_scoped_expr(arm.pattern_value, functions, shapes, variants, slots, types, visible)): fail("YIR verifier: numeric match guard is not numeric" + core_yir_yir_match_arm_location(arm))
        if arm.tag != -1: fail("YIR verifier: numeric match arm must not have a variant tag" + core_yir_yir_match_arm_location(arm))
    else:
        if arm.pattern_operator != "": fail("YIR verifier: sum-type match arm cannot use a numeric guard" + core_yir_yir_match_arm_location(arm))
        if builtin_match:
            set expected_tag = core_yir_builtin_match_case_tag(matched_type, arm.case_name)
            if core_yir_builtin_match_payload_type(matched_type, arm.case_name) != "": set expected_payload_count = 1
        else:
            if variant_index < 0: fail("YIR verifier: match subject is not a supported sum type" + core_yir_yir_match_arm_location(arm))
            let variant: HirVariant = list_get(variants, variant_index)
            set expected_tag = core_yir_find_variant_case(variant, arm.case_name)
            if expected_tag >= 0: set expected_payload_count = list_count(list_get(variant.cases, expected_tag).fields)
        if expected_tag < 0 or arm.tag != expected_tag: fail("YIR verifier: match arm tag does not match case '" + arm.case_name + "'" + core_yir_yir_match_arm_location(arm))
    var arm_visible: Number = visible
    var binding_index: Number = 0
    while binding_index < list_count(arm.bindings):
        let binding: YirMatchBinding = list_get(arm.bindings, binding_index)
        if binding.field_index < 0 or binding.field_index >= expected_payload_count: fail("YIR verifier: match binding field index is out of range" + core_yir_yir_match_arm_location(arm))
        var expected_field_type: Text = ""
        if builtin_match:
            set expected_field_type = core_yir_builtin_match_payload_type(matched_type, arm.case_name)
        else:
            let matched_variant: HirVariant = list_get(variants, variant_index)
            let matched_case: HirVariantCase = list_get(matched_variant.cases, expected_tag)
            set expected_field_type = list_get(matched_case.fields, binding.field_index).value_type
        if binding.value_type != expected_field_type: fail("YIR verifier: match binding type does not match its payload field" + core_yir_yir_match_arm_location(arm))
        var prior_binding: Number = 0
        while prior_binding < binding_index:
            if list_get(arm.bindings, prior_binding).field_index == binding.field_index or list_get(arm.bindings, prior_binding).slot == binding.slot: fail("YIR verifier: duplicate match binding" + core_yir_yir_match_arm_location(arm))
            set prior_binding = prior_binding + 1
        set arm_visible = core_yir_verify_bind(names, slots, types, mutabilities, arm_visible, "", binding.slot, binding.value_type, "let", shapes, variants, core_yir_yir_match_arm_location(arm))
        set binding_index = binding_index + 1
    if expression_mode:
        if list_count(arm.body) != 0: fail("YIR verifier: match expression arm contains statements" + core_yir_yir_match_arm_location(arm))
        if core_yir_expression_opens_list_view(arm.pattern_value) or core_yir_expression_opens_list_view(arm.result_expression): fail("YIR verifier: ListView creation must initialize a local binding" + core_yir_yir_match_arm_location(arm))
        if core_yir_verify_scoped_expr(arm.result_expression, functions, shapes, variants, slots, types, arm_visible) != expected_type: fail("YIR verifier: match expression arm result type mismatch" + core_yir_source_location(arm.result_expression.source_file, arm.result_expression.source_line, arm.result_expression.source_column, arm.result_expression.source_end_column))
    else:
        if arm.result_expression.kind != "unit" or arm.result_expression.value_type != "Unit": fail("YIR verifier: block match arm has an unexpected result expression" + core_yir_yir_match_arm_location(arm))
        if list_count(arm.body) == 0: fail("YIR verifier: block match arm body cannot be empty" + core_yir_yir_match_arm_location(arm))
        core_yir_verify_block(arm.body, functions, shapes, variants, names, slots, types, mutabilities, arm_visible, return_type, loop_depth, inside_function)
    return 0

fn core_yir_verify_block(block: List[YirStatement], functions: List[YirFunction], shapes: List[HirShape], variants: List[HirVariant], names: TextList, slots: TextList, types: TextList, mutabilities: TextList, visible_start: Number, return_type: Text, loop_depth: Number, inside_function: Boolean) -> Number:
    var visible: Number = visible_start
    var statement_index: Number = 0
    while statement_index < list_count(block):
        let statement: YirStatement = list_get(block, statement_index)
        if statement.kind == "let" or statement.kind == "var":
            let view_item_type: Text = core_yir_list_view_element_type(statement.value_type)
            if view_item_type != "":
                if statement.kind != "let" or statement.expression.kind != "call" or (statement.expression.value != "list_read_view" and statement.expression.value != "list_read_view_prefix"): fail("YIR verifier: ListView local must be immutable and initialized directly by a ListView constructor" + core_yir_yir_statement_location(statement))
            else:
                if core_yir_type_contains_list_view(statement.value_type): fail("YIR verifier: ListView cannot be stored inside another value" + core_yir_yir_statement_location(statement))
                if core_yir_expression_opens_list_view(statement.expression): fail("YIR verifier: ListView creation must initialize a ListView local" + core_yir_yir_statement_location(statement))
        else:
            if core_yir_expression_opens_list_view(statement.expression) or core_yir_expression_opens_list_view(statement.expression2): fail("YIR verifier: ListView creation must initialize a local binding" + core_yir_yir_statement_location(statement))
        var handled: Boolean = false
        if statement.kind == "let" or statement.kind == "var":
            if core_yir_verify_scoped_expr(statement.expression, functions, shapes, variants, slots, types, visible) != statement.value_type: fail("YIR verifier: local initializer type mismatch" + core_yir_yir_statement_location(statement))
            set visible = core_yir_verify_bind(names, slots, types, mutabilities, visible, statement.name, statement.slot, statement.value_type, statement.kind, shapes, variants, core_yir_yir_statement_location(statement))
            set handled = true
        if statement.kind == "match_expr":
            let matched_type: Text = core_yir_verify_scoped_expr(statement.expression, functions, shapes, variants, slots, types, visible)
            if statement.slot2 != "return" and statement.slot2 != "let" and statement.slot2 != "var" and statement.slot2 != "set": fail("YIR verifier: invalid match expression destination" + core_yir_yir_statement_location(statement))
            if statement.slot2 == "return":
                if return_type == "Unit" or statement.value_type != return_type: fail("YIR verifier: match return type mismatch" + core_yir_yir_statement_location(statement))
            else:
                if statement.slot2 == "set":
                    let target_index: Number = core_yir_verify_find_slot(slots, visible, statement.slot)
                    if target_index < 0 or list_get(mutabilities, target_index) != "var" or list_get(types, target_index) != statement.value_type: fail("YIR verifier: match assignment target is invalid" + core_yir_yir_statement_location(statement))
                else:
                    if statement.name == "" or statement.slot == "" or statement.value_type == "Unit" or core_yir_type_contains_list_view(statement.value_type) or not core_yir_known_type(statement.value_type, shapes, variants): fail("YIR verifier: malformed match declaration" + core_yir_yir_statement_location(statement))
            var arm_index: Number = 0
            var saw_else: Boolean = false
            var numeric_guard_count: Number = 0
            let seen_tags: List[Number] = List[Number]()
            while arm_index < list_count(statement.match_arms):
                let arm: YirMatchArm = list_get(statement.match_arms, arm_index)
                if core_yir_numeric(matched_type):
                    if arm.case_name == "else":
                        if arm_index == 0 or arm_index + 1 != list_count(statement.match_arms) or saw_else: fail("YIR verifier: numeric match else arm must be last and follow a guard" + core_yir_yir_match_arm_location(arm))
                        set saw_else = true
                    else:
                        if saw_else: fail("YIR verifier: numeric match arm follows else" + core_yir_yir_match_arm_location(arm))
                        set numeric_guard_count = numeric_guard_count + 1
                else:
                    var prior_tag_index: Number = 0
                    while prior_tag_index < list_count(seen_tags):
                        if list_get(seen_tags, prior_tag_index) == arm.tag: fail("YIR verifier: duplicate match case tag" + core_yir_yir_match_arm_location(arm))
                        set prior_tag_index = prior_tag_index + 1
                    list_push(seen_tags, arm.tag)
                core_yir_verify_match_arm(arm, matched_type, statement.value_type, true, functions, shapes, variants, names, slots, types, mutabilities, visible, return_type, loop_depth, inside_function)
                set arm_index = arm_index + 1
            if list_count(statement.match_arms) == 0: fail("YIR verifier: match expression has no arms" + core_yir_yir_statement_location(statement))
            if core_yir_numeric(matched_type):
                if not saw_else or numeric_guard_count == 0: fail("YIR verifier: numeric match requires guards and a final else" + core_yir_yir_statement_location(statement))
            else:
                var expected_cases: Number = 0
                if core_yir_option_payload_type(matched_type) != "" or core_yir_result_argument_type(matched_type, 0) != "": set expected_cases = 2
                else:
                    let variant_index: Number = core_yir_find_variant(variants, matched_type)
                    if variant_index < 0: fail("YIR verifier: match expression subject is not matchable" + core_yir_yir_statement_location(statement))
                    set expected_cases = list_count(list_get(variants, variant_index).cases)
                if list_count(seen_tags) != expected_cases: fail("YIR verifier: match expression is not exhaustive" + core_yir_yir_statement_location(statement))
            if statement.slot2 == "let" or statement.slot2 == "var":
                set visible = core_yir_verify_bind(names, slots, types, mutabilities, visible, statement.name, statement.slot, statement.value_type, statement.slot2, shapes, variants, core_yir_yir_statement_location(statement))
            set handled = true
        if statement.kind == "set":
            let target_index: Number = core_yir_verify_find_slot(slots, visible, statement.slot)
            if target_index < 0 or list_get(mutabilities, target_index) != "var": fail("YIR verifier: set target is unknown or immutable" + core_yir_yir_statement_location(statement))
            if statement.value_type != list_get(types, target_index) or core_yir_verify_scoped_expr(statement.expression, functions, shapes, variants, slots, types, visible) != list_get(types, target_index): fail("YIR verifier: set value type mismatch" + core_yir_yir_statement_location(statement))
            set handled = true
        if statement.kind == "set_field":
            let target_index: Number = core_yir_verify_find_slot(slots, visible, statement.slot)
            if target_index < 0 or list_get(mutabilities, target_index) != "var" or core_yir_base_type(list_get(types, target_index)) != core_yir_base_type(statement.name): fail("YIR verifier: field update target is invalid" + core_yir_yir_statement_location(statement))
            if list_count(statement.field_path) == 0: fail("YIR verifier: field update path is empty" + core_yir_yir_statement_location(statement))
            var current_type: Text = statement.name
            var path_index: Number = 0
            while path_index < list_count(statement.field_path):
                let step: YirFieldPathStep = list_get(statement.field_path, path_index)
                if step.parent_type != current_type: fail("YIR verifier: field update path parent type is invalid" + core_yir_yir_statement_location(statement))
                let shape_index: Number = core_yir_find_shape(shapes, current_type)
                if shape_index < 0: fail("YIR verifier: field update path traverses a non-shape type" + core_yir_yir_statement_location(statement))
                let shape: HirShape = list_get(shapes, shape_index)
                if step.field_index < 0 or step.field_index >= list_count(shape.fields): fail("YIR verifier: field update index is invalid" + core_yir_yir_statement_location(statement))
                let declared_field: HirField = list_get(shape.fields, step.field_index)
                if declared_field.name != step.field_name or declared_field.value_type != step.field_type: fail("YIR verifier: field update metadata does not match the shape" + core_yir_yir_statement_location(statement))
                if path_index + 1 < list_count(statement.field_path) and core_yir_find_shape(shapes, step.field_type) < 0: fail("YIR verifier: nested field update path traverses a non-shape type" + core_yir_yir_statement_location(statement))
                set current_type = step.field_type
                set path_index = path_index + 1
            if statement.value_type != current_type or core_yir_verify_scoped_expr(statement.expression, functions, shapes, variants, slots, types, visible) != current_type: fail("YIR verifier: field update type mismatch" + core_yir_yir_statement_location(statement))
            set handled = true
        if statement.kind == "say":
            if not core_yir_printable_type(core_yir_verify_scoped_expr(statement.expression, functions, shapes, variants, slots, types, visible)): fail("YIR verifier: say operand is not printable" + core_yir_source_location(statement.expression.source_file, statement.expression.source_line, statement.expression.source_column, statement.expression.source_end_column))
            set handled = true
        if statement.kind == "assert":
            if core_yir_verify_scoped_expr(statement.expression, functions, shapes, variants, slots, types, visible) != "Boolean": fail("YIR verifier: assert operand is not Boolean" + core_yir_source_location(statement.expression.source_file, statement.expression.source_line, statement.expression.source_column, statement.expression.source_end_column))
            set handled = true
        if statement.kind == "return":
            if not inside_function: fail("YIR verifier: return appears outside a function" + core_yir_source_location(statement.source_file, statement.source_line, statement.source_column, statement.source_end_column))
            if statement.expression.value_type != return_type or core_yir_verify_scoped_expr(statement.expression, functions, shapes, variants, slots, types, visible) != return_type: fail("YIR verifier: return expression type mismatch" + core_yir_source_location(statement.expression.source_file, statement.expression.source_line, statement.expression.source_column, statement.expression.source_end_column))
            set handled = true
        if statement.kind == "expression":
            core_yir_verify_scoped_expr(statement.expression, functions, shapes, variants, slots, types, visible)
            set handled = true
        if statement.kind == "defer":
            if statement.slot == "" or (statement.expression.kind != "call" and statement.expression.kind != "list_push" and statement.expression.kind != "list_set" and statement.expression.kind != "list_try_push" and statement.expression.kind != "list_try_set"): fail("YIR verifier: malformed defer" + core_yir_yir_statement_location(statement))
            if statement.expression.kind == "call" and statement.expression.value == "list_view_end":
                if not text_starts_with(statement.slot, "%defer.auto.") or list_count(statement.expression.children) != 1 or core_yir_list_view_element_type(list_get(statement.expression.children, 0).value_type) == "": fail("YIR verifier: ListView end must be the compiler-generated lexical cleanup" + core_yir_yir_statement_location(statement))
            let defer_type: Text = core_yir_verify_scoped_expr(statement.expression, functions, shapes, variants, slots, types, visible)
            if core_yir_result_argument_type(defer_type, 0) != "": fail("YIR verifier: deferred call cannot return Result" + core_yir_yir_statement_location(statement))
            set handled = true
        if statement.kind == "if":
            if list_count(statement.branches) == 0: fail("YIR verifier: if has no branches" + core_yir_yir_statement_location(statement))
            if statement.has_else and list_count(statement.alternate) == 0: fail("YIR verifier: else block cannot be empty" + core_yir_else_location(statement))
            if not statement.has_else and list_count(statement.alternate) != 0: fail("YIR verifier: unexpected alternate block without else" + core_yir_yir_statement_location(statement))
            var branch_index: Number = 0
            while branch_index < list_count(statement.branches):
                let branch: YirBranch = list_get(statement.branches, branch_index)
                if core_yir_expression_opens_list_view(branch.condition): fail("YIR verifier: ListView creation must initialize a local binding" + core_yir_branch_location(branch))
                if core_yir_verify_scoped_expr(branch.condition, functions, shapes, variants, slots, types, visible) != "Boolean": fail("YIR verifier: if condition is not Boolean" + core_yir_source_location(branch.condition.source_file, branch.condition.source_line, branch.condition.source_column, branch.condition.source_end_column))
                if list_count(branch.body) == 0: fail("YIR verifier: if branch body cannot be empty" + core_yir_branch_location(branch))
                core_yir_verify_block(branch.body, functions, shapes, variants, names, slots, types, mutabilities, visible, return_type, loop_depth, inside_function)
                set branch_index = branch_index + 1
            core_yir_verify_block(statement.alternate, functions, shapes, variants, names, slots, types, mutabilities, visible, return_type, loop_depth, inside_function)
            set handled = true
        if statement.kind == "arena_scope":
            if statement.slot == "" or not text_starts_with(statement.slot, "%arena.scope."): fail("YIR verifier: malformed arena_scope slot" + core_yir_yir_statement_location(statement))
            if core_yir_verify_scoped_expr(statement.expression, functions, shapes, variants, slots, types, visible) != "Number": fail("YIR verifier: arena_scope limit must be Number bytes" + core_yir_yir_statement_location(statement))
            if list_count(statement.body) == 0: fail("YIR verifier: arena_scope block cannot be empty" + core_yir_yir_statement_location(statement))
            core_yir_verify_block(statement.body, functions, shapes, variants, names, slots, types, mutabilities, visible, return_type, loop_depth, inside_function)
            set handled = true
        if statement.kind == "match":
            let matched_type: Text = core_yir_verify_scoped_expr(statement.expression, functions, shapes, variants, slots, types, visible)
            if core_yir_numeric(matched_type): fail("YIR verifier: block match cannot inspect numeric values" + core_yir_yir_statement_location(statement))
            var expected_cases: Number = 0
            if core_yir_option_payload_type(matched_type) != "" or core_yir_result_argument_type(matched_type, 0) != "": set expected_cases = 2
            else:
                let variant_index: Number = core_yir_find_variant(variants, matched_type)
                if variant_index < 0: fail("YIR verifier: block match subject is not matchable" + core_yir_yir_statement_location(statement))
                set expected_cases = list_count(list_get(variants, variant_index).cases)
            if list_count(statement.match_arms) != expected_cases: fail("YIR verifier: block match is not exhaustive" + core_yir_yir_statement_location(statement))
            let seen_tags: List[Number] = List[Number]()
            var arm_index: Number = 0
            while arm_index < list_count(statement.match_arms):
                let arm: YirMatchArm = list_get(statement.match_arms, arm_index)
                var prior_tag_index: Number = 0
                while prior_tag_index < list_count(seen_tags):
                    if list_get(seen_tags, prior_tag_index) == arm.tag: fail("YIR verifier: duplicate block match tag" + core_yir_yir_match_arm_location(arm))
                    set prior_tag_index = prior_tag_index + 1
                list_push(seen_tags, arm.tag)
                core_yir_verify_match_arm(arm, matched_type, "Unit", false, functions, shapes, variants, names, slots, types, mutabilities, visible, return_type, loop_depth, inside_function)
                set arm_index = arm_index + 1
            set handled = true
        if statement.kind == "while":
            if core_yir_verify_scoped_expr(statement.expression, functions, shapes, variants, slots, types, visible) != "Boolean": fail("YIR verifier: while condition is not Boolean" + core_yir_source_location(statement.expression.source_file, statement.expression.source_line, statement.expression.source_column, statement.expression.source_end_column))
            if list_count(statement.body) == 0: fail("YIR verifier: while body cannot be empty" + core_yir_yir_statement_location(statement))
            core_yir_verify_block(statement.body, functions, shapes, variants, names, slots, types, mutabilities, visible, return_type, loop_depth + 1, inside_function)
            set handled = true
        if statement.kind == "for_range":
            if core_yir_verify_scoped_expr(statement.expression, functions, shapes, variants, slots, types, visible) != "Number" or core_yir_verify_scoped_expr(statement.expression2, functions, shapes, variants, slots, types, visible) != "Number": fail("YIR verifier: range bounds must be Number" + core_yir_yir_statement_location(statement))
            if list_count(statement.body) == 0: fail("YIR verifier: range loop body cannot be empty" + core_yir_yir_statement_location(statement))
            let loop_visible: Number = core_yir_verify_bind(names, slots, types, mutabilities, visible, statement.name, statement.slot, "Number", "var", shapes, variants, core_yir_yir_statement_location(statement))
            core_yir_verify_block(statement.body, functions, shapes, variants, names, slots, types, mutabilities, loop_visible, return_type, loop_depth + 1, inside_function)
            set handled = true
        if statement.kind == "for_each":
            let collection_type: Text = core_yir_verify_scoped_expr(statement.expression, functions, shapes, variants, slots, types, visible)
            let item_type: Text = core_yir_iterable_element_type(collection_type)
            if item_type == "" or item_type != statement.value_type or statement.slot2 == "" or statement.slot2 == statement.slot: fail("YIR verifier: malformed for-each loop" + core_yir_yir_statement_location(statement))
            if list_count(statement.body) == 0: fail("YIR verifier: for-each loop body cannot be empty" + core_yir_yir_statement_location(statement))
            let item_visible: Number = core_yir_verify_bind(names, slots, types, mutabilities, visible, statement.name, statement.slot, item_type, "let", shapes, variants, core_yir_yir_statement_location(statement))
            let loop_visible: Number = core_yir_verify_bind(names, slots, types, mutabilities, item_visible, "", statement.slot2, "Number", "var", shapes, variants, core_yir_yir_statement_location(statement))
            core_yir_verify_block(statement.body, functions, shapes, variants, names, slots, types, mutabilities, loop_visible, return_type, loop_depth + 1, inside_function)
            set handled = true
        if statement.kind == "break" or statement.kind == "continue":
            if loop_depth <= 0: fail("YIR verifier: loop control appears outside a loop" + core_yir_source_location(statement.source_file, statement.source_line, statement.source_column, statement.source_end_column))
            set handled = true
        if not handled: fail("YIR verifier: unknown statement instruction '" + statement.kind + "'" + core_yir_yir_statement_location(statement))
        set statement_index = statement_index + 1
    return visible

fn core_yir_owner_has(owners: TextList, sought: Text) -> Boolean:
    var index: Number = 0
    while index < list_count(owners):
        if list_get(owners, index) == sought: return true
        set index = index + 1
    return false

fn core_yir_owner_copy(owners: TextList) -> TextList:
    let copied: TextList = text_list()
    var index: Number = 0
    while index < list_count(owners):
        list_push(copied, list_get(owners, index))
        set index = index + 1
    return copied

fn core_yir_owner_union(left: TextList, right: TextList) -> TextList:
    let result: TextList = core_yir_owner_copy(left)
    var index: Number = 0
    while index < list_count(right):
        let owner: Text = list_get(right, index)
        if not core_yir_owner_has(result, owner): list_push(result, owner)
        set index = index + 1
    return result

fn core_yir_owner_sets_equal(left: TextList, right: TextList) -> Boolean:
    if list_count(left) != list_count(right): return false
    var index: Number = 0
    while index < list_count(left):
        if not core_yir_owner_has(right, list_get(left, index)): return false
        set index = index + 1
    return true

fn core_yir_owner_encode(owners: TextList) -> Text:
    return text_join(owners, ",")

fn core_yir_owner_decode(encoded: Text) -> TextList:
    if encoded == "": return text_list()
    return text_split(encoded, ",")

fn core_yir_owner_type_inner(value_type: Text, shapes: List[HirShape], variants: List[HirVariant], depth: Number) -> Boolean:
    if depth > 16: return true
    if value_type == "Text" or value_type == "Bytes" or value_type == "TextList" or core_yir_list_element_type(value_type) != "": return true
    if core_yir_option_payload_type(value_type) != "" or core_yir_result_argument_type(value_type, 0) != "": return true
    let shape_index: Number = core_yir_find_shape(shapes, value_type)
    if shape_index >= 0:
        let shape: HirShape = list_get(shapes, shape_index)
        var field_index: Number = 0
        while field_index < list_count(shape.fields):
            if core_yir_owner_type_inner(list_get(shape.fields, field_index).value_type, shapes, variants, depth + 1): return true
            set field_index = field_index + 1
    let variant_index: Number = core_yir_find_variant(variants, value_type)
    if variant_index >= 0:
        let variant: HirVariant = list_get(variants, variant_index)
        var case_index: Number = 0
        while case_index < list_count(variant.cases):
            let variant_case: HirVariantCase = list_get(variant.cases, case_index)
            # LLVM stores every non-empty variant payload behind an arena pointer.
            if list_count(variant_case.fields) > 0: return true
            set case_index = case_index + 1
    return false

fn core_yir_owner_type(value_type: Text, shapes: List[HirShape], variants: List[HirVariant]) -> Boolean:
    return core_yir_owner_type_inner(value_type, shapes, variants, 0)

fn core_yir_owner_aggregate_type(value_type: Text, shapes: List[HirShape], variants: List[HirVariant]) -> Boolean:
    return core_yir_find_shape(shapes, value_type) >= 0 or core_yir_option_payload_type(value_type) != "" or core_yir_result_argument_type(value_type, 0) != "" or core_yir_find_variant(variants, value_type) >= 0

fn core_yir_owner_env_index(environment: YirOwnerEnvironment, slot: Text) -> Number:
    var index: Number = 0
    while index < list_count(environment.slots):
        if list_get(environment.slots, index) == slot: return index
        set index = index + 1
    return -1

fn core_yir_owner_field_index(environment: YirOwnerEnvironment, key: Text) -> Number:
    var index: Number = 0
    while index < list_count(environment.field_keys):
        if list_get(environment.field_keys, index) == key: return index
        set index = index + 1
    return -1

fn core_yir_owner_field_get(environment: YirOwnerEnvironment, key: Text) -> TextList:
    let index: Number = core_yir_owner_field_index(environment, key)
    if index < 0: return text_list()
    return core_yir_owner_decode(list_get(environment.field_owners, index))

fn core_yir_owner_field_set(environment: YirOwnerEnvironment, key: Text, owners: TextList) -> Number:
    let index: Number = core_yir_owner_field_index(environment, key)
    if index < 0:
        list_push(environment.field_keys, key)
        list_push(environment.field_owners, core_yir_owner_encode(owners))
        return list_count(environment.field_keys) - 1
    list_set(environment.field_owners, index, core_yir_owner_encode(owners))
    return index

fn core_yir_owner_field_root(key: Text) -> Text:
    let separator: Number = text_find(key, "::")
    if separator < 0: return ""
    return text_slice(key, 0, separator)

fn core_yir_owner_field_key(expression: YirExpr) -> Text:
    if expression.kind != "field" or list_count(expression.children) == 0: return ""
    let parent: YirExpr = list_get(expression.children, 0)
    if parent.kind == "variable": return parent.value + "::" + expression.value
    let parent_key: Text = core_yir_owner_field_key(parent)
    if parent_key == "": return ""
    return parent_key + "." + expression.value

fn core_yir_owner_field_invalidate_path(environment: YirOwnerEnvironment, slot: Text, path: Text, owners: TextList) -> Number:
    if path == "": return 0
    let field_key: Text = slot + "::" + path
    let field_prefix: Text = field_key + "."
    let identity_key: Text = "@listid::" + field_key
    let identity_prefix: Text = identity_key + "."
    let empty: TextList = text_list()
    var index: Number = 0
    while index < list_count(environment.field_keys):
        let key: Text = list_get(environment.field_keys, index)
        if key == field_key or text_starts_with(key, field_prefix):
            list_set(environment.field_owners, index, core_yir_owner_encode(owners))
        if key == identity_key or text_starts_with(key, identity_prefix):
            list_set(environment.field_owners, index, core_yir_owner_encode(empty))
        set index = index + 1
    return 0

fn core_yir_owner_field_invalidate(environment: YirOwnerEnvironment, slot: Text, owners: TextList) -> Number:
    let prefix: Text = slot + "::"
    let list_identity_prefix: Text = "@listid::" + slot + "::"
    let no_identity: TextList = text_list()
    var index: Number = 0
    while index < list_count(environment.field_keys):
        let key: Text = list_get(environment.field_keys, index)
        if text_starts_with(key, prefix): list_set(environment.field_owners, index, core_yir_owner_encode(owners))
        if text_starts_with(key, list_identity_prefix): list_set(environment.field_owners, index, core_yir_owner_encode(no_identity))
        set index = index + 1
    return 0

fn core_yir_owner_mark_unknown_aggregate_fields(slot: Text, value_type: Text, environment: YirOwnerEnvironment, context: YirOwnerContext, path: Text, depth: Number) -> Number:
    if depth > 16: return 0
    let unknown: TextList = text_list()
    list_push(unknown, "@unknown")
    let shape_index: Number = core_yir_find_shape(context.shapes, value_type)
    if shape_index >= 0:
        let shape: HirShape = list_get(context.shapes, shape_index)
        var field_index: Number = 0
        while field_index < list_count(shape.fields):
            let field: HirField = list_get(shape.fields, field_index)
            var field_path: Text = number_text(field_index)
            if path != "": set field_path = path + "." + field_path
            if core_yir_owner_type(field.value_type, context.shapes, context.variants):
                core_yir_owner_field_set(environment, slot + "::" + field_path, unknown)
            core_yir_owner_mark_unknown_aggregate_fields(slot, field.value_type, environment, context, field_path, depth + 1)
            set field_index = field_index + 1
        return 0
    let option_payload: Text = core_yir_option_payload_type(value_type)
    if option_payload != "":
        var payload_path: Text = "@some"
        if path != "": set payload_path = path + ".@some"
        if core_yir_owner_type(option_payload, context.shapes, context.variants):
            core_yir_owner_field_set(environment, slot + "::" + payload_path, unknown)
        core_yir_owner_mark_unknown_aggregate_fields(slot, option_payload, environment, context, payload_path, depth + 1)
        return 0
    let result_success: Text = core_yir_result_argument_type(value_type, 0)
    let result_error: Text = core_yir_result_argument_type(value_type, 1)
    if result_success != "" and result_error != "":
        var success_path: Text = "@ok"
        var error_path: Text = "@err"
        if path != "":
            set success_path = path + ".@ok"
            set error_path = path + ".@err"
        if core_yir_owner_type(result_success, context.shapes, context.variants):
            core_yir_owner_field_set(environment, slot + "::" + success_path, unknown)
        if core_yir_owner_type(result_error, context.shapes, context.variants):
            core_yir_owner_field_set(environment, slot + "::" + error_path, unknown)
        core_yir_owner_mark_unknown_aggregate_fields(slot, result_success, environment, context, success_path, depth + 1)
        core_yir_owner_mark_unknown_aggregate_fields(slot, result_error, environment, context, error_path, depth + 1)
        return 0
    let variant_index: Number = core_yir_find_variant(context.variants, value_type)
    if variant_index >= 0:
        let variant: HirVariant = list_get(context.variants, variant_index)
        var case_index: Number = 0
        while case_index < list_count(variant.cases):
            let variant_case: HirVariantCase = list_get(variant.cases, case_index)
            var field_index: Number = 0
            while field_index < list_count(variant_case.fields):
                let field: HirField = list_get(variant_case.fields, field_index)
                var field_path: Text = "@case." + number_text(case_index) + "." + number_text(field_index)
                if path != "": set field_path = path + "." + field_path
                if core_yir_owner_type(field.value_type, context.shapes, context.variants):
                    core_yir_owner_field_set(environment, slot + "::" + field_path, unknown)
                core_yir_owner_mark_unknown_aggregate_fields(slot, field.value_type, environment, context, field_path, depth + 1)
                set field_index = field_index + 1
            set case_index = case_index + 1
        return 0
    return 0

fn core_yir_owner_normalize_list_field_path(value_type: Text, path: Text, context: YirOwnerContext, depth: Number) -> Text:
    if depth > 16 or path == "" or text_starts_with(path, "@"): return path
    let shape_index: Number = core_yir_find_shape(context.shapes, value_type)
    if shape_index < 0: return path
    let separator: Number = text_find(path, ".")
    var field_name: Text = path
    var suffix: Text = ""
    if separator >= 0:
        set field_name = text_slice(path, 0, separator)
        set suffix = text_slice(path, separator + 1, text_length(path) - separator - 1)
    let shape: HirShape = list_get(context.shapes, shape_index)
    let field_index: Number = core_yir_shape_field_index(shape, field_name)
    if field_index < 0: return path
    let field: HirField = list_get(shape.fields, field_index)
    let field_path: Text = number_text(field_index)
    if suffix == "": return field_path
    return field_path + "." + core_yir_owner_normalize_list_field_path(field.value_type, suffix, context, depth + 1)

fn core_yir_owner_record_return_fields(expression: YirExpr, owners: TextList, environment: YirOwnerEnvironment, context: YirOwnerContext) -> Number:
    if not core_yir_owner_aggregate_type(expression.value_type, context.shapes, context.variants): return 0
    let snapshot: YirOwnerEnvironment = core_yir_owner_env_clone(environment)
    core_yir_owner_update_aggregate_fields("@return", expression.value_type, expression, owners, snapshot, context, "", 0)
    if list_count(context.return_field_paths) == 0 or list_get(context.return_field_paths, 0) != "@seen":
        list_push(context.return_field_paths, "@seen")
        list_push(context.return_field_owners, "")
        var snapshot_index: Number = 0
        while snapshot_index < list_count(snapshot.field_keys):
            let key: Text = list_get(snapshot.field_keys, snapshot_index)
            if core_yir_owner_field_root(key) == "@return":
                let separator: Number = text_find(key, "::")
                let path: Text = text_slice(key, separator + 2, text_length(key) - separator - 2)
                list_push(context.return_field_paths, path)
                list_push(context.return_field_owners, list_get(snapshot.field_owners, snapshot_index))
            set snapshot_index = snapshot_index + 1
        return 0
    var candidate_index: Number = 1
    while candidate_index < list_count(context.return_field_paths):
        let path: Text = list_get(context.return_field_paths, candidate_index)
        if path != "":
            let snapshot_key: Text = "@return::" + path
            let snapshot_index: Number = core_yir_owner_field_index(snapshot, snapshot_key)
            if snapshot_index < 0:
                list_set(context.return_field_paths, candidate_index, "")
                list_set(context.return_field_owners, candidate_index, "")
            else:
                let prior: TextList = core_yir_owner_decode(list_get(context.return_field_owners, candidate_index))
                let next: TextList = core_yir_owner_decode(list_get(snapshot.field_owners, snapshot_index))
                list_set(context.return_field_owners, candidate_index, core_yir_owner_encode(core_yir_owner_union(prior, next)))
        set candidate_index = candidate_index + 1
    return 0

fn core_yir_owner_seed_parameter_fields(slot: Text, value_type: Text, parameter_index: Number, path: Text, environment: YirOwnerEnvironment, context: YirOwnerContext, depth: Number) -> Number:
    if depth > 16: return 0
    let shape_index: Number = core_yir_find_shape(context.shapes, value_type)
    let option_payload: Text = core_yir_option_payload_type(value_type)
    let result_success: Text = core_yir_result_argument_type(value_type, 0)
    let result_error: Text = core_yir_result_argument_type(value_type, 1)
    if option_payload != "":
        var payload_path: Text = "@some"
        if path != "": set payload_path = path + ".@some"
        let payload_owners: TextList = text_list()
        if core_yir_owner_type(option_payload, context.shapes, context.variants): list_push(payload_owners, "Q" + number_text(parameter_index) + ":" + payload_path)
        core_yir_owner_field_set(environment, slot + "::" + payload_path, payload_owners)
        core_yir_owner_seed_parameter_fields(slot, option_payload, parameter_index, payload_path, environment, context, depth + 1)
        return 0
    if result_success != "" and result_error != "":
        var success_path: Text = "@ok"
        var error_path: Text = "@err"
        if path != "":
            set success_path = path + ".@ok"
            set error_path = path + ".@err"
        var success_owners: TextList = text_list()
        let error_owners: TextList = text_list()
        if core_yir_owner_type(result_success, context.shapes, context.variants): list_push(success_owners, "Q" + number_text(parameter_index) + ":" + success_path)
        if core_yir_owner_type(result_error, context.shapes, context.variants): list_push(error_owners, "Q" + number_text(parameter_index) + ":" + error_path)
        core_yir_owner_field_set(environment, slot + "::" + success_path, success_owners)
        core_yir_owner_field_set(environment, slot + "::" + error_path, error_owners)
        core_yir_owner_seed_parameter_fields(slot, result_success, parameter_index, success_path, environment, context, depth + 1)
        core_yir_owner_seed_parameter_fields(slot, result_error, parameter_index, error_path, environment, context, depth + 1)
        return 0
    let variant_index: Number = core_yir_find_variant(context.variants, value_type)
    if variant_index >= 0:
        let variant: HirVariant = list_get(context.variants, variant_index)
        var case_index: Number = 0
        while case_index < list_count(variant.cases):
            let variant_case: HirVariantCase = list_get(variant.cases, case_index)
            var field_index: Number = 0
            while field_index < list_count(variant_case.fields):
                let field: HirField = list_get(variant_case.fields, field_index)
                var field_path: Text = "@case." + number_text(case_index) + "." + number_text(field_index)
                if path != "": set field_path = path + "." + field_path
                let field_owners: TextList = text_list()
                if core_yir_owner_type(field.value_type, context.shapes, context.variants): list_push(field_owners, "Q" + number_text(parameter_index) + ":" + field_path)
                core_yir_owner_field_set(environment, slot + "::" + field_path, field_owners)
                core_yir_owner_seed_parameter_fields(slot, field.value_type, parameter_index, field_path, environment, context, depth + 1)
                set field_index = field_index + 1
            set case_index = case_index + 1
        return 0
    if shape_index < 0: return 0
    let shape: HirShape = list_get(context.shapes, shape_index)
    var field_index: Number = 0
    while field_index < list_count(shape.fields):
        let field: HirField = list_get(shape.fields, field_index)
        var field_path: Text = number_text(field_index)
        if path != "": set field_path = path + "." + number_text(field_index)
        let field_owners: TextList = text_list()
        if core_yir_owner_type(field.value_type, context.shapes, context.variants):
            list_push(field_owners, "Q" + number_text(parameter_index) + ":" + field_path)
        core_yir_owner_field_set(environment, slot + "::" + field_path, field_owners)
        core_yir_owner_seed_parameter_fields(slot, field.value_type, parameter_index, field_path, environment, context, depth + 1)
        set field_index = field_index + 1
    return 0

fn core_yir_owner_env_get(environment: YirOwnerEnvironment, slot: Text) -> TextList:
    let index: Number = core_yir_owner_env_index(environment, slot)
    if index < 0: return text_list()
    return core_yir_owner_decode(list_get(environment.owners, index))

fn core_yir_owner_env_set(environment: YirOwnerEnvironment, slot: Text, value_type: Text, region: Text, owners: TextList) -> Number:
    let index: Number = core_yir_owner_env_index(environment, slot)
    if index < 0:
        list_push(environment.slots, slot)
        list_push(environment.types, value_type)
        list_push(environment.regions, region)
        list_push(environment.owners, core_yir_owner_encode(owners))
        return list_count(environment.slots) - 1
    list_set(environment.owners, index, core_yir_owner_encode(owners))
    return index

fn core_yir_owner_env_clone(environment: YirOwnerEnvironment) -> YirOwnerEnvironment:
    let cloned_slots: TextList = core_yir_owner_copy(environment.slots)
    let cloned_types: TextList = core_yir_owner_copy(environment.types)
    let cloned_regions: TextList = core_yir_owner_copy(environment.regions)
    let cloned_owners: TextList = core_yir_owner_copy(environment.owners)
    let cloned_field_keys: TextList = core_yir_owner_copy(environment.field_keys)
    let cloned_field_owners: TextList = core_yir_owner_copy(environment.field_owners)
    return YirOwnerEnvironment(cloned_slots, cloned_types, cloned_regions, cloned_owners, cloned_field_keys, cloned_field_owners)

fn core_yir_owner_update_aggregate_fields(slot: Text, value_type: Text, expression: YirExpr, owners: TextList, environment: YirOwnerEnvironment, context: YirOwnerContext, path: Text, depth: Number) -> Number:
    if depth > 16: return 0
    if core_yir_list_element_type(value_type) != "":
        if path != "":
            let identity: Text = core_yir_owner_list_identity(expression, environment, context)
            let identities: TextList = text_list()
            if identity != "": list_push(identities, identity)
            core_yir_owner_field_set(environment, "@listid::" + slot + "::" + path, identities)
        return 0
    if not core_yir_owner_aggregate_type(value_type, context.shapes, context.variants): return 0
    if expression.kind == "index" or expression.kind == "list_get" or expression.kind == "list_try_get":
        if path == "": core_yir_owner_field_invalidate(environment, slot, owners)
        core_yir_owner_copy_alias_fields(slot, value_type, expression, "", path, environment, context, depth + 1)
        return 0
    if expression.kind == "option_unwrap" or expression.kind == "result_unwrap" or expression.kind == "result_unwrap_error":
        if path == "": core_yir_owner_field_invalidate(environment, slot, owners)
        if list_count(expression.children) == 0: return 0
        var payload_path: Text = "@some"
        if expression.kind == "result_unwrap": set payload_path = "@ok"
        if expression.kind == "result_unwrap_error": set payload_path = "@err"
        core_yir_owner_copy_alias_fields(slot, value_type, list_get(expression.children, 0), payload_path, path, environment, context, depth + 1)
        return 0
    if expression.kind == "call":
        if path == "": core_yir_owner_field_invalidate(environment, slot, owners)
        if expression.value == "text_try_lines" or expression.value == "text_try_split":
            var success_path: Text = "@ok"
            var error_path: Text = "@err"
            if path != "":
                set success_path = path + ".@ok"
                set error_path = path + ".@err"
            let success_owners: TextList = text_list()
            list_push(success_owners, core_yir_owner_current(context))
            let error_owners: TextList = text_list()
            list_push(error_owners, "@static")
            core_yir_owner_field_set(environment, slot + "::" + success_path, success_owners)
            core_yir_owner_field_set(environment, slot + "::" + error_path, error_owners)
            let identities: TextList = text_list()
            let identity: Text = core_yir_owner_list_identity(expression, environment, context)
            if identity != "": list_push(identities, identity)
            core_yir_owner_field_set(environment, "@listid::" + slot + "::" + success_path, identities)
            return 0
        let summary_index: Number = core_yir_owner_find_summary(context.summaries, expression.value)
        if summary_index >= 0:
            let summary: YirOwnerSummary = list_get(context.summaries, summary_index)
            let argument_owners: TextList = text_list()
            var argument_index: Number = 0
            while argument_index < list_count(expression.children):
                list_push(argument_owners, core_yir_owner_encode(core_yir_owner_expr(list_get(expression.children, argument_index), environment, context)))
                set argument_index = argument_index + 1
            var field_index: Number = 0
            while field_index < list_count(summary.return_field_paths):
                var field_path: Text = list_get(summary.return_field_paths, field_index)
                if path != "": set field_path = path + "." + field_path
                let origins: TextList = core_yir_owner_decode(list_get(summary.return_field_owners, field_index))
                let mapped: TextList = core_yir_owner_map_field_tokens(origins, expression.children, argument_owners, environment, context, depth + 1)
                core_yir_owner_field_set(environment, slot + "::" + field_path, mapped)
                set field_index = field_index + 1
            if list_count(summary.return_field_paths) > 0: return 0
        core_yir_owner_field_invalidate(environment, slot, owners)
        return 0
    if expression.kind == "fallible_sum":
        if path == "": core_yir_owner_field_invalidate(environment, slot, owners)
        if list_count(expression.children) == 0: return 0
        let child: YirExpr = list_get(expression.children, 0)
        var payload_type: Text = core_yir_option_payload_type(expression.value)
        var inner_path: Text = "@some"
        if expression.value2 == "ok":
            set payload_type = core_yir_result_argument_type(expression.value, 0)
            set inner_path = "@ok"
        else:
            if expression.value2 == "err":
                set payload_type = core_yir_result_argument_type(expression.value, 1)
                set inner_path = "@err"
        let payload_owners: TextList = core_yir_owner_expr(child, environment, context)
        var success_path: Text = "@ok"
        var error_path: Text = "@err"
        if path != "":
            set success_path = path + ".@ok"
            set error_path = path + ".@err"
        var success_owners: TextList = text_list()
        list_push(success_owners, core_yir_owner_current(context))
        set success_owners = core_yir_owner_union(success_owners, payload_owners)
        let error_owners: TextList = text_list()
        list_push(error_owners, "@static")
        core_yir_owner_field_set(environment, slot + "::" + success_path, success_owners)
        core_yir_owner_field_set(environment, slot + "::" + error_path, error_owners)
        let nested_path: Text = success_path + "." + inner_path
        core_yir_owner_field_set(environment, slot + "::" + nested_path, payload_owners)
        core_yir_owner_update_aggregate_fields(slot, payload_type, child, payload_owners, environment, context, nested_path, depth + 1)
        return 0
    if expression.kind == "fallible_variant":
        if path == "": core_yir_owner_field_invalidate(environment, slot, owners)
        let variant_expression: YirExpr = core_yir_expr("variant_create", expression.value2, expression.value, expression.children, expression.source_line)
        let success_owners: TextList = core_yir_owner_expr(variant_expression, environment, context)
        var success_path: Text = "@ok"
        var error_path: Text = "@err"
        if path != "":
            set success_path = path + ".@ok"
            set error_path = path + ".@err"
        core_yir_owner_field_set(environment, slot + "::" + success_path, success_owners)
        let error_owners: TextList = text_list()
        list_push(error_owners, "@static")
        core_yir_owner_field_set(environment, slot + "::" + error_path, error_owners)
        core_yir_owner_update_aggregate_fields(slot, expression.value, variant_expression, success_owners, environment, context, success_path, depth + 1)
        return 0
    if expression.kind == "fallible_interpolate":
        if path == "": core_yir_owner_field_invalidate(environment, slot, owners)
        var success_path: Text = "@ok"
        var error_path: Text = "@err"
        if path != "":
            set success_path = path + ".@ok"
            set error_path = path + ".@err"
        let success_owners: TextList = text_list()
        list_push(success_owners, core_yir_owner_current(context))
        let error_owners: TextList = text_list()
        list_push(error_owners, "@static")
        core_yir_owner_field_set(environment, slot + "::" + success_path, success_owners)
        core_yir_owner_field_set(environment, slot + "::" + error_path, error_owners)
        return 0
    if expression.kind == "fallible_list_try_get":
        if path == "": core_yir_owner_field_invalidate(environment, slot, owners)
        let list_read: YirExpr = core_yir_expr("list_try_get", list_get(expression.children, 0).value_type, expression.value, expression.children, expression.source_line)
        var success_path: Text = "@ok"
        var error_path: Text = "@err"
        if path != "":
            set success_path = path + ".@ok"
            set error_path = path + ".@err"
        var success_owners: TextList = text_list()
        list_push(success_owners, core_yir_owner_current(context))
        set success_owners = core_yir_owner_union(success_owners, core_yir_owner_expr(list_read, environment, context))
        let error_owners: TextList = text_list()
        list_push(error_owners, "@static")
        core_yir_owner_field_set(environment, slot + "::" + success_path, success_owners)
        core_yir_owner_field_set(environment, slot + "::" + error_path, error_owners)
        core_yir_owner_update_aggregate_fields(slot, expression.value, list_read, success_owners, environment, context, success_path, depth + 1)
        return 0
    if expression.kind == "option_some":
        if path == "": core_yir_owner_field_invalidate(environment, slot, owners)
        if list_count(expression.children) == 0: return 0
        let payload_type: Text = core_yir_option_payload_type(value_type)
        let child: YirExpr = list_get(expression.children, 0)
        let payload_owners: TextList = core_yir_owner_expr(child, environment, context)
        var payload_path: Text = "@some"
        if path != "": set payload_path = path + ".@some"
        core_yir_owner_field_set(environment, slot + "::" + payload_path, payload_owners)
        core_yir_owner_update_aggregate_fields(slot, payload_type, child, payload_owners, environment, context, payload_path, depth + 1)
        return 0
    if expression.kind == "option_none":
        if path == "": core_yir_owner_field_invalidate(environment, slot, owners)
        return 0
    if expression.kind == "result_ok" or expression.kind == "result_err":
        if path == "": core_yir_owner_field_invalidate(environment, slot, owners)
        if list_count(expression.children) == 0: return 0
        var payload_path: Text = "@ok"
        var payload_type: Text = core_yir_result_argument_type(value_type, 0)
        if expression.kind == "result_err":
            set payload_path = "@err"
            set payload_type = core_yir_result_argument_type(value_type, 1)
        if path != "": set payload_path = path + "." + payload_path
        let child: YirExpr = list_get(expression.children, 0)
        let payload_owners: TextList = core_yir_owner_expr(child, environment, context)
        core_yir_owner_field_set(environment, slot + "::" + payload_path, payload_owners)
        core_yir_owner_update_aggregate_fields(slot, payload_type, child, payload_owners, environment, context, payload_path, depth + 1)
        return 0
    if expression.kind == "list_try_create" or expression.kind == "list_try_literal":
        if path == "": core_yir_owner_field_invalidate(environment, slot, owners)
        let identity: Text = core_yir_owner_list_identity(expression, environment, context)
        let identities: TextList = text_list()
        if identity != "": list_push(identities, identity)
        var payload_path: Text = "@ok"
        var error_path: Text = "@err"
        if path != "": set payload_path = path + ".@ok"
        if path != "": set error_path = path + ".@err"
        var success_owners: TextList = text_list()
        list_push(success_owners, core_yir_owner_current(context))
        if expression.kind == "list_try_literal":
            var item_index: Number = 0
            while item_index < list_count(expression.children):
                set success_owners = core_yir_owner_union(success_owners, core_yir_owner_expr(list_get(expression.children, item_index), environment, context))
                set item_index = item_index + 1
        let error_owners: TextList = text_list()
        list_push(error_owners, "@static")
        core_yir_owner_field_set(environment, slot + "::" + payload_path, success_owners)
        core_yir_owner_field_set(environment, slot + "::" + error_path, error_owners)
        core_yir_owner_field_set(environment, "@listid::" + slot + "::" + payload_path, identities)
        return 0
    if expression.kind == "variant_create":
        if path == "": core_yir_owner_field_invalidate(environment, slot, owners)
        let variant_index: Number = core_yir_find_variant(context.variants, value_type)
        let case_index: Number = number_parse(expression.value)
        if variant_index < 0 or case_index < 0 or case_index >= list_count(list_get(context.variants, variant_index).cases): return 0
        let variant_case: HirVariantCase = list_get(list_get(context.variants, variant_index).cases, case_index)
        var field_index: Number = 0
        while field_index < list_count(variant_case.fields) and field_index < list_count(expression.children):
            let field: HirField = list_get(variant_case.fields, field_index)
            let child: YirExpr = list_get(expression.children, field_index)
            var field_path: Text = "@case." + number_text(case_index) + "." + number_text(field_index)
            if path != "": set field_path = path + "." + field_path
            let field_owners: TextList = core_yir_owner_expr(child, environment, context)
            core_yir_owner_field_set(environment, slot + "::" + field_path, field_owners)
            core_yir_owner_update_aggregate_fields(slot, field.value_type, child, field_owners, environment, context, field_path, depth + 1)
            set field_index = field_index + 1
        return 0
    if expression.kind == "shape_create":
        if path == "": core_yir_owner_field_invalidate(environment, slot, owners)
        let shape_index: Number = core_yir_find_shape(context.shapes, expression.value)
        if shape_index < 0: return 0
        let shape: HirShape = list_get(context.shapes, shape_index)
        var field_index: Number = 0
        while field_index < list_count(shape.fields) and field_index < list_count(expression.children):
            let field: HirField = list_get(shape.fields, field_index)
            let child: YirExpr = list_get(expression.children, field_index)
            var field_path: Text = number_text(field_index)
            if path != "": set field_path = path + "." + number_text(field_index)
            let field_owners: TextList = core_yir_owner_expr(child, environment, context)
            core_yir_owner_field_set(environment, slot + "::" + field_path, field_owners)
            core_yir_owner_update_aggregate_fields(slot, field.value_type, child, field_owners, environment, context, field_path, depth + 1)
            set field_index = field_index + 1
        return 0
    if expression.kind == "variable" or expression.kind == "field":
        var source_slot: Text = expression.value
        var source_path: Text = ""
        if expression.kind == "field":
            let source_key: Text = core_yir_owner_field_key(expression)
            let separator: Number = text_find(source_key, "::")
            if separator >= 0:
                set source_slot = text_slice(source_key, 0, separator)
                set source_path = text_slice(source_key, separator + 2, text_length(source_key) - separator - 2)
        if source_slot == slot and path == source_path: return 0
        let copied_paths: TextList = text_list()
        let copied_owners: TextList = text_list()
        let copied_list_identity_paths: TextList = text_list()
        let copied_list_identities: TextList = text_list()
        let source_identity_prefix: Text = "@listid::" + source_slot + "::"
        var map_index: Number = 0
        while map_index < list_count(environment.field_keys):
            let key: Text = list_get(environment.field_keys, map_index)
            if core_yir_owner_field_root(key) == source_slot:
                let separator: Number = text_find(key, "::")
                let field_path: Text = text_slice(key, separator + 2, text_length(key) - separator - 2)
                var source_prefix: Text = ""
                if source_path != "": set source_prefix = source_path + "."
                if source_path == "" or text_starts_with(field_path, source_prefix):
                    var suffix: Text = field_path
                    if source_path != "": set suffix = text_slice(field_path, text_length(source_prefix), text_length(field_path) - text_length(source_prefix))
                    list_push(copied_paths, suffix)
                    list_push(copied_owners, list_get(environment.field_owners, map_index))
            if text_starts_with(key, source_identity_prefix):
                let identity_path: Text = text_slice(key, text_length(source_identity_prefix), text_length(key) - text_length(source_identity_prefix))
                var identity_source_prefix: Text = ""
                if source_path != "": set identity_source_prefix = source_path + "."
                if source_path == "" or text_starts_with(identity_path, identity_source_prefix):
                    var identity_suffix: Text = identity_path
                    if source_path != "": set identity_suffix = text_slice(identity_path, text_length(identity_source_prefix), text_length(identity_path) - text_length(identity_source_prefix))
                    list_push(copied_list_identity_paths, identity_suffix)
                    list_push(copied_list_identities, list_get(environment.field_owners, map_index))
            set map_index = map_index + 1
        core_yir_owner_field_invalidate(environment, slot, owners)
        var copy_index: Number = 0
        while copy_index < list_count(copied_paths):
            let suffix: Text = list_get(copied_paths, copy_index)
            var target_path: Text = suffix
            if path != "": set target_path = path + "." + suffix
            core_yir_owner_field_set(environment, slot + "::" + target_path, core_yir_owner_decode(list_get(copied_owners, copy_index)))
            set copy_index = copy_index + 1
        set copy_index = 0
        while copy_index < list_count(copied_list_identity_paths):
            let suffix: Text = list_get(copied_list_identity_paths, copy_index)
            var target_path: Text = suffix
            if path != "": set target_path = path + "." + suffix
            core_yir_owner_field_set(environment, "@listid::" + slot + "::" + target_path, core_yir_owner_decode(list_get(copied_list_identities, copy_index)))
            set copy_index = copy_index + 1
        return 0
    core_yir_owner_field_invalidate(environment, slot, owners)
    return 0

fn core_yir_owner_context_new(program: YirProgram) -> YirOwnerContext:
    let regions: TextList = text_list()
    list_push(regions, "C")
    return YirOwnerContext(program.functions, program.shapes, program.variants, List[YirOwnerSummary](), regions, text_list(), List[YirOwnerEffect](), List[YirOwnerListEffect](), text_list(), text_list())

fn core_yir_owner_current(context: YirOwnerContext) -> Text:
    if list_count(context.regions) == 0: return "C"
    return list_get(context.regions, list_count(context.regions) - 1)

fn core_yir_owner_outlives(source: Text, destination: Text, regions: TextList) -> Boolean:
    if source == "@static" or source == "@process" or source == destination: return true
    if text_starts_with(source, "P") or text_starts_with(destination, "P") or text_starts_with(source, "Q") or text_starts_with(destination, "Q"): return true
    var source_depth: Number = -1
    var destination_depth: Number = -1
    var index: Number = 0
    while index < list_count(regions):
        let region: Text = list_get(regions, index)
        if region == source: set source_depth = index
        if region == destination: set destination_depth = index
        set index = index + 1
    if source_depth < 0 or destination_depth < 0: return false
    return source_depth <= destination_depth

fn core_yir_owner_check_store(owners: TextList, destination_region: Text, context: YirOwnerContext, location: Text) -> Number:
    var index: Number = 0
    while index < list_count(owners):
        let owner: Text = list_get(owners, index)
        var source_region: Text = owner
        if owner == "@unknown": set source_region = core_yir_owner_current(context)
        if not core_yir_owner_outlives(source_region, destination_region, context.regions):
            fail("YIR ownership: value owned by shorter-lived arena '" + owner + "' cannot be stored in '" + destination_region + "'" + location)
        set index = index + 1
    return 0

fn core_yir_owner_list_identity_key(expression: YirExpr) -> Text:
    if expression.kind == "variable": return "@listid::" + expression.value
    if expression.kind == "field" or expression.kind == "owner_path":
        if list_count(expression.children) == 0: return ""
        let parent: YirExpr = list_get(expression.children, 0)
        let parent_key: Text = core_yir_owner_list_identity_key(parent)
        if parent_key == "": return ""
        if parent.kind == "variable": return parent_key + "::" + expression.value
        return parent_key + "." + expression.value
    if expression.kind == "option_unwrap" or expression.kind == "result_unwrap" or expression.kind == "result_unwrap_error":
        if list_count(expression.children) == 0: return ""
        let parent: YirExpr = list_get(expression.children, 0)
        let parent_key: Text = core_yir_owner_list_identity_key(parent)
        if parent_key == "": return ""
        var payload_path: Text = "@some"
        if expression.kind == "result_unwrap": set payload_path = "@ok"
        if expression.kind == "result_unwrap_error": set payload_path = "@err"
        if parent.kind == "variable": return parent_key + "::" + payload_path
        return parent_key + "." + payload_path
    return ""

fn core_yir_owner_list_identity_from_projected_read(expression: YirExpr, path: Text, environment: YirOwnerEnvironment, context: YirOwnerContext, depth: Number) -> Text:
    if depth > 16 or list_count(expression.children) == 0: return ""
    var nested_path: Text = path
    var recognized: Boolean = false
    if expression.kind == "field" or expression.kind == "owner_path":
        set recognized = true
        if nested_path == "":
            set nested_path = expression.value
        else:
            set nested_path = expression.value + "." + nested_path
    if expression.kind == "option_unwrap":
        set recognized = true
        if nested_path == "":
            set nested_path = "@some"
        else:
            set nested_path = "@some." + nested_path
    if expression.kind == "result_unwrap":
        set recognized = true
        if nested_path == "":
            set nested_path = "@ok"
        else:
            set nested_path = "@ok." + nested_path
    if expression.kind == "result_unwrap_error":
        set recognized = true
        if nested_path == "":
            set nested_path = "@err"
        else:
            set nested_path = "@err." + nested_path
    if not recognized: return ""
    let parent: YirExpr = list_get(expression.children, 0)
    if parent.kind == "index" or parent.kind == "list_get" or parent.kind == "list_try_get":
        return core_yir_owner_list_identity_from_read(parent, nested_path, environment, context)
    if parent.kind == "field" or parent.kind == "owner_path" or parent.kind == "option_unwrap" or parent.kind == "result_unwrap" or parent.kind == "result_unwrap_error":
        return core_yir_owner_list_identity_from_projected_read(parent, nested_path, environment, context, depth + 1)
    return ""

fn core_yir_owner_list_identity(expression: YirExpr, environment: YirOwnerEnvironment, context: YirOwnerContext) -> Text:
    if expression.kind == "list_create" or expression.kind == "list_try_create" or expression.kind == "list_literal" or expression.kind == "list_try_literal":
        return "@alloc|" + expression.source_file + "|" + number_text(expression.source_line) + "|" + number_text(expression.source_column)
    if expression.kind == "call":
        return "@call|" + expression.value + "|" + expression.source_file + "|" + number_text(expression.source_line) + "|" + number_text(expression.source_column)
    if expression.kind == "index" or expression.kind == "list_get":
        return core_yir_owner_list_identity_from_read(expression, "@value", environment, context)
    if expression.kind == "list_try_get":
        return core_yir_owner_list_identity_from_read(expression, "@some", environment, context)
    if expression.kind == "field" or expression.kind == "owner_path":
        let projected_identity: Text = core_yir_owner_list_identity_from_projected_read(expression, "", environment, context, 0)
        if projected_identity != "": return projected_identity
    if expression.kind == "field" and list_count(expression.children) > 0:
        let parent: YirExpr = list_get(expression.children, 0)
        if parent.kind == "shape_create":
            let field_index: Number = number_parse(expression.value)
            if field_index >= 0 and field_index < list_count(parent.children): return core_yir_owner_list_identity(list_get(parent.children, field_index), environment, context)
    if expression.kind == "owner_path" and list_count(expression.children) > 0:
        let parent: YirExpr = list_get(expression.children, 0)
        if parent.kind == "variant_create":
            let first_separator: Number = text_find(expression.value, ".")
            let rest: Text = text_slice(expression.value, first_separator + 1, text_length(expression.value) - first_separator - 1)
            let second_separator: Number = text_find(rest, ".")
            if first_separator >= 0 and second_separator >= 0:
                let case_index: Number = number_parse(text_slice(rest, 0, second_separator))
                let field_and_suffix: Text = text_slice(rest, second_separator + 1, text_length(rest) - second_separator - 1)
                let third_separator: Number = text_find(field_and_suffix, ".")
                var field_token: Text = field_and_suffix
                var suffix: Text = ""
                if third_separator >= 0:
                    set field_token = text_slice(field_and_suffix, 0, third_separator)
                    set suffix = text_slice(field_and_suffix, third_separator + 1, text_length(field_and_suffix) - third_separator - 1)
                let field_index: Number = number_parse(field_token)
                if case_index == number_parse(parent.value) and field_index >= 0 and field_index < list_count(parent.children):
                    let field_value: YirExpr = list_get(parent.children, field_index)
                    if suffix == "": return core_yir_owner_list_identity(field_value, environment, context)
                    let projected: YirExpr = core_yir_owner_project_list_expression(field_value, field_value.value_type, suffix, context, 0)
                    return core_yir_owner_list_identity(projected, environment, context)
    if expression.kind == "option_unwrap" or expression.kind == "result_unwrap" or expression.kind == "result_unwrap_error":
        if list_count(expression.children) > 0:
            let parent: YirExpr = list_get(expression.children, 0)
            if expression.kind == "option_unwrap" and parent.kind == "option_some" and list_count(parent.children) > 0: return core_yir_owner_list_identity(list_get(parent.children, 0), environment, context)
            if expression.kind == "result_unwrap" and parent.kind == "result_ok" and list_count(parent.children) > 0: return core_yir_owner_list_identity(list_get(parent.children, 0), environment, context)
            if expression.kind == "result_unwrap_error" and parent.kind == "result_err" and list_count(parent.children) > 0: return core_yir_owner_list_identity(list_get(parent.children, 0), environment, context)
            if expression.kind == "option_unwrap" and parent.kind == "result_unwrap": return core_yir_owner_list_identity(parent, environment, context)
            if expression.kind == "result_unwrap" and parent.kind == "fallible_list_try_get":
                let list_read: YirExpr = core_yir_expr("list_try_get", list_get(parent.children, 0).value_type, parent.value, parent.children, parent.source_line)
                return core_yir_owner_list_identity_from_read(list_read, "@some", environment, context)
            if expression.kind == "result_unwrap" and (parent.kind == "list_try_create" or parent.kind == "list_try_literal"): return core_yir_owner_list_identity(parent, environment, context)
            if expression.kind == "result_unwrap" and parent.kind == "call" and (parent.value == "text_try_lines" or parent.value == "text_try_split"): return core_yir_owner_list_identity(parent, environment, context)
            if expression.kind == "option_unwrap" and parent.kind == "list_try_get": return core_yir_owner_list_identity_from_read(parent, "@some", environment, context)
            if expression.kind == "result_unwrap" and (parent.kind == "index" or parent.kind == "list_get" or parent.kind == "list_try_get"): return core_yir_owner_list_identity_from_read(parent, "@ok", environment, context)
            if expression.kind == "result_unwrap_error" and (parent.kind == "index" or parent.kind == "list_get" or parent.kind == "list_try_get"): return core_yir_owner_list_identity_from_read(parent, "@err", environment, context)
    let key: Text = core_yir_owner_list_identity_key(expression)
    if key != "":
        let identities: TextList = core_yir_owner_field_get(environment, key)
        if list_count(identities) == 1: return list_get(identities, 0)
    return ""

fn core_yir_owner_record_list_variable_identity(slot: Text, value_type: Text, expression: YirExpr, environment: YirOwnerEnvironment, context: YirOwnerContext) -> Number:
    if core_yir_list_element_type(value_type) == "": return 0
    let identity: Text = core_yir_owner_list_identity(expression, environment, context)
    let identities: TextList = text_list()
    if identity != "": list_push(identities, identity)
    core_yir_owner_field_set(environment, "@listid::" + slot, identities)
    return 0

fn core_yir_owner_list_summary_prefix(collection: YirExpr, environment: YirOwnerEnvironment, context: YirOwnerContext) -> Text:
    let collection_owners: Text = core_yir_owner_encode(core_yir_owner_expr(collection, environment, context))
    let identity: Text = core_yir_owner_list_identity(collection, environment, context)
    if identity != "": return "@list::" + collection.value_type + "::" + collection_owners + "::" + identity + "::"
    return "@list::" + collection.value_type + "::" + collection_owners + "::"

fn core_yir_owner_list_identity_from_read(expression: YirExpr, path: Text, environment: YirOwnerEnvironment, context: YirOwnerContext) -> Text:
    if (expression.kind != "index" and expression.kind != "list_get" and expression.kind != "list_try_get") or list_count(expression.children) == 0: return ""
    let collection: YirExpr = list_get(expression.children, 0)
    let element_type: Text = core_yir_list_element_type(collection.value_type)
    if element_type == "": return ""
    var summary_path: Text = path
    if expression.kind == "list_try_get" and text_starts_with(summary_path, "@some"):
        if text_length(summary_path) == 5:
            set summary_path = "@value"
        else:
            set summary_path = text_slice(summary_path, 6, text_length(summary_path) - 6)
    if summary_path == "": set summary_path = "@value"
    let normalized: Text = core_yir_owner_normalize_list_field_path(element_type, summary_path, context, 0)
    let indexed_key: Text = core_yir_owner_list_indexed_read_key(expression, "@listid::" + normalized, environment, context)
    if indexed_key != "":
        let indexed_index: Number = core_yir_owner_field_index(environment, indexed_key)
        if indexed_index >= 0:
            let indexed_ids: TextList = core_yir_owner_decode(list_get(environment.field_owners, indexed_index))
            if list_count(indexed_ids) == 1 and list_get(indexed_ids, 0) != "@ambiguous": return list_get(indexed_ids, 0)
            return ""
    let prefix: Text = core_yir_owner_list_summary_prefix(collection, environment, context)
    let identities: TextList = core_yir_owner_field_get(environment, prefix + "@listid::" + normalized)
    if list_count(identities) == 1: return list_get(identities, 0)
    return ""

fn core_yir_owner_list_summary_add(environment: YirOwnerEnvironment, key: Text, owners: TextList) -> Number:
    let prior: TextList = core_yir_owner_field_get(environment, key)
    core_yir_owner_field_set(environment, key, core_yir_owner_union(prior, owners))
    return 0

fn core_yir_owner_list_summary_add_for_collection(environment: YirOwnerEnvironment, collection: YirExpr, collection_owners: TextList, suffix: Text, owners: TextList, context: YirOwnerContext) -> Number:
    let fallback_prefix: Text = "@list::" + collection.value_type + "::" + core_yir_owner_encode(collection_owners) + "::"
    let identity: Text = core_yir_owner_list_identity(collection, environment, context)
    var precise_prefix: Text = fallback_prefix
    if identity != "": set precise_prefix = precise_prefix + identity + "::"
    core_yir_owner_list_summary_add(environment, precise_prefix + suffix, owners)
    if precise_prefix != fallback_prefix: core_yir_owner_list_summary_add(environment, fallback_prefix + suffix, owners)
    return 0

fn core_yir_owner_list_indexed_summary_add(environment: YirOwnerEnvironment, collection: YirExpr, collection_owners: TextList, element_index: Number, suffix: Text, owners: TextList, context: YirOwnerContext) -> Number:
    if element_index < 0: return 0
    let fallback_prefix: Text = "@list::" + collection.value_type + "::" + core_yir_owner_encode(collection_owners) + "::"
    let identity: Text = core_yir_owner_list_identity(collection, environment, context)
    var precise_prefix: Text = fallback_prefix
    if identity != "": set precise_prefix = precise_prefix + identity + "::"
    let indexed_suffix: Text = "@index::" + number_text(element_index) + "::" + suffix
    core_yir_owner_list_summary_add(environment, precise_prefix + indexed_suffix, owners)
    if precise_prefix != fallback_prefix: core_yir_owner_list_summary_add(environment, fallback_prefix + indexed_suffix, owners)
    return 0

fn core_yir_owner_list_set_length(collection: YirExpr, collection_owners: TextList, length: Number, environment: YirOwnerEnvironment, context: YirOwnerContext) -> Number:
    let fallback_prefix: Text = "@list::" + collection.value_type + "::" + core_yir_owner_encode(collection_owners) + "::"
    let identity: Text = core_yir_owner_list_identity(collection, environment, context)
    var precise_prefix: Text = fallback_prefix
    if identity != "": set precise_prefix = precise_prefix + identity + "::"
    let value: TextList = text_list()
    list_push(value, number_text(length))
    core_yir_owner_field_set(environment, precise_prefix + "@length", value)
    if precise_prefix != fallback_prefix: core_yir_owner_field_set(environment, fallback_prefix + "@length", value)
    return 0

fn core_yir_owner_list_length(collection: YirExpr, collection_owners: TextList, environment: YirOwnerEnvironment, context: YirOwnerContext) -> Number:
    let precise_prefix: Text = core_yir_owner_list_summary_prefix(collection, environment, context)
    let precise_index: Number = core_yir_owner_field_index(environment, precise_prefix + "@length")
    if precise_index >= 0:
        let values: TextList = core_yir_owner_decode(list_get(environment.field_owners, precise_index))
        if list_count(values) == 1 and list_get(values, 0) != "-1": return number_parse(list_get(values, 0))
        return -1
    let fallback_prefix: Text = "@list::" + collection.value_type + "::" + core_yir_owner_encode(collection_owners) + "::"
    let fallback_index: Number = core_yir_owner_field_index(environment, fallback_prefix + "@length")
    if fallback_index >= 0:
        let values: TextList = core_yir_owner_decode(list_get(environment.field_owners, fallback_index))
        if list_count(values) == 1 and list_get(values, 0) != "-1": return number_parse(list_get(values, 0))
        return -1
    let identity: Text = core_yir_owner_list_identity(collection, environment, context)
    if text_starts_with(identity, "@alloc|") and collection.kind != "list_literal": return 0
    return -1

fn core_yir_owner_list_indexed_read_key(expression: YirExpr, path: Text, environment: YirOwnerEnvironment, context: YirOwnerContext) -> Text:
    if (expression.kind != "index" and expression.kind != "list_get" and expression.kind != "list_try_get") or list_count(expression.children) < 2: return ""
    let index_expression: YirExpr = list_get(expression.children, 1)
    if index_expression.kind != "number": return ""
    let collection: YirExpr = list_get(expression.children, 0)
    let element_type: Text = core_yir_list_element_type(collection.value_type)
    if element_type == "": return ""
    var summary_path: Text = path
    if expression.kind == "list_try_get" and text_starts_with(summary_path, "@some"):
        if text_length(summary_path) == 5:
            set summary_path = "@value"
        else:
            set summary_path = text_slice(summary_path, 6, text_length(summary_path) - 6)
    if summary_path == "": set summary_path = "@value"
    let normalized: Text = core_yir_owner_normalize_list_field_path(element_type, summary_path, context, 0)
    let prefix: Text = core_yir_owner_list_summary_prefix(collection, environment, context)
    return prefix + "@index::" + index_expression.value + "::" + normalized

fn core_yir_owner_invalidate_list_indices(collection: YirExpr, environment: YirOwnerEnvironment, context: YirOwnerContext) -> Number:
    let collection_owners: TextList = core_yir_owner_expr(collection, environment, context)
    let fallback_prefix: Text = "@list::" + collection.value_type + "::" + core_yir_owner_encode(collection_owners) + "::@index::"
    let identity: Text = core_yir_owner_list_identity(collection, environment, context)
    var precise_prefix: Text = fallback_prefix
    if identity != "": set precise_prefix = "@list::" + collection.value_type + "::" + core_yir_owner_encode(collection_owners) + "::" + identity + "::@index::"
    let ambiguous: TextList = text_list()
    list_push(ambiguous, "@ambiguous")
    var index: Number = 0
    while index < list_count(environment.field_keys):
        let key: Text = list_get(environment.field_keys, index)
        if text_starts_with(key, precise_prefix) or (precise_prefix != fallback_prefix and text_starts_with(key, fallback_prefix)):
            list_set(environment.field_owners, index, core_yir_owner_encode(ambiguous))
        set index = index + 1
    return 0

fn core_yir_owner_mark_index_prefix_ambiguous(environment: YirOwnerEnvironment, prefix: Text) -> Number:
    let ambiguous: TextList = text_list()
    list_push(ambiguous, "@ambiguous")
    var index: Number = 0
    while index < list_count(environment.field_keys):
        let key: Text = list_get(environment.field_keys, index)
        if text_starts_with(key, prefix): list_set(environment.field_owners, index, core_yir_owner_encode(ambiguous))
        set index = index + 1
    return 0

fn core_yir_owner_invalidate_list_summaries(environment: YirOwnerEnvironment) -> Number:
    let unknown: TextList = text_list()
    let no_identity: TextList = text_list()
    let unknown_length: TextList = text_list()
    let ambiguous_index: TextList = text_list()
    list_push(unknown, "@unknown")
    list_push(unknown_length, "-1")
    list_push(ambiguous_index, "@ambiguous")
    var index: Number = 0
    while index < list_count(environment.field_keys):
        let key: Text = list_get(environment.field_keys, index)
        if core_yir_owner_field_root(key) == "@list":
            if text_ends_with(key, "::@length"):
                list_set(environment.field_owners, index, core_yir_owner_encode(unknown_length))
            else:
                if text_find(key, "::@index::") >= 0:
                    list_set(environment.field_owners, index, core_yir_owner_encode(ambiguous_index))
                else:
                    if text_find(key, "::@listid::") >= 0:
                        list_set(environment.field_owners, index, core_yir_owner_encode(no_identity))
                    else:
                        list_set(environment.field_owners, index, core_yir_owner_encode(unknown))
        set index = index + 1
    return 0

fn core_yir_owner_add_effect(context: YirOwnerContext, destination: Text, value: TextList) -> Number:
    if (not text_starts_with(destination, "P") and not text_starts_with(destination, "Q")) or list_count(value) == 0: return 0
    let destinations: TextList = text_list()
    list_push(destinations, destination)
    var index: Number = 0
    while index < list_count(context.effects):
        let existing: YirOwnerEffect = list_get(context.effects, index)
        if core_yir_owner_sets_equal(existing.destination, destinations) and core_yir_owner_sets_equal(existing.value, value): return 0
        set index = index + 1
    list_push(context.effects, YirOwnerEffect(destinations, core_yir_owner_copy(value)))
    return 1

fn core_yir_owner_list_effect_equal(left: YirOwnerListEffect, right: YirOwnerListEffect) -> Boolean:
    if left.destination != right.destination or left.element_type != right.element_type: return false
    if not core_yir_owner_sets_equal(left.value, right.value): return false
    if list_count(left.field_paths) != list_count(right.field_paths): return false
    var index: Number = 0
    while index < list_count(left.field_paths):
        if list_get(left.field_paths, index) != list_get(right.field_paths, index): return false
        if not core_yir_owner_sets_equal(core_yir_owner_decode(list_get(left.field_owners, index)), core_yir_owner_decode(list_get(right.field_owners, index))): return false
        set index = index + 1
    return true

fn core_yir_owner_add_list_effect(context: YirOwnerContext, destination: Text, element_type: Text, value: TextList, field_paths: TextList, field_owners: TextList) -> Number:
    if (not text_starts_with(destination, "P") and not text_starts_with(destination, "Q")) or list_count(value) == 0: return 0
    let sought: YirOwnerListEffect = YirOwnerListEffect(destination, element_type, core_yir_owner_copy(value), core_yir_owner_copy(field_paths), core_yir_owner_copy(field_owners))
    var index: Number = 0
    while index < list_count(context.list_effects):
        if core_yir_owner_list_effect_equal(list_get(context.list_effects, index), sought): return 0
        set index = index + 1
    list_push(context.list_effects, sought)
    return 1

fn core_yir_owner_record_list_effect(destination: Text, item: YirExpr, element_type: Text, environment: YirOwnerEnvironment, context: YirOwnerContext) -> Number:
    let value: TextList = core_yir_owner_expr(item, environment, context)
    if list_count(value) == 0: return 0
    let field_paths: TextList = text_list()
    let field_owners: TextList = text_list()
    if core_yir_owner_aggregate_type(element_type, context.shapes, context.variants):
        let temp_slot: Text = "@list.element." + number_text(item.source_line) + "." + number_text(item.source_column) + "." + element_type
        var index: Number = 0
        while index < list_count(environment.field_keys):
            let key: Text = list_get(environment.field_keys, index)
            if core_yir_owner_field_root(key) == temp_slot:
                let separator: Number = text_find(key, "::")
                list_push(field_paths, text_slice(key, separator + 2, text_length(key) - separator - 2))
                list_push(field_owners, list_get(environment.field_owners, index))
            set index = index + 1
    core_yir_owner_add_list_effect(context, destination, element_type, value, field_paths, field_owners)
    return 0

fn core_yir_owner_record_list_element_fields(collection: YirExpr, item: YirExpr, element_type: Text, element_index: Number, environment: YirOwnerEnvironment, context: YirOwnerContext) -> Number:
    var element_owners: TextList = core_yir_owner_expr(item, environment, context)
    let collection_owners: TextList = core_yir_owner_expr(collection, environment, context)
    if element_type == "Text": set element_owners = collection_owners
    core_yir_owner_list_summary_add_for_collection(environment, collection, collection_owners, "@value", element_owners, context)
    core_yir_owner_list_indexed_summary_add(environment, collection, collection_owners, element_index, "@value", element_owners, context)
    if core_yir_list_element_type(element_type) != "":
        let identity: Text = core_yir_owner_list_identity(item, environment, context)
        let identities: TextList = text_list()
        if identity != "": list_push(identities, identity)
        core_yir_owner_list_summary_add_for_collection(environment, collection, collection_owners, "@listid::@value", identities, context)
        core_yir_owner_list_indexed_summary_add(environment, collection, collection_owners, element_index, "@listid::@value", identities, context)
        return 0
    if not core_yir_owner_aggregate_type(element_type, context.shapes, context.variants): return 0
    let temp_slot: Text = "@list.element." + number_text(item.source_line) + "." + number_text(item.source_column) + "." + element_type
    core_yir_owner_field_invalidate(environment, temp_slot, text_list())
    core_yir_owner_copy_alias_fields(temp_slot, element_type, item, "", "", environment, context, 0)
    var field_index: Number = 0
    while field_index < list_count(environment.field_keys):
        let field_key: Text = list_get(environment.field_keys, field_index)
        let list_identity_prefix: Text = "@listid::" + temp_slot + "::"
        if text_starts_with(field_key, list_identity_prefix):
            let path: Text = text_slice(field_key, text_length(list_identity_prefix), text_length(field_key) - text_length(list_identity_prefix))
            let identities: TextList = core_yir_owner_decode(list_get(environment.field_owners, field_index))
            core_yir_owner_list_summary_add_for_collection(environment, collection, collection_owners, "@listid::" + path, identities, context)
            core_yir_owner_list_indexed_summary_add(environment, collection, collection_owners, element_index, "@listid::" + path, identities, context)
        if core_yir_owner_field_root(field_key) == temp_slot:
            let separator: Number = text_find(field_key, "::")
            let path: Text = text_slice(field_key, separator + 2, text_length(field_key) - separator - 2)
            let path_owners: TextList = core_yir_owner_decode(list_get(environment.field_owners, field_index))
            core_yir_owner_list_summary_add_for_collection(environment, collection, collection_owners, path, path_owners, context)
            core_yir_owner_list_indexed_summary_add(environment, collection, collection_owners, element_index, path, path_owners, context)
        set field_index = field_index + 1
    return 0

fn core_yir_owner_record_list_store(destination: TextList, value: TextList, element_type: Text, collection: YirExpr, item: YirExpr, write_kind: Text, environment: YirOwnerEnvironment, context: YirOwnerContext, location: Text) -> Number:
    # Typed Text lists copy the text payload into the List owner's arena.
    var element_index: Number = -1
    if write_kind == "push":
        set element_index = core_yir_owner_list_length(collection, destination, environment, context)
        if element_index >= 0: core_yir_owner_list_set_length(collection, destination, element_index + 1, environment, context)
    else:
        core_yir_owner_invalidate_list_indices(collection, environment, context)
        if write_kind == "try_push": core_yir_owner_list_set_length(collection, destination, -1, environment, context)
    if element_type == "Text": return core_yir_owner_record_list_element_fields(collection, item, element_type, element_index, environment, context)
    if list_count(destination) == 0: fail("YIR ownership: list has no known arena owner" + location)
    core_yir_owner_record_list_element_fields(collection, item, element_type, element_index, environment, context)
    var destination_index: Number = 0
    while destination_index < list_count(destination):
        let destination_owner: Text = list_get(destination, destination_index)
        if text_starts_with(destination_owner, "P") or text_starts_with(destination_owner, "Q"):
            core_yir_owner_add_effect(context, destination_owner, value)
            core_yir_owner_record_list_effect(destination_owner, item, element_type, environment, context)
        else:
            core_yir_owner_check_store(value, destination_owner, context, location)
        set destination_index = destination_index + 1
    return 0

fn core_yir_owner_map_tokens(tokens: TextList, arguments: TextList, context: YirOwnerContext) -> TextList:
    let mapped: TextList = text_list()
    var token_index: Number = 0
    while token_index < list_count(tokens):
        let token: Text = list_get(tokens, token_index)
        if token == "C":
            let current: Text = core_yir_owner_current(context)
            if not core_yir_owner_has(mapped, current): list_push(mapped, current)
        else:
            if text_starts_with(token, "P"):
                let parameter_index: Number = number_parse(text_slice(token, 1, text_length(token) - 1))
                if parameter_index >= 0 and parameter_index < list_count(arguments):
                    let actual: TextList = core_yir_owner_decode(list_get(arguments, parameter_index))
                    var actual_index: Number = 0
                    while actual_index < list_count(actual):
                        let owner: Text = list_get(actual, actual_index)
                        if not core_yir_owner_has(mapped, owner): list_push(mapped, owner)
                        set actual_index = actual_index + 1
                else:
                    if not core_yir_owner_has(mapped, token): list_push(mapped, token)
            else:
                var mapped_token: Text = token
                if text_starts_with(token, "%arena.scope."): set mapped_token = "@callee_scope"
                if not core_yir_owner_has(mapped, mapped_token): list_push(mapped, mapped_token)
        set token_index = token_index + 1
    return mapped

fn core_yir_owner_find_return_field(summary: YirOwnerSummary, path: Text) -> Number:
    var index: Number = 0
    while index < list_count(summary.return_field_paths):
        if list_get(summary.return_field_paths, index) == path: return index
        set index = index + 1
    return -1

fn core_yir_owner_call_has_static_text_error(function_name: Text) -> Boolean:
    return function_name == "text_try_concat" or function_name == "text_try_repeat" or function_name == "text_try_join" or function_name == "text_try_slice" or function_name == "text_try_trim" or function_name == "text_try_split" or function_name == "text_try_lines" or function_name == "number_try_text" or function_name == "int32_try_text" or function_name == "float64_try_text" or function_name == "bytes_try_from_text" or function_name == "bytes_try_to_text" or function_name == "bytes_try_from_number" or function_name == "bytes_try_concat" or function_name == "bytes_try_slice" or function_name == "bytes_try_new_zeroed" or function_name == "list_try_new"

fn core_yir_owner_field_value(expression: YirExpr, path: Text, environment: YirOwnerEnvironment, context: YirOwnerContext, depth: Number) -> TextList:
    if depth > 16: return core_yir_owner_expr(expression, environment, context)
    if expression.kind == "list_try_literal":
        if text_starts_with(path, "@err"): return text_list()
        if path == "@ok": return core_yir_owner_expr(expression, environment, context)
    if expression.kind == "index" or expression.kind == "list_get" or expression.kind == "list_try_get":
        if list_count(expression.children) > 0:
            var summary_path: Text = path
            if expression.kind == "list_try_get" and text_starts_with(path, "@some"):
                if text_length(path) == 5:
                    set summary_path = "@value"
                else:
                    set summary_path = text_slice(path, 6, text_length(path) - 6)
            else:
                if summary_path == "": set summary_path = "@value"
            let collection: YirExpr = list_get(expression.children, 0)
            let prefix: Text = core_yir_owner_list_summary_prefix(collection, environment, context)
            let normalized: Text = core_yir_owner_normalize_list_field_path(expression.value_type, summary_path, context, 0)
            let indexed_key: Text = core_yir_owner_list_indexed_read_key(expression, summary_path, environment, context)
            if indexed_key != "":
                let indexed_index: Number = core_yir_owner_field_index(environment, indexed_key)
                if indexed_index >= 0:
                    let indexed_owners: TextList = core_yir_owner_decode(list_get(environment.field_owners, indexed_index))
                    if not core_yir_owner_has(indexed_owners, "@ambiguous"): return indexed_owners
            let key: Text = prefix + normalized
            let summary_index: Number = core_yir_owner_field_index(environment, key)
            if summary_index >= 0: return core_yir_owner_decode(list_get(environment.field_owners, summary_index))
        let unknown: TextList = text_list()
        list_push(unknown, "@unknown")
        return unknown
    if expression.kind == "fallible_sum":
        if text_starts_with(path, "@err"): return text_list()
        if path == "@ok": return core_yir_owner_expr(expression, environment, context)
        if text_starts_with(path, "@ok.") and list_count(expression.children) > 0:
            var inner_tag: Text = "@some"
            if expression.value2 == "ok": set inner_tag = "@ok"
            if expression.value2 == "err": set inner_tag = "@err"
            let nested_path: Text = text_slice(path, 4, text_length(path) - 4)
            if nested_path == inner_tag: return core_yir_owner_expr(list_get(expression.children, 0), environment, context)
            if text_starts_with(nested_path, inner_tag + "."):
                return core_yir_owner_field_value(list_get(expression.children, 0), text_slice(nested_path, text_length(inner_tag) + 1, text_length(nested_path) - text_length(inner_tag) - 1), environment, context, depth + 1)
    if expression.kind == "fallible_variant":
        if text_starts_with(path, "@err"): return text_list()
        if path == "@ok": return core_yir_owner_expr(expression, environment, context)
        if text_starts_with(path, "@ok.@case."):
            let variant_expression: YirExpr = core_yir_expr("variant_create", expression.value2, expression.value, expression.children, expression.source_line)
            return core_yir_owner_field_value(variant_expression, text_slice(path, 4, text_length(path) - 4), environment, context, depth + 1)
    if expression.kind == "fallible_interpolate":
        if text_starts_with(path, "@err"): return text_list()
        if path == "@ok":
            let current_owner: TextList = text_list()
            list_push(current_owner, core_yir_owner_current(context))
            return current_owner
    if expression.kind == "fallible_list_try_get":
        if text_starts_with(path, "@err"): return text_list()
        let list_read: YirExpr = core_yir_expr("list_try_get", list_get(expression.children, 0).value_type, expression.value, expression.children, expression.source_line)
        if path == "@ok":
            let result_owners: TextList = text_list()
            list_push(result_owners, core_yir_owner_current(context))
            return core_yir_owner_union(result_owners, core_yir_owner_expr(list_read, environment, context))
        if text_starts_with(path, "@ok."):
            return core_yir_owner_field_value(list_read, text_slice(path, 4, text_length(path) - 4), environment, context, depth + 1)
    if expression.kind == "option_unwrap" or expression.kind == "result_unwrap" or expression.kind == "result_unwrap_error":
        if list_count(expression.children) == 0: return core_yir_owner_expr(expression, environment, context)
        var payload_path: Text = "@some"
        if expression.kind == "result_unwrap": set payload_path = "@ok"
        if expression.kind == "result_unwrap_error": set payload_path = "@err"
        if path != "": set payload_path = payload_path + "." + path
        return core_yir_owner_field_value(list_get(expression.children, 0), payload_path, environment, context, depth + 1)
    if expression.kind == "option_some" and text_starts_with(path, "@some") and list_count(expression.children) > 0:
        let child: YirExpr = list_get(expression.children, 0)
        if text_length(path) == 5: return core_yir_owner_expr(child, environment, context)
        if text_slice(path, 5, 1) == ".": return core_yir_owner_field_value(child, text_slice(path, 6, text_length(path) - 6), environment, context, depth + 1)
    if expression.kind == "result_ok" and text_starts_with(path, "@err"): return text_list()
    if expression.kind == "result_err" and text_starts_with(path, "@ok"): return text_list()
    if expression.kind == "result_ok" and text_starts_with(path, "@ok") and list_count(expression.children) > 0:
        let child: YirExpr = list_get(expression.children, 0)
        if text_length(path) == 3: return core_yir_owner_expr(child, environment, context)
        if text_slice(path, 3, 1) == ".": return core_yir_owner_field_value(child, text_slice(path, 4, text_length(path) - 4), environment, context, depth + 1)
    if expression.kind == "result_err" and text_starts_with(path, "@err") and list_count(expression.children) > 0:
        let child: YirExpr = list_get(expression.children, 0)
        if text_length(path) == 4: return core_yir_owner_expr(child, environment, context)
        if text_slice(path, 4, 1) == ".": return core_yir_owner_field_value(child, text_slice(path, 5, text_length(path) - 5), environment, context, depth + 1)
    if expression.kind == "variant_create" and text_starts_with(path, "@case."):
        let first_separator: Number = text_find(path, ".")
        let rest: Text = text_slice(path, first_separator + 1, text_length(path) - first_separator - 1)
        let second_separator: Number = text_find(rest, ".")
        if second_separator >= 0:
            let case_index: Number = number_parse(text_slice(rest, 0, second_separator))
            let field_and_suffix: Text = text_slice(rest, second_separator + 1, text_length(rest) - second_separator - 1)
            let third_separator: Number = text_find(field_and_suffix, ".")
            var field_token: Text = field_and_suffix
            if third_separator >= 0: set field_token = text_slice(field_and_suffix, 0, third_separator)
            let field_index: Number = number_parse(field_token)
            if case_index == number_parse(expression.value) and field_index >= 0 and field_index < list_count(expression.children):
                let child: YirExpr = list_get(expression.children, field_index)
                if third_separator < 0: return core_yir_owner_expr(child, environment, context)
                return core_yir_owner_field_value(child, text_slice(field_and_suffix, third_separator + 1, text_length(field_and_suffix) - third_separator - 1), environment, context, depth + 1)
    if expression.kind == "variable":
        let key: Text = expression.value + "::" + path
        let field_index: Number = core_yir_owner_field_index(environment, key)
        if field_index >= 0: return core_yir_owner_decode(list_get(environment.field_owners, field_index))
        return core_yir_owner_env_get(environment, expression.value)
    if expression.kind == "field":
        let key: Text = core_yir_owner_field_key(expression)
        if key != "":
            let field_index: Number = core_yir_owner_field_index(environment, key + "." + path)
            if field_index >= 0: return core_yir_owner_decode(list_get(environment.field_owners, field_index))
        return core_yir_owner_expr(expression, environment, context)
    if expression.kind == "shape_create":
        let separator: Number = text_find(path, ".")
        var field_token: Text = path
        if separator >= 0: set field_token = text_slice(path, 0, separator)
        let field_index: Number = number_parse(field_token)
        if field_index < 0 or field_index >= list_count(expression.children): return core_yir_owner_expr(expression, environment, context)
        let child: YirExpr = list_get(expression.children, field_index)
        if separator < 0: return core_yir_owner_expr(child, environment, context)
        return core_yir_owner_field_value(child, text_slice(path, separator + 1, text_length(path) - separator - 1), environment, context, depth + 1)
    if expression.kind == "call":
        if path == "@err" and core_yir_owner_call_has_static_text_error(expression.value):
            let static_error: TextList = text_list()
            list_push(static_error, "@static")
            return static_error
        let summary_index: Number = core_yir_owner_find_summary(context.summaries, expression.value)
        if summary_index >= 0:
            let summary: YirOwnerSummary = list_get(context.summaries, summary_index)
            let field_index: Number = core_yir_owner_find_return_field(summary, path)
            if field_index >= 0:
                let argument_owners: TextList = text_list()
                var argument_index: Number = 0
                while argument_index < list_count(expression.children):
                    list_push(argument_owners, core_yir_owner_encode(core_yir_owner_expr(list_get(expression.children, argument_index), environment, context)))
                    set argument_index = argument_index + 1
                let origins: TextList = core_yir_owner_decode(list_get(summary.return_field_owners, field_index))
                return core_yir_owner_map_field_tokens(origins, expression.children, argument_owners, environment, context, depth + 1)
        return core_yir_owner_expr(expression, environment, context)
    return core_yir_owner_expr(expression, environment, context)

fn core_yir_owner_map_field_tokens(tokens: TextList, argument_expressions: List[YirExpr], argument_owners: TextList, environment: YirOwnerEnvironment, context: YirOwnerContext, depth: Number) -> TextList:
    var mapped: TextList = text_list()
    var token_index: Number = 0
    while token_index < list_count(tokens):
        let token: Text = list_get(tokens, token_index)
        if text_starts_with(token, "Q"):
            let separator: Number = text_find(token, ":")
            if separator > 1:
                let parameter_index: Number = number_parse(text_slice(token, 1, separator - 1))
                let path: Text = text_slice(token, separator + 1, text_length(token) - separator - 1)
                if parameter_index >= 0 and parameter_index < list_count(argument_expressions):
                    let actual: TextList = core_yir_owner_field_value(list_get(argument_expressions, parameter_index), path, environment, context, depth + 1)
                    set mapped = core_yir_owner_union(mapped, actual)
                else:
                    if not core_yir_owner_has(mapped, token): list_push(mapped, token)
            else:
                if not core_yir_owner_has(mapped, token): list_push(mapped, token)
        else:
            let single: TextList = text_list()
            list_push(single, token)
            set mapped = core_yir_owner_union(mapped, core_yir_owner_map_tokens(single, argument_owners, context))
        set token_index = token_index + 1
    return mapped

fn core_yir_owner_find_summary(summaries: List[YirOwnerSummary], function_name: Text) -> Number:
    var index: Number = 0
    while index < list_count(summaries):
        if list_get(summaries, index).function_name == function_name: return index
        set index = index + 1
    return -1

fn core_yir_owner_project_list_expression(expression: YirExpr, value_type: Text, path: Text, context: YirOwnerContext, depth: Number) -> YirExpr:
    if depth > 16: return core_yir_expr("invalid", "", "", List[YirExpr](), expression.source_line)
    if core_yir_list_element_type(value_type) != "":
        if path == "": return expression
        return core_yir_expr("invalid", "", "", List[YirExpr](), expression.source_line)
    if path == "": return core_yir_expr("invalid", "", "", List[YirExpr](), expression.source_line)
    let option_payload: Text = core_yir_option_payload_type(value_type)
    if option_payload != "":
        if path != "@some" and not text_starts_with(path, "@some."): return core_yir_expr("invalid", "", "", List[YirExpr](), expression.source_line)
        var suffix: Text = ""
        if text_length(path) > 5: set suffix = text_slice(path, 6, text_length(path) - 6)
        let children: List[YirExpr] = List[YirExpr]()
        list_push(children, expression)
        let unwrapped: YirExpr = core_yir_expr("option_unwrap", "", option_payload, children, expression.source_line)
        return core_yir_owner_project_list_expression(unwrapped, option_payload, suffix, context, depth + 1)
    let result_success: Text = core_yir_result_argument_type(value_type, 0)
    let result_error: Text = core_yir_result_argument_type(value_type, 1)
    if result_success != "" and result_error != "":
        var payload_type: Text = ""
        var prefix: Text = ""
        var unwrap_kind: Text = ""
        if path == "@ok" or text_starts_with(path, "@ok."):
            set payload_type = result_success
            set prefix = "@ok"
            set unwrap_kind = "result_unwrap"
        if path == "@err" or text_starts_with(path, "@err."):
            set payload_type = result_error
            set prefix = "@err"
            set unwrap_kind = "result_unwrap_error"
        if payload_type == "": return core_yir_expr("invalid", "", "", List[YirExpr](), expression.source_line)
        var suffix: Text = ""
        if text_length(path) > text_length(prefix): set suffix = text_slice(path, text_length(prefix) + 1, text_length(path) - text_length(prefix) - 1)
        let children: List[YirExpr] = List[YirExpr]()
        list_push(children, expression)
        let unwrapped: YirExpr = core_yir_expr(unwrap_kind, "", payload_type, children, expression.source_line)
        return core_yir_owner_project_list_expression(unwrapped, payload_type, suffix, context, depth + 1)
    let variant_index: Number = core_yir_find_variant(context.variants, value_type)
    if variant_index >= 0:
        if not text_starts_with(path, "@case."): return core_yir_expr("invalid", "", "", List[YirExpr](), expression.source_line)
        let first_separator: Number = text_find(path, ".")
        let case_and_field: Text = text_slice(path, first_separator + 1, text_length(path) - first_separator - 1)
        let second_separator: Number = text_find(case_and_field, ".")
        if second_separator < 0: return core_yir_expr("invalid", "", "", List[YirExpr](), expression.source_line)
        let case_index: Number = number_parse(text_slice(case_and_field, 0, second_separator))
        let field_and_suffix: Text = text_slice(case_and_field, second_separator + 1, text_length(case_and_field) - second_separator - 1)
        let third_separator: Number = text_find(field_and_suffix, ".")
        var field_token: Text = field_and_suffix
        var suffix: Text = ""
        if third_separator >= 0:
            set field_token = text_slice(field_and_suffix, 0, third_separator)
            set suffix = text_slice(field_and_suffix, third_separator + 1, text_length(field_and_suffix) - third_separator - 1)
        let field_index: Number = number_parse(field_token)
        let variant: HirVariant = list_get(context.variants, variant_index)
        if case_index < 0 or case_index >= list_count(variant.cases): return core_yir_expr("invalid", "", "", List[YirExpr](), expression.source_line)
        let variant_case: HirVariantCase = list_get(variant.cases, case_index)
        if field_index < 0 or field_index >= list_count(variant_case.fields): return core_yir_expr("invalid", "", "", List[YirExpr](), expression.source_line)
        let field: HirField = list_get(variant_case.fields, field_index)
        let children: List[YirExpr] = List[YirExpr]()
        list_push(children, expression)
        let projected: YirExpr = core_yir_expr("owner_path", path, field.value_type, children, expression.source_line)
        return core_yir_owner_project_list_expression(projected, field.value_type, suffix, context, depth + 1)
    let shape_index: Number = core_yir_find_shape(context.shapes, value_type)
    if shape_index < 0: return core_yir_expr("invalid", "", "", List[YirExpr](), expression.source_line)
    let separator: Number = text_find(path, ".")
    var field_token: Text = path
    var suffix: Text = ""
    if separator >= 0:
        set field_token = text_slice(path, 0, separator)
        set suffix = text_slice(path, separator + 1, text_length(path) - separator - 1)
    let field_index: Number = number_parse(field_token)
    let shape: HirShape = list_get(context.shapes, shape_index)
    if field_index < 0 or field_index >= list_count(shape.fields): return core_yir_expr("invalid", "", "", List[YirExpr](), expression.source_line)
    let field: HirField = list_get(shape.fields, field_index)
    let children: List[YirExpr] = List[YirExpr]()
    list_push(children, expression)
    let projected: YirExpr = core_yir_expr("field", number_text(field_index), field.value_type, children, expression.source_line)
    return core_yir_owner_project_list_expression(projected, field.value_type, suffix, context, depth + 1)

fn core_yir_owner_list_effect_collection(effect: YirOwnerListEffect, argument_expressions: List[YirExpr], context: YirOwnerContext) -> YirExpr:
    if text_starts_with(effect.destination, "P") and text_find(effect.destination, ":") < 0:
        let parameter_index: Number = number_parse(text_slice(effect.destination, 1, text_length(effect.destination) - 1))
        if parameter_index >= 0 and parameter_index < list_count(argument_expressions):
            let collection: YirExpr = list_get(argument_expressions, parameter_index)
            if core_yir_list_element_type(collection.value_type) == effect.element_type: return collection
        return core_yir_expr("invalid", "", "", List[YirExpr](), 1)
    if text_starts_with(effect.destination, "Q"):
        let separator: Number = text_find(effect.destination, ":")
        if separator > 1:
            let parameter_index: Number = number_parse(text_slice(effect.destination, 1, separator - 1))
            if parameter_index >= 0 and parameter_index < list_count(argument_expressions):
                let source: YirExpr = list_get(argument_expressions, parameter_index)
                let path: Text = text_slice(effect.destination, separator + 1, text_length(effect.destination) - separator - 1)
                let collection: YirExpr = core_yir_owner_project_list_expression(source, source.value_type, path, context, 0)
                if core_yir_list_element_type(collection.value_type) == effect.element_type: return collection
    return core_yir_expr("invalid", "", "", List[YirExpr](), 1)

fn core_yir_owner_list_effect_covers(effect: YirOwnerEffect, list_effects: List[YirOwnerListEffect]) -> Boolean:
    var index: Number = 0
    while index < list_count(list_effects):
        let list_effect: YirOwnerListEffect = list_get(list_effects, index)
        let destination: TextList = text_list()
        list_push(destination, list_effect.destination)
        if core_yir_owner_sets_equal(effect.destination, destination) and core_yir_owner_sets_equal(effect.value, list_effect.value): return true
        set index = index + 1
    return false

fn core_yir_owner_apply_list_effect(effect: YirOwnerListEffect, argument_expressions: List[YirExpr], arguments: TextList, environment: YirOwnerEnvironment, context: YirOwnerContext) -> Boolean:
    let destinations: TextList = text_list()
    list_push(destinations, effect.destination)
    let mapped_destinations: TextList = core_yir_owner_map_field_tokens(destinations, argument_expressions, arguments, environment, context, 0)
    let mapped_value: TextList = core_yir_owner_map_field_tokens(effect.value, argument_expressions, arguments, environment, context, 0)
    let mapped_field_owners: TextList = text_list()
    var field_index: Number = 0
    while field_index < list_count(effect.field_paths):
        let encoded: Text = list_get(effect.field_owners, field_index)
        let owners: TextList = core_yir_owner_map_field_tokens(core_yir_owner_decode(encoded), argument_expressions, arguments, environment, context, 0)
        list_push(mapped_field_owners, core_yir_owner_encode(owners))
        set field_index = field_index + 1
    let collection: YirExpr = core_yir_owner_list_effect_collection(effect, argument_expressions, context)
    let precise: Boolean = collection.kind != "invalid"
    if precise:
        let collection_owners: TextList = core_yir_owner_expr(collection, environment, context)
        core_yir_owner_invalidate_list_indices(collection, environment, context)
        core_yir_owner_list_set_length(collection, collection_owners, -1, environment, context)
        core_yir_owner_list_summary_add_for_collection(environment, collection, collection_owners, "@value", mapped_value, context)
        set field_index = 0
        while field_index < list_count(effect.field_paths):
            core_yir_owner_list_summary_add_for_collection(environment, collection, collection_owners, list_get(effect.field_paths, field_index), core_yir_owner_decode(list_get(mapped_field_owners, field_index)), context)
            set field_index = field_index + 1
    var destination_index: Number = 0
    while destination_index < list_count(mapped_destinations):
        let destination: Text = list_get(mapped_destinations, destination_index)
        if text_starts_with(destination, "P") or text_starts_with(destination, "Q"):
            core_yir_owner_add_list_effect(context, destination, effect.element_type, mapped_value, effect.field_paths, mapped_field_owners)
        set destination_index = destination_index + 1
    return precise

fn core_yir_owner_apply_call_effects(summary: YirOwnerSummary, argument_expressions: List[YirExpr], arguments: TextList, environment: YirOwnerEnvironment, context: YirOwnerContext, location: Text) -> Number:
    var effect_index: Number = 0
    while effect_index < list_count(summary.effects):
        let effect: YirOwnerEffect = list_get(summary.effects, effect_index)
        let destinations: TextList = core_yir_owner_map_field_tokens(effect.destination, argument_expressions, arguments, environment, context, 0)
        let values: TextList = core_yir_owner_map_field_tokens(effect.value, argument_expressions, arguments, environment, context, 0)
        var destination_index: Number = 0
        while destination_index < list_count(destinations):
            let destination: Text = list_get(destinations, destination_index)
            if text_starts_with(destination, "P") or text_starts_with(destination, "Q"):
                core_yir_owner_add_effect(context, destination, values)
            else:
                core_yir_owner_check_store(values, destination, context, location)
            set destination_index = destination_index + 1
        set effect_index = effect_index + 1
    var list_effect_index: Number = 0
    var list_effects_precise: Boolean = true
    while list_effect_index < list_count(summary.list_effects):
        if not core_yir_owner_apply_list_effect(list_get(summary.list_effects, list_effect_index), argument_expressions, arguments, environment, context): set list_effects_precise = false
        set list_effect_index = list_effect_index + 1
    set effect_index = 0
    while effect_index < list_count(summary.effects):
        if not core_yir_owner_list_effect_covers(list_get(summary.effects, effect_index), summary.list_effects): set list_effects_precise = false
        set effect_index = effect_index + 1
    # Unsupported or ambiguous indirect destinations retain the fail-closed fallback.
    if list_count(summary.effects) > 0 and not list_effects_precise: core_yir_owner_invalidate_list_summaries(environment)
    return 0

fn core_yir_owner_apply_try_conversion(expression: YirExpr, error_owners: TextList, environment: YirOwnerEnvironment, context: YirOwnerContext) -> TextList:
    let result: TextList = text_list()
    if expression.value2 == "": return result
    let summary_index: Number = core_yir_owner_find_summary(context.summaries, expression.value2)
    if summary_index < 0: fail("YIR ownership: missing summary for '?' From conversion '" + expression.value2 + "'" + core_yir_yir_expression_location(expression))
    let source_result: YirExpr = list_get(expression.children, 0)
    let source_error_type: Text = core_yir_result_argument_type(source_result.value_type, 1)
    let error_children: List[YirExpr] = List[YirExpr]()
    let error_expression: YirExpr = core_yir_expr("result_unwrap_error", "", source_error_type, List[YirExpr](), expression.source_line)
    list_push(error_expression.children, source_result)
    list_push(error_children, error_expression)
    let arguments: TextList = text_list()
    list_push(arguments, core_yir_owner_encode(error_owners))
    let summary: YirOwnerSummary = list_get(context.summaries, summary_index)
    core_yir_owner_apply_call_effects(summary, error_children, arguments, environment, context, core_yir_yir_expression_location(expression))
    return core_yir_owner_map_tokens(summary.origins, arguments, context)

fn core_yir_owner_expr(expression: YirExpr, environment: YirOwnerEnvironment, context: YirOwnerContext) -> TextList:
    let child_owners: TextList = text_list()
    var child_index: Number = 0
    while child_index < list_count(expression.children):
        list_push(child_owners, core_yir_owner_encode(core_yir_owner_expr(list_get(expression.children, child_index), environment, context)))
        set child_index = child_index + 1
    var result: TextList = text_list()
    let current: Text = core_yir_owner_current(context)
    if expression.kind == "try":
        let source_expression: YirExpr = list_get(expression.children, 0)
        var implicit_error_owners: TextList = core_yir_owner_field_value(source_expression, "@err", environment, context, 0)
        if expression.value2 != "": set implicit_error_owners = core_yir_owner_apply_try_conversion(expression, implicit_error_owners, environment, context)
        core_yir_owner_check_store(implicit_error_owners, "C", context, core_yir_yir_expression_location(expression))
        if list_count(implicit_error_owners) > 0: list_push(context.returns, core_yir_owner_encode(implicit_error_owners))
        return core_yir_owner_field_value(source_expression, "@ok", environment, context, 0)
    if expression.kind == "try_return": core_yir_owner_apply_try_conversion(expression, child_owners, environment, context)
    if expression.kind == "text":
        list_push(result, "@static")
        return result
    if expression.kind == "variable": return core_yir_owner_env_get(environment, expression.value)
    if expression.kind == "owner_path":
        if list_count(expression.children) > 0: return core_yir_owner_field_value(list_get(expression.children, 0), expression.value, environment, context, 0)
        list_push(result, "@unknown")
        return result
    if expression.kind == "option_none": return result
    if expression.kind == "fallible_sum" or expression.kind == "fallible_variant":
        list_push(result, current)
        if list_count(child_owners) > 0: return core_yir_owner_union(result, core_yir_owner_decode(list_get(child_owners, 0)))
        return result
    if expression.kind == "fallible_interpolate":
        list_push(result, current)
        return result
    if expression.kind == "fallible_list_try_get":
        list_push(result, current)
        let list_read: YirExpr = core_yir_expr("list_try_get", list_get(expression.children, 0).value_type, expression.value, expression.children, expression.source_line)
        return core_yir_owner_union(result, core_yir_owner_expr(list_read, environment, context))
    if expression.kind == "option_some" or expression.kind == "result_ok" or expression.kind == "result_err":
        var payload_type: Text = core_yir_option_payload_type(expression.value_type)
        if expression.kind == "result_ok": set payload_type = core_yir_result_argument_type(expression.value_type, 0)
        if expression.kind == "result_err": set payload_type = core_yir_result_argument_type(expression.value_type, 1)
        if not core_yir_sum_payload_inline(payload_type): list_push(result, current)
        if list_count(child_owners) > 0: return core_yir_owner_union(result, core_yir_owner_decode(list_get(child_owners, 0)))
        return result
    if expression.kind == "variant_create":
        let variant_index: Number = core_yir_find_variant(context.variants, expression.value_type)
        let case_index: Number = number_parse(expression.value)
        if variant_index >= 0 and case_index >= 0 and case_index < list_count(list_get(context.variants, variant_index).cases) and list_count(list_get(list_get(context.variants, variant_index).cases, case_index).fields) > 0:
            list_push(result, current)
        var payload_index: Number = 0
        while payload_index < list_count(child_owners):
            set result = core_yir_owner_union(result, core_yir_owner_decode(list_get(child_owners, payload_index)))
            set payload_index = payload_index + 1
        return result
    if expression.kind == "shape_create" or expression.kind == "list_literal":
        if expression.kind == "list_literal": list_push(result, current)
        var item_index: Number = 0
        while item_index < list_count(child_owners):
            set result = core_yir_owner_union(result, core_yir_owner_decode(list_get(child_owners, item_index)))
            set item_index = item_index + 1
        return result
    if expression.kind == "list_try_create":
        list_push(result, current)
        return result
    if expression.kind == "list_try_literal":
        list_push(result, current)
        var item_index: Number = 0
        while item_index < list_count(child_owners):
            set result = core_yir_owner_union(result, core_yir_owner_decode(list_get(child_owners, item_index)))
            set item_index = item_index + 1
        return result
    if expression.kind == "list_create" or expression.kind == "interpolate":
        list_push(result, current)
        if expression.kind == "interpolate":
            var interpolation_index: Number = 0
            while interpolation_index < list_count(child_owners):
                set result = core_yir_owner_union(result, core_yir_owner_decode(list_get(child_owners, interpolation_index)))
                set interpolation_index = interpolation_index + 1
        return result
    if expression.kind == "field":
        if core_yir_owner_type(expression.value_type, context.shapes, context.variants):
            let field_key: Text = core_yir_owner_field_key(expression)
            let field_index: Number = core_yir_owner_field_index(environment, field_key)
            if field_index >= 0: return core_yir_owner_decode(list_get(environment.field_owners, field_index))
            if list_count(expression.children) > 0: return core_yir_owner_field_value(list_get(expression.children, 0), expression.value, environment, context, 0)
        return result
    if expression.kind == "index" or expression.kind == "list_get" or expression.kind == "list_try_get":
        if expression.kind == "list_try_get":
            let payload_type: Text = core_yir_option_payload_type(expression.value_type)
            if core_yir_owner_type(payload_type, context.shapes, context.variants) and list_count(expression.children) > 0:
                let collection: YirExpr = list_get(expression.children, 0)
                let prefix: Text = core_yir_owner_list_summary_prefix(collection, environment, context)
                let indexed_key: Text = core_yir_owner_list_indexed_read_key(expression, "@value", environment, context)
                var summary_index: Number = -1
                if indexed_key != "": set summary_index = core_yir_owner_field_index(environment, indexed_key)
                if summary_index >= 0:
                    let indexed_owners: TextList = core_yir_owner_decode(list_get(environment.field_owners, summary_index))
                    if core_yir_owner_has(indexed_owners, "@ambiguous"): set summary_index = -1
                    else: set result = indexed_owners
                if summary_index < 0: set summary_index = core_yir_owner_field_index(environment, prefix + "@value")
                if summary_index >= 0:
                    if list_count(result) == 0: set result = core_yir_owner_decode(list_get(environment.field_owners, summary_index))
                else:
                    if core_yir_list_element_type(collection.value_type) == "Text":
                        set result = core_yir_owner_decode(list_get(child_owners, 0))
                    else:
                        list_push(result, "@unknown")
            if not core_yir_sum_payload_inline(payload_type): list_push(result, current)
            return result
        if core_yir_owner_type(expression.value_type, context.shapes, context.variants) and list_count(expression.children) > 0:
            let collection: YirExpr = list_get(expression.children, 0)
            let prefix: Text = core_yir_owner_list_summary_prefix(collection, environment, context)
            let indexed_key: Text = core_yir_owner_list_indexed_read_key(expression, "@value", environment, context)
            var summary_index: Number = -1
            if indexed_key != "": set summary_index = core_yir_owner_field_index(environment, indexed_key)
            if summary_index >= 0:
                let indexed_owners: TextList = core_yir_owner_decode(list_get(environment.field_owners, summary_index))
                if core_yir_owner_has(indexed_owners, "@ambiguous"): set summary_index = -1
                else: return indexed_owners
            if summary_index < 0: set summary_index = core_yir_owner_field_index(environment, prefix + "@value")
            if summary_index >= 0:
                return core_yir_owner_decode(list_get(environment.field_owners, summary_index))
            if core_yir_list_element_type(collection.value_type) == "Text": return core_yir_owner_decode(list_get(child_owners, 0))
            list_push(result, "@unknown")
            return result
        return result
    if expression.kind == "option_unwrap" or expression.kind == "result_unwrap" or expression.kind == "result_unwrap_error":
        if list_count(expression.children) > 0 and core_yir_owner_type(expression.value_type, context.shapes, context.variants):
            var payload_path: Text = "@some"
            if expression.kind == "result_unwrap": set payload_path = "@ok"
            if expression.kind == "result_unwrap_error": set payload_path = "@err"
            return core_yir_owner_field_value(list_get(expression.children, 0), payload_path, environment, context, 0)
        if core_yir_owner_type(expression.value_type, context.shapes, context.variants) and list_count(child_owners) > 0: return core_yir_owner_decode(list_get(child_owners, 0))
        return result
    if expression.kind == "binary":
        if expression.value == "+" and expression.value_type == "Text":
            list_push(result, current)
            return result
        return result
    if expression.kind == "list_push" or expression.kind == "list_try_push":
        if list_count(child_owners) >= 2:
            let destination: TextList = core_yir_owner_decode(list_get(child_owners, 0))
            let value: TextList = core_yir_owner_decode(list_get(child_owners, 1))
            let collection: YirExpr = list_get(expression.children, 0)
            let item: YirExpr = list_get(expression.children, 1)
            let element_type: Text = core_yir_list_element_type(list_get(expression.children, 0).value_type)
            var write_kind: Text = "push"
            if expression.kind == "list_try_push": set write_kind = "try_push"
            core_yir_owner_record_list_store(destination, value, element_type, collection, item, write_kind, environment, context, core_yir_yir_expression_location(expression))
        return result
    if expression.kind == "list_set" or expression.kind == "list_try_set":
        if list_count(child_owners) >= 3:
            let destination: TextList = core_yir_owner_decode(list_get(child_owners, 0))
            let value: TextList = core_yir_owner_decode(list_get(child_owners, 2))
            let collection: YirExpr = list_get(expression.children, 0)
            let item: YirExpr = list_get(expression.children, 2)
            let element_type: Text = core_yir_list_element_type(list_get(expression.children, 0).value_type)
            core_yir_owner_record_list_store(destination, value, element_type, collection, item, "set", environment, context, core_yir_yir_expression_location(expression))
        return result
    if expression.kind == "call":
        if expression.value == "bytes_empty": return result
        if expression.value == "arg":
            list_push(result, "@process")
            return result
        let function_index: Number = core_yir_find_lowered_function(context.functions, expression.value)
        if function_index >= 0:
            let summary_index: Number = core_yir_owner_find_summary(context.summaries, expression.value)
            if summary_index >= 0:
                let summary: YirOwnerSummary = list_get(context.summaries, summary_index)
                core_yir_owner_apply_call_effects(summary, expression.children, child_owners, environment, context, core_yir_yir_expression_location(expression))
                set result = core_yir_owner_map_tokens(summary.origins, child_owners, context)
            if not core_yir_owner_type(expression.value_type, context.shapes, context.variants): return text_list()
            if summary_index < 0:
                list_push(result, current)
                var argument_index: Number = 0
                while argument_index < list_count(child_owners):
                    set result = core_yir_owner_union(result, core_yir_owner_decode(list_get(child_owners, argument_index)))
                    set argument_index = argument_index + 1
            return result
        if not core_yir_owner_type(expression.value_type, context.shapes, context.variants): return result
        if expression.value == "arg_count": return result
        if expression.value == "text_list" or expression.value == "list_new" or expression.value == "text_split" or expression.value == "text_lines" or expression.value == "text_try_lines" or expression.value == "text_try_split" or expression.value == "text_try_trim":
            list_push(result, current)
            return result
        list_push(result, current)
        return result
    if not core_yir_owner_type(expression.value_type, context.shapes, context.variants): return result
    list_push(result, current)
    var fallback_index: Number = 0
    while fallback_index < list_count(child_owners):
        set result = core_yir_owner_union(result, core_yir_owner_decode(list_get(child_owners, fallback_index)))
        set fallback_index = fallback_index + 1
    return result

fn core_yir_owner_child_context(context: YirOwnerContext, region: Text) -> YirOwnerContext:
    let regions: TextList = core_yir_owner_copy(context.regions)
    list_push(regions, region)
    return YirOwnerContext(context.functions, context.shapes, context.variants, context.summaries, regions, context.returns, context.effects, context.list_effects, context.return_field_paths, context.return_field_owners)

fn core_yir_owner_merge_environment(target: YirOwnerEnvironment, branch: YirOwnerEnvironment, base_count: Number) -> Number:
    var index: Number = 0
    while index < base_count and index < list_count(target.owners) and index < list_count(branch.owners):
        let merged: TextList = core_yir_owner_union(core_yir_owner_decode(list_get(target.owners, index)), core_yir_owner_decode(list_get(branch.owners, index)))
        list_set(target.owners, index, core_yir_owner_encode(merged))
        set index = index + 1
    var field_index: Number = 0
    while field_index < list_count(branch.field_keys):
        let key: Text = list_get(branch.field_keys, field_index)
        let root: Text = core_yir_owner_field_root(key)
        let root_index: Number = core_yir_owner_env_index(target, root)
        if (root_index >= 0 and root_index < base_count) or root == "@list" or root == "@listid":
            let target_field_index: Number = core_yir_owner_field_index(target, key)
            var prior: TextList = text_list()
            if target_field_index >= 0: set prior = core_yir_owner_decode(list_get(target.field_owners, target_field_index))
            let branch_value: TextList = core_yir_owner_decode(list_get(branch.field_owners, field_index))
            var merged_field: TextList = core_yir_owner_union(prior, branch_value)
            if text_find(key, "@length") >= 0 and not core_yir_owner_sets_equal(prior, branch_value):
                set merged_field = text_list()
                list_push(merged_field, "-1")
                let length_suffix: Number = text_length(key) - 7
                if length_suffix >= 0: core_yir_owner_mark_index_prefix_ambiguous(target, text_slice(key, 0, length_suffix) + "@index::")
            if text_find(key, "@index::") >= 0 and (target_field_index < 0 or core_yir_owner_has(prior, "@ambiguous") or core_yir_owner_has(branch_value, "@ambiguous")):
                set merged_field = text_list()
                list_push(merged_field, "@ambiguous")
            core_yir_owner_field_set(target, key, merged_field)
        set field_index = field_index + 1
    set field_index = 0
    while field_index < list_count(target.field_keys):
        let key: Text = list_get(target.field_keys, field_index)
        let root: Text = core_yir_owner_field_root(key)
        if root == "@list" and (text_find(key, "@index::") >= 0 or text_find(key, "@length") >= 0) and core_yir_owner_field_index(branch, key) < 0:
            if text_find(key, "@length") >= 0:
                let unknown_length: TextList = text_list()
                list_push(unknown_length, "-1")
                list_set(target.field_owners, field_index, core_yir_owner_encode(unknown_length))
                let length_suffix: Number = text_length(key) - 7
                if length_suffix >= 0: core_yir_owner_mark_index_prefix_ambiguous(target, text_slice(key, 0, length_suffix) + "@index::")
            else:
                let ambiguous_index: TextList = text_list()
                list_push(ambiguous_index, "@ambiguous")
                list_set(target.field_owners, field_index, core_yir_owner_encode(ambiguous_index))
        set field_index = field_index + 1
    return 0

fn core_yir_owner_environments_equal(left: YirOwnerEnvironment, right: YirOwnerEnvironment, base_count: Number) -> Boolean:
    var index: Number = 0
    while index < base_count and index < list_count(left.owners) and index < list_count(right.owners):
        if not core_yir_owner_sets_equal(core_yir_owner_decode(list_get(left.owners, index)), core_yir_owner_decode(list_get(right.owners, index))): return false
        set index = index + 1
    if index != base_count: return false
    var field_index: Number = 0
    while field_index < list_count(left.field_keys):
        let key: Text = list_get(left.field_keys, field_index)
        let root: Text = core_yir_owner_field_root(key)
        let root_index: Number = core_yir_owner_env_index(left, root)
        if (root_index >= 0 and root_index < base_count) or root == "@list" or root == "@listid":
            let right_field_index: Number = core_yir_owner_field_index(right, key)
            if right_field_index < 0: return false
            if not core_yir_owner_sets_equal(core_yir_owner_decode(list_get(left.field_owners, field_index)), core_yir_owner_decode(list_get(right.field_owners, right_field_index))): return false
        set field_index = field_index + 1
    set field_index = 0
    while field_index < list_count(right.field_keys):
        let key: Text = list_get(right.field_keys, field_index)
        let root: Text = core_yir_owner_field_root(key)
        let root_index: Number = core_yir_owner_env_index(right, root)
        if ((root_index >= 0 and root_index < base_count) or root == "@list" or root == "@listid") and core_yir_owner_field_index(left, key) < 0: return false
        set field_index = field_index + 1
    return true

fn core_yir_owner_environment_token_count(environment: YirOwnerEnvironment) -> Number:
    var tokens: TextList = text_list()
    var index: Number = 0
    while index < list_count(environment.owners):
        set tokens = core_yir_owner_union(tokens, core_yir_owner_decode(list_get(environment.owners, index)))
        set index = index + 1
    set index = 0
    while index < list_count(environment.field_owners):
        set tokens = core_yir_owner_union(tokens, core_yir_owner_decode(list_get(environment.field_owners, index)))
        set index = index + 1
    return list_count(tokens)

fn core_yir_owner_scope_count(block: List[YirStatement]) -> Number:
    var count: Number = 0
    var statement_index: Number = 0
    while statement_index < list_count(block):
        let statement: YirStatement = list_get(block, statement_index)
        if statement.kind == "arena_scope": set count = count + 1
        set count = count + core_yir_owner_scope_count(statement.body)
        set count = count + core_yir_owner_scope_count(statement.alternate)
        var branch_index: Number = 0
        while branch_index < list_count(statement.branches):
            set count = count + core_yir_owner_scope_count(list_get(statement.branches, branch_index).body)
            set branch_index = branch_index + 1
        var arm_index: Number = 0
        while arm_index < list_count(statement.match_arms):
            set count = count + core_yir_owner_scope_count(list_get(statement.match_arms, arm_index).body)
            set arm_index = arm_index + 1
        set statement_index = statement_index + 1
    return count

fn core_yir_owner_analyze_loop_body(block: List[YirStatement], environment: YirOwnerEnvironment, context: YirOwnerContext, base_count: Number, location: Text) -> YirOwnerEnvironment:
    let possible_owner_count: Number = core_yir_owner_environment_token_count(environment) + core_yir_owner_scope_count(block) + list_count(context.regions) + 4
    let iteration_limit: Number = (base_count + 1) * (possible_owner_count + 1) + 2
    var loop_head: YirOwnerEnvironment = core_yir_owner_env_clone(environment)
    var converged: Boolean = false
    var iteration: Number = 0
    while iteration < iteration_limit and not converged:
        let body_environment: YirOwnerEnvironment = core_yir_owner_env_clone(loop_head)
        core_yir_owner_analyze_block(block, body_environment, context)
        let next_head: YirOwnerEnvironment = core_yir_owner_env_clone(loop_head)
        core_yir_owner_merge_environment(next_head, body_environment, base_count)
        set converged = core_yir_owner_environments_equal(loop_head, next_head, base_count)
        set loop_head = next_head
        set iteration = iteration + 1
    if not converged: fail("YIR ownership: loop dataflow did not converge" + location)
    return loop_head

fn core_yir_owner_match_payload_path(subject_type: Text, arm: YirMatchArm, binding: YirMatchBinding, context: YirOwnerContext) -> Text:
    if core_yir_option_payload_type(subject_type) != "":
        if arm.tag == 1 and binding.field_index == 0: return "@some"
        return ""
    if core_yir_result_argument_type(subject_type, 0) != "" and core_yir_result_argument_type(subject_type, 1) != "":
        if arm.tag == 1 and binding.field_index == 0: return "@ok"
        if arm.tag == 0 and binding.field_index == 0: return "@err"
        return ""
    if core_yir_find_variant(context.variants, subject_type) >= 0:
        return "@case." + number_text(arm.tag) + "." + number_text(binding.field_index)
    return ""

fn core_yir_owner_copy_alias_fields(target_slot: Text, value_type: Text, source: YirExpr, source_path: Text, target_path: Text, environment: YirOwnerEnvironment, context: YirOwnerContext, depth: Number) -> Number:
    if depth > 16: return 0
    if core_yir_list_element_type(value_type) != "":
        var collection: YirExpr = source
        var identity: Text = ""
        if source.kind == "index" or source.kind == "list_get" or source.kind == "list_try_get":
            var read_path: Text = source_path
            if read_path == "": set read_path = "@value"
            set identity = core_yir_owner_list_identity_from_read(source, read_path, environment, context)
        else:
            if source_path != "": set collection = core_yir_owner_project_list_expression(source, source.value_type, source_path, context, 0)
            set identity = core_yir_owner_list_identity(collection, environment, context)
        let identities: TextList = text_list()
        if identity != "": list_push(identities, identity)
        core_yir_owner_field_set(environment, "@listid::" + target_slot + "::" + target_path, identities)
        return 0
    let shape_index: Number = core_yir_find_shape(context.shapes, value_type)
    if shape_index >= 0:
        let shape: HirShape = list_get(context.shapes, shape_index)
        var field_index: Number = 0
        while field_index < list_count(shape.fields):
            let field: HirField = list_get(shape.fields, field_index)
            let field_path: Text = number_text(field_index)
            var source_field_path: Text = field_path
            var target_field_path: Text = field_path
            if source_path != "": set source_field_path = source_path + "." + field_path
            if target_path != "": set target_field_path = target_path + "." + field_path
            let field_owners: TextList = core_yir_owner_field_value(source, source_field_path, environment, context, depth + 1)
            core_yir_owner_field_set(environment, target_slot + "::" + target_field_path, field_owners)
            core_yir_owner_copy_alias_fields(target_slot, field.value_type, source, source_field_path, target_field_path, environment, context, depth + 1)
            set field_index = field_index + 1
        return 0
    let option_payload: Text = core_yir_option_payload_type(value_type)
    if option_payload != "":
        var payload_path: Text = "@some"
        if source_path != "": set payload_path = source_path + ".@some"
        var target_payload_path: Text = "@some"
        if target_path != "": set target_payload_path = target_path + ".@some"
        let payload_owners: TextList = core_yir_owner_field_value(source, payload_path, environment, context, depth + 1)
        core_yir_owner_field_set(environment, target_slot + "::" + target_payload_path, payload_owners)
        core_yir_owner_copy_alias_fields(target_slot, option_payload, source, payload_path, target_payload_path, environment, context, depth + 1)
        return 0
    let result_success: Text = core_yir_result_argument_type(value_type, 0)
    let result_error: Text = core_yir_result_argument_type(value_type, 1)
    if result_success != "" and result_error != "":
        var success_path: Text = "@ok"
        var error_path: Text = "@err"
        var target_success_path: Text = "@ok"
        var target_error_path: Text = "@err"
        if source_path != "":
            set success_path = source_path + ".@ok"
            set error_path = source_path + ".@err"
        if target_path != "":
            set target_success_path = target_path + ".@ok"
            set target_error_path = target_path + ".@err"
        let success_owners: TextList = core_yir_owner_field_value(source, success_path, environment, context, depth + 1)
        let error_owners: TextList = core_yir_owner_field_value(source, error_path, environment, context, depth + 1)
        core_yir_owner_field_set(environment, target_slot + "::" + target_success_path, success_owners)
        core_yir_owner_field_set(environment, target_slot + "::" + target_error_path, error_owners)
        core_yir_owner_copy_alias_fields(target_slot, result_success, source, success_path, target_success_path, environment, context, depth + 1)
        core_yir_owner_copy_alias_fields(target_slot, result_error, source, error_path, target_error_path, environment, context, depth + 1)
        return 0
    let variant_index: Number = core_yir_find_variant(context.variants, value_type)
    if variant_index >= 0:
        let variant: HirVariant = list_get(context.variants, variant_index)
        var case_index: Number = 0
        while case_index < list_count(variant.cases):
            let variant_case: HirVariantCase = list_get(variant.cases, case_index)
            var field_index: Number = 0
            while field_index < list_count(variant_case.fields):
                let field: HirField = list_get(variant_case.fields, field_index)
                var field_path: Text = "@case." + number_text(case_index) + "." + number_text(field_index)
                if source_path != "": set field_path = source_path + "." + field_path
                let field_owners: TextList = core_yir_owner_field_value(source, field_path, environment, context, depth + 1)
                let field_target_path: Text = "@case." + number_text(case_index) + "." + number_text(field_index)
                var nested_target_path: Text = field_target_path
                if target_path != "": set nested_target_path = target_path + "." + field_target_path
                core_yir_owner_field_set(environment, target_slot + "::" + nested_target_path, field_owners)
                core_yir_owner_copy_alias_fields(target_slot, field.value_type, source, field_path, nested_target_path, environment, context, depth + 1)
                set field_index = field_index + 1
            set case_index = case_index + 1
        return 0
    return 0

fn core_yir_owner_bind_match(arm: YirMatchArm, subject: YirExpr, matched_owners: TextList, environment: YirOwnerEnvironment, context: YirOwnerContext) -> Number:
    var binding_index: Number = 0
    let current: Text = core_yir_owner_current(context)
    while binding_index < list_count(arm.bindings):
        let binding: YirMatchBinding = list_get(arm.bindings, binding_index)
        var owners: TextList = text_list()
        let payload_path: Text = core_yir_owner_match_payload_path(subject.value_type, arm, binding, context)
        if payload_path != "": set owners = core_yir_owner_field_value(subject, payload_path, environment, context, 0)
        else:
            if core_yir_owner_type(binding.value_type, context.shapes, context.variants): set owners = core_yir_owner_copy(matched_owners)
        core_yir_owner_env_set(environment, binding.slot, binding.value_type, current, owners)
        if payload_path != "" and core_yir_owner_aggregate_type(binding.value_type, context.shapes, context.variants):
            core_yir_owner_copy_alias_fields(binding.slot, binding.value_type, subject, payload_path, "", environment, context, 0)
        set binding_index = binding_index + 1
    return 0

fn core_yir_owner_analyze_block(block: List[YirStatement], environment: YirOwnerEnvironment, context: YirOwnerContext) -> Number:
    var statement_index: Number = 0
    while statement_index < list_count(block):
        let statement: YirStatement = list_get(block, statement_index)
        if statement.kind == "let" or statement.kind == "var":
            let owners: TextList = core_yir_owner_expr(statement.expression, environment, context)
            let current: Text = core_yir_owner_current(context)
            core_yir_owner_check_store(owners, current, context, core_yir_yir_statement_location(statement))
            core_yir_owner_env_set(environment, statement.slot, statement.value_type, current, owners)
            core_yir_owner_record_list_variable_identity(statement.slot, statement.value_type, statement.expression, environment, context)
            core_yir_owner_update_aggregate_fields(statement.slot, statement.value_type, statement.expression, owners, environment, context, "", 0)
        if statement.kind == "set":
            let owners: TextList = core_yir_owner_expr(statement.expression, environment, context)
            let target_index: Number = core_yir_owner_env_index(environment, statement.slot)
            if target_index < 0: fail("YIR ownership: assignment target has no owner environment entry" + core_yir_yir_statement_location(statement))
            core_yir_owner_check_store(owners, list_get(environment.regions, target_index), context, core_yir_yir_statement_location(statement))
            core_yir_owner_env_set(environment, statement.slot, list_get(environment.types, target_index), list_get(environment.regions, target_index), owners)
            core_yir_owner_record_list_variable_identity(statement.slot, list_get(environment.types, target_index), statement.expression, environment, context)
            core_yir_owner_update_aggregate_fields(statement.slot, list_get(environment.types, target_index), statement.expression, owners, environment, context, "", 0)
        if statement.kind == "set_field":
            let owners: TextList = core_yir_owner_expr(statement.expression, environment, context)
            let target_index: Number = core_yir_owner_env_index(environment, statement.slot)
            if target_index < 0: fail("YIR ownership: field target has no owner environment entry" + core_yir_yir_statement_location(statement))
            let destination_region: Text = list_get(environment.regions, target_index)
            core_yir_owner_check_store(owners, destination_region, context, core_yir_yir_statement_location(statement))
            let combined: TextList = core_yir_owner_union(core_yir_owner_decode(list_get(environment.owners, target_index)), owners)
            core_yir_owner_env_set(environment, statement.slot, list_get(environment.types, target_index), destination_region, combined)
            var field_path: Text = ""
            var field_index: Number = 0
            while field_index < list_count(statement.field_path):
                if field_path != "": set field_path = field_path + "."
                set field_path = field_path + number_text(list_get(statement.field_path, field_index).field_index)
                set field_index = field_index + 1
            core_yir_owner_field_invalidate_path(environment, statement.slot, field_path, owners)
            core_yir_owner_field_set(environment, statement.slot + "::" + field_path, owners)
            let target_field: YirFieldPathStep = list_get(statement.field_path, list_count(statement.field_path) - 1)
            core_yir_owner_update_aggregate_fields(statement.slot, target_field.field_type, statement.expression, owners, environment, context, field_path, 0)
        if statement.kind == "match_expr":
            let matched_owners: TextList = core_yir_owner_expr(statement.expression, environment, context)
            if statement.slot2 == "let" or statement.slot2 == "var":
                core_yir_owner_env_set(environment, statement.slot, statement.value_type, core_yir_owner_current(context), text_list())
            let base_count: Number = list_count(environment.slots)
            var result_owners: TextList = text_list()
            var arm_index: Number = 0
            while arm_index < list_count(statement.match_arms):
                let arm: YirMatchArm = list_get(statement.match_arms, arm_index)
                let arm_environment: YirOwnerEnvironment = core_yir_owner_env_clone(environment)
                core_yir_owner_bind_match(arm, statement.expression, matched_owners, arm_environment, context)
                let arm_owners: TextList = core_yir_owner_expr(arm.result_expression, arm_environment, context)
                if statement.slot2 == "return":
                    core_yir_owner_check_store(arm_owners, "C", context, core_yir_yir_expression_location(arm.result_expression))
                    core_yir_owner_record_return_fields(arm.result_expression, arm_owners, arm_environment, context)
                    if list_count(arm_owners) > 0: list_push(context.returns, core_yir_owner_encode(arm_owners))
                else:
                    if statement.slot2 == "set":
                        let target_index: Number = core_yir_owner_env_index(arm_environment, statement.slot)
                        if target_index < 0: fail("YIR ownership: match assignment target has no owner entry" + core_yir_yir_statement_location(statement))
                        core_yir_owner_check_store(arm_owners, list_get(arm_environment.regions, target_index), context, core_yir_yir_expression_location(arm.result_expression))
                        core_yir_owner_env_set(arm_environment, statement.slot, list_get(arm_environment.types, target_index), list_get(arm_environment.regions, target_index), arm_owners)
                        core_yir_owner_update_aggregate_fields(statement.slot, list_get(arm_environment.types, target_index), arm.result_expression, arm_owners, arm_environment, context, "", 0)
                        core_yir_owner_merge_environment(environment, arm_environment, base_count)
                    else:
                        set result_owners = core_yir_owner_union(result_owners, arm_owners)
                        if statement.slot2 == "let" or statement.slot2 == "var":
                            core_yir_owner_update_aggregate_fields(statement.slot, statement.value_type, arm.result_expression, arm_owners, arm_environment, context, "", 0)
                            core_yir_owner_merge_environment(environment, arm_environment, base_count)
                set arm_index = arm_index + 1
            if statement.slot2 == "let" or statement.slot2 == "var":
                let current: Text = core_yir_owner_current(context)
                core_yir_owner_check_store(result_owners, current, context, core_yir_yir_statement_location(statement))
                core_yir_owner_env_set(environment, statement.slot, statement.value_type, current, result_owners)
        if statement.kind == "return":
            let owners: TextList = core_yir_owner_expr(statement.expression, environment, context)
            core_yir_owner_check_store(owners, "C", context, core_yir_yir_expression_location(statement.expression))
            core_yir_owner_record_return_fields(statement.expression, owners, environment, context)
            if list_count(owners) > 0: list_push(context.returns, core_yir_owner_encode(owners))
        if statement.kind == "expression" or statement.kind == "say" or statement.kind == "assert" or statement.kind == "defer":
            core_yir_owner_expr(statement.expression, environment, context)
        if statement.kind == "if":
            let base_count: Number = list_count(environment.slots)
            var branch_index: Number = 0
            while branch_index < list_count(statement.branches):
                let branch: YirBranch = list_get(statement.branches, branch_index)
                core_yir_owner_expr(branch.condition, environment, context)
                let branch_environment: YirOwnerEnvironment = core_yir_owner_env_clone(environment)
                core_yir_owner_analyze_block(branch.body, branch_environment, context)
                core_yir_owner_merge_environment(environment, branch_environment, base_count)
                set branch_index = branch_index + 1
            if statement.has_else:
                let alternate_environment: YirOwnerEnvironment = core_yir_owner_env_clone(environment)
                core_yir_owner_analyze_block(statement.alternate, alternate_environment, context)
                core_yir_owner_merge_environment(environment, alternate_environment, base_count)
        if statement.kind == "arena_scope":
            core_yir_owner_expr(statement.expression, environment, context)
            let child_context: YirOwnerContext = core_yir_owner_child_context(context, statement.slot)
            core_yir_owner_analyze_block(statement.body, environment, child_context)
        if statement.kind == "match":
            let matched_owners: TextList = core_yir_owner_expr(statement.expression, environment, context)
            let base_count: Number = list_count(environment.slots)
            var arm_index: Number = 0
            while arm_index < list_count(statement.match_arms):
                let arm: YirMatchArm = list_get(statement.match_arms, arm_index)
                let arm_environment: YirOwnerEnvironment = core_yir_owner_env_clone(environment)
                core_yir_owner_bind_match(arm, statement.expression, matched_owners, arm_environment, context)
                core_yir_owner_analyze_block(arm.body, arm_environment, context)
                core_yir_owner_merge_environment(environment, arm_environment, base_count)
                set arm_index = arm_index + 1
        if statement.kind == "while":
            core_yir_owner_expr(statement.expression, environment, context)
            let base_count: Number = list_count(environment.slots)
            let loop_environment: YirOwnerEnvironment = core_yir_owner_analyze_loop_body(statement.body, environment, context, base_count, core_yir_yir_statement_location(statement))
            core_yir_owner_merge_environment(environment, loop_environment, base_count)
        if statement.kind == "for_range":
            core_yir_owner_expr(statement.expression, environment, context)
            core_yir_owner_expr(statement.expression2, environment, context)
            let base_count: Number = list_count(environment.slots)
            let loop_environment: YirOwnerEnvironment = core_yir_owner_env_clone(environment)
            core_yir_owner_env_set(loop_environment, statement.slot, "Number", core_yir_owner_current(context), text_list())
            let loop_result: YirOwnerEnvironment = core_yir_owner_analyze_loop_body(statement.body, loop_environment, context, base_count, core_yir_yir_statement_location(statement))
            core_yir_owner_merge_environment(environment, loop_result, base_count)
        if statement.kind == "for_each":
            let read_children: List[YirExpr] = List[YirExpr]()
            list_push(read_children, statement.expression)
            list_push(read_children, core_yir_expr("number", "0", "Number", List[YirExpr](), statement.source_line))
            let item_expression: YirExpr = core_yir_expr("list_get", statement.expression.value_type, statement.value_type, read_children, statement.source_line)
            let item_owners: TextList = core_yir_owner_expr(item_expression, environment, context)
            let base_count: Number = list_count(environment.slots)
            let loop_environment: YirOwnerEnvironment = core_yir_owner_env_clone(environment)
            core_yir_owner_env_set(loop_environment, statement.slot, statement.value_type, core_yir_owner_current(context), item_owners)
            if core_yir_owner_aggregate_type(statement.value_type, context.shapes, context.variants):
                core_yir_owner_update_aggregate_fields(statement.slot, statement.value_type, item_expression, item_owners, loop_environment, context, "", 0)
            core_yir_owner_env_set(loop_environment, statement.slot2, "Number", core_yir_owner_current(context), text_list())
            let loop_result: YirOwnerEnvironment = core_yir_owner_analyze_loop_body(statement.body, loop_environment, context, base_count, core_yir_yir_statement_location(statement))
            core_yir_owner_merge_environment(environment, loop_result, base_count)
        set statement_index = statement_index + 1
    return 0

fn core_yir_owner_effect_exists(effects: List[YirOwnerEffect], sought: YirOwnerEffect) -> Boolean:
    var index: Number = 0
    while index < list_count(effects):
        let existing: YirOwnerEffect = list_get(effects, index)
        if core_yir_owner_sets_equal(existing.destination, sought.destination) and core_yir_owner_sets_equal(existing.value, sought.value): return true
        set index = index + 1
    return false

fn core_yir_owner_merge_summary(summaries: List[YirOwnerSummary], summary_index: Number, origins: TextList, effects: List[YirOwnerEffect], list_effects: List[YirOwnerListEffect], return_field_paths: TextList, return_field_owners: TextList) -> Boolean:
    let prior: YirOwnerSummary = list_get(summaries, summary_index)
    let merged_origins: TextList = core_yir_owner_union(prior.origins, origins)
    let merged_effects: List[YirOwnerEffect] = List[YirOwnerEffect]()
    var effect_index: Number = 0
    while effect_index < list_count(prior.effects):
        list_push(merged_effects, list_get(prior.effects, effect_index))
        set effect_index = effect_index + 1
    set effect_index = 0
    while effect_index < list_count(effects):
        let effect: YirOwnerEffect = list_get(effects, effect_index)
        if not core_yir_owner_effect_exists(merged_effects, effect): list_push(merged_effects, effect)
        set effect_index = effect_index + 1
    let merged_list_effects: List[YirOwnerListEffect] = List[YirOwnerListEffect]()
    set effect_index = 0
    while effect_index < list_count(prior.list_effects):
        list_push(merged_list_effects, list_get(prior.list_effects, effect_index))
        set effect_index = effect_index + 1
    set effect_index = 0
    while effect_index < list_count(list_effects):
        let list_effect: YirOwnerListEffect = list_get(list_effects, effect_index)
        var already_present: Boolean = false
        var merged_index: Number = 0
        while merged_index < list_count(merged_list_effects):
            if core_yir_owner_list_effect_equal(list_get(merged_list_effects, merged_index), list_effect): set already_present = true
            set merged_index = merged_index + 1
        if not already_present: list_push(merged_list_effects, list_effect)
        set effect_index = effect_index + 1
    var fields_changed: Boolean = list_count(prior.return_field_paths) != list_count(return_field_paths)
    var field_index: Number = 0
    while field_index < list_count(prior.return_field_paths) and field_index < list_count(return_field_paths) and not fields_changed:
        if list_get(prior.return_field_paths, field_index) != list_get(return_field_paths, field_index):
            set fields_changed = true
        else:
            let prior_owners: TextList = core_yir_owner_decode(list_get(prior.return_field_owners, field_index))
            let next_owners: TextList = core_yir_owner_decode(list_get(return_field_owners, field_index))
            if not core_yir_owner_sets_equal(prior_owners, next_owners): set fields_changed = true
        set field_index = field_index + 1
    let changed: Boolean = not core_yir_owner_sets_equal(prior.origins, merged_origins) or list_count(merged_effects) != list_count(prior.effects) or list_count(merged_list_effects) != list_count(prior.list_effects) or fields_changed
    list_set(summaries, summary_index, YirOwnerSummary(prior.function_name, merged_origins, merged_effects, merged_list_effects, core_yir_owner_copy(return_field_paths), core_yir_owner_copy(return_field_owners)))
    return changed

fn core_yir_owner_analyze_function(program: YirProgram, function: YirFunction, summaries: List[YirOwnerSummary]) -> Boolean:
    var context: YirOwnerContext = core_yir_owner_context_new(program)
    set context.summaries = summaries
    let environment: YirOwnerEnvironment = YirOwnerEnvironment(text_list(), text_list(), text_list(), text_list(), text_list(), text_list())
    var parameter_index: Number = 0
    while parameter_index < list_count(function.parameters):
        let parameter: YirParameter = list_get(function.parameters, parameter_index)
        let owners: TextList = text_list()
        if core_yir_owner_type(parameter.value_type, program.shapes, program.variants): list_push(owners, "P" + number_text(parameter_index))
        core_yir_owner_env_set(environment, parameter.slot, parameter.value_type, "C", owners)
        core_yir_owner_seed_parameter_fields(parameter.slot, parameter.value_type, parameter_index, "", environment, context, 0)
        set parameter_index = parameter_index + 1
    core_yir_owner_analyze_block(function.body, environment, context)
    var origins: TextList = text_list()
    var return_index: Number = 0
    while return_index < list_count(context.returns):
        set origins = core_yir_owner_union(origins, core_yir_owner_decode(list_get(context.returns, return_index)))
        set return_index = return_index + 1
    let return_field_paths: TextList = text_list()
    let return_field_owners: TextList = text_list()
    var field_index: Number = 1
    while field_index < list_count(context.return_field_paths):
        let path: Text = list_get(context.return_field_paths, field_index)
        if path != "":
            list_push(return_field_paths, path)
            list_push(return_field_owners, list_get(context.return_field_owners, field_index))
        set field_index = field_index + 1
    return core_yir_owner_merge_summary(summaries, core_yir_owner_find_summary(summaries, function.name), origins, context.effects, context.list_effects, return_field_paths, return_field_owners)

fn core_yir_owner_has_scope_block(block: List[YirStatement]) -> Boolean:
    var statement_index: Number = 0
    while statement_index < list_count(block):
        let statement: YirStatement = list_get(block, statement_index)
        if statement.kind == "arena_scope": return true
        if core_yir_owner_has_scope_block(statement.body) or core_yir_owner_has_scope_block(statement.alternate): return true
        var branch_index: Number = 0
        while branch_index < list_count(statement.branches):
            if core_yir_owner_has_scope_block(list_get(statement.branches, branch_index).body): return true
            set branch_index = branch_index + 1
        var arm_index: Number = 0
        while arm_index < list_count(statement.match_arms):
            if core_yir_owner_has_scope_block(list_get(statement.match_arms, arm_index).body): return true
            set arm_index = arm_index + 1
        set statement_index = statement_index + 1
    return false

fn core_yir_verify_ownership(program: YirProgram) -> Number:
    var has_scope: Boolean = core_yir_owner_has_scope_block(program.body)
    var function_index: Number = 0
    while function_index < list_count(program.functions) and not has_scope:
        if core_yir_owner_has_scope_block(list_get(program.functions, function_index).body): set has_scope = true
        set function_index = function_index + 1
    if not has_scope: return 0
    let summaries: List[YirOwnerSummary] = List[YirOwnerSummary]()
    set function_index = 0
    while function_index < list_count(program.functions):
        list_push(summaries, YirOwnerSummary(list_get(program.functions, function_index).name, text_list(), List[YirOwnerEffect](), List[YirOwnerListEffect](), text_list(), text_list()))
        set function_index = function_index + 1
    var changed: Boolean = true
    var iteration: Number = 0
    let iteration_limit: Number = list_count(program.functions) * 2 + 8
    while changed and iteration < iteration_limit:
        set changed = false
        set function_index = 0
        while function_index < list_count(program.functions):
            let function: YirFunction = list_get(program.functions, function_index)
            if core_yir_owner_analyze_function(program, function, summaries): set changed = true
            set function_index = function_index + 1
        set iteration = iteration + 1
    if changed: fail("YIR ownership: function ownership summaries did not converge")
    set function_index = 0
    while function_index < list_count(program.functions):
        core_yir_owner_analyze_function(program, list_get(program.functions, function_index), summaries)
        set function_index = function_index + 1
    var context: YirOwnerContext = core_yir_owner_context_new(program)
    set context.summaries = summaries
    let environment: YirOwnerEnvironment = YirOwnerEnvironment(text_list(), text_list(), text_list(), text_list(), text_list(), text_list())
    core_yir_owner_analyze_block(program.body, environment, context)
    return 0

shape YirBorrowState:
    slots: TextList
    names: TextList
    types: TextList
    states: TextList
    borrow_targets: TextList
    shared_counts: List[Number]
    mut_borrowers: TextList

fn core_yir_borrow_state_new() -> YirBorrowState:
    return YirBorrowState(text_list(), text_list(), text_list(), text_list(), text_list(), List[Number](), text_list())

fn core_yir_borrow_state_clone(src: YirBorrowState) -> YirBorrowState:
    let cloned_slots: TextList = text_list()
    let cloned_names: TextList = text_list()
    let cloned_types: TextList = text_list()
    let cloned_states: TextList = text_list()
    let cloned_targets: TextList = text_list()
    let cloned_counts: List[Number] = List[Number]()
    let cloned_mut: TextList = text_list()
    var i: Number = 0
    while i < list_count(src.slots):
        list_push(cloned_slots, list_get(src.slots, i))
        list_push(cloned_names, list_get(src.names, i))
        list_push(cloned_types, list_get(src.types, i))
        list_push(cloned_states, list_get(src.states, i))
        list_push(cloned_targets, list_get(src.borrow_targets, i))
        list_push(cloned_counts, list_get(src.shared_counts, i))
        list_push(cloned_mut, list_get(src.mut_borrowers, i))
        set i = i + 1
    return YirBorrowState(cloned_slots, cloned_names, cloned_types, cloned_states, cloned_targets, cloned_counts, cloned_mut)

fn core_yir_borrow_state_find(state: YirBorrowState, slot: Text) -> Number:
    var i: Number = 0
    while i < list_count(state.slots):
        if list_get(state.slots, i) == slot: return i
        set i = i + 1
    return -1

fn core_yir_borrow_state_add(state: YirBorrowState, slot: Text, name: Text, value_type: Text, init_state: Text) -> Number:
    list_push(state.slots, slot)
    list_push(state.names, name)
    list_push(state.types, value_type)
    list_push(state.states, init_state)
    list_push(state.borrow_targets, "")
    list_push(state.shared_counts, 0)
    list_push(state.mut_borrowers, "")
    return 0

fn core_yir_borrow_release(state: YirBorrowState, borrower_slot: Text) -> Number:
    let b_idx: Number = core_yir_borrow_state_find(state, borrower_slot)
    if b_idx < 0: return 0
    let target_slot: Text = list_get(state.borrow_targets, b_idx)
    if target_slot == "": return 0
    let t_idx: Number = core_yir_borrow_state_find(state, target_slot)
    if t_idx >= 0:
        if list_get(state.mut_borrowers, t_idx) == borrower_slot:
            list_set(state.mut_borrowers, t_idx, "")
            list_set(state.states, t_idx, "owned")
        else:
            let count: Number = list_get(state.shared_counts, t_idx)
            if count > 1:
                list_set(state.shared_counts, t_idx, count - 1)
            else:
                list_set(state.shared_counts, t_idx, 0)
                list_set(state.states, t_idx, "owned")
    list_set(state.borrow_targets, b_idx, "")
    return 0

fn core_yir_check_borrow_expr(expr: YirExpr, state: YirBorrowState, functions: List[YirFunction], in_move: Boolean, in_borrow: Boolean, in_borrow_mut: Boolean) -> Number:
    if expr.kind == "move":
        if list_count(expr.children) > 0:
            let child: YirExpr = list_get(expr.children, 0)
            if child.kind == "variable":
                let idx: Number = core_yir_borrow_state_find(state, child.value)
                if idx >= 0:
                    let name: Text = list_get(state.names, idx)
                    let st: Text = list_get(state.states, idx)
                    let vt: Text = list_get(state.types, idx)
                    if core_yir_is_borrow_type(vt):
                        fail("LLVM Core ownership: cannot move out of borrowed reference '" + name + "'" + core_yir_yir_expression_location(expr))
                    if st == "moved":
                        fail("LLVM Core ownership: use of moved value '" + name + "'" + core_yir_yir_expression_location(expr))
                    if st == "borrowed_mut" or st == "borrowed_shared" or list_get(state.shared_counts, idx) > 0 or list_get(state.mut_borrowers, idx) != "":
                        fail("LLVM Core ownership: cannot move '" + name + "' while borrowed" + core_yir_yir_expression_location(expr))
                    list_set(state.states, idx, "moved")
            core_yir_check_borrow_expr(child, state, functions, true, false, false)
        return 0
    if expr.kind == "borrow":
        if list_count(expr.children) > 0:
            let child: YirExpr = list_get(expr.children, 0)
            if child.kind == "variable":
                let idx: Number = core_yir_borrow_state_find(state, child.value)
                if idx >= 0:
                    let name: Text = list_get(state.names, idx)
                    let st: Text = list_get(state.states, idx)
                    if st == "moved":
                        fail("LLVM Core ownership: use of moved value '" + name + "'" + core_yir_yir_expression_location(expr))
                    if st == "borrowed_mut" or list_get(state.mut_borrowers, idx) != "":
                        fail("LLVM Core ownership: cannot borrow '" + name + "' as shared while borrowed as mutable" + core_yir_yir_expression_location(expr))
            core_yir_check_borrow_expr(child, state, functions, false, true, false)
        return 0
    if expr.kind == "borrow_mut":
        if list_count(expr.children) > 0:
            let child: YirExpr = list_get(expr.children, 0)
            if child.kind == "variable":
                let idx: Number = core_yir_borrow_state_find(state, child.value)
                if idx >= 0:
                    let name: Text = list_get(state.names, idx)
                    let st: Text = list_get(state.states, idx)
                    let vt: Text = list_get(state.types, idx)
                    if text_starts_with(vt, "&") and not text_starts_with(vt, "&mut "):
                        fail("LLVM Core ownership: cannot borrow '" + name + "' as mutable through immutable reference" + core_yir_yir_expression_location(expr))
                    if st == "moved":
                        fail("LLVM Core ownership: use of moved value '" + name + "'" + core_yir_yir_expression_location(expr))
                    if st == "borrowed_mut" or list_get(state.mut_borrowers, idx) != "":
                        fail("LLVM Core ownership: cannot borrow '" + name + "' as mutable more than once at a time" + core_yir_yir_expression_location(expr))
                    if st == "borrowed_shared" or list_get(state.shared_counts, idx) > 0:
                        fail("LLVM Core ownership: cannot borrow '" + name + "' as mutable while borrowed as shared" + core_yir_yir_expression_location(expr))
            core_yir_check_borrow_expr(child, state, functions, false, false, true)
        return 0
    if expr.kind == "variable":
        if not in_move and not in_borrow and not in_borrow_mut:
            let idx: Number = core_yir_borrow_state_find(state, expr.value)
            if idx >= 0:
                let name: Text = list_get(state.names, idx)
                let st: Text = list_get(state.states, idx)
                if st == "moved":
                    fail("LLVM Core ownership: use of moved value '" + name + "'" + core_yir_yir_expression_location(expr))
                if st == "borrowed_mut" or list_get(state.mut_borrowers, idx) != "":
                    fail("LLVM Core ownership: cannot use '" + name + "' while borrowed as mutable" + core_yir_yir_expression_location(expr))
        return 0
    if expr.kind == "call":
        var arg_i: Number = 0
        while arg_i < list_count(expr.children):
            let arg1: YirExpr = list_get(expr.children, arg_i)
            var var1: Text = ""
            if arg1.kind == "borrow_mut" and list_count(arg1.children) > 0 and list_get(arg1.children, 0).kind == "variable":
                set var1 = list_get(arg1.children, 0).value
            if var1 != "":
                var arg_j: Number = 0
                while arg_j < list_count(expr.children):
                    if arg_i != arg_j:
                        let arg2: YirExpr = list_get(expr.children, arg_j)
                        var var2: Text = ""
                        if (arg2.kind == "borrow_mut" or arg2.kind == "borrow" or arg2.kind == "move") and list_count(arg2.children) > 0 and list_get(arg2.children, 0).kind == "variable":
                            set var2 = list_get(arg2.children, 0).value
                        if arg2.kind == "variable":
                            set var2 = arg2.value
                        if var1 == var2 and var1 != "":
                            let idx: Number = core_yir_borrow_state_find(state, var1)
                            var name: Text = var1
                            if idx >= 0: set name = list_get(state.names, idx)
                            fail("LLVM Core ownership: overlapping mutable borrow of '" + name + "' in function call" + core_yir_yir_expression_location(expr))
                    set arg_j = arg_j + 1
            set arg_i = arg_i + 1
        var child_idx: Number = 0
        while child_idx < list_count(expr.children):
            core_yir_check_borrow_expr(list_get(expr.children, child_idx), state, functions, false, false, false)
            set child_idx = child_idx + 1
        return 0
    var child_idx: Number = 0
    while child_idx < list_count(expr.children):
        core_yir_check_borrow_expr(list_get(expr.children, child_idx), state, functions, in_move, in_borrow, in_borrow_mut)
        set child_idx = child_idx + 1
    return 0

fn core_yir_check_borrow_block(block: List[YirStatement], state: YirBorrowState, functions: List[YirFunction], in_loop: Boolean) -> Number:
    let base_var_count: Number = list_count(state.slots)
    var stmt_idx: Number = 0
    while stmt_idx < list_count(block):
        let stmt: YirStatement = list_get(block, stmt_idx)
        if stmt.kind == "let" or stmt.kind == "var":
            core_yir_check_borrow_expr(stmt.expression, state, functions, false, false, false)
            var init_st: Text = "owned"
            var target_slot: Text = ""
            var is_mut_borrow: Boolean = false
            if stmt.expression.kind == "borrow" and list_count(stmt.expression.children) > 0 and list_get(stmt.expression.children, 0).kind == "variable":
                set target_slot = list_get(stmt.expression.children, 0).value
            if stmt.expression.kind == "borrow_mut" and list_count(stmt.expression.children) > 0 and list_get(stmt.expression.children, 0).kind == "variable":
                set target_slot = list_get(stmt.expression.children, 0).value
                set is_mut_borrow = true
            core_yir_borrow_state_add(state, stmt.slot, stmt.name, stmt.value_type, init_st)
            let new_idx: Number = list_count(state.slots) - 1
            if target_slot != "":
                let t_idx: Number = core_yir_borrow_state_find(state, target_slot)
                if t_idx >= 0:
                    list_set(state.borrow_targets, new_idx, target_slot)
                    if is_mut_borrow:
                        list_set(state.states, t_idx, "borrowed_mut")
                        list_set(state.mut_borrowers, t_idx, stmt.slot)
                    else:
                        list_set(state.states, t_idx, "borrowed_shared")
                        list_set(state.shared_counts, t_idx, list_get(state.shared_counts, t_idx) + 1)
        else:
            if stmt.kind == "set":
                core_yir_check_borrow_expr(stmt.expression, state, functions, false, false, false)
                let idx: Number = core_yir_borrow_state_find(state, stmt.slot)
                if idx >= 0:
                    let st: Text = list_get(state.states, idx)
                    if st == "borrowed_mut" or st == "borrowed_shared" or list_get(state.shared_counts, idx) > 0 or list_get(state.mut_borrowers, idx) != "":
                        fail("LLVM Core ownership: cannot assign to '" + stmt.name + "' while borrowed" + core_yir_yir_statement_location(stmt))
                    list_set(state.states, idx, "owned")
            else:
                if stmt.kind == "set_field":
                    let idx: Number = core_yir_borrow_state_find(state, stmt.slot)
                    if idx >= 0:
                        let st: Text = list_get(state.states, idx)
                        if st == "moved":
                            fail("LLVM Core ownership: use of moved value '" + stmt.name + "'" + core_yir_yir_statement_location(stmt))
                    core_yir_check_borrow_expr(stmt.expression, state, functions, false, false, false)
                else:
                    if stmt.kind == "if":
                        core_yir_check_borrow_expr(stmt.expression, state, functions, false, false, false)
                        let then_state: YirBorrowState = core_yir_borrow_state_clone(state)
                        core_yir_check_borrow_block(stmt.body, then_state, functions, in_loop)
                        var branch_i: Number = 0
                        while branch_i < list_count(stmt.branches):
                            let br: YirBranch = list_get(stmt.branches, branch_i)
                            core_yir_check_borrow_expr(br.condition, state, functions, false, false, false)
                            let br_state: YirBorrowState = core_yir_borrow_state_clone(state)
                            core_yir_check_borrow_block(br.body, br_state, functions, in_loop)
                            set branch_i = branch_i + 1
                        if list_count(stmt.alternate) > 0:
                            let else_state: YirBorrowState = core_yir_borrow_state_clone(state)
                            core_yir_check_borrow_block(stmt.alternate, else_state, functions, in_loop)
                            var v_idx: Number = 0
                            while v_idx < base_var_count:
                                if list_get(then_state.states, v_idx) == "moved" and list_get(else_state.states, v_idx) == "moved":
                                    list_set(state.states, v_idx, "moved")
                                set v_idx = v_idx + 1
                    else:
                        if stmt.kind == "while":
                            core_yir_check_borrow_expr(stmt.expression, state, functions, false, false, false)
                            let loop_state: YirBorrowState = core_yir_borrow_state_clone(state)
                            core_yir_check_borrow_block(stmt.body, loop_state, functions, true)
                            var v_idx: Number = 0
                            while v_idx < base_var_count:
                                if list_get(state.states, v_idx) == "owned" and list_get(loop_state.states, v_idx) == "moved":
                                    fail("LLVM Core ownership: cannot move value in loop without reinitializing" + core_yir_yir_statement_location(stmt))
                                set v_idx = v_idx + 1
                        else:
                            core_yir_check_borrow_expr(stmt.expression, state, functions, false, false, false)
                            core_yir_check_borrow_expr(stmt.expression2, state, functions, false, false, false)
                            if list_count(stmt.body) > 0:
                                core_yir_check_borrow_block(stmt.body, state, functions, in_loop)
        set stmt_idx = stmt_idx + 1
    var r_idx: Number = list_count(state.slots) - 1
    while r_idx >= base_var_count:
        core_yir_borrow_release(state, list_get(state.slots, r_idx))
        set r_idx = r_idx - 1
    return 0

fn core_yir_verify_borrow_and_moves(program: YirProgram) -> Number:
    var func_idx: Number = 0
    while func_idx < list_count(program.functions):
        let f: YirFunction = list_get(program.functions, func_idx)
        let state: YirBorrowState = core_yir_borrow_state_new()
        var param_idx: Number = 0
        while param_idx < list_count(f.parameters):
            let p: YirParameter = list_get(f.parameters, param_idx)
            core_yir_borrow_state_add(state, p.slot, p.name, p.value_type, "owned")
            set param_idx = param_idx + 1
        core_yir_check_borrow_block(f.body, state, program.functions, false)
        set func_idx = func_idx + 1
    let main_state: YirBorrowState = core_yir_borrow_state_new()
    core_yir_check_borrow_block(program.body, main_state, program.functions, false)
    return 0

fn verify_core_yir(program: YirProgram) -> Number:
    if list_count(program.body) == 0: fail("YIR verifier: the start block must contain at least one statement")
    if program.start_source_line < 1 or program.start_source_column < 1 or program.start_source_end_column < program.start_source_column: fail("YIR verifier: malformed start header source span" + core_yir_source_location(program.start_source_file, program.start_source_line, program.start_source_column, program.start_source_end_column))
    var variant_index: Number = 0
    while variant_index < list_count(program.variants):
        let variant: HirVariant = list_get(program.variants, variant_index)
        let variant_location: Text = core_yir_source_location(variant.source_file, variant.source_line, variant.source_column, variant.name_end_column)
        if variant.name == "" or core_yir_find_variant(program.variants, variant.name) != variant_index: fail("YIR verifier: empty or duplicate variant name" + variant_location)
        if core_yir_reserved_decl_type_name(variant.name): fail("YIR verifier: variant name conflicts with a built-in type" + variant_location)
        if core_yir_find_shape(program.shapes, variant.name) >= 0: fail("YIR verifier: shape and variant names conflict" + variant_location)
        var case_index: Number = 0
        while case_index < list_count(variant.cases):
            let variant_case: HirVariantCase = list_get(variant.cases, case_index)
            let case_location: Text = core_yir_source_location(variant_case.source_file, variant_case.source_line, variant_case.source_column, variant_case.name_end_column)
            if variant_case.name == "" or core_yir_find_variant_case(variant, variant_case.name) != case_index: fail("YIR verifier: empty or duplicate variant case" + case_location)
            var field_index: Number = 0
            while field_index < list_count(variant_case.fields):
                let field: HirField = list_get(variant_case.fields, field_index)
                let field_location: Text = core_yir_source_location(field.source_file, field.source_line, field.source_column, field.name_end_column)
                if field.name == "" or field.value_type == "Unit" or not core_yir_known_type(field.value_type, program.shapes, program.variants): fail("YIR verifier: malformed variant payload field" + field_location)
                var prior_field_index: Number = 0
                while prior_field_index < field_index:
                    if list_get(variant_case.fields, prior_field_index).name == field.name: fail("YIR verifier: duplicate variant payload field" + field_location)
                    set prior_field_index = prior_field_index + 1
                set field_index = field_index + 1
            set case_index = case_index + 1
        set variant_index = variant_index + 1
    var shape_index: Number = 0
    while shape_index < list_count(program.shapes):
        let shape: HirShape = list_get(program.shapes, shape_index)
        let shape_location: Text = core_yir_source_location(shape.source_file, shape.source_line, shape.source_column, shape.name_end_column)
        if shape.name == "" or core_yir_find_shape(program.shapes, shape.name) != shape_index: fail("YIR verifier: empty or duplicate shape name" + shape_location)
        if core_yir_reserved_decl_type_name(shape.name): fail("YIR verifier: shape name conflicts with a built-in type" + shape_location)
        if core_yir_find_variant(program.variants, shape.name) >= 0: fail("YIR verifier: shape and variant names conflict" + shape_location)
        var field_index: Number = 0
        while field_index < list_count(shape.fields):
            let field: HirField = list_get(shape.fields, field_index)
            let field_location: Text = core_yir_source_location(field.source_file, field.source_line, field.source_column, field.name_end_column)
            if field.name == "" or field.value_type == "Unit" or not core_yir_known_type(field.value_type, program.shapes, program.variants): fail("YIR verifier: malformed shape field" + field_location)
            var prior_field_index: Number = 0
            while prior_field_index < field_index:
                if list_get(shape.fields, prior_field_index).name == field.name: fail("YIR verifier: duplicate shape field" + field_location)
                set prior_field_index = prior_field_index + 1
            set field_index = field_index + 1
        set shape_index = shape_index + 1
    var function_index: Number = 0
    while function_index < list_count(program.functions):
        let function: YirFunction = list_get(program.functions, function_index)
        let function_location: Text = core_yir_source_location(function.source_file, function.source_line, function.source_column, function.source_end_column)
        let return_type_location: Text = core_yir_function_return_type_location(function)
        if function.name == "" or core_yir_find_lowered_function(program.functions, function.name) != function_index: fail("YIR verifier: empty or duplicate function name '" + function.name + "'" + function_location)
        if function.source_line < 1 or function.source_column < 1 or function.source_end_column < function.source_column: fail("YIR verifier: malformed function source span")
        if function.header_source_column < 1 or function.header_source_end_column < function.header_source_column: fail("YIR verifier: malformed function header source span")
        if function.return_type_column < 1 or function.return_type_end_column < function.return_type_column: fail("YIR verifier: malformed function return-type source span")
        if core_yir_find_shape(program.shapes, function.name) >= 0 or core_yir_find_variant(program.variants, function.name) >= 0: fail("YIR verifier: function name conflicts with a declared type" + function_location)
        if not core_yir_known_type(function.return_type, program.shapes, program.variants) or core_yir_type_contains_list_view(function.return_type): fail("YIR verifier: unsupported or escaping function return type" + return_type_location)
        if list_count(function.body) == 0: fail("YIR verifier: function body cannot be empty" + function_location)
        let names: TextList = text_list()
        let slots: TextList = text_list()
        let types: TextList = text_list()
        let mutabilities: TextList = text_list()
        var visible: Number = 0
        var parameter_index: Number = 0
        while parameter_index < list_count(function.parameters):
            let parameter: YirParameter = list_get(function.parameters, parameter_index)
            if parameter.name == "" or parameter.value_type == "Unit" or not core_yir_known_type(parameter.value_type, program.shapes, program.variants): fail("YIR verifier: malformed parameter" + core_yir_parameter_type_location(parameter))
            if parameter.slot != "%arg" + number_text(parameter_index): fail("YIR verifier: malformed parameter slot" + core_yir_parameter_name_location(parameter))
            var param_mut: Text = "let"
            if core_yir_is_mut_borrow_type(parameter.value_type): set param_mut = "var"
            set visible = core_yir_verify_bind(names, slots, types, mutabilities, visible, parameter.name, parameter.slot, parameter.value_type, param_mut, program.shapes, program.variants, core_yir_parameter_name_location(parameter))
            set parameter_index = parameter_index + 1
        var function_statement_index: Number = 0
        var saw_top_level_return: Boolean = false
        while function_statement_index < list_count(function.body):
            let function_statement: YirStatement = list_get(function.body, function_statement_index)
            if saw_top_level_return: fail("YIR verifier: return must be the final function statement" + core_yir_yir_statement_location(function_statement))
            if function_statement.kind == "return" or (function_statement.kind == "match_expr" and function_statement.slot2 == "return"):
                set saw_top_level_return = true
            set function_statement_index = function_statement_index + 1
        set function_index = function_index + 1
        core_yir_verify_block(function.body, program.functions, program.shapes, program.variants, names, slots, types, mutabilities, visible, function.return_type, 0, true)
        if function.return_type != "Unit" and not core_yir_sequence_guarantees_return(function.body, 0):
            fail("YIR verifier: function may fall through without returning" + function_location)
    let start_names: TextList = text_list()
    let start_slots: TextList = text_list()
    let start_types: TextList = text_list()
    let start_mutabilities: TextList = text_list()
    core_yir_verify_block(program.body, program.functions, program.shapes, program.variants, start_names, start_slots, start_types, start_mutabilities, 0, "Unit", 0, false)
    core_yir_verify_ownership(program)
    core_yir_verify_borrow_and_moves(program)
    return 0

fn core_yir_render_expr(expression: YirExpr) -> Text:
    if expression.kind == "number" or expression.kind == "float" or expression.kind == "boolean": return expression.value
    if expression.kind == "text": return "\"" + expression.value + "\""
    if expression.kind == "unit": return "unit"
    if expression.kind == "try" or expression.kind == "try_return": return core_yir_render_expr(list_get(expression.children, 0)) + "?"
    if expression.kind == "option_none": return "none"
    if expression.kind == "fallible_sum": return expression.value2 + "_try(" + core_yir_render_expr(list_get(expression.children, 0)) + ")"
    if expression.kind == "fallible_variant":
        let arguments: TextList = text_list()
        var payload_index: Number = 0
        while payload_index < list_count(expression.children):
            list_push(arguments, core_yir_render_expr(list_get(expression.children, payload_index)))
            set payload_index = payload_index + 1
        return "variant_try(" + expression.value + ".case." + expression.value2 + "(" + text_join(arguments, ", ") + "))"
    if expression.kind == "fallible_interpolate": return "text_try_interpolate(\"" + expression.value + "\")"
    if expression.kind == "fallible_list_try_get":
        let arguments: TextList = text_list()
        var get_argument_index: Number = 0
        while get_argument_index < list_count(expression.children):
            list_push(arguments, core_yir_render_expr(list_get(expression.children, get_argument_index)))
            set get_argument_index = get_argument_index + 1
        return "list_try_get_result(" + text_join(arguments, ", ") + ")"
    if expression.kind == "option_some" or expression.kind == "result_ok" or expression.kind == "result_err":
        var constructor: Text = "some"
        if expression.kind == "result_ok": set constructor = "ok"
        if expression.kind == "result_err": set constructor = "err"
        return constructor + "(" + core_yir_render_expr(list_get(expression.children, 0)) + ")"
    if expression.kind == "option_is_some" or expression.kind == "option_unwrap" or expression.kind == "result_is_ok" or expression.kind == "result_unwrap" or expression.kind == "result_unwrap_error":
        return expression.kind + "(" + core_yir_render_expr(list_get(expression.children, 0)) + ")"
    if expression.kind == "list_count" or expression.kind == "list_push" or expression.kind == "list_try_push" or expression.kind == "list_try_reserve" or expression.kind == "list_get" or expression.kind == "list_try_get" or expression.kind == "list_set" or expression.kind == "list_try_set":
        let arguments: TextList = text_list()
        var list_argument_index: Number = 0
        while list_argument_index < list_count(expression.children):
            list_push(arguments, core_yir_render_expr(list_get(expression.children, list_argument_index)))
            set list_argument_index = list_argument_index + 1
        return expression.kind + "(" + text_join(arguments, ", ") + ")"
    if expression.kind == "list_create": return expression.value_type + "()"
    if expression.kind == "list_try_create":
        if expression.value == "TextList": return "text_list_try_new()"
        return "list_try_new()"
    if expression.kind == "list_try_literal":
        let values: TextList = text_list()
        var value_index: Number = 0
        while value_index < list_count(expression.children):
            list_push(values, core_yir_render_expr(list_get(expression.children, value_index)))
            set value_index = value_index + 1
        return "list_try_from([" + text_join(values, ", ") + "])"
    if expression.kind == "list_literal":
        let values: TextList = text_list()
        var value_index: Number = 0
        while value_index < list_count(expression.children):
            list_push(values, core_yir_render_expr(list_get(expression.children, value_index)))
            set value_index = value_index + 1
        return "[" + text_join(values, ", ") + "]"
    if expression.kind == "variable": return expression.value
    if expression.kind == "index": return core_yir_render_expr(list_get(expression.children, 0)) + "[" + core_yir_render_expr(list_get(expression.children, 1)) + "]"
    if expression.kind == "field": return core_yir_render_expr(list_get(expression.children, 0)) + ".field." + expression.value
    if expression.kind == "shape_create":
        let arguments: TextList = text_list()
        var shape_argument_index: Number = 0
        while shape_argument_index < list_count(expression.children):
            list_push(arguments, core_yir_render_expr(list_get(expression.children, shape_argument_index)))
            set shape_argument_index = shape_argument_index + 1
        return expression.value + "(" + text_join(arguments, ", ") + ")"
    if expression.kind == "variant_create":
        let arguments: TextList = text_list()
        var variant_argument_index: Number = 0
        while variant_argument_index < list_count(expression.children):
            list_push(arguments, core_yir_render_expr(list_get(expression.children, variant_argument_index)))
            set variant_argument_index = variant_argument_index + 1
        return expression.value_type + ".case." + expression.value + "(" + text_join(arguments, ", ") + ")"
    if expression.kind == "wrapping_binary":
        var name: Text = "number_wrapping_add"
        if expression.value == "-": set name = "number_wrapping_sub"
        if expression.value == "*": set name = "number_wrapping_mul"
        return name + "(" + core_yir_render_expr(list_get(expression.children, 0)) + ", " + core_yir_render_expr(list_get(expression.children, 1)) + ")"
    if expression.kind == "move": return "move " + core_yir_render_expr(list_get(expression.children, 0))
    if expression.kind == "borrow": return "&" + core_yir_render_expr(list_get(expression.children, 0))
    if expression.kind == "borrow_mut": return "&mut " + core_yir_render_expr(list_get(expression.children, 0))
    if expression.kind == "await": return "await " + core_yir_render_expr(list_get(expression.children, 0))
    if expression.kind == "spawn": return "spawn " + core_yir_render_expr(list_get(expression.children, 0))
    if expression.kind == "unary": return expression.value + core_yir_render_expr(list_get(expression.children, 0))
    if expression.kind == "binary": return "(" + core_yir_render_expr(list_get(expression.children, 0)) + " " + expression.value + " " + core_yir_render_expr(list_get(expression.children, 1)) + ")"
    if expression.kind == "call":
        let arguments: TextList = text_list()
        var index: Number = 0
        while index < list_count(expression.children):
            list_push(arguments, core_yir_render_expr(list_get(expression.children, index)))
            set index = index + 1
        return expression.value + "(" + text_join(arguments, ", ") + ")"
    return "<" + expression.kind + ">"

fn core_yir_indent(level: Number) -> Text:
    var result: Text = ""
    var index: Number = 0
    while index < level * 4:
        set result = result + " "
        set index = index + 1
    return result

fn core_yir_append_rendered_block(block: List[YirStatement], level: Number, output: TextList) -> Number:
    var index: Number = 0
    while index < list_count(block):
        let statement: YirStatement = list_get(block, index)
        let prefix: Text = core_yir_indent(level)
        if statement.kind == "match_expr":
            if statement.slot2 == "return":
                list_push(output, prefix + "return match " + core_yir_render_expr(statement.expression) + " -> " + statement.value_type + "  ;" + core_yir_header_location(statement))
            else:
                list_push(output, prefix + statement.slot2 + " " + statement.name + ": " + statement.value_type + " = match " + core_yir_render_expr(statement.expression) + "  ;" + core_yir_header_location(statement))
            var match_expr_arm_index: Number = 0
            while match_expr_arm_index < list_count(statement.match_arms):
                let expr_arm: YirMatchArm = list_get(statement.match_arms, match_expr_arm_index)
                if expr_arm.case_name == "else":
                    list_push(output, core_yir_indent(level + 1) + "else -> " + core_yir_render_expr(expr_arm.result_expression) + "  ;" + core_yir_yir_match_arm_location(expr_arm))
                else:
                    if expr_arm.pattern_operator != "":
                        list_push(output, core_yir_indent(level + 1) + expr_arm.pattern_operator + " " + core_yir_render_expr(expr_arm.pattern_value) + " -> " + core_yir_render_expr(expr_arm.result_expression) + "  ;" + core_yir_yir_match_arm_location(expr_arm))
                    else:
                        list_push(output, core_yir_indent(level + 1) + expr_arm.case_name + " tag " + number_text(expr_arm.tag) + " -> " + core_yir_render_expr(expr_arm.result_expression) + "  ;" + core_yir_yir_match_arm_location(expr_arm))
                set match_expr_arm_index = match_expr_arm_index + 1
        if statement.kind == "match":
            list_push(output, prefix + "match " + core_yir_render_expr(statement.expression) + ":  ;" + core_yir_header_location(statement))
            var match_arm_index: Number = 0
            while match_arm_index < list_count(statement.match_arms):
                let arm: YirMatchArm = list_get(statement.match_arms, match_arm_index)
                list_push(output, core_yir_indent(level + 1) + "case " + arm.case_name + " tag " + number_text(arm.tag) + ":  ;" + core_yir_yir_match_arm_location(arm))
                var binding_index: Number = 0
                while binding_index < list_count(arm.bindings):
                    let binding: YirMatchBinding = list_get(arm.bindings, binding_index)
                    list_push(output, core_yir_indent(level + 2) + "bind field." + number_text(binding.field_index) + " -> " + binding.slot + ": " + binding.value_type)
                    set binding_index = binding_index + 1
                core_yir_append_rendered_block(arm.body, level + 2, output)
                set match_arm_index = match_arm_index + 1
        if statement.kind == "defer":
            list_push(output, prefix + "defer " + core_yir_render_expr(statement.expression) + "  ; captured in " + statement.slot + core_yir_yir_statement_location(statement))
        if statement.kind == "let" or statement.kind == "var":
            list_push(output, prefix + statement.kind + " " + statement.name + ": " + statement.value_type + " = " + core_yir_render_expr(statement.expression) + "  ; " + statement.slot + core_yir_yir_statement_location(statement))
        else:
            if statement.kind == "set":
                list_push(output, prefix + "set " + statement.slot + " = " + core_yir_render_expr(statement.expression) + "  ;" + core_yir_yir_statement_location(statement))
            else:
                if statement.kind == "set_field":
                    var field_path: Text = statement.slot
                    var path_index: Number = 0
                    while path_index < list_count(statement.field_path):
                        set field_path = field_path + "." + list_get(statement.field_path, path_index).field_name
                        set path_index = path_index + 1
                    list_push(output, prefix + "set " + field_path + " = " + core_yir_render_expr(statement.expression) + "  ;" + core_yir_yir_statement_location(statement))
                else:
                    if statement.kind == "say" or statement.kind == "assert":
                        list_push(output, prefix + statement.kind + " " + core_yir_render_expr(statement.expression) + "  ;" + core_yir_yir_statement_location(statement))
                    else:
                        if statement.kind == "return":
                            if statement.expression.value_type == "Unit":
                                list_push(output, prefix + "return  ;" + core_yir_yir_statement_location(statement))
                            else:
                                list_push(output, prefix + "return " + core_yir_render_expr(statement.expression) + "  ;" + core_yir_yir_statement_location(statement))
                        else:
                            if statement.kind == "expression":
                                list_push(output, prefix + core_yir_render_expr(statement.expression) + "  ;" + core_yir_yir_statement_location(statement))
                            else:
                                if statement.kind == "if":
                                    var branch_index: Number = 0
                                    while branch_index < list_count(statement.branches):
                                        let branch: YirBranch = list_get(statement.branches, branch_index)
                                        var branch_name: Text = "if"
                                        if branch_index > 0: set branch_name = "elif"
                                        list_push(output, prefix + branch_name + " " + core_yir_render_expr(branch.condition) + ":  ;" + core_yir_branch_location(branch))
                                        core_yir_append_rendered_block(branch.body, level + 1, output)
                                        set branch_index = branch_index + 1
                                    if statement.has_else:
                                        list_push(output, prefix + "else:  ;" + core_yir_else_location(statement))
                                        core_yir_append_rendered_block(statement.alternate, level + 1, output)
                                else:
                                    if statement.kind == "while":
                                        list_push(output, prefix + "while " + core_yir_render_expr(statement.expression) + ":  ;" + core_yir_header_location(statement))
                                        core_yir_append_rendered_block(statement.body, level + 1, output)
                                    else:
                                        if statement.kind == "for_range":
                                            list_push(output, prefix + "for " + statement.name + " in " + core_yir_render_expr(statement.expression) + ".." + core_yir_render_expr(statement.expression2) + ":  ; " + statement.slot + core_yir_header_location(statement))
                                            core_yir_append_rendered_block(statement.body, level + 1, output)
                                        else:
                                            if statement.kind == "for_each":
                                                list_push(output, prefix + "for " + statement.name + " in " + core_yir_render_expr(statement.expression) + ":  ; " + statement.slot + ", " + statement.slot2 + core_yir_header_location(statement))
                                                core_yir_append_rendered_block(statement.body, level + 1, output)
                                            else:
                                                if statement.kind == "arena_scope":
                                                    list_push(output, prefix + "arena_scope " + core_yir_render_expr(statement.expression) + ":  ; " + statement.slot + core_yir_header_location(statement))
                                                    core_yir_append_rendered_block(statement.body, level + 1, output)
                                                else:
                                                    if statement.kind == "break" or statement.kind == "continue":
                                                        list_push(output, prefix + statement.kind + "  ;" + core_yir_yir_statement_location(statement))
        set index = index + 1
    return 0

fn core_yir_render_block(block: List[YirStatement], level: Number) -> Text:
    let output: TextList = text_list()
    core_yir_append_rendered_block(block, level, output)
    if list_count(output) == 0: return ""
    return text_join(output, "\n") + "\n"

fn render_core_yir(program: YirProgram) -> Text:
    let output: TextList = text_list()
    list_push(output, "module @yaza_core")
    var shape_index: Number = 0
    while shape_index < list_count(program.shapes):
        let shape: HirShape = list_get(program.shapes, shape_index)
        list_push(output, "")
        list_push(output, "shape @" + shape.name + " {  ;" + core_yir_source_location(shape.source_file, shape.source_line, shape.source_column, shape.name_end_column) + "; header" + core_yir_source_location(shape.source_file, shape.source_line, shape.header_source_column, shape.header_source_end_column))
        var field_index: Number = 0
        while field_index < list_count(shape.fields):
            let field: HirField = list_get(shape.fields, field_index)
            list_push(output, core_yir_indent(1) + "field " + field.name + ": " + field.value_type + "  ; name" + core_yir_source_location(field.source_file, field.source_line, field.source_column, field.name_end_column) + "; type" + core_yir_source_location(field.source_file, field.source_line, field.type_column, field.type_end_column) + "; header" + core_yir_source_location(field.source_file, field.source_line, field.source_column, field.type_end_column))
            set field_index = field_index + 1
        list_push(output, "}")
        set shape_index = shape_index + 1
    var variant_index: Number = 0
    while variant_index < list_count(program.variants):
        let variant: HirVariant = list_get(program.variants, variant_index)
        list_push(output, "")
        list_push(output, "variant @" + variant.name + " {  ;" + core_yir_source_location(variant.source_file, variant.source_line, variant.source_column, variant.name_end_column) + "; header" + core_yir_source_location(variant.source_file, variant.source_line, variant.header_source_column, variant.header_source_end_column))
        var case_index: Number = 0
        while case_index < list_count(variant.cases):
            let variant_case: HirVariantCase = list_get(variant.cases, case_index)
            list_push(output, core_yir_indent(1) + "case " + variant_case.name + " tag " + number_text(case_index) + "  ;" + core_yir_source_location(variant_case.source_file, variant_case.source_line, variant_case.source_column, variant_case.name_end_column) + "; header" + core_yir_source_location(variant_case.source_file, variant_case.source_line, variant_case.header_source_column, variant_case.header_source_end_column))
            var payload_index: Number = 0
            while payload_index < list_count(variant_case.fields):
                let field: HirField = list_get(variant_case.fields, payload_index)
                list_push(output, core_yir_indent(2) + "payload " + field.name + ": " + field.value_type + "  ; name" + core_yir_source_location(field.source_file, field.source_line, field.source_column, field.name_end_column) + "; type" + core_yir_source_location(field.source_file, field.source_line, field.type_column, field.type_end_column) + "; header" + core_yir_source_location(field.source_file, field.source_line, field.source_column, field.type_end_column))
                set payload_index = payload_index + 1
            set case_index = case_index + 1
        list_push(output, "}")
        set variant_index = variant_index + 1
    var function_index: Number = 0
    while function_index < list_count(program.functions):
        let function: YirFunction = list_get(program.functions, function_index)
        let parameters: TextList = text_list()
        var parameter_index: Number = 0
        while parameter_index < list_count(function.parameters):
            let parameter: YirParameter = list_get(function.parameters, parameter_index)
            list_push(parameters, parameter.name + ": " + parameter.value_type + " [" + parameter.slot + "]")
            set parameter_index = parameter_index + 1
        list_push(output, "")
        list_push(output, "func @" + function.name + "(" + text_join(parameters, ", ") + ") -> " + function.return_type + " {  ;" + core_yir_source_location(function.source_file, function.source_line, function.source_column, function.source_end_column) + "; header" + core_yir_source_location(function.source_file, function.source_line, function.header_source_column, function.header_source_end_column))
        list_push(output, core_yir_indent(1) + "; return type" + core_yir_function_return_type_location(function))
        set parameter_index = 0
        while parameter_index < list_count(function.parameters):
            let parameter: YirParameter = list_get(function.parameters, parameter_index)
            list_push(output, core_yir_indent(1) + "; parameter " + parameter.name + " name" + core_yir_parameter_name_location(parameter) + "; type" + core_yir_parameter_type_location(parameter))
            set parameter_index = parameter_index + 1
        core_yir_append_rendered_block(function.body, 1, output)
        list_push(output, "}")
        set function_index = function_index + 1
    list_push(output, "")
    list_push(output, "func @main() -> Unit {  ;" + core_yir_source_location(program.start_source_file, program.start_source_line, program.start_source_column, program.start_source_end_column))
    core_yir_append_rendered_block(program.body, 1, output)
    list_push(output, "}")
    return text_join(output, "\n") + "\n"
