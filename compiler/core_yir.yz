    if list_count(child_types) != expected_count: fail("YIR verifier: Network builtin arity mismatch for '" + expression.value + "'")
    if expected_count > 0 and list_get(child_types, 0) != first_type: fail("YIR verifier: Network builtin first argument mismatch for '" + expression.value + "'")
    if expected_count > 1 and list_get(child_types, 1) != second_type: fail("YIR verifier: Network builtin second argument mismatch for '" + expression.value + "'")
    if expected_count > 2 and list_get(child_types, 2) != third_type: fail("YIR verifier: Network builtin third argument mismatch for '" + expression.value + "'")
    let result_type: Text = core_yir_net_result_type(expression.value)
    if expression.value_type != result_type: fail("YIR verifier: Network builtin result type mismatch for '" + expression.value + "'")
    return result_type

