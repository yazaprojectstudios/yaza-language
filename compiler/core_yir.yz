            if argument_count != 3 or list_get(children, 0).value_type != "Bytes" or list_get(children, 1).value_type != "Number" or list_get(children, 2).value_type != "Number": fail("YIR type check: bytes_try_slice expects Bytes, start, and length" + core_yir_expression_location(expression))
            return core_yir_expr("call", expression.value, "Result[Bytes,Text]", children, expression.source_line)
        if expression.value == "bytes_concat":
            if argument_count != 2 or list_get(children, 0).value_type != "Bytes" or list_get(children, 1).value_type != "Bytes": fail("YIR type check: bytes_concat expects two Bytes values" + core_yir_expression_location(expression))
            return core_yir_expr("call", expression.value, "Bytes", children, expression.source_line)
        if expression.value == "bytes_try_concat":
            if argument_count != 2 or list_get(children, 0).value_type != "Bytes" or list_get(children, 1).value_type != "Bytes": fail("YIR type check: bytes_try_concat expects two Bytes values" + core_yir_expression_location(expression))
            return core_yir_expr("call", expression.value, "Result[Bytes,Text]", children, expression.source_line)
        if expression.value == "bytes_equal" or expression.value == "bytes_equal_constant_time":
            if argument_count != 2 or list_get(children, 0).value_type != "Bytes" or list_get(children, 1).value_type != "Bytes": fail("YIR type check: " + expression.value + " expects two Bytes values" + core_yir_expression_location(expression))
            return core_yir_expr("call", expression.value, "Boolean", children, expression.source_line)
        if expression.value == "bytes_to_text_checked":
            if argument_count != 1 or list_get(children, 0).value_type != "Bytes": fail("YIR type check: bytes_to_text_checked expects one Bytes argument" + core_yir_expression_location(expression))
            return core_yir_expr("call", expression.value, "Option[Text]", children, expression.source_line)
        if expression.value == "bytes_join":
            if argument_count != 1 or core_yir_list_element_type(list_get(children, 0).value_type) != "Bytes": fail("YIR type check: bytes_join expects one List[Bytes] argument" + core_yir_expression_location(expression))
            return core_yir_expr("call", expression.value, "Result[Bytes,Text]", children, expression.source_line)
        if expression.value == "int32_from_number":
            if argument_count != 1 or list_get(children, 0).value_type != "Number": fail("YIR type check: int32_from_number expects one Number argument" + core_yir_expression_location(expression))
            return core_yir_expr("call", expression.value, "Int32", children, expression.source_line)
        if expression.value == "number_from_int32":
            if argument_count != 1 or list_get(children, 0).value_type != "Int32": fail("YIR type check: number_from_int32 expects one Int32 argument" + core_yir_expression_location(expression))
            return core_yir_expr("call", expression.value, "Number", children, expression.source_line)
        if expression.value == "float64_from_number":
            if argument_count != 1 or list_get(children, 0).value_type != "Number": fail("YIR type check: float64_from_number expects one Number argument" + core_yir_expression_location(expression))
            return core_yir_expr("call", expression.value, "Float64", children, expression.source_line)
        if expression.value == "number_from_float64":
            if argument_count != 1 or list_get(children, 0).value_type != "Float64": fail("YIR type check: number_from_float64 expects one Float64 argument" + core_yir_expression_location(expression))
            return core_yir_expr("call", expression.value, "Number", children, expression.source_line)
        if expression.value == "float64_bits":
            if argument_count != 1 or list_get(children, 0).value_type != "Float64": fail("YIR type check: float64_bits expects one Float64 argument" + core_yir_expression_location(expression))
            return core_yir_expr("call", expression.value, "Number", children, expression.source_line)
        if expression.value == "float64_from_bits":
            if argument_count != 1 or list_get(children, 0).value_type != "Number": fail("YIR type check: float64_from_bits expects one Number argument" + core_yir_expression_location(expression))
            return core_yir_expr("call", expression.value, "Float64", children, expression.source_line)
        let function_index: Number = core_yir_find_function(functions, expression.value)
        if function_index < 0:
            fail("YIR type check: unknown function '" + expression.value + "'" + core_yir_source_location(expression.source_file, expression.source_line, expression.source_column, expression.source_end_column))
            return core_yir_expr("call", expression.value, "Number", children, expression.source_line)
        let signature: HirFunction = list_get(functions, function_index)
        if list_count(signature.parameters) != argument_count:
            fail("YIR type check: wrong argument count for '" + expression.value + "'" + core_yir_source_location(expression.source_file, expression.source_line, expression.source_column, expression.source_end_column))
        var compare_index: Number = 0
        while compare_index < argument_count and compare_index < list_count(signature.parameters):
            let actual: YirExpr = list_get(children, compare_index)
            let parameter: HirParameter = list_get(signature.parameters, compare_index)
            if not core_yir_type_assignable_to_parameter(actual.value_type, parameter.value_type):
                fail("YIR type check: argument type mismatch for '" + expression.value + "'" + core_yir_source_location(expression.source_file, expression.source_line, expression.source_column, expression.source_end_column))
            set compare_index = compare_index + 1
        return core_yir_expr("call", expression.value, signature.return_type, children, expression.source_line)
    fail("YIR lowering: expression form '" + expression.kind + "' is not in the active Core slice" + core_yir_source_location(expression.source_file, expression.source_line, expression.source_column, expression.source_end_column))
    return core_yir_expr("number", "0", "Number", children, expression.source_line)

fn core_yir_lower_expr(expression: HirExpr, names: TextList, slots: TextList, types: TextList, active_count: Number, functions: List[HirFunction], shapes: List[HirShape], variants: List[HirVariant]) -> YirExpr:
    var result: YirExpr = core_yir_lower_expr_inner(expression, names, slots, types, active_count, functions, shapes, variants)
    set result.source_column = expression.source_column
    set result.source_end_column = expression.source_end_column
    set result.source_file = expression.source_file
    return result

fn core_yir_lower_expr_expected_inner(expression: HirExpr, names: TextList, slots: TextList, types: TextList, active_count: Number, functions: List[HirFunction], shapes: List[HirShape], variants: List[HirVariant], expected_type: Text) -> YirExpr:
    let empty: List[YirExpr] = List[YirExpr]()
    if expression.kind == "list":
        let item_type: Text = core_yir_list_element_type(expected_type)
        if item_type == "" or item_type == "Unit" or not core_yir_known_type(expected_type, shapes, variants): fail("YIR type check: collection literal requires a List[T] or TextList type context" + core_yir_expression_location(expression))
        let values: List[YirExpr] = List[YirExpr]()
        var item_index: Number = 0
        while item_index < list_count(expression.children):
            list_push(values, core_yir_lower_expr_expected(list_get(expression.children, item_index), names, slots, types, active_count, functions, shapes, variants, item_type))
            set item_index = item_index + 1
        return core_yir_expr("list_literal", expected_type, expected_type, values, expression.source_line)
    if expression.kind == "none":
        if core_yir_option_payload_type(expected_type) == "": fail("YIR type check: 'none' requires an Option type context" + core_yir_expression_location(expression))
        return core_yir_expr("option_none", "", expected_type, empty, expression.source_line)
    if expression.kind == "call" and expression.value == "list_try_from":
        if list_count(expression.children) != 1 or list_get(expression.children, 0).kind != "list": fail("YIR type check: list_try_from expects one collection literal" + core_yir_expression_location(expression))
        let collection_type: Text = core_yir_result_argument_type(expected_type, 0)
        let item_type: Text = core_yir_list_element_type(collection_type)
        if item_type == "" or core_yir_result_argument_type(expected_type, 1) != "Text" or not core_yir_known_type(collection_type, shapes, variants): fail("YIR type check: list_try_from requires a Result[List[T],Text] or Result[TextList,Text] type context" + core_yir_expression_location(expression))
        let values: List[YirExpr] = List[YirExpr]()
        let source_values: List[HirExpr] = list_get(expression.children, 0).children
        var item_index: Number = 0
        while item_index < list_count(source_values):
            list_push(values, core_yir_lower_expr_expected(list_get(source_values, item_index), names, slots, types, active_count, functions, shapes, variants, item_type))
            set item_index = item_index + 1
        return core_yir_expr("list_try_literal", collection_type, expected_type, values, expression.source_line)
    if expression.kind == "call" and expression.value == "list_try_get_result":
        if list_count(expression.children) != 2: fail("YIR type check: list_try_get_result expects a List and Number index" + core_yir_expression_location(expression))
        let collection: YirExpr = core_yir_lower_expr(list_get(expression.children, 0), names, slots, types, active_count, functions, shapes, variants)
        let list_item_type: Text = core_yir_list_element_type(collection.value_type)
        let success_type: Text = core_yir_result_argument_type(expected_type, 0)
        let option_item_type: Text = core_yir_option_payload_type(success_type)
        if list_item_type == "" or list_item_type == "Unit" or list_item_type != option_item_type or core_yir_result_argument_type(expected_type, 1) != "Text" or not core_yir_known_type(list_item_type, shapes, variants): fail("YIR type check: list_try_get_result requires a Result[Option[T],Text] context matching its List element type" + core_yir_expression_location(expression))
        let index: YirExpr = core_yir_lower_expr_expected(list_get(expression.children, 1), names, slots, types, active_count, functions, shapes, variants, "Number")
        let children: List[YirExpr] = List[YirExpr]()
        list_push(children, collection)
        list_push(children, index)
        return core_yir_expr("fallible_list_try_get", success_type, expected_type, children, expression.source_line)
    if expression.kind == "call" and expression.value == "text_try_interpolate":
        if list_count(expression.children) != 1: fail("YIR type check: text_try_interpolate expects one interpolated Text literal" + core_yir_expression_location(expression))
        if expected_type != "Result[Text,Text]": fail("YIR type check: text_try_interpolate requires a Result[Text,Text] type context" + core_yir_expression_location(expression))
        let interpolation: YirExpr = core_yir_lower_expr(list_get(expression.children, 0), names, slots, types, active_count, functions, shapes, variants)
        if interpolation.kind != "interpolate" and interpolation.kind != "text": fail("YIR type check: text_try_interpolate expects one interpolated Text literal" + core_yir_expression_location(expression))
        return core_yir_expr("fallible_interpolate", interpolation.value, expected_type, interpolation.children, expression.source_line)
    if expression.kind == "call" and expression.value == "variant_try":
        if list_count(expression.children) != 1: fail("YIR type check: variant_try expects one variant case constructor" + core_yir_expression_location(expression))
        let variant_expression: HirExpr = list_get(expression.children, 0)
        if variant_expression.kind != "call": fail("YIR type check: variant_try expects a Variant::Case(...) argument" + core_yir_expression_location(expression))
        if core_yir_result_argument_type(expected_type, 1) != "Text": fail("YIR type check: variant_try requires a Result[Variant,Text] type context" + core_yir_expression_location(expression))
        let variant_name: Text = core_yir_variant_name_from_qualified(variant_expression.value)
        let variant_index: Number = core_yir_find_variant(variants, variant_name)
        if variant_index < 0 or core_yir_result_argument_type(expected_type, 0) != variant_name: fail("YIR type check: variant_try requires a Result[" + variant_name + ",Text] type context" + core_yir_expression_location(expression))
        let variant: HirVariant = list_get(variants, variant_index)
        let case_index: Number = core_yir_find_variant_case(variant, core_yir_variant_case_name_from_qualified(variant_expression.value))
        if case_index < 0: fail("YIR type check: unknown variant case '" + variant_expression.value + "'" + core_yir_expression_location(variant_expression))
        let variant_case: HirVariantCase = list_get(variant.cases, case_index)
        if list_count(variant_expression.children) != list_count(variant_case.fields): fail("YIR type check: variant case '" + variant_expression.value + "' expects " + number_text(list_count(variant_case.fields)) + " payload values" + core_yir_expression_location(variant_expression))
        let children: List[YirExpr] = List[YirExpr]()
        var payload_index: Number = 0
        while payload_index < list_count(variant_case.fields):
            list_push(children, core_yir_lower_expr_expected(list_get(variant_expression.children, payload_index), names, slots, types, active_count, functions, shapes, variants, list_get(variant_case.fields, payload_index).value_type))
            set payload_index = payload_index + 1
        var result: YirExpr = core_yir_expr("fallible_variant", variant_name, expected_type, children, expression.source_line)
        set result.value2 = number_text(case_index)
        return result
    if expression.kind == "call" and (expression.value == "some_try" or expression.value == "ok_try" or expression.value == "err_try"):
        if list_count(expression.children) != 1: fail("YIR type check: '" + expression.value + "' expects exactly one payload" + core_yir_expression_location(expression))
        if core_yir_result_argument_type(expected_type, 1) != "Text": fail("YIR type check: '" + expression.value + "' requires a Result[Option[T],Text] or Result[Result[T,E],Text] type context" + core_yir_expression_location(expression))
        let inner_type: Text = core_yir_result_argument_type(expected_type, 0)
        var payload_type: Text = ""
        var constructor: Text = ""
        if expression.value == "some_try":
            set payload_type = core_yir_option_payload_type(inner_type)
            set constructor = "some"
            if payload_type == "" or payload_type == "Unit" or not core_yir_known_type(payload_type, shapes, variants): fail("YIR type check: some_try requires a Result[Option[T],Text] context" + core_yir_expression_location(expression))
        else:
            if core_yir_result_argument_type(inner_type, 0) == "" or core_yir_result_argument_type(inner_type, 1) == "": fail("YIR type check: '" + expression.value + "' requires a Result[Result[T,E],Text] context" + core_yir_expression_location(expression))
            if expression.value == "ok_try":
                set payload_type = core_yir_result_argument_type(inner_type, 0)
                set constructor = "ok"
            else:
                set payload_type = core_yir_result_argument_type(inner_type, 1)
                set constructor = "err"
        let payload: YirExpr = core_yir_lower_expr_expected(list_get(expression.children, 0), names, slots, types, active_count, functions, shapes, variants, payload_type)
        if payload.value_type != payload_type: fail("YIR type check: '" + expression.value + "' payload does not match " + payload_type + core_yir_expression_location(expression))
        let children: List[YirExpr] = List[YirExpr]()
        list_push(children, payload)
        var result: YirExpr = core_yir_expr("fallible_sum", inner_type, expected_type, children, expression.source_line)
        set result.value2 = constructor
        return result
    if expression.kind == "call" and (expression.value == "some" or expression.value == "ok" or expression.value == "err"):
        if list_count(expression.children) != 1: fail("YIR type check: '" + expression.value + "' expects exactly one payload" + core_yir_expression_location(expression))
        if expression.value == "some_try" or expression.value == "ok_try" or expression.value == "err_try":
            fail("YIR type check: '" + expression.value + "' requires an explicit Result type context" + core_yir_expression_location(expression))
        if expression.value == "some":
            let expected_payload: Text = core_yir_option_payload_type(expected_type)
            if expected_type != "" and expected_payload == "": fail("YIR type check: some requires an Option type context" + core_yir_expression_location(expression))
            let payload: YirExpr = core_yir_lower_expr_expected(list_get(expression.children, 0), names, slots, types, active_count, functions, shapes, variants, expected_payload)
            if payload.value_type == "Unit": fail("YIR type check: Option payload cannot be Unit" + core_yir_expression_location(expression))
            let result_type: Text = "Option[" + payload.value_type + "]"
            if expected_type != "" and result_type != expected_type: fail("YIR type check: some payload does not match " + expected_type + core_yir_expression_location(expression))
            let children: List[YirExpr] = List[YirExpr]()
            list_push(children, payload)
            return core_yir_expr("option_some", "", result_type, children, expression.source_line)
        if expected_type == "" or not text_starts_with(expected_type, "Result["):
            fail("YIR type check: '" + expression.value + "' requires a Result type context" + core_yir_expression_location(expression))
        var result_index: Number = 0
        var expression_kind: Text = "result_ok"
        if expression.value == "err":
            set result_index = 1
            set expression_kind = "result_err"
        let expected_payload: Text = core_yir_result_argument_type(expected_type, result_index)
        if expected_payload == "": fail("YIR type check: malformed Result type context" + core_yir_expression_location(expression))
        let payload: YirExpr = core_yir_lower_expr_expected(list_get(expression.children, 0), names, slots, types, active_count, functions, shapes, variants, expected_payload)
        if payload.value_type != expected_payload: fail("YIR type check: '" + expression.value + "' payload does not match " + expected_payload + core_yir_expression_location(expression))
        let children: List[YirExpr] = List[YirExpr]()
        list_push(children, payload)
        return core_yir_expr(expression_kind, "", expected_type, children, expression.source_line)
    if expression.kind == "call" and expression.value == "list_try_new":
        if list_count(expression.children) != 0: fail("YIR type check: list_try_new expects no arguments" + core_yir_expression_location(expression))
        let success_type: Text = core_yir_result_argument_type(expected_type, 0)
        let error_type: Text = core_yir_result_argument_type(expected_type, 1)
        if success_type == "" or error_type != "Text" or core_yir_list_element_type(success_type) == "" or not core_yir_known_type(success_type, shapes, variants):
            fail("YIR type check: list_try_new requires a Result[List[T],Text] type context" + core_yir_expression_location(expression))
        return core_yir_expr("list_try_create", success_type, expected_type, empty, expression.source_line)
    if expression.kind == "call" and expression.value == "text_list_try_new":
        if list_count(expression.children) != 0: fail("YIR type check: text_list_try_new expects no arguments" + core_yir_expression_location(expression))
        if expected_type != "Result[TextList,Text]":
            fail("YIR type check: text_list_try_new requires a Result[TextList,Text] type context" + core_yir_expression_location(expression))
        return core_yir_expr("list_try_create", "TextList", expected_type, empty, expression.source_line)
    let lowered: YirExpr = core_yir_lower_expr(expression, names, slots, types, active_count, functions, shapes, variants)
    if expected_type != "" and not core_yir_type_assignable_to_parameter(lowered.value_type, expected_type):
        fail("YIR type check: expression type " + lowered.value_type + " does not match expected " + expected_type + core_yir_source_location(expression.source_file, expression.source_line, expression.source_column, expression.source_end_column))
    return lowered

fn core_yir_lower_expr_expected(expression: HirExpr, names: TextList, slots: TextList, types: TextList, active_count: Number, functions: List[HirFunction], shapes: List[HirShape], variants: List[HirVariant], expected_type: Text) -> YirExpr:
    var result: YirExpr = core_yir_lower_expr_expected_inner(expression, names, slots, types, active_count, functions, shapes, variants, expected_type)
    set result.source_column = expression.source_column
    set result.source_end_column = expression.source_end_column
    set result.source_file = expression.source_file
    return result

fn core_yir_lower_try(expression: HirExpr, names: TextList, slots: TextList, types: TextList, active_count: Number, functions: List[HirFunction], shapes: List[HirShape], variants: List[HirVariant], expected_type: Text, return_type: Text, is_return: Boolean) -> YirExpr:
    if expression.kind != "try" or list_count(expression.children) != 1: fail("YIR type check: malformed postfix '?' expression" + core_yir_expression_location(expression))
    let source: YirExpr = core_yir_lower_expr(list_get(expression.children, 0), names, slots, types, active_count, functions, shapes, variants)
    let success_type: Text = core_yir_result_argument_type(source.value_type, 0)
    let source_error: Text = core_yir_result_argument_type(source.value_type, 1)
    let target_success: Text = core_yir_result_argument_type(return_type, 0)
    let target_error: Text = core_yir_result_argument_type(return_type, 1)
    if success_type == "" or source_error == "": fail("YIR type check: postfix '?' requires a typed Result[T, E] expression" + core_yir_source_location(expression.source_file, expression.source_line, expression.source_column, expression.source_end_column))
    if target_success == "" or target_error == "": fail("YIR type check: postfix '?' is only valid in a function returning Result[T, E]" + core_yir_source_location(expression.source_file, expression.source_line, expression.source_column, expression.source_end_column))
    if expected_type != "" and success_type != expected_type: fail("YIR type check: postfix '?' success type does not match " + expected_type + core_yir_source_location(expression.source_file, expression.source_line, expression.source_column, expression.source_end_column))
    var conversion_function: Text = ""
    if source_error != target_error:
        set conversion_function = "yaza_impl_from_" + source_error + "_to_" + target_error
        let conversion_index: Number = core_yir_find_function(functions, conversion_function)
        if conversion_index < 0: fail("YIR type check: postfix '?' error type must match the enclosing Result error type or declare impl From[" + source_error + "] for " + target_error + core_yir_source_location(expression.source_file, expression.source_line, expression.source_column, expression.source_end_column))
        if conversion_index >= 0:
            let conversion: HirFunction = list_get(functions, conversion_index)
            if list_count(conversion.parameters) != 1 or list_get(conversion.parameters, 0).value_type != source_error or conversion.return_type != target_error:
                fail("YIR type check: malformed direct From conversion from " + source_error + " to " + target_error + core_yir_source_location(expression.source_file, expression.source_line, expression.source_column, expression.source_end_column))
    if is_return:
        let children: List[YirExpr] = List[YirExpr]()
        list_push(children, source)
        var result: YirExpr = core_yir_expr("try_return", return_type, return_type, children, expression.source_line)
        set result.value2 = conversion_function
        set result.source_column = expression.source_column
        set result.source_end_column = expression.source_end_column
        set result.source_file = expression.source_file
        return result
    let children: List[YirExpr] = List[YirExpr]()
    list_push(children, source)
    var result: YirExpr = core_yir_expr("try", return_type, success_type, children, expression.source_line)
    set result.value2 = conversion_function
    set result.source_column = expression.source_column
    set result.source_end_column = expression.source_end_column
    set result.source_file = expression.source_file
    return result

fn core_yir_lower_context_expr(expression: HirExpr, names: TextList, slots: TextList, types: TextList, active_count: Number, functions: List[HirFunction], shapes: List[HirShape], variants: List[HirVariant], expected_type: Text, return_type: Text, is_return: Boolean) -> YirExpr:
    if expression.kind == "try": return core_yir_lower_try(expression, names, slots, types, active_count, functions, shapes, variants, expected_type, return_type, is_return)
    return core_yir_lower_expr_expected(expression, names, slots, types, active_count, functions, shapes, variants, expected_type)

fn core_yir_lower_match_expr(statement: HirStatement, names: TextList, slots: TextList, types: TextList, mutable_values: TextList, visible: Number, slot_serial: TextList, functions: List[HirFunction], shapes: List[HirShape], variants: List[HirVariant], expected_type: Text, return_type: Text) -> YirStatement:
    var result: YirStatement = core_yir_statement("match_expr", statement.source_line)
    set result.expression = core_yir_lower_expr(statement.expression, names, slots, types, visible, functions, shapes, variants)
    set result.value_type = expected_type
    if not core_yir_known_type(expected_type, shapes, variants) or expected_type == "Unit": fail("YIR type check: match expression requires a supported non-Unit result type" + core_yir_statement_location(statement))
    let matched_type: Text = result.expression.value_type
    let variant_index: Number = core_yir_find_variant(variants, matched_type)
    let option_payload: Text = core_yir_option_payload_type(matched_type)
    let result_success: Text = core_yir_result_argument_type(matched_type, 0)
    let result_error: Text = core_yir_result_argument_type(matched_type, 1)
    let builtin_match: Boolean = option_payload != "" or (result_success != "" and result_error != "")
    let numeric_match: Boolean = core_yir_numeric(matched_type)
    if not numeric_match and variant_index < 0 and not builtin_match: fail("YIR type check: match expression requires a numeric value, declared variant, Option, or Result" + core_yir_source_location(result.expression.source_file, result.expression.source_line, result.expression.source_column, result.expression.source_end_column))
    var case_count: Number = 0
    if builtin_match: set case_count = 2
    else:
        if variant_index >= 0: set case_count = list_count(list_get(variants, variant_index).cases)
    let seen_tags: List[Number] = List[Number]()
    var saw_else: Boolean = false
    var numeric_guards: Number = 0
    var arm_index: Number = 0
    while arm_index < list_count(statement.match_arms):
        let source_arm: HirMatchArm = list_get(statement.match_arms, arm_index)
        var tag: Number = -1
        var payload_type: Text = ""
        var payload_count: Number = 0
        var pattern_value: YirExpr = core_yir_empty_expr(source_arm.source_line)
        if numeric_match:
            if source_arm.case_name == "else":
                if source_arm.pattern_operator != "" or arm_index == 0 or arm_index + 1 != list_count(statement.match_arms): fail("YIR type check: numeric match else arm must follow guards and be last" + core_yir_match_arm_location(source_arm))
                set saw_else = true
            else:
                if saw_else: fail("YIR type check: numeric match has an arm after else" + core_yir_match_arm_location(source_arm))
                if source_arm.pattern_operator != "<" and source_arm.pattern_operator != ">" and source_arm.pattern_operator != "<=" and source_arm.pattern_operator != ">=" and source_arm.pattern_operator != "==" and source_arm.pattern_operator != "!=": fail("YIR type check: invalid numeric match operator" + core_yir_match_arm_location(source_arm))
                set pattern_value = core_yir_lower_expr(source_arm.pattern_value, names, slots, types, visible, functions, shapes, variants)
                if not core_yir_numeric(pattern_value.value_type): fail("YIR type check: numeric match guard value must be numeric" + core_yir_source_location(pattern_value.source_file, pattern_value.source_line, pattern_value.source_column, pattern_value.source_end_column))
                set numeric_guards = numeric_guards + 1
        else:
            if source_arm.pattern_operator != "": fail("YIR type check: numeric guards cannot match a sum type" + core_yir_match_arm_location(source_arm))
            if builtin_match:
                set tag = core_yir_builtin_match_case_tag(matched_type, source_arm.case_name)
                set payload_type = core_yir_builtin_match_payload_type(matched_type, source_arm.case_name)
                if payload_type != "": set payload_count = 1
            else:
                set tag = core_yir_find_variant_case(list_get(variants, variant_index), source_arm.case_name)
                if tag >= 0: set payload_count = list_count(list_get(list_get(variants, variant_index).cases, tag).fields)
            if tag < 0: fail("YIR type check: no case '" + source_arm.case_name + "' for matched type '" + matched_type + "'" + core_yir_match_arm_location(source_arm))
            var seen_index: Number = 0
            while seen_index < list_count(seen_tags):
                if list_get(seen_tags, seen_index) == tag: fail("YIR type check: duplicate match arm for '" + source_arm.case_name + "'" + core_yir_match_arm_location(source_arm))
                set seen_index = seen_index + 1
            list_push(seen_tags, tag)
            if list_count(source_arm.bindings) != payload_count: fail("YIR type check: match arm '" + source_arm.case_name + "' binds the wrong number of payload fields" + core_yir_match_arm_location(source_arm))
        let arm_bindings: List[YirMatchBinding] = List[YirMatchBinding]()
        let arm_names: TextList = text_list()
        var binding_index: Number = 0
        while binding_index < list_count(source_arm.bindings):
            let binding_name: Text = list_get(source_arm.bindings, binding_index)
            var field_type: Text = payload_type
            if not builtin_match and not numeric_match:
                set field_type = list_get(list_get(list_get(variants, variant_index).cases, tag).fields, binding_index).value_type
            if binding_name != "_":
                if core_yir_visible_index(arm_names, list_count(arm_names), binding_name) >= 0:
                    let binding_column: Number = number_parse(list_get(source_arm.binding_columns, binding_index))
                    fail("YIR type check: duplicate binding '" + binding_name + "' in match arm" + core_yir_source_location(source_arm.source_file, source_arm.source_line, binding_column, binding_column + text_length(binding_name) - 1))
                if core_yir_visible_index(names, visible, binding_name) >= 0:
                    let binding_column: Number = number_parse(list_get(source_arm.binding_columns, binding_index))
                    fail("YIR type check: match binding duplicates a name in the active scope" + core_yir_source_location(source_arm.source_file, source_arm.source_line, binding_column, binding_column + text_length(binding_name) - 1))
                list_push(arm_names, binding_name)
                let serial: Number = number_parse(list_get(slot_serial, 0))
                let slot: Text = "%slot." + number_text(serial)
                core_yir_bind_local(names, slots, types, mutable_values, visible + list_count(arm_bindings), binding_name, slot, field_type, "let")
                list_set(slot_serial, 0, number_text(serial + 1))
                list_push(arm_bindings, YirMatchBinding(binding_index, slot, field_type))
            set binding_index = binding_index + 1
        let arm_result: YirExpr = core_yir_lower_context_expr(source_arm.result_expression, names, slots, types, visible + list_count(arm_bindings), functions, shapes, variants, expected_type, return_type, false)
        if arm_result.value_type != expected_type: fail("YIR type check: match arm result does not match " + expected_type + core_yir_source_location(arm_result.source_file, arm_result.source_line, arm_result.source_column, arm_result.source_end_column))
        list_push(result.match_arms, YirMatchArm(tag, source_arm.case_name, arm_bindings, List[YirStatement](), source_arm.source_line, source_arm.source_file, source_arm.source_column, source_arm.source_end_column, source_arm.pattern_operator, pattern_value, arm_result))
        set arm_index = arm_index + 1
    if numeric_match:
        if not saw_else or numeric_guards == 0: fail("YIR type check: numeric match requires at least one guard and a final else arm" + core_yir_source_location(result.expression.source_file, result.expression.source_line, result.expression.source_column, result.expression.source_end_column))
    else:
        if list_count(seen_tags) != case_count: fail("YIR type check: match on '" + matched_type + "' must cover every case exactly once" + core_yir_source_location(result.expression.source_file, result.expression.source_line, result.expression.source_column, result.expression.source_end_column))
    return result

fn core_yir_sequence_guarantees_return(block: List[YirStatement], depth: Number) -> Boolean:
    if depth > 128:
        if list_count(block) > 0: fail("YIR type check: return-path analysis exceeds 128 nested blocks" + core_yir_yir_statement_location(list_get(block, 0)))
        fail("YIR type check: return-path analysis exceeds 128 nested blocks")
        return false
    var index: Number = 0
    while index < list_count(block):
        if core_yir_statement_guarantees_return(list_get(block, index), depth + 1): return true
        set index = index + 1
    return false

fn core_yir_statement_guarantees_return(statement: YirStatement, depth: Number) -> Boolean:
    if depth > 128:
        fail("YIR type check: return-path analysis exceeds 128 nested blocks" + core_yir_yir_statement_location(statement))
        return false
    if statement.kind == "return": return true
    if statement.kind == "match_expr" and statement.slot2 == "return": return true
    if statement.kind == "arena_scope": return core_yir_sequence_guarantees_return(statement.body, depth + 1)
    if statement.kind == "if":
        if list_count(statement.branches) == 0 or not statement.has_else: return false
        var branch_index: Number = 0
        while branch_index < list_count(statement.branches):
            if not core_yir_sequence_guarantees_return(list_get(statement.branches, branch_index).body, depth + 1): return false
            set branch_index = branch_index + 1
        return core_yir_sequence_guarantees_return(statement.alternate, depth + 1)
    if statement.kind == "match":
        if list_count(statement.match_arms) == 0: return false
        var arm_index: Number = 0
        while arm_index < list_count(statement.match_arms):
            if not core_yir_sequence_guarantees_return(list_get(statement.match_arms, arm_index).body, depth + 1): return false
            set arm_index = arm_index + 1
        return true
    return false

fn core_yir_lower_block(source: List[HirStatement], names: TextList, slots: TextList, types: TextList, mutable_values: TextList, active_count: TextList, slot_serial: TextList, functions: List[HirFunction], shapes: List[HirShape], variants: List[HirVariant], return_type: Text, loop_depth: Number) -> List[YirStatement]:
    let result: List[YirStatement] = List[YirStatement]()
    var index: Number = 0
    while index < list_count(source):
        let lowered: YirStatement = core_yir_lower_stmt(list_get(source, index), names, slots, types, mutable_values, active_count, slot_serial, functions, shapes, variants, return_type, loop_depth)
        list_push(result, lowered)
        if lowered.kind == "let" and core_yir_list_view_element_type(lowered.value_type) != "":
            let cleanup_serial: Number = number_parse(list_get(slot_serial, 0))
            let cleanup_slot: Text = "%defer.auto." + number_text(cleanup_serial)
            list_set(slot_serial, 0, number_text(cleanup_serial + 1))
            var cleanup: YirStatement = core_yir_statement("defer", lowered.source_line)
            let cleanup_argument: YirExpr = core_yir_expr("variable", lowered.slot, lowered.value_type, List[YirExpr](), lowered.source_line)
            let cleanup_arguments: List[YirExpr] = List[YirExpr]()
            list_push(cleanup_arguments, cleanup_argument)
            set cleanup.expression = core_yir_expr("call", "list_view_end", "Unit", cleanup_arguments, lowered.source_line)
            set cleanup.slot = cleanup_slot
            set cleanup.value_type = "Unit"
            set cleanup.source_column = lowered.source_column
            set cleanup.source_end_column = lowered.source_end_column
            set cleanup.source_file = lowered.source_file
            list_push(result, cleanup)
        set index = index + 1
    return result

fn core_yir_lower_stmt(statement: HirStatement, names: TextList, slots: TextList, types: TextList, mutable_values: TextList, active_count: TextList, slot_serial: TextList, functions: List[HirFunction], shapes: List[HirShape], variants: List[HirVariant], return_type: Text, loop_depth: Number) -> YirStatement:
    var result: YirStatement = core_yir_statement(statement.kind, statement.source_line)
    set result.source_column = statement.source_column
    set result.source_end_column = statement.source_end_column
    set result.source_file = statement.source_file
    set result = core_yir_copy_statement_provenance(result, statement)
    let visible: Number = number_parse(list_get(active_count, 0))
    if statement.kind == "arena_scope":
        set result.expression = core_yir_lower_expr(statement.expression, names, slots, types, visible, functions, shapes, variants)
        if result.expression.value_type != "Number": fail("YIR type check: arena_scope limit must be Number bytes" + core_yir_statement_location(statement))
        let serial: Number = number_parse(list_get(slot_serial, 0))
        set result.slot = "%arena.scope." + number_text(serial)
        list_set(slot_serial, 0, number_text(serial + 1))
        list_set(active_count, 0, number_text(visible))
        set result.body = core_yir_lower_block(statement.body, names, slots, types, mutable_values, active_count, slot_serial, functions, shapes, variants, return_type, loop_depth)
        list_set(active_count, 0, number_text(visible))
        return result
    if statement.kind == "match_expr_return":
        if return_type == "Unit": fail("YIR type check: a match expression cannot return a value from a Unit function" + core_yir_statement_location(statement))
        set result = core_yir_lower_match_expr(statement, names, slots, types, mutable_values, visible, slot_serial, functions, shapes, variants, return_type, return_type)
        set result.source_column = statement.source_column
        set result.source_end_column = statement.source_end_column
        set result.source_file = statement.source_file
        set result = core_yir_copy_statement_provenance(result, statement)
        set result.slot2 = "return"
        return result
    if statement.kind == "match_expr_let" or statement.kind == "match_expr_var":
        if core_yir_visible_index(names, visible, statement.name) >= 0: fail("YIR type check: duplicate local '" + statement.name + "'" + core_yir_statement_location(statement))
        if core_yir_type_contains_list_view(statement.value_type): fail("YIR type check: ListView cannot be stored in a match expression binding" + core_yir_statement_location(statement))
        if not core_yir_known_type(statement.value_type, shapes, variants) or statement.value_type == "Unit": fail("YIR lowering: match result type '" + statement.value_type + "' is outside the active Core slice" + core_yir_statement_location(statement))
        set result = core_yir_lower_match_expr(statement, names, slots, types, mutable_values, visible, slot_serial, functions, shapes, variants, statement.value_type, return_type)
        set result.source_column = statement.source_column
        set result.source_end_column = statement.source_end_column
        set result.source_file = statement.source_file
        set result = core_yir_copy_statement_provenance(result, statement)
        let serial: Number = number_parse(list_get(slot_serial, 0))
        let slot: Text = "%slot." + number_text(serial)
        var mutability: Text = "let"
        var declaration_kind: Text = "let"
        if statement.kind == "match_expr_var":
            set mutability = "var"
            set declaration_kind = "var"
        core_yir_bind_local(names, slots, types, mutable_values, visible, statement.name, slot, statement.value_type, mutability)
        list_set(active_count, 0, number_text(visible + 1))
        list_set(slot_serial, 0, number_text(serial + 1))
        set result.name = statement.name
        set result.slot = slot
        set result.slot2 = declaration_kind
        set result.value_type = statement.value_type
        return result
    if statement.kind == "match_expr_set":
        let target: Number = core_yir_visible_index(names, visible, statement.name)
        if target < 0: fail("YIR type check: assignment to unknown variable '" + statement.name + "'" + core_yir_statement_location(statement))
        if target >= 0 and list_get(mutable_values, target) != "var": fail("YIR type check: set requires a mutable var '" + statement.name + "'" + core_yir_statement_location(statement))
        if target < 0: return result
        set result = core_yir_lower_match_expr(statement, names, slots, types, mutable_values, visible, slot_serial, functions, shapes, variants, list_get(types, target), return_type)
        set result.source_column = statement.source_column
        set result.source_end_column = statement.source_end_column
        set result.source_file = statement.source_file
        set result = core_yir_copy_statement_provenance(result, statement)
        set result.name = statement.name
        set result.slot = list_get(slots, target)
        set result.slot2 = "set"
        set result.value_type = list_get(types, target)
        return result
    if statement.kind == "defer":
        if statement.expression.kind != "call": fail("YIR type check: defer requires a direct function call" + core_yir_statement_location(statement))
        set result.expression = core_yir_lower_expr(statement.expression, names, slots, types, visible, functions, shapes, variants)
        if result.expression.kind != "call" and result.expression.kind != "list_push" and result.expression.kind != "list_set" and result.expression.kind != "list_try_push" and result.expression.kind != "list_try_set": fail("YIR type check: defer target must be a callable Core function" + core_yir_statement_location(statement))
        if core_yir_result_argument_type(result.expression.value_type, 0) != "": fail("YIR type check: defer target cannot return Result; handle its result before deferring" + core_yir_statement_location(statement))
        let defer_serial: Number = number_parse(list_get(slot_serial, 0))
        set result.slot = "%defer." + number_text(defer_serial)
        set result.value_type = result.expression.value_type
        list_set(slot_serial, 0, number_text(defer_serial + 1))
        return result
    if statement.kind == "let" or statement.kind == "var":
        if core_yir_visible_index(names, visible, statement.name) >= 0:
            fail("YIR type check: duplicate local '" + statement.name + "'" + core_yir_statement_location(statement))
        if not core_yir_known_type(statement.value_type, shapes, variants) or statement.value_type == "Unit":
            fail("YIR lowering: local type '" + statement.value_type + "' is outside the active Core slice" + core_yir_local_type_location(statement))
        let value: YirExpr = core_yir_lower_context_expr(statement.expression, names, slots, types, visible, functions, shapes, variants, statement.value_type, return_type, false)
        if core_yir_list_view_element_type(statement.value_type) != "" and (statement.kind != "let" or value.kind != "call" or (value.value != "list_read_view" and value.value != "list_read_view_prefix")):
            fail("YIR type check: ListView must be an immutable local initialized directly by a ListView constructor" + core_yir_statement_location(statement))
        if core_yir_type_contains_list_view(statement.value_type) and core_yir_list_view_element_type(statement.value_type) == "":
            fail("YIR type check: ListView cannot be stored inside another value" + core_yir_statement_location(statement))
        if value.value_type != statement.value_type:
            fail("YIR type check: initializer type for '" + statement.name + "' does not match " + statement.value_type + core_yir_source_location(statement.expression.source_file, statement.expression.source_line, statement.expression.source_column, statement.expression.source_end_column))
        let serial: Number = number_parse(list_get(slot_serial, 0))
        let slot: Text = "%slot." + number_text(serial)
        core_yir_bind_local(names, slots, types, mutable_values, visible, statement.name, slot, statement.value_type, statement.kind)
        list_set(active_count, 0, number_text(visible + 1))
        list_set(slot_serial, 0, number_text(serial + 1))
        set result.slot = slot
        set result.name = statement.name
        set result.value_type = statement.value_type
        set result.expression = value
        return result
    if statement.kind == "set":
        let target: Number = core_yir_visible_index(names, visible, statement.name)
        if target < 0: fail("YIR type check: assignment to unknown variable '" + statement.name + "'" + core_yir_statement_location(statement))
        if target >= 0 and list_get(mutable_values, target) != "var": fail("YIR type check: set requires a mutable var '" + statement.name + "'" + core_yir_statement_location(statement))
        let value: YirExpr = core_yir_lower_context_expr(statement.expression, names, slots, types, visible, functions, shapes, variants, list_get(types, target), return_type, false)
        if target >= 0 and value.value_type != list_get(types, target): fail("YIR type check: assigned value has the wrong type" + core_yir_source_location(value.source_file, value.source_line, value.source_column, value.source_end_column))
        if target >= 0: set result.slot = list_get(slots, target)
        set result.expression = value
        set result.value_type = value.value_type
        return result
    if statement.kind == "set_field":
        let target: Number = core_yir_visible_index(names, visible, statement.name)
        if target < 0: fail("YIR type check: field update on unknown variable '" + statement.name + "'" + core_yir_statement_location(statement))
        if target >= 0 and list_get(mutable_values, target) != "var": fail("YIR type check: field update requires a mutable var '" + statement.name + "'" + core_yir_statement_location(statement))
        if list_count(statement.field_path) == 0: fail("YIR type check: field update requires a nonempty shape path" + core_yir_statement_location(statement))
        let field_path: List[YirFieldPathStep] = List[YirFieldPathStep]()
        var current_type: Text = ""
        if target >= 0:
            set current_type = list_get(types, target)
            if core_yir_is_mut_borrow_type(current_type): set current_type = core_yir_base_type(current_type)
        var path_index: Number = 0
        while path_index < list_count(statement.field_path):
            let field_name: Text = list_get(statement.field_path, path_index)
            let shape_index: Number = core_yir_find_shape(shapes, current_type)
            if shape_index < 0: fail("YIR type check: nested field update path passes through non-shape type '" + current_type + "'" + core_yir_field_path_location(statement, path_index))
            let shape: HirShape = list_get(shapes, shape_index)
            let field_index: Number = core_yir_shape_field_index(shape, field_name)
            if field_index < 0: fail("YIR type check: shape '" + current_type + "' has no field '" + field_name + "'" + core_yir_field_path_location(statement, path_index))
            let field_type: Text = list_get(shape.fields, field_index).value_type
            list_push(field_path, YirFieldPathStep(current_type, field_name, field_index, field_type))
            if path_index + 1 < list_count(statement.field_path) and core_yir_find_shape(shapes, field_type) < 0:
                fail("YIR type check: nested field update path cannot traverse type '" + field_type + "'" + core_yir_field_path_location(statement, path_index + 1))
            set current_type = field_type
            set path_index = path_index + 1
        let value: YirExpr = core_yir_lower_context_expr(statement.expression, names, slots, types, visible, functions, shapes, variants, current_type, return_type, false)
        if value.value_type != current_type: fail("YIR type check: field path expects " + current_type + core_yir_source_location(value.source_file, value.source_line, value.source_column, value.source_end_column))
        if target >= 0: set result.slot = list_get(slots, target)
        if target >= 0: set result.name = core_yir_base_type(list_get(types, target))
        set result.field_path = field_path
        set result.expression = value
        set result.value_type = current_type
        return result
    if statement.kind == "say":
        set result.expression = core_yir_lower_expr(statement.expression, names, slots, types, visible, functions, shapes, variants)
        if not core_yir_printable_type(result.expression.value_type): fail("YIR type check: say requires a printable scalar value" + core_yir_source_location(result.expression.source_file, result.expression.source_line, result.expression.source_column, result.expression.source_end_column))
        return result
    if statement.kind == "assert":
        set result.name = statement.name
        set result.expression = core_yir_lower_expr(statement.expression, names, slots, types, visible, functions, shapes, variants)
        if result.expression.value_type != "Boolean": fail("YIR type check: assert requires Boolean" + core_yir_source_location(result.expression.source_file, result.expression.source_line, result.expression.source_column, result.expression.source_end_column))
        return result
    if statement.kind == "return":
        if return_type == "Unit":
            if statement.expression.kind != "unit": fail("YIR type check: Unit function cannot return a value" + core_yir_statement_location(statement))
        else:
            if statement.expression.kind == "unit": fail("YIR type check: return value is required" + core_yir_statement_location(statement))
            var expected_return_type: Text = return_type
            if statement.expression.kind == "try": set expected_return_type = core_yir_result_argument_type(return_type, 0)
            let value: YirExpr = core_yir_lower_context_expr(statement.expression, names, slots, types, visible, functions, shapes, variants, expected_return_type, return_type, true)
            if value.value_type != return_type: fail("YIR type check: return type does not match " + return_type + core_yir_source_location(value.source_file, value.source_line, value.source_column, value.source_end_column))
            set result.expression = value
        return result
    if statement.kind == "expression":
        set result.expression = core_yir_lower_expr(statement.expression, names, slots, types, visible, functions, shapes, variants)
        return result
    if statement.kind == "if":
        var branch_index: Number = 0
        while branch_index < list_count(statement.branches):
            let branch: HirBranch = list_get(statement.branches, branch_index)
            let condition: YirExpr = core_yir_lower_expr(branch.condition, names, slots, types, visible, functions, shapes, variants)
            if condition.value_type != "Boolean": fail("YIR type check: if condition requires Boolean" + core_yir_source_location(condition.source_file, condition.source_line, condition.source_column, condition.source_end_column))
            list_set(active_count, 0, number_text(visible))
            let body: List[YirStatement] = core_yir_lower_block(branch.body, names, slots, types, mutable_values, active_count, slot_serial, functions, shapes, variants, return_type, loop_depth)
            list_set(active_count, 0, number_text(visible))
            list_push(result.branches, YirBranch(condition, body, branch.source_line, branch.source_file, branch.source_column, branch.source_end_column))
            set branch_index = branch_index + 1
        list_set(active_count, 0, number_text(visible))
        set result.alternate = core_yir_lower_block(statement.alternate, names, slots, types, mutable_values, active_count, slot_serial, functions, shapes, variants, return_type, loop_depth)
        set result.has_else = statement.has_else
        list_set(active_count, 0, number_text(visible))
        return result
    if statement.kind == "match":
        set result.expression = core_yir_lower_expr(statement.expression, names, slots, types, visible, functions, shapes, variants)
        let variant_index: Number = core_yir_find_variant(variants, result.expression.value_type)
        let option_payload: Text = core_yir_option_payload_type(result.expression.value_type)
        let result_success: Text = core_yir_result_argument_type(result.expression.value_type, 0)
        let result_error: Text = core_yir_result_argument_type(result.expression.value_type, 1)
        let builtin_match: Boolean = option_payload != "" or (result_success != "" and result_error != "")
        if variant_index < 0 and not builtin_match: fail("YIR type check: match requires a declared variant, Option, or Result value" + core_yir_source_location(result.expression.source_file, result.expression.source_line, result.expression.source_column, result.expression.source_end_column))
        var case_count: Number = 0
        if builtin_match: set case_count = 2
        else: set case_count = list_count(list_get(variants, variant_index).cases)
        let seen_tags: List[Number] = List[Number]()
        var arm_index: Number = 0
        while arm_index < list_count(statement.match_arms):
            let source_arm: HirMatchArm = list_get(statement.match_arms, arm_index)
            var tag: Number = -1
            var payload_type: Text = ""
            var payload_count: Number = 0
            if builtin_match:
                set tag = core_yir_builtin_match_case_tag(result.expression.value_type, source_arm.case_name)
                set payload_type = core_yir_builtin_match_payload_type(result.expression.value_type, source_arm.case_name)
                if payload_type != "": set payload_count = 1
            else:
                let variant: HirVariant = list_get(variants, variant_index)
                set tag = core_yir_find_variant_case(variant, source_arm.case_name)
                if tag >= 0: set payload_count = list_count(list_get(variant.cases, tag).fields)
            if tag < 0: fail("YIR type check: no case '" + source_arm.case_name + "' for matched type '" + result.expression.value_type + "'" + core_yir_match_arm_location(source_arm))
            var seen_index: Number = 0
            while seen_index < list_count(seen_tags):
                if list_get(seen_tags, seen_index) == tag: fail("YIR type check: duplicate match arm for '" + source_arm.case_name + "'" + core_yir_match_arm_location(source_arm))
                set seen_index = seen_index + 1
            list_push(seen_tags, tag)
            if list_count(source_arm.bindings) != payload_count: fail("YIR type check: match arm '" + source_arm.case_name + "' binds the wrong number of payload fields" + core_yir_match_arm_location(source_arm))
            let arm_bindings: List[YirMatchBinding] = List[YirMatchBinding]()
            let arm_names: TextList = text_list()
            var binding_index: Number = 0
            while binding_index < list_count(source_arm.bindings):
                let binding_name: Text = list_get(source_arm.bindings, binding_index)
                var field_type: Text = payload_type
                if not builtin_match:
                    let variant_case: HirVariantCase = list_get(list_get(variants, variant_index).cases, tag)
                    set field_type = list_get(variant_case.fields, binding_index).value_type
                if binding_name != "_":
                    if core_yir_visible_index(arm_names, list_count(arm_names), binding_name) >= 0:
                        let binding_column: Number = number_parse(list_get(source_arm.binding_columns, binding_index))
                        fail("YIR type check: duplicate binding '" + binding_name + "' in match arm" + core_yir_source_location(source_arm.source_file, source_arm.source_line, binding_column, binding_column + text_length(binding_name) - 1))
                    if core_yir_visible_index(names, visible, binding_name) >= 0:
                        let binding_column: Number = number_parse(list_get(source_arm.binding_columns, binding_index))
                        fail("YIR type check: match binding duplicates a name in the active scope" + core_yir_source_location(source_arm.source_file, source_arm.source_line, binding_column, binding_column + text_length(binding_name) - 1))
                    list_push(arm_names, binding_name)
                    let serial: Number = number_parse(list_get(slot_serial, 0))
                    let slot: Text = "%slot." + number_text(serial)
                    core_yir_bind_local(names, slots, types, mutable_values, visible + list_count(arm_bindings), binding_name, slot, field_type, "let")
                    list_set(slot_serial, 0, number_text(serial + 1))
                    list_push(arm_bindings, YirMatchBinding(binding_index, slot, field_type))
                set binding_index = binding_index + 1
            list_set(active_count, 0, number_text(visible + list_count(arm_bindings)))
            let arm_body: List[YirStatement] = core_yir_lower_block(source_arm.body, names, slots, types, mutable_values, active_count, slot_serial, functions, shapes, variants, return_type, loop_depth)
            list_set(active_count, 0, number_text(visible))
            list_push(result.match_arms, YirMatchArm(tag, source_arm.case_name, arm_bindings, arm_body, source_arm.source_line, source_arm.source_file, source_arm.source_column, source_arm.source_end_column, "", core_yir_empty_expr(source_arm.source_line), core_yir_empty_expr(source_arm.source_line)))
            set arm_index = arm_index + 1
        if list_count(seen_tags) != case_count: fail("YIR type check: match on '" + result.expression.value_type + "' must cover every case exactly once" + core_yir_source_location(result.expression.source_file, result.expression.source_line, result.expression.source_column, result.expression.source_end_column))
        set result.value_type = result.expression.value_type
        return result
    if statement.kind == "while":
        set result.expression = core_yir_lower_expr(statement.expression, names, slots, types, visible, functions, shapes, variants)
        if result.expression.value_type != "Boolean": fail("YIR type check: while condition requires Boolean" + core_yir_source_location(result.expression.source_file, result.expression.source_line, result.expression.source_column, result.expression.source_end_column))
        list_set(active_count, 0, number_text(visible))
        set result.body = core_yir_lower_block(statement.body, names, slots, types, mutable_values, active_count, slot_serial, functions, shapes, variants, return_type, loop_depth + 1)
        list_set(active_count, 0, number_text(visible))
        return result
    if statement.kind == "for_range":
        if core_yir_visible_index(names, visible, statement.name) >= 0: fail("YIR type check: for variable duplicates a name in the active scope" + core_yir_statement_location(statement))
        let start_hir: HirStatement = list_get(statement.alternate, 0)
        let end_hir: HirStatement = list_get(statement.alternate, 1)
        set result.expression = core_yir_lower_expr(start_hir.expression, names, slots, types, visible, functions, shapes, variants)
        set result.expression2 = core_yir_lower_expr(end_hir.expression, names, slots, types, visible, functions, shapes, variants)
        if result.expression.value_type != "Number" or result.expression2.value_type != "Number":
            if result.expression.value_type != "Number":
                fail("YIR type check: Number range bounds must be Number" + core_yir_source_location(result.expression.source_file, result.expression.source_line, result.expression.source_column, result.expression.source_end_column))
            else:
                fail("YIR type check: Number range bounds must be Number" + core_yir_source_location(result.expression2.source_file, result.expression2.source_line, result.expression2.source_column, result.expression2.source_end_column))
        let serial: Number = number_parse(list_get(slot_serial, 0))
        let slot: Text = "%slot." + number_text(serial)
        core_yir_bind_local(names, slots, types, mutable_values, visible, statement.name, slot, "Number", "var")
        list_set(active_count, 0, number_text(visible + 1))
        list_set(slot_serial, 0, number_text(serial + 1))
        set result.slot = slot
        set result.name = statement.name
        set result.value_type = "Number"
        set result.body = core_yir_lower_block(statement.body, names, slots, types, mutable_values, active_count, slot_serial, functions, shapes, variants, return_type, loop_depth + 1)
        list_set(active_count, 0, number_text(visible))
        return result
    if statement.kind == "for_each":
        if core_yir_visible_index(names, visible, statement.name) >= 0: fail("YIR type check: for variable duplicates a name in the active scope" + core_yir_statement_location(statement))
        let collection: YirExpr = core_yir_lower_expr(statement.expression, names, slots, types, visible, functions, shapes, variants)
        let item_type: Text = core_yir_iterable_element_type(collection.value_type)
        if item_type == "": fail("YIR type check: for loop requires a supported List, TextList, or ListView" + core_yir_source_location(collection.source_file, collection.source_line, collection.source_column, collection.source_end_column))
        let serial: Number = number_parse(list_get(slot_serial, 0))
        let item_slot: Text = "%slot." + number_text(serial)
        let index_slot: Text = "%slot." + number_text(serial + 1)
        core_yir_bind_local(names, slots, types, mutable_values, visible, statement.name, item_slot, item_type, "let")
        list_set(active_count, 0, number_text(visible + 1))
        list_set(slot_serial, 0, number_text(serial + 2))
        set result.name = statement.name
        set result.slot = item_slot
        set result.slot2 = index_slot
        set result.value_type = item_type
        set result.expression = collection
        set result.body = core_yir_lower_block(statement.body, names, slots, types, mutable_values, active_count, slot_serial, functions, shapes, variants, return_type, loop_depth + 1)
        list_set(active_count, 0, number_text(visible))
        return result
    if statement.kind == "break" or statement.kind == "continue":
        if loop_depth <= 0: fail("YIR type check: " + statement.kind + " is only valid inside a loop" + core_yir_statement_location(statement))
        return result
    fail("YIR lowering: unsupported statement kind '" + statement.kind + "'" + core_yir_statement_location(statement))
    return result

fn lower_core_hir_to_yir(program: HirProgram) -> YirProgram:
    let functions: List[YirFunction] = List[YirFunction]()
    var variant_index: Number = 0
    while variant_index < list_count(program.variants):
        let variant: HirVariant = list_get(program.variants, variant_index)
        let variant_location: Text = core_yir_source_location(variant.source_file, variant.source_line, variant.source_column, variant.name_end_column)
        let variant_header_location: Text = core_yir_source_location(variant.source_file, variant.source_line, variant.header_source_column, variant.header_source_end_column)
        if variant.header_source_column < 1 or variant.header_source_end_column < variant.header_source_column: fail("YIR verifier: malformed variant header source span" + variant_header_location)
        if core_yir_find_variant(program.variants, variant.name) != variant_index: fail("YIR type check: duplicate variant '" + variant.name + "'" + variant_location)
        if core_yir_reserved_decl_type_name(variant.name): fail("YIR type check: variant name conflicts with a built-in type '" + variant.name + "'" + variant_location)
        if core_yir_find_shape(program.shapes, variant.name) >= 0: fail("YIR type check: shape and variant share the name '" + variant.name + "'" + variant_location)
        var declared_function: Number = 0
        while declared_function < list_count(program.functions):
            if list_get(program.functions, declared_function).name == variant.name: fail("YIR type check: variant and function share the name '" + variant.name + "'" + variant_location)
            set declared_function = declared_function + 1
        var case_index: Number = 0
        while case_index < list_count(variant.cases):
            let variant_case: HirVariantCase = list_get(variant.cases, case_index)
            let case_location: Text = core_yir_source_location(variant_case.source_file, variant_case.source_line, variant_case.source_column, variant_case.name_end_column)
            let case_header_location: Text = core_yir_source_location(variant_case.source_file, variant_case.source_line, variant_case.header_source_column, variant_case.header_source_end_column)
            if variant_case.header_source_column < 1 or variant_case.header_source_end_column < variant_case.header_source_column: fail("YIR verifier: malformed variant case header source span" + case_header_location)
            if core_yir_find_variant_case(variant, variant_case.name) != case_index: fail("YIR type check: duplicate case '" + variant_case.name + "' in variant '" + variant.name + "'" + case_location)
            var field_index: Number = 0
            while field_index < list_count(variant_case.fields):
                let field: HirField = list_get(variant_case.fields, field_index)
                if not core_yir_known_type(field.value_type, program.shapes, program.variants) or field.value_type == "Unit": fail("YIR type check: unsupported payload field type '" + field.value_type + "'" + core_yir_source_location(field.source_file, field.source_line, field.type_column, field.type_end_column))
                if core_yir_type_contains_list_view(field.value_type): fail("YIR type check: ListView cannot be stored in a variant" + core_yir_source_location(field.source_file, field.source_line, field.type_column, field.type_end_column))
                var previous_field: Number = 0
                while previous_field < field_index:
                    if list_get(variant_case.fields, previous_field).name == field.name: fail("YIR type check: duplicate payload field '" + field.name + "' in case '" + variant_case.name + "'" + core_yir_source_location(field.source_file, field.source_line, field.source_column, field.name_end_column))
                    set previous_field = previous_field + 1
                set field_index = field_index + 1
            set case_index = case_index + 1
        set variant_index = variant_index + 1
    var shape_index: Number = 0
    while shape_index < list_count(program.shapes):
        let shape: HirShape = list_get(program.shapes, shape_index)
        let shape_location: Text = core_yir_source_location(shape.source_file, shape.source_line, shape.source_column, shape.name_end_column)
        let shape_header_location: Text = core_yir_source_location(shape.source_file, shape.source_line, shape.header_source_column, shape.header_source_end_column)
        if shape.header_source_column < 1 or shape.header_source_end_column < shape.header_source_column: fail("YIR verifier: malformed shape header source span" + shape_header_location)
        if core_yir_find_shape(program.shapes, shape.name) != shape_index: fail("YIR type check: duplicate shape '" + shape.name + "'" + shape_location)
        if core_yir_reserved_decl_type_name(shape.name): fail("YIR type check: shape name conflicts with a built-in type '" + shape.name + "'" + shape_location)
        if core_yir_find_variant(program.variants, shape.name) >= 0: fail("YIR type check: shape and variant share the name '" + shape.name + "'" + shape_location)
        var function_name_index: Number = 0
        while function_name_index < list_count(program.functions):
            if list_get(program.functions, function_name_index).name == shape.name: fail("YIR type check: shape and function share the name '" + shape.name + "'" + shape_location)
            set function_name_index = function_name_index + 1
        var field_index: Number = 0
        while field_index < list_count(shape.fields):
            let field: HirField = list_get(shape.fields, field_index)
            if not core_yir_known_type(field.value_type, program.shapes, program.variants) or field.value_type == "Unit": fail("YIR type check: unsupported shape field type '" + field.value_type + "'" + core_yir_source_location(field.source_file, field.source_line, field.type_column, field.type_end_column))
            if core_yir_type_contains_list_view(field.value_type): fail("YIR type check: ListView cannot be stored in a shape" + core_yir_source_location(field.source_file, field.source_line, field.type_column, field.type_end_column))
            var previous_field: Number = 0
            while previous_field < field_index:
                if list_get(shape.fields, previous_field).name == field.name: fail("YIR type check: duplicate field '" + field.name + "' in shape '" + shape.name + "'" + core_yir_source_location(field.source_file, field.source_line, field.source_column, field.name_end_column))
                set previous_field = previous_field + 1
            if core_yir_find_shape(program.shapes, field.value_type) >= 0:
                let visited: TextList = text_list()
                if core_yir_shape_reaches(program.shapes, field.value_type, shape.name, visited): fail("YIR type check: by-value shape cycle from '" + shape.name + "' through '" + field.value_type + "'" + core_yir_source_location(field.source_file, field.source_line, field.type_column, field.type_end_column))
            set field_index = field_index + 1
        set shape_index = shape_index + 1
    var function_index: Number = 0
    while function_index < list_count(program.functions):
        let source: HirFunction = list_get(program.functions, function_index)
        let function_location: Text = core_yir_source_location(source.source_file, source.source_line, source.source_column, source.name_end_column)
        if core_yir_find_function(program.functions, source.name) != function_index: fail("YIR type check: duplicate function '" + source.name + "'" + function_location)
        let names: TextList = text_list()
        let slots: TextList = text_list()
        let types: TextList = text_list()
        let mutabilities: TextList = text_list()
        let active: TextList = text_list()
        let slot_serial: TextList = text_list()
        list_push(active, "0")
        list_push(slot_serial, "0")
        let parameters: List[YirParameter] = List[YirParameter]()
        var parameter_index: Number = 0
        while parameter_index < list_count(source.parameters):
            let parameter: HirParameter = list_get(source.parameters, parameter_index)
            if not core_yir_known_type(parameter.value_type, program.shapes, program.variants) or parameter.value_type == "Unit": fail("YIR lowering: unsupported parameter type '" + parameter.value_type + "'" + core_yir_source_location(source.source_file, parameter.source_line, parameter.type_column, parameter.type_end_column))
            if core_yir_visible_index(names, number_parse(list_get(active, 0)), parameter.name) >= 0: fail("YIR type check: duplicate parameter '" + parameter.name + "'" + core_yir_source_location(source.source_file, parameter.source_line, parameter.source_column, parameter.name_end_column))
            let slot: Text = "%arg" + number_text(parameter_index)
            list_push(parameters, YirParameter(parameter.name, slot, parameter.value_type, parameter.source_line, source.source_file, parameter.source_column, parameter.name_end_column, parameter.type_column, parameter.type_end_column))
            list_push(names, parameter.name)
            list_push(slots, slot)
            list_push(types, parameter.value_type)
            var param_mut: Text = "let"
            if core_yir_is_mut_borrow_type(parameter.value_type): set param_mut = "var"
            list_push(mutabilities, param_mut)
            list_set(active, 0, number_text(parameter_index + 1))
            set parameter_index = parameter_index + 1
        if core_yir_find_variant(program.variants, source.name) >= 0: fail("YIR type check: variant and function share the name '" + source.name + "'" + function_location)
        if not core_yir_known_type(source.return_type, program.shapes, program.variants): fail("YIR lowering: unsupported return type '" + source.return_type + "'" + core_yir_source_location(source.source_file, source.source_line, source.return_type_column, source.return_type_end_column))
        if core_yir_type_contains_list_view(source.return_type): fail("YIR type check: a borrowed ListView cannot escape as a function return value" + core_yir_source_location(source.source_file, source.source_line, source.return_type_column, source.return_type_end_column))
        let body: List[YirStatement] = core_yir_lower_block(source.body, names, slots, types, mutabilities, active, slot_serial, program.functions, program.shapes, program.variants, source.return_type, 0)
        if source.return_type != "Unit" and not core_yir_sequence_guarantees_return(body, 0):
            fail("YIR type check: function must return on every path" + core_yir_source_location(source.source_file, source.source_line, source.source_column, source.name_end_column))
        list_push(functions, YirFunction(source.name, parameters, source.return_type, body, source.source_line, source.source_file, source.source_column, source.name_end_column, source.return_type_column, source.return_type_end_column, source.header_source_column, source.header_source_end_column, source.is_async))
        set function_index = function_index + 1
    let names: TextList = text_list()
    let slots: TextList = text_list()
    let types: TextList = text_list()
    let mutabilities: TextList = text_list()
    let active: TextList = text_list()
    let slot_serial: TextList = text_list()
    list_push(active, "0")
    list_push(slot_serial, "0")
    let body: List[YirStatement] = core_yir_lower_block(program.body, names, slots, types, mutabilities, active, slot_serial, program.functions, program.shapes, program.variants, "Unit", 0)
    return YirProgram(functions, program.shapes, program.variants, body, program.start_source_line, program.start_source_file, program.start_source_column, program.start_source_end_column)

fn core_yir_find_lowered_function(functions: List[YirFunction], sought: Text) -> Number:
    var index: Number = 0
    while index < list_count(functions):
        if list_get(functions, index).name == sought: return index
        set index = index + 1
    return -1

fn core_yir_verify_list_view_call(expression: YirExpr, child_types: List[Text]) -> Text:
    let child_count: Number = list_count(child_types)
    var inferred_type: Text = ""
    if expression.value == "list_read_view":
        if child_count != 1: fail("YIR verifier: list_read_view expects List[T]")
        let item_type: Text = core_yir_list_element_type(list_get(child_types, 0))
        if item_type == "": fail("YIR verifier: list_read_view expects List[T]")
        set inferred_type = "ListView[" + item_type + "]"
    if expression.value == "list_read_view_prefix":
        if child_count != 2: fail("YIR verifier: list_read_view_prefix expects (List[T], Number)")
        let item_type: Text = core_yir_list_element_type(list_get(child_types, 0))
        if item_type == "" or list_get(child_types, 1) != "Number": fail("YIR verifier: list_read_view_prefix expects (List[T], Number)")
        set inferred_type = "ListView[" + item_type + "]"
    if expression.value == "list_view_get":
        if child_count != 2: fail("YIR verifier: list_view_get expects (ListView[T], Number)")
        set inferred_type = core_yir_list_view_element_type(list_get(child_types, 0))
        if inferred_type == "" or list_get(child_types, 1) != "Number": fail("YIR verifier: list_view_get expects (ListView[T], Number)")
    if expression.value == "list_view_count" or expression.value == "list_view_end":
        if child_count != 1: fail("YIR verifier: ListView builtin expects one argument")
        if core_yir_list_view_element_type(list_get(child_types, 0)) == "": fail("YIR verifier: ListView builtin expects ListView[T]")
        if expression.value == "list_view_count": set inferred_type = "Number"
        if expression.value == "list_view_end": set inferred_type = "Unit"
    if inferred_type == "" or inferred_type != expression.value_type:
        fail("YIR verifier: ListView builtin result type mismatch" + core_yir_yir_expression_location(expression))
    return inferred_type

fn core_yir_verify_vfs_call(expression: YirExpr, child_types: List[Text]) -> Text:
    var expected_count: Number = 1
    var first_type: Text = "Number"
    var second_type: Text = ""
    var third_type: Text = ""
    if expression.value == "vfs_root_open": set first_type = "Text"
    if expression.value == "vfs_open_read" or expression.value == "vfs_open_read_public" or expression.value == "vfs_open_rw" or expression.value == "vfs_create_exclusive" or expression.value == "vfs_lock_exclusive" or expression.value == "vfs_remove":
        set expected_count = 2
        set second_type = "Text"
    if expression.value == "vfs_read_exact":
        set expected_count = 3
        set second_type = "Number"
        set third_type = "Number"
    if expression.value == "vfs_write_exact":
        set expected_count = 3
        set second_type = "Number"
        set third_type = "Bytes"
    if expression.value == "vfs_truncate":
        set expected_count = 2
        set second_type = "Number"
    if expression.value == "vfs_preallocate":
        set expected_count = 2
        set second_type = "Number"
    if expression.value == "vfs_rename":
        set expected_count = 3
        set second_type = "Text"
        set third_type = "Text"
    if list_count(child_types) != expected_count: fail("YIR verifier: VFS builtin arity mismatch for '" + expression.value + "'")
    if list_get(child_types, 0) != first_type: fail("YIR verifier: VFS builtin first argument mismatch for '" + expression.value + "'")
    if expected_count > 1 and list_get(child_types, 1) != second_type: fail("YIR verifier: VFS builtin second argument mismatch for '" + expression.value + "'")
    if expected_count > 2 and list_get(child_types, 2) != third_type: fail("YIR verifier: VFS builtin third argument mismatch for '" + expression.value + "'")
    let result_type: Text = core_yir_vfs_result_type(expression.value)
    if expression.value_type != result_type: fail("YIR verifier: VFS builtin result type mismatch for '" + expression.value + "'")
    return result_type

fn core_yir_verify_net_call(expression: YirExpr, child_types: List[Text]) -> Text:
    var expected_count: Number = 1
    var first_type: Text = "Number"
    var second_type: Text = ""
    var third_type: Text = ""
    if expression.value == "net_listen" or expression.value == "net_connect":
        set expected_count = 3
        set first_type = "Text"
        set second_type = "Number"
        set third_type = "Number"
    if expression.value == "net_accept":
        set expected_count = 2
        set first_type = "Number"
        set second_type = "Number"
    if expression.value == "net_read":
