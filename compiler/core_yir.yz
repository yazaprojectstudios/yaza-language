# Typed Core YIR and source-level type checking.
use "core_hir"

shape YirExpr:
    kind: Text
    value: Text
    value2: Text
    value_type: Text
    children: List[YirExpr]
    source_line: Number
    source_column: Number
    source_end_column: Number
    source_file: Text

shape YirParameter:
    name: Text
    slot: Text
    value_type: Text
    source_line: Number
    source_file: Text
    name_column: Number
    name_end_column: Number
    type_column: Number
    type_end_column: Number

shape YirBranch:
    condition: YirExpr
    body: List[YirStatement]
    source_line: Number
    source_file: Text
    source_column: Number
    source_end_column: Number

shape YirMatchBinding:
    field_index: Number
    slot: Text
    value_type: Text

shape YirFieldPathStep:
    parent_type: Text
    field_name: Text
    field_index: Number
    field_type: Text

shape YirMatchArm:
    tag: Number
    case_name: Text
    bindings: List[YirMatchBinding]
    body: List[YirStatement]
    source_line: Number
    source_file: Text
    source_column: Number
    source_end_column: Number
    pattern_operator: Text
    pattern_value: YirExpr
    result_expression: YirExpr

shape YirStatement:
    kind: Text
    name: Text
    slot: Text
    slot2: Text
    value_type: Text
    expression: YirExpr
    expression2: YirExpr
    body: List[YirStatement]
    alternate: List[YirStatement]
    branches: List[YirBranch]
    match_arms: List[YirMatchArm]
    source_line: Number
    source_column: Number
    source_end_column: Number
    source_file: Text
    field_path: List[YirFieldPathStep]
    header_source_line: Number
    header_source_file: Text
    header_source_column: Number
    header_source_end_column: Number
    else_source_line: Number
    else_source_file: Text
    else_source_column: Number
    else_source_end_column: Number
    has_else: Boolean

shape YirFunction:
    name: Text
    parameters: List[YirParameter]
    return_type: Text
    body: List[YirStatement]
    source_line: Number
    source_file: Text
    source_column: Number
    source_end_column: Number
    return_type_column: Number
    return_type_end_column: Number
    header_source_column: Number
    header_source_end_column: Number
    is_async: Boolean

shape YirProgram:
    functions: List[YirFunction]
    shapes: List[HirShape]
    variants: List[HirVariant]
    body: List[YirStatement]
    start_source_line: Number
    start_source_file: Text
    start_source_column: Number
    start_source_end_column: Number

shape YirOwnerEffect:
    destination: TextList
    value: TextList

shape YirOwnerListEffect:
    destination: Text
    element_type: Text
    value: TextList
    field_paths: TextList
    field_owners: TextList

shape YirOwnerSummary:
    function_name: Text
    origins: TextList
    effects: List[YirOwnerEffect]
    list_effects: List[YirOwnerListEffect]
    return_field_paths: TextList
    return_field_owners: TextList

shape YirOwnerEnvironment:
    slots: TextList
    types: TextList
    regions: TextList
    owners: TextList
    field_keys: TextList
    field_owners: TextList

shape YirOwnerContext:
    functions: List[YirFunction]
    shapes: List[HirShape]
    variants: List[HirVariant]
    summaries: List[YirOwnerSummary]
    regions: TextList
    returns: TextList
    effects: List[YirOwnerEffect]
    list_effects: List[YirOwnerListEffect]
    return_field_paths: TextList
    return_field_owners: TextList

fn core_yir_expr(kind: Text, value: Text, value_type: Text, children: List[YirExpr], source_line: Number) -> YirExpr:
    return YirExpr(kind, value, "", value_type, children, source_line, 1, 1, "")

fn core_yir_source_location(source_file: Text, source_line: Number, source_column: Number, source_end_column: Number) -> Text:
    if source_file != "": return " at " + source_file + ":" + number_text(source_line) + ":" + number_text(source_column) + "-" + number_text(source_end_column)
    return " at line " + number_text(source_line) + ", column " + number_text(source_column) + " (through " + number_text(source_end_column) + ")"

fn core_yir_expression_location(expression: HirExpr) -> Text:
    return core_yir_source_location(expression.source_file, expression.source_line, expression.source_column, expression.source_end_column)

fn core_yir_statement_location(statement: HirStatement) -> Text:
    return core_yir_source_location(statement.source_file, statement.source_line, statement.source_column, statement.source_end_column)

fn core_yir_local_type_location(statement: HirStatement) -> Text:
    if statement.header_source_line > 0:
        return core_yir_source_location(statement.header_source_file, statement.header_source_line, statement.header_source_column, statement.header_source_end_column)
    return core_yir_statement_location(statement)

fn core_yir_yir_statement_location(statement: YirStatement) -> Text:
    return core_yir_source_location(statement.source_file, statement.source_line, statement.source_column, statement.source_end_column)

fn core_yir_yir_expression_location(expression: YirExpr) -> Text:
    return core_yir_source_location(expression.source_file, expression.source_line, expression.source_column, expression.source_end_column)

fn core_yir_yir_match_arm_location(arm: YirMatchArm) -> Text:
    return core_yir_source_location(arm.source_file, arm.source_line, arm.source_column, arm.source_end_column)

fn core_yir_branch_location(branch: YirBranch) -> Text:
    return core_yir_source_location(branch.source_file, branch.source_line, branch.source_column, branch.source_end_column)

fn core_yir_header_location(statement: YirStatement) -> Text:
    return core_yir_source_location(statement.header_source_file, statement.header_source_line, statement.header_source_column, statement.header_source_end_column)

fn core_yir_else_location(statement: YirStatement) -> Text:
    return core_yir_source_location(statement.else_source_file, statement.else_source_line, statement.else_source_column, statement.else_source_end_column)

fn core_yir_parameter_name_location(parameter: YirParameter) -> Text:
    return core_yir_source_location(parameter.source_file, parameter.source_line, parameter.name_column, parameter.name_end_column)

fn core_yir_parameter_type_location(parameter: YirParameter) -> Text:
    return core_yir_source_location(parameter.source_file, parameter.source_line, parameter.type_column, parameter.type_end_column)

fn core_yir_function_return_type_location(function: YirFunction) -> Text:
    return core_yir_source_location(function.source_file, function.source_line, function.return_type_column, function.return_type_end_column)

fn core_yir_field_path_location(statement: HirStatement, path_index: Number) -> Text:
    let column: Number = number_parse(list_get(statement.field_path_columns, path_index))
    let field_name: Text = list_get(statement.field_path, path_index)
    return core_yir_source_location(statement.source_file, statement.source_line, column, column + text_length(field_name) - 1)

fn core_yir_match_arm_location(arm: HirMatchArm) -> Text:
    return core_yir_source_location(arm.source_file, arm.source_line, arm.source_column, arm.source_end_column)

fn core_yir_empty_expr(source_line: Number) -> YirExpr:
    return core_yir_expr("unit", "", "Unit", List[YirExpr](), source_line)

fn core_yir_statement(kind: Text, source_line: Number) -> YirStatement:
    return YirStatement(kind, "", "", "", "Unit", core_yir_empty_expr(source_line), core_yir_empty_expr(source_line), List[YirStatement](), List[YirStatement](), List[YirBranch](), List[YirMatchArm](), source_line, 1, 1, "", List[YirFieldPathStep](), 0, "", 1, 1, 0, "", 1, 1, false)

fn core_yir_copy_statement_provenance(target: YirStatement, source: HirStatement) -> YirStatement:
    var result: YirStatement = target
    set result.header_source_line = source.header_source_line
    set result.header_source_file = source.header_source_file
    set result.header_source_column = source.header_source_column
    set result.header_source_end_column = source.header_source_end_column
    set result.else_source_line = source.else_source_line
    set result.else_source_file = source.else_source_file
    set result.else_source_column = source.else_source_column
    set result.else_source_end_column = source.else_source_end_column
    return result

fn core_yir_numeric(value_type: Text) -> Boolean:
    return value_type == "Number" or value_type == "Int32" or value_type == "Float64"

fn core_yir_float_literal_valid(value: Text) -> Boolean:
    let length: Number = text_length(value)
    var start: Number = 0
    if length > 0 and text_byte(value, 0) == 45: set start = 1
    var valid: Boolean = length > start and length <= 128
    var integer_digits: Number = 0
    var fraction_digits: Number = 0
    var exponent_digits: Number = 0
    var has_dot: Boolean = false
    var has_exponent: Boolean = false
    var index: Number = start
    while index < length and text_byte(value, index) >= 48 and text_byte(value, index) <= 57:
        set integer_digits = integer_digits + 1
        set index = index + 1
    if index < length and text_byte(value, index) == 46:
        set has_dot = true
        set index = index + 1
        while index < length and text_byte(value, index) >= 48 and text_byte(value, index) <= 57:
            set fraction_digits = fraction_digits + 1
            set index = index + 1
    if index < length and (text_byte(value, index) == 101 or text_byte(value, index) == 69):
        set has_exponent = true
        set index = index + 1
        if index < length and (text_byte(value, index) == 43 or text_byte(value, index) == 45):
            set index = index + 1
        while index < length and text_byte(value, index) >= 48 and text_byte(value, index) <= 57:
            set exponent_digits = exponent_digits + 1
            set index = index + 1
    if integer_digits == 0 or (has_dot and fraction_digits == 0) or (has_exponent and exponent_digits == 0) or (not has_dot and not has_exponent) or index != length:
        set valid = false
    return valid

fn core_yir_number_magnitude(value: Text) -> Text:
    let length: Number = text_length(value)
    var first_digit: Number = 0
    while first_digit < length and text_byte(value, first_digit) == 48:
        set first_digit = first_digit + 1
    if first_digit == length: return "0"
    return text_slice(value, first_digit, length - first_digit)

fn core_yir_number_literal_valid(value: Text) -> Boolean:
    let length: Number = text_length(value)
    if length == 0: return false
    var index: Number = 0
    while index < length:
        let digit: Number = text_byte(value, index)
        if digit < 48 or digit > 57: return false
        set index = index + 1
    let magnitude: Text = core_yir_number_magnitude(value)
    let magnitude_length: Number = text_length(magnitude)
    if magnitude_length < 19: return true
    if magnitude_length > 19: return false
    let maximum: Text = "9223372036854775807"
    set index = 0
    while index < 19:
        let digit: Number = text_byte(magnitude, index)
        let maximum_digit: Number = text_byte(maximum, index)
        if digit < maximum_digit: return true
        if digit > maximum_digit: return false
        set index = index + 1
    return true

fn core_yir_signed_number_literal_valid(value: Text) -> Boolean:
    let length: Number = text_length(value)
    if length == 0: return false
    if text_byte(value, 0) == 45:
        if length == 1: return false
        let magnitude: Text = text_slice(value, 1, length - 1)
        if core_yir_number_magnitude(magnitude) == "9223372036854775808":
            var digit_index: Number = 0
            while digit_index < text_length(magnitude):
                let digit: Number = text_byte(magnitude, digit_index)
                if digit < 48 or digit > 57: return false
                set digit_index = digit_index + 1
            return true
        return core_yir_number_literal_valid(magnitude)
    return core_yir_number_literal_valid(value)

fn core_yir_supported_type(value_type: Text) -> Boolean:
    if value_type == "Number" or value_type == "Int32" or value_type == "Float64" or value_type == "Boolean" or value_type == "Text" or value_type == "Bytes" or value_type == "TextList" or value_type == "Unit": return true
    if not text_starts_with(value_type, "List[") or not text_ends_with(value_type, "]"): return false
    let element_type: Text = text_slice(value_type, 5, text_length(value_type) - 6)
    return element_type == "Number" or element_type == "Int32" or element_type == "Float64" or element_type == "Boolean" or element_type == "Text" or element_type == "Bytes"

fn core_yir_reserved_decl_type_name(value: Text) -> Boolean:
    return value == "Text" or value == "Number" or value == "Int32" or value == "Float64" or value == "Boolean" or value == "TextList" or value == "Bytes" or value == "SecretText" or value == "Option" or value == "Result" or value == "ListView"

fn core_yir_option_payload_type(value_type: Text) -> Text:
    if not text_starts_with(value_type, "Option[") or not text_ends_with(value_type, "]"): return ""
    return text_slice(value_type, 7, text_length(value_type) - 8)

fn core_yir_sum_payload_inline(value_type: Text) -> Boolean:
    return value_type == "Unit" or value_type == "Number" or value_type == "Int32" or value_type == "Float64" or value_type == "Boolean" or value_type == "Text" or value_type == "TextList" or text_starts_with(value_type, "List[") or text_starts_with(value_type, "ListView[")

fn core_yir_result_argument_type(value_type: Text, argument_index: Number) -> Text:
    if not text_starts_with(value_type, "Result[") or not text_ends_with(value_type, "]"): return ""
    let length: Number = text_length(value_type)
    var depth: Number = 0
    var comma_index: Number = -1
    var scan: Number = 7
    while scan < length - 1 and comma_index < 0:
        let byte: Number = text_byte(value_type, scan)
        if byte == 91: set depth = depth + 1
        if byte == 93: set depth = depth - 1
        if byte == 44 and depth == 0: set comma_index = scan
        set scan = scan + 1
    if comma_index < 0: return ""
    if argument_index == 0: return text_slice(value_type, 7, comma_index - 7)
    if argument_index == 1: return text_slice(value_type, comma_index + 1, length - comma_index - 2)
    return ""

fn core_yir_list_element_type(value_type: Text) -> Text:
    if value_type == "TextList": return "Text"
    if text_starts_with(value_type, "List[") and text_ends_with(value_type, "]"):
        return text_slice(value_type, 5, text_length(value_type) - 6)
    return ""

fn core_yir_list_view_element_type(value_type: Text) -> Text:
    if text_starts_with(value_type, "ListView[") and text_ends_with(value_type, "]"):
        return text_slice(value_type, 9, text_length(value_type) - 10)
    return ""

fn core_yir_type_contains_list_view_inner(value_type: Text, generic_depth: Number) -> Boolean:
    if generic_depth > 16: return true
    if core_yir_list_view_element_type(value_type) != "": return true
    let list_item_type: Text = core_yir_list_element_type(value_type)
    if list_item_type != "": return core_yir_type_contains_list_view_inner(list_item_type, generic_depth + 1)
    let option_payload: Text = core_yir_option_payload_type(value_type)
    if option_payload != "": return core_yir_type_contains_list_view_inner(option_payload, generic_depth + 1)
    let result_success: Text = core_yir_result_argument_type(value_type, 0)
    let result_error: Text = core_yir_result_argument_type(value_type, 1)
    if result_success != "" or result_error != "": return core_yir_type_contains_list_view_inner(result_success, generic_depth + 1) or core_yir_type_contains_list_view_inner(result_error, generic_depth + 1)
    return false

fn core_yir_type_contains_list_view(value_type: Text) -> Boolean:
    return core_yir_type_contains_list_view_inner(value_type, 0)

fn core_yir_expression_opens_list_view(expression: YirExpr) -> Boolean:
    if expression.kind == "call" and (expression.value == "list_read_view" or expression.value == "list_read_view_prefix"): return true
    var child_index: Number = 0
    while child_index < list_count(expression.children):
        if core_yir_expression_opens_list_view(list_get(expression.children, child_index)): return true
        set child_index = child_index + 1
    return false

fn core_yir_iterable_element_type(value_type: Text) -> Text:
    let item_type: Text = core_yir_list_element_type(value_type)
    if item_type != "": return item_type
    return core_yir_list_view_element_type(value_type)

fn core_yir_printable_type(value_type: Text) -> Boolean:
    return value_type == "Number" or value_type == "Int32" or value_type == "Float64" or value_type == "Boolean" or value_type == "Text"

fn core_yir_equality_type(value_type: Text) -> Boolean:
    return core_yir_printable_type(value_type) or core_yir_list_element_type(value_type) != ""

fn core_yir_interpolated_type(value_type: Text) -> Boolean:
    return value_type == "Number" or value_type == "Int32" or value_type == "Float64" or value_type == "Text"

fn core_yir_visible_index(names: TextList, active_count: Number, sought: Text) -> Number:
    var index: Number = active_count - 1
    while index >= 0:
        if list_get(names, index) == sought:
            return index
        set index = index - 1
    return -1

fn core_yir_bind_local(names: TextList, slots: TextList, types: TextList, mutabilities: TextList, index: Number, name: Text, slot: Text, value_type: Text, mutability: Text) -> Number:
    if list_count(names) > index:
        list_set(names, index, name)
        list_set(slots, index, slot)
        list_set(types, index, value_type)
        list_set(mutabilities, index, mutability)
    else:
        list_push(names, name)
        list_push(slots, slot)
        list_push(types, value_type)
        list_push(mutabilities, mutability)
    return 0

fn core_yir_find_function(functions: List[HirFunction], sought: Text) -> Number:
    var index: Number = 0
    while index < list_count(functions):
        if list_get(functions, index).name == sought:
            return index
        set index = index + 1
    return -1

fn core_yir_find_shape(shapes: List[HirShape], sought: Text) -> Number:
    var index: Number = 0
    while index < list_count(shapes):
        if list_get(shapes, index).name == sought: return index
        set index = index + 1
    return -1

fn core_yir_find_variant(variants: List[HirVariant], sought: Text) -> Number:
    var index: Number = 0
    while index < list_count(variants):
        if list_get(variants, index).name == sought: return index
        set index = index + 1
    return -1

fn core_yir_option_unwrap_error_type(value_type: Text, shapes: List[HirShape], variants: List[HirVariant]) -> Text:
    if core_yir_option_payload_type(value_type) != "": return "Option"
    if core_yir_result_argument_type(value_type, 0) != "" and core_yir_result_argument_type(value_type, 1) != "": return "Result"
    if core_yir_list_element_type(value_type) != "": return value_type
    if core_yir_find_variant(variants, value_type) >= 0: return "variant"
    return value_type

fn core_yir_find_variant_case(variant: HirVariant, sought: Text) -> Number:
    var index: Number = 0
    while index < list_count(variant.cases):
        if list_get(variant.cases, index).name == sought: return index
        set index = index + 1
    return -1

fn core_yir_builtin_match_case_tag(value_type: Text, case_name: Text) -> Number:
    if core_yir_option_payload_type(value_type) != "":
        if case_name == "none": return 0
        if case_name == "some": return 1
    let success_type: Text = core_yir_result_argument_type(value_type, 0)
    let error_type: Text = core_yir_result_argument_type(value_type, 1)
    if success_type != "" and error_type != "":
        if case_name == "err": return 0
        if case_name == "ok": return 1
    return -1

fn core_yir_builtin_match_payload_type(value_type: Text, case_name: Text) -> Text:
    if core_yir_option_payload_type(value_type) != "" and case_name == "some": return core_yir_option_payload_type(value_type)
    if core_yir_result_argument_type(value_type, 0) != "" and core_yir_result_argument_type(value_type, 1) != "":
        if case_name == "ok": return core_yir_result_argument_type(value_type, 0)
        if case_name == "err": return core_yir_result_argument_type(value_type, 1)
    return ""

fn core_yir_variant_name_from_qualified(name: Text) -> Text:
    let separator: Number = text_find(name, "::")
    if separator <= 0: return ""
    return text_slice(name, 0, separator)

fn core_yir_variant_case_name_from_qualified(name: Text) -> Text:
    let separator: Number = text_find(name, "::")
    if separator < 0: return ""
    return text_slice(name, separator + 2, text_length(name) - separator - 2)

fn core_yir_is_borrow_type(value_type: Text) -> Boolean:
    return text_starts_with(value_type, "&") or text_starts_with(value_type, "edit ")

fn core_yir_is_mut_borrow_type(value_type: Text) -> Boolean:
    return text_starts_with(value_type, "&mut ") or text_starts_with(value_type, "edit ")

fn core_yir_is_move_type(value_type: Text) -> Boolean:
    return text_starts_with(value_type, "move ")

fn core_yir_base_type(value_type: Text) -> Text:
    if text_starts_with(value_type, "&mut "): return text_slice(value_type, 5, text_length(value_type) - 5)
    if text_starts_with(value_type, "edit "): return text_slice(value_type, 5, text_length(value_type) - 5)
    if text_starts_with(value_type, "&"): return text_slice(value_type, 1, text_length(value_type) - 1)
    if text_starts_with(value_type, "move "): return text_slice(value_type, 5, text_length(value_type) - 5)
    return value_type

fn core_yir_type_assignable_to_parameter(actual_type: Text, parameter_type: Text) -> Boolean:
    if actual_type == parameter_type: return true
    let actual_base: Text = core_yir_base_type(actual_type)
    let param_base: Text = core_yir_base_type(parameter_type)
    if actual_base != param_base: return false
    if core_yir_is_mut_borrow_type(parameter_type):
        return core_yir_is_mut_borrow_type(actual_type)
    if core_yir_is_borrow_type(parameter_type):
        return true
    if core_yir_is_move_type(parameter_type):
        return true
    return not core_yir_is_borrow_type(actual_type)

fn core_yir_shape_field_index(shape: HirShape, sought: Text) -> Number:
    var index: Number = 0
    while index < list_count(shape.fields):
        if list_get(shape.fields, index).name == sought: return index
        set index = index + 1
    return -1

fn core_yir_known_type_inner(value_type: Text, shapes: List[HirShape], variants: List[HirVariant], generic_depth: Number) -> Boolean:
    if generic_depth > 16: return false
    if core_yir_is_borrow_type(value_type) or core_yir_is_move_type(value_type):
        let base: Text = core_yir_base_type(value_type)
        return base != "Unit" and not core_yir_type_contains_list_view(base) and core_yir_known_type_inner(base, shapes, variants, generic_depth + 1)
    if core_yir_supported_type(value_type) or core_yir_find_shape(shapes, value_type) >= 0 or core_yir_find_variant(variants, value_type) >= 0: return true
    let list_item_type: Text = core_yir_list_element_type(value_type)
    if list_item_type != "": return list_item_type != "Unit" and not core_yir_type_contains_list_view(list_item_type) and core_yir_known_type_inner(list_item_type, shapes, variants, generic_depth + 1)
    let list_view_item_type: Text = core_yir_list_view_element_type(value_type)
    if list_view_item_type != "": return list_view_item_type != "Unit" and not core_yir_type_contains_list_view(list_view_item_type) and core_yir_known_type_inner(list_view_item_type, shapes, variants, generic_depth + 1)
    let option_payload: Text = core_yir_option_payload_type(value_type)
    if option_payload != "": return option_payload != "Unit" and not core_yir_type_contains_list_view(option_payload) and core_yir_known_type_inner(option_payload, shapes, variants, generic_depth + 1)
    if text_starts_with(value_type, "Task[") and text_ends_with(value_type, "]"):
        let task_inner: Text = text_slice(value_type, 5, text_length(value_type) - 6)
        return task_inner != "Unit" and not core_yir_type_contains_list_view(task_inner) and core_yir_known_type_inner(task_inner, shapes, variants, generic_depth + 1)
    if text_starts_with(value_type, "Future[") and text_ends_with(value_type, "]"):
        let future_inner: Text = text_slice(value_type, 7, text_length(value_type) - 8)
        return future_inner != "Unit" and not core_yir_type_contains_list_view(future_inner) and core_yir_known_type_inner(future_inner, shapes, variants, generic_depth + 1)
    if text_starts_with(value_type, "Option[") or text_starts_with(value_type, "Result["):
        if text_starts_with(value_type, "Option["): return false
        let success_type: Text = core_yir_result_argument_type(value_type, 0)
        let error_type: Text = core_yir_result_argument_type(value_type, 1)
        return success_type != "" and error_type != "" and success_type != "Unit" and error_type != "Unit" and not core_yir_type_contains_list_view(success_type) and not core_yir_type_contains_list_view(error_type) and core_yir_known_type_inner(success_type, shapes, variants, generic_depth + 1) and core_yir_known_type_inner(error_type, shapes, variants, generic_depth + 1)
    return false

fn core_yir_known_type(value_type: Text, shapes: List[HirShape], variants: List[HirVariant]) -> Boolean:
    return core_yir_known_type_inner(value_type, shapes, variants, 0)

fn core_yir_shape_reaches(shapes: List[HirShape], current: Text, target: Text, visited: TextList) -> Boolean:
    if current == target: return true
    var visit_index: Number = 0
    while visit_index < list_count(visited):
        if list_get(visited, visit_index) == current: return false
        set visit_index = visit_index + 1
    list_push(visited, current)
    let shape_index: Number = core_yir_find_shape(shapes, current)
    if shape_index < 0: return false
    let shape: HirShape = list_get(shapes, shape_index)
    var field_index: Number = 0
    while field_index < list_count(shape.fields):
        let field: HirField = list_get(shape.fields, field_index)
        if core_yir_find_shape(shapes, field.value_type) >= 0 and core_yir_shape_reaches(shapes, field.value_type, target, visited): return true
        set field_index = field_index + 1
    return false

fn core_yir_fallible_numeric_text_builtin(name: Text) -> Boolean:
    return name == "number_try_text" or name == "int32_try_text" or name == "float64_try_text"

fn core_yir_concurrency_builtin(name: Text) -> Boolean:
    return name == "unix_ms" or name == "sleep_ms" or name == "thread_yield" or name == "rt_mutex_create" or name == "rt_mutex_lock" or name == "rt_mutex_unlock" or name == "rt_mutex_destroy" or name == "rt_atomic_create" or name == "rt_atomic_load" or name == "rt_atomic_store" or name == "rt_atomic_add" or name == "rt_channel_create" or name == "rt_channel_send" or name == "rt_channel_recv" or name == "rt_channel_close" or name == "rt_channel_is_full" or name == "rt_channel_is_closed"

fn core_yir_cli_io_builtin(name: Text) -> Boolean:
    if core_yir_concurrency_builtin(name): return true
    return name == "env_get" or name == "env_set" or name == "file_exists" or name == "is_directory" or name == "file_read" or name == "file_write" or name == "file_remove" or name == "directory_create" or name == "directory_list" or name == "temp_directory" or name == "test_temp_directory_remove" or name == "process" or name == "monotonic_ms" or name == "monotonic_ns" or name == "processor_count" or name == "executable_path" or name == "rt_os_platform" or name == "rt_os_arch" or name == "console_read_line"

fn core_yir_vfs_builtin(name: Text) -> Boolean:
    return name == "vfs_root_open" or name == "vfs_open_read" or name == "vfs_open_read_public" or name == "vfs_open_rw" or name == "vfs_create_exclusive" or name == "vfs_list_names" or name == "vfs_lock_exclusive" or name == "vfs_file_size" or name == "vfs_read_exact" or name == "vfs_write_exact" or name == "vfs_truncate" or name == "vfs_preallocate" or name == "vfs_sync" or name == "vfs_sync_directory" or name == "vfs_remove" or name == "vfs_rename" or name == "vfs_close"

fn core_yir_vfs_result_type(name: Text) -> Text:
    if name == "vfs_read_exact" or name == "vfs_list_names": return "Result[Bytes,Text]"
    if name == "vfs_root_open" or name == "vfs_open_read" or name == "vfs_open_read_public" or name == "vfs_open_rw" or name == "vfs_create_exclusive" or name == "vfs_lock_exclusive" or name == "vfs_file_size" or name == "vfs_write_exact": return "Result[Number,Text]"
    return "Result[Boolean,Text]"

fn core_yir_net_builtin(name: Text) -> Boolean:
    return name == "net_listen" or name == "net_connect" or name == "net_accept" or name == "net_read" or name == "net_write" or name == "net_close" or name == "net_pair_create" or name == "net_pair_peer"

fn core_yir_net_result_type(name: Text) -> Text:
    if name == "net_read": return "Result[Bytes,Text]"
    if name == "net_listen" or name == "net_connect" or name == "net_accept" or name == "net_write" or name == "net_pair_create" or name == "net_pair_peer": return "Result[Number,Text]"
    return "Result[Boolean,Text]"

fn core_yir_float64_bit_builtin(name: Text) -> Boolean:
    return name == "float64_bits" or name == "float64_from_bits"

fn core_yir_builtin_call(name: Text) -> Boolean:
    if core_yir_float64_bit_builtin(name): return true
    if name == "list_read_view" or name == "list_read_view_prefix" or name == "list_view_get" or name == "list_view_count" or name == "list_view_end": return true
    return name == "some" or name == "ok" or name == "err" or name == "some_try" or name == "ok_try" or name == "err_try" or name == "variant_try" or name == "list_try_from" or name == "list_try_get_result" or name == "text_try_interpolate" or name == "option_is_some" or name == "option_unwrap" or name == "result_is_ok" or name == "result_unwrap" or name == "result_unwrap_error" or name == "fail" or name == "exit" or name == "arg" or name == "arg_count" or core_yir_arena_metric_builtin(name) or core_yir_cli_io_builtin(name) or core_yir_vfs_builtin(name) or core_yir_net_builtin(name) or name == "text_list" or name == "text_list_try_new" or name == "list_new" or name == "list_try_new" or name == "text_split" or name == "text_try_split" or name == "text_lines" or name == "text_try_lines" or name == "text_trim" or name == "text_try_trim" or name == "text_join" or name == "text_try_join" or name == "text_compare" or name == "text_byte" or name == "text_slice" or name == "text_try_slice" or name == "text_find" or name == "text_starts_with" or name == "text_ends_with" or name == "text_try_concat" or name == "text_try_repeat" or core_yir_fallible_numeric_text_builtin(name) or name == "list_count" or name == "list_push" or name == "list_try_push" or name == "list_try_reserve" or name == "list_get" or name == "list_try_get" or name == "list_set" or name == "list_try_set" or name == "number_text" or name == "number_parse" or name == "number_try_parse" or name == "int32_try_parse" or name == "int32_text" or name == "float64_text" or name == "text_length" or name == "float64_parse" or name == "float64_try_parse" or name == "number_wrapping_add" or name == "number_wrapping_sub" or name == "number_wrapping_mul" or name == "int32_from_number" or name == "number_from_int32" or name == "float64_from_number" or name == "number_from_float64" or name == "bytes_empty" or name == "bytes_from_text" or name == "bytes_try_from_text" or name == "bytes_from_text_bounded" or name == "bytes_try_new_zeroed" or name == "bytes_try_set" or name == "bytes_from_number" or name == "bytes_try_from_number" or name == "secure_random_bytes" or name == "secure_random_bytes_try" or name == "bytes_length" or name == "bytes_crc32c" or name == "bytes_crc32c_zeroed_range" or name == "bytes_ydbv1_checksum" or name == "bytes_ydbv1_checksum_zeroed_range" or name == "bytes_get" or name == "bytes_slice" or name == "bytes_try_slice" or name == "bytes_concat" or name == "bytes_try_concat" or name == "bytes_equal" or name == "bytes_equal_constant_time" or name == "bytes_to_text" or name == "bytes_try_to_text" or name == "bytes_to_text_checked" or name == "bytes_zeroize" or name == "bytes_join" or name == "crypto_sha256" or name == "crypto_hmac_sha256" or name == "crypto_pbkdf2_sha256" or name == "crypto_argon2id_hash" or name == "crypto_argon2id_verify" or name == "crypto_argon2id_hash_format_is_current" or text_starts_with(name, "List[")

fn core_yir_arena_metric_builtin(name: Text) -> Boolean:
    return name == "arena_used" or name == "arena_storage_used" or name == "arena_reserved" or name == "arena_peak_used" or name == "arena_peak_storage_used" or name == "arena_peak_reserved" or name == "arena_allocation_count" or name == "arena_generation" or name == "arena_live_scopes"

fn core_yir_lower_special_call(expression: HirExpr, names: TextList, slots: TextList, types: TextList, active_count: Number, functions: List[HirFunction], shapes: List[HirShape], variants: List[HirVariant]) -> YirExpr:
    let empty: List[YirExpr] = List[YirExpr]()
    if expression.kind != "call": return core_yir_expr("not_special", "", "", empty, expression.source_line)
    if expression.value == "variant_try": fail("YIR type check: variant_try requires an explicit Result[Variant,Text] type context" + core_yir_expression_location(expression))
    if expression.value == "list_try_from": fail("YIR type check: list_try_from requires an explicit Result[List[T],Text] or Result[TextList,Text] type context" + core_yir_expression_location(expression))
    if expression.value == "list_try_get_result": fail("YIR type check: list_try_get_result requires an explicit Result[Option[T],Text] type context" + core_yir_expression_location(expression))
    if expression.value == "text_try_interpolate": fail("YIR type check: text_try_interpolate requires a Result[Text,Text] type context" + core_yir_expression_location(expression))
    let shape_index: Number = core_yir_find_shape(shapes, expression.value)
    if shape_index >= 0:
        let shape: HirShape = list_get(shapes, shape_index)
        if list_count(expression.children) != list_count(shape.fields): fail("YIR type check: constructor '" + shape.name + "' expects " + number_text(list_count(shape.fields)) + " fields" + core_yir_expression_location(expression))
        let children: List[YirExpr] = List[YirExpr]()
        var argument_index: Number = 0
        while argument_index < list_count(expression.children) and argument_index < list_count(shape.fields):
            let field: HirField = list_get(shape.fields, argument_index)
            list_push(children, core_yir_lower_expr_expected(list_get(expression.children, argument_index), names, slots, types, active_count, functions, shapes, variants, field.value_type))
            set argument_index = argument_index + 1
        return core_yir_expr("shape_create", shape.name, shape.name, children, expression.source_line)
    let variant_name: Text = core_yir_variant_name_from_qualified(expression.value)
    let variant_index: Number = core_yir_find_variant(variants, variant_name)
    if variant_index >= 0:
        let variant: HirVariant = list_get(variants, variant_index)
        let case_index: Number = core_yir_find_variant_case(variant, core_yir_variant_case_name_from_qualified(expression.value))
        if case_index < 0: fail("YIR type check: unknown variant case '" + expression.value + "'" + core_yir_expression_location(expression))
        if case_index >= 0:
            let variant_case: HirVariantCase = list_get(variant.cases, case_index)
            if list_count(expression.children) != list_count(variant_case.fields): fail("YIR type check: variant case '" + expression.value + "' expects " + number_text(list_count(variant_case.fields)) + " payload values" + core_yir_expression_location(expression))
            let children: List[YirExpr] = List[YirExpr]()
            var argument_index: Number = 0
            while argument_index < list_count(expression.children) and argument_index < list_count(variant_case.fields):
                let field: HirField = list_get(variant_case.fields, argument_index)
                list_push(children, core_yir_lower_expr_expected(list_get(expression.children, argument_index), names, slots, types, active_count, functions, shapes, variants, field.value_type))
                set argument_index = argument_index + 1
            return core_yir_expr("variant_create", number_text(case_index), variant.name, children, expression.source_line)
    if core_yir_builtin_call(expression.value): return core_yir_expr("not_special", "", "", empty, expression.source_line)
    let function_index: Number = core_yir_find_function(functions, expression.value)
    if function_index < 0: return core_yir_expr("not_special", "", "", empty, expression.source_line)
    let signature: HirFunction = list_get(functions, function_index)
    if list_count(expression.children) != list_count(signature.parameters): fail("YIR type check: wrong argument count for '" + expression.value + "'" + core_yir_source_location(expression.source_file, expression.source_line, expression.source_column, expression.source_end_column))
    let children: List[YirExpr] = List[YirExpr]()
    var argument_index: Number = 0
    while argument_index < list_count(expression.children) and argument_index < list_count(signature.parameters):
        let parameter: HirParameter = list_get(signature.parameters, argument_index)
        list_push(children, core_yir_lower_expr_expected(list_get(expression.children, argument_index), names, slots, types, active_count, functions, shapes, variants, parameter.value_type))
        set argument_index = argument_index + 1
    return core_yir_expr("call", expression.value, signature.return_type, children, expression.source_line)

fn core_yir_lower_expr_inner(expression: HirExpr, names: TextList, slots: TextList, types: TextList, active_count: Number, functions: List[HirFunction], shapes: List[HirShape], variants: List[HirVariant]) -> YirExpr:
    if expression.kind == "call":
        let special: YirExpr = core_yir_lower_special_call(expression, names, slots, types, active_count, functions, shapes, variants)
        if special.kind != "not_special": return special
        if expression.value == "list_push" and list_count(expression.children) == 2:
            let collection: YirExpr = core_yir_lower_expr(list_get(expression.children, 0), names, slots, types, active_count, functions, shapes, variants)
            let item_type: Text = core_yir_list_element_type(collection.value_type)
            if item_type == "": fail("YIR type check: list_push expects a List and an item" + core_yir_expression_location(expression))
            let item: YirExpr = core_yir_lower_expr_expected(list_get(expression.children, 1), names, slots, types, active_count, functions, shapes, variants, item_type)
            let push_children: List[YirExpr] = List[YirExpr]()
            list_push(push_children, collection)
            list_push(push_children, item)
            return core_yir_expr("list_push", collection.value_type, "Number", push_children, expression.source_line)
        if expression.value == "list_try_push" and list_count(expression.children) == 2:
            let collection: YirExpr = core_yir_lower_expr(list_get(expression.children, 0), names, slots, types, active_count, functions, shapes, variants)
            let item_type: Text = core_yir_list_element_type(collection.value_type)
            if item_type == "": fail("YIR type check: list_try_push expects a List and an item" + core_yir_expression_location(expression))
            let item: YirExpr = core_yir_lower_expr_expected(list_get(expression.children, 1), names, slots, types, active_count, functions, shapes, variants, item_type)
            let push_children: List[YirExpr] = List[YirExpr]()
            list_push(push_children, collection)
            list_push(push_children, item)
            return core_yir_expr("list_try_push", collection.value_type, "Boolean", push_children, expression.source_line)
        if expression.value == "list_try_reserve":
            if list_count(expression.children) != 2: fail("YIR type check: list_try_reserve expects a List and Number capacity" + core_yir_expression_location(expression))
            let collection: YirExpr = core_yir_lower_expr(list_get(expression.children, 0), names, slots, types, active_count, functions, shapes, variants)
            let capacity: YirExpr = core_yir_lower_expr_expected(list_get(expression.children, 1), names, slots, types, active_count, functions, shapes, variants, "Number")
            if core_yir_list_element_type(collection.value_type) == "": fail("YIR type check: list_try_reserve expects a List or TextList" + core_yir_expression_location(expression))
            let reserve_children: List[YirExpr] = List[YirExpr]()
            list_push(reserve_children, collection)
            list_push(reserve_children, capacity)
            return core_yir_expr("list_try_reserve", collection.value_type, "Boolean", reserve_children, expression.source_line)
        if expression.value == "list_set" and list_count(expression.children) == 3:
            let collection: YirExpr = core_yir_lower_expr(list_get(expression.children, 0), names, slots, types, active_count, functions, shapes, variants)
            let item_type: Text = core_yir_list_element_type(collection.value_type)
            let set_index_expr: YirExpr = core_yir_lower_expr(list_get(expression.children, 1), names, slots, types, active_count, functions, shapes, variants)
            if item_type == "" or set_index_expr.value_type != "Number": fail("YIR type check: list_set expects a List, Number index, and item" + core_yir_expression_location(expression))
            let item: YirExpr = core_yir_lower_expr_expected(list_get(expression.children, 2), names, slots, types, active_count, functions, shapes, variants, item_type)
            let set_children: List[YirExpr] = List[YirExpr]()
            list_push(set_children, collection)
            list_push(set_children, set_index_expr)
            list_push(set_children, item)
            return core_yir_expr("list_set", collection.value_type, "Number", set_children, expression.source_line)
        if expression.value == "list_try_set" and list_count(expression.children) == 3:
            let collection: YirExpr = core_yir_lower_expr(list_get(expression.children, 0), names, slots, types, active_count, functions, shapes, variants)
            let item_type: Text = core_yir_list_element_type(collection.value_type)
            let set_index_expr: YirExpr = core_yir_lower_expr(list_get(expression.children, 1), names, slots, types, active_count, functions, shapes, variants)
            if item_type == "" or set_index_expr.value_type != "Number": fail("YIR type check: list_try_set expects a List, Number index, and item" + core_yir_expression_location(expression))
            let item: YirExpr = core_yir_lower_expr_expected(list_get(expression.children, 2), names, slots, types, active_count, functions, shapes, variants, item_type)
            let set_children: List[YirExpr] = List[YirExpr]()
            list_push(set_children, collection)
            list_push(set_children, set_index_expr)
            list_push(set_children, item)
            return core_yir_expr("list_try_set", collection.value_type, "Boolean", set_children, expression.source_line)
        if expression.value == "list_try_new":
            fail("YIR type check: list_try_new requires a Result[List[T],Text] type context" + core_yir_expression_location(expression))
        if expression.value == "text_list_try_new":
            fail("YIR type check: text_list_try_new requires a Result[TextList,Text] type context" + core_yir_expression_location(expression))
    let children: List[YirExpr] = List[YirExpr]()
    if expression.kind == "number":
        if not core_yir_number_literal_valid(expression.value): fail("YIR type check: Number literal is outside the signed 64-bit range" + core_yir_source_location(expression.source_file, expression.source_line, expression.source_column, expression.source_end_column))
        return core_yir_expr("number", expression.value, "Number", children, expression.source_line)
    if expression.kind == "float":
        if not core_yir_float_literal_valid(expression.value): fail("YIR type check: invalid Float64 literal" + core_yir_source_location(expression.source_file, expression.source_line, expression.source_column, expression.source_end_column))
        return core_yir_expr("float", expression.value, "Float64", children, expression.source_line)
    if expression.kind == "text":
        return core_yir_expr("text", expression.value, "Text", children, expression.source_line)
    if expression.kind == "interpolate":
        var interpolation_index: Number = 0
        while interpolation_index < list_count(expression.children):
            let value: YirExpr = core_yir_lower_expr(list_get(expression.children, interpolation_index), names, slots, types, active_count, functions, shapes, variants)
            if not core_yir_interpolated_type(value.value_type):
                fail("YIR type check: unsupported interpolation type '" + value.value_type + "'" + core_yir_source_location(value.source_file, value.source_line, value.source_column, value.source_end_column))
            list_push(children, value)
            set interpolation_index = interpolation_index + 1
        return core_yir_expr("interpolate", expression.value, "Text", children, expression.source_line)
    if expression.kind == "boolean":
        return core_yir_expr("boolean", expression.value, "Boolean", children, expression.source_line)
    if expression.kind == "none":
        fail("YIR type check: 'none' requires an Option type context" + core_yir_expression_location(expression))
        return core_yir_expr("option_none", "", "Option[Number]", children, expression.source_line)
    if expression.kind == "unit":
        return core_yir_empty_expr(expression.source_line)
    if expression.kind == "variable":
        let variant_name: Text = core_yir_variant_name_from_qualified(expression.value)
        let variant_index: Number = core_yir_find_variant(variants, variant_name)
        if variant_index >= 0:
            let variant: HirVariant = list_get(variants, variant_index)
            let case_index: Number = core_yir_find_variant_case(variant, core_yir_variant_case_name_from_qualified(expression.value))
            if case_index < 0: fail("YIR type check: unknown variant case '" + expression.value + "'" + core_yir_source_location(expression.source_file, expression.source_line, expression.source_column, expression.source_end_column))
            if case_index >= 0 and list_count(list_get(variant.cases, case_index).fields) != 0: fail("YIR type check: variant case '" + expression.value + "' requires payload arguments" + core_yir_source_location(expression.source_file, expression.source_line, expression.source_column, expression.source_end_column))
            return core_yir_expr("variant_create", number_text(case_index), variant.name, children, expression.source_line)
        let index: Number = core_yir_visible_index(names, active_count, expression.value)
        if index < 0:
            fail("YIR type check: unknown variable '" + expression.value + "'" + core_yir_source_location(expression.source_file, expression.source_line, expression.source_column, expression.source_end_column))
            return core_yir_expr("number", "0", "Number", children, expression.source_line)
        return core_yir_expr("variable", list_get(slots, index), list_get(types, index), children, expression.source_line)
    if expression.kind == "index":
        let collection: YirExpr = core_yir_lower_expr(list_get(expression.children, 0), names, slots, types, active_count, functions, shapes, variants)
        let index: YirExpr = core_yir_lower_expr(list_get(expression.children, 1), names, slots, types, active_count, functions, shapes, variants)
        let item_type: Text = core_yir_list_element_type(collection.value_type)
        if item_type == "": fail("YIR type check: indexing requires a supported List or TextList" + core_yir_source_location(expression.source_file, expression.source_line, expression.source_column, expression.source_end_column))
        if index.value_type != "Number": fail("YIR type check: list index requires Number" + core_yir_source_location(expression.source_file, expression.source_line, expression.source_column, expression.source_end_column))
        list_push(children, collection)
        list_push(children, index)
        return core_yir_expr("index", collection.value_type, item_type, children, expression.source_line)
    if expression.kind == "move":
        let nested: YirExpr = core_yir_lower_expr(list_get(expression.children, 0), names, slots, types, active_count, functions, shapes, variants)
        list_push(children, nested)
        return core_yir_expr("move", nested.value, nested.value_type, children, expression.source_line)
    if expression.kind == "borrow":
