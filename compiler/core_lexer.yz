# LLVM Core frontend lexer, implemented in YAZA and kept local to this backend.
# Token format matches the current native compiler: I:<identifier>, N:<integer>, F:<decimal/scientific>, S:<quoted string>, O:<operator>, P:<punctuation>.
fn is_letter(value: Number) -> Boolean:
    return (value >= 65 and value <= 90) or (value >= 97 and value <= 122) or value == 95

fn is_digit(value: Number) -> Boolean:
    return value >= 48 and value <= 57

fn is_identifier_part(value: Number) -> Boolean:
    return is_letter(value) or is_digit(value)

fn lex(source: Text) -> TextList:
    return lex_with_source(source, "", 0, 1)

fn core_lexer_error_location(source_file: Text, source_line: Number, source_column: Number) -> Text:
    if source_line < 1: return ""
    if source_file == "": return " at line " + number_text(source_line) + ", column " + number_text(source_column)
    return " at " + source_file + ":" + number_text(source_line) + ":" + number_text(source_column)

fn lex_with_source(source: Text, source_file: Text, source_line: Number, first_column: Number) -> TextList:
    let tokens: TextList = text_list()
    let length: Number = text_length(source)
    var cursor: Number = 0

    while cursor < length:
        let value: Number = text_byte(source, cursor)

        if value <= 32:
            set cursor = cursor + 1
        else:
            if value == 35:
                while cursor < length and text_byte(source, cursor) != 10:
                    set cursor = cursor + 1
            else:
                if is_letter(value):
                    var start: Number = cursor
                    set cursor = cursor + 1
                    while cursor < length and is_identifier_part(text_byte(source, cursor)):
                        set cursor = cursor + 1
                    let name: Text = text_slice(source, start, cursor - start)
                    list_push(tokens, "I:" + name)
                else:
                    if is_digit(value):
                        var start: Number = cursor
                        set cursor = cursor + 1
                        while cursor < length and is_digit(text_byte(source, cursor)):
                            set cursor = cursor + 1
                        var floating: Boolean = false
                        if cursor + 1 < length and text_byte(source, cursor) == 46 and is_digit(text_byte(source, cursor + 1)):
                            set floating = true
                            set cursor = cursor + 1
                            while cursor < length and is_digit(text_byte(source, cursor)):
                                set cursor = cursor + 1
                        if cursor < length and (text_byte(source, cursor) == 101 or text_byte(source, cursor) == 69):
                            set floating = true
                            set cursor = cursor + 1
                            if cursor < length and (text_byte(source, cursor) == 43 or text_byte(source, cursor) == 45):
                                set cursor = cursor + 1
                            while cursor < length and is_digit(text_byte(source, cursor)):
                                set cursor = cursor + 1
                        let digits: Text = text_slice(source, start, cursor - start)
                        if floating:
                            list_push(tokens, "F:" + digits)
                        else:
                            list_push(tokens, "N:" + digits)
                    else:
                        if value == 34:
                            var start: Number = cursor
                            var escaped: Boolean = false
                            var closed: Boolean = false
                            set cursor = cursor + 1
                            while cursor < length and not closed:
                                let string_value: Number = text_byte(source, cursor)
                                if escaped:
                                    set escaped = false
                                else:
                                    if string_value == 92:
                                        set escaped = true
                                    else:
                                        if string_value == 34:
                                            set closed = true
                                set cursor = cursor + 1
                            if not closed:
                                fail("unterminated Text literal" + core_lexer_error_location(source_file, source_line, first_column + start))
                            else:
                                let literal: Text = text_slice(source, start, cursor - start)
                                list_push(tokens, "S:" + literal)
                        else:
                            var start: Number = cursor
                            set cursor = cursor + 1
                            if cursor < length:
                                let pair: Text = text_slice(source, start, 2)
                                if pair == "::":
                                    list_push(tokens, "P:double_colon")
                                    set cursor = cursor + 1
                                else:
                                    if pair == "==" or pair == "!=" or pair == "<=" or pair == ">=" or pair == "->" or pair == "=>":
                                        list_push(tokens, "O:" + pair)
                                        set cursor = cursor + 1
                                    else:
                                        let symbol: Text = text_slice(source, start, 1)
                                        if text_find("+-*/%=<>!?&|^~", symbol) >= 0:
                                            list_push(tokens, "O:" + symbol)
                                        else:
                                            if text_find("()[]{}:,.", symbol) >= 0:
                                                list_push(tokens, "P:" + symbol)
                                            else:
                                                fail("unknown character in YAZA source" + core_lexer_error_location(source_file, source_line, first_column + start))
                            else:
                                let symbol: Text = text_slice(source, start, 1)
                                if text_find("+-*/%=<>!?&|^~", symbol) >= 0:
                                    list_push(tokens, "O:" + symbol)
                                else:
                                    if text_find("()[]{}:,.", symbol) >= 0:
                                        list_push(tokens, "P:" + symbol)
                                    else:
                                        fail("unknown character in YAZA source" + core_lexer_error_location(source_file, source_line, first_column + start))
    return tokens
