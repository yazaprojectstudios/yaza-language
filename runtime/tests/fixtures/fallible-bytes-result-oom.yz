fn fill_arena() -> Result[Number, Text]:
    var byte_count: Number = 0
    while byte_count < 100000:
        let chunk: Bytes = bytes_try_from_text("0123456789abcdef")?
        set byte_count = byte_count + bytes_length(chunk)
    return ok(byte_count)

start:
    let fill_result: Result[Number, Text] = fill_arena()
    assert not result_is_ok(fill_result)
    let result: Result[Bytes, Text] = bytes_from_text_bounded("x", 1)
    assert not result_is_ok(result)
    assert result_unwrap_error(result) == "Could not allocate Bytes in the active arena"
    say "oom-result-recovered"
