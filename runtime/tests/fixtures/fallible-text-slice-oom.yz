fn text_slice_oom_recovers() -> Boolean:
    arena_scope 512:
        var filling: Boolean = true
        while filling:
            let chunk: Result[Bytes, Text] = bytes_try_from_text("0123456789abcdef")
            if result_is_ok(chunk):
                continue
            set filling = false
        let attempt: Result[Text, Text] = text_try_slice("YAZA", 0, 3)
        if result_is_ok(attempt):
            return false
        return result_unwrap_error(attempt) == "Could not allocate Text in the active arena"

start:
    assert text_slice_oom_recovers()
    say "text-slice-oom-recovered"
