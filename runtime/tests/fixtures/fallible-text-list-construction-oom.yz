fn text_list_constructor_recovers_from_quota() -> Boolean:
    arena_scope 1:
        let created: Result[TextList, Text] = text_list_try_new()
        if result_is_ok(created): return false
        return result_unwrap_error(created) == "Could not allocate List in the active arena"

start:
    assert text_list_constructor_recovers_from_quota()
    say "text-list-construction-oom-recovered"
