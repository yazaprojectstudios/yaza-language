start:
    let values: TextList = text_list()
    list_push(values, "left")
    list_push(values, "right")
    var filling: Boolean = true
    while filling and arena_storage_used() < arena_reserved():
        let filler: Result[Bytes,Text] = bytes_try_from_text("0123456789abcdef")
        if not result_is_ok(filler): set filling = false
    let joined: Result[Text,Text] = text_try_join(values, "/")
    assert not result_is_ok(joined)
    assert result_unwrap_error(joined) == "Could not allocate Text in the active arena"
    say "text-join-oom-result-recovered"
