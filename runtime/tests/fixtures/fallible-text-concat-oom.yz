start:
    while arena_storage_used() < arena_reserved():
        let filler: Bytes = bytes_from_text("0123456789abcdef")
    let result: Result[Text,Text] = text_try_concat("left", "right")
    assert not result_is_ok(result)
    assert result_unwrap_error(result) == "Could not allocate Text in the active arena"
    say "text-oom-result-recovered"
