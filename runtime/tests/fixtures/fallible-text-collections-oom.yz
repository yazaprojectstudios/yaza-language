fn exhaust_active_arena() -> Boolean:
    var filling: Boolean = true
    while filling:
        let chunk: Result[Bytes, Text] = bytes_try_from_text("0123456789abcdef")
        if result_is_ok(chunk):
            continue
        set filling = false
    return true

fn text_trim_oom_recovers() -> Boolean:
    arena_scope 512:
        assert exhaust_active_arena()
        let attempt: Result[Text, Text] = text_try_trim(" padded ")
        if result_is_ok(attempt): return false
        return result_unwrap_error(attempt) == "Could not allocate Text in the active arena"

fn text_split_oom_recovers() -> Boolean:
    arena_scope 512:
        assert exhaust_active_arena()
        let attempt: Result[TextList, Text] = text_try_split("a:b", ":")
        if result_is_ok(attempt): return false
        return result_unwrap_error(attempt) == "Could not allocate List in the active arena"

fn text_lines_oom_recovers() -> Boolean:
    arena_scope 512:
        assert exhaust_active_arena()
        let attempt: Result[TextList, Text] = text_try_lines("one\ntwo")
        if result_is_ok(attempt): return false
        return result_unwrap_error(attempt) == "Could not allocate List in the active arena"

start:
    assert text_trim_oom_recovers()
    assert text_split_oom_recovers()
    assert text_lines_oom_recovers()
    say "text-collections-oom-recovered"
