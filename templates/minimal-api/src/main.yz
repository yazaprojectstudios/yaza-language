# Modern Minimal API for YAZA: {{project_name}}
# Zero-boilerplate, ultra-fast endpoint router with modern design patterns.
use "std/http"

fn handle_route(method: Text, path: Text, body: Text) -> HttpResponse:
    if path == "/healthz" or path == "/livez":
        return http_response_ok_json("{\"status\":\"UP\",\"service\":\"{{project_name}}\"}")
    if path == "/readyz":
        return http_response_ok_json("{\"ready\":true,\"database\":\"connected\"}")
    if path == "/" or path == "/api":
        return http_response_ok_json("{\"message\":\"Welcome to {{project_name}} Minimal API\",\"version\":\"1.0.2\"}")
    if path == "/api/v1/items":
        if method == "GET":
            return http_response_ok_json("[{\"id\":101,\"name\":\"Standard Item\",\"price\":49.99},{\"id\":102,\"name\":\"Pro Item\",\"price\":99.99}]")
        if method == "POST":
            if text_length(body) == 0:
                return http_response_bad_request("Request body required", true)
            return http_response_created_json("{\"id\":103,\"status\":\"created\",\"received\":" + body + "}")
        return http_response_method_not_allowed("Method not allowed", true)
    return http_response_not_found("Route not found", true)

start:
    say "Starting {{project_name}} Minimal API on http://127.0.0.1:8080"
    say "  Live routes:"
    say "    GET  /healthz"
    say "    GET  /readyz"
    say "    GET  /api/v1/items"
    say "    POST /api/v1/items"
    let test_res: HttpResponse = handle_route("GET", "/healthz", "")
    say "  Probe self-test status: " + number_text(test_res.status_code)
