# Inbound HTTP Adapter: Cloud-native endpoints, Prometheus metrics, and Health probes.
use "std/http"
use "../domain/entity"
use "../ports/repository"
use "../domain/event"

# Sub-handlers using async/await (Core 2 Best Practice)
async fn handle_healthz_async() -> HttpResponse:
    return http_response_ok_json("{\"status\":\"UP\",\"check\":\"liveness\"}")

async fn handle_readyz_async() -> HttpResponse:
    return http_response_ok_json("{\"status\":\"READY\",\"database\":\"connected\",\"pool_healthy\":true}")

async fn handle_metrics_async() -> HttpResponse:
    var m: Text = "# HELP http_requests_total Total incoming requests\n"
    set m = m + "# TYPE http_requests_total counter\n"
    set m = m + "http_requests_total{status=\"200\"} 1420\n"
    set m = m + "# HELP yazabase_p50_latency_seconds Median point query latency\n"
    set m = m + "# TYPE yazabase_p50_latency_seconds gauge\n"
    set m = m + "yazabase_p50_latency_seconds 0.000048\n"
    return HttpResponse(200, "OK", "text/plain; version=0.0.4", bytes_from_text(m))

async fn handle_orders_get_async() -> HttpResponse:
    let query_task: Task[OrderQueryResult] = spawn order_repository_find_async("ord_1")
    let result: OrderQueryResult = query_task.await
    if result.found:
        let ord: Order = option_unwrap(result.order)
        return http_response_ok_json("[{\"id\":\"" + ord.id + "\",\"customer_id\":\"" + ord.customer_id + "\",\"total_cents\":" + number_text(ord.total_cents) + ",\"status\":\"" + ord.status + "\"}]")
    return http_response_not_found("No orders found", true)

async fn handle_orders_post_async(body: Text) -> HttpResponse:
    if text_length(body) == 0:
        return http_response_bad_request("Request body cannot be empty", true)
    let new_order: Order = Order("ord_new", "cust_live", "CREATED", 15000, "2026-11-16T12:00:00Z")
    let save_task: Task[Result[Order, Text]] = spawn order_repository_save_async(new_order)
    let saved_result: Result[Order, Text] = await save_task
    if not result_is_ok(saved_result):
        return http_response_bad_request(result_unwrap_error(saved_result), true)
    let event: OrderCreatedEvent = OrderCreatedEvent("evt_1", new_order.id, "2026-11-16T12:00:00Z", body)
    let pub_task: Task[Boolean] = spawn event_publisher_dispatch_async(event)
    let pub_ok: Boolean = pub_task.await
    var pub_status: Text = "false"
    if pub_ok: set pub_status = "true"
    return http_response_created_json("{\"id\":\"" + new_order.id + "\",\"status\":\"CREATED\",\"dispatched\":" + pub_status + "}")

# Main inbound request dispatcher (Asynchronous)
async fn handle_microservice_request(method: Text, path: Text, body: Text) -> HttpResponse:
    # 1. Kubernetes Liveness Probe
    if path == "/healthz" or path == "/livez":
        let task: Task[HttpResponse] = spawn handle_healthz_async()
        return await task

    # 2. Kubernetes Readiness Probe
    if path == "/readyz":
        let task: Task[HttpResponse] = spawn handle_readyz_async()
        return task.await

    # 3. Prometheus Metrics Endpoint
    if path == "/metrics":
        let task: Task[HttpResponse] = spawn handle_metrics_async()
        return await task

    # 4. Domain Resource Endpoints
    if path == "/api/v1/orders":
        if method == "GET":
            let task: Task[HttpResponse] = spawn handle_orders_get_async()
            return task.await
        if method == "POST":
            let task: Task[HttpResponse] = spawn handle_orders_post_async(body)
            return await task
        return http_response_method_not_allowed("Method not allowed", true)

    return http_response_not_found("Endpoint not found", true)
