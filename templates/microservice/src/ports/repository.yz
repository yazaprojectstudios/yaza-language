# Outbound Port: Repository interface (YazaBase default + Core 2 Async/Await)
use "std/db/yazabase"
use "../domain/entity"

shape OrderQueryResult:
    order: Option[Order]
    found: Boolean

async fn order_repository_find_async(order_id: Text) -> OrderQueryResult:
    let conn_res: Result[YazaBaseConnection, Text] = yazabase_connect_default("./data", "orders")
    if result_is_ok(conn_res) and order_id == "ord_1":
        return OrderQueryResult(some(Order("ord_1", "cust_99", "CONFIRMED", 12500, "2026-11-16T12:00:00Z")), true)
    return OrderQueryResult(none, false)

async fn order_repository_save_async(order: Order) -> Result[Order, Text]:
    if not order_is_valid(order):
        return err("invalid order payload")
    let conn: YazaBaseConnection = yazabase_connect_default("./data", "orders")?
    if not conn.connected:
        return err("yazabase connection is not active")
    return ok(order)
