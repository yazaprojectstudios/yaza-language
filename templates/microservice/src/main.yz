# Cloud-Native Microservice: {{project_name}}
# Architecture: Hexagonal (Ports & Adapters) + DDD
# Runtime: Live TCP HTTP/1.1 Keep-Alive Server + Core 2 async/await & spawn workers + YazaBase SQL
use "adapters/http_handler"
use "std/net"
use "std/json"
use "std/sync"
use "std/log"
use "std/time"
use "std/config/api_config"

shape HttpReadOutcome:
    ok_read: Boolean
    raw: Bytes
    error_response: Option[HttpResponse]

fn header_end_index(raw_text: Text) -> Number:
    let crlf: Number = text_find(raw_text, "\r\n\r\n")
    if crlf >= 0: return crlf + 4
    let lf: Number = text_find(raw_text, "\n\n")
    if lf >= 0: return lf + 2
    return -1

fn request_wants_close(raw_text: Text) -> Boolean:
    if text_find(raw_text, "Connection: close") >= 0 or text_find(raw_text, "connection: close") >= 0:
        return true
    if text_find(raw_text, "HTTP/1.0") >= 0 and text_find(raw_text, "keep-alive") < 0:
        return true
    return false

fn read_bounded_http_request(client_fd: Number, max_body_bytes: Number) -> HttpReadOutcome:
    var header_buf: Bytes = bytes_empty()
    let body_chunks: List[Bytes] = List[Bytes]()
    let header_limit: Number = 16384
    var hdr_end: Number = -1
    var content_len: Number = 0
    var total_read: Number = 0
    var chunks: Number = 0

    while chunks < 512:
        var ask: Number = 65536
        if hdr_end >= 0:
            let rem: Number = (hdr_end + content_len) - total_read
            if rem <= 0: break
            set ask = rem
            if ask > 262144: set ask = 262144
        let rd: Result[Bytes, Text] = tcp_read(client_fd, ask, 5000)
        if not result_is_ok(rd): break
        let chunk: Bytes = result_unwrap(rd)
        let clen: Number = bytes_length(chunk)
        if clen == 0: break
        set total_read = total_read + clen
        if hdr_end < 0:
            set header_buf = bytes_concat(header_buf, chunk)
            let cur_len: Number = bytes_length(header_buf)
            let raw_hdr_pos: Number = http_find_header_end_bytes(header_buf)
            if cur_len > header_limit and raw_hdr_pos < 0:
                return HttpReadOutcome(false, bytes_empty(), some(http_response_payload_too_large("HTTP header exceeds 16 KiB limit", true)))
            if raw_hdr_pos >= 0:
                set hdr_end = raw_hdr_pos + 4
                let hdr_req_res: Result[HttpRequest, Text] = http_parse_request_headers(bytes_slice(header_buf, 0, hdr_end))
                if result_is_ok(hdr_req_res):
                    set content_len = result_unwrap(hdr_req_res).content_length
                if content_len > max_body_bytes:
                    return HttpReadOutcome(false, bytes_empty(), some(http_response_payload_too_large("request body exceeds configured limit", true)))
                list_push(body_chunks, header_buf)
        else:
            list_push(body_chunks, chunk)
        if hdr_end >= 0 and total_read >= hdr_end + content_len:
            let joined_res: Result[Bytes, Text] = bytes_join(body_chunks)
            if not result_is_ok(joined_res):
                return HttpReadOutcome(false, bytes_empty(), some(http_response_payload_too_large("request body exceeds arena limit", true)))
            let joined: Bytes = result_unwrap(joined_res)
            if bytes_length(joined) == hdr_end + content_len:
                return HttpReadOutcome(true, joined, none)
            return HttpReadOutcome(true, bytes_slice(joined, 0, hdr_end + content_len), none)
        set chunks = chunks + 1

    if total_read == 0:
        return HttpReadOutcome(false, bytes_empty(), none)
    if list_count(body_chunks) > 0:
        let j_res: Result[Bytes, Text] = bytes_join(body_chunks)
        if result_is_ok(j_res):
            return HttpReadOutcome(true, result_unwrap(j_res), none)
    return HttpReadOutcome(true, header_buf, none)

fn dispatch_microservice_http_request(req: HttpRequest, m_total: AtomicNumber, m_errors: AtomicNumber) -> HttpResponse:
    let h_task: Task[HttpResponse] = spawn handle_microservice_request(req.method, req.path, req.body_text, m_total, m_errors)
    return await h_task

fn handle_client_connection(client_fd: Number, max_body_bytes: Number, max_in_flight: Number, m_in_flight: AtomicNumber, m_total: AtomicNumber, m_errors: AtomicNumber, m_rate_limited: AtomicNumber, logger: Logger) -> Boolean:
    var keep_alive: Boolean = true
    var req_on_conn: Number = 0
    var req_arena_cap: Number = max_body_bytes * 4 + 16777216
    if req_arena_cap < 16777216:
        set req_arena_cap = 16777216
    while keep_alive and req_on_conn < 64:
        var continue_conn: Boolean = false
        arena_scope req_arena_cap:
            let rd_out: HttpReadOutcome = read_bounded_http_request(client_fd, max_body_bytes)
            if not rd_out.ok_read:
                if option_is_some(rd_out.error_response):
                    let wire_err: Bytes = http_format_response_keep_alive(option_unwrap(rd_out.error_response), "req-limit", false)
                    let _wr: Result[Number, Text] = tcp_write(client_fd, wire_err, 5000)
            else:
                set req_on_conn = req_on_conn + 1
                var hdr_slice_len: Number = bytes_length(rd_out.raw)
                let h_end: Number = http_find_header_end_bytes(rd_out.raw)
                if h_end >= 0:
                    set hdr_slice_len = h_end
                elif hdr_slice_len > 16384:
                    set hdr_slice_len = 16384
                let hdr_txt_res: Result[Text, Text] = bytes_try_to_text(bytes_slice(rd_out.raw, 0, hdr_slice_len))
                if not result_is_ok(hdr_txt_res) or request_wants_close(result_unwrap(hdr_txt_res)):
                    set keep_alive = false

                let started_ns: Number = time_now_monotonic_ns()
                let cur_in_flight: Number = atomic_fetch_add(m_in_flight, 1)
                let req_res: Result[HttpRequest, Text] = http_parse_request(rd_out.raw)
                var resp: HttpResponse = http_response_bad_request("malformed HTTP request", true)
                var req_id: Text = "req-" + number_text(req_on_conn)
                var log_method: Text = "UNKNOWN"
                var log_path: Text = "/"

                if result_is_ok(req_res):
                    let req: HttpRequest = result_unwrap(req_res)
                    set log_method = req.method
                    set log_path = req.path
                    if req.x_request_id != "":
                        set req_id = req.x_request_id
                    if cur_in_flight >= max_in_flight:
                        let _rl: AtomicNumber = atomic_add(m_rate_limited, 1)
                        set resp = http_response_service_unavailable("maximum in-flight concurrency limit reached", true)
                    else:
                        set resp = dispatch_microservice_http_request(req, m_total, m_errors)
                let _dec: AtomicNumber = atomic_add(m_in_flight, -1)

                if resp.status_code >= 500:
                    let _er: AtomicNumber = atomic_add(m_errors, 1)

                let wire: Bytes = http_format_response_keep_alive(resp, req_id, keep_alive)
                let wr_res: Result[Number, Text] = tcp_write(client_fd, wire, 5000)
                let elapsed_ms: Number = (time_now_monotonic_ns() - started_ns) / 1000000
                let access_json: Text = "{\"method\":\"" + json_escape_text(log_method) + "\",\"path\":\"" + json_escape_text(log_path) + "\",\"status\":" + number_text(resp.status_code) + ",\"latency_ms\":" + number_text(elapsed_ms) + ",\"request_id\":\"" + json_escape_text(req_id) + "\"}"
                let _li: Boolean = log_info(logger, "http_request", access_json)
                if result_is_ok(wr_res):
                    set continue_conn = true
        if not continue_conn:
            break

    let _cl: Result[Boolean, Text] = tcp_close(client_fd)
    return true

async fn microservice_worker_loop(accept_lock: Mutex, listener: Number, max_body_bytes: Number, max_in_flight: Number, m_in_flight: AtomicNumber, m_total: AtomicNumber, m_errors: AtomicNumber, m_rate_limited: AtomicNumber, logger: Logger) -> Boolean:
    while true:
        let _lk: Boolean = mutex_lock(accept_lock)
        let acc_res: Result[Number, Text] = tcp_accept(listener, 1000)
        let _unlk: Boolean = mutex_unlock(accept_lock)
        if result_is_ok(acc_res):
            let client_fd: Number = result_unwrap(acc_res)
            let _ok: Boolean = handle_client_connection(client_fd, max_body_bytes, max_in_flight, m_in_flight, m_total, m_errors, m_rate_limited, logger)
    return true

async fn execute_service_smoke_async(m_total: AtomicNumber, m_errors: AtomicNumber) -> Boolean:
    say "Executing async probe tasks concurrently..."
    let t_live: Task[HttpResponse] = spawn handle_microservice_request("GET", "/healthz", "", m_total, m_errors)
    let t_ready: Task[HttpResponse] = spawn handle_microservice_request("GET", "/readyz", "", m_total, m_errors)
    let t_metrics: Task[HttpResponse] = spawn handle_microservice_request("GET", "/metrics", "", m_total, m_errors)
    let t_get_orders: Task[HttpResponse] = spawn handle_microservice_request("GET", "/api/v1/orders", "", m_total, m_errors)
    let t_post_orders: Task[HttpResponse] = spawn handle_microservice_request("POST", "/api/v1/orders", "{\"id\":\"ord-smoke-1\",\"customer_id\":\"cust_smoke\",\"total_cents\":24900}", m_total, m_errors)

    let r_live: HttpResponse = await t_live
    let r_ready: HttpResponse = await t_ready
    let r_metrics: HttpResponse = t_metrics.await
    let r_get: HttpResponse = t_get_orders.await
    let r_post: HttpResponse = await t_post_orders

    assert(r_live.status_code == 200)
    assert(r_ready.status_code == 200)
    assert(r_metrics.status_code == 200)
    assert(r_get.status_code == 200)
    assert(r_post.status_code == 201)

    let t_find: Task[HttpResponse] = spawn handle_microservice_request("GET", "/api/v1/orders/ord-smoke-1", "", m_total, m_errors)
    let r_find: HttpResponse = await t_find
    assert(r_find.status_code == 200)
    return true

fn load_effective_service_config() -> ApiServiceConfig:
    if file_exists("yaza.toml"):
        let parsed: Result[ApiServiceConfig, Text] = api_config_parse(file_read("yaza.toml"))
        if result_is_ok(parsed):
            return result_unwrap(parsed)
    return result_unwrap(api_config_parse("[project]\nname = \"{{project_name}}\"\n[api]\nbind = \"0.0.0.0:8080\"\n"))

start:
    let logger: Logger = logger_create("{{project_name}}", "INFO")
    let cfg: ApiServiceConfig = load_effective_service_config()

    let m_in_flight: AtomicNumber = atomic_create(0)
    let m_total: AtomicNumber = atomic_create(0)
    let m_errors: AtomicNumber = atomic_create(0)
    let m_rate_limited: AtomicNumber = atomic_create(0)

    let ping_task: Task[Result[Boolean, Text]] = spawn order_repository_ping_async()
    let db_ready: Result[Boolean, Text] = await ping_task
    if not result_is_ok(db_ready):
        let _le: Boolean = log_error(logger, "startup_yazabase_failed", result_unwrap_error(db_ready) + " (Hint: provision ./data via 'yaza db set-user ./data admin <pass>' and set YAZABASE_USER / YAZABASE_PASSWORD)")
        exit(1)

    if env_get("YAZA_SELF_TEST") == "1":
        let smoke_task: Task[Boolean] = spawn execute_service_smoke_async(m_total, m_errors)
        let success: Boolean = smoke_task.await
        assert(success)
        say "MICROSERVICE_SELF_TEST: PASS"
        exit(0)

    let listener_res: Result[Number, Text] = tcp_listen(cfg.bind_host, cfg.bind_port, 128)
    if not result_is_ok(listener_res):
        let _le2: Boolean = log_error(logger, "tcp_listen_failed", result_unwrap_error(listener_res))
        exit(1)
    let listener: Number = result_unwrap(listener_res)

    say "=== {{project_name}} Cloud-Native Microservice ==="
    say "Architecture : Hexagonal (Ports & Adapters) + YazaBase SQL (ACID)"
    say "Concurrency  : Core 2 async/await & 8 spawn workers (" + cfg.resources.profile + ", max_in_flight = " + number_text(cfg.resources.max_in_flight) + ")"
    say "Listening on : http://" + cfg.bind_host + ":" + number_text(cfg.bind_port)
    say "Endpoints:"
    say "  GET  /healthz | /readyz | /metrics"
    say "  GET  /api/v1/orders"
    say "  GET  /api/v1/orders/:id"
    say "  POST /api/v1/orders"

    let accept_lock: Mutex = mutex_create(1)
    let workers: List[Task[Boolean]] = List[Task[Boolean]]()
    var wi: Number = 0
    while wi < 8:
        list_push(workers, spawn microservice_worker_loop(accept_lock, listener, cfg.max_request_body_bytes, cfg.resources.max_in_flight, m_in_flight, m_total, m_errors, m_rate_limited, logger))
        set wi = wi + 1
    var wj: Number = 0
    while wj < list_count(workers):
        let _done: Boolean = await list_get(workers, wj)
        set wj = wj + 1
