# Cloud-Native Microservice: {{project_name}}
# Architecture: Hexagonal (Ports & Adapters) + DDD
# Profile: throughput (AQB arena mode, 512 MiB process cap, 64 in-flight concurrency)
# Concurrency: Native Core 2 async fn, spawn, and await with isolated task arenas
use "adapters/http_handler"

async fn execute_service_smoke_async() -> Boolean:
    say "Executing async probe tasks concurrently..."
    let t_live: Task[HttpResponse] = spawn handle_microservice_request("GET", "/healthz", "")
    let t_ready: Task[HttpResponse] = spawn handle_microservice_request("GET", "/readyz", "")
    let t_metrics: Task[HttpResponse] = spawn handle_microservice_request("GET", "/metrics", "")
    let t_get_orders: Task[HttpResponse] = spawn handle_microservice_request("GET", "/api/v1/orders", "")
    let t_post_orders: Task[HttpResponse] = spawn handle_microservice_request("POST", "/api/v1/orders", "{\"items\":[1]}")

    let r_live: HttpResponse = await t_live
    let r_ready: HttpResponse = await t_ready
    let r_metrics: HttpResponse = t_metrics.await
    let r_get: HttpResponse = t_get_orders.await
    let r_post: HttpResponse = await t_post_orders

    assert(r_live.status_code == 200)
    assert(r_ready.status_code == 200)
    assert(r_metrics.status_code == 200)
    assert(r_get.status_code == 200)
    assert(r_post.status_code == 201)
    say "All concurrent microservice endpoints verified successfully (HTTP 200/201)."
    return true

start:
    say "=== {{project_name}} Cloud-Native Microservice ==="
    say "Architecture : Hexagonal / Ports & Adapters"
    say "Engine       : YazaBase Embedded Engine"
    say "Concurrency  : Language-level async/await & spawn"
    say "Probes & Telemetry:"
    say "  Liveness   : http://0.0.0.0:8080/healthz"
    say "  Readiness  : http://0.0.0.0:8080/readyz"
    say "  Metrics    : http://0.0.0.0:8080/metrics (Prometheus format)"
    say "  API Routes : http://0.0.0.0:8080/api/v1/orders"

    let db_init_task: Task[Result[Order, Text]] = spawn order_repository_save_async(Order("ord_0", "cust_0", "INIT", 0, "2026-11-16T00:00:00Z"))
    let _db_ready: Result[Order, Text] = await db_init_task
    let smoke_task: Task[Boolean] = spawn execute_service_smoke_async()
    let success: Boolean = smoke_task.await
    assert(success)

    say "Service initialized with 64 concurrent async task slots."
