# Domain Entity for {{project_name}}
shape OrderItem:
    item_id: Text
    quantity: Number
    unit_price_cents: Number

shape Order:
    id: Text
    customer_id: Text
    status: Text
    total_cents: Number
    created_at: Text

fn order_is_valid(order: Order) -> Boolean:
    if text_length(order.id) == 0:
        return false
    if text_length(order.customer_id) == 0:
        return false
    if order.total_cents < 0:
        return false
    return true
