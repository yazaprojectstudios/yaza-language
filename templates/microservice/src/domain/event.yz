# Domain Events for asynchronous event-driven architecture.
shape OrderCreatedEvent:
    event_id: Text
    order_id: Text
    occurred_at: Text
    payload_json: Text

fn order_created_event_serialize(event: OrderCreatedEvent) -> Text:
    return "{\"event_id\":\"" + event.event_id + "\",\"order_id\":\"" + event.order_id + "\",\"occurred_at\":\"" + event.occurred_at + "\"}"

# Asynchronous Event Dispatching (Core 2 Best Practice)
async fn event_publisher_dispatch_async(event: OrderCreatedEvent) -> Boolean:
    # Non-blocking event dispatch to event bus
    return true
