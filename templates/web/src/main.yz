# YAZA Web Application: {{project_name}}
# Single-binary Zero-GC Arena-SSR Web Server with YAZA UI ("YAZA Current") & Strict Web CSP.
use "std/net"
use "std/http"
use "std/sync"
use "std/web/request"
use "std/web/response"
use "std/web/static"
use "std/web/view"
use "std/config/api_config"

view web_brand_svg():
    <svg class="yz-logo-svg" viewBox="0 0 512 512" aria-hidden="true">
      <rect x="8" y="8" width="496" height="496" rx="112" fill="#102D33" stroke="#1D4A54" stroke-width="12"/>
      <g transform="translate(51.2, 51.2) scale(0.8)">
        <polygon points="84,68 190,68 304,264 200,444 94,444 198,264" fill="#00E5A8"/>
        <polygon points="324,68 428,68 318,257 266,168" fill="#FFFFFF"/>
      </g>
    </svg>

view render_web_welcome(profile_label: Text):
    <!doctype html>
    <html lang="en" data-theme="light">
    <head>
      <meta charset="utf-8">
      <meta name="viewport" content="width=device-width, initial-scale=1">
      <title>Welcome to YAZA Web · {{project_name}}</title>
      <link rel="stylesheet" href="/public/yaza-ui.css">
      <script defer src="/public/yaza-live.js"></script>
    </head>
    <body>
    <div class="yz-welcome-shell">
      <header class="yz-welcome-header">
        <a class="yz-brand" href="/">{! web_brand_svg() !}<span>{{project_name}}</span><span class="yz-ver-tag">WEB</span></a>
        <div class="yz-top-actions">
          <button class="yz-btn yz-btn-sm" type="button" data-yaza-theme-toggle="1">Theme</button>
          <a class="yz-btn yz-btn-sm yz-btn-primary" href="/healthz">Status</a>
        </div>
      </header>
      <section class="yz-hero-split">
        <div class="yz-hero-panel">
          <div>
            <div class="yz-eyebrow"><span class="yz-live-dot"></span>ONLINE · YAZA ARENA-SSR WEB</div>
            <h1 class="yz-hero-title">Welcome to <span>YAZA Web.</span></h1>
            <p class="yz-hero-lead">Project <code>{{project_name}}</code> is running natively on LLVM with Zero-GC <code>arena_scope</code> rendering, strict Web CSP, and YAZA UI v1.0.</p>
            <div class="yz-hero-cta">
              <a class="yz-btn yz-btn-primary" href="/public/yaza-ui.css">Inspect YAZA UI CSS</a>
              <a class="yz-btn" href="/healthz">GET /healthz</a>
            </div>
          </div>
          <div class="yz-telemetry-strip">
            <div class="yz-tele-item"><small>Runtime</small><strong class="yz-tele-ok">Zero-GC LLVM</strong></div>
            <div class="yz-tele-item"><small>AQB Profile</small><strong>{{ profile_label }}</strong></div>
            <div class="yz-tele-item"><small>Security</small><strong>Strict CSP · ETag</strong></div>
          </div>
        </div>
        <aside class="yz-term-panel">
          <div class="yz-term-bar"><span class="yz-term-dots"><i></i><i></i><i></i></span><span>yaza-web · 8 spawn workers</span></div>
          <div class="yz-term-body">
            <div><span class="yz-t-lime">$</span> yaza new --web {{project_name}}</div>
            <div class="yz-t-muted">  native single binary · 0 node_modules</div>
            <div><span class="yz-t-mint">GET</span> /                   <span class="yz-t-muted">→ Welcome SSR</span></div>
            <div><span class="yz-t-mint">GET</span> /public/yaza-ui.css <span class="yz-t-muted">→ ETag 304</span></div>
            <div><span class="yz-t-coral">GET</span> /healthz            <span class="yz-t-muted">→ JSON Probe</span></div>
          </div>
          <div class="yz-term-foot"><span>Need SQL + Auth MVC?</span><strong>yaza new --mvc</strong></div>
        </aside>
      </section>
      <footer class="yz-welcome-foot">
        <span>Edit <code>src/main.yz</code> or styles in <code>public/yaza-ui.css</code>.</span>
        <span>YAZA UI v1.0 (“YAZA Current”) · yazastudios.id</span>
      </footer>
    </div>
    </body>
    </html>

fn dispatch_web_req(req: WebRequest, profile_label: Text) -> WebResponse:
    let path: Text = req.http.path
    if path == "/healthz":
        return web_from_http_response(http_response_ok_json("{\"status\":\"ok\",\"service\":\"{{project_name}}\",\"mode\":\"web\"}"))
    if text_starts_with(path, "/public/"):
        let st: Result[WebResponse, Text] = static_serve_public_dir("./public", path, "/public/", req.if_none_match, 4194304)
        if result_is_ok(st): return result_unwrap(st)
        return web_html_status(404, "Not Found", "<h1>404 Asset Not Found</h1>")
    if path == "/":
        return web_html_ok(render_web_welcome(profile_label))
    return web_html_status(404, "Not Found", "<h1>404 Page Not Found</h1>")

fn header_end_index(raw_text: Text) -> Number:
    let crlf: Number = text_find(raw_text, "\r\n\r\n")
    if crlf >= 0: return crlf + 4
    let lf: Number = text_find(raw_text, "\n\n")
    if lf >= 0: return lf + 2
    return -1

fn read_req_bytes(client_fd: Number) -> Bytes:
    var buf: Bytes = bytes_empty()
    var chunks: Number = 0
    while chunks < 32:
        let rd: Result[Bytes, Text] = tcp_read(client_fd, 8192, 5000)
        if not result_is_ok(rd): break
        let chunk: Bytes = result_unwrap(rd)
        if bytes_length(chunk) == 0: break
        set buf = bytes_concat(buf, chunk)
        if header_end_index(bytes_to_text(buf)) >= 0:
            return buf
        set chunks = chunks + 1
    return buf

fn handle_web_client(client_fd: Number, profile_label: Text) -> Boolean:
    var keep_alive: Boolean = true
    var n: Number = 0
    while keep_alive and n < 64:
        var cont: Boolean = false
        arena_scope 1048576:
            let raw: Bytes = read_req_bytes(client_fd)
            if bytes_length(raw) > 0:
                set n = n + 1
                let txt: Text = bytes_to_text(raw)
                if n >= 64 or text_find(txt, "Connection: close") >= 0 or text_find(txt, "connection: close") >= 0:
                    set keep_alive = false
                let parsed: Result[WebRequest, Text] = web_parse_request(raw)
                var resp: WebResponse = web_from_http_response(http_response_bad_request("malformed HTTP request", true))
                if result_is_ok(parsed):
                    set resp = dispatch_web_req(result_unwrap(parsed), profile_label)
                let wr: Result[Number, Text] = tcp_write(client_fd, web_format_response(resp, "web-" + number_text(n), keep_alive), 5000)
                if result_is_ok(wr): set cont = true
        if not cont: break
    let _cl: Result[Boolean, Text] = tcp_close(client_fd)
    return true

async fn web_worker_loop(lock: Mutex, listener: Number, profile_label: Text) -> Boolean:
    while true:
        let _lk: Boolean = mutex_lock(lock)
        let acc: Result[Number, Text] = tcp_accept(listener, 1000)
        let _unlk: Boolean = mutex_unlock(lock)
        if result_is_ok(acc):
            let _ok: Boolean = handle_web_client(result_unwrap(acc), profile_label)
    return true

fn load_cfg() -> ApiServiceConfig:
    if file_exists("yaza.toml"):
        let p: Result[ApiServiceConfig, Text] = api_config_parse(file_read("yaza.toml"))
        if result_is_ok(p): return result_unwrap(p)
    return result_unwrap(api_config_parse("[project]\nname = \"{{project_name}}\"\n"))

start:
    let cfg: ApiServiceConfig = load_cfg()
    let profile_label: Text = cfg.resources.profile + " / " + cfg.resources.arena_mode
    if env_get("YAZA_SELF_TEST") == "1":
        arena_scope 1048576:
            let r1: WebResponse = dispatch_web_req(result_unwrap(web_parse_request(bytes_from_text("GET / HTTP/1.1\r\nHost: 127.0.0.1:8080\r\n\r\n"))), profile_label)
            assert(r1.status_code == 200 and text_find(bytes_to_text(r1.body), "Welcome to YAZA Web") >= 0)
            let r2: WebResponse = dispatch_web_req(result_unwrap(web_parse_request(bytes_from_text("GET /public/yaza-ui.css HTTP/1.1\r\nHost: 127.0.0.1:8080\r\n\r\n"))), profile_label)
            assert(r2.status_code == 200)
            let r3: WebResponse = dispatch_web_req(result_unwrap(web_parse_request(bytes_from_text("GET /public/../yaza.toml HTTP/1.1\r\nHost: 127.0.0.1:8080\r\n\r\n"))), profile_label)
            assert(r3.status_code == 404)
        say "WEB_STARTER_SELF_TEST: PASS"
        exit(0)

    let listener: Number = result_unwrap(tcp_listen(cfg.bind_host, cfg.bind_port, 128))
    say "=== {{project_name}} YAZA Web Server ==="
    say "Welcome Page : http://" + cfg.bind_host + ":" + number_text(cfg.bind_port) + "/"
    say "Health Check : http://" + cfg.bind_host + ":" + number_text(cfg.bind_port) + "/healthz"
    let lock: Mutex = mutex_create(1)
    let workers: List[Task[Boolean]] = List[Task[Boolean]]()
    var wi: Number = 0
    while wi < 8:
        list_push(workers, spawn web_worker_loop(lock, listener, profile_label))
        set wi = wi + 1
    var wj: Number = 0
    while wj < list_count(workers):
        let _d: Boolean = await list_get(workers, wj)
        set wj = wj + 1
