use "std/security/admin_credentials"
use "models/task_repository"

start:
    let db_dir: Text = task_db_dir()
    let _created: Number = yazabase_ensure_dir_tree(db_dir)
    let username: Text = env_get("YAZA_WEB_ADMIN_USER")
    let password: Text = env_get("YAZA_WEB_ADMIN_PASSWORD")
    let configured: Result[Boolean, Text] = admin_set_credentials(db_dir, username, password)
    if not result_is_ok(configured):
        say "admin setup: " + result_unwrap_error(configured)
        exit(1)
    say "Web admin credentials configured. Remove YAZA_WEB_ADMIN_PASSWORD from this shell."
