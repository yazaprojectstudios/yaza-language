# Master Layout View: Compiled HTML5 Shell with YAZA UI ("YAZA Current").
use "std/web/view"

fn render_app_layout(page_title: Text, active_nav: Text, username: Text, csrf_token: Text, profile_label: Text, body_html: Text) -> Text:
    var out: Text = "<!doctype html>\n<html lang=\"en\" data-theme=\"light\">\n<head>\n"
    set out = out + "  <meta charset=\"utf-8\">\n"
    set out = out + "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
    set out = out + "  <title>" + view_escape(page_title) + " · {{project_name}}</title>\n"
    set out = out + "  <link rel=\"stylesheet\" href=\"/public/yaza-ui.css\">\n"
    set out = out + "  <script defer src=\"/public/yaza-live.js\"></script>\n"
    set out = out + "</head>\n<body>\n<div class=\"yz-shell\">\n"

    # Sidebar
    set out = out + "  <aside class=\"yz-sidebar\" aria-label=\"Workspace navigation\">\n"
    set out = out + "    <div>\n"
    set out = out + "      <a class=\"yz-brand\" href=\"/\"><span class=\"yz-mark\">Y</span><span>{{project_name}}</span></a>\n"
    set out = out + "      <nav class=\"yz-nav\">\n"
    set out = out + "        <p class=\"yz-nav-label\">MONOLITH MVC</p>\n"
    var cls_dash: Text = ""
    if active_nav == "dashboard": set cls_dash = "is-active"
    set out = out + "        <a href=\"/\"><span>Welcome</span></a>\n"
    set out = out + "        <a class=\"" + cls_dash + "\" href=\"/dashboard\"><span>Dashboard</span><span class=\"yz-pill\">SSR</span></a>\n"
    set out = out + "        <a href=\"/api/v1/tasks\"><span>JSON API</span></a>\n"
    set out = out + "        <p class=\"yz-nav-label\">OBSERVABILITY</p>\n"
    set out = out + "        <a href=\"/healthz\"><span>Liveness /healthz</span></a>\n"
    set out = out + "        <a href=\"/readyz\"><span>Readiness /readyz</span></a>\n"
    set out = out + "        <a href=\"/metrics\"><span>Prometheus /metrics</span></a>\n"
    set out = out + "      </nav>\n"
    set out = out + "    </div>\n"
    set out = out + "    <div class=\"yz-sidebar-foot\">\n"
    set out = out + "      <div>Zero-GC Arena-SSR</div>\n"
    set out = out + "      <div>Profile: " + view_escape(profile_label) + "</div>\n"
    set out = out + "    </div>\n"
    set out = out + "  </aside>\n"

    # Main column
    set out = out + "  <div class=\"yz-main-col\">\n"
    set out = out + "    <header class=\"yz-topbar\">\n"
    set out = out + "      <div class=\"yz-crumb\">Workspace / <strong>" + view_escape(page_title) + "</strong></div>\n"
    set out = out + "      <div class=\"yz-top-actions\">\n"
    set out = out + "        <button class=\"yz-btn yz-btn-sm\" type=\"button\" data-yaza-theme-toggle=\"1\">Theme</button>\n"
    set out = out + "        <span class=\"yz-crumb\">" + view_escape(username) + "</span>\n"
    set out = out + "        <form method=\"POST\" action=\"/logout\">" + view_csrf_input(csrf_token) + "<button class=\"yz-btn yz-btn-sm\" type=\"submit\">Sign out</button></form>\n"
    set out = out + "      </div>\n"
    set out = out + "    </header>\n"
    set out = out + "    <main class=\"yz-content\">\n" + body_html + "\n    </main>\n"
    set out = out + "  </div>\n</div>\n</body>\n</html>"
    return out
