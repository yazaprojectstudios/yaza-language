# Master Layout View: Compiled HTML5 Shell with YAZA UI v1.0 ("YAZA Current").
use "std/web/view"

view app_brand_svg():
    <svg class="yz-logo-svg" viewBox="0 0 512 512" aria-hidden="true">
      <rect x="8" y="8" width="496" height="496" rx="112" fill="#102D33" stroke="#1D4A54" stroke-width="12"/>
      <g transform="translate(51.2, 51.2) scale(0.8)">
        <polygon points="84,68 190,68 304,264 200,444 94,444 198,264" fill="#00E5A8"/>
        <polygon points="324,68 428,68 318,257 266,168" fill="#FFFFFF"/>
      </g>
    </svg>

view render_app_layout(page_title: Text, active_nav: Text, username: Text, csrf_token: Text, profile_label: Text, body_html: Text):
    <!doctype html>
    <html lang="en" data-theme="light">
    <head>
      <meta charset="utf-8">
      <meta name="viewport" content="width=device-width, initial-scale=1">
      <title>{{ page_title }} · {{project_name}}</title>
      <link rel="stylesheet" href="/public/yaza-ui.css">
      <script defer src="/public/yaza-live.js"></script>
    </head>
    <body>
    <div class="yz-shell">
      <aside class="yz-sidebar" aria-label="Workspace navigation">
        <div>
          <a class="yz-brand" href="/">{! app_brand_svg() !}<span>{{project_name}}</span></a>
          <nav class="yz-nav">
            <p class="yz-nav-label">MONOLITH MVC</p>
            <a href="/"><span class="yz-nav-left"><svg class="yz-icon-svg" viewBox="0 0 24 24"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>Welcome</span></a>
            var cls_dash: Text = ""
            if active_nav == "dashboard":
                set cls_dash = "is-active"
            <a class="{{ cls_dash }}" href="/dashboard"><span class="yz-nav-left"><svg class="yz-icon-svg" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>Dashboard</span><span class="yz-pill">SSR</span></a>
            <a href="/api/v1/tasks"><span class="yz-nav-left"><svg class="yz-icon-svg" viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>JSON API</span></a>
            <p class="yz-nav-label">OBSERVABILITY</p>
            <a href="/healthz"><span class="yz-nav-left"><svg class="yz-icon-svg" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>Liveness /healthz</span></a>
            <a href="/readyz"><span class="yz-nav-left"><svg class="yz-icon-svg" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>Readiness /readyz</span></a>
            <a href="/metrics"><span class="yz-nav-left"><svg class="yz-icon-svg" viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>Metrics /metrics</span></a>
          </nav>
        </div>
        <div class="yz-sidebar-foot">
          <strong>Zero-GC Arena-SSR</strong>
          <div>Profile: {{ profile_label }}</div>
        </div>
      </aside>
      <div class="yz-main-col">
        <header class="yz-topbar">
          <div class="yz-crumb">Workspace / <strong>{{ page_title }}</strong></div>
          <div class="yz-top-actions">
            <button class="yz-btn yz-btn-sm" type="button" data-yaza-theme-toggle="1">Theme</button>
            <span class="yz-user-chip">{{ username }}</span>
            <form method="POST" action="/logout">{! view_csrf_input(csrf_token) !}<button class="yz-btn yz-btn-sm" type="submit">Sign out</button></form>
          </div>
        </header>
        <main class="yz-content">
          {! body_html !}
        </main>
      </div>
    </div>
    </body>
    </html>
