# Master Layout View: Compiled HTML5 Shell with YAZA UI v1.0 ("YAZA Current").
use "std/web/view"

fn app_brand_svg() -> Text:
    return "<svg class=\"yz-logo-svg\" viewBox=\"0 0 512 512\" aria-hidden=\"true\"><rect x=\"8\" y=\"8\" width=\"496\" height=\"496\" rx=\"112\" fill=\"#102D33\" stroke=\"#1D4A54\" stroke-width=\"12\"/><g transform=\"translate(51.2, 51.2) scale(0.8)\"><polygon points=\"84,68 190,68 304,264 200,444 94,444 198,264\" fill=\"#00E5A8\"/><polygon points=\"324,68 428,68 318,257 266,168\" fill=\"#FFFFFF\"/></g></svg>"

fn render_app_layout(page_title: Text, active_nav: Text, username: Text, csrf_token: Text, profile_label: Text, body_html: Text) -> Text:
    let p: TextList = text_list()
    list_push(p, "<!doctype html>\n<html lang=\"en\" data-theme=\"light\">\n<head>\n")
    list_push(p, "  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n")
    list_push(p, "  <title>" + view_escape(page_title) + " · {{project_name}}</title>\n")
    list_push(p, "  <link rel=\"stylesheet\" href=\"/public/yaza-ui.css\">\n")
    list_push(p, "  <script defer src=\"/public/yaza-live.js\"></script>\n")
    list_push(p, "</head>\n<body>\n<div class=\"yz-shell\">\n")

    # Sidebar
    list_push(p, "  <aside class=\"yz-sidebar\" aria-label=\"Workspace navigation\">\n    <div>\n")
    list_push(p, "      <a class=\"yz-brand\" href=\"/\">" + app_brand_svg() + "<span>{{project_name}}</span></a>\n")
    list_push(p, "      <nav class=\"yz-nav\">\n")
    list_push(p, "        <p class=\"yz-nav-label\">MONOLITH MVC</p>\n")
    list_push(p, "        <a href=\"/\"><span class=\"yz-nav-left\"><svg class=\"yz-icon-svg\" viewBox=\"0 0 24 24\"><path d=\"m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/></svg>Welcome</span></a>\n")
    var cls_dash: Text = ""
    if active_nav == "dashboard": set cls_dash = "is-active"
    list_push(p, "        <a class=\"" + cls_dash + "\" href=\"/dashboard\"><span class=\"yz-nav-left\"><svg class=\"yz-icon-svg\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/></svg>Dashboard</span><span class=\"yz-pill\">SSR</span></a>\n")
    list_push(p, "        <a href=\"/api/v1/tasks\"><span class=\"yz-nav-left\"><svg class=\"yz-icon-svg\" viewBox=\"0 0 24 24\"><polyline points=\"16 18 22 12 16 6\"/><polyline points=\"8 6 2 12 8 18\"/></svg>JSON API</span></a>\n")
    list_push(p, "        <p class=\"yz-nav-label\">OBSERVABILITY</p>\n")
    list_push(p, "        <a href=\"/healthz\"><span class=\"yz-nav-left\"><svg class=\"yz-icon-svg\" viewBox=\"0 0 24 24\"><polyline points=\"22 12 18 12 15 21 9 3 6 12 2 12\"/></svg>Liveness /healthz</span></a>\n")
    list_push(p, "        <a href=\"/readyz\"><span class=\"yz-nav-left\"><svg class=\"yz-icon-svg\" viewBox=\"0 0 24 24\"><ellipse cx=\"12\" cy=\"5\" rx=\"9\" ry=\"3\"/><path d=\"M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5\"/></svg>Readiness /readyz</span></a>\n")
    list_push(p, "        <a href=\"/metrics\"><span class=\"yz-nav-left\"><svg class=\"yz-icon-svg\" viewBox=\"0 0 24 24\"><line x1=\"18\" y1=\"20\" x2=\"18\" y2=\"10\"/><line x1=\"12\" y1=\"20\" x2=\"12\" y2=\"4\"/><line x1=\"6\" y1=\"20\" x2=\"6\" y2=\"14\"/></svg>Metrics /metrics</span></a>\n")
    list_push(p, "      </nav>\n    </div>\n")
    list_push(p, "    <div class=\"yz-sidebar-foot\">\n      <strong>Zero-GC Arena-SSR</strong>\n      <div>Profile: " + view_escape(profile_label) + "</div>\n    </div>\n  </aside>\n")

    # Main column
    list_push(p, "  <div class=\"yz-main-col\">\n")
    list_push(p, "    <header class=\"yz-topbar\">\n")
    list_push(p, "      <div class=\"yz-crumb\">Workspace / <strong>" + view_escape(page_title) + "</strong></div>\n")
    list_push(p, "      <div class=\"yz-top-actions\">\n")
    list_push(p, "        <button class=\"yz-btn yz-btn-sm\" type=\"button\" data-yaza-theme-toggle=\"1\">Theme</button>\n")
    list_push(p, "        <span class=\"yz-user-chip\">" + view_escape(username) + "</span>\n")
    list_push(p, "        <form method=\"POST\" action=\"/logout\">" + view_csrf_input(csrf_token) + "<button class=\"yz-btn yz-btn-sm\" type=\"submit\">Sign out</button></form>\n")
    list_push(p, "      </div>\n    </header>\n")
    list_push(p, "    <main class=\"yz-content\">\n" + body_html + "\n    </main>\n")
    list_push(p, "  </div>\n</div>\n</body>\n</html>")
    return text_join(p, "")
