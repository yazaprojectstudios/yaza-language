# Compiled SSR View: Default "Welcome to YAZA" Modern Split-Hero & Bento Landing Page (GET /).
use "std/web/view"
use "../layouts/app_layout"

view render_welcome_page(profile_label: Text, db_ready: Boolean, task_count: Number, signed_in_user: Text):
    var db_status: Text = "Connecting..."
    if db_ready:
        set db_status = "Connected · " + number_text(task_count) + " tasks"
    var primary_href: Text = "/login"
    var primary_label: Text = "Open MVC Dashboard →"
    if text_length(signed_in_user) > 0:
        set primary_href = "/dashboard"
        set primary_label = "Open Dashboard (" + signed_in_user + ") →"
    <!doctype html>
    <html lang="en" data-theme="light">
    <head>
      <meta charset="utf-8">
      <meta name="viewport" content="width=device-width, initial-scale=1">
      <title>Welcome to YAZA · {{project_name}}</title>
      <link rel="stylesheet" href="/public/yaza-ui.css">
      <script defer src="/public/yaza-live.js"></script>
    </head>
    <body>
    <div class="yz-welcome-shell">
      <header class="yz-welcome-header">
        <a class="yz-brand" href="/">{! app_brand_svg() !}<span>{{project_name}}</span><span class="yz-ver-tag">v1.0.0</span></a>
        <nav class="yz-header-links" aria-label="Quick links">
          <a href="/dashboard">Workspace</a><a href="/api/v1/tasks">JSON API</a><a href="/healthz">Health</a><a href="/metrics">Metrics</a>
        </nav>
        <div class="yz-top-actions">
          <button class="yz-btn yz-btn-sm" type="button" data-yaza-theme-toggle="1">Theme</button>
          <a class="yz-btn yz-btn-sm yz-btn-primary" href="{! view_safe_href(primary_href) !}">Launch App</a>
        </div>
      </header>
      <section class="yz-hero-split">
        <div class="yz-hero-panel">
          <div>
            <div class="yz-eyebrow"><span class="yz-live-dot"></span>ONLINE · ZERO-GC ARENA-SSR ENGINE</div>
            <h1 class="yz-hero-title">Welcome to <span>YAZA.</span></h1>
            <p class="yz-hero-lead"><code>{{project_name}}</code> is running as a single native LLVM binary — combining compiled XSS-safe SSR views, live Hypermedia Fragments, and embedded YazaBase ACID SQL with zero GC pauses.</p>
            <div class="yz-hero-cta">
              <a class="yz-btn yz-btn-primary" href="{! view_safe_href(primary_href) !}">{{ primary_label }}</a>
              <a class="yz-btn" href="/api/v1/tasks">Explore JSON API</a>
            </div>
          </div>
          <div class="yz-telemetry-strip">
            <div class="yz-tele-item"><small>Database</small><strong class="yz-tele-ok">{{ db_status }}</strong></div>
            <div class="yz-tele-item"><small>AQB Profile</small><strong>{{ profile_label }}</strong></div>
            <div class="yz-tele-item"><small>Security</small><strong>Argon2id · CSP · CSRF</strong></div>
          </div>
        </div>
        <aside class="yz-term-panel" aria-label="Active runtime routes">
          <div class="yz-term-bar"><span class="yz-term-dots"><i></i><i></i><i></i></span><span>yaza-runtime · 8 spawn workers</span></div>
          <div class="yz-term-body">
            <div><span class="yz-t-lime">$</span> yaza new --mvc {{project_name}}</div>
            <div class="yz-t-muted">  compiled native binary · 0 node_modules</div>
            <div class="yz-t-gap"></div>
            <div><span class="yz-t-mint">GET </span> /                <span class="yz-t-muted">→ Welcome SSR</span></div>
            <div><span class="yz-t-mint">GET </span> /dashboard       <span class="yz-t-muted">→ MVC Workspace</span></div>
            <div><span class="yz-t-lime">POST</span> /tasks           <span class="yz-t-muted">→ CSRF + Fragment</span></div>
            <div><span class="yz-t-mint">GET </span> /api/v1/tasks    <span class="yz-t-muted">→ JSON Parity</span></div>
            <div><span class="yz-t-coral">GET </span> /metrics         <span class="yz-t-muted">→ Prometheus</span></div>
          </div>
          <div class="yz-term-foot"><span>arena_scope 1 MiB / req</span><strong>1-step reset · 0 GC</strong></div>
        </aside>
      </section>
      <section class="yz-bento">
        <article class="yz-bento-card yz-span-7">
          <div>
            <div class="yz-bento-top"><span class="yz-icon-box"><svg class="yz-icon-svg" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/></svg></span><span class="yz-badge yz-badge-open">01 · MVC Workspace</span></div>
            <h2>Authenticated CRUD + Live Hypermedia Fragments</h2>
            <p>Sign in with your YazaBase Argon2id user to add, toggle, and delete tasks. Forms annotated with <code>data-yaza-target</code> swap only the <code>#task-board</code> fragment via ~2 KB zero-dep JS — and degrade gracefully to HTTP 303 without JS.</p>
          </div>
          <div class="yz-pill-row"><a class="yz-route-pill" href="/dashboard">/dashboard</a><a class="yz-route-pill" href="/login">/login</a><a class="yz-route-pill" href="/public/yaza-live.js">/public/yaza-live.js</a></div>
        </article>
        <article class="yz-bento-card yz-span-5">
          <div>
            <div class="yz-bento-top"><span class="yz-icon-box"><svg class="yz-icon-svg" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span><span class="yz-badge yz-badge-high">02 · Hardened</span></div>
            <h2>Web Security by Default</h2>
            <p>HMAC-SHA256 signed <code>HttpOnly</code> sessions, constant-time CSRF tokens, <code>std/html</code> XSS escaping, strict CSP, and compile-time MVC boundaries.</p>
          </div>
          <div class="yz-pill-row"><span class="yz-route-pill">yaza arch check</span><span class="yz-route-pill">yaza audit --security</span></div>
        </article>
        <article class="yz-bento-card yz-span-5">
          <div>
            <div class="yz-bento-top"><span class="yz-icon-box"><svg class="yz-icon-svg" viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg></span><span class="yz-badge yz-badge-normal">03 · Tri-Mode</span></div>
            <h2>One Controller. Three Formats.</h2>
            <p>Serve full SSR HTML5 pages, partial fragments, and JSON APIs from the exact same typed models and services — zero duplicate DTOs.</p>
          </div>
          <div class="yz-pill-row"><a class="yz-route-pill" href="/api/v1/tasks">/api/v1/tasks</a><a class="yz-route-pill" href="/public/yaza-ui.css">/public/yaza-ui.css</a></div>
        </article>
        <article class="yz-bento-card yz-bento-dark yz-span-7">
          <div>
            <div class="yz-bento-top"><span class="yz-icon-box"><svg class="yz-icon-svg" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg></span><span class="yz-ver-tag">04 · AQB + SQL</span></div>
            <h2>Hardware-Aware Profiles &amp; Pluggable SQL</h2>
            <p>Tune memory caps in <code>yaza.toml</code> across <code>low_memory</code> (128 MiB), <code>balanced</code> (512 MiB), and <code>throughput</code> (2 GiB). Ships with embedded YazaBase ACID SQL plus native stdlib drivers for PostgreSQL, MySQL, MSSQL, and NoSQL.</p>
          </div>
          <div class="yz-pill-row"><a class="yz-route-pill" href="/healthz">/healthz</a><a class="yz-route-pill" href="/readyz">/readyz</a><a class="yz-route-pill" href="/metrics">/metrics</a></div>
        </article>
      </section>
      <footer class="yz-welcome-foot">
        <span>Customize <code>src/views/pages/welcome_page.yz</code> or styles in <code>public/yaza-ui.css</code>.</span>
        <span>YAZA UI v1.0 (“YAZA Current”) · yazastudios.id</span>
      </footer>
    </div>
    </body>
    </html>
