# Compiled SSR View: Default "Welcome to YAZA" Monolith Landing Page (GET /).
use "std/web/view"

fn render_welcome_page(profile_label: Text, db_ready: Boolean, task_count: Number, signed_in_user: Text) -> Text:
    var db_badge: Text = "YazaBase SQL: Connecting"
    if db_ready:
        set db_badge = "YazaBase ACID SQL: Connected (" + number_text(task_count) + " tasks)"
    var primary_href: Text = "/login"
    var primary_label: Text = "Open MVC Dashboard (Sign In) →"
    if text_length(signed_in_user) > 0:
        set primary_href = "/dashboard"
        set primary_label = "Open MVC Dashboard (" + view_escape(signed_in_user) + ") →"

    var out: Text = "<!doctype html>\n<html lang=\"en\" data-theme=\"light\">\n<head>\n"
    set out = out + "  <meta charset=\"utf-8\">\n"
    set out = out + "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
    set out = out + "  <title>Welcome to YAZA · {{project_name}}</title>\n"
    set out = out + "  <link rel=\"stylesheet\" href=\"/public/yaza-ui.css\">\n"
    set out = out + "  <script defer src=\"/public/yaza-live.js\"></script>\n"
    set out = out + "</head>\n<body>\n<div class=\"yz-welcome-wrap\">\n"

    # Top Nav
    set out = out + "  <header class=\"yz-welcome-nav\">\n"
    set out = out + "    <a class=\"yz-brand\" href=\"/\"><span class=\"yz-mark\">Y</span><span>{{project_name}}</span></a>\n"
    set out = out + "    <div class=\"yz-top-actions\">\n"
    set out = out + "      <button class=\"yz-btn yz-btn-sm\" type=\"button\" data-yaza-theme-toggle=\"1\">Theme</button>\n"
    set out = out + "      <a class=\"yz-btn yz-btn-sm yz-btn-primary\" href=\"" + view_safe_href(primary_href) + "\">Dashboard</a>\n"
    set out = out + "    </div>\n"
    set out = out + "  </header>\n"

    # Hero Card
    set out = out + "  <section class=\"yz-welcome-hero\">\n"
    set out = out + "    <p class=\"yz-eyebrow\">YAZA v1.0.0 · SINGLE-BINARY ARENA-SSR MONOLITH</p>\n"
    set out = out + "    <h1>Welcome to YAZA.</h1>\n"
    set out = out + "    <p class=\"yz-welcome-lead\">Your fullstack MVC application <code>{{project_name}}</code> is running natively on LLVM with Zero-GC <code>arena_scope</code> memory, compiled XSS-safe views, Hypermedia Fragments, and embedded YazaBase ACID SQL.</p>\n"
    set out = out + "    <div class=\"yz-stamp-bar\">\n"
    set out = out + "      <span class=\"yz-stamp yz-stamp-accent\">" + view_escape(db_badge) + "</span>\n"
    set out = out + "      <span class=\"yz-stamp\">Profile: " + view_escape(profile_label) + "</span>\n"
    set out = out + "      <span class=\"yz-stamp\">Strict Web CSP + CSRF</span>\n"
    set out = out + "      <span class=\"yz-stamp\">0 node_modules</span>\n"
    set out = out + "    </div>\n"
    set out = out + "    <div class=\"yz-welcome-actions\">\n"
    set out = out + "      <a class=\"yz-btn yz-btn-primary\" href=\"" + view_safe_href(primary_href) + "\">" + primary_label + "</a>\n"
    set out = out + "      <a class=\"yz-btn\" href=\"/healthz\">Inspect /healthz</a>\n"
    set out = out + "      <a class=\"yz-btn\" href=\"/metrics\">Prometheus /metrics</a>\n"
    set out = out + "    </div>\n"
    set out = out + "  </section>\n"

    # 4 Starter Architecture Cards
    set out = out + "  <section class=\"yz-welcome-grid\">\n"
    set out = out + "    <article class=\"yz-card yz-feature-card\">\n"
    set out = out + "      <div class=\"yz-metric-label\">01 · MVC WORKSPACE</div>\n"
    set out = out + "      <h2>Authenticated CRUD + Live Fragments</h2>\n"
    set out = out + "      <p>Sign in with your provisioned YazaBase Argon2id credentials to create, toggle, and delete tasks with instant partial DOM swaps and CSRF protection.</p>\n"
    set out = out + "      <div class=\"yz-link-row\"><a class=\"yz-link-pill\" href=\"/dashboard\">/dashboard</a><a class=\"yz-link-pill\" href=\"/login\">/login</a></div>\n"
    set out = out + "    </article>\n"

    set out = out + "    <article class=\"yz-card yz-feature-card\">\n"
    set out = out + "      <div class=\"yz-metric-label\">02 · TRI-MODE CONTROLLERS</div>\n"
    set out = out + "      <h2>Full SSR, Fragments &amp; JSON API</h2>\n"
    set out = out + "      <p>One controller serves HTML5 pages, <code>X-Yaza-Fragment</code> partials via <code>public/yaza-live.js</code>, and JSON APIs from the same typed models.</p>\n"
    set out = out + "      <div class=\"yz-link-row\"><a class=\"yz-link-pill\" href=\"/api/v1/tasks\">/api/v1/tasks</a><a class=\"yz-link-pill\" href=\"/public/yaza-ui.css\">/public/yaza-ui.css</a></div>\n"
    set out = out + "    </article>\n"

    set out = out + "    <article class=\"yz-card yz-feature-card\">\n"
    set out = out + "      <div class=\"yz-metric-label\">03 · LAYERED MVC STRUCTURE</div>\n"
    set out = out + "      <h2>Compile-Time Layer Boundaries</h2>\n"
    set out = out + "      <p>Edit <code>src/models/</code>, <code>src/services/</code>, <code>src/controllers/</code>, and <code>src/views/</code>. Run <code>yaza arch check</code> and <code>yaza audit --security</code> before shipping.</p>\n"
    set out = out + "      <div class=\"yz-link-row\"><span class=\"yz-link-pill\">yaza arch check</span><span class=\"yz-link-pill\">yaza audit --security</span></div>\n"
    set out = out + "    </article>\n"

    set out = out + "    <article class=\"yz-card yz-feature-card\">\n"
    set out = out + "      <div class=\"yz-metric-label\">04 · DATABASE &amp; PROFILES</div>\n"
    set out = out + "      <h2>YazaBase SQL + Pluggable Drivers</h2>\n"
    set out = out + "      <p>Runs embedded YazaBase ACID SQL out of the box, with native wire-protocol stdlib drivers for PostgreSQL, MySQL, MSSQL, and NoSQL plus AQB caps in <code>yaza.toml</code>.</p>\n"
    set out = out + "      <div class=\"yz-link-row\"><a class=\"yz-link-pill\" href=\"/readyz\">/readyz</a><a class=\"yz-link-pill\" href=\"/metrics\">/metrics</a></div>\n"
    set out = out + "    </article>\n"
    set out = out + "  </section>\n"

    set out = out + "  <footer class=\"yz-welcome-foot\">\n"
    set out = out + "    <span>Edit <code>src/views/pages/welcome_page.yz</code> to customize this landing page.</span>\n"
    set out = out + "    <span>YAZA v1.0.0 · yazastudios.id</span>\n"
    set out = out + "  </footer>\n"
    set out = out + "</div>\n</body>\n</html>"
    return out
