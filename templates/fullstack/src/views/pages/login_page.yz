# Compiled SSR View: Modern Login Page (YAZA UI v1.0 + Argon2id YazaBase Auth).
use "std/web/view"

fn login_brand_svg() -> Text:
    return "<svg class=\"yz-logo-svg\" viewBox=\"0 0 512 512\" aria-hidden=\"true\"><rect x=\"8\" y=\"8\" width=\"496\" height=\"496\" rx=\"112\" fill=\"#102D33\" stroke=\"#1D4A54\" stroke-width=\"12\"/><g transform=\"translate(51.2, 51.2) scale(0.8)\"><polygon points=\"84,68 190,68 304,264 200,444 94,444 198,264\" fill=\"#00E5A8\"/><polygon points=\"324,68 428,68 318,257 266,168\" fill=\"#FFFFFF\"/></g></svg>"

fn render_login_page(error_msg: Text) -> Text:
    var out: Text = "<!doctype html>\n<html lang=\"en\" data-theme=\"light\">\n<head>\n"
    set out = out + "  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
    set out = out + "  <title>Sign in · {{project_name}}</title>\n"
    set out = out + "  <link rel=\"stylesheet\" href=\"/public/yaza-ui.css\">\n"
    set out = out + "  <script defer src=\"/public/yaza-live.js\"></script>\n"
    set out = out + "</head>\n<body>\n<main class=\"yz-auth-wrap\">\n"
    set out = out + "  <section class=\"yz-auth-card\">\n"
    set out = out + "    <a class=\"yz-brand\" href=\"/\">" + login_brand_svg() + "<span>{{project_name}}</span><span class=\"yz-ver-tag\">MVC</span></a>\n"
    set out = out + "    <h1 class=\"yz-auth-title\">Sign in to Workspace</h1>\n"
    set out = out + "    <p class=\"yz-sub yz-auth-sub\">Verified against YazaBase Argon2id credentials with signed HttpOnly cookies.</p>\n"
    if text_length(error_msg) > 0:
        set out = out + "    <div class=\"yz-alert\" role=\"alert\">" + view_escape(error_msg) + "</div>\n"
    set out = out + "    <form method=\"POST\" action=\"/login\">\n"
    set out = out + "      <div class=\"yz-field\"><label for=\"username\">Username</label><input class=\"yz-input\" id=\"username\" name=\"username\" type=\"text\" value=\"admin\" required autocomplete=\"username\"></div>\n"
    set out = out + "      <div class=\"yz-field\"><label for=\"password\">Password</label><input class=\"yz-input\" id=\"password\" name=\"password\" type=\"password\" required autocomplete=\"current-password\"></div>\n"
    set out = out + "      <button class=\"yz-btn yz-btn-primary yz-btn-block\" type=\"submit\">Sign in →</button>\n"
    set out = out + "    </form>\n"
    set out = out + "    <div class=\"yz-auth-foot\"><a href=\"/\">← Back to Welcome</a><button class=\"yz-btn yz-btn-sm\" type=\"button\" data-yaza-theme-toggle=\"1\">Theme</button></div>\n"
    set out = out + "  </section>\n</main>\n</body>\n</html>"
    return out
