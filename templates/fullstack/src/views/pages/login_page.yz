# Compiled SSR View: Modern Login Page (YAZA UI v1.0 + Argon2id YazaBase Auth).
use "std/web/view"
use "../layouts/app_layout"

view render_login_page(error_msg: Text):
    <!doctype html>
    <html lang="en" data-theme="light">
    <head>
      <meta charset="utf-8">
      <meta name="viewport" content="width=device-width, initial-scale=1">
      <title>Sign in · {{project_name}}</title>
      <link rel="stylesheet" href="/public/yaza-ui.css">
      <script defer src="/public/yaza-live.js"></script>
    </head>
    <body>
    <main class="yz-auth-wrap">
      <section class="yz-auth-card">
        <a class="yz-brand" href="/">{! app_brand_svg() !}<span>{{project_name}}</span><span class="yz-ver-tag">MVC</span></a>
        <h1 class="yz-auth-title">Sign in to Workspace</h1>
        <p class="yz-sub yz-auth-sub">Verified against YazaBase Argon2id credentials with signed HttpOnly cookies.</p>
        if text_length(error_msg) > 0:
            <div class="yz-alert" role="alert">{{ error_msg }}</div>
        <form method="POST" action="/login">
          <div class="yz-field"><label for="username">Username</label><input class="yz-input" id="username" name="username" type="text" value="admin" required autocomplete="username"></div>
          <div class="yz-field"><label for="password">Password</label><input class="yz-input" id="password" name="password" type="password" required autocomplete="current-password"></div>
          <button class="yz-btn yz-btn-primary yz-btn-block" type="submit">Sign in →</button>
        </form>
        <p><a href="/forgot-password">Forgot password?</a></p>
        <div class="yz-auth-foot"><a href="/">← Back to Welcome</a><button class="yz-btn yz-btn-sm" type="button" data-yaza-theme-toggle="1">Theme</button></div>
      </section>
    </main>
    </body>
    </html>
