# Compiled SSR View: Dashboard Page composing Master Layout + Task Board Fragment.
use "std/web/view"
use "../../models/task"
use "../layouts/app_layout"
use "../components/task_board"

fn render_dashboard_page(items: List[TaskItem], stats: TaskStats, username: Text, csrf_token: Text, profile_label: Text, flash_msg: Text, is_error: Boolean) -> Text:
    var body: Text = "<div class=\"yz-head\">\n"
    set body = body + "  <div>\n"
    set body = body + "    <p class=\"yz-eyebrow\">SINGLE-BINARY FULLSTACK MVC · YAZABASE ACID SQL</p>\n"
    set body = body + "    <h1>Workspace Tasks</h1>\n"
    set body = body + "    <p class=\"yz-sub\">Rendered natively inside a per-request Zero-GC <code>arena_scope</code> with live fragment updates.</p>\n"
    set body = body + "  </div>\n"
    set body = body + "  <a class=\"yz-btn\" href=\"/tasks\" data-yaza-target=\"#task-board\">Refresh Fragment</a>\n"
    set body = body + "</div>\n"
    set body = body + render_task_board_fragment(items, stats, csrf_token, flash_msg, is_error)
    return render_app_layout("Dashboard", "dashboard", username, csrf_token, profile_label, body)
