# Reusable Compiled SSR Component: #task-board (Full Page & Hypermedia Fragment Swappable).
use "std/web/view"
use "../../models/task"

fn render_task_row(item: TaskItem, csrf_token: Text) -> Text:
    var status_cls: Text = "yz-badge yz-badge-open"
    var toggle_label: Text = "Mark Done"
    if item.status == "done":
        set status_cls = "yz-badge yz-badge-done"
        set toggle_label = "Reopen"
    var prio_cls: Text = "yz-badge yz-badge-normal"
    if item.priority == "high":
        set prio_cls = "yz-badge yz-badge-high"

    let safe_id: Text = view_escape(item.id)
    var row: Text = "<tr>"
    set row = row + "<td><code>" + safe_id + "</code></td>"
    set row = row + "<td><strong>" + view_escape(item.title) + "</strong></td>"
    set row = row + "<td><span class=\"" + prio_cls + "\">" + view_escape(item.priority) + "</span></td>"
    set row = row + "<td><span class=\"" + status_cls + "\">" + view_escape(item.status) + "</span></td>"
    set row = row + "<td>" + view_escape(item.owner) + "</td>"
    set row = row + "<td class=\"yz-inline-actions\">"
    set row = row + "<form method=\"POST\" action=\"/tasks/" + safe_id + "/toggle\" data-yaza-target=\"#task-board\">"
    set row = row + view_csrf_input(csrf_token)
    set row = row + "<button class=\"yz-btn yz-btn-sm\" type=\"submit\">" + toggle_label + "</button></form>"
    set row = row + "<form method=\"POST\" action=\"/tasks/" + safe_id + "/delete\" data-yaza-target=\"#task-board\">"
    set row = row + view_csrf_input(csrf_token)
    set row = row + "<button class=\"yz-btn yz-btn-sm yz-btn-danger\" type=\"submit\">Delete</button></form>"
    set row = row + "</td></tr>\n"
    return row

fn render_task_board_fragment(items: List[TaskItem], stats: TaskStats, csrf_token: Text, flash_msg: Text, is_error: Boolean) -> Text:
    var out: Text = "<section id=\"task-board\">\n"
    if text_length(flash_msg) > 0:
        var alert_cls: Text = "yz-alert yz-alert-ok"
        if is_error: set alert_cls = "yz-alert"
        set out = out + "  <div class=\"" + alert_cls + "\" role=\"status\">" + view_escape(flash_msg) + "</div>\n"

    # KPI Cards
    set out = out + "  <div class=\"yz-metrics\">\n"
    set out = out + "    <article class=\"yz-card\"><div class=\"yz-metric-label\">Total Tasks</div><div class=\"yz-metric-val\">" + number_text(stats.total) + "</div></article>\n"
    set out = out + "    <article class=\"yz-card\"><div class=\"yz-metric-label\">Open</div><div class=\"yz-metric-val\">" + number_text(stats.open_count) + "</div></article>\n"
    set out = out + "    <article class=\"yz-card\"><div class=\"yz-metric-label\">Completed</div><div class=\"yz-metric-val\">" + number_text(stats.done_count) + "</div></article>\n"
    set out = out + "  </div>\n"

    # Create Task Form (Works both with yaza-live.js fragment swap AND plain HTML POST without JS)
    set out = out + "  <div class=\"yz-card\">\n"
    set out = out + "    <form class=\"yz-form-row\" method=\"POST\" action=\"/tasks\" data-yaza-target=\"#task-board\">\n"
    set out = out + "      " + view_csrf_input(csrf_token) + "\n"
    set out = out + "      <input class=\"yz-input\" type=\"text\" name=\"title\" placeholder=\"Add a new task (persisted in YazaBase SQL)...\" required minlength=\"2\" maxlength=\"140\">\n"
    set out = out + "      <select class=\"yz-select\" name=\"priority\"><option value=\"normal\">Normal</option><option value=\"high\">High priority</option></select>\n"
    set out = out + "      <button class=\"yz-btn yz-btn-primary\" type=\"submit\">+ Add Task</button>\n"
    set out = out + "    </form>\n"

    # Task Table
    set out = out + "    <div class=\"yz-table-wrap\">\n"
    set out = out + "      <table class=\"yz-table\">\n"
    set out = out + "        <thead><tr><th>ID</th><th>Task</th><th>Priority</th><th>Status</th><th>Owner</th><th>Actions</th></tr></thead>\n"
    set out = out + "        <tbody>\n"
    if list_count(items) == 0:
        set out = out + "          <tr><td colspan=\"6\">No tasks yet. Create your first task above.</td></tr>\n"
    else:
        var i: Number = 0
        while i < list_count(items):
            set out = out + "          " + render_task_row(list_get(items, i), csrf_token)
            set i = i + 1
    set out = out + "        </tbody>\n      </table>\n    </div>\n  </div>\n</section>"
    return out
