# Reusable Compiled SSR Component: #task-board (Full Page & Hypermedia Fragment Swappable).
use "std/web/view"
use "../../models/task"

view render_task_row(item: TaskItem, csrf_token: Text):
    var status_cls: Text = "yz-badge yz-badge-open"
    var toggle_label: Text = "Mark Done"
    if item.status == "done":
        set status_cls = "yz-badge yz-badge-done"
        set toggle_label = "Reopen"
    var prio_cls: Text = "yz-badge yz-badge-normal"
    if item.priority == "high":
        set prio_cls = "yz-badge yz-badge-high"
    <tr>
      <td><code>{{ item.id }}</code></td>
      <td><strong>{{ item.title }}</strong></td>
      <td><span class="{{ prio_cls }}">{{ item.priority }}</span></td>
      <td><span class="{{ status_cls }}">{{ item.status }}</span></td>
      <td>{{ item.owner }}</td>
      <td class="yz-inline-actions">
        <form method="POST" action="/tasks/{{ item.id }}/toggle" data-yaza-target="#task-board">{! view_csrf_input(csrf_token) !}<button class="yz-btn yz-btn-sm" type="submit">{{ toggle_label }}</button></form>
        <form method="POST" action="/tasks/{{ item.id }}/delete" data-yaza-target="#task-board">{! view_csrf_input(csrf_token) !}<button class="yz-btn yz-btn-sm yz-btn-danger" type="submit">Delete</button></form>
      </td>
    </tr>

view render_task_board_fragment(items: List[TaskItem], stats: TaskStats, csrf_token: Text, flash_msg: Text, is_error: Boolean):
    <section id="task-board">
      if text_length(flash_msg) > 0:
          var alert_cls: Text = "yz-alert yz-alert-ok"
          if is_error:
              set alert_cls = "yz-alert"
          <div class="{{ alert_cls }}" role="status">{{ flash_msg }}</div>
      <div class="yz-metrics">
        <article class="yz-metric-card"><div class="yz-metric-label">Total Tasks</div><div class="yz-metric-val">{{ number_text(stats.total) }}</div></article>
        <article class="yz-metric-card is-mint"><div class="yz-metric-label">Open</div><div class="yz-metric-val">{{ number_text(stats.open_count) }}</div></article>
        <article class="yz-metric-card is-lime"><div class="yz-metric-label">Completed</div><div class="yz-metric-val">{{ number_text(stats.done_count) }}</div></article>
      </div>
      <div class="yz-card">
        <form class="yz-form-row" method="POST" action="/tasks" data-yaza-target="#task-board">
          {! view_csrf_input(csrf_token) !}
          <input class="yz-input" type="text" name="title" placeholder="Add a new task (persisted in YazaBase SQL)..." required minlength="2" maxlength="140">
          <select class="yz-select" name="priority"><option value="normal">Normal</option><option value="high">High priority</option></select>
          <button class="yz-btn yz-btn-primary" type="submit">+ Add Task</button>
        </form>
        <div class="yz-table-wrap">
          <table class="yz-table">
            <thead><tr><th>ID</th><th>Task</th><th>Priority</th><th>Status</th><th>Owner</th><th>Actions</th></tr></thead>
            <tbody>
              if list_count(items) == 0:
                  <tr><td colspan="6">No tasks yet. Create your first task above.</td></tr>
              else:
                  var i: Number = 0
                  while i < list_count(items):
                      {! render_task_row(list_get(items, i), csrf_token) !}
                      set i = i + 1
            </tbody>
          </table>
        </div>
      </div>
    </section>
