# Add application job kinds here. Workers invoke only registered handlers;
# payloads are data and are never interpreted as code or shell commands.
use "std/fs"
use "std/crypto/hash"
use "../models/background_job_repository"

fn background_job_close(handle: Number) -> Number:
    let _closed: Result[Boolean, Text] = close(handle)
    return 0

fn background_job_handle(job: BackgroundJob) -> Result[Text, Text]:
    if job.kind == "echo": return ok(job.payload)
    if job.kind == "sha256_file":
        if text_length(job.payload) < 1 or text_length(job.payload) > 120:
            return err("file job name must contain 1-120 bytes")
        let root: Number = root_open(task_db_dir() + "/job_files")?
        defer background_job_close(root)
        # open_read accepts a single child name and rejects path traversal.
        let file: Number = open_read(root, job.payload)?
        defer background_job_close(file)
        let size: Number = file_size(file)?
        if size < 0 or size > 1048576: return err("file job input exceeds 1 MiB")
        var data: Bytes = bytes_empty()
        if size > 0: set data = read_exact(file, 0, size)?
        return ok(crypto_bytes_to_hex(crypto_sha256(data)))
    return err("background job kind has no registered handler")
