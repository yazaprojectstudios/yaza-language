use "std/db/migrations"

fn app_migrations() -> List[DbMigration]:
    let migrations: List[DbMigration] = List[DbMigration]()
    list_push(migrations, DbMigration(1, "CREATE TABLE mail_jobs (id BIGINT PRIMARY KEY, to_address TEXT NOT NULL, subject TEXT NOT NULL, body TEXT NOT NULL, status TEXT NOT NULL, attempts BIGINT NOT NULL, next_attempt_ms BIGINT NOT NULL)", "DROP TABLE mail_jobs"))
    list_push(migrations, DbMigration(2, "CREATE TABLE account_action_tokens (id BIGINT PRIMARY KEY, kind TEXT NOT NULL, subject TEXT NOT NULL, digest TEXT NOT NULL, status TEXT NOT NULL, expires_ms BIGINT NOT NULL)", "DROP TABLE account_action_tokens"))
    list_push(migrations, DbMigration(3, "CREATE TABLE admin_email_verification (id BIGINT PRIMARY KEY, email TEXT NOT NULL, verified_at_ms BIGINT NOT NULL)", "DROP TABLE admin_email_verification"))
    list_push(migrations, DbMigration(4, "CREATE TABLE background_jobs (id BIGINT PRIMARY KEY, kind TEXT NOT NULL, payload TEXT NOT NULL, status TEXT NOT NULL, attempts BIGINT NOT NULL, next_attempt_ms BIGINT NOT NULL, result_text TEXT NOT NULL, last_error TEXT NOT NULL)", "DROP TABLE background_jobs"))
    return migrations
