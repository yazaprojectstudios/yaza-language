# Business Logic Layer: TaskService (Pure domain operations, zero HTML/HTTP dependency).
use "../models/task"
use "../models/task_repository"

fn task_service_ping() -> Result[Boolean, Text]:
    return task_repository_ping()

fn task_service_list() -> Result[List[TaskItem], Text]:
    return task_repository_list()

fn task_service_compute_stats(items: List[TaskItem]) -> TaskStats:
    let total: Number = list_count(items)
    var open_c: Number = 0
    var done_c: Number = 0
    var i: Number = 0
    while i < total:
        let it: TaskItem = list_get(items, i)
        if it.status == "done":
            set done_c = done_c + 1
        else:
            set open_c = open_c + 1
        set i = i + 1
    return TaskStats(total, open_c, done_c)

fn task_service_create(title: Text, owner: Text, priority: Text) -> Result[TaskItem, Text]:
    if not task_is_valid_title(title):
        return err("Title must be between 2 and 140 characters.")
    return task_repository_create(title, owner, priority)

fn task_service_toggle(task_id: Text) -> Result[Boolean, Text]:
    let found_opt: Option[TaskItem] = task_repository_find(task_id)?
    if not option_is_some(found_opt):
        return err("Task not found")
    let cur: TaskItem = option_unwrap(found_opt)
    var next_status: Text = "done"
    if cur.status == "done":
        set next_status = "open"
    return task_repository_set_status(task_id, next_status)

fn task_service_delete(task_id: Text) -> Result[Boolean, Text]:
    return task_repository_delete(task_id)
