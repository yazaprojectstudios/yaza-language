# Optional MVC mail service. A local MTA owns outbound delivery and TLS.
use "std/smtp"
use "std/env"
use "../models/mail_job_repository"

fn mail_service_enqueue(to_address: Text, subject: Text, body: Text) -> Result[Number, Text]:
    return mail_job_enqueue(to_address, subject, body)

fn mail_service_send(to_address: Text, subject: Text, body: Text) -> Result[Boolean, Text]:
    let from_address: Text = env_try_get("YAZA_MAIL_FROM")?
    let provider: Text = env_get_or_default("YAZA_MAIL_PROVIDER", "local")
    let message: SmtpMessage = SmtpMessage(from_address, to_address, subject, body)
    if provider == "google" or provider == "brevo":
        let username: Text = env_try_get("YAZA_MAIL_USERNAME")?
        let credential: Text = env_try_get("YAZA_MAIL_CREDENTIAL")?
        let auth_mode: Text = env_get_or_default("YAZA_MAIL_AUTH_MODE", "password")
        return smtp_send_secure(provider, auth_mode, username, credential, message, 10000)
    if provider != "local": return err("YAZA_MAIL_PROVIDER must be local, google, or brevo")
    let port_text: Text = env_get_or_default("YAZA_MAIL_RELAY_PORT", "25")
    let port: Number = number_try_parse(port_text)?
    return smtp_send_local(port, message, 5000)
