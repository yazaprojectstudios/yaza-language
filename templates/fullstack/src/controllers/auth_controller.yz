# Auth Controller: Login (YazaBase Argon2id), Signed Session Cookie Issuance & CSRF Logout.
use "std/web/request"
use "std/web/response"
use "std/web/form"
use "../middleware/web_security"
use "../views/pages/login_page"

fn auth_controller_login_form(req: WebRequest) -> WebResponse:
    let sess: WebSession = web_current_session(req)
    if sess.authenticated:
        return web_redirect_see_other("/dashboard")
    return web_html_ok(render_login_page(""))

fn auth_controller_login_submit(req: WebRequest) -> WebResponse:
    let form_res: Result[List[FormField], Text] = form_parse_urlencoded(req.http.body_text, 16)
    if not result_is_ok(form_res):
        return web_html_status(400, "Bad Request", render_login_page("Malformed login form submission."))
    let fields: List[FormField] = result_unwrap(form_res)
    let username: Text = text_trim(form_get_or(fields, "username", ""))
    let password: Text = form_get_or(fields, "password", "")
    if not web_login_limiter_take(username):
        return web_html_status(429, "Too Many Requests", render_login_page("Too many login attempts. Try again later."))
    if not web_authenticate_credentials(username, password):
        return web_html_status(401, "Unauthorized", render_login_page("Invalid username or password."))
    let _cleared: Boolean = web_login_limiter_clear(username)
    let cookie_hdr: Text = web_issue_session_cookie(username, "admin")
    return web_with_cookie(web_redirect_see_other("/dashboard"), cookie_hdr)

fn auth_controller_logout(req: WebRequest) -> WebResponse:
    let sess: WebSession = web_current_session(req)
    if not sess.authenticated:
        return web_redirect_see_other("/login")
    let form_res: Result[List[FormField], Text] = form_parse_urlencoded(req.http.body_text, 16)
    var fields: List[FormField] = List[FormField]()
    if result_is_ok(form_res):
        set fields = result_unwrap(form_res)
    if not web_verify_request_csrf(req, sess, fields):
        return web_html_status(403, "Forbidden", render_login_page("CSRF verification failed."))
    return web_with_cookie(web_redirect_see_other("/login"), web_clear_session_cookie())
