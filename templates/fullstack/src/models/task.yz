# Domain Model: TaskItem entity, statistics, validation & JSON serialization.
use "std/json"

shape TaskItem:
    id: Text
    title: Text
    owner: Text
    priority: Text
    status: Text
    created_at: Text

shape TaskStats:
    total: Number
    open_count: Number
    done_count: Number

fn task_normalize_priority(raw: Text) -> Text:
    let clean: Text = text_trim(raw)
    if clean == "high" or clean == "HIGH":
        return "high"
    return "normal"

fn task_is_valid_title(title: Text) -> Boolean:
    let clean: Text = text_trim(title)
    let len: Number = text_length(clean)
    return len >= 2 and len <= 140

fn task_to_json(t: TaskItem) -> Text:
    return "{\"id\":\"" + json_escape_text(t.id) + "\",\"title\":\"" + json_escape_text(t.title) + "\",\"owner\":\"" + json_escape_text(t.owner) + "\",\"priority\":\"" + json_escape_text(t.priority) + "\",\"status\":\"" + json_escape_text(t.status) + "\",\"created_at\":\"" + json_escape_text(t.created_at) + "\"}"

fn task_list_to_json(items: List[TaskItem]) -> Text:
    var out: Text = "["
    var i: Number = 0
    while i < list_count(items):
        if i > 0:
            set out = out + ","
        set out = out + task_to_json(list_get(items, i))
        set i = i + 1
    return out + "]"
