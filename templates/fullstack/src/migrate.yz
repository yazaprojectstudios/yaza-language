use "std/db/yazabase"
use "std/db/migrations"
use "migrations/registry"
use "models/task_repository"

fn migrate_run(command: Text) -> Result[Number, Text]:
    let conn: YazaBaseConnection = yazabase_connect_default(task_db_dir(), "monolith")?
    if command == "up": return db_migration_apply_all(conn, app_migrations())
    if command == "down": return db_migration_rollback_last(conn, app_migrations())
    return err("usage: migrate up|down")

start:
    let outcome: Result[Number, Text] = migrate_run(arg(1))
    if not result_is_ok(outcome):
        say "migration: " + result_unwrap_error(outcome)
        exit(1)
    say "migrations changed: " + number_text(result_unwrap(outcome))
