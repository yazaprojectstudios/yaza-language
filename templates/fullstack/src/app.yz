# Application Router: Unifies Static Assets, Web MVC SSR, Hypermedia Fragments, JSON API & K8s Probes.
use "std/http"
use "std/sync"
use "std/web/request"
use "std/web/response"
use "std/web/static"
use "services/task_service"
use "controllers/auth_controller"
use "controllers/task_controller"

fn extract_task_action_id(path: Text, suffix: Text) -> Text:
    if not text_starts_with(path, "/tasks/") or not text_ends_with(path, suffix):
        return ""
    let start: Number = 7
    let end: Number = text_length(path) - text_length(suffix)
    if end <= start:
        return ""
    return text_slice(path, start, end - start)

fn app_dispatch_request(req: WebRequest, public_dir: Text, profile_label: Text, m_total: AtomicNumber, m_errors: AtomicNumber) -> WebResponse:
    let _inc: AtomicNumber = atomic_add(m_total, 1)
    let method: Text = req.http.method
    let path: Text = req.http.path

    # 1. Operational Probes & Telemetry
    if path == "/healthz" or path == "/livez":
        return web_from_http_response(http_response_ok_json("{\"status\":\"ok\",\"service\":\"{{project_name}}\",\"mode\":\"fullstack-mvc\"}"))
    if path == "/readyz":
        let ping: Result[Boolean, Text] = task_service_ping()
        if not result_is_ok(ping):
            let _e: AtomicNumber = atomic_add(m_errors, 1)
            return web_from_http_response(http_response_service_unavailable("yazabase database is not ready", true))
        return web_from_http_response(http_response_ok_json("{\"status\":\"ready\",\"database\":\"yazabase\"}"))
    if path == "/metrics":
        let tot: Number = atomic_load(m_total)
        let errs: Number = atomic_load(m_errors)
        var prom: Text = "# HELP yaza_http_requests_total Total HTTP requests handled\n"
        set prom = prom + "# TYPE yaza_http_requests_total counter\n"
        set prom = prom + "yaza_http_requests_total " + number_text(tot) + "\n"
        set prom = prom + "# HELP yaza_http_errors_total Total 5xx or readiness errors\n"
        set prom = prom + "# TYPE yaza_http_errors_total counter\n"
        set prom = prom + "yaza_http_errors_total " + number_text(errs) + "\n"
        return web_from_http_response(HttpResponse(200, "OK", "text/plain; version=0.0.4", bytes_from_text(prom)))

    # 2. Confined Static Assets (/public/*)
    if text_starts_with(path, "/public/"):
        if method != "GET" and method != "HEAD":
            return web_from_http_response(http_response_method_not_allowed("method not allowed", true))
        let st_res: Result[WebResponse, Text] = static_serve_public_dir(public_dir, path, "/public/", req.if_none_match, 4194304)
        if result_is_ok(st_res):
            return result_unwrap(st_res)
        return web_html_status(404, "Not Found", "<h1>404 Asset Not Found</h1>")

    # 3. Authentication Routes
    if path == "/login":
        if method == "GET": return auth_controller_login_form(req)
        if method == "POST": return auth_controller_login_submit(req)
        return web_html_status(405, "Method Not Allowed", "<h1>405 Method Not Allowed</h1>")
    if path == "/logout" and method == "POST":
        return auth_controller_logout(req)

    # 4. Tri-Mode MVC & JSON API Routes
    if path == "/" or path == "/tasks" or path == "/api/v1/tasks":
        if method == "GET" or method == "HEAD":
            return task_controller_index(req, profile_label)
        if method == "POST" and (path == "/tasks" or path == "/api/v1/tasks"):
            return task_controller_create(req, profile_label)
        return web_html_status(405, "Method Not Allowed", "<h1>405 Method Not Allowed</h1>")

    let toggle_id: Text = extract_task_action_id(path, "/toggle")
    if text_length(toggle_id) > 0 and method == "POST":
        return task_controller_toggle(req, toggle_id, profile_label)

    let delete_id: Text = extract_task_action_id(path, "/delete")
    if text_length(delete_id) > 0 and method == "POST":
        return task_controller_delete(req, delete_id, profile_label)

    if web_request_wants_json(req):
        return web_from_http_response(http_response_not_found("route not found", true))
    return web_html_status(404, "Not Found", "<h1>404 Page Not Found</h1>")
