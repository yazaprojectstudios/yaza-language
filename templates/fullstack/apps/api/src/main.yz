# Monolith API Application ({{project_name}}) backed by YazaBase + Async/Await.
use "std/db/yazabase"

async fn init_monolith_db_async() -> Result[YazaBaseConnection, Text]:
    return yazabase_connect_default("./data", "monolith")

start:
    let conn_task: Task[Result[YazaBaseConnection, Text]] = spawn init_monolith_db_async()
    let conn_res: Result[YazaBaseConnection, Text] = await conn_task
    if result_is_ok(conn_res):
        let conn: YazaBaseConnection = result_unwrap(conn_res)
        say "YAZA Monolith API starter: {{project_name}} (YazaBase connected as " + conn.username + ")"
    else:
        say "YAZA Monolith API error: " + result_unwrap_error(conn_res)
