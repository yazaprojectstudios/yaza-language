# Copy to your shell environment or secret manager (never commit secrets).
YAZA_ENV=development
YAZA_AUTH_SECRET=change_me_run_yaza_secret_token_min_32_chars
YAZABASE_USER=admin
YAZABASE_PASSWORD=change_me_16_plus_char_password
YAZABASE_DATA_DIR=./data
YAZA_ADMIN_EMAIL=admin@example.com
YAZA_PUBLIC_BASE_URL=http://127.0.0.1:8080
# Provision once with admin-setup, then remove these from the running server environment:
# YAZA_WEB_ADMIN_USER=admin
# YAZA_WEB_ADMIN_PASSWORD=DifferentWebPassword_2026
# Optional mail service: configure a trusted SMTP relay bound to 127.0.0.1.
YAZA_MAIL_PROVIDER=local
YAZA_MAIL_FROM=notifications@example.com
YAZA_MAIL_RELAY_PORT=1025
# For YAZA_MAIL_PROVIDER=google or brevo, set these in a secret manager:
# YAZA_MAIL_USERNAME=your-smtp-login
# YAZA_MAIL_CREDENTIAL=your-oauth-token-app-password-or-brevo-smtp-key
# YAZA_MAIL_AUTH_MODE=password  # google also accepts oauth2
# Supply these from a secret manager in production; never commit real values.
