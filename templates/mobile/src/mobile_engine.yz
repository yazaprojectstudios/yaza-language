use "std/db/yazabase_mobile_kv"

fn mobile_reduce_load(storage_dir: Text, fallback_state: Text) -> Text:
    if storage_dir == "": return fallback_state
    let loaded: Result[Text, Text] = yaza_db_embedded_kv_load_v1(storage_dir, "mobile_state.ydb", "counter")
    if result_is_ok(loaded): return result_unwrap(loaded)
    return fallback_state

fn mobile_reduce_persist(storage_dir: Text, next_state: Text) -> Result[Text, Text]:
    if storage_dir != "":
        let _saved: Boolean = yaza_db_embedded_kv_store_v1(storage_dir, "mobile_state.ydb", "counter", next_state)?
    return ok(next_state)

# Export this reducer with: yaza emit-llvm-module --export-request mobile_reduce.
fn mobile_reduce(event: Text, payload: Text, current_state: Text) -> Result[Text, Text]:
    let storage_dir: Text = env_get("YAZA_MOBILE_STORAGE_DIR")
    if event == "snapshot":
        return ok(mobile_reduce_load(storage_dir, current_state))
    if event == "reset":
        return mobile_reduce_persist(storage_dir, "0")
    if event == "increment":
        var step: Number = 1
        if payload != "":
            set step = number_try_parse(payload)?
        if step < 1 or step > 1000:
            return err("increment step must be between 1 and 1000")
        let base_state: Text = mobile_reduce_load(storage_dir, current_state)
        let current: Number = number_try_parse(base_state)?
        if current < 0 or current > 9000000000000000000 - step:
            return err("counter is outside the supported range")
        let next_state: Text = number_try_text(current + step)?
        return mobile_reduce_persist(storage_dir, next_state)
    return err("unknown mobile event")

start:
    say "YAZA mobile reducer module"
