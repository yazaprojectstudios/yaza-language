# C ABI Entry Point (--export-request mobile_reduce)
use "state/app_state"
use "state/codec"
use "actions/home_actions"
use "domain/greeting"

fn mobile_reduce(event: Text, payload: Text, current_state: Bytes) -> Result[Bytes, Text]:
    let storage_dir: Text = env_get("YAZA_MOBILE_STORAGE_DIR")
    if event == "action":
        let state: AppState = codec_decode_state(current_state)
        return home_handle_action(state, payload, storage_dir)

    if event == "snapshot":
        let cur: Number = home_load_persisted_counter(storage_dir, codec_counter_from_state(current_state))
        let txt: Text = number_try_text(cur)?
        return bytes_try_from_text(txt)

    if event == "reset":
        let _saved: Boolean = home_persist_counter(storage_dir, 0)?
        return bytes_try_from_text("0")

    if event == "increment":
        let step: Number = domain_validate_step(payload)?
        let cur: Number = home_load_persisted_counter(storage_dir, codec_counter_from_state(current_state))
        let next_val: Number = domain_next_counter(cur, step)?
        let _saved: Boolean = home_persist_counter(storage_dir, next_val)?
        let txt: Text = number_try_text(next_val)?
        return bytes_try_from_text(txt)

    return err("unknown mobile event")

start:
    say "YAZA mobile MVI reducer module"
