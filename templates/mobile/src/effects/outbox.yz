# Declarative Outbox Effects emitted by the pure YAZA reducer for platform execution.

fn outbox_kv_save(key: Text, value: Text) -> Result[Text, Text]:
    let p1: Text = text_try_concat("KV_SAVE|", key)?
    let p2: Text = text_try_concat(p1, "|")?
    return text_try_concat(p2, value)

fn outbox_toast(message: Text) -> Result[Text, Text]:
    return text_try_concat("TOAST|", message)

fn outbox_http_get(req_id: Text, url: Text) -> Result[Text, Text]:
    let p1: Text = text_try_concat("HTTP|GET|", req_id)?
    let p2: Text = text_try_concat(p1, "|")?
    return text_try_concat(p2, url)

fn outbox_append(existing: Text, effect: Text) -> Result[Text, Text]:
    if effect == "": return ok(existing)
    if existing == "": return ok(effect)
    let joined: Text = text_try_concat(existing, "\n")?
    return text_try_concat(joined, effect)
