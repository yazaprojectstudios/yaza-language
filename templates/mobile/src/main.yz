# CLI preview of the same reducer used by the Android/iOS native bridge.
fn mobile_reduce_preview(event: Text, payload: Text, current_state: Text) -> Result[Text, Text]:
    if event == "snapshot": return ok(current_state)
    if event == "reset": return ok("0")
    if event == "increment":
        var step: Number = 1
        if payload != "": set step = number_try_parse(payload)?
        if step < 1 or step > 1000: return err("increment step must be between 1 and 1000")
        let current: Number = number_try_parse(current_state)?
        if current < 0 or current > 9000000000000000000 - step: return err("counter is outside the supported range")
        return number_try_text(current + step)
    return err("unknown mobile event")

start:
    let state: Result[Text, Text] = mobile_reduce_preview("increment", "1", "0")
    if result_is_ok(state):
        say "YAZA mobile engine preview · counter=" + result_unwrap(state)
    else:
        say "YAZA mobile engine preview failed: " + result_unwrap_error(state)
