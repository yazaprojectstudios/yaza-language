# Desktop CLI smoke-test & verifier for the YAZA Mobile MVI + YBIF core.
use "std/ybif"
use "state/app_state"
use "state/codec"
use "actions/home_actions"
use "domain/greeting"

start:
    let s0: AppState = codec_decode_state(bytes_from_text("0"))
    let r_init: Result[Bytes, Text] = home_handle_action(s0, "INIT", "")
    if not result_is_ok(r_init):
        fail("INIT failed: " + result_unwrap_error(r_init))
    let b_init: Bytes = result_unwrap(r_init)
    if not ybif_try_is_valid_header(b_init):
        fail("INIT did not return valid YBIF frame")
    let st_init: AppState = codec_decode_state(b_init)

    let r_greet: Result[Bytes, Text] = home_handle_action(st_init, "GREET|Developer", "")
    if not result_is_ok(r_greet):
        fail("GREET failed: " + result_unwrap_error(r_greet))
    let st_greet: AppState = codec_decode_state(result_unwrap(r_greet))

    let r_inc: Result[Bytes, Text] = home_handle_action(st_greet, "INCREMENT|5", "")
    if not result_is_ok(r_inc):
        fail("INCREMENT failed: " + result_unwrap_error(r_inc))
    let st_inc: AppState = codec_decode_state(result_unwrap(r_inc))

    let r_persist: Result[Bytes, Text] = home_handle_action(st_inc, "PERSIST", "")
    if not result_is_ok(r_persist):
        fail("PERSIST failed: " + result_unwrap_error(r_persist))
    let st_persist: AppState = codec_decode_state(result_unwrap(r_persist))

    let r_reset: Result[Bytes, Text] = home_handle_action(st_persist, "RESET", "")
    if not result_is_ok(r_reset):
        fail("RESET failed: " + result_unwrap_error(r_reset))
    let st_reset: AppState = codec_decode_state(result_unwrap(r_reset))

    let step_res: Result[Number, Text] = domain_validate_step("3")
    if not result_is_ok(step_res) or result_unwrap(step_res) != 3:
        fail("domain_validate_step failed")

    say st_init.title + " | counter_after_inc=" + number_text(st_inc.counter) + " | reset=" + number_text(st_reset.counter) + " | greeting=" + st_greet.greeting
