# Action Handlers (MVI Reducer Branching): INIT, GREET, INCREMENT, PERSIST, RESET
use "std/db/yazabase_mobile_kv"
use "../state/app_state"
use "../state/codec"
use "../domain/greeting"
use "../effects/outbox"

fn home_load_persisted_counter(storage_dir: Text, fallback: Number) -> Number:
    if storage_dir == "": return fallback
    let loaded: Result[Text, Text] = yaza_db_embedded_kv_load_v1(storage_dir, "mobile_state.ydb", "counter")
    if not result_is_ok(loaded): return fallback
    let parsed: Result[Number, Text] = number_try_parse(result_unwrap(loaded))
    if result_is_ok(parsed): return result_unwrap(parsed)
    return fallback

fn home_persist_counter(storage_dir: Text, counter: Number) -> Result[Boolean, Text]:
    if storage_dir == "": return ok(false)
    let val_txt: Text = number_try_text(counter)?
    return yaza_db_embedded_kv_store_v1(storage_dir, "mobile_state.ydb", "counter", val_txt)

fn home_split_action_name(action_payload: Text) -> Result[Text, Text]:
    let sep: Number = text_find(action_payload, "|")
    if sep < 0: return ok(action_payload)
    return text_try_slice(action_payload, 0, sep)

fn home_split_action_arg(action_payload: Text) -> Result[Text, Text]:
    let sep: Number = text_find(action_payload, "|")
    if sep < 0: return ok("")
    let total: Number = text_length(action_payload)
    let rem: Number = total - (sep + 1)
    if rem <= 0: return ok("")
    return text_try_slice(action_payload, sep + 1, rem)

fn home_handle_action(current: AppState, action_payload: Text, storage_dir: Text) -> Result[Bytes, Text]:
    let raw_name: Text = home_split_action_name(action_payload)?
    var action_name: Text = raw_name
    if action_name == "": set action_name = "INIT"
    let action_arg: Text = home_split_action_arg(action_payload)?

    if action_name == "INIT":
        let cnt: Number = home_load_persisted_counter(storage_dir, current.counter)
        let fx: Text = outbox_toast("Welcome to YAZA Mobile")?
        let next_state: AppState = AppState("Welcome to YAZA Mobile", "Shared YAZA Core is ready.", cnt, "ready", fx)
        return codec_encode_ybif(next_state)

    if action_name == "GREET":
        let msg: Text = domain_build_greeting(action_arg)?
        let fx: Text = outbox_toast(msg)?
        let next_state: AppState = AppState("Welcome to YAZA Mobile", msg, current.counter, "greeted", fx)
        return codec_encode_ybif(next_state)

    if action_name == "INCREMENT":
        let step: Number = domain_validate_step(action_arg)?
        let base_cnt: Number = home_load_persisted_counter(storage_dir, current.counter)
        let next_cnt: Number = domain_next_counter(base_cnt, step)?
        let _saved: Boolean = home_persist_counter(storage_dir, next_cnt)?
        let cnt_txt: Text = number_try_text(next_cnt)?
        let fx_kv: Text = outbox_kv_save("counter", cnt_txt)?
        let g1: Text = text_try_concat("Counter updated to ", cnt_txt)?
        let fx_toast: Text = outbox_toast(g1)?
        let all_fx: Text = outbox_append(fx_kv, fx_toast)?
        let next_state: AppState = AppState("Welcome to YAZA Mobile", g1, next_cnt, "updated", all_fx)
        return codec_encode_ybif(next_state)

    if action_name == "RESET":
        let _saved: Boolean = home_persist_counter(storage_dir, 0)?
        let fx_kv: Text = outbox_kv_save("counter", "0")?
        let fx_toast: Text = outbox_toast("Counter reset to 0")?
        let all_fx: Text = outbox_append(fx_kv, fx_toast)?
        let next_state: AppState = AppState("Welcome to YAZA Mobile", "Counter reset to 0", 0, "reset", all_fx)
        return codec_encode_ybif(next_state)

    if action_name == "PERSIST":
        let _saved: Boolean = home_persist_counter(storage_dir, current.counter)?
        let cnt_txt: Text = number_try_text(current.counter)?
        let fx_kv: Text = outbox_kv_save("counter", cnt_txt)?
        let g1: Text = text_try_concat("State saved: counter=", cnt_txt)?
        let fx_toast: Text = outbox_toast(g1)?
        let all_fx: Text = outbox_append(fx_kv, fx_toast)?
        let next_state: AppState = AppState("Welcome to YAZA Mobile", g1, current.counter, "persisted", all_fx)
        return codec_encode_ybif(next_state)

    return err("unknown mobile action")
