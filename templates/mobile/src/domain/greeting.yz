# Pure Business Logic & Input Validation for YAZA Mobile (Fallible Core safe).

fn domain_build_greeting(raw_name: Text) -> Result[Text, Text]:
    let clean: Text = text_try_trim(raw_name)?
    let n: Number = text_length(clean)
    if n < 1:
        return err("name cannot be empty")
    if n > 80:
        return err("name must be at most 80 characters")
    let p1: Text = text_try_concat("Hello, ", clean)?
    return text_try_concat(p1, "! Welcome to YAZA Mobile.")

fn domain_validate_step(raw_step: Text) -> Result[Number, Text]:
    if raw_step == "":
        return ok(1)
    let parsed: Number = number_try_parse(raw_step)?
    if parsed < 1 or parsed > 1000:
        return err("increment step must be between 1 and 1000")
    return ok(parsed)

fn domain_next_counter(current: Number, step: Number) -> Result[Number, Text]:
    if current < 0 or current > 9000000000000000000 - step:
        return err("counter is outside the supported range")
    return ok(current + step)
