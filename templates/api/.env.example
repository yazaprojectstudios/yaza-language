# Configure these credentials explicitly before starting the service.
YAZABASE_DIR=./data
YAZABASE_DB={{project_name}}
YAZABASE_USER=
YAZABASE_PASSWORD=

# Auth & Token Secrets (Generate dengan: yaza secret token)
YAZA_API_TOKEN=
YAZA_YWT_SECRET=dev_ywt_secret_change_in_production_32b
YAZA_JWT_SECRET=dev_jwt_secret_change_in_production_32b
YAZA_JWT_ISSUER={{project_name}}
YAZA_JWT_AUDIENCE={{project_name}}-clients

# Child processes disabled by default (fail-closed)
YAZA_API_ALLOW_PROCESS=false
YAZA_API_ALLOWED_PROCESSES=
