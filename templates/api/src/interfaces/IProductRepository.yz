interface IProductRepository:
    method list(limit: Number, offset: Number) -> Result[List[ProductRecord], ApiError]
    method find(id: Text) -> Result[ProductRecord, ApiError]
    method create(input: ProductInput) -> Result[ProductRecord, ApiError]
    method replace(input: ProductInput) -> Result[ProductRecord, ApiError]
    method patch(input: ProductInput) -> Result[ProductRecord, ApiError]
    method delete(id: Text) -> Result[ProductDeleteOutcome, ApiError]
