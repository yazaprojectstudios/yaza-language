# Product catalog CRUD routes.
# Middleware & RBAC enforcement is wired in controllers/ProductController.yz via std/middleware (YWT & JWT HS256):
#   GET    /api/products        -> roles: admin, editor, viewer
#   GET    /api/products/{id}   -> roles: admin, editor, viewer
#   POST   /api/products        -> roles: admin, editor
#   PUT    /api/products/{id}   -> roles: admin, editor
#   PATCH  /api/products/{id}   -> roles: admin, editor
#   DELETE /api/products/{id}   -> role:  admin
group "/api/products":
    route GET "/" => async controller ProductListController.product_controller_list
    route GET "/{id}" => async controller ProductReadController.product_controller_find
    route POST "/" => async controller ProductController.product_controller_create
    route PUT "/{id}" => async controller ProductController.product_controller_replace
    route PATCH "/{id}" => async controller ProductController.product_controller_patch
    route DELETE "/{id}" status 204 => async controller ProductReadController.product_controller_delete
