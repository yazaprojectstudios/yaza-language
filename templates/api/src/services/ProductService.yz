# Product Application Service: input validation + async delegation to ProductRepository.

use "../repositories/ProductRepository"

fn product_validate_write_input(input: ProductInput, require_name_and_price: Boolean) -> Result[Boolean, ApiError]:
    if require_name_and_price:
        if not option_is_some(input.name) or text_trim(option_unwrap(input.name)) == "":
            return err(ApiError::InvalidInput("name"))
        if not option_is_some(input.priceMinor) or option_unwrap(input.priceMinor) < 0:
            return err(ApiError::InvalidInput("priceMinor"))
    else:
        if option_is_some(input.name) and text_trim(option_unwrap(input.name)) == "":
            return err(ApiError::InvalidInput("name"))
        if option_is_some(input.priceMinor) and option_unwrap(input.priceMinor) < 0:
            return err(ApiError::InvalidInput("priceMinor"))
    return ok(true)

fn product_service_list(limit: Number, offset: Number) -> Result[List[ProductRecord], ApiError]:
    return product_repository_list(limit, offset)

fn product_service_find(id: Text) -> Result[ProductRecord, ApiError]:
    if text_trim(id) == "":
        return err(ApiError::InvalidInput("id"))
    return product_repository_find(id)

fn product_service_create(input: ProductInput) -> Result[ProductRecord, ApiError]:
    let _valid: Boolean = product_validate_write_input(input, true)?
    return product_repository_create(input)

fn product_service_replace(input: ProductInput) -> Result[ProductRecord, ApiError]:
    let _valid: Boolean = product_validate_write_input(input, true)?
    return product_repository_replace(input)

fn product_service_patch(input: ProductInput) -> Result[ProductRecord, ApiError]:
    let _valid: Boolean = product_validate_write_input(input, false)?
    return product_repository_patch(input)

fn product_service_delete(id: Text) -> Result[ProductDeleteOutcome, ApiError]:
    if text_trim(id) == "":
        return err(ApiError::InvalidInput("id"))
    return product_repository_delete(id)

async fn product_service_list_async(limit: Number, offset: Number) -> Result[List[ProductRecord], ApiError]:
    let handle: Task[Result[List[ProductRecord], ApiError]] = spawn product_repository_list_async(limit, offset)
    return await handle

async fn product_service_find_async(id: Text) -> Result[ProductRecord, ApiError]:
    if text_trim(id) == "":
        return err(ApiError::InvalidInput("id"))
    let handle: Task[Result[ProductRecord, ApiError]] = spawn product_repository_find_async(id)
    return await handle

async fn product_service_create_async(input: ProductInput) -> Result[ProductRecord, ApiError]:
    let _valid: Boolean = product_validate_write_input(input, true)?
    let handle: Task[Result[ProductRecord, ApiError]] = spawn product_repository_create_async(input)
    return await handle

async fn product_service_replace_async(input: ProductInput) -> Result[ProductRecord, ApiError]:
    let _valid: Boolean = product_validate_write_input(input, true)?
    let handle: Task[Result[ProductRecord, ApiError]] = spawn product_repository_replace_async(input)
    return await handle

async fn product_service_patch_async(input: ProductInput) -> Result[ProductRecord, ApiError]:
    let _valid: Boolean = product_validate_write_input(input, false)?
    let handle: Task[Result[ProductRecord, ApiError]] = spawn product_repository_patch_async(input)
    return await handle

async fn product_service_delete_async(id: Text) -> Result[ProductDeleteOutcome, ApiError]:
    if text_trim(id) == "":
        return err(ApiError::InvalidInput("id"))
    let handle: Task[Result[ProductDeleteOutcome, ApiError]] = spawn product_repository_delete_async(id)
    return await handle
