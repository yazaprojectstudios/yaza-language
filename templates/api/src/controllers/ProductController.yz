# Product Controller: Complete 6-Route CRUD + Async/Await + Middleware + RBAC.

use "std/http"
use "std/json"
use "../services/ProductService"
use "../middleware/auth_middleware"

fn product_record_to_json(rec: ProductRecord) -> Text:
    let fields: List[Text] = List[Text]()
    list_push(fields, json_field("id", json_string(rec.id)))
    list_push(fields, json_field("name", json_string(rec.name)))
    list_push(fields, json_field("priceMinor", json_number(rec.priceMinor)))
    list_push(fields, json_field("currency", json_string(rec.currency)))
    list_push(fields, json_field("available", json_bool(rec.available)))
    return json_object(fields)

fn product_list_to_json(items: List[ProductRecord]) -> Text:
    let encoded: List[Text] = List[Text]()
    var i: Number = 0
    while i < list_count(items):
        list_push(encoded, product_record_to_json(list_get(items, i)))
        set i = i + 1
    return json_array(encoded)

fn product_error_to_http(err_val: ApiError) -> HttpResponse:
    match err_val:
        BadRequest:
            return http_response_bad_request("invalid product payload", true)
        InvalidInput(field):
            return http_response_bad_request("invalid field: " + field, true)
        ValidationFailed(errors):
            return http_response_bad_request("validation failed: " + text_join(errors, ", "), true)
        PayloadTooLarge:
            return http_response_payload_too_large("payload too large", true)
        UnsupportedMediaType:
            return http_response_bad_request("unsupported media type", true)
        Unauthorized:
            return http_response_unauthorized("database or request unauthorized", true)
        TokenExpired:
            return http_response_unauthorized("token expired", true)
        LockedOut:
            return http_response_unauthorized("account locked out", true)
        Forbidden:
            return http_response_forbidden("insufficient role permissions", true)
        NotFound:
            return http_response_not_found("product not found", true)
        Conflict:
            return http_response_bad_request("product conflict", true)
        AlreadyExists:
            return http_response_bad_request("product already exists", true)
        PreconditionFailed:
            return http_response_bad_request("precondition failed", true)
        PaymentRequired:
            return http_response_bad_request("payment required", true)
        RateLimited:
            return http_response_service_unavailable("rate limited", true)
        ExternalServiceError:
            return http_response_service_unavailable("external service error", true)
        Timeout:
            return http_response_service_unavailable("request timed out", true)
        Unavailable:
            return http_response_service_unavailable("storage unavailable", true)
        Internal:
            return http_response_internal_error("unexpected internal error", true)

fn product_controller_list(limit: Number, offset: Number) -> Result[List[ProductRecord], ApiError]:
    return product_service_list(limit, offset)

fn product_controller_find(id: Text) -> Result[ProductRecord, ApiError]:
    return product_service_find(id)

fn product_controller_create(input: ProductInput) -> Result[ProductRecord, ApiError]:
    return product_service_create(input)

fn product_controller_replace(id: Text, input: ProductInput) -> Result[ProductRecord, ApiError]:
    let scoped: ProductInput = ProductInput(some(id), input.name, input.priceMinor, input.currency, input.available)
    return product_service_replace(scoped)

fn product_controller_patch(id: Text, input: ProductInput) -> Result[ProductRecord, ApiError]:
    let scoped: ProductInput = ProductInput(some(id), input.name, input.priceMinor, input.currency, input.available)
    return product_service_patch(scoped)

fn product_controller_delete(id: Text) -> Result[ProductDeleteOutcome, ApiError]:
    return product_service_delete(id)

fn product_http_list_sync(req: HttpRequest, limit: Number, offset: Number) -> HttpResponse:
    let ctx: MiddlewareContext = api_middleware_pipeline_auth(req, "admin,editor,viewer")
    if ctx.rejected:
        return ctx.reject_response
    let res: Result[List[ProductRecord], ApiError] = product_service_list(limit, offset)
    if not result_is_ok(res):
        return product_error_to_http(result_unwrap_error(res))
    return http_response_ok_json(product_list_to_json(result_unwrap(res)))

fn product_http_find_sync(req: HttpRequest, id: Text) -> HttpResponse:
    let ctx: MiddlewareContext = api_middleware_pipeline_auth(req, "admin,editor,viewer")
    if ctx.rejected:
        return ctx.reject_response
    let res: Result[ProductRecord, ApiError] = product_service_find(id)
    if not result_is_ok(res):
        return product_error_to_http(result_unwrap_error(res))
    return http_response_ok_json(product_record_to_json(result_unwrap(res)))

fn product_http_create_sync(req: HttpRequest, input: ProductInput) -> HttpResponse:
    let ctx: MiddlewareContext = api_middleware_pipeline_auth(req, "admin,editor")
    if ctx.rejected:
        return ctx.reject_response
    let res: Result[ProductRecord, ApiError] = product_service_create(input)
    if not result_is_ok(res):
        return product_error_to_http(result_unwrap_error(res))
    return http_response_created_json(product_record_to_json(result_unwrap(res)))

fn product_http_replace_sync(req: HttpRequest, id: Text, input: ProductInput) -> HttpResponse:
    let ctx: MiddlewareContext = api_middleware_pipeline_auth(req, "admin,editor")
    if ctx.rejected:
        return ctx.reject_response
    let scoped: ProductInput = ProductInput(some(id), input.name, input.priceMinor, input.currency, input.available)
    let res: Result[ProductRecord, ApiError] = product_service_replace(scoped)
    if not result_is_ok(res):
        return product_error_to_http(result_unwrap_error(res))
    return http_response_ok_json(product_record_to_json(result_unwrap(res)))

fn product_http_patch_sync(req: HttpRequest, id: Text, input: ProductInput) -> HttpResponse:
    let ctx: MiddlewareContext = api_middleware_pipeline_auth(req, "admin,editor")
    if ctx.rejected:
        return ctx.reject_response
    let scoped: ProductInput = ProductInput(some(id), input.name, input.priceMinor, input.currency, input.available)
    let res: Result[ProductRecord, ApiError] = product_service_patch(scoped)
    if not result_is_ok(res):
        return product_error_to_http(result_unwrap_error(res))
    return http_response_ok_json(product_record_to_json(result_unwrap(res)))

fn product_http_delete_sync(req: HttpRequest, id: Text) -> HttpResponse:
    let ctx: MiddlewareContext = api_middleware_pipeline_auth(req, "admin")
    if ctx.rejected:
        return ctx.reject_response
    let res: Result[ProductDeleteOutcome, ApiError] = product_service_delete(id)
    if not result_is_ok(res):
        return product_error_to_http(result_unwrap_error(res))
    return http_response_no_content()

async fn product_http_list(req: HttpRequest, limit: Number, offset: Number) -> HttpResponse:
    return product_http_list_sync(req, limit, offset)

async fn product_http_find(req: HttpRequest, id: Text) -> HttpResponse:
    return product_http_find_sync(req, id)

async fn product_http_create(req: HttpRequest, input: ProductInput) -> HttpResponse:
    return product_http_create_sync(req, input)

async fn product_http_replace(req: HttpRequest, id: Text, input: ProductInput) -> HttpResponse:
    return product_http_replace_sync(req, id, input)

async fn product_http_patch(req: HttpRequest, id: Text, input: ProductInput) -> HttpResponse:
    return product_http_patch_sync(req, id, input)

async fn product_http_delete(req: HttpRequest, id: Text) -> HttpResponse:
    return product_http_delete_sync(req, id)
