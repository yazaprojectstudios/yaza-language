variant ApiError:
    # Client request and validation errors.
    BadRequest
    InvalidInput(field: Text)
    ValidationFailed(errors: TextList)
    PayloadTooLarge
    UnsupportedMediaType

    # Authentication and authorization errors.
    Unauthorized
    TokenExpired
    LockedOut
    Forbidden

    # Resource and business rule errors.
    NotFound
    Conflict
    AlreadyExists
    PreconditionFailed
    PaymentRequired

    # Infrastructure and external dependency errors.
    RateLimited
    ExternalServiceError
    Timeout
    Unavailable
    Internal
