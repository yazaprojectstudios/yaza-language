# Production HTTP API Server: {{project_name}}
# Features: Transactional YazaBase SQL Engine, Complete 6-Route CRUD, Multi-Chunk Body Framing,
# HTTP/1.1 Keep-Alive, Atomic Rate Limiting, Fail-Closed Auth Secret, Structured JSON Logs, & /metrics.
use "application"
use "std/net"
use "std/json"
use "std/sync"
use "std/log"
use "std/time"
use "std/config/api_config"

shape HttpReadOutcome:
    ok_read: Boolean
    raw: Bytes
    error_response: Option[HttpResponse]

fn parse_product_input_from_body(body_text: Text) -> ProductInput:
    let id_opt: Option[Text] = json_extract_string(body_text, "id")
    let name_opt: Option[Text] = json_extract_string(body_text, "name")
    let price_opt: Option[Number] = json_extract_number(body_text, "priceMinor")
    let curr_opt: Option[Text] = json_extract_string(body_text, "currency")
    var avail_opt: Option[Boolean] = none
    if text_find(body_text, "\"available\":true") >= 0 or text_find(body_text, "\"available\": true") >= 0:
        set avail_opt = some(true)
    elif text_find(body_text, "\"available\":false") >= 0 or text_find(body_text, "\"available\": false") >= 0:
        set avail_opt = some(false)
    return ProductInput(id_opt, name_opt, price_opt, curr_opt, avail_opt)

fn header_end_index(raw_text: Text) -> Number:
    let crlf: Number = text_find(raw_text, "\r\n\r\n")
    if crlf >= 0: return crlf + 4
    let lf: Number = text_find(raw_text, "\n\n")
    if lf >= 0: return lf + 2
    return -1

fn request_wants_close(raw_text: Text) -> Boolean:
    if text_find(raw_text, "Connection: close") >= 0 or text_find(raw_text, "connection: close") >= 0:
        return true
    if text_find(raw_text, "HTTP/1.0") >= 0 and text_find(raw_text, "keep-alive") < 0:
        return true
    return false

fn read_bounded_http_request(client_fd: Number, max_body_bytes: Number) -> HttpReadOutcome:
    var buf: Bytes = bytes_empty()
    let header_limit: Number = 16384
    var hdr_end: Number = -1
    var content_len: Number = 0
    var chunks: Number = 0

    while chunks < 256:
        let rd: Result[Bytes, Text] = tcp_read(client_fd, 16384, 5000)
        if not result_is_ok(rd):
            break
        let chunk: Bytes = result_unwrap(rd)
        if bytes_length(chunk) == 0:
            break
        set buf = bytes_concat(buf, chunk)
        let cur_len: Number = bytes_length(buf)
        if hdr_end < 0:
            if cur_len > header_limit and header_end_index(bytes_to_text(buf)) < 0:
                return HttpReadOutcome(false, bytes_empty(), some(http_response_payload_too_large("HTTP header exceeds 16 KiB limit", true)))
            let txt: Text = bytes_to_text(buf)
            set hdr_end = header_end_index(txt)
            if hdr_end >= 0:
                let hdr_req_res: Result[HttpRequest, Text] = http_parse_request(bytes_slice(buf, 0, hdr_end))
                if result_is_ok(hdr_req_res):
                    set content_len = result_unwrap(hdr_req_res).content_length
                if content_len > max_body_bytes:
                    return HttpReadOutcome(false, bytes_empty(), some(http_response_payload_too_large("request body exceeds configured limit", true)))
        if hdr_end >= 0 and cur_len >= hdr_end + content_len:
            return HttpReadOutcome(true, bytes_slice(buf, 0, hdr_end + content_len), none)
        set chunks = chunks + 1

    if bytes_length(buf) == 0:
        return HttpReadOutcome(false, bytes_empty(), none)
    return HttpReadOutcome(true, buf, none)

fn dispatch_http_request(req: HttpRequest, m_total: AtomicNumber, m_errors: AtomicNumber) -> HttpResponse:
    let _t_inc: AtomicNumber = atomic_add(m_total, 1)
    if req.method == "OPTIONS":
        return http_response_no_content()
    if req.path == "/healthz":
        return http_response_ok_json("{\"status\":\"ok\",\"service\":\"{{project_name}}\"}")
    if req.path == "/readyz":
        let ping: Result[Boolean, ApiError] = product_repository_ping()
        if not result_is_ok(ping):
            let _e: AtomicNumber = atomic_add(m_errors, 1)
            return http_response_service_unavailable("yazabase database is not ready", true)
        return http_response_ok_json("{\"status\":\"ready\",\"database\":\"yazabase\"}")
    if req.path == "/metrics":
        let tot: Number = atomic_load(m_total)
        let errs: Number = atomic_load(m_errors)
        var prom: Text = "# HELP yaza_http_requests_total Total HTTP requests handled\n"
        set prom = prom + "# TYPE yaza_http_requests_total counter\n"
        set prom = prom + "yaza_http_requests_total " + number_text(tot) + "\n"
        set prom = prom + "# HELP yaza_http_errors_total Total 5xx or readiness errors\n"
        set prom = prom + "# TYPE yaza_http_errors_total counter\n"
        set prom = prom + "yaza_http_errors_total " + number_text(errs) + "\n"
        return HttpResponse(200, "OK", "text/plain; version=0.0.4", bytes_from_text(prom))

    if req.path == "/api/products" and (req.method == "GET" or req.method == "HEAD"):
        let limit: Number = http_query_param_number(req.query, "limit", 50)
        let offset: Number = http_query_param_number(req.query, "offset", 0)
        return product_http_list_sync(req, limit, offset)
    if req.path == "/api/products" and req.method == "POST":
        let input: ProductInput = parse_product_input_from_body(req.body_text)
        return product_http_create_sync(req, input)
    if text_starts_with(req.path, "/api/products/"):
        let id: Text = text_slice(req.path, 14, text_length(req.path) - 14)
        if req.method == "GET" or req.method == "HEAD":
            return product_http_find_sync(req, id)
        if req.method == "PUT":
            let input: ProductInput = parse_product_input_from_body(req.body_text)
            return product_http_replace_sync(req, id, input)
        if req.method == "PATCH":
            let input: ProductInput = parse_product_input_from_body(req.body_text)
            return product_http_patch_sync(req, id, input)
        if req.method == "DELETE":
            return product_http_delete_sync(req, id)
    return http_response_not_found("route not found", true)

fn handle_client_connection(client_fd: Number, max_body_bytes: Number, max_in_flight: Number, m_in_flight: AtomicNumber, m_total: AtomicNumber, m_errors: AtomicNumber, m_rate_limited: AtomicNumber, logger: Logger) -> Boolean:
    var keep_alive: Boolean = true
    var req_on_conn: Number = 0
    while keep_alive and req_on_conn < 64:
        var continue_conn: Boolean = false
        arena_scope 1048576:
            let rd_out: HttpReadOutcome = read_bounded_http_request(client_fd, max_body_bytes)
            if not rd_out.ok_read:
                if option_is_some(rd_out.error_response):
                    let wire_err: Bytes = http_format_response_keep_alive(option_unwrap(rd_out.error_response), "req-limit", false)
                    let _wr: Result[Number, Text] = tcp_write(client_fd, wire_err, 5000)
            else:
                set req_on_conn = req_on_conn + 1
                let raw_text: Text = bytes_to_text(rd_out.raw)
                if request_wants_close(raw_text):
                    set keep_alive = false

                let started_ns: Number = time_now_monotonic_ns()
                let cur_in_flight: Number = atomic_fetch_add(m_in_flight, 1)
                let req_res: Result[HttpRequest, Text] = http_parse_request(rd_out.raw)
                var resp: HttpResponse = http_response_bad_request("malformed HTTP request", true)
                var req_id: Text = "req-" + number_text(req_on_conn)
                var log_method: Text = "UNKNOWN"
                var log_path: Text = "/"

                if result_is_ok(req_res):
                    let req: HttpRequest = result_unwrap(req_res)
                    set log_method = req.method
                    set log_path = req.path
                    if req.x_request_id != "":
                        set req_id = req.x_request_id
                    if cur_in_flight >= max_in_flight:
                        let _rl: AtomicNumber = atomic_add(m_rate_limited, 1)
                        set resp = http_response_service_unavailable("maximum in-flight concurrency limit reached", true)
                    else:
                        set resp = dispatch_http_request(req, m_total, m_errors)
                let _dec: AtomicNumber = atomic_add(m_in_flight, -1)

                if resp.status_code >= 500:
                    let _er: AtomicNumber = atomic_add(m_errors, 1)

                let wire: Bytes = http_format_response_keep_alive(resp, req_id, keep_alive)
                let wr_res: Result[Number, Text] = tcp_write(client_fd, wire, 5000)
                let elapsed_ms: Number = (time_now_monotonic_ns() - started_ns) / 1000000
                let access_json: Text = "{\"method\":\"" + json_escape_text(log_method) + "\",\"path\":\"" + json_escape_text(log_path) + "\",\"status\":" + number_text(resp.status_code) + ",\"latency_ms\":" + number_text(elapsed_ms) + ",\"request_id\":\"" + json_escape_text(req_id) + "\"}"
                let _li: Boolean = log_info(logger, "http_request", access_json)
                if result_is_ok(wr_res):
                    set continue_conn = true
        if not continue_conn:
            break

    let _cl: Result[Boolean, Text] = tcp_close(client_fd)
    return true

async fn api_worker_loop(accept_lock: Mutex, listener: Number, max_body_bytes: Number, max_in_flight: Number, m_in_flight: AtomicNumber, m_total: AtomicNumber, m_errors: AtomicNumber, m_rate_limited: AtomicNumber, logger: Logger) -> Boolean:
    while true:
        let _lk: Boolean = mutex_lock(accept_lock)
        let acc_res: Result[Number, Text] = tcp_accept(listener, 1000)
        let _unlk: Boolean = mutex_unlock(accept_lock)
        if result_is_ok(acc_res):
            let client_fd: Number = result_unwrap(acc_res)
            let _ok: Boolean = handle_client_connection(client_fd, max_body_bytes, max_in_flight, m_in_flight, m_total, m_errors, m_rate_limited, logger)
    return true

fn load_effective_service_config() -> ApiServiceConfig:
    if file_exists("yaza.toml"):
        let parsed: Result[ApiServiceConfig, Text] = api_config_parse(file_read("yaza.toml"))
        if result_is_ok(parsed):
            return result_unwrap(parsed)
    return result_unwrap(api_config_parse("[project]\nname = \"{{project_name}}\"\n"))

start:
    let logger: Logger = logger_create("{{project_name}}", "INFO")
    let cfg: ApiServiceConfig = load_effective_service_config()

    let auth_cfg_check: Result[Boolean, Text] = api_auth_validate_config()
    if not result_is_ok(auth_cfg_check):
        let _le1: Boolean = log_error(logger, "startup_auth_config_failed", result_unwrap_error(auth_cfg_check))
        exit(1)

    if env_get("YAZA_ENV") != "production" and env_get("YAZA_AUTH_SECRET") == "":
        let _lw: Boolean = log_warn(logger, "using_development_auth_secret", "{\"hint\":\"Set YAZA_AUTH_SECRET before production deployment\"}")

    let db_ready: Result[Boolean, ApiError] = product_repository_ping()
    if not result_is_ok(db_ready):
        let _le2: Boolean = log_error(logger, "startup_yazabase_failed", "Failed to initialize YazaBase SQL storage")
        exit(1)

    let m_in_flight: AtomicNumber = atomic_create(0)
    let m_total: AtomicNumber = atomic_create(0)
    let m_errors: AtomicNumber = atomic_create(0)
    let m_rate_limited: AtomicNumber = atomic_create(0)

    if env_get("YAZA_SELF_TEST") == "1":
        let admin_jwt: Text = api_issue_token_jwt("user-admin", "admin", 3600)
        let viewer_jwt: Text = api_issue_token_jwt("user-viewer", "viewer", 3600)
        arena_scope 1048576:
            let create_req: HttpRequest = HttpRequest("POST", "/api/products", "", "application/json", "application/json", "Bearer " + admin_jwt, "self-1", 0, bytes_empty(), "{\"id\":\"sku-003\",\"name\":\"Mechanical Keyboard\",\"priceMinor\":750000,\"currency\":\"IDR\",\"available\":true}")
            let c_res: HttpResponse = dispatch_http_request(create_req, m_total, m_errors)
            assert(c_res.status_code == 201)
            let patch_req: HttpRequest = HttpRequest("PATCH", "/api/products/sku-003", "", "application/json", "application/json", "Bearer " + admin_jwt, "self-2", 0, bytes_empty(), "{\"priceMinor\":699000}")
            let p_res: HttpResponse = dispatch_http_request(patch_req, m_total, m_errors)
            assert(p_res.status_code == 200)
            let put_req: HttpRequest = HttpRequest("PUT", "/api/products/sku-003", "", "application/json", "application/json", "Bearer " + admin_jwt, "self-2b", 0, bytes_empty(), "{\"name\":\"Keyboard Pro\",\"priceMinor\":799000,\"currency\":\"IDR\",\"available\":true}")
            let u_res: HttpResponse = dispatch_http_request(put_req, m_total, m_errors)
            assert(u_res.status_code == 200)
            let ready_req: HttpRequest = HttpRequest("GET", "/readyz", "", "application/json", "", "", "self-r", 0, bytes_empty(), "")
            let r_res: HttpResponse = dispatch_http_request(ready_req, m_total, m_errors)
            assert(r_res.status_code == 200)
            let metrics_req: HttpRequest = HttpRequest("GET", "/metrics", "", "text/plain", "", "", "self-m", 0, bytes_empty(), "")
            let m_res: HttpResponse = dispatch_http_request(metrics_req, m_total, m_errors)
            assert(m_res.status_code == 200)
            let v_post_req: HttpRequest = HttpRequest("POST", "/api/products", "", "application/json", "application/json", "Bearer " + viewer_jwt, "self-3", 0, bytes_empty(), "{\"id\":\"sku-999\",\"name\":\"Blocked\",\"priceMinor\":1000}")
            let f_res: HttpResponse = dispatch_http_request(v_post_req, m_total, m_errors)
            assert(f_res.status_code == 403)
            let d_req: HttpRequest = HttpRequest("DELETE", "/api/products/sku-003", "", "application/json", "application/json", "Bearer " + admin_jwt, "self-4", 0, bytes_empty(), "")
            let d_res: HttpResponse = dispatch_http_request(d_req, m_total, m_errors)
            assert(d_res.status_code == 204)
        say "API_PRODUCTION_SELF_TEST: PASS"
        exit(0)

    let listener_res: Result[Number, Text] = tcp_listen(cfg.bind_host, cfg.bind_port, 128)
    if not result_is_ok(listener_res):
        let _le3: Boolean = log_error(logger, "tcp_listen_failed", result_unwrap_error(listener_res))
        exit(1)
    let listener: Number = result_unwrap(listener_res)

    let demo_jwt: Text = api_issue_token_jwt("user-admin", "admin", 3600)
    say "=== {{project_name}} Production API Service ==="
    say "Profile: " + cfg.resources.profile + " (arena_mode = " + cfg.resources.arena_mode + ") | max_in_flight = " + number_text(cfg.resources.max_in_flight) + " | DB: YazaBase SQL (ACID)"
    say "Server listening on http://" + cfg.bind_host + ":" + number_text(cfg.bind_port)
    say "Endpoints:"
    say "  GET    /healthz  |  /readyz  |  /metrics"
    say "  GET    /api/products"
    say "  POST   /api/products"
    say "  GET    /api/products/:id"
    say "  PUT    /api/products/:id"
    say "  PATCH  /api/products/:id"
    say "  DELETE /api/products/:id"
    if env_get("YAZA_ENV") != "production":
        say "Demo Bearer JWT (admin): " + demo_jwt

    let accept_lock: Mutex = mutex_create(1)
    let workers: List[Task[Boolean]] = List[Task[Boolean]]()
    var wi: Number = 0
    while wi < 8:
        list_push(workers, spawn api_worker_loop(accept_lock, listener, cfg.max_request_body_bytes, cfg.resources.max_in_flight, m_in_flight, m_total, m_errors, m_rate_limited, logger))
        set wi = wi + 1
    var wj: Number = 0
    while wj < list_count(workers):
        let _done: Boolean = await list_get(workers, wj)
        set wj = wj + 1
