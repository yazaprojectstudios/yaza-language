fn repeat_text(value: Text, count: Number) -> Result[Text,Text]:
    return text_try_repeat(value, count)

start:
    let triple: Result[Text,Text] = repeat_text("ab", 3)
    assert result_is_ok(triple)
    assert result_unwrap(triple) == "ababab"

    let zero: Result[Text,Text] = text_try_repeat("text", 0)
    assert result_is_ok(zero)
    assert result_unwrap(zero) == ""

    let empty: Result[Text,Text] = text_try_repeat("", 9223372036854775807)
    assert result_is_ok(empty)
    assert result_unwrap(empty) == ""

    let utf8: Result[Text,Text] = text_try_repeat("é🙂", 2)
    assert result_is_ok(utf8)
    assert result_unwrap(utf8) == "é🙂é🙂"
    assert text_length(result_unwrap(utf8)) == 12

    let large: Result[Text,Text] = text_try_repeat("x", 100000)
    assert result_is_ok(large)
    assert text_length(result_unwrap(large)) == 100000

    let negative: Result[Text,Text] = text_try_repeat("x", -1)
    assert not result_is_ok(negative)
    assert result_unwrap_error(negative) == "text_try_repeat count must be non-negative"

    let overflow: Result[Text,Text] = text_try_repeat("xx", 9223372036854775807)
    assert not result_is_ok(overflow)
    assert result_unwrap_error(overflow) == "text_try_repeat output size is too large"
    say "fallible-text-repeat-ok"
