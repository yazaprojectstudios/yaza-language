fn append_at_bottom(destination: List[Bytes], depth: Number) -> Number:
    if depth > 0:
        return append_at_bottom(destination, depth - 1)
    arena_scope 2048:
        let temporary: Bytes = bytes_from_text("recursive child " + number_text(depth))
        list_push(destination, temporary)
        return 0

start:
    let output: List[Bytes] = List[Bytes]()
    append_at_bottom(output, 2)
