use "../yazabase/sql_binder_v1"
use "../yazabase/sql_create_index_v1"
use "../yazabase/sql_create_index_write_v1"

fn yaza_base_sql_create_index_parser_v1_check() -> Boolean:
    let source: Text = "CREATE INDEX people_email_idx ON people(email);"
    let parsed: Result[YazaSqlCreateIndexAstV1, Text] = yaza_sql_parse_create_index_v1(source)
    if not result_is_ok(parsed): return false
    let ast: YazaSqlCreateIndexAstV1 = result_unwrap(parsed)
    if ast.version != 1 or ast.start_byte != 0 or ast.end_byte != text_length(source): return false
    if text_slice(source, ast.index_name.start_byte, ast.index_name.end_byte - ast.index_name.start_byte) != "people_email_idx": return false
    if text_slice(source, ast.table_name.start_byte, ast.table_name.end_byte - ast.table_name.start_byte) != "people": return false
    if text_slice(source, ast.column_name.start_byte, ast.column_name.end_byte - ast.column_name.start_byte) != "email": return false

    let unique_source: Text = "CREATE UNIQUE INDEX people_email_idx ON people(email)"
    let unique_parsed: Result[YazaSqlCreateIndexAstV1, Text] = yaza_sql_parse_create_index_v1(unique_source)
    if not result_is_ok(unique_parsed) or not result_unwrap(unique_parsed).is_unique: return false
    let if_not_exists_source: Text = "CREATE INDEX IF NOT EXISTS people_email_idx ON people(email);"
    let if_not_exists_parsed: Result[YazaSqlCreateIndexAstV1, Text] = yaza_sql_parse_create_index_v1(if_not_exists_source)
    if not result_is_ok(if_not_exists_parsed) or result_unwrap(if_not_exists_parsed).is_unique: return false
    let unique_if_not_exists_source: Text = "CREATE UNIQUE INDEX IF NOT EXISTS people_email_idx ON people(email)"
    let unique_if_not_exists_parsed: Result[YazaSqlCreateIndexAstV1, Text] = yaza_sql_parse_create_index_v1(unique_if_not_exists_source)
    if not result_is_ok(unique_if_not_exists_parsed) or not result_unwrap(unique_if_not_exists_parsed).is_unique: return false
    if result_is_ok(yaza_sql_parse_create_index_v1("CREATE INDEX IF people_email_idx ON people(email)")): return false
    if result_is_ok(yaza_sql_parse_create_index_v1("CREATE INDEX IF NOT people_email_idx ON people(email)")): return false
    if result_is_ok(yaza_sql_parse_create_index_v1("CREATE UNIQUE INDEX IF EXISTS people_email_idx ON people(email)")): return false
    if result_is_ok(yaza_sql_parse_create_index_v1("CREATE INDEX people_name_idx ON people(name, email)")): return false
    if result_is_ok(yaza_sql_parse_create_index_v1("CREATE INDEX people_email_idx ON people(email) WHERE email IS NOT NULL")): return false
    if result_is_ok(yaza_sql_parse_create_index_v1("CREATE INDEX people_email_idx ON public.people(email)")): return false
    if result_is_ok(yaza_sql_parse_create_index_v1("CREATE INDEX people_email_idx ON people()")): return false
    if result_is_ok(yaza_sql_parse_create_index_v1("CREATE INDEX people_email_idx ON people(email); SELECT 1")): return false

    let columns: List[YazaSqlColumnSchemaV1] = [YazaSqlColumnSchemaV1("id", 4, false, 0, 0, 0, ""), YazaSqlColumnSchemaV1("email", 9, true, 1, 0, 0, "")]
    let tables: List[YazaSqlTableSchemaV1] = [YazaSqlTableSchemaV1(5, "people", columns)]
    let catalog: YazaSqlCatalogSnapshotV1 = YazaSqlCatalogSnapshotV1(7, tables, List[YazaSqlColumnDefaultV1]())
    let plan_result: Result[YazaSqlCreateIndexPlanV1, Text] = yaza_sql_bind_create_index_v1(source, ast, catalog)
    if not result_is_ok(plan_result): return false
    let plan: YazaSqlCreateIndexPlanV1 = result_unwrap(plan_result)
    if not yaza_sql_create_index_plan_valid_v1(plan) or plan.is_unique or plan.catalog_version != 7 or plan.table_id != 5 or plan.index_name != "people_email_idx" or plan.table_name != "people" or plan.index_column_ordinal != 1: return false
    let unique_ast: YazaSqlCreateIndexAstV1 = result_unwrap(unique_parsed)
    let unique_plan_result: Result[YazaSqlCreateIndexPlanV1, Text] = yaza_sql_bind_create_index_v1(unique_source, unique_ast, catalog)
    if not result_is_ok(unique_plan_result): return false
    let unique_plan: YazaSqlCreateIndexPlanV1 = result_unwrap(unique_plan_result)
    if not yaza_sql_create_index_plan_valid_v1(unique_plan) or not unique_plan.is_unique: return false

    let unknown_table: YazaSqlCreateIndexAstV1 = result_unwrap(yaza_sql_parse_create_index_v1("CREATE INDEX absent_idx ON absent(email)"))
    if result_is_ok(yaza_sql_bind_create_index_v1("CREATE INDEX absent_idx ON absent(email)", unknown_table, catalog)): return false
    let unknown_column: YazaSqlCreateIndexAstV1 = result_unwrap(yaza_sql_parse_create_index_v1("CREATE INDEX absent_idx ON people(absent)"))
    if result_is_ok(yaza_sql_bind_create_index_v1("CREATE INDEX absent_idx ON people(absent)", unknown_column, catalog)): return false

    let system_catalog: YazaSqlCatalogSnapshotV1 = YazaSqlCatalogSnapshotV1(7, [YazaSqlTableSchemaV1(3, "sys_indexes", columns)], List[YazaSqlColumnDefaultV1]())
    let system_ast: YazaSqlCreateIndexAstV1 = result_unwrap(yaza_sql_parse_create_index_v1("CREATE INDEX sys_idx ON sys_indexes(index_id)"))
    if result_is_ok(yaza_sql_bind_create_index_v1("CREATE INDEX sys_idx ON sys_indexes(index_id)", system_ast, system_catalog)): return false
    return true

start:
    if yaza_base_sql_create_index_parser_v1_check():
        say "yazabase-sql-create-index-parser-v1-ok"
    else:
        say "yazabase-sql-create-index-parser-v1-failed"
        exit(1)
