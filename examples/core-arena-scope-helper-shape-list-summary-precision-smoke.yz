shape Payloads:
    items: List[Bytes]

shape Inbox:
    payloads: Payloads

fn append_inner(inbox: Inbox, value: Bytes) -> Unit:
    list_push(inbox.payloads.items, value)

fn append_outer(inbox: Inbox, value: Bytes) -> Unit:
    append_inner(inbox, value)

start:
    let inbox: Inbox = Inbox(Payloads(List[Bytes]()))
    let parent_bytes: Bytes = bytes_from_text("parent-safe")
    let output: List[Bytes] = List[Bytes]()
    arena_scope 4096:
        append_outer(inbox, parent_bytes)
        let latest: Bytes = list_get(inbox.payloads.items, 0)
        list_push(output, latest)
    say bytes_to_text(list_get(output, 0))
