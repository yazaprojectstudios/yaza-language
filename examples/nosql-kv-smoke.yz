use "std/nosql/kv"

start:
    # 1. Simple String encoding / decoding
    let ok_str: Bytes = kv_encode_simple_string("OK")
    let p_ok: Result[KvParsedItem, Text] = kv_parse_response(ok_str, 0)
    assert result_is_ok(p_ok)
    assert result_unwrap(p_ok).value_text == "OK"
    assert not result_unwrap(p_ok).is_error
    assert not result_unwrap(p_ok).is_null

    # 2. Integer encoding / decoding
    let int_b: Bytes = kv_encode_integer(42)
    let p_int: Result[KvParsedItem, Text] = kv_parse_response(int_b, 0)
    assert result_is_ok(p_int)
    assert result_unwrap(p_int).value_int == 42
    assert result_unwrap(p_int).value_text == "42"

    # 3. Bulk String encoding / decoding
    let bulk_b: Bytes = kv_encode_bulk_string("hello world")
    let p_bulk: Result[KvParsedItem, Text] = kv_parse_response(bulk_b, 0)
    assert result_is_ok(p_bulk)
    assert result_unwrap(p_bulk).value_text == "hello world"

    # 4. Null Bulk String ($-1\r\n)
    let null_b: Bytes = kv_encode_null()
    let p_null: Result[KvParsedItem, Text] = kv_parse_response(null_b, 0)
    assert result_is_ok(p_null)
    assert result_unwrap(p_null).is_null

    # 5. Simple Error encoding / decoding
    let err_b: Bytes = kv_encode_error("ERR unknown command")
    let p_err: Result[KvParsedItem, Text] = kv_parse_response(err_b, 0)
    assert result_is_ok(p_err)
    assert result_unwrap(p_err).is_error
    assert result_unwrap(p_err).value_text == "ERR unknown command"

    # 6. Key-Value Command generation
    let ping_cmd: Bytes = kv_ping()
    assert bytes_length(ping_cmd) > 0
    assert bytes_get(ping_cmd, 0) == 42 # '*'

    let get_cmd: Bytes = kv_get("user:101")
    assert bytes_length(get_cmd) > 0
    assert bytes_get(get_cmd, 0) == 42 # '*'

    let set_cmd: Bytes = kv_set("session:abc", "token_val")
    assert bytes_length(set_cmd) > 0
    assert bytes_get(set_cmd, 0) == 42 # '*'

    let incr_cmd: Bytes = kv_incr("hits:count")
    assert bytes_length(incr_cmd) > 0
    assert bytes_get(incr_cmd, 0) == 42 # '*'
