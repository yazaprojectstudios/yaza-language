fn number_result() -> Result[Number, Text]:
    return ok(42)

fn error_result() -> Result[Number, Text]:
    return err("number is unavailable")

fn render_number(value: Result[Number, Text]) -> Result[Text, Text]:
    let number: Number = value?
    return ok(number_text(number))

start:
    let success: Result[Text, Text] = render_number(number_result())
    let failure: Result[Text, Text] = render_number(error_result())
    assert result_is_ok(success)
    assert result_unwrap(success) == "42"
    assert not result_is_ok(failure)
    assert result_unwrap_error(failure) == "number is unavailable"
    say "postfix-question-different-success-types-ok"
