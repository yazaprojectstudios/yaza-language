use "../std/html"

start:
    let escaped_text: Result[Text, Text] = html_escape_text("Hello & <YAZA>")
    assert result_is_ok(escaped_text)
    assert result_unwrap(escaped_text) == "Hello &amp; &lt;YAZA&gt;"

    let escaped_attribute: Result[Text, Text] = html_escape_attribute("say \"hello\" & 'goodbye'")
    assert result_is_ok(escaped_attribute)
    assert result_unwrap(escaped_attribute) == "say &quot;hello&quot; &amp; &#39;goodbye&#39;"

    let unicode_text: Result[Text, Text] = html_escape_text("Bandung 🌋 & café")
    assert result_is_ok(unicode_text)
    assert result_unwrap(unicode_text) == "Bandung 🌋 &amp; café"

    let empty_text: Result[Text, Text] = html_escape_text("")
    assert result_is_ok(empty_text)
    assert result_unwrap(empty_text) == ""

    let already_encoded: Result[Text, Text] = html_escape_text("&lt;script&gt;")
    assert result_is_ok(already_encoded)
    assert result_unwrap(already_encoded) == "&amp;lt;script&amp;gt;"

    let repeated: Result[Text, Text] = html_escape_text("<script>alert('x' & \"y\")</script>")
    assert result_is_ok(repeated)
    assert result_unwrap(repeated) == "&lt;script&gt;alert(&#39;x&#39; &amp; &quot;y&quot;)&lt;/script&gt;"

    let invalid_utf8: Result[Text, Text] = html_escape_bytes(bytes_from_number(255))
    assert not result_is_ok(invalid_utf8)
    let nul_input: Result[Text, Text] = html_escape_bytes(bytes_from_number(0))
    assert not result_is_ok(nul_input)

    let safe_https: Result[Text, Text] = html_escape_href("https://example.com/search?q=green%20tea&sort=asc")
    assert result_is_ok(safe_https)
    assert result_unwrap(safe_https) == "https://example.com/search?q=green%20tea&amp;sort=asc"
    let safe_relative: Result[Text, Text] = html_escape_href("../products?id=7#details")
    assert result_is_ok(safe_relative)
    assert result_unwrap(safe_relative) == "../products?id=7#details"
    let safe_https_port: Result[Text, Text] = html_escape_href("https://EXAMPLE.com:8443/search")
    assert result_is_ok(safe_https_port)
    let safe_ipv4: Result[Text, Text] = html_escape_href("https://192.0.2.17/catalog")
    assert result_is_ok(safe_ipv4)
    let safe_ipv6: Result[Text, Text] = html_escape_href("https://[2001:db8::1]:443/catalog")
    assert result_is_ok(safe_ipv6)
    let safe_ipv6_full: Result[Text, Text] = html_escape_href("https://[2001:0db8:0000:0000:0000:0000:0000:0001]/")
    assert result_is_ok(safe_ipv6_full)
    let empty_https_authority: Result[Text, Text] = html_escape_href("https:///path")
    assert not result_is_ok(empty_https_authority)
    let unsafe_script: Result[Text, Text] = html_escape_href("javascript:alert(1)")
    assert not result_is_ok(unsafe_script)
    let unsafe_data: Result[Text, Text] = html_escape_href("DATA:text/html,hello")
    assert not result_is_ok(unsafe_data)
    let unsafe_protocol_relative: Result[Text, Text] = html_escape_href("//tracker.example/path")
    assert not result_is_ok(unsafe_protocol_relative)
    let unsafe_credentials: Result[Text, Text] = html_escape_href("https://user@example.com/path")
    assert not result_is_ok(unsafe_credentials)
    let bad_percent_escape: Result[Text, Text] = html_escape_href("/search?q=%G0")
    assert not result_is_ok(bad_percent_escape)
    let encoded_control: Result[Text, Text] = html_escape_href("/search?q=one%0Atwo")
    assert not result_is_ok(encoded_control)
    let bad_port_name: Result[Text, Text] = html_escape_href("https://example.com:443x/path")
    assert not result_is_ok(bad_port_name)
    let empty_port: Result[Text, Text] = html_escape_href("https://example.com:/path")
    assert not result_is_ok(empty_port)
    let zero_port: Result[Text, Text] = html_escape_href("https://example.com:0/path")
    assert not result_is_ok(zero_port)
    let oversized_port: Result[Text, Text] = html_escape_href("https://example.com:65536/path")
    assert not result_is_ok(oversized_port)
    let bad_hostname_label: Result[Text, Text] = html_escape_href("https://-example.com/path")
    assert not result_is_ok(bad_hostname_label)
    let empty_hostname_label: Result[Text, Text] = html_escape_href("https://example..com/path")
    assert not result_is_ok(empty_hostname_label)
    let underscore_hostname: Result[Text, Text] = html_escape_href("https://bad_name.example/path")
    assert not result_is_ok(underscore_hostname)
    let abbreviated_ipv4: Result[Text, Text] = html_escape_href("https://127.1/path")
    assert not result_is_ok(abbreviated_ipv4)
    let octal_ipv4: Result[Text, Text] = html_escape_href("https://192.000.2.1/path")
    assert not result_is_ok(octal_ipv4)
    let hex_numeric_hostname: Result[Text, Text] = html_escape_href("https://example.0x/path")
    assert not result_is_ok(hex_numeric_hostname)
    let encoded_host_separator: Result[Text, Text] = html_escape_href("https://example.com%40evil.test/path")
    assert not result_is_ok(encoded_host_separator)
    let unbracketed_ipv6: Result[Text, Text] = html_escape_href("https://2001:db8::1/path")
    assert not result_is_ok(unbracketed_ipv6)
    let bad_ipv6_group_count: Result[Text, Text] = html_escape_href("https://[1:2:3:4:5:6:7:8::]/path")
    assert not result_is_ok(bad_ipv6_group_count)
    let repeated_ipv6_compression: Result[Text, Text] = html_escape_href("https://[2001::db8::1]/path")
    assert not result_is_ok(repeated_ipv6_compression)
    let ipv6_zone_identifier: Result[Text, Text] = html_escape_href("https://[fe80::1%25en0]/path")
    assert not result_is_ok(ipv6_zone_identifier)
