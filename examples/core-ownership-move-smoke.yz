# Core 2 Ownership and Move semantics verification
shape Item:
    id: Number
    name: Text

fn consume(item: move Item) -> Number:
    return item.id

start:
    let a: Item = Item(101, "first")
    let id: Number = consume(move a)
    assert(id == 101)

    # Reinitializing after move allows reuse
    var b: Item = Item(202, "second")
    let b_id: Number = consume(move b)
    assert(b_id == 202)

    set b = Item(303, "third")
    assert(b.id == 303)
    let b3_id: Number = consume(move b)
    assert(b3_id == 303)

    say "ownership move smoke passed"
