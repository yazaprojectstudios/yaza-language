fn maybe_first(values: TextList) -> Option[Text]:
    if list_count(values) > 0:
        return some(list_get(values, 0))
    return none

fn result_for(value: Number) -> Result[Number, Text]:
    if value >= 0:
        return ok(value)
    return err("negative")

fn positive(value: Number) -> Result[Number, Text]:
    if value > 0:
        return ok(value)
    return err("not positive")

fn doubled_positive(value: Number) -> Result[Number, Text]:
    let accepted: Number = positive(value)?
    return ok(accepted * 2)

fn assign_positive(value: Number) -> Result[Number, Text]:
    var accepted: Number = 0
    set accepted = positive(value)?
    return ok(accepted)

fn forward_positive(value: Number) -> Result[Number, Text]:
    return positive(value)?

fn result_label(value: Result[Number, Text]) -> Text:
    match value:
        ok(number):
            return number_text(number)
        err(message):
            return message

fn nested_option(value: Boolean) -> Option[Option[Text]]:
    if value:
        return some(some("nested"))
    return some(none)

fn option_label(value: Option[Text]) -> Text:
    match value:
        some(item):
            return item
        none:
            return "empty"

start:
    let empty_values: TextList = text_list()
    let first: Option[Text] = maybe_first(empty_values)
    let present: Option[Text] = some("available")
    assert not option_is_some(first)
    assert option_is_some(present)
    assert option_unwrap(present) == "available"
    assert option_label(present) == "available"
    assert option_label(first) == "empty"

    let nested: Option[Option[Text]] = nested_option(true)
    let nested_empty: Option[Option[Text]] = nested_option(false)
    assert option_unwrap(option_unwrap(nested)) == "nested"
    assert option_is_some(nested_empty)
    assert not option_is_some(option_unwrap(nested_empty))

    let success: Result[Number, Text] = result_for(42)
    let failure: Result[Number, Text] = result_for(-1)
    assert result_is_ok(success)
    assert result_unwrap(success) == 42
    assert not result_is_ok(failure)
    assert result_unwrap_error(failure) == "negative"
    assert result_label(success) == "42"
    assert result_label(failure) == "negative"
    assert result_unwrap(doubled_positive(4)) == 8
    assert result_unwrap_error(doubled_positive(-1)) == "not positive"
    assert result_unwrap(assign_positive(5)) == 5
    assert result_unwrap_error(assign_positive(0)) == "not positive"
    assert result_unwrap(forward_positive(9)) == 9
    assert result_unwrap_error(forward_positive(-2)) == "not positive"

    let nested_result: Result[Option[Text], Text] = ok(some("inside"))
    assert option_unwrap(result_unwrap(nested_result)) == "inside"
    say "option-result-ok"
