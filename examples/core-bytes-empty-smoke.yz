shape EmptyBytesBox:
    payload: Bytes

fn make_empty_bytes_box() -> EmptyBytesBox:
    return EmptyBytesBox(bytes_empty())

start:
    let empty: Bytes = bytes_empty()
    assert bytes_length(empty) == 0
    assert bytes_equal(empty, bytes_from_text(""))

    let boxes: List[EmptyBytesBox] = List[EmptyBytesBox]()
    list_push(boxes, make_empty_bytes_box())
    let box: EmptyBytesBox = list_get(boxes, 0)
    assert bytes_length(box.payload) == 0

    say "core-bytes-empty-smoke-ok"
