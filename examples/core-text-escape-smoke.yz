start:
    let escaped: Text = "line\ncolumn\t quote:\" slash:\\ zero:\0ignored"
    let expected: Text = "line\ncolumn\t quote:\" slash:\\ zero:"
    assert escaped == expected
    assert text_length(escaped) == text_length(expected)
    let controls: Bytes = bytes_from_text("\a\b\f\n\r\t\v")
    assert bytes_length(controls) == 7
    assert bytes_get(controls, 0) == 7
    assert bytes_get(controls, 1) == 8
    assert bytes_get(controls, 2) == 12
    assert bytes_get(controls, 3) == 10
    assert bytes_get(controls, 4) == 13
    assert bytes_get(controls, 5) == 9
    assert bytes_get(controls, 6) == 11
    say escaped
