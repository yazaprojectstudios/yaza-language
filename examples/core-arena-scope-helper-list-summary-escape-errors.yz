shape Envelope:
    items: List[Bytes]

fn append_envelope(values: List[Envelope], value: Envelope) -> Unit:
    list_push(values, value)

start:
    let parent_items: List[Bytes] = List[Bytes]()
    let parent_bytes: Bytes = bytes_from_text("parent")
    list_push(parent_items, parent_bytes)
    let escaped: List[Bytes] = List[Bytes]()
    arena_scope 4096:
        let child_items: List[Bytes] = List[Bytes]()
        let child_bytes: Bytes = bytes_from_text("child")
        list_push(child_items, child_bytes)
        let values: List[Envelope] = List[Envelope]()
        list_push(values, Envelope(parent_items))
        append_envelope(values, Envelope(child_items))
        let latest: Envelope = list_get(values, 1)
        let escaped_bytes: Bytes = list_get(latest.items, 0)
        list_push(escaped, escaped_bytes)
