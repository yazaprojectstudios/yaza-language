start:
    let initial_used: Number = arena_used()
    let initial_storage: Number = arena_storage_used()
    let initial_reserved: Number = arena_reserved()
    let initial_scopes: Number = arena_live_scopes()
    var cycle: Number = 0
    while cycle < 10000:
        arena_scope 4096:
            let payload: Text = "cycle " + number_text(cycle)
            assert(text_length(payload) > 0)
            assert(arena_used() > 0)
        assert(arena_used() == initial_used)
        assert(arena_storage_used() == initial_storage)
        assert(arena_reserved() == initial_reserved)
        assert(arena_live_scopes() == initial_scopes)
        set cycle = cycle + 1
    say "reclaimed=10000"
