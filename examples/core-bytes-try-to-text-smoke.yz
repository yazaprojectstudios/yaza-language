start:
    let converted: Result[Text, Text] = bytes_try_to_text(bytes_from_text("YAZA"))
    match converted:
        ok(value):
            say value
        err(message):
            say message
    let invalid: Result[Text, Text] = bytes_try_to_text(bytes_from_number(255))
    match invalid:
        ok(value):
            say value
        err(message):
            say message
    say "fallible-bytes-to-text-ok"
