start:
    let number_min: Result[Number, Text] = number_try_parse("-9223372036854775808")
    let number_max: Result[Number, Text] = number_try_parse(" +9223372036854775807")
    assert result_is_ok(number_min)
    assert result_is_ok(number_max)
    assert result_unwrap(number_min) == -9223372036854775808
    assert result_unwrap(number_max) == 9223372036854775807

    let number_overflow: Result[Number, Text] = number_try_parse("9223372036854775808")
    let number_bad: Result[Number, Text] = number_try_parse("42 ")
    assert not result_is_ok(number_overflow)
    assert not result_is_ok(number_bad)
    assert result_unwrap_error(number_overflow) == "invalid or out-of-range Number text"

    let int32_min: Result[Int32, Text] = int32_try_parse("-2147483648")
    let int32_max: Result[Int32, Text] = int32_try_parse("2147483647")
    let int32_overflow: Result[Int32, Text] = int32_try_parse("2147483648")
    assert result_is_ok(int32_min)
    assert result_is_ok(int32_max)
    assert not result_is_ok(int32_overflow)
    assert number_from_int32(result_unwrap(int32_min)) == -2147483648
    assert number_from_int32(result_unwrap(int32_max)) == 2147483647

    let float_ok: Result[Float64, Text] = float64_try_parse("+1.25e2")
    let float_nan: Result[Float64, Text] = float64_try_parse("nan")
    let float_overflow: Result[Float64, Text] = float64_try_parse("1e9999")
    assert result_is_ok(float_ok)
    assert result_unwrap(float_ok) == 125.0
    assert not result_is_ok(float_nan)
    assert not result_is_ok(float_overflow)
    say "yazabase-fallible-parse-ok"
