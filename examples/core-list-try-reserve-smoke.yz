start:
    var numbers: List[Number] = List[Number]()
    assert list_try_reserve(numbers, 0)
    assert list_try_reserve(numbers, 32)
    assert list_count(numbers) == 0
    assert list_try_push(numbers, 17)
    assert list_try_push(numbers, 23)
    assert list_try_reserve(numbers, 16)
    assert list_count(numbers) == 2
    assert list_get(numbers, 0) == 17
    assert list_get(numbers, 1) == 23
    assert not list_try_reserve(numbers, -1)
    assert not list_try_reserve(numbers, 9223372036854775807)
    assert list_count(numbers) == 2
    assert list_get(numbers, 0) == 17
    assert list_get(numbers, 1) == 23

    var labels: List[Text] = List[Text]()
    assert list_try_reserve(labels, 8)
    assert list_try_push(labels, "sql")
    assert list_try_push(labels, "binder")
    assert list_get(labels, 1) == "binder"
    say "list-try-reserve-ok"
