fn fallible_text_list_construction_works() -> Boolean:
    let created: Result[TextList, Text] = text_list_try_new()
    if not result_is_ok(created): return false

    let values: TextList = result_unwrap(created)
    if not list_try_push(values, "alpha"): return false
    if not list_try_push(values, "beta"): return false
    return list_count(values) == 2 and list_get(values, 0) == "alpha" and list_get(values, 1) == "beta"

start:
    assert fallible_text_list_construction_works()
    say "fallible-text-list-construction-ok"
