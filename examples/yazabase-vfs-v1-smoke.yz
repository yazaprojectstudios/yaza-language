use "std/fs"

fn expect_vfs_success(result: Result[Boolean, Text]) -> Result[Number, Text]:
    if result_is_ok(result): return ok(1)
    return err(result_unwrap_error(result))

fn exercise_vfs(root_path: Text) -> Result[Number, Text]:
    let root: Number = root_open(root_path)?
    let file: Number = create_exclusive(root, "smoke-page.ydb")?
    let names: Bytes = list_names(root)?
    if bytes_length(names) == 0: return err("VFS root listing returned an empty result after creating a file")
    let expected: Bytes = bytes_from_text("YDBv1-page")
    let written: Number = write_exact(file, 0, expected)?
    if written != bytes_length(expected): return err("VFS write length did not match input")
    let actual: Result[Bytes, Text] = read_exact(file, 0, written)
    if not result_is_ok(actual): return err(result_unwrap_error(actual))
    if not bytes_equal(result_unwrap(actual), expected): return err("VFS bytes did not round-trip")
    let initial_size: Number = file_size(file)?
    if initial_size != written: return err("VFS file size is incorrect")
    let preallocated: Result[Number, Text] = expect_vfs_success(preallocate(file, 65536))
    if not result_is_ok(preallocated): return err(result_unwrap_error(preallocated))
    let reserved_size: Number = file_size(file)?
    if reserved_size != 65536: return err("VFS preallocation did not extend the file to its reserved size")
    let smaller_preallocation: Result[Number, Text] = expect_vfs_success(preallocate(file, 8192))
    if not result_is_ok(smaller_preallocation): return err(result_unwrap_error(smaller_preallocation))
    let preserved_size: Number = file_size(file)?
    if preserved_size != 65536: return err("VFS preallocation unexpectedly shrank the file")
    let sync_result: Result[Number, Text] = expect_vfs_success(sync(file))
    if not result_is_ok(sync_result): return err(result_unwrap_error(sync_result))
    let truncate_result: Result[Number, Text] = expect_vfs_success(truncate(file, 4))
    if not result_is_ok(truncate_result): return err(result_unwrap_error(truncate_result))
    let closed_file: Result[Number, Text] = expect_vfs_success(close(file))
    if not result_is_ok(closed_file): return err(result_unwrap_error(closed_file))
    let renamed: Result[Boolean, Text] = rename(root, "smoke-page.ydb", "smoke-page.done")
    if not result_is_ok(renamed): return err(result_unwrap_error(renamed))
    let directory_sync: Result[Number, Text] = expect_vfs_success(sync_directory(root))
    if not result_is_ok(directory_sync): return err(result_unwrap_error(directory_sync))
    let renamed_file: Number = open_read(root, "smoke-page.done")?
    let final_size: Number = file_size(renamed_file)?
    if final_size != 4: return err("VFS truncate did not persist the expected size")
    let closed_renamed: Result[Number, Text] = expect_vfs_success(close(renamed_file))
    if not result_is_ok(closed_renamed): return err(result_unwrap_error(closed_renamed))
    let removed: Result[Boolean, Text] = remove(root, "smoke-page.done")
    if not result_is_ok(removed): return err(result_unwrap_error(removed))
    let final_directory_sync: Result[Number, Text] = expect_vfs_success(sync_directory(root))
    if not result_is_ok(final_directory_sync): return err(result_unwrap_error(final_directory_sync))
    let closed_root: Result[Number, Text] = expect_vfs_success(close(root))
    if not result_is_ok(closed_root): return err(result_unwrap_error(closed_root))
    return ok(final_size)

start:
    let outcome: Result[Number, Text] = exercise_vfs(arg(1))
    if result_is_ok(outcome):
        say "vfs round-trip bytes: " + number_text(result_unwrap(outcome))
    else:
        say result_unwrap_error(outcome)
