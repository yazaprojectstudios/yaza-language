use "std/http_client"

start:
    let response: Result[HttpsResponse, Text] = http_client_get(arg(1), "")
    if not result_is_ok(response): say result_unwrap_error(response)
    assert result_is_ok(response)
    let value: HttpsResponse = result_unwrap(response)
    assert value.status_code == 200
    assert bytes_length(value.body) > 0
    say "https-trusted-smoke passed"
