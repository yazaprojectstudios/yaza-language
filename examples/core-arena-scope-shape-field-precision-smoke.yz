shape Envelope:
    label: Text
    items: List[Bytes]

start:
    let parent_label: Text = "parent " + number_text(1)
    arena_scope 4096:
        let local_bytes: Bytes = bytes_from_text("child")
        let local: Envelope = Envelope(parent_label, List[Bytes]())
        list_push(local.items, local_bytes)
        assert list_count(local.items) == 1
    say "field-precise-list-store-ok"
