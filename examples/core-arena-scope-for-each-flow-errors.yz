start:
    let retained: List[Bytes] = List[Bytes]()
    let values: List[Number] = List[Number]()
    let initial: Bytes = bytes_from_text("static")
    list_push(values, 0)
    arena_scope 4096:
        var carried: Bytes = initial
        for value in values:
            list_push(retained, carried)
            set carried = bytes_from_text("child-" + number_text(value))
    say "scope-closed"
