use "std/env"
use "std/compress"

start:
    # 1. std/env real runtime-backed helpers (no stub shadowing core env_get)
    let _set: Number = env_set("YAZA_STD_ENV_SMOKE_KEY", "hello-yaza")
    let got_res: Result[Text, Text] = env_try_get("YAZA_STD_ENV_SMOKE_KEY")
    assert(result_is_ok(got_res) and result_unwrap(got_res) == "hello-yaza")
    assert(env_has("YAZA_STD_ENV_SMOKE_KEY"))
    assert(env_get_or_default("YAZA_STD_ENV_SMOKE_KEY", "fallback") == "hello-yaza")
    assert(not env_has("YAZA_STD_ENV_SMOKE_MISSING_999"))
    assert(env_get_or_default("YAZA_STD_ENV_SMOKE_MISSING_999", "fallback") == "fallback")
    assert(not result_is_ok(env_try_get("")))
    assert(not result_is_ok(env_try_get("BAD=KEY")))

    let plat: Text = os_platform()
    let arch: Text = os_arch()
    let cores: Number = os_cpu_cores()
    assert(plat == "macos" or plat == "linux" or plat == "windows")
    assert(arch == "arm64" or arch == "x86_64" or arch == "x86" or arch == "arm")
    assert(cores >= 1)

    # 2. std/compress IEEE 802.3 CRC-32 (0xEDB88320) standard test vector: "123456789" -> 0xCBF43926 (3421780262)
    let vec: Bytes = bytes_from_text("123456789")
    assert(checksum_crc32_bytes(bytes_empty()) == 0)
    assert(checksum_crc32_bytes(vec) == 3421780262)

    var inc_crc: Number = 0
    var i: Number = 0
    while i < bytes_length(vec):
        set inc_crc = checksum_crc32_number(inc_crc, bytes_get(vec, i))
        set i = i + 1
    assert(inc_crc == 3421780262)
    assert(checksum_crc32c_bytes(vec) != 0)

    say "std-env-compress-smoke: PASS"
    let _ex: Number = process_exit_code(0)
