shape ResultFields:
    direct: Result[Number, Text]
    optional: Option[Result[Number, Text]]
    values: List[Result[Number, Text]]

fn read_direct(fields: ResultFields) -> Number:
    if result_is_ok(fields.direct):
        return result_unwrap(fields.direct)
    return -1

start:
    var fields: ResultFields = ResultFields(ok(7), some(err("nested failure")), [ok(3), err("list failure")])
    assert read_direct(fields) == 7
    match option_unwrap(fields.optional):
        ok(value):
            assert value == 99
        err(message):
            assert message == "nested failure"
    match list_get(fields.values, 0):
        ok(value):
            assert value == 3
        err(message):
            assert false
    match list_get(fields.values, 1):
        ok(value):
            assert false
        err(message):
            assert message == "list failure"
    set fields.direct = err("updated")
    assert read_direct(fields) == -1
    assert result_unwrap_error(fields.direct) == "updated"
    say "result-scalar-shape-field-parity-ok"
