start:
    let parent_items: List[Bytes] = List[Bytes]()
    arena_scope 4096:
        let local_bytes: Bytes = bytes_from_text("child")
        let nested_lists: List[List[Bytes]] = List[List[Bytes]]()
        list_push(nested_lists, parent_items)
        for target in nested_lists:
            list_push(target, local_bytes)
