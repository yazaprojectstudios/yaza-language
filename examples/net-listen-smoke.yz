use "std/net"

start:
    let listener_result: Result[Number, Text] = tcp_listen("127.0.0.1", 19876, 16)
    if not result_is_ok(listener_result):
        say "FAIL: " + result_unwrap_error(listener_result)
        exit(1)
    let listener: Number = result_unwrap(listener_result)
    say "LISTEN OK: " + number_text(listener)
    let accept_result: Result[Number, Text] = tcp_accept(listener, 10)
    if result_is_ok(accept_result):
        say "UNEXPECTED CLIENT"
        exit(1)
    say "ACCEPT TIMEOUT OK: " + result_unwrap_error(accept_result)
    let close_result: Result[Boolean, Text] = tcp_close(listener)
    if not result_is_ok(close_result):
        say "FAIL CLOSE: " + result_unwrap_error(close_result)
        exit(1)
    say "CLOSE OK"
