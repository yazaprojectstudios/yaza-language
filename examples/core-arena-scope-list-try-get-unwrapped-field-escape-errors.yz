shape Envelope:
    items: List[Bytes]

start:
    let parent_items: List[Bytes] = List[Bytes]()
    arena_scope 4096:
        let local_bytes: Bytes = bytes_from_text("child")
        let values: List[Result[Envelope, Text]] = List[Result[Envelope, Text]]()
        list_push(values, ok(Envelope(parent_items)))
        let maybe: Option[Result[Envelope, Text]] = list_try_get(values, 0)
        let wrapped: Result[Envelope, Text] = option_unwrap(maybe)
        let value: Envelope = result_unwrap(wrapped)
        list_push(value.items, local_bytes)
