shape Link:
    value: Number
    next: Option[Link]

shape Packet:
    revision: Int32
    link: Option[Link]

shape Fault:
    reason: Text
    link: Option[Link]

fn load_packet(succeeds: Boolean) -> Result[Packet, Fault]:
    let chain: Link = Link(11, some(Link(22, none)))
    if succeeds:
        return ok(Packet(int32_from_number(3), some(chain)))
    return err(Fault("not found", some(chain)))

fn relay_packet(result: Result[Packet, Fault]) -> Result[Packet, Fault]:
    return result?

start:
    let success: Result[Packet, Fault] = load_packet(true)
    let failure: Result[Packet, Fault] = load_packet(false)
    assert result_is_ok(success)
    assert number_from_int32(result_unwrap(success).revision) == 3
    assert option_is_some(result_unwrap(success).link)
    let first_link: Link = option_unwrap(result_unwrap(success).link)
    assert first_link.value == 11
    assert option_unwrap(first_link.next).value == 22

    assert not result_is_ok(failure)
    assert result_unwrap_error(failure).reason == "not found"
    let failed_link: Link = option_unwrap(result_unwrap_error(failure).link)
    assert option_unwrap(failed_link.next).value == 22
    match failure:
        ok(packet):
            assert false
        err(problem):
            assert problem.reason == "not found"
            assert option_unwrap(problem.link).value == 11

    let nested: Result[Result[Packet, Fault], Option[Fault]] = ok(success)
    assert result_is_ok(result_unwrap(nested))
    assert number_from_int32(result_unwrap(result_unwrap(nested)).revision) == 3
    let nested_error: Result[Result[Packet, Fault], Option[Fault]] = err(some(Fault("outer", none)))
    assert option_unwrap(result_unwrap_error(nested_error)).reason == "outer"

    let values: List[Result[Packet, Fault]] = List[Result[Packet, Fault]]()
    list_push(values, success)
    list_push(values, failure)
    let fetched: Option[Result[Packet, Fault]] = list_try_get(values, 1)
    assert result_unwrap_error(option_unwrap(fetched)).reason == "not found"
    assert not option_is_some(list_try_get(values, -1))
    assert result_unwrap_error(relay_packet(failure)).reason == "not found"
    say "result-shape-layout-ok"
