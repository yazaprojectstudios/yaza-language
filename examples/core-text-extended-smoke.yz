start:
    let lines: TextList = text_lines("alpha\nbeta\n")
    assert list_count(lines) == 2
    assert list_get(lines, 0) == "alpha"
    assert list_get(lines, 1) == "beta"
    assert list_count(text_lines("")) == 0
    let blank_tail: TextList = text_lines("a\n\n")
    assert list_count(blank_tail) == 2
    assert list_get(blank_tail, 1) == ""

    assert text_trim(" \t\r\n hello \t") == "hello"
    assert text_trim(" \t\r\n") == ""
    assert text_compare("same", "same") == 0
    assert text_compare("alpha", "beta") < 0
    assert text_compare("beta", "alpha") > 0

    let parts: TextList = list_new()
    list_push(parts, "one")
    list_push(parts, "two")
    assert text_join(parts, ",") == "one,two"
    assert text_join(text_list(), ",") == ""

    let bytes: Bytes = bytes_from_text("YAZA")
    assert bytes_to_text(bytes) == "YAZA"
    let secret: Bytes = bytes_from_text("secret")
    assert bytes_zeroize(secret) == 0
    assert bytes_length(secret) == 6
    assert bytes_get(secret, 0) == 0
    assert not option_is_some(bytes_to_text_checked(secret))
