shape CollectionFields:
    numbers: List[Number]
    int32s: List[Int32]
    floats: List[Float64]
    booleans: List[Boolean]
    texts: List[Text]
    bytes_values: List[Bytes]
    nested_numbers: List[List[Number]]
    optional_numbers: Option[List[Number]]
    number_options: List[Option[Number]]
    aliases: TextList

fn copy_collection_fields(value: CollectionFields) -> CollectionFields:
    return value

start:
    var numbers: List[Number] = List[Number]()
    list_push(numbers, 11)
    var int32s: List[Int32] = List[Int32]()
    list_push(int32s, int32_from_number(7))
    var floats: List[Float64] = List[Float64]()
    list_push(floats, 1.25)
    var booleans: List[Boolean] = List[Boolean]()
    list_push(booleans, true)
    var texts: List[Text] = List[Text]()
    list_push(texts, "list-text")
    var bytes_values: List[Bytes] = List[Bytes]()
    list_push(bytes_values, bytes_from_text("list-bytes"))
    var nested_numbers: List[List[Number]] = List[List[Number]]()
    var inner_numbers: List[Number] = List[Number]()
    list_push(inner_numbers, 29)
    list_push(nested_numbers, inner_numbers)
    var number_options: List[Option[Number]] = List[Option[Number]]()
    list_push(number_options, some(41))
    list_push(number_options, none)
    var aliases: TextList = text_list()
    list_push(aliases, "primary")

    let original: CollectionFields = CollectionFields(numbers, int32s, floats, booleans, texts, bytes_values, nested_numbers, some(numbers), number_options, aliases)
    var copied: CollectionFields = copy_collection_fields(original)
    assert list_get(copied.numbers, 0) == 11
    assert number_from_int32(list_get(copied.int32s, 0)) == 7
    assert list_get(copied.floats, 0) == 1.25
    assert list_get(copied.booleans, 0)
    assert list_get(copied.texts, 0) == "list-text"
    assert bytes_equal(list_get(copied.bytes_values, 0), bytes_from_text("list-bytes"))
    assert list_get(list_get(copied.nested_numbers, 0), 0) == 29
    assert list_get(option_unwrap(copied.optional_numbers), 0) == 11
    assert option_unwrap(list_get(copied.number_options, 0)) == 41
    assert not option_is_some(list_get(copied.number_options, 1))
    assert list_get(copied.aliases, 0) == "primary"

    var replacement: List[Number] = List[Number]()
    list_push(replacement, 53)
    set copied.numbers = replacement
    assert list_get(copied.numbers, 0) == 53
    assert list_get(original.numbers, 0) == 11
    say "shape-typed-list-layout-ok"
