    let split_inner_packed: Bytes = yaza_db_page_finalize_v1(split_inner)?
    let split_inner_source: Bytes = yaza_db_page_set_fences_v1(split_inner_packed, true, bytes_from_text("aa"), true, bytes_from_text("zz"))?
    let inner_split: YazaDbInnerSplitV1 = yaza_db_page_split_inner_v1(split_inner_source, 61, 41)?
    let inner_left_header: YazaDbPageHeaderV1 = yaza_db_page_header_decode_v1(inner_split.left_page, 60)?
    let inner_right_header: YazaDbPageHeaderV1 = yaza_db_page_header_decode_v1(inner_split.right_page, 61)?
    let inner_left_high: Bytes = bytes_try_slice(inner_split.left_page, inner_left_header.high_fence_offset, inner_left_header.high_fence_len)?
    let inner_right_low: Bytes = bytes_try_slice(inner_split.right_page, inner_right_header.low_fence_offset, inner_right_header.low_fence_len)?
    let inner_left_low: Bytes = bytes_try_slice(inner_split.left_page, inner_left_header.low_fence_offset, inner_left_header.low_fence_len)?
    let inner_right_high: Bytes = bytes_try_slice(inner_split.right_page, inner_right_header.high_fence_offset, inner_right_header.high_fence_len)?
    let inner_split_left_first: Bytes = yaza_db_page_slot_key_v1(inner_split.left_page, 0, 60)?
    let inner_split_right_first: Bytes = yaza_db_page_slot_key_v1(inner_split.right_page, 0, 61)?
    if inner_split.split_index != 2 or inner_split.left_count != 2 or inner_split.right_count != 2 or bytes_to_text(inner_split.separator) != "cluster-c": return err("YDBv1 inner split did not choose the balanced middle separator")
    if inner_left_header.upper != 24 or inner_right_header.upper != 30 or inner_left_header.level != 2 or inner_right_header.level != 2: return err("YDBv1 inner split did not transfer upper child pointers or preserve levels")
    if not bytes_equal(inner_left_high, inner_split.separator) or not bytes_equal(inner_right_low, inner_split.separator) or bytes_to_text(inner_left_low) != "aa" or bytes_to_text(inner_right_high) != "zz": return err("YDBv1 inner split did not preserve adjacent fences")
    if bytes_to_text(inner_split_left_first) != "cluster-a" or bytes_to_text(inner_split_right_first) != "cluster-d" or inner_left_header.prefix_len != 8 or inner_right_header.prefix_len != 8: return err("YDBv1 inner split did not preserve ordered slots and shared prefixes")
    let inner_source_after: YazaDbPageHeaderV1 = yaza_db_page_header_decode_v1(split_inner_source, 60)?
    if inner_source_after.count != 5 or inner_source_after.page_lsn != 40: return err("YDBv1 inner split modified the source page")
    let inner_bad_page_id: Result[YazaDbInnerSplitV1, Text] = yaza_db_page_split_inner_v1(split_inner_source, 60, 41)
    let inner_bad_lsn: Result[YazaDbInnerSplitV1, Text] = yaza_db_page_split_inner_v1(split_inner_source, 61, 40)
    if result_is_ok(inner_bad_page_id) or result_is_ok(inner_bad_lsn): return err("YDBv1 inner split accepted a duplicate right page ID or non-advancing LSN")
    let malformed_inner: Bytes = yaza_db_page_new_v1(62, 40, 2, 1)?
    if not yaza_db_page_set_upper_v1(malformed_inner, 15): return err("YDBv1 malformed inner fixture could not set its upper child")
    let malformed_child: Bytes = bytes_try_new_zeroed(7)?
    let malformed_child_slot: Number = yaza_db_page_add_slot_v1(malformed_inner, bytes_from_text("a"), malformed_child)?
    let valid_child_slot_b: Number = yaza_db_page_add_slot_v1(malformed_inner, bytes_from_text("b"), split_child_b)?
    let valid_child_slot_c: Number = yaza_db_page_add_slot_v1(malformed_inner, bytes_from_text("c"), split_child_c)?
    if malformed_child_slot != 0 or valid_child_slot_b != 1 or valid_child_slot_c != 2: return err("YDBv1 malformed inner fixture could not add its child payloads")
    let malformed_inner_source: Bytes = yaza_db_page_finalize_v1(malformed_inner)?
    let malformed_inner_split: Result[YazaDbInnerSplitV1, Text] = yaza_db_page_split_inner_v1(malformed_inner_source, 63, 41)
    if result_is_ok(malformed_inner_split): return err("YDBv1 inner split accepted a non-8-byte child pointer")

    let grown_root: YazaDbInnerRootGrowthV1 = yaza_db_page_grow_inner_root_v1(split_inner_source, 64, 65, 42)?
    let grown_root_header: YazaDbPageHeaderV1 = yaza_db_page_header_decode_v1(grown_root.root_page, 60)?
    let grown_root_slot: YazaDbPageSlotV1 = yaza_db_page_slot_v1(grown_root.root_page, 0, 60)?
    let grown_root_left_id: Number = yaza_db_page_inner_child_page_id_v1(grown_root_slot.payload)?
    let grown_left_header: YazaDbPageHeaderV1 = yaza_db_page_header_decode_v1(grown_root.left_child_page, 64)?
    let grown_right_header: YazaDbPageHeaderV1 = yaza_db_page_header_decode_v1(grown_root.right_child_page, 65)?
    if grown_root_header.level != 3 or grown_root_header.count != 1 or grown_root_header.upper != 130 or grown_root_left_id != 64: return err("YDBv1 root growth did not preserve the root ID and install two child pointers")
    if bytes_to_text(grown_root.separator) != "cluster-c" or not bytes_equal(grown_root_slot.key_suffix, bytes_from_text("cluster-c")): return err("YDBv1 root growth did not promote the inner separator")
    if grown_left_header.level != 2 or grown_right_header.level != 2 or grown_left_header.page_lsn != 42 or grown_right_header.page_lsn != 42: return err("YDBv1 root growth child levels or LSNs are incorrect")
    let root_growth_duplicate_child: Result[YazaDbInnerRootGrowthV1, Text] = yaza_db_page_grow_inner_root_v1(split_inner_source, 64, 64, 42)
    let root_growth_stale_lsn: Result[YazaDbInnerRootGrowthV1, Text] = yaza_db_page_grow_inner_root_v1(split_inner_source, 64, 65, 40)
    if result_is_ok(root_growth_duplicate_child) or result_is_ok(root_growth_stale_lsn): return err("YDBv1 root growth accepted duplicate children or a stale LSN")

    let bitmap_page: Bytes = yaza_db_page_new_v1(4, 23, 5, 0)?
    let bitmap_header: YazaDbPageHeaderV1 = yaza_db_page_header_decode_v1(bitmap_page, 4)?
    if yaza_db_bitmap_page_payload_bytes_v1() != 16336 or yaza_db_bitmap_page_bit_count_v1() != 130688: return err("YDBv1 bitmap capacity does not preserve the generic page header")
    if bitmap_header.page_type != 5 or bitmap_header.data_start != 48 or bitmap_header.space_used != 16336: return err("YDBv1 bitmap page header accounting is invalid")
    let first_bit_initial: Boolean = yaza_db_bitmap_page_bit_v1(bitmap_page, 0, 4)?
    let last_bit_initial: Boolean = yaza_db_bitmap_page_bit_v1(bitmap_page, 130687, 4)?
    if first_bit_initial or last_bit_initial: return err("YDBv1 new bitmap page did not initialize all allocation bits to free")
    let first_bit_claimed: Boolean = yaza_db_bitmap_page_set_allocated_v1(bitmap_page, 0, true, 24, 4)?
    let last_bit_claimed: Boolean = yaza_db_bitmap_page_set_allocated_v1(bitmap_page, 130687, true, 24, 4)?
    if not first_bit_claimed or not last_bit_claimed: return err("YDBv1 bitmap boundary bits could not be allocated")
    let first_bit_after_claim: Boolean = yaza_db_bitmap_page_bit_v1(bitmap_page, 0, 4)?
    let last_bit_after_claim: Boolean = yaza_db_bitmap_page_bit_v1(bitmap_page, 130687, 4)?
    if not first_bit_after_claim or not last_bit_after_claim: return err("YDBv1 bitmap allocation bits did not round-trip")
    let repeated_claim: Boolean = yaza_db_bitmap_page_set_allocated_v1(bitmap_page, 0, true, 25, 4)?
    if repeated_claim: return err("YDBv1 bitmap update reported a change when the bit already matched")
    let bitmap_after_idempotent: YazaDbPageHeaderV1 = yaza_db_page_header_decode_v1(bitmap_page, 4)?
    if bitmap_after_idempotent.page_lsn != 24: return err("YDBv1 no-op bitmap update changed the page LSN")
    let released_bit: Boolean = yaza_db_bitmap_page_set_allocated_v1(bitmap_page, 0, false, 25, 4)?
    let first_bit_after_release: Boolean = yaza_db_bitmap_page_bit_v1(bitmap_page, 0, 4)?
    if not released_bit or first_bit_after_release: return err("YDBv1 bitmap bit could not be freed")
    let bitmap_bad_index: Result[Boolean, Text] = yaza_db_bitmap_page_bit_v1(bitmap_page, 130688, 4)
    if result_is_ok(bitmap_bad_index): return err("YDBv1 bitmap reader accepted an out-of-range bit")
    let bitmap_backwards_lsn: Result[Boolean, Text] = yaza_db_bitmap_page_set_allocated_v1(bitmap_page, 1, true, 24, 4)
    if result_is_ok(bitmap_backwards_lsn): return err("YDBv1 bitmap writer accepted a backwards page LSN")
    let bitmap_type_mismatch: Result[Boolean, Text] = yaza_db_bitmap_page_bit_v1(finished_page, 0, 2)
    if result_is_ok(bitmap_type_mismatch): return err("YDBv1 bitmap reader accepted a non-BITMAP page")
    let bitmap_search_type: Result[Number, Text] = yaza_db_page_lower_bound_v1(bitmap_page, bytes_from_text("alpha"), 4)
    if result_is_ok(bitmap_search_type): return err("YDBv1 lower-bound search accepted a BITMAP page")

    let first_range_start: YazaDbBitmapAddressV1 = yaza_db_bitmap_address_v1(2)?
    let first_range_data: YazaDbBitmapAddressV1 = yaza_db_bitmap_address_v1(3)?
    let first_range_end: YazaDbBitmapAddressV1 = yaza_db_bitmap_address_v1(130689)?
    let second_range_start: YazaDbBitmapAddressV1 = yaza_db_bitmap_address_v1(130690)?
    let second_range_data: YazaDbBitmapAddressV1 = yaza_db_bitmap_address_v1(130691)?
    if first_range_start.bitmap_page_id != 2 or first_range_start.bit_index != 0 or not first_range_start.is_bitmap_page: return err("YDBv1 first BITMAP range did not begin at page 2")
    if first_range_data.bitmap_page_id != 2 or first_range_data.bit_index != 1 or first_range_data.is_bitmap_page: return err("YDBv1 first data page did not map to the second bit")
    if first_range_end.bitmap_page_id != 2 or first_range_end.bit_index != 130687: return err("YDBv1 last page in the first BITMAP range mapped incorrectly")
    if second_range_start.bitmap_page_id != 130690 or second_range_start.bit_index != 0 or second_range_start.segment_index != 1 or not second_range_start.is_bitmap_page: return err("YDBv1 second BITMAP range did not start after exactly 130,688 page IDs")
    if second_range_data.bitmap_page_id != 130690 or second_range_data.bit_index != 1: return err("YDBv1 second range data page mapped incorrectly")
    let header_page_address: Result[YazaDbBitmapAddressV1, Text] = yaza_db_bitmap_address_v1(1)
    if result_is_ok(header_page_address): return err("YDBv1 allocation mapping accepted a file-header page")

    let mapped_bitmap: Bytes = yaza_db_bitmap_page_new_mapped_v1(2, 23)?
    let mapped_self: Boolean = yaza_db_bitmap_page_bit_for_page_v1(mapped_bitmap, 2, 2)?
    let mapped_first_data_initial: Boolean = yaza_db_bitmap_page_bit_for_page_v1(mapped_bitmap, 3, 2)?
    if not mapped_self or mapped_first_data_initial: return err("YDBv1 mapped BITMAP did not reserve itself and leave data free")
    let first_free_after_metadata: Number = yaza_db_bitmap_page_find_free_v1(mapped_bitmap, 0, 130688, 2)?
    if first_free_after_metadata != 1: return err("YDBv1 allocator scan did not skip the reserved BITMAP page")
    let mapped_first_data_claimed: Boolean = yaza_db_bitmap_page_set_page_allocated_v1(mapped_bitmap, 3, true, 24, 2)?
    let mapped_first_data_after_claim: Boolean = yaza_db_bitmap_page_bit_for_page_v1(mapped_bitmap, 3, 2)?
    let mapped_page_ten_claimed: Boolean = yaza_db_bitmap_page_set_page_allocated_v1(mapped_bitmap, 10, true, 25, 2)?
    let first_free_after_claim: Number = yaza_db_bitmap_page_find_free_v1(mapped_bitmap, 0, 130688, 2)?
    let partial_byte_free: Number = yaza_db_bitmap_page_find_free_v1(mapped_bitmap, 8, 10, 2)?
    let partial_byte_full: Number = yaza_db_bitmap_page_find_free_v1(mapped_bitmap, 8, 9, 2)?
    let empty_search: Number = yaza_db_bitmap_page_find_free_v1(mapped_bitmap, 7, 7, 2)?
    if not mapped_page_ten_claimed or first_free_after_claim != 2: return err("YDBv1 free-bit scan did not find the first available page")
    if partial_byte_free != 9 or partial_byte_full != -1 or empty_search != -1: return err("YDBv1 free-bit scan mishandled partial-byte or empty ranges")
    let mapped_last_data_claimed: Boolean = yaza_db_bitmap_page_set_page_allocated_v1(mapped_bitmap, 130689, true, 26, 2)?
    let mapped_last_data_after_claim: Boolean = yaza_db_bitmap_page_bit_for_page_v1(mapped_bitmap, 130689, 2)?
    if not mapped_first_data_claimed or not mapped_first_data_after_claim or not mapped_last_data_claimed or not mapped_last_data_after_claim: return err("YDBv1 mapped allocation bits did not update at range boundaries")
    let mapped_last_range_free: Number = yaza_db_bitmap_page_find_free_v1(mapped_bitmap, 130687, 130688, 2)?
    if mapped_last_range_free != -1: return err("YDBv1 free-bit scan ignored an allocated final page")
    let invalid_scan_range: Result[Number, Text] = yaza_db_bitmap_page_find_free_v1(mapped_bitmap, 2, 130689, 2)
    if result_is_ok(invalid_scan_range): return err("YDBv1 free-bit scan accepted an out-of-range endpoint")
    let mapped_self_free: Result[Boolean, Text] = yaza_db_bitmap_page_set_page_allocated_v1(mapped_bitmap, 2, false, 27, 2)
    if result_is_ok(mapped_self_free): return err("YDBv1 allocator marked a BITMAP metadata page free")
    let mapped_wrong_range: Result[Boolean, Text] = yaza_db_bitmap_page_bit_for_page_v1(mapped_bitmap, 130690, 2)
    if result_is_ok(mapped_wrong_range): return err("YDBv1 BITMAP lookup accepted a page from the next range")
    let next_mapped_bitmap: Bytes = yaza_db_bitmap_page_new_mapped_v1(130690, 26)?
    let next_mapped_self: Boolean = yaza_db_bitmap_page_bit_for_page_v1(next_mapped_bitmap, 130690, 130690)?
    if not next_mapped_self: return err("YDBv1 second-range BITMAP did not reserve itself")
    let invalid_mapped_page: Result[Bytes, Text] = yaza_db_bitmap_page_new_mapped_v1(4, 23)
    if result_is_ok(invalid_mapped_page): return err("YDBv1 mapped BITMAP constructor accepted a non-range-start page ID")

    let checksum_corruption: Bytes = bytes_try_slice(finished_page, 0, 16384)?
    if not bytes_try_set(checksum_corruption, 500, 1): return err("YDBv1 corruption fixture could not be written")
    if result_is_ok(yaza_db_page_header_decode_v1(checksum_corruption, 2)): return err("YDBv1 page CRC failed to detect corruption")

    let overlapping_prefix: Bytes = bytes_try_slice(finished_page, 0, 16384)?
    if not yaza_db_write_uint_le_v1(overlapping_prefix, 20, 2048, 2): return err("YDBv1 prefix-overlap fixture could not be written")
    let resealed_prefix: Bytes = yaza_db_page_finalize_v1(overlapping_prefix)?
    if result_is_ok(yaza_db_page_header_decode_v1(resealed_prefix, 2)): return err("YDBv1 page validator accepted shared-prefix data overlapping the slot body")

    let reversed_fences: Bytes = bytes_try_slice(finished_page, 0, 16384)?
    if not bytes_try_set(reversed_fences, 16362, 122) or not bytes_try_set(reversed_fences, 16363, 97): return err("YDBv1 fence-order fixture could not be written")
    if not yaza_db_write_uint_le_v1(reversed_fences, 16, 46, 2) or not yaza_db_write_uint_le_v1(reversed_fences, 18, 16362, 2): return err("YDBv1 fence-order accounting could not be written")
    if not yaza_db_write_uint_le_v1(reversed_fences, 24, 16362, 2) or not yaza_db_write_uint_le_v1(reversed_fences, 26, 1, 2): return err("YDBv1 low fence could not be written")
    if not yaza_db_write_uint_le_v1(reversed_fences, 28, 16363, 2) or not yaza_db_write_uint_le_v1(reversed_fences, 30, 1, 2): return err("YDBv1 high fence could not be written")
    let resealed_fences: Bytes = yaza_db_page_finalize_v1(reversed_fences)?
    if result_is_ok(yaza_db_page_header_decode_v1(resealed_fences, 2)): return err("YDBv1 page validator accepted reversed low/high fences")

    let overlapping_slots: Bytes = bytes_try_slice(finished_page, 0, 16384)?
    let first_offset: Number = yaza_db_read_uint_le_v1(overlapping_slots, 48, 2)?
    if not yaza_db_write_uint_le_v1(overlapping_slots, 60, first_offset, 2): return err("YDBv1 overlap fixture could not be written")
    let resealed_overlap: Bytes = yaza_db_page_finalize_v1(overlapping_slots)?
    if result_is_ok(yaza_db_page_header_decode_v1(resealed_overlap, 2)): return err("YDBv1 page validator accepted overlapping slot bodies")

    let bad_order: Result[Number, Text] = yaza_db_page_add_slot_v1(page, bytes_from_text("aardvark"), bytes_from_text("row-c"))
    if result_is_ok(bad_order): return err("YDBv1 writer accepted out-of-order key")
    let wrong_page: Result[YazaDbPageHeaderV1, Text] = yaza_db_page_header_decode_v1(finished_page, 3)
    if result_is_ok(wrong_page): return err("YDBv1 page-location mismatch was accepted")
    return ok(page_header.count)

start:
    let outcome: Result[Number, Text] = yaza_base_page_v1_check()
    if result_is_ok(outcome):
        say "yazabase-page-v1-ok slots=" + number_text(result_unwrap(outcome))
    else:
        say result_unwrap_error(outcome)
