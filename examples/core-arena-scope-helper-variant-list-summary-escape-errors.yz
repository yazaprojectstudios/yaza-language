shape Payload:
    items: Option[Result[List[Bytes], Text]]

variant Inbox:
    Empty
    Data(payload: Payload)

fn append_inner(inbox: Inbox, value: Bytes) -> Unit:
    match inbox:
        Empty:
            assert true
        Data(payload):
            match payload.items:
                some(result):
                    match result:
                        ok(items):
                            list_push(items, value)
                        err(_):
                            assert true
                none:
                    assert true

fn append_outer(inbox: Inbox, value: Bytes) -> Unit:
    append_inner(inbox, value)

start:
    let inbox: Inbox = Inbox::Data(Payload(some(ok(List[Bytes]()))))
    let output: List[Bytes] = List[Bytes]()
    arena_scope 4096:
        let child_bytes: Bytes = bytes_from_text("child")
        append_outer(inbox, child_bytes)
        match inbox:
            Empty:
                assert false
            Data(payload):
                match payload.items:
                    some(result):
                        match result:
                            ok(items):
                                let escaped: Bytes = list_get(items, 0)
                                list_push(output, escaped)
                            err(_):
                                assert false
                    none:
                        assert false
