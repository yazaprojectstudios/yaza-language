use "../yazabase/key_codec_v1"
use "../yazabase/sql_executor_v1"
use "../yazabase/page_v1"

fn yaza_base_key_v1_integer(type_id: Number, value: Number) -> Result[Bytes, Text]:
    let columns: List[YazaSqlColumnSchemaV1] = List[YazaSqlColumnSchemaV1]()
    let values: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let nulls: List[Boolean] = List[Boolean]()
    let ordinals: List[Number] = List[Number]()
    list_push(columns, YazaSqlColumnSchemaV1("key", type_id, false, 0, 0, 0, ""))
    let integer_value: YazaSqlValueV1 = yaza_sql_value_integer_v1(type_id, value)?
    list_push(values, integer_value)
    list_push(nulls, false)
    list_push(ordinals, 0)
    return yaza_db_key_encode_composite_v1(values, nulls, columns, ordinals)

fn yaza_base_key_v1_text(value: Text) -> Result[Bytes, Text]:
    let columns: List[YazaSqlColumnSchemaV1] = List[YazaSqlColumnSchemaV1]()
    let values: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let nulls: List[Boolean] = List[Boolean]()
    let ordinals: List[Number] = List[Number]()
    list_push(columns, YazaSqlColumnSchemaV1("key", 9, false, 0, 0, 0, ""))
    list_push(values, yaza_sql_value_text_v1(value))
    list_push(nulls, false)
    list_push(ordinals, 0)
    return yaza_db_key_encode_composite_v1(values, nulls, columns, ordinals)

fn yaza_base_key_v1_double(value: Float64) -> Result[Bytes, Text]:
    let columns: List[YazaSqlColumnSchemaV1] = List[YazaSqlColumnSchemaV1]()
    let values: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let nulls: List[Boolean] = List[Boolean]()
    let ordinals: List[Number] = List[Number]()
    list_push(columns, YazaSqlColumnSchemaV1("key", 6, false, 0, 0, 0, ""))
    list_push(values, yaza_sql_value_double_v1(value))
    list_push(nulls, false)
    list_push(ordinals, 0)
    return yaza_db_key_encode_composite_v1(values, nulls, columns, ordinals)

fn yaza_base_key_v1_check() -> Result[Number, Text]:
    let small_min: Bytes = yaza_base_key_v1_integer(2, -32768)?
    let small_negative: Bytes = yaza_base_key_v1_integer(2, -1)?
    let small_zero: Bytes = yaza_base_key_v1_integer(2, 0)?
    let small_max: Bytes = yaza_base_key_v1_integer(2, 32767)?
    if yaza_db_compare_bytes_v1(small_min, small_negative) >= 0 or yaza_db_compare_bytes_v1(small_negative, small_zero) >= 0 or yaza_db_compare_bytes_v1(small_zero, small_max) >= 0: return err("YDBv1 SMALLINT sort keys are not in signed numeric order")
    if bytes_get(small_min, 2) != 0 or bytes_get(small_min, 3) != 0 or bytes_get(small_max, 2) != 255 or bytes_get(small_max, 3) != 255: return err("YDBv1 SMALLINT sort-key sign-bit transformation is incorrect")

    let int_min: Bytes = yaza_base_key_v1_integer(3, -2147483648)?
    let int_zero: Bytes = yaza_base_key_v1_integer(3, 0)?
    let int_max: Bytes = yaza_base_key_v1_integer(3, 2147483647)?
    if yaza_db_compare_bytes_v1(int_min, int_zero) >= 0 or yaza_db_compare_bytes_v1(int_zero, int_max) >= 0: return err("YDBv1 INTEGER sort keys are not in signed numeric order")
    let bigint_min: Number = -9223372036854775807 - 1
    let big_min: Bytes = yaza_base_key_v1_integer(4, bigint_min)?
    let big_max: Bytes = yaza_base_key_v1_integer(4, 9223372036854775807)?
    if yaza_db_compare_bytes_v1(big_min, big_max) >= 0: return err("YDBv1 BIGINT sort keys are not in signed numeric order")

    let bool_columns: List[YazaSqlColumnSchemaV1] = List[YazaSqlColumnSchemaV1]()
    list_push(bool_columns, YazaSqlColumnSchemaV1("key", 1, false, 0, 0, 0, ""))
    let false_values: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    list_push(false_values, yaza_sql_value_boolean_v1(false))
    let true_values: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    list_push(true_values, yaza_sql_value_boolean_v1(true))
    let bool_nulls: List[Boolean] = List[Boolean]()
    list_push(bool_nulls, false)
    let bool_ordinals: List[Number] = List[Number]()
    list_push(bool_ordinals, 0)
    let false_key: Bytes = yaza_db_key_encode_composite_v1(false_values, bool_nulls, bool_columns, bool_ordinals)?
    let true_key: Bytes = yaza_db_key_encode_composite_v1(true_values, bool_nulls, bool_columns, bool_ordinals)?
    if yaza_db_compare_bytes_v1(false_key, true_key) >= 0: return err("YDBv1 BOOLEAN sort keys are not false-before-true")

    let text_a: Bytes = yaza_base_key_v1_text("a")?
    let text_aa: Bytes = yaza_base_key_v1_text("aa")?
    let text_ab: Bytes = yaza_base_key_v1_text("ab")?
    if yaza_db_compare_bytes_v1(text_a, text_aa) >= 0 or yaza_db_compare_bytes_v1(text_aa, text_ab) >= 0: return err("YDBv1 TEXT sort keys are not in bytewise UTF-8 order")
    if bytes_length(text_a) != 5 or bytes_get(text_a, 0) != 1 or bytes_get(text_a, 1) != 9 or bytes_get(text_a, 2) != 97 or bytes_get(text_a, 3) != 0 or bytes_get(text_a, 4) != 0: return err("YDBv1 TEXT index key is not canonically terminated")

    let negative_double: Bytes = yaza_base_key_v1_double(-100.0)?
    let negative_one: Bytes = yaza_base_key_v1_double(-1.0)?
    let negative_zero: Bytes = yaza_base_key_v1_double(float64_from_bits(-9223372036854775807 - 1))?
    let positive_zero: Bytes = yaza_base_key_v1_double(0.0)?
    let positive_one: Bytes = yaza_base_key_v1_double(1.0)?
    let positive_hundred: Bytes = yaza_base_key_v1_double(100.0)?
    if yaza_db_compare_bytes_v1(negative_double, negative_one) >= 0 or yaza_db_compare_bytes_v1(negative_one, negative_zero) >= 0 or yaza_db_compare_bytes_v1(positive_zero, positive_one) >= 0 or yaza_db_compare_bytes_v1(positive_one, positive_hundred) >= 0: return err("YDBv1 finite DOUBLE sort keys are not in numeric order")
    if not bytes_equal(negative_zero, positive_zero): return err("YDBv1 DOUBLE sort keys must canonicalize signed zero")
    let nan_value: Float64 = float64_from_bits(-2251799813685248)
    let nan_key: Result[Bytes, Text] = yaza_base_key_v1_double(nan_value)
    if result_is_ok(nan_key): return err("YDBv1 DOUBLE index key accepted a NaN value")

    let nullable_columns: List[YazaSqlColumnSchemaV1] = List[YazaSqlColumnSchemaV1]()
    let nullable_values: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let nullable_nulls: List[Boolean] = List[Boolean]()
    let nullable_ordinals: List[Number] = List[Number]()
    list_push(nullable_columns, YazaSqlColumnSchemaV1("key", 3, true, 0, 0, 0, ""))
    list_push(nullable_values, yaza_sql_executor_value_v1(3, 0, 0.0, false, ""))
    list_push(nullable_nulls, true)
    list_push(nullable_ordinals, 0)
    let null_key: Bytes = yaza_db_key_encode_composite_v1(nullable_values, nullable_nulls, nullable_columns, nullable_ordinals)?
    if bytes_get(null_key, 0) != 0: return err("YDBv1 NULL index key is not ordered before non-NULL values")
    let nullable_non_nulls: List[Boolean] = List[Boolean]()
    list_push(nullable_non_nulls, false)
    let nullable_value_key: Bytes = yaza_db_key_encode_composite_v1(nullable_values, nullable_non_nulls, nullable_columns, nullable_ordinals)?
    if yaza_db_compare_bytes_v1(null_key, nullable_value_key) >= 0: return err("YDBv1 NULL index key does not sort before a non-NULL value")

    let composite_columns: List[YazaSqlColumnSchemaV1] = List[YazaSqlColumnSchemaV1]()
    list_push(composite_columns, YazaSqlColumnSchemaV1("id", 3, false, 0, 0, 0, ""))
    list_push(composite_columns, YazaSqlColumnSchemaV1("name", 9, false, 1, 0, 0, ""))
    let composite_ordinals: List[Number] = List[Number]()
    list_push(composite_ordinals, 0)
    list_push(composite_ordinals, 1)
    let composite_first_values: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let composite_first_id: YazaSqlValueV1 = yaza_sql_value_integer_v1(3, -1)?
    list_push(composite_first_values, composite_first_id)
    list_push(composite_first_values, yaza_sql_value_text_v1("z"))
    let composite_second_values: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let composite_second_id: YazaSqlValueV1 = yaza_sql_value_integer_v1(3, 0)?
    list_push(composite_second_values, composite_second_id)
    list_push(composite_second_values, yaza_sql_value_text_v1("a"))
    let composite_middle_values: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let composite_middle_id: YazaSqlValueV1 = yaza_sql_value_integer_v1(3, 0)?
    list_push(composite_middle_values, composite_middle_id)
    list_push(composite_middle_values, yaza_sql_value_text_v1("aa"))
    let composite_third_values: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let composite_third_id: YazaSqlValueV1 = yaza_sql_value_integer_v1(3, 0)?
    list_push(composite_third_values, composite_third_id)
    list_push(composite_third_values, yaza_sql_value_text_v1("b"))
    let composite_not_nulls: List[Boolean] = List[Boolean]()
    list_push(composite_not_nulls, false)
    list_push(composite_not_nulls, false)
    let composite_first_key: Bytes = yaza_db_key_encode_composite_v1(composite_first_values, composite_not_nulls, composite_columns, composite_ordinals)?
    let composite_second_key: Bytes = yaza_db_key_encode_composite_v1(composite_second_values, composite_not_nulls, composite_columns, composite_ordinals)?
    let composite_middle_key: Bytes = yaza_db_key_encode_composite_v1(composite_middle_values, composite_not_nulls, composite_columns, composite_ordinals)?
    let composite_third_key: Bytes = yaza_db_key_encode_composite_v1(composite_third_values, composite_not_nulls, composite_columns, composite_ordinals)?
    if yaza_db_compare_bytes_v1(composite_first_key, composite_second_key) >= 0 or yaza_db_compare_bytes_v1(composite_second_key, composite_middle_key) >= 0 or yaza_db_compare_bytes_v1(composite_middle_key, composite_third_key) >= 0: return err("YDBv1 composite keys do not preserve ordinal then value ordering")
    let composite_page_builder: Bytes = yaza_db_page_new_v1(40, 80, 1, 0)?
    let composite_page_first: Number = yaza_db_page_add_slot_v1(composite_page_builder, composite_first_key, bytes_from_text("row-1"))?
    let composite_page_second: Number = yaza_db_page_add_slot_v1(composite_page_builder, composite_second_key, bytes_from_text("row-2"))?
    let composite_page_third: Number = yaza_db_page_add_slot_v1(composite_page_builder, composite_third_key, bytes_from_text("row-3"))?
    if composite_page_first != 0 or composite_page_second != 1 or composite_page_third != 2: return err("YDBv1 encoded composite keys could not populate a sorted leaf")
    let composite_page: Bytes = yaza_db_page_finalize_v1(composite_page_builder)?
    let composite_lower_bound: Number = yaza_db_page_lower_bound_v1(composite_page, composite_middle_key, 40)?
    let composite_inserted: Bytes = yaza_db_page_insert_slot_v1(composite_page, composite_middle_key, bytes_from_text("row-mid"))?
    let composite_inserted_key: Bytes = yaza_db_page_slot_key_v1(composite_inserted, 2, 40)?
    if composite_lower_bound != 2 or not bytes_equal(composite_inserted_key, composite_middle_key): return err("YDBv1 encoded composite key did not search and insert through the B+Tree page codec")

    let duplicate_ordinals: List[Number] = List[Number]()
    list_push(duplicate_ordinals, 0)
    list_push(duplicate_ordinals, 0)
    let duplicate_columns: List[YazaSqlColumnSchemaV1] = List[YazaSqlColumnSchemaV1]()
    list_push(duplicate_columns, YazaSqlColumnSchemaV1("first", 1, false, 0, 0, 0, ""))
    list_push(duplicate_columns, YazaSqlColumnSchemaV1("second", 1, false, 1, 0, 0, ""))
    let duplicate_values: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    list_push(duplicate_values, yaza_sql_value_boolean_v1(false))
    list_push(duplicate_values, yaza_sql_value_boolean_v1(true))
    let duplicate_nulls: List[Boolean] = List[Boolean]()
    list_push(duplicate_nulls, false)
    list_push(duplicate_nulls, false)
    let duplicate_key: Result[Bytes, Text] = yaza_db_key_encode_composite_v1(duplicate_values, duplicate_nulls, duplicate_columns, duplicate_ordinals)
    if result_is_ok(duplicate_key): return err("YDBv1 composite-key encoder accepted duplicate ordinals")
    return ok(bytes_length(big_min) + bytes_length(text_a) + bytes_length(positive_hundred))

start:
    let outcome: Result[Number, Text] = yaza_base_key_v1_check()
    if result_is_ok(outcome):
        say "yazabase-key-v1-ok bytes=" + number_text(result_unwrap(outcome))
    else:
        say result_unwrap_error(outcome)
