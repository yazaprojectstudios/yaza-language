use "std/url"

start:
    let parsed: Result[WebUrl, Text] = url_parse_http("HTTPS://Example.COM:8443/a%20b?q=x&mode=one#section")
    assert result_is_ok(parsed)
    let url: WebUrl = result_unwrap(parsed)
    assert url.scheme == "https"
    assert url.host == "Example.COM"
    assert url.host_kind == "dns"
    assert option_is_some(url.port)
    assert number_from_int32(option_unwrap(url.port)) == 8443
    assert url.path == "/a%20b"
    assert option_unwrap(url.query) == "q=x&mode=one"
    assert option_unwrap(url.fragment) == "section"

    let ipv6: Result[WebUrl, Text] = url_parse_http("https://[2001:db8::1]:443/catalog")
    assert result_is_ok(ipv6)
    assert result_unwrap(ipv6).host == "2001:db8::1"
    assert result_unwrap(ipv6).host_kind == "ipv6"

    let rejected: Result[WebUrl, Text] = url_parse_http("https://bad_name.example/path")
    assert not result_is_ok(rejected)
