fn scan_and_mutate(values: List[Number]) -> Text:
    var index: Number = 0
    var output: Text = ""
    while index < list_count(values):
        let value: Number = list_get(values, index)
        set output = output + number_text(value)
        if index == 0:
            list_set(values, 1, 9)
            list_push(values, 3)
        set index = index + 1
    return output

start:
    var values: List[Number] = List[Number]()
    list_push(values, 1)
    list_push(values, 2)
    let output: Text = scan_and_mutate(values)
    assert output == "193"
    assert list_count(values) == 3
    say output
