use "std/ybif"

start:
    let cols: List[Text] = List[Text]()
    list_push(cols, "id")
    list_push(cols, "name")

    let rows: List[Text] = List[Text]()
    list_push(rows, "[1, \"apple\"]")
    list_push(rows, "[2, \"banana\"]")

    let encoded: Bytes = ybif_encode_sql_result(cols, rows, 2)
    if not ybif_is_valid_header(encoded):
        say "FAIL: invalid YBIF header"
        exit(1)
    say "YBIF header valid, total bytes: " + number_text(bytes_length(encoded))
    say "YBIF SMOKE PASS"
