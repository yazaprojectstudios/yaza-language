variant StorageError:
    Missing
    Unavailable(message: Text)

variant ApplicationError:
    MissingRecord
    Storage(message: Text)

impl From[StorageError] for ApplicationError:
    fn from(error: StorageError) -> ApplicationError:
        match error:
            Missing:
                return ApplicationError::MissingRecord
            Unavailable(message):
                return ApplicationError::Storage(message)
        return ApplicationError::Storage("unreachable")
