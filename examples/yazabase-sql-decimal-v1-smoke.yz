use "../yazabase/sql_decimal_v1"
use "../yazabase/row_v1"

fn yaza_base_decimal_smoke_v1() -> Result[Boolean, Text]:
    let positive: YazaSqlDecimalV1 = yaza_sql_decimal_parse_v1("123.45", 5, 2)?
    let positive_text: Text = yaza_sql_decimal_to_text_v1(positive)?
    if positive_text != "123.45": return err("YazaBase DECIMAL positive formatting is wrong")
    let positive_twelve: YazaSqlDecimalV1 = yaza_sql_decimal_parse_v1("1.20", 5, 2)?
    let positive_twelve_text: Text = yaza_sql_decimal_to_text_v1(positive_twelve)?
    let negative: YazaSqlDecimalV1 = yaza_sql_decimal_parse_v1("-1.20", 5, 2)?
    let negative_text: Text = yaza_sql_decimal_to_text_v1(negative)?
    if positive_twelve_text != "1.20": return err("YazaBase DECIMAL small positive formatting is wrong: " + positive_twelve_text)
    if negative_text != "-1.20": return err("YazaBase DECIMAL negative formatting is wrong: " + negative_text + " from " + positive_twelve_text)
    let aligned: YazaSqlDecimalV1 = yaza_sql_decimal_parse_v1("1.2", 5, 2)?
    let sign_order: Number = yaza_sql_decimal_compare_v1(negative, aligned)?
    if sign_order >= 0: return err("YazaBase DECIMAL comparison mishandled signs")
    let one_scale_one: YazaSqlDecimalV1 = yaza_sql_decimal_parse_v1("1.2", 5, 1)?
    let one_scale_two: YazaSqlDecimalV1 = yaza_sql_decimal_parse_v1("1.20", 5, 2)?
    let cross_scale_order: Number = yaza_sql_decimal_compare_v1(one_scale_one, one_scale_two)?
    if cross_scale_order != 0: return err("YazaBase DECIMAL comparison mishandled equal values with different scales")
    let tenth: YazaSqlDecimalV1 = yaza_sql_decimal_parse_v1("0.1", 5, 1)?
    let twelve_hundredths: YazaSqlDecimalV1 = yaza_sql_decimal_parse_v1("0.12", 5, 2)?
    let fractional_order: Number = yaza_sql_decimal_compare_v1(tenth, twelve_hundredths)?
    if fractional_order >= 0: return err("YazaBase DECIMAL comparison mishandled fractional values with different scales")
    let negative_two: YazaSqlDecimalV1 = yaza_sql_decimal_parse_v1("-2.00", 5, 2)?
    let negative_one: YazaSqlDecimalV1 = yaza_sql_decimal_parse_v1("-1.00", 5, 2)?
    let negative_order: Number = yaza_sql_decimal_compare_v1(negative_two, negative_one)?
    if negative_order >= 0: return err("YazaBase DECIMAL comparison mishandled negative magnitudes")
    if yaza_sql_decimal_compare_text_v1("1.2", "1.20") != 0: return err("YazaBase DECIMAL canonical-text comparison mishandled scale padding")
    if yaza_sql_decimal_compare_text_v1("9.99", "10.00") >= 0: return err("YazaBase DECIMAL canonical-text comparison mishandled integer digit counts")
    if yaza_sql_decimal_compare_text_v1("-10.0", "-9.99") >= 0: return err("YazaBase DECIMAL canonical-text comparison mishandled negative magnitudes")
    if yaza_sql_decimal_compare_text_v1("-0.01", "0.00") >= 0: return err("YazaBase DECIMAL canonical-text comparison mishandled signs")
    let padded_equal: YazaSqlDecimalV1 = yaza_sql_decimal_parse_v1("123.4500", 5, 2)?
    let equal_order: Number = yaza_sql_decimal_compare_v1(positive, padded_equal)?
    if equal_order != 0: return err("YazaBase DECIMAL comparison failed to accept zero excess fractional digits")
    let one: YazaSqlDecimalV1 = yaza_sql_decimal_parse_v1("1.25", 5, 2)?
    let two: YazaSqlDecimalV1 = yaza_sql_decimal_parse_v1("2.75", 5, 2)?
    let sum: YazaSqlDecimalV1 = yaza_sql_decimal_add_v1(one, two, 5)?
    let sum_text: Text = yaza_sql_decimal_to_text_v1(sum)?
    if sum_text != "4.00": return err("YazaBase DECIMAL addition or scale preservation failed")
    let difference: YazaSqlDecimalV1 = yaza_sql_decimal_subtract_v1(one, two, 5)?
    let difference_text: Text = yaza_sql_decimal_to_text_v1(difference)?
    if difference_text != "-1.50": return err("YazaBase DECIMAL subtraction failed")
    let zero_decimal: YazaSqlDecimalV1 = yaza_sql_decimal_parse_v1("0.00", 5, 2)?
    let minus_zero: YazaSqlDecimalV1 = yaza_sql_decimal_subtract_v1(one, zero_decimal, 5)?
    let minus_zero_text: Text = yaza_sql_decimal_to_text_v1(minus_zero)?
    if minus_zero_text != "1.25": return err("YazaBase DECIMAL zero subtraction failed")
    let self_difference: YazaSqlDecimalV1 = yaza_sql_decimal_subtract_v1(one, one, 5)?
    let self_difference_text: Text = yaza_sql_decimal_to_text_v1(self_difference)?
    if self_difference_text != "0.00": return err("YazaBase DECIMAL self subtraction failed")
    let add_mixed_scale: YazaSqlDecimalV1 = yaza_sql_decimal_add_common_scale_v1(one_scale_one, one_scale_two, 6)?
    let add_mixed_scale_text: Text = yaza_sql_decimal_to_text_v1(add_mixed_scale)?
    if add_mixed_scale_text != "2.40": return err("YazaBase DECIMAL addition did not align scales exactly")
    let rescaled: YazaSqlDecimalV1 = yaza_sql_decimal_rescale_v1(one, 6, 3)?
    let rescaled_text: Text = yaza_sql_decimal_to_text_v1(rescaled)?
    if rescaled_text != "1.250": return err("YazaBase DECIMAL exact scale increase failed")
    let rescaled_down: YazaSqlDecimalV1 = yaza_sql_decimal_rescale_v1(rescaled, 5, 2)?
    let rescaled_down_text: Text = yaza_sql_decimal_to_text_v1(rescaled_down)?
    if rescaled_down_text != "1.25": return err("YazaBase DECIMAL exact scale reduction failed")
    let non_exact: YazaSqlDecimalV1 = yaza_sql_decimal_parse_v1("1.251", 5, 3)?
    let lossy_result: Result[YazaSqlDecimalV1, Text] = yaza_sql_decimal_rescale_v1(non_exact, 5, 2)
    if result_is_ok(lossy_result): return err("YazaBase DECIMAL allowed lossy scale reduction")
    let zero: YazaSqlDecimalV1 = yaza_sql_decimal_parse_v1("-0.000", 4, 3)?
    let zero_text: Text = yaza_sql_decimal_to_text_v1(zero)?
    if zero_text != "0.000": return err("YazaBase DECIMAL negative zero was not canonicalized")
    if result_is_ok(yaza_sql_decimal_parse_v1("1.234", 5, 2)): return err("YazaBase DECIMAL accepted non-zero excess fractional digits")
    if result_is_ok(yaza_sql_decimal_parse_v1("1000", 3, 0)): return err("YazaBase DECIMAL accepted a precision overflow")
    if result_is_ok(yaza_sql_decimal_parse_v1("1e3", 5, 2)): return err("YazaBase DECIMAL accepted exponent notation without a defined conversion")
    if result_is_ok(yaza_sql_decimal_parse_v1("1.2.3", 5, 2)): return err("YazaBase DECIMAL accepted multiple decimal points")
    let high: YazaSqlDecimalV1 = yaza_sql_decimal_parse_v1("99999999999999999999999999999999999999", 38, 0)?
    let high_text: Text = yaza_sql_decimal_to_text_v1(high)?
    if high_text != "99999999999999999999999999999999999999": return err("YazaBase DECIMAL 38-digit positive boundary failed")
    let low: YazaSqlDecimalV1 = yaza_sql_decimal_parse_v1("-99999999999999999999999999999999999999", 38, 0)?
    let low_text: Text = yaza_sql_decimal_to_text_v1(low)?
    if low_text != "-99999999999999999999999999999999999999": return err("YazaBase DECIMAL 38-digit negative boundary failed")
    let high_key: Bytes = yaza_sql_decimal_order_key_v1(high)?
    let low_key: Bytes = yaza_sql_decimal_order_key_v1(low)?
    if bytes_get(low_key, 0) >= bytes_get(high_key, 0): return err("YazaBase DECIMAL order key does not order signed values")
    let high_sum: Result[YazaSqlDecimalV1, Text] = yaza_sql_decimal_add_v1(high, high, 38)
    let low_sum: Result[YazaSqlDecimalV1, Text] = yaza_sql_decimal_add_v1(low, low, 38)
    if result_is_ok(high_sum) or result_is_ok(low_sum): return err("YazaBase DECIMAL accepted signed 128-bit or precision overflow")
    let amount_columns: List[YazaSqlColumnSchemaV1] = [YazaSqlColumnSchemaV1("amount", 10, false, 0, 5, 2, "")]
    let stored_amount: YazaSqlValueV1 = yaza_sql_value_decimal_v1(positive_twelve)?
    let amount_values: List[YazaSqlValueV1] = [stored_amount]
    let amount_nulls: List[Boolean] = [false]
    let encoded_amount: Bytes = yaza_db_row_encode_v1(amount_values, amount_nulls, amount_columns, 91)?
    let decoded_amount: YazaDbRowV1 = yaza_db_row_decode_v1(encoded_amount, amount_columns)?
    let decoded_decimal: YazaSqlValueV1 = list_get(decoded_amount.values, 0)
    if decoded_decimal.text_value != "1.20" or yaza_sql_value_decimal_precision_v1(decoded_decimal) != 5 or yaza_sql_value_decimal_scale_v1(decoded_decimal) != 2:
        return err("YazaBase DECIMAL row codec did not preserve coefficient, value, precision, and scale")
    return ok(true)

start:
    let outcome: Result[Boolean, Text] = yaza_base_decimal_smoke_v1()
    if not result_is_ok(outcome): say result_unwrap_error(outcome)
    elif result_unwrap(outcome): say "yazabase-sql-decimal-v1-ok"
    else: say "YazaBase DECIMAL helper fixture returned false"
