use "std/net"

start:
    let listener_res: Result[Number, Text] = tcp_listen("127.0.0.1", 19877, 8)
    if not result_is_ok(listener_res):
        say "LISTEN FAIL: " + result_unwrap_error(listener_res)
        exit(1)
    let listener: Number = result_unwrap(listener_res)

    let client_res: Result[Number, Text] = tcp_connect("127.0.0.1", 19877, 1000)
    if not result_is_ok(client_res):
        say "CONNECT FAIL: " + result_unwrap_error(client_res)
        let _c: Result[Boolean, Text] = tcp_close(listener)
        exit(1)
    let client: Number = result_unwrap(client_res)

    let server_conn_res: Result[Number, Text] = tcp_accept(listener, 1000)
    if not result_is_ok(server_conn_res):
        say "ACCEPT FAIL: " + result_unwrap_error(server_conn_res)
        let _c1: Result[Boolean, Text] = tcp_close(client)
        let _c2: Result[Boolean, Text] = tcp_close(listener)
        exit(1)
    let server_conn: Number = result_unwrap(server_conn_res)

    let msg: Bytes = bytes_from_text("PING_POSTGRES")
    let write_res: Result[Number, Text] = tcp_write(client, msg, 1000)
    if not result_is_ok(write_res):
        say "WRITE FAIL: " + result_unwrap_error(write_res)
        exit(1)

    let read_res: Result[Bytes, Text] = tcp_read(server_conn, 64, 1000)
    if not result_is_ok(read_res):
        say "READ FAIL: " + result_unwrap_error(read_res)
        exit(1)
    let payload: Bytes = result_unwrap(read_res)
    say "READ: " + bytes_to_text(payload)

    let _c3: Result[Boolean, Text] = tcp_close(client)
    let _c4: Result[Boolean, Text] = tcp_close(server_conn)
    let _c5: Result[Boolean, Text] = tcp_close(listener)
    say "ALL SOCKETS CLOSED CLEANLY"
