use "std/net"

start:
    let listener: Number = result_unwrap(tcp_listen("127.0.0.1", 19877, 16))
    say "READY"
    let client: Number = result_unwrap(tcp_accept(listener, 3000))
    say "CLIENT ACCEPTED"
    let req_bytes: Bytes = result_unwrap(tcp_read(client, 4096, 3000))
    say "READ BYTES: " + number_text(bytes_length(req_bytes))
    let req_text: Text = bytes_to_text(req_bytes)
    say "REQ PREVIEW: " + text_slice(req_text, 0, 14)
    let resp: Bytes = bytes_from_text("HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 5\r\nConnection: close\r\n\r\nhello")
    let written: Number = result_unwrap(tcp_write(client, resp, 3000))
    say "WROTE BYTES: " + number_text(written)
    let closed_client: Boolean = result_unwrap(tcp_close(client))
    let closed_listener: Boolean = result_unwrap(tcp_close(listener))
    say "DONE"
