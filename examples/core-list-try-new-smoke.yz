fn list_try_new_success() -> Boolean:
    arena_scope 1024:
        let attempt: Result[List[Number],Text] = list_try_new()
        if result_is_ok(attempt):
            let values: List[Number] = result_unwrap(attempt)
            assert list_try_push(values, 42)
            return list_count(values) == 1
        else:
            return false

fn list_try_new_quota_failure() -> Boolean:
    arena_scope 1:
        let attempt: Result[List[Number],Text] = list_try_new()
        if result_is_ok(attempt):
            return false
        else:
            let message: Text = result_unwrap_error(attempt)
            return message == "Could not allocate List in the active arena"

start:
    assert list_try_new_success()
    assert list_try_new_quota_failure()
    say "fallible-list-construction-ok"
