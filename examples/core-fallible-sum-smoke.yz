shape Payload:
    first: Number
    second: Number

shape Envelope:
    items: List[Bytes]

variant Lookup:
    Missing
    Found(payload: Payload, status: Number)

start:
    arena_scope 4096:
        let optional_number: Result[Option[Number], Text] = some_try(42)
        assert result_is_ok(optional_number)
        assert option_unwrap(result_unwrap(optional_number)) == 42

        let optional_payload: Result[Option[Payload], Text] = some_try(Payload(7, 11))
        assert result_is_ok(optional_payload)
        assert option_unwrap(result_unwrap(optional_payload)).second == 11

        let nested_ok: Result[Result[Payload, Text], Text] = ok_try(Payload(13, 17))
        assert result_is_ok(nested_ok)
        assert result_is_ok(result_unwrap(nested_ok))
        assert result_unwrap(result_unwrap(nested_ok)).first == 13

        let nested_err: Result[Result[Payload, Text], Text] = err_try("inner failure")
        assert result_is_ok(nested_err)
        assert not result_is_ok(result_unwrap(nested_err))
        assert result_unwrap_error(result_unwrap(nested_err)) == "inner failure"

        let found: Result[Lookup, Text] = variant_try(Lookup::Found(Payload(37, 41), 200))
        assert result_is_ok(found)
        match result_unwrap(found):
            Found(payload, status):
                assert payload.second == 41
                assert status == 200
            Missing:
                fail("variant_try selected the wrong case")

        let missing: Result[Lookup, Text] = variant_try(Lookup::Missing())
        assert result_is_ok(missing)
        match result_unwrap(missing):
            Missing:
                say "variant-try-empty-ok"
            Found(_, _):
                fail("variant_try selected the wrong empty case")

        let numbers: Result[List[Number], Text] = list_try_from([2, 3, 5])
        assert result_is_ok(numbers)
        assert list_count(result_unwrap(numbers)) == 3
        assert list_get(result_unwrap(numbers), 2) == 5

        let empty_numbers: Result[List[Number], Text] = list_try_from([])
        assert result_is_ok(empty_numbers)
        assert list_count(result_unwrap(empty_numbers)) == 0

        let words: Result[TextList, Text] = list_try_from(["yaza", "llvm"])
        assert result_is_ok(words)
        assert list_get(result_unwrap(words), 0) == "yaza"
        assert list_get(result_unwrap(words), 1) == "llvm"
        say "fallible-list-literal-ok"

        let payloads: List[Payload] = [Payload(53, 59)]
        let found_payload: Result[Option[Payload], Text] = list_try_get_result(payloads, 0)
        assert result_is_ok(found_payload)
        assert option_unwrap(result_unwrap(found_payload)).second == 59
        let absent_payload: Result[Option[Payload], Text] = list_try_get_result(payloads, 9)
        assert result_is_ok(absent_payload)
        assert not option_is_some(result_unwrap(absent_payload))
        let negative_payload: Result[Option[Payload], Text] = list_try_get_result(payloads, -1)
        assert result_is_ok(negative_payload)
        assert not option_is_some(result_unwrap(negative_payload))
        let bytes_value: Bytes = bytes_from_text("inline bytes")
        let byte_values: List[Bytes] = [bytes_value]
        let optional_bytes: Result[Option[Bytes], Text] = list_try_get_result(byte_values, 0)
        assert result_is_ok(optional_bytes)
        assert bytes_equal(option_unwrap(result_unwrap(optional_bytes)), bytes_value)
        say "fallible-list-read-ok"

        let count: Number = 3
        let identifier: Int32 = int32_from_number(5)
        let ratio: Float64 = 1.25
        let label: Text = "ready"
        let formatted: Result[Text, Text] = text_try_interpolate("count={count}, id={identifier}, ratio={ratio}, label={label}")
        assert result_is_ok(formatted)
        assert result_unwrap(formatted) == "count=3, id=5, ratio=1.25, label=ready"
        let literal: Result[Text, Text] = text_try_interpolate("literal only")
        assert result_is_ok(literal)
        assert result_unwrap(literal) == "literal only"
        say "fallible-interpolation-ok"

    arena_scope 1000000:
        let parent_bytes: Bytes = bytes_from_text("parent-owned")
        let parent_items: List[Bytes] = List[Bytes]()
        list_push(parent_items, parent_bytes)
        let envelopes: List[Envelope] = [Envelope(parent_items)]
        arena_scope 4096:
            let lookup: Result[Option[Envelope], Text] = list_try_get_result(envelopes, 0)
            let envelope: Envelope = option_unwrap(result_unwrap(lookup))
            assert bytes_equal(list_get(envelope.items, 0), parent_bytes)
        say "fallible-list-read-owner-ok"

    arena_scope 1:
        let first_allocation_failure: Result[Option[Payload], Text] = some_try(Payload(19, 23))
        assert not result_is_ok(first_allocation_failure)
        assert result_unwrap_error(first_allocation_failure) == "Could not allocate Text in the active arena"

    arena_scope 16:
        let outer_allocation_failure: Result[Option[Payload], Text] = some_try(Payload(29, 31))
        assert not result_is_ok(outer_allocation_failure)
        assert result_unwrap_error(outer_allocation_failure) == "Could not allocate Text in the active arena"

    arena_scope 1:
        let variant_allocation_failure: Result[Lookup, Text] = variant_try(Lookup::Found(Payload(43, 47), 503))
        assert not result_is_ok(variant_allocation_failure)
        assert result_unwrap_error(variant_allocation_failure) == "Could not allocate Text in the active arena"
        assert arena_used() == 0

    arena_scope 1:
        let list_allocation_failure: Result[List[Number], Text] = list_try_from([59])
        assert not result_is_ok(list_allocation_failure)
        assert result_unwrap_error(list_allocation_failure) == "Could not allocate List in the active arena"
        assert arena_used() == 0

    arena_scope 1000000:
        let payloads: List[Payload] = [Payload(61, 67)]
        arena_scope 1:
            let first_list_read_allocation_failure: Result[Option[Payload], Text] = list_try_get_result(payloads, 0)
            assert not result_is_ok(first_list_read_allocation_failure)
            assert result_unwrap_error(first_list_read_allocation_failure) == "Could not allocate List in the active arena"
            assert arena_used() == 0
        arena_scope 16:
            let outer_list_read_allocation_failure: Result[Option[Payload], Text] = list_try_get_result(payloads, 0)
            assert not result_is_ok(outer_list_read_allocation_failure)
            assert result_unwrap_error(outer_list_read_allocation_failure) == "Could not allocate List in the active arena"
            assert arena_used() == 16

    arena_scope 1:
        let count: Number = 61
        let interpolation_allocation_failure: Result[Text, Text] = text_try_interpolate("count={count}")
        assert not result_is_ok(interpolation_allocation_failure)
        assert result_unwrap_error(interpolation_allocation_failure) == "Could not allocate Text in the active arena"
        assert arena_used() == 0

    arena_scope 32:
        let count: Number = 7
        let interpolation_concat_failure: Result[Text, Text] = text_try_interpolate("n={count}")
        assert not result_is_ok(interpolation_concat_failure)
        assert result_unwrap_error(interpolation_concat_failure) == "Could not allocate Text in the active arena"

    say "fallible-sums-ok"
