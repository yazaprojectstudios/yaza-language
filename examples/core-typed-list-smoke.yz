shape Product:
    id: Number
    name: Text

variant Lookup:
    Missing
    Found(product: Product)

fn maybe_product(products: List[Product], index: Number) -> Option[Product]:
    return list_try_get(products, index)

fn read_product(products: List[Product], index: Number) -> Text:
    return products[index].name

fn make_numbers() -> List[Number]:
    return [3, 4]

fn first_number(numbers: List[Number]) -> Number:
    return numbers[0]

fn make_products() -> List[Product]:
    var products: List[Product] = List[Product]()
    list_push(products, Product(2, "returned"))
    return products

start:
    let literal: List[Number] = [2, 3, 4]
    assert list_count(literal) == 3
    assert literal[1] == 3
    assert list_get(make_numbers(), 1) == 4
    assert first_number([5, 6]) == 5

    let text_values: List[Text] = List[Text]()
    list_push(text_values, "owned")
    list_set(text_values, 0, "replacement")
    assert list_get(text_values, 0) == "replacement"

    let try_values: List[Number] = List[Number]()
    assert list_try_push(try_values, 71)
    assert list_count(try_values) == 1
    assert list_get(try_values, 0) == 71

    var products: List[Product] = List[Product]()
    list_push(products, Product(7, "YAZA"))
    list_push(products, Product(9, "LLVM"))
    assert read_product(products, 0) == "YAZA"
    assert products[1].id == 9
    list_set(products, 1, Product(11, "Core"))
    assert list_get(products, 1).name == "Core"
    assert option_unwrap(maybe_product(products, 0)).name == "YAZA"
    assert not option_is_some(maybe_product(products, -1))
    assert list_get(make_products(), 0).name == "returned"

    var maybe_numbers: List[Option[Number]] = List[Option[Number]]()
    list_push(maybe_numbers, some(17))
    list_push(maybe_numbers, none)
    let nested: Option[Option[Number]] = list_try_get(maybe_numbers, 1)
    assert option_is_some(nested)
    assert not option_is_some(option_unwrap(nested))
    let option_literals: List[Option[Number]] = [some(29), none]
    assert option_unwrap(list_get(option_literals, 0)) == 29
    assert not option_is_some(list_get(option_literals, 1))

    var results: List[Result[Number, Text]] = List[Result[Number, Text]]()
    list_push(results, ok(23))
    list_push(results, err("failed"))
    let maybe_result: Option[Result[Number, Text]] = list_try_get(results, 1)
    assert option_is_some(maybe_result)
    assert result_unwrap_error(option_unwrap(maybe_result)) == "failed"

    var nested_lists: List[List[Number]] = List[List[Number]]()
    list_push(nested_lists, [31, 32])
    assert list_get(list_get(nested_lists, 0), 1) == 32

    var lookups: List[Lookup] = List[Lookup]()
    list_push(lookups, Lookup::Missing)
    list_push(lookups, Lookup::Found(Product(13, "typed")))
    let found: Lookup = list_get(lookups, 1)
    let maybe_lookup: Option[Lookup] = list_try_get(lookups, 1)
    assert option_is_some(maybe_lookup)
    match found:
        Missing:
            assert false
        Found(product):
            assert product.name == "typed"

    var total: Number = 0
    for product in products:
        set total = total + product.id
    assert total == 18

    var growing: List[Number] = List[Number]()
    list_push(growing, 1)
    var visits: Number = 0
    for item in growing:
        set visits = visits + 1
        list_push(growing, 2)
    assert visits == 1
    assert list_count(growing) == 2
    say "typed-list-ok"
