shape Inbox:
    items: List[Bytes]

fn append_through_alias(inbox: Inbox, value: Bytes) -> Unit:
    let alias: Inbox = inbox
    list_push(alias.items, value)

start:
    let shared: Inbox = Inbox(List[Bytes]())
    arena_scope 4096:
        let message: Bytes = bytes_from_text("child " + number_text(43))
        append_through_alias(shared, message)
