shape Bucket:
    values: List[Bytes]

start:
    arena_scope 4096:
        let first_values: List[Bytes] = List[Bytes]()
        let second_values: List[Bytes] = List[Bytes]()
        let temporary: Bytes = bytes_from_text("dynamic-child-safe")
        list_push(first_values, temporary)
        list_push(second_values, temporary)
        let buckets: List[Bucket] = List[Bucket]()
        list_push(buckets, Bucket(first_values))
        list_push(buckets, Bucket(second_values))
        var selection: Number = 0
        if arg_count() > 0:
            set selection = 1
        let selected: Bucket = list_get(buckets, selection)
        say bytes_to_text(list_get(selected.values, 0))
