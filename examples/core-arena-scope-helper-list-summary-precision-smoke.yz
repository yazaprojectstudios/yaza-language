shape Envelope:
    items: List[Bytes]

fn append_envelope(values: List[Envelope], value: Envelope) -> Unit:
    list_push(values, value)

fn append_outer(values: List[Envelope], value: Envelope) -> Unit:
    append_envelope(values, value)

start:
    let parent_items: List[Bytes] = List[Bytes]()
    let parent_bytes: Bytes = bytes_from_text("parent-safe")
    list_push(parent_items, parent_bytes)
    let output: List[Bytes] = List[Bytes]()
    arena_scope 4096:
        let values: List[Envelope] = List[Envelope]()
        append_outer(values, Envelope(parent_items))
        let latest: Envelope = list_get(values, 0)
        let safe_bytes: Bytes = list_get(latest.items, 0)
        list_push(output, safe_bytes)
    say bytes_to_text(list_get(output, 0))
