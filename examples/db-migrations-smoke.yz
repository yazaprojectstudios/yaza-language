use "std/db/migrations"

start:
    let registry: List[DbMigration] = List[DbMigration]()
    list_push(registry, DbMigration(1, "CREATE TABLE widgets (id BIGINT PRIMARY KEY)", "DROP TABLE widgets"))
    let history: List[DbMigrationRecord] = List[DbMigrationRecord]()
    assert(result_is_ok(db_migration_validate(registry, history)))
    list_push(history, DbMigrationRecord(1, db_migration_checksum(list_get(registry, 0)), "applied"))
    assert(result_is_ok(db_migration_validate(registry, history)))
    say "db-migrations-smoke passed"
