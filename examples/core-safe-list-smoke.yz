fn first_number(values: List[Number]) -> Option[Number]:
    return list_try_get(values, 0)

start:
    var numbers: List[Number] = List[Number]()
    list_push(numbers, 17)
    list_push(numbers, 29)
    let first_number_value: Option[Number] = first_number(numbers)
    let negative_number: Option[Number] = list_try_get(numbers, -1)
    let missing_number: Option[Number] = list_try_get(numbers, 2)
    assert option_is_some(first_number_value)
    assert option_unwrap(first_number_value) == 17
    assert option_is_some(list_try_get(numbers, 1))
    assert not option_is_some(negative_number)
    assert not option_is_some(missing_number)

    var ids: List[Int32] = List[Int32]()
    list_push(ids, int32_from_number(42))
    let first_id: Option[Int32] = list_try_get(ids, 0)
    assert option_is_some(first_id)
    assert option_unwrap(first_id) == int32_from_number(42)

    var fractions: List[Float64] = List[Float64]()
    list_push(fractions, 2.5)
    let first_fraction: Option[Float64] = list_try_get(fractions, 0)
    assert option_is_some(first_fraction)
    assert option_unwrap(first_fraction) == 2.5

    var flags: List[Boolean] = List[Boolean]()
    list_push(flags, true)
    let first_flag: Option[Boolean] = list_try_get(flags, 0)
    assert option_is_some(first_flag)
    assert option_unwrap(first_flag)

    let words: TextList = text_list()
    list_push(words, "safe")
    let first_word: Option[Text] = list_try_get(words, 0)
    let missing_word: Option[Text] = list_try_get(words, 100)
    assert option_is_some(first_word)
    assert option_unwrap(first_word) == "safe"
    assert not option_is_some(missing_word)
    say "safe-list-ok"
