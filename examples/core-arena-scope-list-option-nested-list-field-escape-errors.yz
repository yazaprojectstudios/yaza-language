start:
    let parent_items: List[Bytes] = List[Bytes]()
    arena_scope 4096:
        let local_bytes: Bytes = bytes_from_text("child")
        let nested_lists: List[Option[List[Bytes]]] = List[Option[List[Bytes]]]()
        list_push(nested_lists, some(parent_items))
        let target: List[Bytes] = option_unwrap(list_get(nested_lists, 0))
        list_push(target, local_bytes)
