shape DeepValue:
    nested: Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Number]]]]]]]]]]]]]]]]

fn read_deep(value: DeepValue) -> Number:
    return option_unwrap(option_unwrap(option_unwrap(option_unwrap(option_unwrap(option_unwrap(option_unwrap(option_unwrap(option_unwrap(option_unwrap(option_unwrap(option_unwrap(option_unwrap(option_unwrap(option_unwrap(option_unwrap(value.nested))))))))))))))))

start:
    let value: DeepValue = DeepValue(some(some(some(some(some(some(some(some(some(some(some(some(some(some(some(some(42)))))))))))))))))
    assert read_deep(value) == 42
    say "type-depth-16-ok"
