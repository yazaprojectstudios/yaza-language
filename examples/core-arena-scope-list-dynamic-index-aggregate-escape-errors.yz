shape Bucket:
    values: List[Bytes]

start:
    let persistent_values: List[Bytes] = List[Bytes]()
    arena_scope 4096:
        let temporary_values: List[Bytes] = List[Bytes]()
        let temporary_bytes: Bytes = bytes_from_text("child")
        let buckets: List[Bucket] = List[Bucket]()
        list_push(buckets, Bucket(persistent_values))
        list_push(buckets, Bucket(temporary_values))
        let selection: Number = arg_count()
        let selected: Bucket = list_get(buckets, selection)
        list_push(selected.values, temporary_bytes)
