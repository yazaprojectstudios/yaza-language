use "../yazabase/sql_insert_v1"

fn yazabase_sql_insert_v1_smoke() -> Boolean:
    let source: Text = "INSERT INTO app.\"users\" (id, name, active) VALUES (-7, 'O''Reilly', TRUE), (8, :owner, FALSE);"
    let parsed: Result[YazaSqlInsertAstV1, Text] = yaza_sql_parse_insert_v1(source)
    if not result_is_ok(parsed): return false
    let insert: YazaSqlInsertAstV1 = result_unwrap(parsed)
    if insert.version != 1 or insert.table_name.part_count != 2 or not insert.has_column_list: return false
    if list_count(insert.columns) != 3 or list_count(insert.rows) != 2 or insert.values_per_row != 3: return false
    if text_slice(source, insert.start_byte, insert.end_byte - insert.start_byte) != source: return false
    let first_column: YazaSqlNameV2 = list_get(insert.columns, 0)
    let last_column: YazaSqlNameV2 = list_get(insert.columns, 2)
    if text_slice(source, first_column.start_byte, first_column.end_byte - first_column.start_byte) != "id": return false
    if text_slice(source, last_column.start_byte, last_column.end_byte - last_column.start_byte) != "active": return false
    let first_row: List[YazaSqlTokenV1] = list_get(insert.rows, 0)
    let second_row: List[YazaSqlTokenV1] = list_get(insert.rows, 1)
    let negative_integer: YazaSqlTokenV1 = list_get(first_row, 0)
    let escaped_text: YazaSqlTokenV1 = list_get(first_row, 1)
    let true_value: YazaSqlTokenV1 = list_get(first_row, 2)
    let named_parameter: YazaSqlTokenV1 = list_get(second_row, 1)
    let false_value: YazaSqlTokenV1 = list_get(second_row, 2)
    if negative_integer.kind != 3 or text_slice(source, negative_integer.start_byte, negative_integer.end_byte - negative_integer.start_byte) != "-7": return false
    if escaped_text.kind != 4 or text_slice(source, escaped_text.start_byte, escaped_text.end_byte - escaped_text.start_byte) != "'O''Reilly'": return false
    if not yaza_sql_v2_is_keyword(source, [true_value], 0, "TRUE"): return false
    if named_parameter.kind != 5 or text_slice(source, named_parameter.start_byte, named_parameter.end_byte - named_parameter.start_byte) != ":owner": return false
    if not yaza_sql_v2_is_keyword(source, [false_value], 0, "FALSE"): return false

    let implicit_columns: Result[YazaSqlInsertAstV1, Text] = yaza_sql_parse_insert_v1("INSERT INTO logs VALUES (1), (2)")
    if not result_is_ok(implicit_columns): return false
    let implicit_insert: YazaSqlInsertAstV1 = result_unwrap(implicit_columns)
    if implicit_insert.has_column_list or list_count(implicit_insert.rows) != 2 or implicit_insert.values_per_row != 1: return false

    let null_and_decimal: Result[YazaSqlInsertAstV1, Text] = yaza_sql_parse_insert_v1("INSERT INTO measurements VALUES (NULL), (1.25e2)")
    if not result_is_ok(null_and_decimal): return false
    let literal_rows: List[List[YazaSqlTokenV1]] = result_unwrap(null_and_decimal).rows
    if not yaza_sql_v2_is_keyword("INSERT INTO measurements VALUES (NULL), (1.25e2)", list_get(literal_rows, 0), 0, "NULL"): return false
    let decimal_token: YazaSqlTokenV1 = list_get(list_get(literal_rows, 1), 0)
    if decimal_token.kind != 3 or text_slice("INSERT INTO measurements VALUES (NULL), (1.25e2)", decimal_token.start_byte, decimal_token.end_byte - decimal_token.start_byte) != "1.25e2": return false

    let count_mismatch: Result[YazaSqlInsertAstV1, Text] = yaza_sql_parse_insert_v1("INSERT INTO t (a,b) VALUES (1)")
    if result_is_ok(count_mismatch): return false
    let ragged_rows: Result[YazaSqlInsertAstV1, Text] = yaza_sql_parse_insert_v1("INSERT INTO t VALUES (1,2), (3)")
    if result_is_ok(ragged_rows): return false
    let expression_value: Result[YazaSqlInsertAstV1, Text] = yaza_sql_parse_insert_v1("INSERT INTO t VALUES (1 + 2)")
    if result_is_ok(expression_value): return false
    let empty_values: Result[YazaSqlInsertAstV1, Text] = yaza_sql_parse_insert_v1("INSERT INTO t VALUES ()")
    if result_is_ok(empty_values): return false
    let empty_columns: Result[YazaSqlInsertAstV1, Text] = yaza_sql_parse_insert_v1("INSERT INTO t () VALUES (1)")
    if result_is_ok(empty_columns): return false
    let extra_statement: Result[YazaSqlInsertAstV1, Text] = yaza_sql_parse_insert_v1("INSERT INTO t VALUES (1); DELETE FROM t")
    if result_is_ok(extra_statement): return false
    let default_value: Result[YazaSqlInsertAstV1, Text] = yaza_sql_parse_insert_v1("INSERT INTO t VALUES (DEFAULT)")
    if not result_is_ok(default_value): return false
    if not yaza_sql_v2_is_keyword("INSERT INTO t VALUES (DEFAULT)", list_get(result_unwrap(default_value).rows, 0), 0, "DEFAULT"): return false
    let unsupported_keyword: Result[YazaSqlInsertAstV1, Text] = yaza_sql_parse_insert_v1("INSERT INTO t VALUES (CURRENT_TIMESTAMP)")
    if result_is_ok(unsupported_keyword): return false
    return true

start:
    let initial_used: Number = arena_used()
    arena_scope 262144:
        assert yazabase_sql_insert_v1_smoke()
    assert arena_used() == initial_used
    say "yazabase-sql-insert-v1-ok"
