start:
    let made: Result[Bytes, Text] = bytes_try_new_zeroed(4)
    assert result_is_ok(made)
    let value: Bytes = result_unwrap(made)
    assert bytes_length(value) == 4
    assert bytes_get(value, 0) == 0
    assert bytes_get(value, 3) == 0

    let alias: Bytes = value
    assert bytes_try_set(value, 1, 89)
    assert bytes_get(alias, 1) == 89
    assert bytes_try_set(alias, 2, 90)
    assert bytes_get(value, 2) == 90
    assert not bytes_try_set(value, -1, 1)
    assert not bytes_try_set(value, 4, 1)
    assert not bytes_try_set(value, 1, 256)
    assert not bytes_try_set(value, 1, -1)

    let empty: Result[Bytes, Text] = bytes_try_new_zeroed(0)
    assert result_is_ok(empty)
    assert bytes_length(result_unwrap(empty)) == 0
    let negative: Result[Bytes, Text] = bytes_try_new_zeroed(-1)
    assert not result_is_ok(negative)
    assert result_unwrap_error(negative) == "Bytes length must be between 0 and 64 MiB"
    say "bytes-try-new-zeroed-ok"
