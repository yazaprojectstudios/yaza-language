shape Envelope:
    items: List[Bytes]

start:
    arena_scope 4096:
        let child_items: List[Bytes] = List[Bytes]()
        let child_bytes: Bytes = bytes_from_text("child")
        let values: List[Envelope] = List[Envelope]()
        list_push(values, Envelope(child_items))
        let value: Envelope = list_get(values, 0)
        list_push(value.items, child_bytes)
        let maybe_value: Option[Envelope] = list_try_get(values, 0)
        let try_value: Envelope = option_unwrap(maybe_value)
        list_push(try_value.items, child_bytes)
        for each_value in values:
            list_push(each_value.items, child_bytes)
        list_try_push(values, Envelope(child_items))
        let replacement_items: List[Bytes] = List[Bytes]()
        list_set(values, 1, Envelope(replacement_items))
        let replaced_value: Envelope = list_get(values, 1)
        list_push(replaced_value.items, child_bytes)
        let nested_lists: List[List[Bytes]] = List[List[Bytes]]()
        list_push(nested_lists, child_items)
        let nested: List[Bytes] = list_get(nested_lists, 0)
        list_push(nested, child_bytes)
        let option_lists: List[Option[List[Bytes]]] = List[Option[List[Bytes]]]()
        list_push(option_lists, some(child_items))
        let maybe_nested: Option[List[Bytes]] = list_get(option_lists, 0)
        let unwrapped: List[Bytes] = option_unwrap(maybe_nested)
        list_push(unwrapped, child_bytes)
        let result_lists: List[Result[List[Bytes], Text]] = List[Result[List[Bytes], Text]]()
        list_push(result_lists, ok(child_items))
        let result_nested: List[Bytes] = result_unwrap(list_get(result_lists, 0))
        list_push(result_nested, child_bytes)
    say "list-element-field-precision-ok"
