shape Envelope:
    items: List[Bytes]

start:
    let parent_items: List[Bytes] = List[Bytes]()
    arena_scope 4096:
        let local_bytes: Bytes = bytes_from_text("child")
        let values: List[Envelope] = List[Envelope]()
        list_push(values, Envelope(parent_items))
        for value in values:
            list_push(value.items, local_bytes)
