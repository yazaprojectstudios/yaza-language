start:
    let parent_bytes: Bytes = bytes_from_text("parent-safe")
    let output: List[Bytes] = List[Bytes]()
    arena_scope 4096:
        let values: List[Bytes] = List[Bytes]()
        let child_bytes: Bytes = bytes_from_text("child")
        var iteration: Number = 0
        while iteration < 2:
            if iteration == 0:
                list_push(values, parent_bytes)
            else:
                list_push(values, child_bytes)
            set iteration = iteration + 1
        let escaped: Bytes = list_get(values, 1)
        list_push(output, escaped)
