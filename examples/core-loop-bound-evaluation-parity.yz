fn range_start(events: List[Number]) -> Number:
    list_push(events, 1)
    return 1

fn range_end(events: List[Number]) -> Number:
    list_push(events, 2)
    return 4

start:
    let events: List[Number] = List[Number]()
    var sum: Number = 0
    for value in range_start(events)..range_end(events):
        set sum = sum + value

    assert sum == 6
    assert list_count(events) == 2
    assert list_get(events, 0) == 1
    assert list_get(events, 1) == 2
    say "loop-bound-evaluation-ok"
