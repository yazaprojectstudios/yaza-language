start:
    let value: Text = "prefix::alpha::omega"
    assert text_byte(value, 0) == 112
    assert text_byte(value, 6) == 58
    assert text_slice(value, 8, 5) == "alpha"
    assert text_slice(value, text_length(value), 0) == ""
    assert text_find(value, "::") == 6
    assert text_find(value, "alpha") == 8
    assert text_find(value, "missing") == -1
    assert text_find(value, "") == 0
    assert text_starts_with(value, "prefix")
    assert text_starts_with(value, "")
    assert not text_starts_with(value, "prefix-long")
    assert text_ends_with(value, "omega")
    assert text_ends_with(value, "")
    assert not text_ends_with(value, "Omega")

    let utf8: Text = "é"
    assert text_length(utf8) == 2
    assert text_byte(utf8, 0) == 195
    assert text_byte(utf8, 1) == 169
    assert text_slice(utf8, 0, 2) == utf8

    assert number_parse("65535") == 65535
    assert number_parse("-17") == -17
