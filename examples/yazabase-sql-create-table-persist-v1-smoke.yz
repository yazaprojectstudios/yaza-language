use "std/fs"
use "../yazabase/btree_scan_v1"
use "../yazabase/catalog_init_v1"
use "../yazabase/catalog_snapshot_v1"
use "../yazabase/key_codec_v1"
use "../yazabase/mvcc_history_v1"
use "../yazabase/page_v1"
use "../yazabase/page_wal_v1"
use "../yazabase/row_v1"
use "../yazabase/sql_dispatch_v1"
use "../yazabase/sql_binder_v1"
use "../yazabase/sql_literal_v1"
use "../yazabase/sql_parser_v3"
use "../yazabase/query_v1"
use "../yazabase/wal_v1"

fn yaza_base_sql_prefix_limit_plan_eligible_v1(source: Text, catalog: YazaSqlCatalogSnapshotV1) -> Boolean:
    let parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(source)
    if not result_is_ok(parsed): return false
    let bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(source, result_unwrap(parsed), catalog)
    if not result_is_ok(bound): return false
    return yaza_db_query_prefix_limit_eligible_v1(result_unwrap(bound))

fn yaza_base_sql_prefix_limit_eligibility_v1(catalog: YazaSqlCatalogSnapshotV1) -> Boolean:
    if not yaza_base_sql_prefix_limit_plan_eligible_v1("SELECT id FROM accounts LIMIT 2", catalog): return false
    if yaza_base_sql_prefix_limit_plan_eligible_v1("SELECT id FROM accounts WHERE id > 0 LIMIT 2", catalog): return false
    if yaza_base_sql_prefix_limit_plan_eligible_v1("SELECT DISTINCT id FROM accounts LIMIT 2", catalog): return false
    if yaza_base_sql_prefix_limit_plan_eligible_v1("SELECT id FROM accounts ORDER BY id LIMIT 2", catalog): return false
    if yaza_base_sql_prefix_limit_plan_eligible_v1("SELECT COUNT(*) FROM accounts LIMIT 2", catalog): return false
    if yaza_base_sql_prefix_limit_plan_eligible_v1("SELECT id, COUNT(*) FROM accounts GROUP BY id LIMIT 2", catalog): return false
    if yaza_base_sql_prefix_limit_plan_eligible_v1("SELECT COUNT(*) AS n FROM accounts HAVING COUNT(*) > 0 LIMIT 2", catalog): return false
    return not yaza_base_sql_prefix_limit_plan_eligible_v1("SELECT id FROM accounts LIMIT 70000", catalog)

fn yazabase_sql_create_table_persist_v1(root_path: Text) -> Result[Number, Text]:
    let invalid_utf8_fragment: Text = text_slice("é", 0, 1)
    let invalid_utf8_literal: Text = "'" + invalid_utf8_fragment + "'"
    let invalid_utf8_decode: Result[Text, Text] = yaza_sql_decode_text_literal_v1(invalid_utf8_literal, 0, text_length(invalid_utf8_literal))
    if result_is_ok(invalid_utf8_decode): return err("YDBv1 SQL literal decoder accepted an invalid UTF-8 slice")
    let root: Number = root_open(root_path)?
    let db_name: Text = "create-table-persist-smoke.ydb"
    let header: YazaDbFileHeaderV1 = YazaDbFileHeaderV1(bytes_from_text("ct-persist-uuid1"), 0, 1, 1, 0, 2, 1)
    let empty_storage: YazaDbStorageHandleV1 = yaza_db_storage_create_empty_v1(root, db_name, header)?
    let empty_closed: Boolean = yaza_db_storage_close_v1(empty_storage)?
    if not empty_closed: return err("YDBv1 CREATE TABLE could not close the empty database before catalog initialization")

    let initialized: YazaDbCatalogBootstrapV1 = yaza_db_catalog_initialize_v1(root, db_name)?
    let no_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let source: Text = "CREATE TABLE accounts (id BIGINT PRIMARY KEY, email TEXT NOT NULL DEFAULT 'pending', active BOOL DEFAULT TRUE, points INTEGER DEFAULT -2)"
    let create_result: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(initialized.storage, initialized.wal, source, no_parameters)?
    if create_result.statement_kind != yaza_db_sql_statement_kind_create_table_v1() or not option_is_some(create_result.write_commit): return err("YDBv1 SQL dispatcher did not return a CREATE TABLE commit")
    let committed: YazaDbWriteCommitV1 = option_unwrap(create_result.write_commit)
    if committed.txn_id != 1 or committed.commit_ts != 2: return err("YDBv1 CREATE TABLE did not publish the expected first transaction")
    let wal_closed: Boolean = yaza_db_wal_log_close_v1(committed.wal)?
    let storage_closed: Boolean = yaza_db_storage_close_v1(committed.storage)?
    if not wal_closed or not storage_closed: return err("YDBv1 CREATE TABLE committed handles did not close")

    let recovered: YazaDbCheckpointRecoveryV1 = yaza_db_open_recovered_v1(root, db_name)?
    let after: YazaSqlCatalogSnapshotV1 = yaza_db_catalog_snapshot_load_v1(recovered.storage.file, recovered.storage.header)?
    if after.version != 2 or list_count(after.tables) != 5: return err("YDBv1 CREATE TABLE did not persist a visible catalog entry")
    let accounts_index: Number = yaza_db_catalog_snapshot_table_index_v1(after.tables, 13)
    if accounts_index < 0: return err("YDBv1 CREATE TABLE catalog does not contain the allocated table ID")
    let accounts: YazaSqlTableSchemaV1 = list_get(after.tables, accounts_index)
    if accounts.name != "accounts" or list_count(accounts.columns) != 4: return err("YDBv1 CREATE TABLE did not persist the table columns")
    if list_get(accounts.columns, 0).name != "id" or list_get(accounts.columns, 0).type_id != 4 or list_get(accounts.columns, 0).nullable: return err("YDBv1 CREATE TABLE primary-key column metadata is incorrect")
    if list_get(accounts.columns, 1).name != "email" or list_get(accounts.columns, 1).type_id != 9 or list_get(accounts.columns, 1).nullable: return err("YDBv1 CREATE TABLE text column metadata is incorrect")
    if list_get(accounts.columns, 2).name != "active" or list_get(accounts.columns, 2).type_id != 1 or not list_get(accounts.columns, 2).nullable: return err("YDBv1 CREATE TABLE nullable column metadata is incorrect")
    if list_get(accounts.columns, 3).name != "points" or list_get(accounts.columns, 3).type_id != 3 or not list_get(accounts.columns, 3).nullable: return err("YDBv1 CREATE TABLE integer expression column metadata is incorrect")

    let selected_result: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(recovered.storage, recovered.wal, "SELECT id, email, active FROM accounts", no_parameters)?
    if selected_result.statement_kind != yaza_db_sql_statement_kind_select_v1() or not option_is_some(selected_result.query_result): return err("YDBv1 SQL dispatcher did not return a SELECT result")
    let selected: YazaSqlQueryResultV1 = option_unwrap(selected_result.query_result)
    if list_count(selected.columns) != 3 or list_count(selected.rows) != 0: return err("YDBv1 CREATE TABLE did not create a queryable empty table")

    let duplicate_insert: Result[YazaDbSqlStatementResultV1, Text] = yaza_db_execute_statement_v1(recovered.storage, recovered.wal, "INSERT INTO accounts (id, email, active, points) VALUES (7, 'duplicate-a', TRUE, NULL), (7, 'duplicate-b', FALSE, NULL)", no_parameters)
    if result_is_ok(duplicate_insert): return err("YDBv1 catalog-driven INSERT accepted duplicate primary keys in one batch")
    let insert_result: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(recovered.storage, recovered.wal, "INSERT INTO accounts (id, email, active, points) VALUES (1, 'one@example.test', TRUE, NULL), (2, 'two@example.test', FALSE, NULL)", no_parameters)?
    if insert_result.statement_kind != yaza_db_sql_statement_kind_insert_v1() or not option_is_some(insert_result.write_commit): return err("YDBv1 SQL dispatcher did not return an INSERT commit")
    let inserted: YazaDbWriteCommitV1 = option_unwrap(insert_result.write_commit)
    if inserted.txn_id != 2 or inserted.commit_ts != 3: return err("YDBv1 catalog-driven INSERT did not commit the expected transaction")
    let id_parameter: YazaSqlValueV1 = yaza_sql_value_integer_v1(4, 3)?
    let email_parameter: YazaSqlValueV1 = yaza_sql_value_text_v1("three@example.test")
    let active_parameter: YazaSqlValueV1 = yaza_sql_value_null_v1(1)?
    let points_parameter: YazaSqlValueV1 = yaza_sql_value_null_v1(3)?
    let parameters: List[YazaSqlValueV1] = [id_parameter, email_parameter, active_parameter, points_parameter]
    let parameter_insert_result: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(inserted.storage, inserted.wal, "INSERT INTO accounts (id, email, active, points) VALUES ($1, $2, $3, $4)", parameters)?
    if not option_is_some(parameter_insert_result.write_commit): return err("YDBv1 SQL dispatcher did not return the parameter INSERT commit")
    let parameter_insert: YazaDbWriteCommitV1 = option_unwrap(parameter_insert_result.write_commit)
    if parameter_insert.txn_id != 3 or parameter_insert.commit_ts != 4: return err("YDBv1 catalog-driven parameter INSERT did not commit the expected transaction")
    let bulk_parts_result: Result[TextList, Text] = text_list_try_new()
    if not result_is_ok(bulk_parts_result): return err("YDBv1 bulk SQL INSERT could not allocate its source fragments")
    let bulk_parts: TextList = result_unwrap(bulk_parts_result)
    if not list_try_reserve(bulk_parts, 800) or not list_try_push(bulk_parts, "INSERT INTO accounts (id, email, active, points) VALUES "): return err("YDBv1 bulk SQL INSERT could not reserve its source fragments")
    var bulk_id: Number = 4
    while bulk_id <= 403:
        if bulk_id > 4:
            if not list_try_push(bulk_parts, ", "): return err("YDBv1 bulk SQL INSERT could not append its row delimiter")
        let bulk_id_text: Text = number_text(bulk_id)
        let bulk_row: Text = "(" + bulk_id_text + ", 'bulk-" + bulk_id_text + "@example.test', TRUE, NULL)"
        if not list_try_push(bulk_parts, bulk_row): return err("YDBv1 bulk SQL INSERT could not append a row")
        set bulk_id = bulk_id + 1
    let bulk_source_result: Result[Text, Text] = text_try_join(bulk_parts, "")
    if not result_is_ok(bulk_source_result): return err("YDBv1 bulk SQL INSERT could not join its source fragments")
    let bulk_source: Text = result_unwrap(bulk_source_result)
    let bulk_insert_result: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(parameter_insert.storage, parameter_insert.wal, bulk_source, no_parameters)?
    if bulk_insert_result.statement_kind != yaza_db_sql_statement_kind_insert_v1() or not option_is_some(bulk_insert_result.write_commit): return err("YDBv1 SQL dispatcher did not return a split-capable bulk INSERT commit")
    let bulk_insert: YazaDbWriteCommitV1 = option_unwrap(bulk_insert_result.write_commit)
    if bulk_insert.txn_id != 4 or bulk_insert.commit_ts != 5: return err("YDBv1 bulk SQL INSERT did not commit the expected transaction")
    let table_roots: YazaDbCatalogSnapshotWithRootsV1 = yaza_db_catalog_snapshot_load_with_roots_v1(bulk_insert.storage.file, bulk_insert.storage.header)?
    let table_root_id: Number = list_get(table_roots.root_page_ids, accounts_index)
    let account_key_ordinals: List[Number] = [0]
    let empty_transaction_statuses: List[YazaDbTxnStatusV1] = List[YazaDbTxnStatusV1]()
    let history_key_value: YazaSqlValueV1 = yaza_sql_value_integer_v1(4, 1)?
    let history_key_text: YazaSqlValueV1 = yaza_sql_value_text_v1("")
    let history_key_active: YazaSqlValueV1 = yaza_sql_value_boolean_v1(false)
    let history_key_points: YazaSqlValueV1 = yaza_sql_value_integer_v1(3, 0)?
    let history_key_values: List[YazaSqlValueV1] = [history_key_value, history_key_text, history_key_active, history_key_points]
    let history_key_nulls: List[Boolean] = [false, false, false, false]
    let history_key: Bytes = yaza_db_key_encode_composite_v1(history_key_values, history_key_nulls, accounts.columns, account_key_ordinals)?
    let table_root_page: Bytes = yaza_db_storage_read_page_v1(bulk_insert.storage.file, bulk_insert.storage.header, table_root_id)?
    let table_root_header: YazaDbPageHeaderV1 = yaza_db_page_header_decode_v1(table_root_page, table_root_id)?
    if table_root_header.page_type != 2 or table_root_header.level != 1 or table_root_header.count < 1: return err("YDBv1 bulk SQL INSERT did not retain the split leaves under its inner root")
    let rejected_delete_order: Result[YazaDbSqlStatementResultV1, Text] = yaza_db_execute_statement_v1(bulk_insert.storage, bulk_insert.wal, "DELETE FROM accounts WHERE id > 400 ORDER BY id", no_parameters)
    if result_is_ok(rejected_delete_order): return err("YDBv1 SQL DELETE accepted ORDER BY outside its supported grammar")
    let delete_id_value: YazaSqlValueV1 = yaza_sql_value_integer_v1(4, 2)?
    let delete_id_parameter: List[YazaSqlValueV1] = [delete_id_value]
    let delete_one_result: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(bulk_insert.storage, bulk_insert.wal, "DELETE FROM accounts WHERE id = $1", delete_id_parameter)?
    if delete_one_result.statement_kind != yaza_db_sql_statement_kind_delete_v1() or not option_is_some(delete_one_result.write_commit): return err("YDBv1 SQL dispatcher did not return a primary-key DELETE commit")
    let delete_one: YazaDbWriteCommitV1 = option_unwrap(delete_one_result.write_commit)
    if delete_one.txn_id != 5 or delete_one.commit_ts != 6: return err("YDBv1 primary-key DELETE did not commit the expected transaction")
    let deleted_key_id: YazaSqlValueV1 = yaza_sql_value_integer_v1(4, 2)?
    let deleted_key_text: YazaSqlValueV1 = yaza_sql_value_text_v1("")
    let deleted_key_active: YazaSqlValueV1 = yaza_sql_value_boolean_v1(false)
    let deleted_key_points: YazaSqlValueV1 = yaza_sql_value_integer_v1(3, 0)?
    let deleted_key_values: List[YazaSqlValueV1] = [deleted_key_id, deleted_key_text, deleted_key_active, deleted_key_points]
    let deleted_key_nulls: List[Boolean] = [false, false, false, false]
    let deleted_key: Bytes = yaza_db_key_encode_composite_v1(deleted_key_values, deleted_key_nulls, accounts.columns, account_key_ordinals)?
    let deleted_seek: YazaDbBtreeSeekV1 = yaza_db_btree_seek_leaf_v1(delete_one.storage.file, delete_one.storage.header, table_root_id, deleted_key)?
    let deleted_page: Bytes = yaza_db_storage_read_page_v1(delete_one.storage.file, delete_one.storage.header, deleted_seek.leaf_page_id)?
    let deleted_header: YazaDbPageHeaderV1 = yaza_db_page_header_decode_v1(deleted_page, deleted_seek.leaf_page_id)?
    let deleted_slot_index: Number = yaza_db_page_lower_bound_v1(deleted_page, deleted_key, deleted_seek.leaf_page_id)?
    if deleted_slot_index >= deleted_header.count: return err("YDBv1 SQL DELETE did not retain its clustered row as a tombstone")
    let deleted_stored_key: Bytes = yaza_db_page_slot_key_v1(deleted_page, deleted_slot_index, deleted_seek.leaf_page_id)?
    if not bytes_equal(deleted_stored_key, deleted_key): return err("YDBv1 SQL DELETE tombstone is stored under a different key")
    let deleted_slot: YazaDbPageSlotV1 = yaza_db_page_slot_v1(deleted_page, deleted_slot_index, deleted_seek.leaf_page_id)?
    let deleted_tombstone: YazaDbRowV1 = yaza_db_row_decode_v1(deleted_slot.payload, accounts.columns)?
    if not deleted_tombstone.deleted or deleted_tombstone.undo_ref <= 0 or deleted_tombstone.version_ts != delete_one.commit_ts: return err("YDBv1 SQL DELETE tombstone flags, LSN, or timestamp are invalid")
    let before_delete_rows: Option[YazaDbRowV1] = yaza_db_mvcc_resolve_row_history_v1(root, delete_one.wal.db_uuid, delete_one.wal.next_lsn, deleted_key, deleted_tombstone, 5, 0, empty_transaction_statuses, accounts.columns)?
    if not option_is_some(before_delete_rows) or list_get(option_unwrap(before_delete_rows).values, 1).text_value != "two@example.test": return err("YDBv1 MVCC history did not restore the row before DELETE")
    let after_delete_rows: Option[YazaDbRowV1] = yaza_db_mvcc_resolve_row_history_v1(root, delete_one.wal.db_uuid, delete_one.wal.next_lsn, deleted_key, deleted_tombstone, delete_one.commit_ts, 0, empty_transaction_statuses, accounts.columns)?
    if option_is_some(after_delete_rows): return err("YDBv1 MVCC history returned a visible tombstone as a live row")
    let deleted_point_rows: List[YazaDbRowV1] = yaza_db_btree_read_rows_by_key_v1(delete_one.storage.file, delete_one.storage.header, table_root_id, accounts.columns, account_key_ordinals, delete_one.commit_ts, deleted_key)?
    if list_count(deleted_point_rows) != 0: return err("YDBv1 point lookup returned a deleted tombstone")
    let before_delete_query: YazaSqlQueryResultV1 = yaza_db_execute_select_at_snapshot_v1(delete_one.storage, delete_one.wal, "SELECT email FROM accounts WHERE id = 2", no_parameters, 5, 0, empty_transaction_statuses)?
    if list_count(before_delete_query.rows) != 1 or list_get(list_get(before_delete_query.rows, 0), 0).text_value != "two@example.test": return err("YDBv1 historical SQL SELECT did not return the row before DELETE")
    let after_delete_query: YazaSqlQueryResultV1 = yaza_db_execute_select_at_snapshot_v1(delete_one.storage, delete_one.wal, "SELECT email FROM accounts WHERE id = 2", no_parameters, delete_one.commit_ts, 0, empty_transaction_statuses)?
    if list_count(after_delete_query.rows) != 0: return err("YDBv1 historical SQL SELECT returned a row deleted at its snapshot")
    let delete_range_result: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(delete_one.storage, delete_one.wal, "DELETE FROM accounts WHERE id >= 300", no_parameters)?
    if not option_is_some(delete_range_result.write_commit): return err("YDBv1 SQL dispatcher did not return a predicate DELETE commit")
    let delete_range: YazaDbWriteCommitV1 = option_unwrap(delete_range_result.write_commit)
    if delete_range.txn_id != 6 or delete_range.commit_ts != 7: return err("YDBv1 predicate DELETE did not commit the expected transaction")
    let deleted_range_check: YazaSqlQueryResultV1 = yaza_db_execute_select_v1(delete_range.storage.file, delete_range.storage.header, "SELECT id FROM accounts WHERE id >= 300", no_parameters)?
    if list_count(deleted_range_check.rows) != 0: return err("YDBv1 104-row predicate DELETE left rows visible in its committed snapshot")
    let rejected_update_key: Result[YazaDbSqlStatementResultV1, Text] = yaza_db_execute_statement_v1(delete_range.storage, delete_range.wal, "UPDATE accounts SET id = 30 WHERE id = 3", no_parameters)
    if result_is_ok(rejected_update_key): return err("YDBv1 SQL UPDATE accepted mutation of its clustered primary key")
    let rejected_update_null: Result[YazaDbSqlStatementResultV1, Text] = yaza_db_execute_statement_v1(delete_range.storage, delete_range.wal, "UPDATE accounts SET email = NULL WHERE id = 3", no_parameters)
    if result_is_ok(rejected_update_null): return err("YDBv1 SQL UPDATE accepted NULL for a NOT NULL column")
    let rejected_update_duplicate: Result[YazaDbSqlStatementResultV1, Text] = yaza_db_execute_statement_v1(delete_range.storage, delete_range.wal, "UPDATE accounts SET active = TRUE, active = FALSE WHERE id = 3", no_parameters)
    if result_is_ok(rejected_update_duplicate): return err("YDBv1 SQL UPDATE accepted a repeated target column")
    let rejected_update_without_where: Result[YazaDbSqlStatementResultV1, Text] = yaza_db_execute_statement_v1(delete_range.storage, delete_range.wal, "UPDATE accounts SET active = FALSE", no_parameters)
    if result_is_ok(rejected_update_without_where): return err("YDBv1 SQL UPDATE accepted a missing WHERE clause")
    let rejected_update_order: Result[YazaDbSqlStatementResultV1, Text] = yaza_db_execute_statement_v1(delete_range.storage, delete_range.wal, "UPDATE accounts SET active = FALSE WHERE id = 3 ORDER BY id", no_parameters)
    if result_is_ok(rejected_update_order): return err("YDBv1 SQL UPDATE accepted ORDER BY outside its supported grammar")
    let rejected_update_missing_parameter: Result[YazaDbSqlStatementResultV1, Text] = yaza_db_execute_statement_v1(delete_range.storage, delete_range.wal, "UPDATE accounts SET email = $1 WHERE id = 3", no_parameters)
    if result_is_ok(rejected_update_missing_parameter): return err("YDBv1 SQL UPDATE accepted a missing SET bind parameter")
    let wrong_update_parameter: YazaSqlValueV1 = yaza_sql_value_integer_v1(4, 99)?
    let wrong_update_parameters: List[YazaSqlValueV1] = [wrong_update_parameter]
    let rejected_update_parameter_type: Result[YazaDbSqlStatementResultV1, Text] = yaza_db_execute_statement_v1(delete_range.storage, delete_range.wal, "UPDATE accounts SET email = $1 WHERE id = 3", wrong_update_parameters)
    if result_is_ok(rejected_update_parameter_type): return err("YDBv1 SQL UPDATE accepted a SET parameter with the wrong type")
    let null_update_parameter: YazaSqlValueV1 = yaza_sql_value_null_v1(9)?
    let null_update_parameters: List[YazaSqlValueV1] = [null_update_parameter]
    let rejected_update_parameter_null: Result[YazaDbSqlStatementResultV1, Text] = yaza_db_execute_statement_v1(delete_range.storage, delete_range.wal, "UPDATE accounts SET email = $1 WHERE id = 3", null_update_parameters)
    if result_is_ok(rejected_update_parameter_null): return err("YDBv1 SQL UPDATE accepted a NULL SET parameter for a NOT NULL column")
    let mixed_update_text: YazaSqlValueV1 = yaza_sql_value_text_v1("mixed@example.test")
    let wrong_mixed_id: YazaSqlValueV1 = yaza_sql_value_text_v1("3")
    let wrong_mixed_parameters: List[YazaSqlValueV1] = [mixed_update_text, wrong_mixed_id]
    let rejected_update_mixed_type: Result[YazaDbSqlStatementResultV1, Text] = yaza_db_execute_statement_v1(delete_range.storage, delete_range.wal, "UPDATE accounts SET email = :value WHERE id = :id", wrong_mixed_parameters)
    if result_is_ok(rejected_update_mixed_type): return err("YDBv1 SQL UPDATE accepted a named parameter with an incompatible WHERE type")
    let update_parameter: YazaSqlValueV1 = yaza_sql_value_text_v1("patched@example.test")
    let update_parameters: List[YazaSqlValueV1] = [update_parameter]
    let update_result: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(delete_range.storage, delete_range.wal, "UPDATE accounts SET email = $1, active = FALSE WHERE id >= 1 AND id <= 3", update_parameters)?
    if update_result.statement_kind != yaza_db_sql_statement_kind_update_v1() or not option_is_some(update_result.write_commit): return err("YDBv1 SQL dispatcher did not return a predicate UPDATE commit")
    let updated: YazaDbWriteCommitV1 = option_unwrap(update_result.write_commit)
    if updated.txn_id != 7 or updated.commit_ts != 8: return err("YDBv1 predicate UPDATE did not commit the expected transaction")
    let updated_rows: List[YazaDbRowV1] = yaza_db_btree_read_rows_by_key_v1(updated.storage.file, updated.storage.header, table_root_id, accounts.columns, account_key_ordinals, updated.commit_ts, history_key)?
    if list_count(updated_rows) != 1 or list_get(updated_rows, 0).undo_ref <= 0: return err("YDBv1 SQL UPDATE did not persist a WAL undo reference in its current row")
    let versioned_row: YazaDbRowV1 = list_get(updated_rows, 0)
    if list_get(versioned_row.values, 0).integer_value != 1 or versioned_row.version_ts != updated.commit_ts: return err("YDBv1 SQL UPDATE undo-reference fixture selected the wrong current row")
    let update_record: YazaDbWalRecordV1 = yaza_db_wal_read_record_at_v1(root, updated.wal.db_uuid, versioned_row.undo_ref, updated.wal.next_lsn)?
    if update_record.rec_type != yaza_db_wal_type_leaf_update_v1(): return err("YDBv1 SQL UPDATE undo reference does not point to a LEAF_UPDATE record")
    let prior_snapshot_rows: Option[YazaDbRowV1] = yaza_db_mvcc_resolve_row_history_v1(root, updated.wal.db_uuid, updated.wal.next_lsn, history_key, versioned_row, 7, 0, empty_transaction_statuses, accounts.columns)?
    if not option_is_some(prior_snapshot_rows) or list_get(option_unwrap(prior_snapshot_rows).values, 1).text_value != "one@example.test": return err("YDBv1 MVCC history lookup did not resolve the pre-UPDATE snapshot")
    let prior_update_query: YazaSqlQueryResultV1 = yaza_db_execute_select_at_snapshot_v1(updated.storage, updated.wal, "SELECT email FROM accounts WHERE id = 1", no_parameters, 7, 0, empty_transaction_statuses)?
    if list_count(prior_update_query.rows) != 1 or list_get(list_get(prior_update_query.rows, 0), 0).text_value != "one@example.test": return err("YDBv1 historical SQL SELECT did not return the row before UPDATE")
    let clipped_log_result: Result[Option[YazaDbRowV1], Text] = yaza_db_mvcc_resolve_row_history_v1(root, updated.wal.db_uuid, versioned_row.undo_ref, history_key, versioned_row, 7, 0, empty_transaction_statuses, accounts.columns)
    if result_is_ok(clipped_log_result): return err("YDBv1 MVCC history lookup accepted a WAL end before its undo record")
    let update_mutation: YazaDbWalLeafMutationV1 = yaza_db_wal_leaf_mutation_payload_decode_v1(update_record)?
