    let update_expr_min_modulo: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(update_expr_min.storage, update_expr_min.wal, "UPDATE update_expr_probe SET wide_value = wide_value % -1 WHERE id = 2", no_parameters)?
    if not option_is_some(update_expr_min_modulo.write_commit): return err("YDBv1 UPDATE BIGINT minimum remainder by negative one did not commit")
    let update_expr_modulo_final: YazaDbWriteCommitV1 = option_unwrap(update_expr_min_modulo.write_commit)
    let update_expr_verify_result: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(update_expr_modulo_final.storage, update_expr_modulo_final.wal, "SELECT id, left_value, wide_value FROM update_expr_probe WHERE id > 0 ORDER BY id", no_parameters)?
    if not option_is_some(update_expr_verify_result.query_result): return err("YDBv1 UPDATE arithmetic verification did not return a query")
    let update_expr_verify: YazaSqlQueryResultV1 = option_unwrap(update_expr_verify_result.query_result)
    if list_count(update_expr_verify.rows) != 2 or list_get(list_get(update_expr_verify.rows, 0), 1).integer_value != 1 or list_get(list_get(update_expr_verify.rows, 0), 2).integer_value != 9223372036854775807 or not list_get(list_get(update_expr_verify.rows, 1), 1).is_null or list_get(list_get(update_expr_verify.rows, 1), 2).integer_value != 0: return err("YDBv1 UPDATE column arithmetic returned incorrect values, NULL semantics, or BIGINT boundaries")

    let double_add_result: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(update_expr_verify_result.storage, update_expr_verify_result.wal, "UPDATE update_expr_probe SET ratio_value = ratio_value + ratio_step WHERE id = 1", no_parameters)?
    if not option_is_some(double_add_result.write_commit): return err("YDBv1 DOUBLE addition UPDATE did not commit")
    let double_added: YazaDbWriteCommitV1 = option_unwrap(double_add_result.write_commit)
    let double_mul_sub_result: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(double_added.storage, double_added.wal, "UPDATE update_expr_probe SET ratio_value = ratio_value * 3.0, ratio_step = ratio_step - 0.25 WHERE id = 1", no_parameters)?
    if not option_is_some(double_mul_sub_result.write_commit): return err("YDBv1 DOUBLE multiply/subtract UPDATE did not commit")
    let double_mul_sub: YazaDbWriteCommitV1 = option_unwrap(double_mul_sub_result.write_commit)
    let double_bind_divisor: YazaSqlValueV1 = yaza_sql_value_double_v1(2.0)
    let double_div_params: List[YazaSqlValueV1] = [double_bind_divisor]
    let double_div_result: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(double_mul_sub.storage, double_mul_sub.wal, "UPDATE update_expr_probe SET ratio_value = ratio_value / $1 WHERE id = 1", double_div_params)?
    if not option_is_some(double_div_result.write_commit): return err("YDBv1 DOUBLE bind division UPDATE did not commit")
    let double_div: YazaDbWriteCommitV1 = option_unwrap(double_div_result.write_commit)
    let double_null_result: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(double_div.storage, double_div.wal, "UPDATE update_expr_probe SET ratio_value = ratio_value + ratio_step WHERE id = 2", no_parameters)?
    if not option_is_some(double_null_result.write_commit): return err("YDBv1 DOUBLE NULL propagation UPDATE did not commit")
    let double_null_updated: YazaDbWriteCommitV1 = option_unwrap(double_null_result.write_commit)
    let double_div_zero: Result[YazaDbSqlStatementResultV1, Text] = yaza_db_execute_statement_v1(double_null_updated.storage, double_null_updated.wal, "UPDATE update_expr_probe SET ratio_value = ratio_value / 0.0 WHERE id = 1", no_parameters)
    if result_is_ok(double_div_zero): return err("YDBv1 UPDATE DOUBLE division accepted a zero divisor")
    let double_mod_reject: Result[YazaDbSqlStatementResultV1, Text] = yaza_db_execute_statement_v1(double_null_updated.storage, double_null_updated.wal, "UPDATE update_expr_probe SET ratio_value = ratio_value % 2.0 WHERE id = 1", no_parameters)
    if result_is_ok(double_mod_reject): return err("YDBv1 UPDATE DOUBLE arithmetic accepted modulo")
    let double_verify_result: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(double_null_updated.storage, double_null_updated.wal, "SELECT id, ratio_value, ratio_step FROM update_expr_probe WHERE id > 0 ORDER BY id", no_parameters)?
    if not option_is_some(double_verify_result.query_result): return err("YDBv1 DOUBLE UPDATE verification did not return a query")
    let double_verify: YazaSqlQueryResultV1 = option_unwrap(double_verify_result.query_result)
    if list_count(double_verify.rows) != 2 or list_get(list_get(double_verify.rows, 0), 1).float_value != 3.0 or list_get(list_get(double_verify.rows, 0), 2).float_value != 0.25 or not list_get(list_get(double_verify.rows, 1), 1).is_null or list_get(list_get(double_verify.rows, 1), 2).float_value != 2.0: return err("YDBv1 DOUBLE UPDATE arithmetic returned incorrect values or NULL semantics")

    let final_wal_closed: Boolean = yaza_db_wal_log_close_v1(double_verify_result.wal)?
    let final_storage_closed: Boolean = yaza_db_storage_close_v1(double_verify_result.storage)?
    if not final_wal_closed or not final_storage_closed: return err("YDBv1 CREATE TABLE recovered handles did not close")
    let removed: Boolean = remove(root, db_name)?
    if not removed: return err("YDBv1 CREATE TABLE fixture could not remove its database")
    let synced: Boolean = sync_directory(root)?
    if not synced: return err("YDBv1 CREATE TABLE fixture cleanup sync failed")
    let root_closed: Boolean = close(root)?
    if not root_closed: return err("YDBv1 CREATE TABLE fixture root did not close")
    return ok(after.version)

start:
    let outcome: Result[Number, Text] = yazabase_sql_create_table_persist_v1(arg(1))
    if result_is_ok(outcome):
        say "yazabase-sql-create-table-persist-v1-ok catalog-version=" + number_text(result_unwrap(outcome)) + " arena-peak-bytes=" + number_text(arena_peak_used())
    else:
        say result_unwrap_error(outcome)
