shape Chain:
    value: Number
    next: Option[Result[Chain, Text]]

fn next_link(chain: Chain) -> Option[Result[Chain, Text]]:
    return chain.next

fn chain_value(chain: Chain) -> Number:
    return chain.value

start:
    let terminal: Result[Chain, Text] = err("end")
    let last: Chain = Chain(3, some(terminal))
    let middle: Chain = Chain(2, some(ok(last)))
    let first: Chain = Chain(1, some(ok(middle)))

    assert chain_value(first) == 1
    assert option_is_some(next_link(first))
    let first_result: Result[Chain, Text] = option_unwrap(next_link(first))
    assert result_is_ok(first_result)
    let second: Chain = result_unwrap(first_result)
    assert second.value == 2
    let second_result: Result[Chain, Text] = option_unwrap(second.next)
    let third: Chain = result_unwrap(second_result)
    assert third.value == 3
    let end_result: Result[Chain, Text] = option_unwrap(third.next)
    assert result_unwrap_error(end_result) == "end"

    match first_result:
        ok(value):
            assert value.value == 2
        err(message):
            assert message == "unexpected"

    var editable: Chain = first
    set editable.next = some(err("replaced"))
    assert result_unwrap_error(option_unwrap(editable.next)) == "replaced"

    let values: List[Chain] = List[Chain]()
    list_push(values, first)
    assert result_unwrap(option_unwrap(list_get(values, 0).next)).value == 2
    say "recursive-option-result-shape-ok"
