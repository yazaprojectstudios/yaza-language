fn arithmetic_precedence() -> Boolean:
    return 2 + 3 * 4 == 14 and (2 + 3) * 4 == 20 and 48 / 4 / 3 == 4 and 20 - 5 - 3 == 12 and 17 % 5 * 2 == 4

fn boolean_precedence() -> Boolean:
    return true or false and false

fn unary_precedence() -> Boolean:
    return not false and !false and --1 == 1 and -2 * 3 == -6

fn text_precedence() -> Boolean:
    return "yaza " + "llvm" == "yaza llvm"

start:
    assert arithmetic_precedence()
    assert boolean_precedence()
    assert unary_precedence()
    assert text_precedence()
    assert 1 < 2 and 3 <= 3 and 4 > 3 and 4 >= 4 and 4 != 5
    say "expression-precedence-ok"
