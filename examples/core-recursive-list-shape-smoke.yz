shape Tree:
    value: Number
    children: List[Tree]

fn total(node: Tree) -> Number:
    var sum: Number = node.value
    for child in node.children:
        set sum = sum + total(child)
    return sum

start:
    let no_children: List[Tree] = List[Tree]()
    let leaf: Tree = Tree(2, no_children)
    let children: List[Tree] = List[Tree]()
    list_push(children, leaf)
    let root: Tree = Tree(1, children)
    assert total(root) == 3
    say total(root)
    say "recursive-list-shape-ok"
