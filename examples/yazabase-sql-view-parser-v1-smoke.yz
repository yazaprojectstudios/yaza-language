use "../yazabase/sql_view_v1"

fn yazabase_sql_view_rejected_v1(source: Text, catalog: YazaSqlCatalogSnapshotV1) -> Boolean:
    let parsed: Result[YazaSqlCreateViewAstV1, Text] = yaza_sql_parse_create_view_v1(source)
    if not result_is_ok(parsed): return true
    let bound: Result[YazaSqlCreateViewPlanV1, Text] = yaza_sql_bind_create_view_v1(source, result_unwrap(parsed), catalog)
    return not result_is_ok(bound)

fn yazabase_sql_view_parser_v1_check() -> Boolean:
    let people_columns: List[YazaSqlColumnSchemaV1] = [YazaSqlColumnSchemaV1("id", 4, false, 0, 0, 0, ""), YazaSqlColumnSchemaV1("name", 9, false, 1, 0, 0, ""), YazaSqlColumnSchemaV1("age", 2, false, 2, 0, 0, "")]
    let catalog: YazaSqlCatalogSnapshotV1 = YazaSqlCatalogSnapshotV1(9, [YazaSqlTableSchemaV1(10, "people", people_columns)], List[YazaSqlColumnDefaultV1]())

    let source: Text = "CREATE VIEW adults AS SELECT id, name AS display_name FROM people WHERE age >= 18;"
    let parsed: Result[YazaSqlCreateViewAstV1, Text] = yaza_sql_parse_create_view_v1(source)
    if not result_is_ok(parsed): return false
    let ast: YazaSqlCreateViewAstV1 = result_unwrap(parsed)
    if ast.version != 1 or ast.start_byte != 0 or ast.end_byte != text_length(source): return false
    let bound: Result[YazaSqlCreateViewPlanV1, Text] = yaza_sql_bind_create_view_v1(source, ast, catalog)
    if not result_is_ok(bound): return false
    let plan: YazaSqlCreateViewPlanV1 = result_unwrap(bound)
    if not yaza_sql_create_view_plan_valid_v1(plan) or plan.catalog_version != 9 or plan.view_name != "adults" or plan.dependency_table_id != 10: return false
    if plan.definition != "SELECT id, name AS display_name FROM people WHERE age >= 18" or list_count(plan.output_columns) != 2: return false
    if list_get(plan.output_columns, 0).name != "id" or list_get(plan.output_columns, 0).type_id != 4 or list_get(plan.output_columns, 0).ordinal != 0: return false
    if list_get(plan.output_columns, 1).name != "display_name" or list_get(plan.output_columns, 1).type_id != 9 or list_get(plan.output_columns, 1).ordinal != 1: return false
    let if_not_exists_source: Text = "CREATE VIEW IF NOT EXISTS adults AS SELECT id, name AS display_name FROM people WHERE age >= 18;"
    let if_not_exists_parsed: Result[YazaSqlCreateViewAstV1, Text] = yaza_sql_parse_create_view_v1(if_not_exists_source)
    if not result_is_ok(if_not_exists_parsed): return false
    let if_not_exists_plan: Result[YazaSqlCreateViewPlanV1, Text] = yaza_sql_bind_create_view_v1(if_not_exists_source, result_unwrap(if_not_exists_parsed), catalog)
    if not result_is_ok(if_not_exists_plan) or result_unwrap(if_not_exists_plan).view_name != "adults" or result_unwrap(if_not_exists_plan).definition != "SELECT id, name AS display_name FROM people WHERE age >= 18": return false
    if result_is_ok(yaza_sql_parse_create_view_v1("CREATE VIEW IF adults AS SELECT id FROM people")): return false
    if result_is_ok(yaza_sql_parse_create_view_v1("CREATE VIEW IF NOT adults AS SELECT id FROM people")): return false
    if result_is_ok(yaza_sql_parse_create_view_v1("CREATE VIEW IF EXISTS adults AS SELECT id FROM people")): return false

    if result_is_ok(yaza_sql_parse_create_view_v1("CREATE VIEW bad AS SELECT id FROM people; SELECT 1")): return false
    if result_is_ok(yaza_sql_parse_create_view_v1("CREATE VIEW public.bad AS SELECT id FROM people")): return false
    if result_is_ok(yaza_sql_parse_create_view_v1("CREATE VIEW bad AS DELETE FROM people")): return false
    if not yazabase_sql_view_rejected_v1("CREATE VIEW bad AS SELECT * FROM people", catalog): return false
    if not yazabase_sql_view_rejected_v1("CREATE VIEW bad AS SELECT id FROM people WHERE id = $1", catalog): return false
    if not yazabase_sql_view_rejected_v1("CREATE VIEW bad AS SELECT id, name AS id FROM people", catalog): return false
    if not yazabase_sql_view_rejected_v1("CREATE VIEW people AS SELECT id FROM people", catalog): return false
    if not yazabase_sql_view_rejected_v1("CREATE VIEW bad AS SELECT id FROM unknown_table", catalog): return false
    if not yazabase_sql_view_rejected_v1("CREATE VIEW bad AS SELECT id FROM people JOIN people AS other ON people.id = other.id", catalog): return false

    let drop_source: Text = "DROP VIEW IF EXISTS adults;"
    let drop: Result[YazaSqlDropViewAstV1, Text] = yaza_sql_parse_drop_view_v1(drop_source)
    if not result_is_ok(drop) or result_unwrap(drop).version != 1 or not result_unwrap(drop).if_exists or result_unwrap(drop).view_name != "adults": return false
    let drop_plain: Result[YazaSqlDropViewAstV1, Text] = yaza_sql_parse_drop_view_v1("DROP VIEW adults")
    if not result_is_ok(drop_plain) or result_unwrap(drop_plain).if_exists: return false
    if result_is_ok(yaza_sql_parse_drop_view_v1("DROP VIEW IF adults")): return false
    if result_is_ok(yaza_sql_parse_drop_view_v1("DROP VIEW public.adults")): return false
    if result_is_ok(yaza_sql_parse_drop_view_v1("DROP VIEW adults; SELECT 1")): return false
    return true

start:
    if yazabase_sql_view_parser_v1_check():
        say "yazabase-sql-view-parser-v1-ok"
    else:
        say "yazabase-sql-view-parser-v1-failed"
        exit(1)
