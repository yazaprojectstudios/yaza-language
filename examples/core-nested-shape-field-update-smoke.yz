shape Address:
    city: Text
    number: Number

shape Owner:
    address: Address
    active: Boolean

start:
    var owner: Owner = Owner(Address("Tokyo", 7), true)
    set owner.address.city = "Osaka"
    set owner.address.number = 8
    assert owner.address.city == "Osaka"
    assert owner.address.number == 8
    assert owner.active
    say "nested-shape-update-ok"
