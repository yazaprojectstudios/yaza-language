start:
    let started_ns: Number = monotonic_ns()
    if started_ns <= 0: fail("monotonic_ns did not return a positive monotonic timestamp")
    var checksum: Number = 0
    var index: Number = 0
    while index < 100000:
        set checksum = checksum + index
        set index = index + 1
    let finished_ns: Number = monotonic_ns()
    if finished_ns <= started_ns: fail("monotonic_ns did not advance during the measured work")
    if checksum != 4999950000: fail("monotonic_ns fixture work checksum mismatch")
    say "core-monotonic-ns-ok"
