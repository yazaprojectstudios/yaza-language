fn factorial(value: Number) -> Number:
    if value <= 1: return 1
    return value * factorial(value - 1)

fn is_even(value: Number) -> Boolean:
    if value == 0: return true
    return is_odd(value - 1)

fn is_odd(value: Number) -> Boolean:
    if value == 0: return false
    return is_even(value - 1)

start:
    assert factorial(10) == 3628800
    assert is_even(24)
    assert not is_even(23)
    assert is_odd(23)
    assert not is_odd(24)
    say "recursion-ok"
