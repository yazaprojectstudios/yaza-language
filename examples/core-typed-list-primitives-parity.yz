fn make_inner_numbers() -> List[Number]:
    var values: List[Number] = List[Number]()
    list_push(values, 11)
    list_push(values, 12)
    return values

fn make_replacement_numbers() -> List[Number]:
    var values: List[Number] = List[Number]()
    list_push(values, 21)
    list_push(values, 22)
    return values

start:
    var int32_values: List[Int32] = List[Int32]()
    list_push(int32_values, int32_from_number(-2147483648))
    assert list_try_push(int32_values, int32_from_number(7))
    assert list_count(int32_values) == 2
    list_set(int32_values, 0, int32_from_number(2147483647))
    assert number_from_int32(list_get(int32_values, 0)) == 2147483647
    let maybe_int32: Option[Int32] = list_try_get(int32_values, 0)
    assert option_is_some(maybe_int32)
    assert number_from_int32(option_unwrap(maybe_int32)) == 2147483647
    assert not option_is_some(list_try_get(int32_values, -1))
    assert not option_is_some(list_try_get(int32_values, 2))

    var float64_values: List[Float64] = List[Float64]()
    list_push(float64_values, float64_parse("1.25e2"))
    assert list_try_push(float64_values, 2.5)
    list_set(float64_values, 1, -0.125)
    assert list_count(float64_values) == 2
    let maybe_float64: Option[Float64] = list_try_get(float64_values, 0)
    assert option_is_some(maybe_float64)
    assert option_unwrap(maybe_float64) == 125.0
    assert list_get(float64_values, 1) == -0.125
    assert not option_is_some(list_try_get(float64_values, 2))

    var boolean_values: List[Boolean] = List[Boolean]()
    list_push(boolean_values, true)
    assert list_try_push(boolean_values, false)
    list_set(boolean_values, 0, false)
    assert list_count(boolean_values) == 2
    let maybe_boolean: Option[Boolean] = list_try_get(boolean_values, 0)
    assert option_is_some(maybe_boolean)
    assert not option_unwrap(maybe_boolean)
    assert not list_get(boolean_values, 1)
    assert not option_is_some(list_try_get(boolean_values, 2))

    var text_values: List[Text] = List[Text]()
    list_push(text_values, "arena-text")
    assert list_try_push(text_values, "second-text")
    list_set(text_values, 0, "replaced-text")
    assert list_count(text_values) == 2
    let maybe_text: Option[Text] = list_try_get(text_values, 0)
    assert option_is_some(maybe_text)
    assert option_unwrap(maybe_text) == "replaced-text"
    assert list_get(text_values, 1) == "second-text"
    assert not option_is_some(list_try_get(text_values, 2))

    var bytes_values: List[Bytes] = List[Bytes]()
    list_push(bytes_values, bytes_from_text("arena-bytes"))
    assert list_try_push(bytes_values, bytes_from_text("second-bytes"))
    list_set(bytes_values, 0, bytes_from_text("replaced-bytes"))
    assert list_count(bytes_values) == 2
    let maybe_bytes: Option[Bytes] = list_try_get(bytes_values, 0)
    assert option_is_some(maybe_bytes)
    assert bytes_equal(option_unwrap(maybe_bytes), bytes_from_text("replaced-bytes"))
    assert bytes_equal(list_get(bytes_values, 1), bytes_from_text("second-bytes"))
    assert not option_is_some(list_try_get(bytes_values, 2))

    var nested_values: List[List[Number]] = List[List[Number]]()
    list_push(nested_values, make_inner_numbers())
    assert list_try_push(nested_values, make_replacement_numbers())
    list_set(nested_values, 1, make_inner_numbers())
    let maybe_nested: Option[List[Number]] = list_try_get(nested_values, 0)
    assert option_is_some(maybe_nested)
    assert list_get(option_unwrap(maybe_nested), 1) == 12
    assert list_get(list_get(nested_values, 1), 0) == 11
    assert not option_is_some(list_try_get(nested_values, 2))

    say "typed-list-primitives-ok"
