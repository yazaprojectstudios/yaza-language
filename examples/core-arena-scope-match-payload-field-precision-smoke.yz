shape Envelope:
    label: Text
    items: List[Bytes]

variant Event:
    Empty
    Data(value: Envelope)

fn wrap(label: Text, items: List[Bytes]) -> Option[Envelope]:
    return some(Envelope(label, items))

fn wrap_nested(label: Text, items: List[Bytes]) -> Option[Result[Envelope, Text]]:
    return some(ok(Envelope(label, items)))

start:
    let parent_label: Text = "parent " + number_text(1)
    arena_scope 4096:
        let local_bytes: Bytes = bytes_from_text("child")
        let optional: Option[Envelope] = wrap(parent_label, List[Bytes]())
        match optional:
            some(value):
                list_push(value.items, local_bytes)
                assert list_count(value.items) == 1
            none:
                assert false
        let nested: Option[Result[Envelope, Text]] = wrap_nested(parent_label, List[Bytes]())
        match nested:
            some(result):
                match result:
                    ok(value):
                        list_push(value.items, local_bytes)
                        assert list_count(value.items) == 1
                    err(_):
                        assert false
            none:
                assert false
        let event: Event = Event::Data(Envelope(parent_label, List[Bytes]()))
        match event:
            Empty:
                assert false
            Data(value):
                list_push(value.items, local_bytes)
                assert list_count(value.items) == 1
    say "match-payload-field-precision-ok"
