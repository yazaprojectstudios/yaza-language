use "../yazabase/overflow_v1"

fn yaza_base_overflow_v1_check() -> Result[Number, Text]:
    let value: Bytes = bytes_try_new_zeroed(20000)?
    var byte_index: Number = 0
    while byte_index < bytes_length(value):
        if not bytes_try_set(value, byte_index, byte_index * 7 % 251): return err("YDBv1 overflow value fixture could not be filled")
        set byte_index = byte_index + 1

    let ids_result: Result[List[Number], Text] = list_try_new()
    if not result_is_ok(ids_result): return err(result_unwrap_error(ids_result))
    let page_ids: List[Number] = result_unwrap(ids_result)
    if not list_try_reserve(page_ids, 2): return err("YDBv1 overflow page-ID fixture reservation failed")
    if not list_try_push(page_ids, 4) or not list_try_push(page_ids, 9): return err("YDBv1 overflow page-ID fixture allocation failed")
    let descending_ids_result: Result[List[Number], Text] = list_try_new()
    if not result_is_ok(descending_ids_result): return err(result_unwrap_error(descending_ids_result))
    let descending_ids: List[Number] = result_unwrap(descending_ids_result)
    if not list_try_push(descending_ids, 9) or not list_try_push(descending_ids, 4): return err("YDBv1 descending-ID fixture allocation failed")
    if result_is_ok(yaza_db_overflow_encode_chain_v1(value, descending_ids, 77)): return err("YDBv1 overflow encoder accepted non-canonical page order")

    let chain: YazaDbOverflowChainV1 = yaza_db_overflow_encode_chain_v1(value, page_ids, 77)?
    if chain.reference.first_page_id != 4 or chain.reference.total_length != 20000 or list_count(chain.pages) != 2: return err("YDBv1 overflow chain metadata is wrong")
    let first_page: Bytes = list_get(chain.pages, 0)
    let first_decoded: YazaDbOverflowPageV1 = yaza_db_overflow_page_decode_v1(first_page, 4)?
    if first_decoded.header.page_lsn != 77 or first_decoded.next_page_id != 9 or bytes_length(first_decoded.payload) != yaza_db_overflow_payload_capacity_v1(): return err("YDBv1 first overflow page did not decode correctly")

    let reference_bytes: Bytes = yaza_db_overflow_ref_encode_v1(chain.reference)?
    let reference: YazaDbOverflowRefV1 = yaza_db_overflow_ref_decode_v1(reference_bytes)?
    if reference.first_page_id != 4 or reference.total_length != bytes_length(value) or reference.checksum != bytes_ydbv1_checksum(value): return err("YDBv1 overflow reference did not round-trip")
    let reconstructed: Bytes = yaza_db_overflow_decode_chain_v1(chain.pages, reference)?
    if not bytes_equal(reconstructed, value): return err("YDBv1 overflow value did not round-trip")

    var bad_checksum: Number = reference.checksum + 1
    if bad_checksum > 4294967295: set bad_checksum = 0
    let wrong_value_crc: Result[Bytes, Text] = yaza_db_overflow_decode_chain_v1(chain.pages, YazaDbOverflowRefV1(reference.first_page_id, reference.total_length, bad_checksum, 0))
    if result_is_ok(wrong_value_crc): return err("YDBv1 overflow decoder accepted a value checksum mismatch")
    let short_pages_result: Result[List[Bytes], Text] = list_try_new()
    if not result_is_ok(short_pages_result): return err(result_unwrap_error(short_pages_result))
    let short_pages: List[Bytes] = result_unwrap(short_pages_result)
    if not list_try_push(short_pages, first_page): return err("YDBv1 short-chain fixture allocation failed")
    if result_is_ok(yaza_db_overflow_decode_chain_v1(short_pages, reference)): return err("YDBv1 overflow decoder accepted a truncated chain")

    let corrupt_reference: Bytes = bytes_try_slice(reference_bytes, 0, bytes_length(reference_bytes))?
    if not bytes_try_set(corrupt_reference, 20, 1): return err("YDBv1 reserved-field fixture could not be changed")
    if result_is_ok(yaza_db_overflow_ref_decode_v1(corrupt_reference)): return err("YDBv1 overflow reference accepted non-zero reserved bytes")
    let corrupt_page: Bytes = bytes_try_slice(first_page, 0, bytes_length(first_page))?
    if not bytes_try_set(corrupt_page, 100, (bytes_get(corrupt_page, 100) + 1) % 256): return err("YDBv1 overflow page corruption fixture could not be changed")
    if result_is_ok(yaza_db_overflow_page_decode_v1(corrupt_page, 4)): return err("YDBv1 overflow page decoder accepted a checksum mismatch")
    return ok(bytes_length(reconstructed))

start:
    let outcome: Result[Number, Text] = yaza_base_overflow_v1_check()
    if result_is_ok(outcome):
        say "yazabase-overflow-v1-ok bytes=" + number_text(result_unwrap(outcome))
    else:
        say result_unwrap_error(outcome)
