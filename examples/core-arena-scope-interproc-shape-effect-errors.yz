shape Envelope:
    items: List[Bytes]

fn append(value: Envelope, item: Bytes) -> Unit:
    list_push(value.items, item)

start:
    let parent_items: List[Bytes] = List[Bytes]()
    arena_scope 4096:
        let local_bytes: Bytes = bytes_from_text("child")
        let envelope: Envelope = Envelope(parent_items)
        append(envelope, local_bytes)
