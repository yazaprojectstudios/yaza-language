start:
    let converted: Result[Bytes, Text] = bytes_try_from_number(255)
    match converted:
        ok(value):
            say bytes_get(value, 0)
        err(message):
            say message
    let invalid: Result[Bytes, Text] = bytes_try_from_number(256)
    match invalid:
        ok(value):
            say bytes_get(value, 0)
        err(message):
            say message
    say "fallible-bytes-construction-ok"
