use "../std/pdf"

start:
    let generated: Result[Bytes, Text] = pdf_text_page("YAZA (native) \\ PDF")
    assert result_is_ok(generated)
    let pdf_bytes: Bytes = result_unwrap(generated)
    let decoded: Option[Text] = bytes_to_text_checked(pdf_bytes)
    assert option_is_some(decoded)
    let pdf: Text = option_unwrap(decoded)
    assert text_starts_with(pdf, "%PDF-1.7\n")
    assert text_find(pdf, "(YAZA \\(native\\) \\\\ PDF) Tj") >= 0
    assert text_find(pdf, "/Type /Catalog") >= 0
    assert text_find(pdf, "/Type /Page") >= 0
    assert text_find(pdf, "/Length ") >= 0
    assert text_find(pdf, "xref\n0 6\n") >= 0
    assert text_find(pdf, "trailer\n<< /Size 6 /Root 1 0 R >>") >= 0
    assert text_find(pdf, "%%EOF\n") >= 0

    let empty_page: Result[Bytes, Text] = pdf_text_page("")
    assert result_is_ok(empty_page)
    let unicode_text: Result[Bytes, Text] = pdf_text_page("YAZA café")
    assert not result_is_ok(unicode_text)
    let control_text: Result[Bytes, Text] = pdf_text_page("first\nsecond")
    assert not result_is_ok(control_text)
    let long_text: Result[Bytes, Text] = pdf_text_page("123456789012345678901234567890123456789012345678901234567890123456789012345678901")
    assert not result_is_ok(long_text)
