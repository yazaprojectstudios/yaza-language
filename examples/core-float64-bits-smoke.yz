fn yaza_float64_bits_roundtrip(bits: Number) -> Boolean:
    return float64_bits(float64_from_bits(bits)) == bits

fn yaza_float64_nan_matches_not_equal(value: Float64) -> Boolean:
    return match value:
        != 0.0 -> true
        else -> false

start:
    let negative_zero_bits: Number = -9223372036854775807 - 1
    if not yaza_float64_bits_roundtrip(0): say "Float64 positive-zero bit pattern did not round-trip"
    if not yaza_float64_bits_roundtrip(negative_zero_bits): say "Float64 negative-zero bit pattern did not round-trip"
    if not yaza_float64_bits_roundtrip(1): say "Float64 subnormal bit pattern did not round-trip"
    if not yaza_float64_bits_roundtrip(9218868437227405312): say "Float64 infinity bit pattern did not round-trip"
    if not yaza_float64_bits_roundtrip(9221120237041090561): say "Float64 NaN payload did not round-trip"
    let nan_value: Float64 = float64_from_bits(9221120237041090561)
    if nan_value == nan_value: say "Float64 NaN unexpectedly compared equal to itself"
    if not (nan_value != nan_value): say "Float64 NaN != NaN did not follow IEEE unordered comparison semantics"
    if not (nan_value != 1.0) or 1.0 == nan_value: say "Float64 NaN comparison with a finite value was incorrect"
    if nan_value < 1.0 or nan_value > 1.0 or nan_value <= 1.0 or nan_value >= 1.0:
        say "Float64 ordered comparison unexpectedly matched NaN"
    if not yaza_float64_nan_matches_not_equal(nan_value): say "Float64 numeric match != did not match a NaN"
    if yaza_float64_nan_matches_not_equal(0.0): say "Float64 numeric match != matched an equal value"
    say "core-float64-bits-ok"
