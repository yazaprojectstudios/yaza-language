fn list_try_set_success() -> Boolean:
    let numbers: List[Number] = List[Number]()
    if not list_try_push(numbers, 41):
        return false
    if not list_try_set(numbers, 0, 42):
        return false
    if list_try_set(numbers, 1, 99):
        return false
    return list_get(numbers, 0) == 42 and list_count(numbers) == 1

start:
    assert list_try_set_success()
    say "fallible-list-update-ok"
