fn sum_range(start: Number, stop: Number) -> Number:
    var total: Number = 0
    for value in start..stop:
        if value == 2: continue
        if value == 5: break
        set total = total + value
    return total

fn sum_while(stop: Number) -> Number:
    var value: Number = 0
    var total: Number = 0
    while value < stop:
        set total = total + value
        set value = value + 1
    return total

fn label(value: Number) -> Text:
    if value < 0:
        return "negative"
    elif value == 0:
        return "zero"
    else:
        return "positive"

start:
    let total: Number = sum_range(1, 7)
    assert total == 8
    assert sum_while(5) == 10
    let stock: Int32 = int32_from_number(42)
    assert number_from_int32(stock) == 42
    let floating: Float64 = float64_from_number(42)
    assert number_from_float64(floating) == 42
    let ready: Boolean = true
    say label(total)
    say "total={total}, int32={stock}, float64={floating}"
    say ready
