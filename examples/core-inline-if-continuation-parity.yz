fn run(mode: Number) -> Number:
    var result: Number = 0
    if mode == 1: set result = 1
        set result = result + 10
    elif mode == 2: set result = 2
        set result = result + 20
    else: set result = 3
        set result = result + 30
    return result

start:
    say run(1)
    say run(2)
    say run(3)
