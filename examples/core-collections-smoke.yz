start:
    var numbers: List[Number] = List[Number]()
    list_push(numbers, 3)
    list_push(numbers, 4)
    list_push(numbers, 5)
    assert list_count(numbers) == 3
    assert numbers[1] == 4
    list_set(numbers, 1, 10)
    assert list_get(numbers, 1) == 10

    var total: Number = 0
    for value in numbers:
        set total = total + value
    say "sum={total}"

    let words: TextList = text_list()
    list_push(words, "arena-owned")
    list_push(words, "text-copy")
    assert list_count(words) == 2
    assert words[0] == "arena-owned"
    list_set(words, 1, "updated")
    for word in words:
        say word

    var ratios: List[Float64] = List[Float64]()
    list_push(ratios, 1.25)
    list_push(ratios, 2.5)
    assert ratios[1] == 2.5

    var flags: List[Boolean] = List[Boolean]()
    list_push(flags, true)
    list_push(flags, false)
    assert flags[0]
    assert not flags[1]

    var counts: List[Int32] = List[Int32]()
    list_push(counts, int32_from_number(8))
    assert number_from_int32(counts[0]) == 8
