use "../yazabase/sql_parser_v3"

fn yaza_base_sql_parser_v3_smoke() -> Boolean:
    let source: Text = "SELECT p.id AS item_id FROM catalog.products AS p WHERE NOT (p.price < :floor OR p.price > :ceiling) AND p.active = TRUE ORDER BY p.id DESC LIMIT 10"
    let parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(source)
    if not result_is_ok(parsed): return false
    let query: YazaSqlSelectAstV3 = result_unwrap(parsed)
    if query.version != 3 or not query.has_where or query.where_root != 5: return false
    if list_count(query.where_nodes) != 6: return false

    let lower: YazaSqlExpressionNodeV3 = list_get(query.where_nodes, 0)
    let upper: YazaSqlExpressionNodeV3 = list_get(query.where_nodes, 1)
    let either_bound: YazaSqlExpressionNodeV3 = list_get(query.where_nodes, 2)
    let negated: YazaSqlExpressionNodeV3 = list_get(query.where_nodes, 3)
    let active: YazaSqlExpressionNodeV3 = list_get(query.where_nodes, 4)
    let root: YazaSqlExpressionNodeV3 = list_get(query.where_nodes, query.where_root)
    if lower.kind != 1 or lower.operator != 3 or lower.value.kind != 5: return false
    if text_slice(source, lower.start_byte, lower.end_byte - lower.start_byte) != "p.price < :floor": return false
    if text_slice(source, lower.operator_start_byte, lower.operator_end_byte - lower.operator_start_byte) != "<": return false
    if upper.kind != 1 or upper.operator != 5 or upper.value.kind != 5: return false
    if either_bound.kind != 3 or either_bound.left_index != 0 or either_bound.right_index != 1: return false
    if text_slice(source, either_bound.operator_start_byte, either_bound.operator_end_byte - either_bound.operator_start_byte) != "OR": return false
    if negated.kind != 4 or negated.left_index != 2 or negated.right_index != -1: return false
    if text_slice(source, negated.operator_start_byte, negated.operator_end_byte - negated.operator_start_byte) != "NOT": return false
    if active.kind != 1 or active.operator != 1: return false
    if root.kind != 2 or root.left_index != 3 or root.right_index != 4: return false
    if text_slice(source, root.operator_start_byte, root.operator_end_byte - root.operator_start_byte) != "AND": return false

    let precedence: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT x FROM t WHERE a = 1 OR b = 2 AND NOT (c <> 3)")
    if not result_is_ok(precedence): return false
    let precedence_query: YazaSqlSelectAstV3 = result_unwrap(precedence)
    if precedence_query.where_root != 5 or list_count(precedence_query.where_nodes) != 6: return false
    let precedence_root: YazaSqlExpressionNodeV3 = list_get(precedence_query.where_nodes, 5)
    let precedence_and: YazaSqlExpressionNodeV3 = list_get(precedence_query.where_nodes, 4)
    if precedence_root.kind != 3 or precedence_root.left_index != 0 or precedence_root.right_index != 4: return false
    if precedence_and.kind != 2 or precedence_and.left_index != 1 or precedence_and.right_index != 3: return false

    let null_predicates: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT id FROM users WHERE deleted_at IS NULL OR expires_at IS NOT NULL")
    if not result_is_ok(null_predicates): return false
    let null_query: YazaSqlSelectAstV3 = result_unwrap(null_predicates)
    if null_query.where_root != 2 or list_count(null_query.where_nodes) != 3: return false
    let is_null_node: YazaSqlExpressionNodeV3 = list_get(null_query.where_nodes, 0)
    let is_not_null_node: YazaSqlExpressionNodeV3 = list_get(null_query.where_nodes, 1)
    let null_root: YazaSqlExpressionNodeV3 = list_get(null_query.where_nodes, 2)
    if is_null_node.kind != 5 or is_null_node.operator != 1 or is_not_null_node.kind != 5 or is_not_null_node.operator != 2: return false
    if null_root.kind != 3 or null_root.left_index != 0 or null_root.right_index != 1: return false
    if text_slice("SELECT id FROM users WHERE deleted_at IS NULL", is_null_node.operator_start_byte, is_null_node.operator_end_byte - is_null_node.operator_start_byte) != "IS NULL": return false

    let invalid_is: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT id FROM users WHERE deleted_at IS DISTINCT FROM NULL")
    if result_is_ok(invalid_is): return false

    let no_where: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT id FROM users")
    if not result_is_ok(no_where): return false
    let no_where_query: YazaSqlSelectAstV3 = result_unwrap(no_where)
    if no_where_query.has_where or no_where_query.where_root != -1 or list_count(no_where_query.where_nodes) != 0: return false

    let column_comparison_source: Text = "SELECT child.parent_id FROM child WHERE child.parent_id = parent.id"
    let column_comparison_parse: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(column_comparison_source)
    if not result_is_ok(column_comparison_parse): return false
    let column_comparison_query: YazaSqlSelectAstV3 = result_unwrap(column_comparison_parse)
    if column_comparison_query.where_root != 0 or list_count(column_comparison_query.where_nodes) != 1: return false
    let column_comparison_node: YazaSqlExpressionNodeV3 = list_get(column_comparison_query.where_nodes, 0)
    if column_comparison_node.kind != 8 or column_comparison_node.operator != 1: return false
    if text_slice(column_comparison_source, column_comparison_node.column.start_byte, column_comparison_node.column.end_byte - column_comparison_node.column.start_byte) != "child.parent_id": return false
    if text_slice(column_comparison_source, column_comparison_node.right_column.start_byte, column_comparison_node.right_column.end_byte - column_comparison_node.right_column.start_byte) != "parent.id": return false

    let join_source: Text = "SELECT u.id, p.name FROM users AS u INNER JOIN profiles AS p ON u.id = p.user_id WHERE u.id > 0"
    let join_parse: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(join_source)
    if not result_is_ok(join_parse): return false
    let join_query: YazaSqlSelectAstV3 = result_unwrap(join_parse)
    if join_query.join_type != 1 or not join_query.has_join_table_alias: return false
    if text_slice(join_source, join_query.join_table_name.start_byte, join_query.join_table_name.end_byte - join_query.join_table_name.start_byte) != "profiles": return false
    if text_slice(join_source, join_query.join_table_alias.start_byte, join_query.join_table_alias.end_byte - join_query.join_table_alias.start_byte) != "p": return false
    if text_slice(join_source, join_query.join_left_column.start_byte, join_query.join_left_column.end_byte - join_query.join_left_column.start_byte) != "u.id": return false
    if text_slice(join_source, join_query.join_right_column.start_byte, join_query.join_right_column.end_byte - join_query.join_right_column.start_byte) != "p.user_id": return false
    let chained_join_source: Text = "SELECT u.id FROM users AS u INNER JOIN profiles AS p ON u.id = p.user_id INNER JOIN orders AS o ON p.id = o.profile_id WHERE o.total > 0"
    let chained_join_parse: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(chained_join_source)
    if not result_is_ok(chained_join_parse): return false
    let chained_join_query: YazaSqlSelectAstV3 = result_unwrap(chained_join_parse)
    if chained_join_query.join_type != 1 or list_count(chained_join_query.additional_joins) != 1: return false
    let additional_join: YazaSqlAdditionalJoinV3 = list_get(chained_join_query.additional_joins, 0)
    if additional_join.join_type != 1 or additional_join.join_comparison_operator != 1 or not additional_join.has_table_alias: return false
    if text_slice(chained_join_source, additional_join.table_name.start_byte, additional_join.table_name.end_byte - additional_join.table_name.start_byte) != "orders": return false
    if text_slice(chained_join_source, additional_join.left_column.start_byte, additional_join.left_column.end_byte - additional_join.left_column.start_byte) != "p.id": return false
    if text_slice(chained_join_source, additional_join.right_column.start_byte, additional_join.right_column.end_byte - additional_join.right_column.start_byte) != "o.profile_id": return false
    let chained_left_source: Text = "SELECT u.id FROM users AS u JOIN profiles AS p ON u.id = p.user_id LEFT OUTER JOIN orders AS o ON p.id = o.profile_id"
    let chained_left_parse: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(chained_left_source)
    if not result_is_ok(chained_left_parse) or list_get(result_unwrap(chained_left_parse).additional_joins, 0).join_type != 2: return false
    let chained_right_parse: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT u.id FROM users AS u JOIN profiles AS p ON u.id = p.user_id RIGHT JOIN orders AS o ON p.id = o.profile_id")
    if not result_is_ok(chained_right_parse) or list_get(result_unwrap(chained_right_parse).additional_joins, 0).join_type != 3: return false
    let chained_full_parse: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT u.id FROM users AS u JOIN profiles AS p ON u.id = p.user_id FULL OUTER JOIN orders AS o ON p.id = o.profile_id")
    if not result_is_ok(chained_full_parse) or list_get(result_unwrap(chained_full_parse).additional_joins, 0).join_type != 4: return false
    let chained_cross_parse: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT u.id FROM users AS u JOIN profiles AS p ON u.id = p.user_id CROSS JOIN orders AS o")
    if not result_is_ok(chained_cross_parse) or list_get(result_unwrap(chained_cross_parse).additional_joins, 0).join_type != 5 or list_get(result_unwrap(chained_cross_parse).additional_joins, 0).join_comparison_operator != 0: return false
    let chained_theta_parse: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT u.id FROM users AS u JOIN profiles AS p ON u.id = p.user_id JOIN orders AS o ON o.profile_id > p.id")
    if not result_is_ok(chained_theta_parse) or list_get(result_unwrap(chained_theta_parse).additional_joins, 0).join_type != 1 or list_get(result_unwrap(chained_theta_parse).additional_joins, 0).join_comparison_operator != 5: return false
    let eight_table_source: Text = "SELECT t0.id FROM t0 AS t0 JOIN t1 AS t1 ON t0.id = t1.id JOIN t2 AS t2 ON t1.id = t2.id JOIN t3 AS t3 ON t2.id = t3.id JOIN t4 AS t4 ON t3.id = t4.id JOIN t5 AS t5 ON t4.id = t5.id JOIN t6 AS t6 ON t5.id = t6.id JOIN t7 AS t7 ON t6.id = t7.id"
    let eight_table_parse: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(eight_table_source)
    if not result_is_ok(eight_table_parse) or list_count(result_unwrap(eight_table_parse).additional_joins) != 6: return false
    let nine_table_source: Text = "SELECT t0.id FROM t0 AS t0 JOIN t1 AS t1 ON t0.id = t1.id JOIN t2 AS t2 ON t1.id = t2.id JOIN t3 AS t3 ON t2.id = t3.id JOIN t4 AS t4 ON t3.id = t4.id JOIN t5 AS t5 ON t4.id = t5.id JOIN t6 AS t6 ON t5.id = t6.id JOIN t7 AS t7 ON t6.id = t7.id JOIN t8 AS t8 ON t7.id = t8.id"
    if result_is_ok(yaza_sql_parse_select_v3(nine_table_source)): return false
    let bare_join: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT u.id FROM users AS u JOIN profiles AS p ON u.id = p.user_id")
    if not result_is_ok(bare_join) or result_unwrap(bare_join).join_type != 1: return false
    let right_join: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT u.id FROM users AS u RIGHT OUTER JOIN profiles AS p ON u.id = p.user_id")
    if not result_is_ok(right_join) or result_unwrap(right_join).join_type != 3: return false
    let full_join: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT u.id FROM users AS u FULL JOIN profiles AS p ON u.id = p.user_id")
    if not result_is_ok(full_join) or result_unwrap(full_join).join_type != 4: return false
    let full_outer_join: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT u.id FROM users AS u FULL OUTER JOIN profiles AS p ON u.id = p.user_id")
    if not result_is_ok(full_outer_join) or result_unwrap(full_outer_join).join_type != 4: return false
    let less_join: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT u.id FROM users AS u JOIN profiles AS p ON u.id < p.user_id")
    if not result_is_ok(less_join) or result_unwrap(less_join).join_comparison_operator != 3: return false
    let less_equal_join: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT u.id FROM users AS u JOIN profiles AS p ON u.id <= p.user_id")
    if not result_is_ok(less_equal_join) or result_unwrap(less_equal_join).join_comparison_operator != 4: return false
    let greater_join: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT u.id FROM users AS u JOIN profiles AS p ON u.id > p.user_id")
    if not result_is_ok(greater_join) or result_unwrap(greater_join).join_comparison_operator != 5: return false
    let greater_equal_join: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT u.id FROM users AS u JOIN profiles AS p ON u.id >= p.user_id")
    if not result_is_ok(greater_equal_join) or result_unwrap(greater_equal_join).join_comparison_operator != 6: return false
    let not_equal_join: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT u.id FROM users AS u JOIN profiles AS p ON u.id <> p.user_id")
    if not result_is_ok(not_equal_join) or result_unwrap(not_equal_join).join_comparison_operator != 2: return false
    let cross_join: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT u.id FROM users AS u CROSS JOIN profiles AS p")
    if not result_is_ok(cross_join) or result_unwrap(cross_join).join_type != 5 or not result_unwrap(cross_join).has_join_table_alias: return false
    if result_unwrap(cross_join).join_left_column.part_count != 0 or result_unwrap(cross_join).join_right_column.part_count != 0: return false
    if result_is_ok(yaza_sql_parse_select_v3("SELECT u.id FROM users u CROSS profiles p")): return false
    if result_is_ok(yaza_sql_parse_select_v3("SELECT u.id FROM users u CROSS JOIN profiles p ON u.id = p.user_id")): return false
    if result_is_ok(yaza_sql_parse_select_v3("SELECT u.id FROM users u LEFT JOIN profiles p ON u.id = p.user_id")): return false
    if result_is_ok(yaza_sql_parse_select_v3("SELECT u.id FROM users u INNER profiles p ON u.id = p.user_id")): return false
    if result_is_ok(yaza_sql_parse_select_v3("SELECT u.id FROM users u JOIN profiles p ON u.id LIKE p.user_id")): return false
    if result_is_ok(yaza_sql_parse_select_v3("SELECT u.id FROM users u JOIN profiles p u.id = p.user_id")): return false
    if result_is_ok(yaza_sql_parse_select_v3("SELECT u.id FROM users AS u JOIN profiles AS p ON u.id = p.user_id CROSS JOIN orders AS o ON p.id = o.profile_id")): return false
    if result_is_ok(yaza_sql_parse_select_v3("SELECT u.id FROM users AS u JOIN profiles AS p ON u.id = p.user_id LEFT JOIN orders AS o ON p.id > o.profile_id")): return false
    if result_is_ok(yaza_sql_parse_select_v3("SELECT u.id FROM users AS u JOIN profiles AS p ON u.id = p.user_id CROSS JOIN orders AS o ON p.id = o.profile_id")): return false

    let sum_projection_source: Text = "SELECT SUM(score) AS total FROM items"
    let sum_projection: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(sum_projection_source)
    if not result_is_ok(sum_projection): return false
    let sum_query: YazaSqlSelectAstV3 = result_unwrap(sum_projection)
    if list_count(sum_query.projections) != 1: return false
    let sum_item: YazaSqlProjectionV2 = list_get(sum_query.projections, 0)
    if sum_item.aggregate_kind != 2 or not sum_item.has_alias or sum_item.name.first_token.kind != 1: return false
    if text_slice(sum_projection_source, sum_item.name.start_byte, sum_item.name.end_byte - sum_item.name.start_byte) != "SUM(score)": return false
    if text_slice(sum_projection_source, sum_item.name.first_token.start_byte, sum_item.name.first_token.end_byte - sum_item.name.first_token.start_byte) != "score": return false
    if result_is_ok(yaza_sql_parse_select_v3("SELECT SUM(*) FROM items")): return false
    let extremum_projection: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT MIN(score), MAX(score) FROM items")
    if not result_is_ok(extremum_projection): return false
    if list_get(result_unwrap(extremum_projection).projections, 0).aggregate_kind != 3 or list_get(result_unwrap(extremum_projection).projections, 1).aggregate_kind != 4: return false
    if result_is_ok(yaza_sql_parse_select_v3("SELECT MIN(*) FROM items")): return false
    let average_projection: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT AVG(score) FROM items")
    if not result_is_ok(average_projection) or list_get(result_unwrap(average_projection).projections, 0).aggregate_kind != 5: return false

    let grouped_source: Text = "SELECT region, COUNT(*) FROM sales WHERE active = TRUE GROUP BY region"
    let grouped_projection: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(grouped_source)
    if not result_is_ok(grouped_projection): return false
    let grouped_query: YazaSqlSelectAstV3 = result_unwrap(grouped_projection)
    if list_count(grouped_query.group_by) != 1 or text_slice(grouped_source, list_get(grouped_query.group_by, 0).start_byte, list_get(grouped_query.group_by, 0).end_byte - list_get(grouped_query.group_by, 0).start_byte) != "region": return false
    let multi_grouped_projection: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT a, b, SUM(value) FROM t GROUP BY a, b ORDER BY a LIMIT 10")
    if not result_is_ok(multi_grouped_projection) or list_count(result_unwrap(multi_grouped_projection).group_by) != 2: return false
    let having_source: Text = "SELECT active, COUNT(*) AS total FROM items GROUP BY active HAVING total >= $1 ORDER BY active"
    let having_projection: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(having_source)
    if not result_is_ok(having_projection): return false
    let having_query: YazaSqlSelectAstV3 = result_unwrap(having_projection)
    if not having_query.has_having or having_query.having_root != 0 or list_count(having_query.having_nodes) != 1: return false
    let having_comparison: YazaSqlExpressionNodeV3 = list_get(having_query.having_nodes, 0)
    if having_comparison.kind != 1 or having_comparison.operator != 6 or having_comparison.value.kind != 5: return false
    if text_slice(having_source, having_comparison.start_byte, having_comparison.end_byte - having_comparison.start_byte) != "total >= $1": return false
    let direct_aggregate_source: Text = "SELECT SUM(score) AS total FROM items HAVING SUM(score) > 7"
    let direct_aggregate: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(direct_aggregate_source)
    if not result_is_ok(direct_aggregate): return false
    let direct_aggregate_node: YazaSqlExpressionNodeV3 = list_get(result_unwrap(direct_aggregate).having_nodes, 0)
    if direct_aggregate_node.aggregate_kind != 2 or direct_aggregate_node.column.first_token.kind != 1: return false
    if text_slice(direct_aggregate_source, direct_aggregate_node.start_byte, direct_aggregate_node.end_byte - direct_aggregate_node.start_byte) != "SUM(score) > 7": return false
    let direct_count: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT COUNT(*) AS n FROM items HAVING COUNT(*) >= 2")
    if not result_is_ok(direct_count) or list_get(result_unwrap(direct_count).having_nodes, 0).aggregate_kind != 1: return false
    let direct_aggregate_null: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT SUM(score) FROM items HAVING SUM(score) IS NULL")
    if not result_is_ok(direct_aggregate_null) or list_get(result_unwrap(direct_aggregate_null).having_nodes, 0).aggregate_kind != 2: return false
    if result_is_ok(yaza_sql_parse_select_v3("SELECT a, COUNT(*) FROM t GROUP BY")): return false
    if result_is_ok(yaza_sql_parse_select_v3("SELECT a, COUNT(*) FROM t GROUP a")): return false
    if result_is_ok(yaza_sql_parse_select_v3("SELECT a, COUNT(*) FROM t GROUP BY a,")): return false
    if result_is_ok(yaza_sql_parse_select_v3("SELECT a, COUNT(*) FROM t GROUP BY a HAVING")): return false
    if result_is_ok(yaza_sql_parse_select_v3("SELECT a FROM t HAVING a = 1 GROUP BY a")): return false

    let missing_close: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT id FROM users WHERE (id = 1")
    if result_is_ok(missing_close): return false
    let dangling_and: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT id FROM users WHERE id = 1 AND")
    if result_is_ok(dangling_and): return false
    let dangling_not: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT id FROM users WHERE NOT")
    if result_is_ok(dangling_not): return false
    let multiline_error: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT id FROM t\r\nWHERE id 1")
    if result_is_ok(multiline_error): return false
    if result_unwrap_error(multiline_error) != "SQL parser expected a comparison operator at byte 27 (line 2, column 10)": return false

    let too_deep: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3("SELECT id FROM users WHERE (((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((id = 1)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))")
    if result_is_ok(too_deep): return false
    if result_unwrap_error(too_deep) != "SQL parser expression nesting exceeds 64 at byte 92 (line 1, column 93)": return false
    return true

start:
    let initial_used: Number = arena_used()
    arena_scope 1048576:
        assert yaza_base_sql_parser_v3_smoke()
    assert arena_used() == initial_used
    say "yazabase-sql-parser-v3-ok"
