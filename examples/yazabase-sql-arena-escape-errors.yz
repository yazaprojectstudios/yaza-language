use "../yazabase/sql_parser_v1"

fn yaza_base_leak_select_ast() -> Result[YazaSqlSelectAstV1, Text]:
    arena_scope 65536:
        return yaza_sql_parse_select_v1("SELECT id FROM users")

start:
    let escaped: Result[YazaSqlSelectAstV1, Text] = yaza_base_leak_select_ast()
    assert not result_is_ok(escaped)
