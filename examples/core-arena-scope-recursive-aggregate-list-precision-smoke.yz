shape Node:
    values: List[Bytes]
    children: List[Node]

fn append_deep(node: Node, value: Bytes, depth: Number) -> Number:
    if depth > 0:
        let child: Node = list_get(node.children, 0)
        return append_deep(child, value, depth - 1)
    list_push(node.values, value)
    return 0

start:
    let persistent: Bytes = bytes_from_text("parent-safe")
    let leaf: Node = Node(List[Bytes](), List[Node]())
    let root: Node = Node(List[Bytes](), List[Node]())
    list_push(root.children, leaf)
    arena_scope 4096:
        append_deep(root, persistent, 1)
    say bytes_to_text(list_get(leaf.values, 0))
