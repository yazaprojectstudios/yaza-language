start:
    let first: List[Number] = List[Number]()
    list_push(first, 7)
    let alias: List[Number] = first
    let second: List[Number] = List[Number]()
    list_push(second, 7)
    if first == alias:
        say "typed alias equal"
    else:
        say "typed alias unequal"
    assert not (first != alias)
    if first != second:
        say "typed distinct unequal"
    else:
        say "typed distinct equal"
    assert not (first == second)

    let texts_a: TextList = text_list()
    list_push(texts_a, "x")
    let texts_alias: TextList = texts_a
    let texts_b: TextList = text_list()
    list_push(texts_b, "x")
    if texts_a == texts_alias:
        say "text alias equal"
    else:
        say "text alias unequal"
    assert not (texts_a != texts_alias)
    if texts_a != texts_b:
        say "text distinct unequal"
    else:
        say "text distinct equal"
    assert not (texts_a == texts_b)
