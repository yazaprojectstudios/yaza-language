use "std/convert"

fn base64_conversion_smoke() -> Result[Boolean, Text]:
    let empty_encoded: Result[Text, Text] = convert_try_base64_encode(bytes_from_text(""))
    if not result_is_ok(empty_encoded) or result_unwrap(empty_encoded) != "":
        return err("Base64 did not encode empty Bytes")

    let samples_result: Result[TextList, Text] = text_list_try_new()
    let expected_result: Result[TextList, Text] = text_list_try_new()
    if not result_is_ok(samples_result) or not result_is_ok(expected_result):
        return err("Base64 fixture could not allocate sample metadata")
    let samples: TextList = result_unwrap(samples_result)
    let expected: TextList = result_unwrap(expected_result)
    if not list_try_push(samples, "f") or not list_try_push(samples, "fo") or not list_try_push(samples, "foo") or not list_try_push(samples, "foobar"):
        return err("Base64 fixture could not append source samples")
    if not list_try_push(expected, "Zg==") or not list_try_push(expected, "Zm8=") or not list_try_push(expected, "Zm9v") or not list_try_push(expected, "Zm9vYmFy"):
        return err("Base64 fixture could not append expected samples")
    var sample_index: Number = 0
    while sample_index < list_count(samples):
        let sample_bytes: Bytes = bytes_from_text(list_get(samples, sample_index))
        let encoded: Result[Text, Text] = convert_try_base64_encode(sample_bytes)
        if not result_is_ok(encoded) or result_unwrap(encoded) != list_get(expected, sample_index):
            return err("Base64 encoded an RFC 4648 sample incorrectly")
        let decoded: Result[Bytes, Text] = convert_try_base64_decode(list_get(expected, sample_index))
        if not result_is_ok(decoded) or not bytes_equal(result_unwrap(decoded), sample_bytes):
            return err("Base64 did not round-trip an RFC 4648 sample")
        set sample_index = sample_index + 1

    let binary_result: Result[Bytes, Text] = bytes_try_new_zeroed(3)
    if not result_is_ok(binary_result): return err(result_unwrap_error(binary_result))
    let binary: Bytes = result_unwrap(binary_result)
    if not bytes_try_set(binary, 0, 0) or not bytes_try_set(binary, 1, 255) or not bytes_try_set(binary, 2, 128):
        return err("Base64 binary fixture could not prepare its bytes")
    let binary_encoded: Result[Text, Text] = convert_try_base64_encode(binary)
    if not result_is_ok(binary_encoded) or result_unwrap(binary_encoded) != "AP+A":
        return err("Base64 changed arbitrary binary data during encoding")
    let binary_decoded: Result[Bytes, Text] = convert_try_base64_decode("AP+A")
    if not result_is_ok(binary_decoded) or not bytes_equal(result_unwrap(binary_decoded), binary):
        return err("Base64 changed arbitrary binary data during decoding")

    let url_binary_encoded: Result[Text, Text] = convert_try_base64url_encode(binary)
    if not result_is_ok(url_binary_encoded) or result_unwrap(url_binary_encoded) != "AP-A":
        return err("Base64URL did not use its URL-safe alphabet and unpadded output")
    let url_binary_decoded: Result[Bytes, Text] = convert_try_base64url_decode("AP-A")
    if not result_is_ok(url_binary_decoded) or not bytes_equal(result_unwrap(url_binary_decoded), binary):
        return err("Base64URL changed arbitrary binary data during decoding")
    let empty_url_encoded: Result[Text, Text] = convert_try_base64url_encode(bytes_from_text(""))
    let empty_url_decoded: Result[Bytes, Text] = convert_try_base64url_decode("")
    if not result_is_ok(empty_url_encoded) or result_unwrap(empty_url_encoded) != "" or not result_is_ok(empty_url_decoded) or bytes_length(result_unwrap(empty_url_decoded)) != 0:
        return err("Base64URL did not round-trip empty input")

    let url_alphabet_bytes_result: Result[Bytes, Text] = bytes_try_new_zeroed(3)
    if not result_is_ok(url_alphabet_bytes_result): return err(result_unwrap_error(url_alphabet_bytes_result))
    let url_alphabet_bytes: Bytes = result_unwrap(url_alphabet_bytes_result)
    if not bytes_try_set(url_alphabet_bytes, 0, 251) or not bytes_try_set(url_alphabet_bytes, 1, 255) or not bytes_try_set(url_alphabet_bytes, 2, 255):
        return err("Base64URL fixture could not prepare alphabet bytes")
    let url_alphabet_encoded: Result[Text, Text] = convert_try_base64url_encode(url_alphabet_bytes)
    if not result_is_ok(url_alphabet_encoded) or result_unwrap(url_alphabet_encoded) != "-___":
        return err("Base64URL did not encode the URL-safe '-' and '_' characters")
    let url_alphabet_decoded: Result[Bytes, Text] = convert_try_base64url_decode("-___")
    if not result_is_ok(url_alphabet_decoded) or not bytes_equal(result_unwrap(url_alphabet_decoded), url_alphabet_bytes):
        return err("Base64URL did not decode the URL-safe '-' and '_' characters")

    let url_samples_result: Result[TextList, Text] = text_list_try_new()
    let url_expected_result: Result[TextList, Text] = text_list_try_new()
    if not result_is_ok(url_samples_result) or not result_is_ok(url_expected_result):
        return err("Base64URL fixture could not allocate sample metadata")
    let url_samples: TextList = result_unwrap(url_samples_result)
    let url_expected: TextList = result_unwrap(url_expected_result)
    if not list_try_push(url_samples, "f") or not list_try_push(url_samples, "fo") or not list_try_push(url_samples, "foo") or not list_try_push(url_samples, "foobar"):
        return err("Base64URL fixture could not append source samples")
    if not list_try_push(url_expected, "Zg") or not list_try_push(url_expected, "Zm8") or not list_try_push(url_expected, "Zm9v") or not list_try_push(url_expected, "Zm9vYmFy"):
        return err("Base64URL fixture could not append expected samples")
    var url_sample_index: Number = 0
    while url_sample_index < list_count(url_samples):
        let url_sample_bytes: Bytes = bytes_from_text(list_get(url_samples, url_sample_index))
        let url_encoded: Result[Text, Text] = convert_try_base64url_encode(url_sample_bytes)
        if not result_is_ok(url_encoded) or result_unwrap(url_encoded) != list_get(url_expected, url_sample_index):
            return err("Base64URL encoded an RFC 4648 unpadded sample incorrectly")
        let url_decoded: Result[Bytes, Text] = convert_try_base64url_decode(list_get(url_expected, url_sample_index))
        if not result_is_ok(url_decoded) or not bytes_equal(result_unwrap(url_decoded), url_sample_bytes):
            return err("Base64URL did not round-trip an RFC 4648 unpadded sample")
        set url_sample_index = url_sample_index + 1

    let invalid_inputs_result: Result[TextList, Text] = text_list_try_new()
    if not result_is_ok(invalid_inputs_result): return err(result_unwrap_error(invalid_inputs_result))
    let invalid_inputs: TextList = result_unwrap(invalid_inputs_result)
    if not list_try_push(invalid_inputs, "Zg=") or not list_try_push(invalid_inputs, "Z=g=") or not list_try_push(invalid_inputs, "Zm9v*") or not list_try_push(invalid_inputs, "Zh==") or not list_try_push(invalid_inputs, "Zg==AAAA") or not list_try_push(invalid_inputs, "===="):
        return err("Base64 fixture could not append malformed samples")
    var invalid_index: Number = 0
    while invalid_index < list_count(invalid_inputs):
        if result_is_ok(convert_try_base64_decode(list_get(invalid_inputs, invalid_index))):
            return err("Base64 decoder accepted malformed, padded, or non-canonical input")
        set invalid_index = invalid_index + 1

    let invalid_url_inputs_result: Result[TextList, Text] = text_list_try_new()
    if not result_is_ok(invalid_url_inputs_result): return err(result_unwrap_error(invalid_url_inputs_result))
    let invalid_url_inputs: TextList = result_unwrap(invalid_url_inputs_result)
    if not list_try_push(invalid_url_inputs, "A") or not list_try_push(invalid_url_inputs, "Zh") or not list_try_push(invalid_url_inputs, "Zm9") or not list_try_push(invalid_url_inputs, "Zg=") or not list_try_push(invalid_url_inputs, "Zg==") or not list_try_push(invalid_url_inputs, "+AAA") or not list_try_push(invalid_url_inputs, "/AAA") or not list_try_push(invalid_url_inputs, "-__="):
        return err("Base64URL fixture could not append malformed samples")
    var invalid_url_index: Number = 0
    while invalid_url_index < list_count(invalid_url_inputs):
        if result_is_ok(convert_try_base64url_decode(list_get(invalid_url_inputs, invalid_url_index))):
            return err("Base64URL decoder accepted padding, a foreign alphabet, or non-canonical input")
        set invalid_url_index = invalid_url_index + 1

    if not result_is_ok(convert_try_parse_boolean("true")) or result_unwrap(convert_try_parse_boolean("true")) != true:
        return err("Boolean conversion rejected lowercase true")
    if not result_is_ok(convert_try_parse_boolean("false")) or result_unwrap(convert_try_parse_boolean("false")) != false:
        return err("Boolean conversion rejected lowercase false")
    if result_is_ok(convert_try_parse_boolean("True")) or result_is_ok(convert_try_parse_boolean(" true ")):
        return err("Boolean conversion accepted non-canonical input")
    return ok(true)

start:
    let outcome: Result[Boolean, Text] = base64_conversion_smoke()
    if not result_is_ok(outcome): say result_unwrap_error(outcome)
    elif result_unwrap(outcome): say "base64-conversion-ok"
    else: say "Base64 conversion fixture returned false"
