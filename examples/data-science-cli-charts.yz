# YAZA Terminal / CLI Statistical Computing & Chart Showcase (Run with: yaza run examples/data-science-cli-charts.yz)
use "std/data/random"
use "std/data/stats"
use "std/data/frame"
use "std/data/ml"
use "std/data/viz"

start:
    arena_scope 67108864:
        say "========================================================================"
        say "  YAZA v1.0 DATA SCIENCE & STATISTICAL COMPUTING ENGINE (CLI CHARTS)"
        say "========================================================================"

        let xs: List[Float64] = List[Float64]()
        let ys: List[Float64] = List[Float64]()
        var i: Number = 0
        while i < 24:
            let x: Float64 = float64_from_number(i + 1)
            list_push(xs, x)
            list_push(ys, 2.5 * x + 10.0)
            set i = i + 1

        say "[1] Unicode 8-Level Block Sparkline:"
        say "    " + result_unwrap(viz_cli_sparkline(ys))

        let cats: TextList = text_list()
        list_push(cats, "YAZA v1.0 (-O2)")
        list_push(cats, "Go 1.27.3")
        list_push(cats, "Node.js v26")
        list_push(cats, "Fastify 5.12")
        list_push(cats, "Next.js 16.4")
        list_push(cats, "Python 3.14")
        let rps: List[Float64] = List[Float64]()
        list_push(rps, 29024.0)
        list_push(rps, 28743.0)
        list_push(rps, 27430.0)
        list_push(rps, 25295.0)
        list_push(rps, 4473.0)
        list_push(rps, 2100.0)
        say "[2] CLI Horizontal Benchmark Bar Chart:"
        say result_unwrap(viz_cli_bar_chart("Fullstack SSR & Data Throughput (req/s)", cats, rps, 36))

        let gauss: List[Float64] = rng_normal_vec(2026, 1000, 100.0, 15.0)
        let jb: NormalityTestResult = result_unwrap(stats_jarque_bera_normality(gauss))
        let ci: ConfidenceInterval = result_unwrap(stats_confidence_interval(gauss, 0.95))
        say "[3] CLI Gaussian Distribution Histogram (Box-Muller N=1000 | JB=" + viz_fmt_num(jb.statistic) + " p=" + viz_fmt_num(jb.p_value) + " | 95% CI=[" + viz_fmt_num(ci.lower_bound) + ", " + viz_fmt_num(ci.upper_bound) + "]):"
        say result_unwrap(viz_cli_histogram("Gaussian Sample N(100, 15^2) Distribution", gauss, 9, 36))

        let g_yaza: List[Float64] = rng_normal_vec(11, 80, 5.45, 0.4)
        let g_go: List[Float64] = rng_normal_vec(22, 80, 14.20, 1.2)
        let g_py: List[Float64] = rng_normal_vec(33, 80, 42.80, 3.5)
        let g_names: TextList = text_list()
        list_push(g_names, "YAZA (-O2)")
        list_push(g_names, "Go 1.27")
        list_push(g_names, "Python 3")
        let g_list: List[List[Float64]] = List[List[Float64]]()
        list_push(g_list, g_yaza)
        list_push(g_list, g_go)
        list_push(g_list, g_py)
        let anova: AnovaOneWayResult = result_unwrap(stats_anova_oneway(g_list))
        let kw: KruskalWallisResult = result_unwrap(stats_kruskal_wallis(g_list))
        say "[4] CLI Multi-Group Box-and-Whisker Plot (ANOVA F=" + viz_fmt_num(anova.f_stat) + " | Kruskal-Wallis H=" + viz_fmt_num(kw.h_statistic) + "):"
        say result_unwrap(viz_cli_boxplot("1M-Point Statistical Latency Distribution (ms)", g_names, g_list, 40))

        say "[5] CLI 2D Scatter & OLS Linear Regression Canvas:"
        say result_unwrap(viz_cli_scatter_plot("Ad Spend (x) vs Revenue (y)", xs, ys, 48, 10))

        say "[6] CLI Time-Series Autocorrelation Correlogram (ACF):"
        say result_unwrap(viz_cli_acf_correlogram("Time-Series Autocorrelation ACF(0..6)", ys, 6))
