fn pass_bytes_option(value: Option[Bytes]) -> Option[Bytes]:
    return value

fn pass_bytes_result(value: Result[Bytes, Text]) -> Result[Bytes, Text]:
    return value

fn pass_bytes_error(value: Result[Text, Bytes]) -> Result[Text, Bytes]:
    return value

start:
    let numbers: List[Option[Number]] = List[Option[Number]]()
    let texts: List[Option[Text]] = List[Option[Text]]()
    let outcomes: List[Result[Number, Text]] = List[Result[Number, Text]]()

    arena_scope 512:
        let bytes_value: Bytes = bytes_from_text("inline")
        let before_inline_wraps: Number = arena_allocation_count()
        let maybe_bytes: Option[Bytes] = pass_bytes_option(some(bytes_value))
        assert arena_allocation_count() == before_inline_wraps
        let result_bytes: Result[Bytes, Text] = pass_bytes_result(ok(bytes_value))
        assert arena_allocation_count() == before_inline_wraps
        let bytes_error: Result[Text, Bytes] = pass_bytes_error(err(bytes_value))
        assert arena_allocation_count() == before_inline_wraps
        assert bytes_equal(option_unwrap(maybe_bytes), bytes_value)
        assert bytes_equal(result_unwrap(result_bytes), bytes_value)
        assert bytes_equal(result_unwrap_error(bytes_error), bytes_value)

        list_push(numbers, some(17))
        list_push(numbers, none)
        list_push(texts, some("kept"))
        list_push(outcomes, ok(23))
        list_push(outcomes, err("handled"))

        let byte_options: List[Bytes] = List[Bytes]()
        list_push(byte_options, bytes_value)
        let before_list_try_get: Number = arena_allocation_count()
        let optional_list_bytes: Option[Bytes] = list_try_get(byte_options, 0)
        assert arena_allocation_count() == before_list_try_get
        assert bytes_equal(option_unwrap(optional_list_bytes), bytes_value)

    match list_get(numbers, 0):
        some(value):
            say value
        none:
            say "missing"

    match list_get(numbers, 1):
        some(value):
            say value
        none:
            say "none"

    match list_get(texts, 0):
        some(value):
            say value
        none:
            say "missing text"

    match list_get(outcomes, 0):
        ok(value):
            say value
        err(message):
            say message

    match list_get(outcomes, 1):
        ok(value):
            say value
        err(message):
            say message

    say "inline-sums-ok"
