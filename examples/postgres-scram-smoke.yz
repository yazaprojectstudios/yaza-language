use "std/pg/scram"

start:
    let first_result: Result[PgScramClientFirst, Text] = pg_scram_client_first_with_nonce("user", "rOprNGfwEbeRWgbNEkqO")
    assert result_is_ok(first_result)
    let first: PgScramClientFirst = result_unwrap(first_result)
    assert first.bare == "n=user,r=rOprNGfwEbeRWgbNEkqO"
    assert first.message == "n,,n=user,r=rOprNGfwEbeRWgbNEkqO"

    let initial_result: Result[Bytes, Text] = pg_scram_initial_message(first)
    assert result_is_ok(initial_result)
    assert bytes_get(result_unwrap(initial_result), 0) == 112

    let server_first: Text = "r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096"
    let final_result: Result[PgScramClientFinal, Text] = pg_scram_client_final(first, "pencil", server_first)
    if not result_is_ok(final_result):
        say "SCRAM FINAL ERROR: " + result_unwrap_error(final_result)
    assert result_is_ok(final_result)
    let final_message: PgScramClientFinal = result_unwrap(final_result)
    assert final_message.message == "c=biws,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,p=dHzbZapWIk4jUhN+Ute9ytag9zjfMHgsqmmiz7AndVQ="

    let continue_result: Result[Bytes, Text] = pg_scram_continue_message(final_message)
    assert result_is_ok(continue_result)
    assert bytes_get(result_unwrap(continue_result), 0) == 112
    assert result_is_ok(pg_scram_verify_server_final(final_message, "v=6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4="))
    assert not result_is_ok(pg_scram_verify_server_final(final_message, "v=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="))
    assert not result_is_ok(pg_scram_verify_server_final(final_message, "e=invalid-proof"))

    assert not result_is_ok(pg_scram_client_first_with_nonce("", "rOprNGfwEbeRWgbNEkqO"))
    let escaped_username: Result[PgScramClientFirst, Text] = pg_scram_client_first_with_nonce("a,b=c", "rOprNGfwEbeRWgbNEkqO")
    assert result_is_ok(escaped_username)
    assert result_unwrap(escaped_username).bare == "n=a=2Cb=3Dc,r=rOprNGfwEbeRWgbNEkqO"
    assert not result_is_ok(pg_scram_client_first_with_nonce("usér", "rOprNGfwEbeRWgbNEkqO"))
    assert not result_is_ok(pg_scram_client_first_with_nonce("user", "short"))
    assert not result_is_ok(pg_scram_client_final(first, "pencil", "r=server,s=YWJj,i=4095"))
    assert not result_is_ok(pg_scram_client_final(first, "pencil", "r=wrong-nonce,s=YWJj,i=4096"))
    assert not result_is_ok(pg_scram_client_final(first, "pencil", "r=server,s=YWJj,i=4096,i=4096"))
    assert not result_is_ok(pg_scram_client_final(first, "pencil", "r=server,s=YWJj,i=4096,x=a,x=b"))
    assert not result_is_ok(pg_scram_client_final(first, "pässword", server_first))
    assert not result_is_ok(pg_scram_base64_decode("YWJ="))
    assert not result_is_ok(pg_scram_base64_decode("YWJj="))
