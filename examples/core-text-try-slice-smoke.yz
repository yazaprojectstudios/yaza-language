fn text_try_slice_success() -> Boolean:
    let valid: Result[Text, Text] = text_try_slice("YAZA", 1, 2)
    if result_is_ok(valid) == false:
        return false
    if result_unwrap(valid) != "AZ":
        return false
    let invalid: Result[Text, Text] = text_try_slice("YAZA", 3, 5)
    if result_is_ok(invalid):
        return false
    return result_unwrap_error(invalid) == "Text slice is out of range"

start:
    assert text_try_slice_success()
    say "fallible-text-slice-ok"
