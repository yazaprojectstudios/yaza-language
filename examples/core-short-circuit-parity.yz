fn record_call(values: List[Number]) -> Boolean:
    list_push(values, 1)
    return true

start:
    var calls: List[Number] = List[Number]()

    assert (false and record_call(calls)) == false
    assert list_count(calls) == 0

    assert (true or record_call(calls)) == true
    assert list_count(calls) == 0

    assert (true and record_call(calls)) == true
    assert (false or record_call(calls)) == true
    assert list_count(calls) == 2
    assert list_get(calls, 0) == 1
    assert list_get(calls, 1) == 1

    say "short-circuit-ok"
