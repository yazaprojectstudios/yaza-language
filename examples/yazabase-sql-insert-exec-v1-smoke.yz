use "../yazabase/sql_binder_v1"
use "../yazabase/sql_insert_v1"
use "../yazabase/sql_insert_bind_v1"
use "../yazabase/sql_insert_exec_v1"
use "../yazabase/sql_executor_v1"
use "../yazabase/sql_decimal_v1"

fn yaza_base_sql_insert_exec_v1_catalog() -> YazaSqlCatalogSnapshotV1:
    let columns: List[YazaSqlColumnSchemaV1] = List[YazaSqlColumnSchemaV1]()
    list_push(columns, YazaSqlColumnSchemaV1("id", 4, false, 0, 0, 0, ""))
    list_push(columns, YazaSqlColumnSchemaV1("name", 9, true, 1, 0, 0, ""))
    list_push(columns, YazaSqlColumnSchemaV1("active", 1, false, 2, 0, 0, ""))
    let tables: List[YazaSqlTableSchemaV1] = List[YazaSqlTableSchemaV1]()
    list_push(tables, YazaSqlTableSchemaV1(11, "users", columns))
    let metric_columns: List[YazaSqlColumnSchemaV1] = List[YazaSqlColumnSchemaV1]()
    list_push(metric_columns, YazaSqlColumnSchemaV1("small_value", 2, false, 0, 0, 0, ""))
    list_push(metric_columns, YazaSqlColumnSchemaV1("int_value", 3, false, 1, 0, 0, ""))
    list_push(metric_columns, YazaSqlColumnSchemaV1("ratio", 6, false, 2, 0, 0, ""))
    list_push(tables, YazaSqlTableSchemaV1(12, "metrics", metric_columns))
    let amount_columns: List[YazaSqlColumnSchemaV1] = List[YazaSqlColumnSchemaV1]()
    list_push(amount_columns, YazaSqlColumnSchemaV1("id", 4, false, 0, 0, 0, ""))
    list_push(amount_columns, YazaSqlColumnSchemaV1("amount", 10, false, 1, 10, 2, ""))
    list_push(tables, YazaSqlTableSchemaV1(13, "amounts", amount_columns))
    return YazaSqlCatalogSnapshotV1(23, tables, List[YazaSqlColumnDefaultV1]())

fn yaza_base_sql_insert_exec_v1_plan(source: Text, catalog: YazaSqlCatalogSnapshotV1) -> Result[YazaSqlBoundInsertPlanV1, Text]:
    let parsed: Result[YazaSqlInsertAstV1, Text] = yaza_sql_parse_insert_v1(source)
    if not result_is_ok(parsed): return err(result_unwrap_error(parsed))
    return yaza_sql_bind_insert_v1(source, result_unwrap(parsed), catalog)

fn yaza_base_sql_insert_exec_v1_literals(catalog: YazaSqlCatalogSnapshotV1) -> Boolean:
    let source: Text = "INSERT INTO users (id, name, active) VALUES (1, 'Ada''s', TRUE), (2, NULL, FALSE)"
    let plan_result: Result[YazaSqlBoundInsertPlanV1, Text] = yaza_base_sql_insert_exec_v1_plan(source, catalog)
    if not result_is_ok(plan_result): return false
    let empty_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let materialized_result: Result[YazaSqlInsertMaterializedV1, Text] = yaza_sql_materialize_insert_v1(result_unwrap(plan_result), empty_parameters)
    if not result_is_ok(materialized_result): return false
    let materialized: YazaSqlInsertMaterializedV1 = result_unwrap(materialized_result)
    if materialized.table_id != 11 or materialized.catalog_version != 23 or list_count(materialized.rows) != 2: return false
    let first: YazaSqlInsertMaterializedRowV1 = list_get(materialized.rows, 0)
    if list_get(first.values, 0).integer_value != 1 or list_get(first.values, 1).text_value != "Ada's" or not list_get(first.values, 2).boolean_value: return false
    if list_get(first.nulls, 0) or list_get(first.nulls, 1) or list_get(first.nulls, 2): return false
    let second: YazaSqlInsertMaterializedRowV1 = list_get(materialized.rows, 1)
    return list_get(second.values, 1).is_null and list_get(second.nulls, 1) and not list_get(second.values, 2).boolean_value

fn yaza_base_sql_insert_exec_v1_parameters(catalog: YazaSqlCatalogSnapshotV1) -> Boolean:
    let source: Text = "INSERT INTO users (id, name, active) VALUES (:id, :name, :active)"
    let plan_result: Result[YazaSqlBoundInsertPlanV1, Text] = yaza_base_sql_insert_exec_v1_plan(source, catalog)
    if not result_is_ok(plan_result): return false
    let parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    list_push(parameters, yaza_sql_executor_value_v1(4, 17, 0.0, false, ""))
    list_push(parameters, yaza_sql_value_text_v1("Grace"))
    list_push(parameters, yaza_sql_value_boolean_v1(true))
    let result: Result[YazaSqlInsertMaterializedV1, Text] = yaza_sql_materialize_insert_v1(result_unwrap(plan_result), parameters)
    if not result_is_ok(result): return false
    let row: YazaSqlInsertMaterializedRowV1 = list_get(result_unwrap(result).rows, 0)
    if list_get(row.values, 0).integer_value != 17 or list_get(row.values, 1).text_value != "Grace" or not list_get(row.values, 2).boolean_value: return false
    if list_get(row.nulls, 0) or list_get(row.nulls, 1) or list_get(row.nulls, 2): return false

    let null_required_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let null_value_result: Result[YazaSqlValueV1, Text] = yaza_sql_value_null_v1(4)
    if not result_is_ok(null_value_result): return false
    list_push(null_required_parameters, result_unwrap(null_value_result))
    list_push(null_required_parameters, yaza_sql_value_text_v1("Grace"))
    list_push(null_required_parameters, yaza_sql_value_boolean_v1(true))
    if result_is_ok(yaza_sql_materialize_insert_v1(result_unwrap(plan_result), null_required_parameters)): return false
    let short_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    list_push(short_parameters, yaza_sql_executor_value_v1(4, 17, 0.0, false, ""))
    return not result_is_ok(yaza_sql_materialize_insert_v1(result_unwrap(plan_result), short_parameters))

fn yaza_base_sql_insert_exec_v1_omitted_nullable(catalog: YazaSqlCatalogSnapshotV1) -> Boolean:
    let source: Text = "INSERT INTO users (id, active) VALUES (3, TRUE)"
    let plan_result: Result[YazaSqlBoundInsertPlanV1, Text] = yaza_base_sql_insert_exec_v1_plan(source, catalog)
    if not result_is_ok(plan_result): return false
    let empty_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let result: Result[YazaSqlInsertMaterializedV1, Text] = yaza_sql_materialize_insert_v1(result_unwrap(plan_result), empty_parameters)
    if not result_is_ok(result): return false
    let row: YazaSqlInsertMaterializedRowV1 = list_get(result_unwrap(result).rows, 0)
    return list_count(row.values) == 3 and list_get(row.values, 1).is_null and list_get(row.nulls, 1)

fn yaza_base_sql_insert_exec_v1_numeric_and_empty_text(catalog: YazaSqlCatalogSnapshotV1) -> Boolean:
    let numeric_source: Text = "INSERT INTO metrics VALUES (-32768, 2147483647, 1.25e2)"
    let numeric_plan: Result[YazaSqlBoundInsertPlanV1, Text] = yaza_base_sql_insert_exec_v1_plan(numeric_source, catalog)
    if not result_is_ok(numeric_plan): return false
    let no_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let numeric_rows: Result[YazaSqlInsertMaterializedV1, Text] = yaza_sql_materialize_insert_v1(result_unwrap(numeric_plan), no_parameters)
    if not result_is_ok(numeric_rows): return false
    let numeric_row: YazaSqlInsertMaterializedRowV1 = list_get(result_unwrap(numeric_rows).rows, 0)
    if list_get(numeric_row.values, 0).integer_value != -32768 or list_get(numeric_row.values, 1).integer_value != 2147483647 or list_get(numeric_row.values, 2).float_value != 125.0: return false

    let overflow_source: Text = "INSERT INTO metrics VALUES (32768, 1, 0.5)"
    let overflow_parse: Result[YazaSqlInsertAstV1, Text] = yaza_sql_parse_insert_v1(overflow_source)
    if not result_is_ok(overflow_parse) or result_is_ok(yaza_sql_bind_insert_v1(overflow_source, result_unwrap(overflow_parse), catalog)): return false

    let empty_source: Text = "INSERT INTO users VALUES (4, '', TRUE)"
    let empty_plan: Result[YazaSqlBoundInsertPlanV1, Text] = yaza_base_sql_insert_exec_v1_plan(empty_source, catalog)
    if not result_is_ok(empty_plan): return false
    let empty_rows: Result[YazaSqlInsertMaterializedV1, Text] = yaza_sql_materialize_insert_v1(result_unwrap(empty_plan), no_parameters)
    if not result_is_ok(empty_rows): return false
    return list_get(list_get(result_unwrap(empty_rows).rows, 0).values, 1).text_value == ""

fn yaza_base_sql_insert_exec_v1_decimal(catalog: YazaSqlCatalogSnapshotV1) -> Boolean:
    let source: Text = "INSERT INTO amounts VALUES (1, 123.4500), (2, -9.99)"
    let plan: Result[YazaSqlBoundInsertPlanV1, Text] = yaza_base_sql_insert_exec_v1_plan(source, catalog)
    if not result_is_ok(plan): return false
    let no_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let materialized: Result[YazaSqlInsertMaterializedV1, Text] = yaza_sql_materialize_insert_v1(result_unwrap(plan), no_parameters)
    if not result_is_ok(materialized): return false
    let first: YazaSqlInsertMaterializedRowV1 = list_get(result_unwrap(materialized).rows, 0)
    let first_amount: YazaSqlValueV1 = list_get(first.values, 1)
    if first_amount.type_id != 10 or first_amount.text_value != "123.45" or yaza_sql_value_decimal_precision_v1(first_amount) != 10 or yaza_sql_value_decimal_scale_v1(first_amount) != 2: return false
    let second: YazaSqlInsertMaterializedRowV1 = list_get(result_unwrap(materialized).rows, 1)
    if list_get(second.values, 1).text_value != "-9.99": return false

    let inexact_source: Text = "INSERT INTO amounts VALUES (3, 1.001)"
    if result_is_ok(yaza_base_sql_insert_exec_v1_plan(inexact_source, catalog)): return false

    let parameter_source: Text = "INSERT INTO amounts VALUES ($1, $2)"
    let parameter_plan: Result[YazaSqlBoundInsertPlanV1, Text] = yaza_base_sql_insert_exec_v1_plan(parameter_source, catalog)
    if not result_is_ok(parameter_plan): return false
    let parsed_parameter_result: Result[YazaSqlDecimalV1, Text] = yaza_sql_decimal_parse_v1("2.500", 10, 3)
    if not result_is_ok(parsed_parameter_result): return false
    let decimal_parameter_result: Result[YazaSqlValueV1, Text] = yaza_sql_value_decimal_v1(result_unwrap(parsed_parameter_result))
    if not result_is_ok(decimal_parameter_result): return false
    let decimal_parameter: YazaSqlValueV1 = result_unwrap(decimal_parameter_result)
    let parameters: List[YazaSqlValueV1] = [yaza_sql_executor_value_v1(4, 4, 0.0, false, ""), decimal_parameter]
    let parameter_rows: Result[YazaSqlInsertMaterializedV1, Text] = yaza_sql_materialize_insert_v1(result_unwrap(parameter_plan), parameters)
    if not result_is_ok(parameter_rows): return false
    let parameter_amount: YazaSqlValueV1 = list_get(list_get(result_unwrap(parameter_rows).rows, 0).values, 1)
    if parameter_amount.text_value != "2.50" or yaza_sql_value_decimal_scale_v1(parameter_amount) != 2: return false

    let inexact_decimal_result: Result[YazaSqlDecimalV1, Text] = yaza_sql_decimal_parse_v1("2.501", 10, 3)
    if not result_is_ok(inexact_decimal_result): return false
    let inexact_value_result: Result[YazaSqlValueV1, Text] = yaza_sql_value_decimal_v1(result_unwrap(inexact_decimal_result))
    if not result_is_ok(inexact_value_result): return false
    let inexact_parameter: YazaSqlValueV1 = result_unwrap(inexact_value_result)
    let rejected_parameters: List[YazaSqlValueV1] = [yaza_sql_executor_value_v1(4, 5, 0.0, false, ""), inexact_parameter]
    return not result_is_ok(yaza_sql_materialize_insert_v1(result_unwrap(parameter_plan), rejected_parameters))

start:
    let initial_used: Number = arena_used()
    arena_scope 524288:
        let catalog: YazaSqlCatalogSnapshotV1 = yaza_base_sql_insert_exec_v1_catalog()
        assert yaza_base_sql_insert_exec_v1_literals(catalog)
        assert yaza_base_sql_insert_exec_v1_parameters(catalog)
        assert yaza_base_sql_insert_exec_v1_omitted_nullable(catalog)
        assert yaza_base_sql_insert_exec_v1_numeric_and_empty_text(catalog)
        assert yaza_base_sql_insert_exec_v1_decimal(catalog)
    assert arena_used() == initial_used
    say "yazabase-sql-insert-exec-v1-ok"
