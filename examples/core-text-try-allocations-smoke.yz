fn text_try_allocations_work() -> Boolean:
    let trimmed_result: Result[Text, Text] = text_try_trim(" \tYAZA \n")
    if not result_is_ok(trimmed_result): return false
    let trimmed: Text = result_unwrap(trimmed_result)
    if trimmed != "YAZA": return false

    let split_result: Result[TextList, Text] = text_try_split("alpha::beta", "::")
    if not result_is_ok(split_result): return false
    let parts: TextList = result_unwrap(split_result)
    if list_count(parts) != 2: return false
    if list_get(parts, 0) != "alpha" or list_get(parts, 1) != "beta": return false

    let lines_result: Result[TextList, Text] = text_try_lines("one\ntwo\n")
    if not result_is_ok(lines_result): return false
    let lines: TextList = result_unwrap(lines_result)
    if list_count(lines) != 2 or list_get(lines, 1) != "two": return false

    let empty_delimiter: Result[TextList, Text] = text_try_split("value", "")
    if result_is_ok(empty_delimiter): return false
    return result_unwrap_error(empty_delimiter) == "text_split delimiter cannot be empty"

start:
    assert text_try_allocations_work()
    say "fallible-text-allocation-ops-ok"
