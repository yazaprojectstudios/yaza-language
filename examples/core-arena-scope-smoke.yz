fn release_notice() -> Unit:
    say "cleanup"
fn return_through_scope() -> Number:
    arena_scope 4096:
        let temporary: Text = "return " + number_text(9)
        defer release_notice()
        say temporary
        return 9
start:
    say number_text(return_through_scope())
    var index: Number = 0
    while index < 4:
        arena_scope 2048:
            if index == 2:
                break
            say number_text(index)
        set index = index + 1
    assert arena_live_scopes() == 0
    say "done"
