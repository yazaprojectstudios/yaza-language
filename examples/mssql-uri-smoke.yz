use "std/mssql/uri"

start:
    # 1. Full URI with credentials, port, db, encrypt, trust
    let uri1: Text = "mssql://sa:Str0ngP%40ss@sql.corp.internal:1433/production?encrypt=true&trustServerCertificate=true&connectionTimeout=45"
    let res1: Result[MssqlConnectionConfig, Text] = mssql_parse_uri(uri1)
    assert result_is_ok(res1)
    let cfg1: MssqlConnectionConfig = result_unwrap(res1)
    assert cfg1.user == "sa"
    assert option_is_some(cfg1.password)
    assert option_unwrap(cfg1.password) == "Str0ngP@ss"
    assert cfg1.host == "sql.corp.internal"
    assert cfg1.port == 1433
    assert option_is_some(cfg1.database)
    assert option_unwrap(cfg1.database) == "production"
    assert cfg1.encrypt
    assert cfg1.trust_server_certificate
    assert cfg1.connect_timeout_seconds == 45

    # 2. sqlserver:// scheme
    let uri2: Text = "sqlserver://localhost/warehouse"
    let res2: Result[MssqlConnectionConfig, Text] = mssql_parse_uri(uri2)
    assert result_is_ok(res2)
    let cfg2: MssqlConnectionConfig = result_unwrap(res2)
    assert cfg2.user == "sa"
    assert cfg2.host == "localhost"
    assert cfg2.port == 1433
    assert option_is_some(cfg2.database)
    assert option_unwrap(cfg2.database) == "warehouse"

    # 3. Invalid schemes and ports
    assert not result_is_ok(mssql_parse_uri("postgres://localhost/db"))
    assert not result_is_ok(mssql_parse_uri("mssql://localhost:99999/db"))
