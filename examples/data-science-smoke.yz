# End-to-End Smoke & Numerical Accuracy Verification for YAZA Data Science Engine (std/math + std/data/*).
use "std/math"
use "std/data/random"
use "std/data/stats"
use "std/data/matrix"
use "std/data/frame"
use "std/data/ml"
use "std/data/viz"

fn approx_eq(a: Float64, b: Float64, tol: Float64) -> Boolean:
    return math_abs_float64(a - b) <= tol

start:
    arena_scope 33554432:
        # 1. High-Precision Transcendental Math (IEEE-754 Bitwise + Minimax/Newton)
        assert(approx_eq(math_sqrt_float64(2.0), 1.4142135623730951, 0.00000000000001))
        assert(approx_eq(math_sqrt_float64(144.0), 12.0, 0.00000000000001))
        assert(approx_eq(math_exp_float64(1.0), math_e(), 0.00000000000001))
        assert(approx_eq(math_ln_float64(math_e()), 1.0, 0.00000000000001))
        assert(approx_eq(math_log10_float64(1000.0), 3.0, 0.000000000001))
        assert(approx_eq(math_pow_float64(2.0, 10.0), 1024.0, 0.0000000001))
        assert(approx_eq(math_sin_float64(math_pi() / 2.0), 1.0, 0.000000000001))
        assert(approx_eq(math_cos_float64(math_pi()), -1.0, 0.000000000001))
        assert(approx_eq(stats_normal_cdf(0.0), 0.5, 0.0000001))
        assert(approx_eq(stats_normal_cdf(1.95996398454), 0.975, 0.00001))

        # 2. Accuracy Proof #1: Ill-Conditioned Summation (Neumaier Compensated vs Naive IEEE-754)
        # In naive IEEE-754 addition: ((1e16 + 1.0) + 1.0 + 1.0 + 1.0) - 1e16 == 0.0 (100% loss of significance!)
        let ill_series: List[Float64] = List[Float64]()
        list_push(ill_series, 10000000000000000.0)
        list_push(ill_series, 1.0)
        list_push(ill_series, 1.0)
        list_push(ill_series, 1.0)
        list_push(ill_series, 1.0)
        list_push(ill_series, -10000000000000000.0)
        let exact_sum: Float64 = stats_sum_compensated(ill_series)
        assert(exact_sum == 4.0)

        # 3. Accuracy Proof #2: Shift-Invariant Welford Variance at 10^9 Offset (Zero Catastrophic Cancellation)
        let shifted: List[Float64] = List[Float64]()
        list_push(shifted, 1000000001.0)
        list_push(shifted, 1000000002.0)
        list_push(shifted, 1000000003.0)
        let desc_shifted: StatsSummary = result_unwrap(stats_describe(shifted))
        assert(approx_eq(desc_shifted.mean, 1000000002.0, 0.000001))
        assert(approx_eq(desc_shifted.variance_sample, 1.0, 0.000000000001))
        assert(approx_eq(desc_shifted.std_dev_sample, 1.0, 0.000000000001))

        # 4. Five-Number Summary, IQR, MAD, Correlation & Welch's t-Test
        let sample_a: List[Float64] = List[Float64]()
        list_push(sample_a, 10.0)
        list_push(sample_a, 12.0)
        list_push(sample_a, 14.0)
        list_push(sample_a, 16.0)
        list_push(sample_a, 18.0)
        let fns: FiveNumberSummary = result_unwrap(stats_five_number_summary(sample_a))
        assert(fns.min == 10.0 and fns.q25 == 12.0 and fns.median == 14.0 and fns.q75 == 16.0 and fns.max == 18.0)
        assert(fns.iqr == 4.0 and fns.mad == 2.0)

        let sample_b: List[Float64] = List[Float64]()
        list_push(sample_b, 20.0)
        list_push(sample_b, 24.0)
        list_push(sample_b, 28.0)
        list_push(sample_b, 32.0)
        list_push(sample_b, 36.0)
        let r_corr: Float64 = result_unwrap(stats_pearson_r(sample_a, sample_b))
        assert(approx_eq(r_corr, 1.0, 0.0000000001))
        let ttest: WelchTTestResult = result_unwrap(stats_welch_ttest(sample_b, sample_a))
        assert(ttest.mean_diff == 14.0 and ttest.t_stat > 4.0 and ttest.significant_at_05)

        # 5. DenseMatrix Linear Algebra & Partial-Pivoting Gaussian Solver (A * x = b)
        # Solve: 2x + y = 5, x + 3y = 10 -> x = 1, y = 3
        let mat_a: DenseMatrix = mat_zeros(2, 2)
        let _m00: Boolean = mat_set(mat_a, 0, 0, 2.0)
        let _m01: Boolean = mat_set(mat_a, 0, 1, 1.0)
        let _m10: Boolean = mat_set(mat_a, 1, 0, 1.0)
        let _m11: Boolean = mat_set(mat_a, 1, 1, 3.0)
        let rhs_b: List[Float64] = List[Float64]()
        list_push(rhs_b, 5.0)
        list_push(rhs_b, 10.0)
        let sol_x: List[Float64] = result_unwrap(mat_solve_linear(mat_a, rhs_b))
        assert(approx_eq(list_get(sol_x, 0), 1.0, 0.0000000001))
        assert(approx_eq(list_get(sol_x, 1), 3.0, 0.0000000001))

        # 6. Columnar Arena DataFrame (CSV Type Inference, Filter & GroupBy Aggregation)
        let csv_raw: Text = "engine,latency_ms,rps\nYAZA,0.16,29024.0\nYAZA,0.12,37990.0\nPython,14.50,2100.0\nPython,16.20,1850.0\n"
        let df: DataFrame = result_unwrap(df_from_csv(csv_raw))
        assert(df.row_count == 4 and df_column_count(df) == 3)
        let fast_df: DataFrame = result_unwrap(df_filter_gt(df, "rps", 10000.0))
        assert(fast_df.row_count == 2)
        let groups: List[GroupBySummaryRow] = result_unwrap(df_groupby_agg(df, "engine", "rps"))
        assert(list_count(groups) == 2)
        let g_yaza: GroupBySummaryRow = list_get(groups, 0)
        assert(g_yaza.group_key == "YAZA" and g_yaza.count == 2 and approx_eq(g_yaza.mean, 33507.0, 0.01))
        let desc_txt: Text = df_describe_text(df)
        assert(text_find(desc_txt, "latency_ms [Float64]") >= 0)

        # 7. Machine Learning: OLS, Multiple Regression, Logistic Classification & K-Means
        let ols: OlsModel = result_unwrap(ml_ols_fit(sample_a, sample_b))
        assert(approx_eq(ols.slope, 2.0, 0.000000001) and approx_eq(ols.intercept, 0.0, 0.000000001) and approx_eq(ols.r_squared, 1.0, 0.000000001))

        # Multiple OLS: y = 5.0 + 2.0*x1 + 3.0*x2
        let x_mult: DenseMatrix = mat_zeros(4, 2)
        let _x0: Boolean = mat_set(x_mult, 0, 0, 1.0)
        let _x1: Boolean = mat_set(x_mult, 0, 1, 1.0)
        let _x2: Boolean = mat_set(x_mult, 1, 0, 2.0)
        let _x3: Boolean = mat_set(x_mult, 1, 1, 1.0)
        let _x4: Boolean = mat_set(x_mult, 2, 0, 1.0)
        let _x5: Boolean = mat_set(x_mult, 2, 1, 3.0)
        let _x6: Boolean = mat_set(x_mult, 3, 0, 3.0)
        let _x7: Boolean = mat_set(x_mult, 3, 1, 2.0)
        let y_mult: List[Float64] = List[Float64]()
        list_push(y_mult, 10.0)
        list_push(y_mult, 12.0)
        list_push(y_mult, 16.0)
        list_push(y_mult, 17.0)
        let mols: MultipleOlsModel = result_unwrap(ml_multiple_ols_fit(x_mult, y_mult, 0.0))
        assert(approx_eq(mols.intercept, 5.0, 0.000001))
        assert(approx_eq(list_get(mols.weights, 0), 2.0, 0.000001))
        assert(approx_eq(list_get(mols.weights, 1), 3.0, 0.000001))
        assert(approx_eq(mols.r_squared, 1.0, 0.000001))

        # Binary Logistic Regression
        let x_log: DenseMatrix = mat_zeros(6, 1)
        let _l0: Boolean = mat_set(x_log, 0, 0, -3.0)
        let _l1: Boolean = mat_set(x_log, 1, 0, -2.0)
        let _l2: Boolean = mat_set(x_log, 2, 0, -1.0)
        let _l3: Boolean = mat_set(x_log, 3, 0, 1.0)
        let _l4: Boolean = mat_set(x_log, 4, 0, 2.0)
        let _l5: Boolean = mat_set(x_log, 5, 0, 3.0)
        let y_log: List[Float64] = List[Float64]()
        list_push(y_log, 0.0)
        list_push(y_log, 0.0)
        list_push(y_log, 0.0)
        list_push(y_log, 1.0)
        list_push(y_log, 1.0)
        list_push(y_log, 1.0)
        let log_mod: LogisticModel = result_unwrap(ml_logistic_fit(x_log, y_log, 0.5, 80, 0.001))
        assert(log_mod.accuracy == 1.0)

        # K-Means 1D Clustering (2 clusters around 10 and 100)
        let km_data: List[Float64] = List[Float64]()
        list_push(km_data, 9.0)
        list_push(km_data, 10.0)
        list_push(km_data, 11.0)
        list_push(km_data, 99.0)
        list_push(km_data, 100.0)
        list_push(km_data, 101.0)
        let km: KMeans1DResult = result_unwrap(ml_kmeans_1d(km_data, 2, 20))
        assert(approx_eq(list_get(km.centroids, 0), 10.0, 0.001) and approx_eq(list_get(km.centroids, 1), 100.0, 0.001))

        # 8. Probability Distributions (std/data/random: Uniform, Gaussian Box-Muller, Exponential, Poisson, Train/Test Split)
        let norm_samples: List[Float64] = rng_normal_vec(42, 500, 50.0, 5.0)
        let norm_desc: StatsSummary = result_unwrap(stats_describe(norm_samples))
        assert(approx_eq(norm_desc.mean, 50.0, 1.0) and approx_eq(norm_desc.std_dev_sample, 5.0, 1.0))
        let split: TrainTestSplit = result_unwrap(rng_train_test_split(norm_samples, 0.2, 42))
        assert(list_count(split.train_values) == 400 and list_count(split.test_values) == 100)

        # 9. One-Way ANOVA F-Test, Chi-Square Goodness-of-Fit & Time-Series Autocorrelation (ACF)
        let anova_groups: List[List[Float64]] = List[List[Float64]]()
        list_push(anova_groups, sample_a)
        list_push(anova_groups, sample_b)
        let anova_res: AnovaOneWayResult = result_unwrap(stats_anova_oneway(anova_groups))
        assert(approx_eq(anova_res.f_stat, 19.6, 0.0001) and anova_res.significant_at_05)

        let obs: List[Float64] = List[Float64]()
        list_push(obs, 50.0)
        list_push(obs, 30.0)
        list_push(obs, 20.0)
        let exp_f: List[Float64] = List[Float64]()
        list_push(exp_f, 50.0)
        list_push(exp_f, 30.0)
        list_push(exp_f, 20.0)
        let chi_res: ChiSquareResult = result_unwrap(stats_chi_square_gof(obs, exp_f))
        assert(chi_res.chi_square_stat == 0.0 and not chi_res.significant_at_05)
        let acf1: Float64 = result_unwrap(stats_autocorrelation(sample_a, 1))
        assert(acf1 > 0.3)

        # 10. Advanced DataFrame: Missing Value Imputation (fillna_mean), Sort, Inner Join & HTML Table Export
        let csv_na: Text = "engine,score\nYAZA,100.0\nGo,NA\nRust,80.0\n"
        let df_na: DataFrame = result_unwrap(df_from_csv(csv_na))
        let df_filled: DataFrame = result_unwrap(df_fillna_mean(df_na, "score"))
        let scores_filled: List[Float64] = result_unwrap(df_get_numeric(df_filled, "score"))
        assert(approx_eq(list_get(scores_filled, 1), 90.0, 0.0001))
        let df_sorted: DataFrame = result_unwrap(df_sort_by_numeric(df_filled, "score", true))
        assert(list_get(result_unwrap(df_get_numeric(df_sorted, "score")), 0) == 80.0)
        let df_joined: DataFrame = result_unwrap(df_inner_join(df, df_filled, "engine"))
        assert(df_joined.row_count == 2 and df_column_count(df_joined) == 4)
        let html_tbl: Text = df_to_html_table(df_joined, 10)
        assert(text_find(html_tbl, "<table class=\"yz-df-table\">") >= 0)

        # 11. Advanced ML: Classification Metrics (F1), ROC-AUC, Multi-Dimensional KNN & PCA Top Component
        let cm: ClassificationMetrics = result_unwrap(ml_binary_metrics(y_log, y_log, 0.5))
        assert(cm.accuracy == 1.0 and cm.f1_score == 1.0)
        let auc: Float64 = result_unwrap(ml_roc_auc(y_log, y_log))
        assert(auc == 1.0)
        let q_pt: List[Float64] = List[Float64]()
        list_push(q_pt, 2.5)
        let knn_pred: Float64 = result_unwrap(ml_knn_classify(x_log, y_log, q_pt, 3))
        assert(knn_pred == 1.0)
        let pca_res: PcaComponentResult = result_unwrap(ml_pca_first_component(x_mult, 32))
        assert(pca_res.explained_variance_ratio > 0.5 and list_count(pca_res.projected_scores) == 4)

        # 12. Frontend SVG Data Visualization Suite (std/data/viz: Line, Scatter+OLS, Bar, Histogram, BoxPlot, Heatmap)
        let cfg_v: ChartConfig = viz_default_config("YAZA Throughput vs Latency", "X", "Y")
        let svg_line: Text = result_unwrap(viz_line_chart(cfg_v, sample_a, sample_b))
        assert(text_find(svg_line, "<polyline") >= 0 and text_find(svg_line, "style=") < 0)
        let svg_scat: Text = result_unwrap(viz_scatter_regression_chart(cfg_v, sample_a, sample_b))
        assert(text_find(svg_scat, "OLS: y =") >= 0)
        let bar_cats: TextList = text_list()
        list_push(bar_cats, "YAZA")
        list_push(bar_cats, "Go")
        list_push(bar_cats, "Python")
        let bar_vals: List[Float64] = List[Float64]()
        list_push(bar_vals, 29024.0)
        list_push(bar_vals, 28743.0)
        list_push(bar_vals, 2100.0)
        let svg_bar: Text = result_unwrap(viz_bar_chart(cfg_v, bar_cats, bar_vals))
        assert(text_find(svg_bar, "29024") >= 0)
        let svg_hist: Text = result_unwrap(viz_histogram_chart(cfg_v, norm_samples, 12))
        assert(text_find(svg_hist, "bins=12") >= 0)
        let bp_names: TextList = text_list()
        list_push(bp_names, "Group A")
        list_push(bp_names, "Group B")
        let svg_box: Text = result_unwrap(viz_boxplot_chart(cfg_v, bp_names, anova_groups))
        assert(text_find(svg_box, "Five-Number Summary") >= 0)
        let svg_heat: Text = result_unwrap(viz_heatmap_matrix(cfg_v, bp_names, bp_names, mat_a))
        assert(text_find(svg_heat, "matrix=2x2") >= 0)

        # 13. Special Math (Lanczos Gamma, Beta, Inverse Trig, Hyperbolic)
        assert(approx_eq(math_tgamma_float64(5.0), 24.0, 0.00001))
        assert(approx_eq(math_atan_float64(1.0), math_pi() / 4.0, 0.00001))
        assert(approx_eq(math_tanh_float64(0.0), 0.0, 0.0000001))

        # 14. Generalized Means, Robust Estimators, qnorm (PPF) & Confidence Intervals
        let gmean: Float64 = result_unwrap(stats_geometric_mean(sample_a))
        let hmean: Float64 = result_unwrap(stats_harmonic_mean(sample_a))
        let tmean: Float64 = result_unwrap(stats_trimmed_mean(sample_a, 0.2))
        let wmean: Float64 = result_unwrap(stats_winsorized_mean(sample_a, 0.2))
        assert(hmean <= gmean and gmean <= 14.0 and approx_eq(tmean, 14.0, 0.0001) and approx_eq(wmean, 14.0, 0.0001))
        let z975: Float64 = result_unwrap(stats_normal_ppf(0.975))
        assert(approx_eq(z975, 1.95996398, 0.001))
        let ci95: ConfidenceInterval = result_unwrap(stats_confidence_interval(sample_a, 0.95))
        assert(ci95.lower_bound < 14.0 and ci95.upper_bound > 14.0)

        # 15. Parametric, Non-Parametric, Normality, Effect Sizes, Information Theory, Bayesian & Time-Series
        let t1s: WelchTTestResult = result_unwrap(stats_one_sample_ttest(sample_a, 10.0))
        let tpair: WelchTTestResult = result_unwrap(stats_paired_ttest(sample_a, sample_b))
        let cohen_d: Float64 = result_unwrap(stats_cohens_d(sample_b, sample_a))
        let hedges_g: Float64 = result_unwrap(stats_hedges_g(sample_b, sample_a))
        assert(t1s.t_stat > 2.0 and tpair.t_stat > 5.0 and cohen_d > 2.0 and hedges_g > 1.8)

        let jb_norm: NormalityTestResult = result_unwrap(stats_jarque_bera_normality(norm_samples))
        let ks_norm: NormalityTestResult = result_unwrap(stats_kolmogorov_smirnov_normal(norm_samples))
        assert(jb_norm.is_normal_at_05 and ks_norm.is_normal_at_05)

        let spearman: Float64 = result_unwrap(stats_spearman_rho(sample_a, sample_b))
        let kendall: Float64 = result_unwrap(stats_kendall_tau(sample_a, sample_b))
        let mwu: MannWhitneyResult = result_unwrap(stats_mann_whitney_u(sample_a, sample_b))
        let kw: KruskalWallisResult = result_unwrap(stats_kruskal_wallis(anova_groups))
        assert(approx_eq(spearman, 1.0, 0.0001) and approx_eq(kendall, 1.0, 0.0001) and mwu.significant_at_05 and kw.significant_at_05)

        let ent: Float64 = result_unwrap(stats_shannon_entropy(obs))
        let jsd: Float64 = result_unwrap(stats_jensen_shannon_divergence(obs, exp_f))
        assert(ent > 0.9 and approx_eq(jsd, 0.0, 0.00001))

        let bayes_ab: BayesBetaPosterior = result_unwrap(stats_bayes_beta_binomial(1.0, 1.0, 48, 100))
        let bayes_n: BayesNormalPosterior = result_unwrap(stats_bayes_normal_update(50.0, 10.0, norm_samples))
        assert(approx_eq(bayes_ab.posterior_mean, 49.0 / 102.0, 0.001) and approx_eq(bayes_n.posterior_mean, 50.0, 1.0))

        let holt_fc: List[Float64] = result_unwrap(stats_holt_linear_forecast(sample_a, 0.8, 0.8, 3))
        assert(list_count(holt_fc) == 3 and list_get(holt_fc, 0) > 18.0)

        # 16. Remaining 12 Frontend SVG Chart Types + 6 Terminal CLI Chart Types
        let svg_mline: Text = result_unwrap(viz_multi_line_chart(cfg_v, sample_a, bp_names, anova_groups))
        let svg_bub: Text = result_unwrap(viz_bubble_chart(cfg_v, sample_a, sample_b, sample_a, bp_names))
        let svg_hbar: Text = result_unwrap(viz_horizontal_bar_chart(cfg_v, bar_cats, bar_vals))
        assert(text_find(svg_mline, "2 Series") >= 0 and text_find(svg_bub, "3D Bubble") >= 0 and text_find(svg_hbar, "29024") >= 0)

        let stack_mat: List[List[Float64]] = List[List[Float64]]()
        list_push(stack_mat, bar_vals)
        list_push(stack_mat, bar_vals)
        let svg_sbar_ok: Text = result_unwrap(viz_stacked_bar_chart(cfg_v, bar_cats, bp_names, stack_mat))
        let svg_kde: Text = result_unwrap(viz_kde_density_chart(cfg_v, norm_samples, 32))
        let svg_violin: Text = result_unwrap(viz_violin_chart(cfg_v, bp_names, anova_groups))
        let svg_qq: Text = result_unwrap(viz_qq_normality_chart(cfg_v, norm_samples))
        let svg_ecdf: Text = result_unwrap(viz_ecdf_chart(cfg_v, norm_samples))
        let svg_acf: Text = result_unwrap(viz_acf_correlogram_chart(cfg_v, sample_a, 3))
        let svg_donut: Text = result_unwrap(viz_pie_donut_chart(cfg_v, bar_cats, bar_vals, true))
        let radar_scores: List[Float64] = List[Float64]()
        list_push(radar_scores, 0.98)
        list_push(radar_scores, 0.95)
        list_push(radar_scores, 0.99)
        let svg_radar: Text = result_unwrap(viz_radar_spider_chart(cfg_v, bar_cats, radar_scores))
        let svg_water: Text = result_unwrap(viz_waterfall_chart(cfg_v, bar_cats, bar_vals))
        assert(text_find(svg_sbar_ok, "Stacked") >= 0 and text_find(svg_kde, "Silverman KDE") >= 0 and text_find(svg_violin, "Violin KDE") >= 0)
        assert(text_find(svg_qq, "Normal Q-Q Plot") >= 0 and text_find(svg_ecdf, "Empirical CDF") >= 0 and text_find(svg_acf, "Autocorrelation Function") >= 0)
        assert(text_find(svg_donut, "TOTAL") >= 0 and text_find(svg_radar, "<polygon") >= 0 and text_find(svg_water, "Waterfall Steps") >= 0)

        # CLI Terminal Charts
        let cli_spark: Text = result_unwrap(viz_cli_sparkline(sample_a))
        let cli_bar: Text = result_unwrap(viz_cli_bar_chart("CLI SSR Benchmark", bar_cats, bar_vals, 30))
        let cli_hist: Text = result_unwrap(viz_cli_histogram("CLI Gaussian Histogram", norm_samples, 8, 30))
        let cli_box: Text = result_unwrap(viz_cli_boxplot("CLI BoxPlot", bp_names, anova_groups, 36))
        let cli_scat: Text = result_unwrap(viz_cli_scatter_plot("CLI Scatter + OLS", sample_a, sample_b, 32, 10))
        let cli_acf: Text = result_unwrap(viz_cli_acf_correlogram("CLI ACF", sample_a, 3))
        assert(text_length(cli_spark) > 10 and text_find(cli_bar, "█") >= 0 and text_find(cli_hist, "▓") >= 0)
        assert(text_find(cli_box, "╬") >= 0 and text_find(cli_scat, "●") >= 0 and text_find(cli_acf, "Lag 0") >= 0)

    say "YAZA_DATA_SCIENCE_SMOKE: PASS"
