shape Profile:
    locale: Text
    active: Boolean

shape Product:
    id: Number
    name: Text
    profile: Profile

fn rename(product: Product, name: Text) -> Product:
    return Product(product.id, name, product.profile)

start:
    let profile: Profile = Profile("id-ID", true)
    var book: Product = Product(7, "YAZA", profile)
    let original: Product = book
    set book.name = "YAZA Core"
    assert book.name == "YAZA Core"
    assert original.name == "YAZA"
    set book.profile = Profile("en-US", false)
    assert book.profile.locale == "en-US"
    let renamed: Product = rename(book, "YAZA LLVM")
    assert renamed.id == 7
    assert not renamed.profile.active
    say renamed.name
    say renamed.profile.locale
