use "std/math"

fn math_nan_match_not_equal(value: Float64) -> Boolean:
    return match value:
        != 0.0 -> true
        else -> false

fn math_smoke() -> Result[Boolean, Text]:
    let positive_abs: Result[Number, Text] = math_abs_number(-42)
    if not result_is_ok(positive_abs) or result_unwrap(positive_abs) != 42:
        return err("Number absolute value failed for a negative input")
    let minimum: Number = -9223372036854775807 - 1
    if result_is_ok(math_abs_number(minimum)):
        return err("Number absolute value accepted the overflowing minimum input")
    if math_min_number(7, -3) != -3 or math_max_number(7, -3) != 7:
        return err("Number min/max returned an incorrect value")
    let clamped_low: Result[Number, Text] = math_clamp_number(-9, -4, 6)
    let clamped_high: Result[Number, Text] = math_clamp_number(8, -4, 6)
    let clamped_inside: Result[Number, Text] = math_clamp_number(2, -4, 6)
    if not result_is_ok(clamped_low) or result_unwrap(clamped_low) != -4 or not result_is_ok(clamped_high) or result_unwrap(clamped_high) != 6 or not result_is_ok(clamped_inside) or result_unwrap(clamped_inside) != 2:
        return err("Number clamp did not handle below, above, and in-range values")
    if result_is_ok(math_clamp_number(1, 2, 0)):
        return err("Number clamp accepted inverted bounds")

    let negative_zero_bits: Number = -9223372036854775807 - 1
    let negative_zero: Float64 = float64_from_bits(negative_zero_bits)
    let positive_zero: Float64 = 0.0
    if float64_bits(math_abs_float64(negative_zero)) != 0:
        return err("Float64 absolute value did not canonicalize negative zero to positive zero")
    if float64_bits(math_abs_float64(-4.5)) != float64_bits(4.5):
        return err("Float64 absolute value failed for a negative finite value")
    if math_trunc_float64(3.875) != 3.0 or math_trunc_float64(-3.875) != -3.0:
        return err("Float64 truncation failed to round toward zero")
    if math_floor_float64(-3.125) != -4.0 or math_floor_float64(3.125) != 3.0:
        return err("Float64 floor returned an incorrect result")
    if math_ceil_float64(3.125) != 4.0 or math_ceil_float64(-3.125) != -3.0:
        return err("Float64 ceil returned an incorrect result")
    if math_round_float64(2.5) != 3.0 or math_round_float64(-2.5) != -3.0 or math_round_float64(2.49) != 2.0 or math_round_float64(-2.49) != -2.0:
        return err("Float64 round did not use half-away-from-zero semantics")
    if float64_bits(math_trunc_float64(negative_zero)) != negative_zero_bits:
        return err("Float64 truncation did not preserve the sign of zero")
    if float64_bits(math_min_float64(positive_zero, negative_zero)) != negative_zero_bits:
        return err("Float64 min did not preserve negative zero")
    if float64_bits(math_max_float64(positive_zero, negative_zero)) != 0:
        return err("Float64 max did not prefer positive zero")
    if float64_bits(math_max_float64(negative_zero, positive_zero)) != 0:
        return err("Float64 max did not prefer positive zero when the operands are reversed")

    let positive_infinity: Float64 = float64_from_bits(math_positive_infinity_bits_v1())
    let negative_infinity: Float64 = float64_from_bits(math_negative_infinity_bits_v1())
    let nan_value: Float64 = float64_from_bits(9221120237041090561)
    let negative_nan: Float64 = float64_from_bits(-4503599627370495)
    if nan_value == nan_value or not (nan_value != nan_value):
        return err("Float64 equality/inequality did not follow IEEE NaN semantics")
    if not (nan_value != 1.0) or 1.0 == nan_value:
        return err("Float64 equality/inequality with a finite value mishandled NaN")
    if not math_nan_match_not_equal(nan_value) or math_nan_match_not_equal(0.0):
        return err("Float64 numeric match != did not follow IEEE NaN semantics")
    if not math_is_finite_float64(1.25) or math_is_finite_float64(positive_infinity) or math_is_finite_float64(negative_infinity):
        return err("Float64 finite classification returned an incorrect result")
    if not math_is_infinite_float64(positive_infinity) or not math_is_infinite_float64(negative_infinity) or math_is_infinite_float64(nan_value):
        return err("Float64 infinity classification returned an incorrect result")
    if not math_is_nan_float64(nan_value) or not math_is_nan_float64(negative_nan) or math_is_nan_float64(positive_infinity):
        return err("Float64 NaN classification returned an incorrect result")
    if float64_bits(math_abs_float64(negative_infinity)) != math_positive_infinity_bits_v1():
        return err("Float64 absolute value did not handle negative infinity")
    if float64_bits(math_abs_float64(negative_nan)) != 9218868437227405313:
        return err("Float64 absolute value did not clear the sign bit of a negative NaN")
    if float64_bits(math_min_float64(nan_value, 1.0)) != float64_bits(nan_value):
        return err("Float64 min did not propagate its first NaN")
    if float64_bits(math_min_float64(1.0, negative_nan)) != float64_bits(negative_nan):
        return err("Float64 min did not propagate a NaN in its second operand")
    if float64_bits(math_trunc_float64(nan_value)) != float64_bits(nan_value) or float64_bits(math_floor_float64(positive_infinity)) != float64_bits(positive_infinity) or float64_bits(math_ceil_float64(negative_infinity)) != float64_bits(negative_infinity) or float64_bits(math_round_float64(negative_nan)) != float64_bits(negative_nan):
        return err("Float64 rounding did not preserve non-finite values")
    let large_integral: Float64 = float64_from_number(4503599627370496)
    if float64_bits(math_trunc_float64(large_integral)) != float64_bits(large_integral):
        return err("Float64 truncation changed an integral value at 2^52")
    let clamped: Result[Float64, Text] = math_clamp_float64(-3.5, -2.0, 4.0)
    if not result_is_ok(clamped) or result_unwrap(clamped) != -2.0:
        return err("Float64 clamp did not apply its lower bound")
    let positive_infinity_clamped: Result[Float64, Text] = math_clamp_float64(positive_infinity, -2.0, 4.0)
    let negative_infinity_clamped: Result[Float64, Text] = math_clamp_float64(negative_infinity, -2.0, 4.0)
    if not result_is_ok(positive_infinity_clamped) or result_unwrap(positive_infinity_clamped) != 4.0 or not result_is_ok(negative_infinity_clamped) or result_unwrap(negative_infinity_clamped) != -2.0:
        return err("Float64 clamp did not apply finite bounds to infinities")
    if result_is_ok(math_clamp_float64(1.0, nan_value, 4.0)) or result_is_ok(math_clamp_float64(1.0, 2.0, 1.0)):
        return err("Float64 clamp accepted a NaN or inverted bound")
    let nan_clamp: Result[Float64, Text] = math_clamp_float64(nan_value, -1.0, 1.0)
    if not result_is_ok(nan_clamp) or not math_is_nan_float64(result_unwrap(nan_clamp)):
        return err("Float64 clamp did not propagate a NaN input")
    return ok(true)

start:
    let outcome: Result[Boolean, Text] = math_smoke()
    if not result_is_ok(outcome): say result_unwrap_error(outcome)
    elif result_unwrap(outcome): say "std-math-ok"
    else: say "std/math fixture returned false"
