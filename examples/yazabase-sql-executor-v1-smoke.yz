    let types: List[Number] = [6]
    let row_one: List[YazaSqlValueV1] = [yaza_sql_value_double_v1(1.0e16)]
    let row_two: List[YazaSqlValueV1] = [yaza_sql_value_double_v1(1.0)]
    let row_three: List[YazaSqlValueV1] = [yaza_sql_value_double_v1(-1.0e16)]
    let rows: List[List[YazaSqlValueV1]] = [row_one, row_two, row_three]
    let table: YazaSqlMemoryTableV1 = YazaSqlMemoryTableV1(13, 4, types, rows, 0)
    let source: Text = "SELECT AVG(value) FROM samples"
    let parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(source)
    if not result_is_ok(parsed): return false
    let bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(source, result_unwrap(parsed), catalog)
    if not result_is_ok(bound): return false
    let parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(bound), table, parameters)
    if not result_is_ok(executed): return false
    let average: YazaSqlValueV1 = list_get(list_get(result_unwrap(executed).rows, 0), 0)
    return not average.is_null and average.float_value == 1.0 / 3.0

fn yaza_base_sql_executor_v1_min_max(catalog: YazaSqlCatalogSnapshotV1, table: YazaSqlMemoryTableV1) -> Boolean:
    let source: Text = "SELECT MIN(score), MAX(score), MIN(title), MAX(active) FROM items"
    let parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(source)
    if not result_is_ok(parsed): return false
    let bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(source, result_unwrap(parsed), catalog)
    if not result_is_ok(bound): return false
    let parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(bound), table, parameters)
    if not result_is_ok(executed): return false
    let rows: List[List[YazaSqlValueV1]] = result_unwrap(executed).rows
    if list_count(rows) != 1 or list_count(list_get(rows, 0)) != 4: return false
    let row: List[YazaSqlValueV1] = list_get(rows, 0)
    if list_get(row, 0).type_id != 6 or list_get(row, 0).float_value != 2.5: return false
    if list_get(row, 1).type_id != 6 or list_get(row, 1).float_value != 5.5: return false
    if list_get(row, 2).type_id != 9 or list_get(row, 2).text_value != "a": return false
    if list_get(row, 3).type_id != 1 or list_get(row, 3).boolean_value != true: return false

    let empty_rows: List[List[YazaSqlValueV1]] = List[List[YazaSqlValueV1]]()
    let empty_table: YazaSqlMemoryTableV1 = YazaSqlMemoryTableV1(table.table_id, table.catalog_version, table.column_type_ids, empty_rows, 0)
    let empty_source: Text = "SELECT MIN(score), MAX(title) FROM items"
    let empty_parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(empty_source)
    if not result_is_ok(empty_parsed): return false
    let empty_bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(empty_source, result_unwrap(empty_parsed), catalog)
    if not result_is_ok(empty_bound): return false
    let empty_executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(empty_bound), empty_table, parameters)
    if not result_is_ok(empty_executed): return false
    let empty_row: List[YazaSqlValueV1] = list_get(result_unwrap(empty_executed).rows, 0)
    if list_count(empty_row) != 2 or not list_get(empty_row, 0).is_null or not list_get(empty_row, 1).is_null: return false
    return true

fn yaza_base_sql_executor_v1_group_by() -> Boolean:
    let columns: List[YazaSqlColumnSchemaV1] = [YazaSqlColumnSchemaV1("team", 9, true, 0, 0, 0, ""), YazaSqlColumnSchemaV1("active", 1, false, 1, 0, 0, ""), YazaSqlColumnSchemaV1("amount", 4, true, 2, 0, 0, "")]
    let tables: List[YazaSqlTableSchemaV1] = [YazaSqlTableSchemaV1(21, "group_probe", columns)]
    let catalog: YazaSqlCatalogSnapshotV1 = YazaSqlCatalogSnapshotV1(5, tables, List[YazaSqlColumnDefaultV1]())
    let types: List[Number] = [9, 1, 4]
    let rows: List[List[YazaSqlValueV1]] = List[List[YazaSqlValueV1]]()
    list_push(rows, [yaza_sql_value_text_v1("a"), yaza_sql_value_boolean_v1(true), result_unwrap(yaza_sql_value_integer_v1(4, 5))])
    list_push(rows, [yaza_sql_value_text_v1("a"), yaza_sql_value_boolean_v1(true), result_unwrap(yaza_sql_value_integer_v1(4, 7))])
    list_push(rows, [yaza_sql_value_text_v1("a"), yaza_sql_value_boolean_v1(false), result_unwrap(yaza_sql_value_integer_v1(4, 11))])
    list_push(rows, [yaza_sql_value_text_v1("b"), yaza_sql_value_boolean_v1(true), result_unwrap(yaza_sql_value_integer_v1(4, 13))])
    list_push(rows, [result_unwrap(yaza_sql_value_null_v1(9)), yaza_sql_value_boolean_v1(true), result_unwrap(yaza_sql_value_integer_v1(4, 17))])
    list_push(rows, [result_unwrap(yaza_sql_value_null_v1(9)), yaza_sql_value_boolean_v1(true), result_unwrap(yaza_sql_value_null_v1(4))])
    let table: YazaSqlMemoryTableV1 = YazaSqlMemoryTableV1(21, 5, types, rows, 0)
    let source: Text = "SELECT team, active, COUNT(*) AS n, SUM(amount) AS total, AVG(amount) AS mean, MIN(amount), MAX(amount) FROM group_probe GROUP BY team, active ORDER BY team, active"
    let parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(source)
    if not result_is_ok(parsed): return false
    let bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(source, result_unwrap(parsed), catalog)
    if not result_is_ok(bound): return false
    let plan: YazaSqlBoundPlanV1 = result_unwrap(bound)
    if list_count(plan.group_by_columns) != 2 or list_get(plan.group_by_columns, 0) != 0 or list_get(plan.group_by_columns, 1) != 1: return false
    if list_get(plan.operators, 1).kind != 7 or list_get(plan.operators, 1).item_start != 2: return false
    let parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(plan, table, parameters)
    if not result_is_ok(executed): return false
    let result: YazaSqlQueryResultV1 = result_unwrap(executed)
    if list_count(result.rows) != 4 or list_count(result.columns) != 7: return false
    let null_group: List[YazaSqlValueV1] = list_get(result.rows, 0)
    if not list_get(null_group, 0).is_null or not list_get(null_group, 1).boolean_value or list_get(null_group, 2).integer_value != 2 or list_get(null_group, 3).integer_value != 17: return false
    if list_get(null_group, 4).float_value != 17.0 or list_get(null_group, 5).integer_value != 17 or list_get(null_group, 6).integer_value != 17: return false
    let a_inactive: List[YazaSqlValueV1] = list_get(result.rows, 1)
    if list_get(a_inactive, 0).text_value != "a" or list_get(a_inactive, 1).boolean_value or list_get(a_inactive, 2).integer_value != 1 or list_get(a_inactive, 3).integer_value != 11: return false
    let a_active: List[YazaSqlValueV1] = list_get(result.rows, 2)
    if list_get(a_active, 0).text_value != "a" or not list_get(a_active, 1).boolean_value or list_get(a_active, 2).integer_value != 2 or list_get(a_active, 3).integer_value != 12: return false
    if list_get(a_active, 4).float_value != 6.0 or list_get(a_active, 5).integer_value != 5 or list_get(a_active, 6).integer_value != 7: return false
    let b_active: List[YazaSqlValueV1] = list_get(result.rows, 3)
    if list_get(b_active, 0).text_value != "b" or list_get(b_active, 2).integer_value != 1 or list_get(b_active, 3).integer_value != 13: return false

    let having_source: Text = "SELECT team, active, COUNT(*) AS n, SUM(amount) AS total FROM group_probe WHERE amount IS NOT NULL AND amount > 0 GROUP BY team, active HAVING n >= $1 AND total IS NOT NULL ORDER BY team, active"
    let having_parse: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(having_source)
    if not result_is_ok(having_parse): return false
    let having_plan: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(having_source, result_unwrap(having_parse), catalog)
    if not result_is_ok(having_plan): return false
    let having_parameters: List[YazaSqlValueV1] = [result_unwrap(yaza_sql_value_integer_v1(4, 2))]
    let having_result: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(having_plan), table, having_parameters)
    if not result_is_ok(having_result): return false
    let having_rows: List[List[YazaSqlValueV1]] = result_unwrap(having_result).rows
    if list_count(result_unwrap(having_plan).expressions) != 6 or result_unwrap(having_plan).where_root != 2 or result_unwrap(having_plan).having_start_index != 3 or result_unwrap(having_plan).having_root != 5: return false
    if list_count(having_rows) != 1: return false
    let having_a_group: List[YazaSqlValueV1] = list_get(having_rows, 0)
    if list_get(having_a_group, 0).text_value != "a" or not list_get(having_a_group, 1).boolean_value or list_get(having_a_group, 2).integer_value != 2 or list_get(having_a_group, 3).integer_value != 12: return false

    let direct_aggregate_source: Text = "SELECT team, active, COUNT(*) AS n, SUM(amount) AS total FROM group_probe GROUP BY team, active HAVING COUNT(*) >= $1 AND SUM(amount) > 10 ORDER BY team, active"
    let direct_aggregate_parse: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(direct_aggregate_source)
    if not result_is_ok(direct_aggregate_parse): return false
    let direct_aggregate_plan: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(direct_aggregate_source, result_unwrap(direct_aggregate_parse), catalog)
    if not result_is_ok(direct_aggregate_plan): return false
    let direct_aggregate_result: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(direct_aggregate_plan), table, [result_unwrap(yaza_sql_value_integer_v1(4, 2))])
    if not result_is_ok(direct_aggregate_result): return false
    let direct_aggregate_rows: List[List[YazaSqlValueV1]] = result_unwrap(direct_aggregate_result).rows
    if list_count(direct_aggregate_rows) != 2: return false
    let direct_aggregate_null_group: List[YazaSqlValueV1] = list_get(direct_aggregate_rows, 0)
    let direct_aggregate_row: List[YazaSqlValueV1] = list_get(direct_aggregate_rows, 1)
    if not list_get(direct_aggregate_null_group, 0).is_null or not list_get(direct_aggregate_null_group, 1).boolean_value or list_get(direct_aggregate_null_group, 2).integer_value != 2 or list_get(direct_aggregate_null_group, 3).integer_value != 17: return false
    if list_get(direct_aggregate_row, 0).text_value != "a" or not list_get(direct_aggregate_row, 1).boolean_value or list_get(direct_aggregate_row, 2).integer_value != 2 or list_get(direct_aggregate_row, 3).integer_value != 12: return false

    let global_having_source: Text = "SELECT COUNT(*) AS total FROM group_probe HAVING total > 0"
    let global_having_parse: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(global_having_source)
    if not result_is_ok(global_having_parse): return false
    let global_having_plan: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(global_having_source, result_unwrap(global_having_parse), catalog)
    if not result_is_ok(global_having_plan): return false
    let global_having_result: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(global_having_plan), table, parameters)
    if not result_is_ok(global_having_result) or list_count(result_unwrap(global_having_result).rows) != 1 or list_get(list_get(result_unwrap(global_having_result).rows, 0), 0).integer_value != 6: return false

    let empty_rows: List[List[YazaSqlValueV1]] = List[List[YazaSqlValueV1]]()
    let empty_table: YazaSqlMemoryTableV1 = YazaSqlMemoryTableV1(table.table_id, table.catalog_version, table.column_type_ids, empty_rows, 0)
    let empty_having_source: Text = "SELECT COUNT(*) AS total FROM group_probe HAVING total = 0"
    let empty_having_parse: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(empty_having_source)
    if not result_is_ok(empty_having_parse): return false
    let empty_having_plan: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(empty_having_source, result_unwrap(empty_having_parse), catalog)
    if not result_is_ok(empty_having_plan): return false
    let empty_having_result: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(empty_having_plan), empty_table, parameters)
    if not result_is_ok(empty_having_result) or list_count(result_unwrap(empty_having_result).rows) != 1 or list_get(list_get(result_unwrap(empty_having_result).rows, 0), 0).integer_value != 0: return false

    let null_having_source: Text = "SELECT SUM(amount) AS total FROM group_probe HAVING total IS NULL"
    let null_having_parse: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(null_having_source)
    if not result_is_ok(null_having_parse): return false
    let null_having_plan: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(null_having_source, result_unwrap(null_having_parse), catalog)
    if not result_is_ok(null_having_plan): return false
    let null_having_result: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(null_having_plan), empty_table, parameters)
    if not result_is_ok(null_having_result) or list_count(result_unwrap(null_having_result).rows) != 1 or not list_get(list_get(result_unwrap(null_having_result).rows, 0), 0).is_null: return false

    let direct_null_having_source: Text = "SELECT SUM(amount) FROM group_probe HAVING SUM(amount) IS NULL"
    let direct_null_having_parse: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(direct_null_having_source)
    if not result_is_ok(direct_null_having_parse): return false
    let direct_null_having_plan: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(direct_null_having_source, result_unwrap(direct_null_having_parse), catalog)
    if not result_is_ok(direct_null_having_plan): return false
    let direct_null_having_result: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(direct_null_having_plan), empty_table, parameters)
    if not result_is_ok(direct_null_having_result) or list_count(result_unwrap(direct_null_having_result).rows) != 1 or not list_get(list_get(result_unwrap(direct_null_having_result).rows, 0), 0).is_null: return false

    var invalid_having_plan: YazaSqlBoundPlanV1 = result_unwrap(having_plan)
    set invalid_having_plan.having_root = list_count(invalid_having_plan.expressions)
    if result_is_ok(yaza_sql_execute_memory_v1(invalid_having_plan, table, having_parameters)): return false
    var cross_stage_having_plan: YazaSqlBoundPlanV1 = result_unwrap(having_plan)
    let cross_stage_having_root: YazaSqlBoundExpressionNodeV1 = list_get(cross_stage_having_plan.expressions, cross_stage_having_plan.having_root)
    let forged_cross_stage_root: YazaSqlBoundExpressionNodeV1 = YazaSqlBoundExpressionNodeV1(cross_stage_having_root.kind, cross_stage_having_root.operator, cross_stage_having_plan.where_root, cross_stage_having_root.right_index, cross_stage_having_root.column_ordinal, cross_stage_having_root.value_kind, cross_stage_having_root.parameter_ordinal, cross_stage_having_root.type_id, cross_stage_having_root.start_byte, cross_stage_having_root.end_byte, cross_stage_having_root.operator_start_byte, cross_stage_having_root.operator_end_byte, cross_stage_having_root.value_start_byte, cross_stage_having_root.value_end_byte, cross_stage_having_root.precision, cross_stage_having_root.scale, cross_stage_having_root.correlation_column_ordinal, cross_stage_having_root.correlation_type_id, cross_stage_having_root.correlation_precision, cross_stage_having_root.correlation_scale)
    list_set(cross_stage_having_plan.expressions, cross_stage_having_plan.having_root, forged_cross_stage_root)
    if result_is_ok(yaza_sql_execute_memory_v1(cross_stage_having_plan, table, having_parameters)): return false

    let key_only_source: Text = "SELECT team, active FROM group_probe GROUP BY team, active ORDER BY team, active"
    let key_only_parse: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(key_only_source)
    if not result_is_ok(key_only_parse): return false
    let key_only_plan: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(key_only_source, result_unwrap(key_only_parse), catalog)
    if not result_is_ok(key_only_plan): return false
    let key_only_result: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(key_only_plan), table, parameters)
    if not result_is_ok(key_only_result) or list_count(result_unwrap(key_only_result).rows) != 4: return false

    let empty_source: Text = "SELECT COUNT(*) FROM group_probe WHERE amount > 999 GROUP BY team"
    let empty_parse: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(empty_source)
    if not result_is_ok(empty_parse): return false
    let empty_plan: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(empty_source, result_unwrap(empty_parse), catalog)
    if not result_is_ok(empty_plan): return false
    let empty_result: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(empty_plan), table, parameters)
    if not result_is_ok(empty_result) or list_count(result_unwrap(empty_result).rows) != 0: return false

    let invalid_source: Text = "SELECT amount, COUNT(*) FROM group_probe GROUP BY team"
    let invalid_parse: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(invalid_source)
    if not result_is_ok(invalid_parse): return false
    if result_is_ok(yaza_sql_bind_select_v1(invalid_source, result_unwrap(invalid_parse), catalog)): return false

    var out_of_range_plan: YazaSqlBoundPlanV1 = plan
    set out_of_range_plan.group_by_columns = [3]
    if result_is_ok(yaza_sql_execute_memory_v1(out_of_range_plan, table, parameters)): return false
    var duplicate_key_plan: YazaSqlBoundPlanV1 = plan
    set duplicate_key_plan.group_by_columns = [0, 0]
    if result_is_ok(yaza_sql_execute_memory_v1(duplicate_key_plan, table, parameters)): return false
    var projection_plan: YazaSqlBoundPlanV1 = plan
    set projection_plan.group_by_columns = [0]
    return not result_is_ok(yaza_sql_execute_memory_v1(projection_plan, table, parameters))

fn yaza_base_sql_executor_v1_count_avoids_projected_cell_expansion() -> Boolean:
    let columns: List[YazaSqlColumnSchemaV1] = [YazaSqlColumnSchemaV1("id", 4, false, 0, 0, 0, "")]
    let tables: List[YazaSqlTableSchemaV1] = [YazaSqlTableSchemaV1(9, "large_items", columns)]
    let catalog: YazaSqlCatalogSnapshotV1 = YazaSqlCatalogSnapshotV1(11, tables, List[YazaSqlColumnDefaultV1]())
    let type_ids: List[Number] = [4]
    let rows: List[List[YazaSqlValueV1]] = List[List[YazaSqlValueV1]]()
    var row_index: Number = 0
    while row_index < 1500:
        let row: List[YazaSqlValueV1] = [result_unwrap(yaza_sql_value_integer_v1(4, row_index))]
        if not list_try_push(rows, row): return false
        set row_index = row_index + 1

    let projection_fragments_result: Result[TextList, Text] = text_list_try_new()
    if not result_is_ok(projection_fragments_result): return false
    let projection_fragments: TextList = result_unwrap(projection_fragments_result)
    if not list_try_reserve(projection_fragments, 800): return false
    var projection_index: Number = 0
    while projection_index < 800:
        if not list_try_push(projection_fragments, "COUNT(*)"): return false
        set projection_index = projection_index + 1
    let joined_projections: Result[Text, Text] = text_try_join(projection_fragments, ",")
    if not result_is_ok(joined_projections): return false
    let select_prefix: Result[Text, Text] = text_try_concat("SELECT ", result_unwrap(joined_projections))
    if not result_is_ok(select_prefix): return false
    let source_result: Result[Text, Text] = text_try_concat(result_unwrap(select_prefix), " FROM large_items")
    if not result_is_ok(source_result): return false
    let source: Text = result_unwrap(source_result)
    let parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(source)
    if not result_is_ok(parsed): return false
    let bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(source, result_unwrap(parsed), catalog)
    if not result_is_ok(bound): return false
    let table: YazaSqlMemoryTableV1 = YazaSqlMemoryTableV1(9, 11, type_ids, rows, 0)
    let no_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(bound), table, no_parameters)
    if not result_is_ok(executed): return false
    let output: YazaSqlQueryResultV1 = result_unwrap(executed)
    if list_count(output.columns) != 800 or list_count(output.rows) != 1: return false
    let aggregate_row: List[YazaSqlValueV1] = list_get(output.rows, 0)
    if list_count(aggregate_row) != 800: return false
    set projection_index = 0
    while projection_index < list_count(aggregate_row):
        if list_get(aggregate_row, projection_index).integer_value != 1500: return false
        set projection_index = projection_index + 1
    return true

fn yaza_base_sql_executor_v1_distinct(catalog: YazaSqlCatalogSnapshotV1, table: YazaSqlMemoryTableV1) -> Boolean:
    let source: Text = "SELECT DISTINCT active FROM items"
    let parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(source)
    if not result_is_ok(parsed): return false
    let bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(source, result_unwrap(parsed), catalog)
    if not result_is_ok(bound): return false
    let parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(bound), table, parameters)
    if not result_is_ok(executed): return false
    let rows: List[List[YazaSqlValueV1]] = result_unwrap(executed).rows
    if list_count(rows) != 3: return false
    let null_value: YazaSqlValueV1 = list_get(list_get(rows, 0), 0)
    let false_value: YazaSqlValueV1 = list_get(list_get(rows, 1), 0)
    let true_value: YazaSqlValueV1 = list_get(list_get(rows, 2), 0)
    return null_value.is_null and not false_value.is_null and not false_value.boolean_value and not true_value.is_null and true_value.boolean_value

fn yaza_base_sql_executor_v1_null_semantics(catalog: YazaSqlCatalogSnapshotV1, table: YazaSqlMemoryTableV1) -> Boolean:
    let null_source: Text = "SELECT id, title FROM items WHERE active IS NULL"
    let null_parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(null_source)
    if not result_is_ok(null_parsed): return false
    let null_bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(null_source, result_unwrap(null_parsed), catalog)
    if not result_is_ok(null_bound): return false
    let no_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let null_executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(null_bound), table, no_parameters)
    if not result_is_ok(null_executed): return false
    let null_rows: List[List[YazaSqlValueV1]] = result_unwrap(null_executed).rows
    if list_count(null_rows) != 1: return false
    let null_row: List[YazaSqlValueV1] = list_get(null_rows, 0)
    if list_get(null_row, 0).integer_value != 5 or not list_get(null_row, 1).is_null: return false

    let not_null_source: Text = "SELECT id FROM items WHERE active IS NOT NULL"
    let not_null_parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(not_null_source)
    if not result_is_ok(not_null_parsed): return false
    let not_null_bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(not_null_source, result_unwrap(not_null_parsed), catalog)
    if not result_is_ok(not_null_bound): return false
    let not_null_executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(not_null_bound), table, no_parameters)
    if not result_is_ok(not_null_executed) or list_count(result_unwrap(not_null_executed).rows) != 4: return false

    let or_source: Text = "SELECT id FROM items WHERE active = TRUE OR title IS NULL"
    let or_parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(or_source)
    if not result_is_ok(or_parsed): return false
    let or_bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(or_source, result_unwrap(or_parsed), catalog)
    if not result_is_ok(or_bound): return false
    let or_executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(or_bound), table, no_parameters)
    if not result_is_ok(or_executed) or list_count(result_unwrap(or_executed).rows) != 4: return false

    let and_source: Text = "SELECT id FROM items WHERE active = TRUE AND id = 5"
    let and_parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(and_source)
    if not result_is_ok(and_parsed): return false
    let and_bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(and_source, result_unwrap(and_parsed), catalog)
    if not result_is_ok(and_bound): return false
    let and_executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(and_bound), table, no_parameters)
    if not result_is_ok(and_executed) or list_count(result_unwrap(and_executed).rows) != 0: return false

    let not_source: Text = "SELECT id FROM items WHERE NOT (active = TRUE)"
    let not_parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(not_source)
    if not result_is_ok(not_parsed): return false
    let not_bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(not_source, result_unwrap(not_parsed), catalog)
    if not result_is_ok(not_bound): return false
    let not_executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(not_bound), table, no_parameters)
    if not result_is_ok(not_executed): return false
    let not_rows: List[List[YazaSqlValueV1]] = result_unwrap(not_executed).rows
    if list_count(not_rows) != 1 or list_get(list_get(not_rows, 0), 0).integer_value != 3: return false

    let bind_source: Text = "SELECT id FROM items WHERE title = $1"
    let bind_parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(bind_source)
    if not result_is_ok(bind_parsed): return false
    let bind_bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(bind_source, result_unwrap(bind_parsed), catalog)
    if not result_is_ok(bind_bound): return false
    let null_parameters: List[YazaSqlValueV1] = [result_unwrap(yaza_sql_value_null_v1(9))]
    let bind_executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(bind_bound), table, null_parameters)
    if not result_is_ok(bind_executed) or list_count(result_unwrap(bind_executed).rows) != 0: return false

    let literal_source: Text = "SELECT id FROM items WHERE active = NULL"
    let literal_parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(literal_source)
    if not result_is_ok(literal_parsed): return false
    let literal_bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(literal_source, result_unwrap(literal_parsed), catalog)
    if not result_is_ok(literal_bound): return false
    let literal_executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(literal_bound), table, no_parameters)
    return result_is_ok(literal_executed) and list_count(result_unwrap(literal_executed).rows) == 0

fn yaza_base_sql_executor_v1_text_escape(catalog: YazaSqlCatalogSnapshotV1, table: YazaSqlMemoryTableV1) -> Boolean:
    let source: Text = "SELECT id FROM items WHERE title = 'a''b'"
    let rows: List[List[YazaSqlValueV1]] = List[List[YazaSqlValueV1]]()
    list_push(rows, yaza_base_sql_executor_v1_row(8, 8.0, true, "a'b"))
    let table_with_quote: YazaSqlMemoryTableV1 = YazaSqlMemoryTableV1(table.table_id, table.catalog_version, table.column_type_ids, rows, 0)
    let parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(source)
    if not result_is_ok(parsed): return false
    let bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(source, result_unwrap(parsed), catalog)
    if not result_is_ok(bound): return false
    let parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(bound), table_with_quote, parameters)
    if not result_is_ok(executed): return false
    let output: YazaSqlQueryResultV1 = result_unwrap(executed)
    return list_count(output.rows) == 1 and list_get(list_get(output.rows, 0), 0).integer_value == 8

fn yaza_base_sql_executor_v1_rejects_wrong_parameter(catalog: YazaSqlCatalogSnapshotV1, table: YazaSqlMemoryTableV1) -> Boolean:
    let source: Text = "SELECT id FROM items WHERE score >= $1"
    let parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(source)
    if not result_is_ok(parsed): return false
    let bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(source, result_unwrap(parsed), catalog)
    if not result_is_ok(bound): return false
    let parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    list_push(parameters, result_unwrap(yaza_sql_value_integer_v1(3, 3)))
    let executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(bound), table, parameters)
    return not result_is_ok(executed)

fn yaza_base_sql_executor_v1_treats_injection_payload_as_data(catalog: YazaSqlCatalogSnapshotV1) -> Boolean:
    let source: Text = "SELECT id FROM items WHERE title = $1"
    let parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(source)
    if not result_is_ok(parsed): return false
    let bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(source, result_unwrap(parsed), catalog)
    if not result_is_ok(bound): return false
    let payloads: List[Text] = List[Text]()
    list_push(payloads, "' OR TRUE --")
    list_push(payloads, "' UNION SELECT password FROM users --")
    list_push(payloads, "x'; DROP TABLE items; --")
    list_push(payloads, "' OR '1'='1")
    list_push(payloads, "1); DELETE FROM users WHERE TRUE; --")
    let rows: List[List[YazaSqlValueV1]] = List[List[YazaSqlValueV1]]()
    var index: Number = 0
    while index < list_count(payloads):
        let payload: Text = list_get(payloads, index)
        list_push(rows, yaza_base_sql_executor_v1_row(index + 1, 1.0, true, payload))
        set index = index + 1
    list_push(rows, yaza_base_sql_executor_v1_row(99, 2.0, true, "ordinary title"))
    let types: List[Number] = List[Number]()
    list_push(types, 3)
    list_push(types, 6)
    list_push(types, 1)
    list_push(types, 9)
    let table: YazaSqlMemoryTableV1 = YazaSqlMemoryTableV1(5, 7, types, rows, 0)
    set index = 0
    while index < list_count(payloads):
        let payload: Text = list_get(payloads, index)
        let parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
        list_push(parameters, yaza_sql_value_text_v1(payload))
        let executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(bound), table, parameters)
        if not result_is_ok(executed): return false
        let matched: List[List[YazaSqlValueV1]] = result_unwrap(executed).rows
        if list_count(matched) != 1 or list_get(list_get(matched, 0), 0).integer_value != index + 1: return false
        set index = index + 1
    return true

fn yaza_base_sql_executor_v1_rejects_reused_expression_children(catalog: YazaSqlCatalogSnapshotV1, table: YazaSqlMemoryTableV1) -> Boolean:
    let source: Text = "SELECT id FROM items WHERE id = 1 AND id = 2"
    let parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(source)
    if not result_is_ok(parsed): return false
    let bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(source, result_unwrap(parsed), catalog)
    if not result_is_ok(bound): return false
    var plan: YazaSqlBoundPlanV1 = result_unwrap(bound)
    if list_count(plan.expressions) != 3 or plan.where_root != 2: return false
    let root: YazaSqlBoundExpressionNodeV1 = list_get(plan.expressions, plan.where_root)
    let reused_child: YazaSqlBoundExpressionNodeV1 = YazaSqlBoundExpressionNodeV1(root.kind, root.operator, root.left_index, root.left_index, root.column_ordinal, root.value_kind, root.parameter_ordinal, root.type_id, root.start_byte, root.end_byte, root.operator_start_byte, root.operator_end_byte, root.value_start_byte, root.value_end_byte, root.precision, root.scale, root.correlation_column_ordinal, root.correlation_type_id, root.correlation_precision, root.correlation_scale)
    list_set(plan.expressions, plan.where_root, reused_child)
    let parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(plan, table, parameters)
    if result_is_ok(executed): return false
    let error: Text = result_unwrap_error(executed)
    return text_starts_with(error, "SQL executor expression plan reuses a child")

fn yaza_base_sql_executor_v1_rejects_oversized_text_bind(catalog: YazaSqlCatalogSnapshotV1, table: YazaSqlMemoryTableV1) -> Boolean:
    let source: Text = "SELECT id FROM items WHERE title = $1"
    let parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(source)
    if not result_is_ok(parsed): return false
    let bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(source, result_unwrap(parsed), catalog)
    if not result_is_ok(bound): return false
    var oversized_text: Text = "x"
    while text_length(oversized_text) <= 65536:
        let doubled_result: Result[Text, Text] = text_try_concat(oversized_text, oversized_text)
        if not result_is_ok(doubled_result): return false
        set oversized_text = result_unwrap(doubled_result)
    let parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    list_push(parameters, yaza_sql_value_text_v1(oversized_text))
    let executed: Result[YazaSqlQueryResultV1, YazaSqlDiagnosticV1] = yaza_sql_execute_memory_structured_v1(result_unwrap(bound), table, parameters)
    if result_is_ok(executed): return false
    let diagnostic: YazaSqlDiagnosticV1 = result_unwrap_error(executed)
    return diagnostic.code == 4007 and text_starts_with(diagnostic.message, "SQL executor text comparison exceeds")

start:
    let initial_used: Number = arena_used()
    arena_scope 16777216:
        let catalog: YazaSqlCatalogSnapshotV1 = yaza_base_sql_executor_v1_catalog()
        let table: YazaSqlMemoryTableV1 = yaza_base_sql_executor_v1_table()
        assert yaza_base_sql_executor_v1_decimal_query()
        assert yaza_base_sql_executor_v1_filtered_ordered(catalog, table)
        assert yaza_base_sql_executor_v1_count_star(catalog, table)
        assert yaza_base_sql_executor_v1_sum(catalog, table)
        assert yaza_base_sql_executor_v1_sum_overflow()
        assert yaza_base_sql_executor_v1_avg_compensation()
        assert yaza_base_sql_executor_v1_min_max(catalog, table)
        assert yaza_base_sql_executor_v1_group_by()
        arena_scope 4194304:
            assert yaza_base_sql_executor_v1_count_avoids_projected_cell_expansion()
        assert yaza_base_sql_executor_v1_distinct(catalog, table)
        assert yaza_base_sql_executor_v1_null_semantics(catalog, table)
        assert yaza_base_sql_executor_v1_text_escape(catalog, table)
        assert yaza_base_sql_executor_v1_rejects_wrong_parameter(catalog, table)
        assert yaza_base_sql_executor_v1_treats_injection_payload_as_data(catalog)
        assert yaza_base_sql_executor_v1_rejects_reused_expression_children(catalog, table)
        assert yaza_base_sql_executor_v1_rejects_oversized_text_bind(catalog, table)
    assert arena_used() == initial_used
    say "yazabase-sql-executor-v1-ok"
