fn yaza_base_sql_executor_v1_sum_overflow() -> Boolean:
    let columns: List[YazaSqlColumnSchemaV1] = [YazaSqlColumnSchemaV1("value", 4, false, 0, 0, 0, "")]
    let tables: List[YazaSqlTableSchemaV1] = [YazaSqlTableSchemaV1(12, "large_values", columns)]
    let catalog: YazaSqlCatalogSnapshotV1 = YazaSqlCatalogSnapshotV1(3, tables, List[YazaSqlColumnDefaultV1]())
    let types: List[Number] = [4]
    let first_row: List[YazaSqlValueV1] = [yaza_sql_executor_value_v1(4, 9223372036854775807, 0.0, false, "")]
    let second_row: List[YazaSqlValueV1] = [yaza_sql_executor_value_v1(4, 1, 0.0, false, "")]
    let rows: List[List[YazaSqlValueV1]] = [first_row, second_row]
    let table: YazaSqlMemoryTableV1 = YazaSqlMemoryTableV1(12, 3, types, rows, 0)
    let source: Text = "SELECT SUM(value) FROM large_values"
    let parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(source)
    if not result_is_ok(parsed): return false
    let bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(source, result_unwrap(parsed), catalog)
    if not result_is_ok(bound): return false
    let parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(bound), table, parameters)
    if result_is_ok(executed) or not text_starts_with(result_unwrap_error(executed), "SQL executor SUM overflowed"): return false
    let structured_overflow: Result[YazaSqlQueryResultV1, YazaSqlDiagnosticV1] = yaza_sql_execute_memory_structured_v1(result_unwrap(bound), table, parameters)
    if result_is_ok(structured_overflow) or result_unwrap_error(structured_overflow).code != 4008: return false
    let minimum: Number = -9223372036854775807 - 1
    let minimum_row: List[YazaSqlValueV1] = [yaza_sql_executor_value_v1(4, minimum, 0.0, false, "")]
    let negative_row: List[YazaSqlValueV1] = [yaza_sql_executor_value_v1(4, -1, 0.0, false, "")]
    let negative_rows: List[List[YazaSqlValueV1]] = [minimum_row, negative_row]
    let underflow_table: YazaSqlMemoryTableV1 = YazaSqlMemoryTableV1(12, 3, types, negative_rows, 0)
    let underflow: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(bound), underflow_table, parameters)
    return not result_is_ok(underflow) and text_starts_with(result_unwrap_error(underflow), "SQL executor SUM underflowed")

fn yaza_base_sql_executor_v1_avg_compensation() -> Boolean:
    let columns: List[YazaSqlColumnSchemaV1] = [YazaSqlColumnSchemaV1("value", 6, false, 0, 0, 0, "")]
    let tables: List[YazaSqlTableSchemaV1] = [YazaSqlTableSchemaV1(13, "samples", columns)]
