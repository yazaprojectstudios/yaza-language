use "../yazabase/sql_executor_v1"
use "../yazabase/sql_decimal_v1"

fn yaza_base_sql_executor_v1_catalog() -> YazaSqlCatalogSnapshotV1:
    let columns: List[YazaSqlColumnSchemaV1] = List[YazaSqlColumnSchemaV1]()
    list_push(columns, YazaSqlColumnSchemaV1("id", 3, false, 0, 0, 0, ""))
    list_push(columns, YazaSqlColumnSchemaV1("score", 6, false, 1, 0, 0, ""))
    list_push(columns, YazaSqlColumnSchemaV1("active", 1, true, 2, 0, 0, ""))
    list_push(columns, YazaSqlColumnSchemaV1("title", 9, true, 3, 0, 0, ""))
    let tables: List[YazaSqlTableSchemaV1] = List[YazaSqlTableSchemaV1]()
    list_push(tables, YazaSqlTableSchemaV1(5, "items", columns))
    return YazaSqlCatalogSnapshotV1(7, tables, List[YazaSqlColumnDefaultV1]())

fn yaza_base_sql_executor_v1_row(id: Number, score: Float64, active: Boolean, title: Text) -> List[YazaSqlValueV1]:
    let row: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    list_push(row, result_unwrap(yaza_sql_value_integer_v1(3, id)))
    list_push(row, yaza_sql_value_double_v1(score))
    list_push(row, yaza_sql_value_boolean_v1(active))
    list_push(row, yaza_sql_value_text_v1(title))
    return row

fn yaza_base_sql_executor_v1_null_row(id: Number, score: Float64) -> List[YazaSqlValueV1]:
    let row: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    list_push(row, result_unwrap(yaza_sql_value_integer_v1(3, id)))
    list_push(row, yaza_sql_value_double_v1(score))
    list_push(row, result_unwrap(yaza_sql_value_null_v1(1)))
    list_push(row, result_unwrap(yaza_sql_value_null_v1(9)))
    return row

fn yaza_base_sql_executor_v1_decimal_value(text: Text) -> YazaSqlValueV1:
    let parsed: Result[YazaSqlDecimalV1, Text] = yaza_sql_decimal_parse_v1(text, 10, 2)
    if not result_is_ok(parsed): fail(result_unwrap_error(parsed))
    let value: Result[YazaSqlValueV1, Text] = yaza_sql_value_decimal_v1(result_unwrap(parsed))
    if not result_is_ok(value): fail(result_unwrap_error(value))
    return result_unwrap(value)

fn yaza_base_sql_executor_v1_decimal_integer_value(text: Text) -> YazaSqlValueV1:
    let parsed: Result[YazaSqlDecimalV1, Text] = yaza_sql_decimal_parse_v1(text, 38, 0)
    if not result_is_ok(parsed): fail(result_unwrap_error(parsed))
    let value: Result[YazaSqlValueV1, Text] = yaza_sql_value_decimal_v1(result_unwrap(parsed))
    if not result_is_ok(value): fail(result_unwrap_error(value))
    return result_unwrap(value)

fn yaza_base_sql_executor_v1_decimal_query() -> Boolean:
    let columns: List[YazaSqlColumnSchemaV1] = [YazaSqlColumnSchemaV1("amount", 10, false, 0, 10, 2, "")]
    let tables: List[YazaSqlTableSchemaV1] = [YazaSqlTableSchemaV1(21, "amounts", columns)]
    let catalog: YazaSqlCatalogSnapshotV1 = YazaSqlCatalogSnapshotV1(7, tables, List[YazaSqlColumnDefaultV1]())
    let types: List[Number] = [10]
    let row_one: List[YazaSqlValueV1] = [yaza_base_sql_executor_v1_decimal_value("1.20")]
    let row_two: List[YazaSqlValueV1] = [yaza_base_sql_executor_v1_decimal_value("9.99")]
    let row_three: List[YazaSqlValueV1] = [yaza_base_sql_executor_v1_decimal_value("10.00")]
    let row_four: List[YazaSqlValueV1] = [yaza_base_sql_executor_v1_decimal_value("1.20")]
    let rows: List[List[YazaSqlValueV1]] = [row_one, row_two, row_three, row_four]
    let table: YazaSqlMemoryTableV1 = YazaSqlMemoryTableV1(21, 7, types, rows, 0)
    let source: Text = "SELECT amount FROM amounts WHERE amount > 1.20 ORDER BY amount"
    let parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(source)
    if not result_is_ok(parsed): return false
    let bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(source, result_unwrap(parsed), catalog)
    if not result_is_ok(bound): return false
    let no_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(bound), table, no_parameters)
    if not result_is_ok(executed): return false
    let output: YazaSqlQueryResultV1 = result_unwrap(executed)
    if list_count(output.rows) != 2: return false
    if list_get(list_get(output.rows, 0), 0).text_value != "9.99" or list_get(list_get(output.rows, 1), 0).text_value != "10.00": return false
    if list_get(output.columns, 0).type_id != 10 or list_get(output.columns, 0).precision != 10 or list_get(output.columns, 0).scale != 2: return false

    let sum_source: Text = "SELECT SUM(amount) AS total FROM amounts"
    let sum_ast: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(sum_source)
    if not result_is_ok(sum_ast): return false
    let sum_plan: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(sum_source, result_unwrap(sum_ast), catalog)
    if not result_is_ok(sum_plan): return false
    let sum_result: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(sum_plan), table, no_parameters)
    if not result_is_ok(sum_result): return false
    let sum_output: YazaSqlQueryResultV1 = result_unwrap(sum_result)
    if list_count(sum_output.rows) != 1 or list_get(list_get(sum_output.rows, 0), 0).text_value != "22.39": return false
    if list_get(sum_output.columns, 0).type_id != 10 or list_get(sum_output.columns, 0).precision != 38 or list_get(sum_output.columns, 0).scale != 2: return false

    let extreme_source: Text = "SELECT MIN(amount), MAX(amount) FROM amounts"
    let extreme_ast: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(extreme_source)
    if not result_is_ok(extreme_ast): return false
    let extreme_plan: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(extreme_source, result_unwrap(extreme_ast), catalog)
    if not result_is_ok(extreme_plan): return false
    let extreme_result: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(extreme_plan), table, no_parameters)
    if not result_is_ok(extreme_result): return false
    let extreme_output: YazaSqlQueryResultV1 = result_unwrap(extreme_result)
    if list_get(list_get(extreme_output.rows, 0), 0).text_value != "1.20" or list_get(list_get(extreme_output.rows, 0), 1).text_value != "10.00": return false

    let grouped_sum_source: Text = "SELECT amount, SUM(amount) AS total FROM amounts GROUP BY amount ORDER BY amount"
    let grouped_sum_ast: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(grouped_sum_source)
    if not result_is_ok(grouped_sum_ast): return false
    let grouped_sum_plan: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(grouped_sum_source, result_unwrap(grouped_sum_ast), catalog)
    if not result_is_ok(grouped_sum_plan): return false
    let grouped_sum_result: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(grouped_sum_plan), table, no_parameters)
    if not result_is_ok(grouped_sum_result): return false
    let grouped_sum_output: YazaSqlQueryResultV1 = result_unwrap(grouped_sum_result)
    if list_count(grouped_sum_output.rows) != 3: return false
    if list_get(list_get(grouped_sum_output.rows, 0), 1).text_value != "2.40": return false
    if list_get(list_get(grouped_sum_output.rows, 1), 1).text_value != "9.99": return false
    if list_get(list_get(grouped_sum_output.rows, 2), 1).text_value != "10.00": return false

    let empty_sum_source: Text = "SELECT SUM(amount) AS total FROM amounts WHERE amount > 100"
    let empty_sum_ast: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(empty_sum_source)
    if not result_is_ok(empty_sum_ast): return false
    let empty_sum_plan: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(empty_sum_source, result_unwrap(empty_sum_ast), catalog)
    if not result_is_ok(empty_sum_plan): return false
    let empty_sum_result: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(empty_sum_plan), table, no_parameters)
    if not result_is_ok(empty_sum_result): return false
    let empty_sum_output: YazaSqlQueryResultV1 = result_unwrap(empty_sum_result)
    if list_count(empty_sum_output.rows) != 1 or not list_get(list_get(empty_sum_output.rows, 0), 0).is_null: return false

    let wide_columns: List[YazaSqlColumnSchemaV1] = [YazaSqlColumnSchemaV1("amount", 10, false, 0, 38, 0, "")]
    let wide_tables: List[YazaSqlTableSchemaV1] = [YazaSqlTableSchemaV1(22, "wide_amounts", wide_columns)]
    let wide_catalog: YazaSqlCatalogSnapshotV1 = YazaSqlCatalogSnapshotV1(7, wide_tables, List[YazaSqlColumnDefaultV1]())
    let wide_types: List[Number] = [10]
    let max_decimal_row: List[YazaSqlValueV1] = [yaza_base_sql_executor_v1_decimal_integer_value("99999999999999999999999999999999999999")]
    let one_decimal_row: List[YazaSqlValueV1] = [yaza_base_sql_executor_v1_decimal_integer_value("1")]
    let wide_rows: List[List[YazaSqlValueV1]] = [max_decimal_row, one_decimal_row]
    let wide_table: YazaSqlMemoryTableV1 = YazaSqlMemoryTableV1(22, 7, wide_types, wide_rows, 0)
    let overflow_source: Text = "SELECT SUM(amount) FROM wide_amounts"
    let overflow_ast: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(overflow_source)
    if not result_is_ok(overflow_ast): return false
    let overflow_plan: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(overflow_source, result_unwrap(overflow_ast), wide_catalog)
    if not result_is_ok(overflow_plan): return false
    if result_is_ok(yaza_sql_execute_memory_v1(result_unwrap(overflow_plan), wide_table, no_parameters)): return false

    let parameter_source: Text = "SELECT amount FROM amounts WHERE amount >= $1 ORDER BY amount"
    let parameter_ast: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(parameter_source)
    if not result_is_ok(parameter_ast): return false
    let parameter_plan: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(parameter_source, result_unwrap(parameter_ast), catalog)
    if not result_is_ok(parameter_plan): return false
    let wider_decimal: Result[YazaSqlDecimalV1, Text] = yaza_sql_decimal_parse_v1("9.990", 10, 3)
    if not result_is_ok(wider_decimal): return false
    let wider_value: Result[YazaSqlValueV1, Text] = yaza_sql_value_decimal_v1(result_unwrap(wider_decimal))
    if not result_is_ok(wider_value): return false
    let parameters: List[YazaSqlValueV1] = [result_unwrap(wider_value)]
    let parameter_result: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(parameter_plan), table, parameters)
    if not result_is_ok(parameter_result): return false
    if list_count(result_unwrap(parameter_result).rows) != 2: return false

    let bad_literal_source: Text = "SELECT amount FROM amounts WHERE amount = 1.201"
    let bad_literal_ast: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(bad_literal_source)
    if not result_is_ok(bad_literal_ast): return false
    return not result_is_ok(yaza_sql_bind_select_v1(bad_literal_source, result_unwrap(bad_literal_ast), catalog))

fn yaza_base_sql_executor_v1_table() -> YazaSqlMemoryTableV1:
    let types: List[Number] = List[Number]()
    list_push(types, 3)
    list_push(types, 6)
    list_push(types, 1)
    list_push(types, 9)
    let rows: List[List[YazaSqlValueV1]] = List[List[YazaSqlValueV1]]()
    list_push(rows, yaza_base_sql_executor_v1_row(1, 2.5, true, "z"))
    list_push(rows, yaza_base_sql_executor_v1_row(2, 3.5, true, "a"))
    list_push(rows, yaza_base_sql_executor_v1_row(3, 4.0, false, "b"))
    list_push(rows, yaza_base_sql_executor_v1_row(4, 5.0, true, "m"))
    list_push(rows, yaza_base_sql_executor_v1_null_row(5, 5.5))
    return YazaSqlMemoryTableV1(5, 7, types, rows, 0)

fn yaza_base_sql_executor_v1_filtered_ordered(catalog: YazaSqlCatalogSnapshotV1, table: YazaSqlMemoryTableV1) -> Boolean:
    let source: Text = "SELECT id, title FROM items WHERE score >= $1 AND active = TRUE ORDER BY title LIMIT 2"
    let parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(source)
    if not result_is_ok(parsed): return false
    let bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(source, result_unwrap(parsed), catalog)
    if not result_is_ok(bound): return false
    let parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    list_push(parameters, yaza_sql_value_double_v1(3.0))
    let executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(bound), table, parameters)
    if not result_is_ok(executed): return false
    let result: YazaSqlQueryResultV1 = result_unwrap(executed)
    if list_count(result.columns) != 2 or list_count(result.rows) != 2: return false
    if list_get(result.columns, 1).output_name != "title": return false
    let first: List[YazaSqlValueV1] = list_get(result.rows, 0)
    let second: List[YazaSqlValueV1] = list_get(result.rows, 1)
    return list_get(first, 0).integer_value == 2 and list_get(first, 1).text_value == "a" and list_get(second, 0).integer_value == 4 and list_get(second, 1).text_value == "m"

fn yaza_base_sql_executor_v1_count_star(catalog: YazaSqlCatalogSnapshotV1, table: YazaSqlMemoryTableV1) -> Boolean:
    let source: Text = "SELECT COUNT(*) AS total FROM items"
    let parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(source)
    if not result_is_ok(parsed): return false
    let bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(source, result_unwrap(parsed), catalog)
    if not result_is_ok(bound): return false
    let no_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(bound), table, no_parameters)
    if not result_is_ok(executed): return false
    let output: YazaSqlQueryResultV1 = result_unwrap(executed)
    if list_count(output.columns) != 1 or list_get(output.columns, 0).output_name != "total" or list_get(output.columns, 0).type_id != 4: return false
    if list_count(output.rows) != 1: return false
    let result_row: List[YazaSqlValueV1] = list_get(output.rows, 0)
    if list_count(result_row) != 1: return false
    let result_value: YazaSqlValueV1 = list_get(result_row, 0)
    if result_value.type_id != 4 or result_value.is_null or result_value.integer_value != 5: return false

    let multiple_source: Text = "SELECT COUNT(*), COUNT(*) FROM items"
    let multiple_parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(multiple_source)
    if not result_is_ok(multiple_parsed): return false
    let multiple_bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(multiple_source, result_unwrap(multiple_parsed), catalog)
    if not result_is_ok(multiple_bound): return false
    let multiple_executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(multiple_bound), table, no_parameters)
    if not result_is_ok(multiple_executed): return false
    let multiple_rows: List[List[YazaSqlValueV1]] = result_unwrap(multiple_executed).rows
    if list_count(multiple_rows) != 1 or list_count(list_get(multiple_rows, 0)) != 2: return false
    if list_get(list_get(multiple_rows, 0), 0).integer_value != 5 or list_get(list_get(multiple_rows, 0), 1).integer_value != 5: return false

    let mixed_source: Text = "SELECT COUNT(*), id FROM items"
    let mixed_parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(mixed_source)
    if not result_is_ok(mixed_parsed): return false
    if result_is_ok(yaza_sql_bind_select_v1(mixed_source, result_unwrap(mixed_parsed), catalog)): return false

    let filtered_source: Text = "SELECT COUNT(*) AS total FROM items WHERE score >= 3.0 AND active = TRUE"
    let filtered_parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(filtered_source)
    if not result_is_ok(filtered_parsed): return false
    let filtered_bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(filtered_source, result_unwrap(filtered_parsed), catalog)
    if not result_is_ok(filtered_bound): return false
    let filtered_executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(filtered_bound), table, no_parameters)
    if not result_is_ok(filtered_executed): return false
    let filtered_rows: List[List[YazaSqlValueV1]] = result_unwrap(filtered_executed).rows
    if list_count(filtered_rows) != 1 or list_get(list_get(filtered_rows, 0), 0).integer_value != 2: return false

    let no_match_source: Text = "SELECT COUNT(*) FROM items WHERE id = 999"
    let no_match_parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(no_match_source)
    if not result_is_ok(no_match_parsed): return false
    let no_match_bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(no_match_source, result_unwrap(no_match_parsed), catalog)
    if not result_is_ok(no_match_bound): return false
    let no_match_executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(no_match_bound), table, no_parameters)
    if not result_is_ok(no_match_executed): return false
    let no_match_rows: List[List[YazaSqlValueV1]] = result_unwrap(no_match_executed).rows
    if list_count(no_match_rows) != 1 or list_get(list_get(no_match_rows, 0), 0).integer_value != 0: return false

    let empty_rows: List[List[YazaSqlValueV1]] = List[List[YazaSqlValueV1]]()
    let empty_table: YazaSqlMemoryTableV1 = YazaSqlMemoryTableV1(table.table_id, table.catalog_version, table.column_type_ids, empty_rows, 0)
    let empty_executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(bound), empty_table, no_parameters)
    if not result_is_ok(empty_executed): return false
    let empty_output: List[List[YazaSqlValueV1]] = result_unwrap(empty_executed).rows
    if list_count(empty_output) != 1 or list_get(list_get(empty_output, 0), 0).integer_value != 0: return false

    let limit_source: Text = "SELECT COUNT(*) FROM items LIMIT 0"
    let limit_parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(limit_source)
    if not result_is_ok(limit_parsed): return false
    let limit_bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(limit_source, result_unwrap(limit_parsed), catalog)
    if not result_is_ok(limit_bound): return false
    let limit_executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(limit_bound), table, no_parameters)
    return result_is_ok(limit_executed) and list_count(result_unwrap(limit_executed).rows) == 0

fn yaza_base_sql_executor_v1_sum(catalog: YazaSqlCatalogSnapshotV1, table: YazaSqlMemoryTableV1) -> Boolean:
    let no_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let integer_source: Text = "SELECT SUM(id) AS total FROM items"
    let integer_parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(integer_source)
    if not result_is_ok(integer_parsed): return false
    let integer_bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(integer_source, result_unwrap(integer_parsed), catalog)
    if not result_is_ok(integer_bound): return false
    let integer_projection: YazaSqlBoundProjectionV1 = list_get(result_unwrap(integer_bound).projections, 0)
    if integer_projection.aggregate_kind != 2 or integer_projection.column_ordinal != 0 or integer_projection.type_id != 4 or not integer_projection.nullable or integer_projection.output_name != "total": return false
    let integer_executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(integer_bound), table, no_parameters)
    if not result_is_ok(integer_executed): return false
    let integer_rows: List[List[YazaSqlValueV1]] = result_unwrap(integer_executed).rows
    if list_count(integer_rows) != 1 or list_count(list_get(integer_rows, 0)) != 1: return false
    let integer_value: YazaSqlValueV1 = list_get(list_get(integer_rows, 0), 0)
    if integer_value.type_id != 4 or integer_value.is_null or integer_value.integer_value != 15: return false

    let double_source: Text = "SELECT SUM(score) AS total FROM items WHERE active = TRUE"
    let double_parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(double_source)
    if not result_is_ok(double_parsed): return false
    let double_bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(double_source, result_unwrap(double_parsed), catalog)
    if not result_is_ok(double_bound): return false
    let double_projection: YazaSqlBoundProjectionV1 = list_get(result_unwrap(double_bound).projections, 0)
    if double_projection.type_id != 6 or double_projection.aggregate_kind != 2 or not double_projection.nullable: return false
    let double_executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(double_bound), table, no_parameters)
    if not result_is_ok(double_executed): return false
    let double_value: YazaSqlValueV1 = list_get(list_get(result_unwrap(double_executed).rows, 0), 0)
    if double_value.type_id != 6 or double_value.is_null or double_value.float_value != 11.0: return false

    let mixed_source: Text = "SELECT SUM(id), SUM(score), COUNT(*), MIN(title) FROM items"
    let mixed_parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(mixed_source)
    if not result_is_ok(mixed_parsed): return false
    let mixed_bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(mixed_source, result_unwrap(mixed_parsed), catalog)
    if not result_is_ok(mixed_bound): return false
    let mixed_executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(result_unwrap(mixed_bound), table, no_parameters)
    if not result_is_ok(mixed_executed): return false
    let mixed_row: List[YazaSqlValueV1] = list_get(result_unwrap(mixed_executed).rows, 0)
    if list_count(mixed_row) != 4 or list_get(mixed_row, 0).integer_value != 15 or list_get(mixed_row, 1).float_value != 20.5 or list_get(mixed_row, 2).integer_value != 5 or list_get(mixed_row, 3).text_value != "a": return false

    let average_source: Text = "SELECT AVG(id) AS mean FROM items"
    let average_parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(average_source)
    if not result_is_ok(average_parsed): return false
    let average_bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(average_source, result_unwrap(average_parsed), catalog)
    if not result_is_ok(average_bound): return false
