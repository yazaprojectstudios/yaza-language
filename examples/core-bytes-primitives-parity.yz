start:
    let word: Bytes = bytes_from_text("hello")
    assert bytes_length(word) == 5
    assert bytes_get(word, 0) == 104
    assert bytes_equal(word, bytes_from_text("hello"))
    assert bytes_equal_constant_time(word, bytes_from_text("hello"))

    let joined: Bytes = bytes_concat(word, bytes_from_number(0))
    assert bytes_length(joined) == 6
    assert bytes_get(joined, 5) == 0
    assert bytes_equal(bytes_slice(joined, 0, 5), word)
    assert bytes_length(bytes_slice(joined, 5, 0)) == 0

    let decoded: Option[Text] = bytes_to_text_checked(bytes_from_text("héllo 🌋"))
    assert option_is_some(decoded)
    assert option_unwrap(decoded) == "héllo 🌋"
    assert not option_is_some(bytes_to_text_checked(bytes_from_number(255)))
    assert not option_is_some(bytes_to_text_checked(joined))

    let bounded: Result[Bytes, Text] = bytes_from_text_bounded("abc", 3)
    assert result_is_ok(bounded)
    assert bytes_equal(result_unwrap(bounded), bytes_from_text("abc"))
    say "bytes-parity-ok"
