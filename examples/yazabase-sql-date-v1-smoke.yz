use "../yazabase/sql_date_v1"

fn yaza_base_date_smoke_v1() -> Result[Boolean, Text]:
    let epoch: Number = yaza_sql_date_parse_v1("1970-01-01")?
    if epoch != 0: return err("YazaBase DATE epoch mapping is wrong")
    let leap_day: Number = yaza_sql_date_parse_v1("2000-02-29")?
    let leap_text: Text = yaza_sql_date_to_text_v1(leap_day)?
    if leap_text != "2000-02-29": return err("YazaBase DATE leap-day round trip failed")
    let first_day: Number = yaza_sql_date_parse_v1("0001-01-01")?
    if first_day != -719162: return err("YazaBase DATE lower bound is wrong")
    let first_text: Text = yaza_sql_date_to_text_v1(first_day)?
    if first_text != "0001-01-01": return err("YazaBase DATE lower-bound formatting failed")
    let last_day: Number = yaza_sql_date_parse_v1("9999-12-31")?
    if last_day != 2932896: return err("YazaBase DATE upper bound is wrong")
    let last_text: Text = yaza_sql_date_to_text_v1(last_day)?
    if last_text != "9999-12-31": return err("YazaBase DATE upper-bound formatting failed")
    let century_day: Number = yaza_sql_date_parse_v1("1900-02-28")?
    let century_text: Text = yaza_sql_date_to_text_v1(century_day + 1)?
    if century_text != "1900-03-01": return err("YazaBase DATE Gregorian century rule is wrong")
    let century_leap_day: Result[Number, Text] = yaza_sql_date_parse_v1("2000-02-29")
    if not result_is_ok(century_leap_day): return err("YazaBase DATE rejected a Gregorian 400-year leap day")
    if result_is_ok(yaza_sql_date_parse_v1("0000-12-31")): return err("YazaBase DATE accepted year zero")
    if result_is_ok(yaza_sql_date_parse_v1("1900-02-29")): return err("YazaBase DATE accepted a non-leap century day")
    if result_is_ok(yaza_sql_date_parse_v1("2024-04-31")): return err("YazaBase DATE accepted an invalid month day")
    if result_is_ok(yaza_sql_date_parse_v1("2024-2-03")): return err("YazaBase DATE accepted non-canonical width")
    if result_is_ok(yaza_sql_date_to_text_v1(-719163)): return err("YazaBase DATE formatted below the supported range")
    if result_is_ok(yaza_sql_date_to_text_v1(2932897)): return err("YazaBase DATE formatted above the supported range")
    return ok(true)

start:
    let outcome: Result[Boolean, Text] = yaza_base_date_smoke_v1()
    if not result_is_ok(outcome): say result_unwrap_error(outcome)
    elif result_unwrap(outcome): say "yazabase-sql-date-v1-ok"
    else: say "YazaBase DATE helper fixture returned false"
