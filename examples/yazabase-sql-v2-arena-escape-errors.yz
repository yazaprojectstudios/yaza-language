use "../yazabase/sql_parser_v2"

fn yaza_base_leak_select_ast_v2() -> Result[YazaSqlSelectAstV2, Text]:
    arena_scope 65536:
        return yaza_sql_parse_select_v2("SELECT p.id AS product_id FROM catalog.products AS p WHERE p.active = TRUE")

start:
    let escaped: Result[YazaSqlSelectAstV2, Text] = yaza_base_leak_select_ast_v2()
    assert not result_is_ok(escaped)
