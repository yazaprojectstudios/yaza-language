use "../yazabase/page_v1"
use "../yazabase/wal_v1"

fn yaza_base_node_split_test_page_v1(page_id: Number, page_lsn: Number) -> Result[Bytes, Text]:
    let page: Bytes = yaza_db_page_new_v1(page_id, page_lsn, 1, 0)?
    return yaza_db_page_finalize_v1(page)

fn yaza_base_node_split_wal_v1_check() -> Result[Number, Text]:
    let before_page: Bytes = yaza_db_page_new_v1(3, 39, 1, 0)?
    let slot_a: Number = yaza_db_page_add_slot_v1(before_page, bytes_from_text("a"), bytes_from_text("row-a"))?
    let slot_b: Number = yaza_db_page_add_slot_v1(before_page, bytes_from_text("b"), bytes_from_text("row-b"))?
    let slot_c: Number = yaza_db_page_add_slot_v1(before_page, bytes_from_text("c"), bytes_from_text("row-c"))?
    let slot_d: Number = yaza_db_page_add_slot_v1(before_page, bytes_from_text("d"), bytes_from_text("row-d"))?
    if slot_a != 0 or slot_b != 1 or slot_c != 2 or slot_d != 3: return err("YDBv1 node-split fixture could not create its source leaf")
    let before_image: Bytes = yaza_db_page_finalize_v1(before_page)?
    let split: YazaDbLeafSplitV1 = yaza_db_page_split_leaf_v1(before_image, 4, 40)?

    var pages: List[YazaDbWalNodeSplitPageV1] = List[YazaDbWalNodeSplitPageV1]()
    let existing_page: YazaDbWalNodeSplitPageV1 = YazaDbWalNodeSplitPageV1(3, true, before_image, split.left_page)
    let new_page: YazaDbWalNodeSplitPageV1 = YazaDbWalNodeSplitPageV1(4, false, bytes_from_text(""), split.right_page)
    if not list_try_push(pages, existing_page) or not list_try_push(pages, new_page): return err("YDBv1 node-split fixture page list allocation failed")
    let payload: Bytes = yaza_db_wal_node_split_payload_encode_v1(40, pages)?
    if bytes_length(payload) != yaza_db_wal_node_split_payload_size_v1(2): return err("YDBv1 NODE_SPLIT encoded payload size is incorrect")
    let record: YazaDbWalRecordV1 = YazaDbWalRecordV1(40, 20, 7, yaza_db_wal_type_node_split_v1(), 0, payload)
    let decoded: YazaDbWalNodeSplitV1 = yaza_db_wal_node_split_payload_decode_v1(record)?
    if list_count(decoded.pages) != 2: return err("YDBv1 NODE_SPLIT codec did not round-trip its page count")
    let decoded_left: YazaDbWalNodeSplitPageV1 = list_get(decoded.pages, 0)
    let decoded_right: YazaDbWalNodeSplitPageV1 = list_get(decoded.pages, 1)
    if decoded_left.page_id != 3 or not decoded_left.has_before_image or not bytes_equal(decoded_left.before_image, before_image) or not bytes_equal(decoded_left.after_image, split.left_page): return err("YDBv1 NODE_SPLIT codec changed the existing-page images")
    if decoded_right.page_id != 4 or decoded_right.has_before_image or not yaza_db_wal_bytes_all_zero_v1(decoded_right.before_image) or not bytes_equal(decoded_right.after_image, split.right_page): return err("YDBv1 NODE_SPLIT codec changed the newly allocated page entry")
    let encoded_record: Bytes = yaza_db_wal_encode_v1(record)?
    let framed_record: YazaDbWalRecordV1 = yaza_db_wal_decode_v1(encoded_record, 40)?
    let framed_split: YazaDbWalNodeSplitV1 = yaza_db_wal_node_split_payload_decode_v1(framed_record)?
    if not bytes_equal(list_get(framed_split.pages, 0).after_image, split.left_page) or not bytes_equal(list_get(framed_split.pages, 1).after_image, split.right_page): return err("YDBv1 NODE_SPLIT page images did not survive generic WAL framing")
    if yaza_db_wal_node_split_max_pages_v1() != 16 or yaza_db_wal_node_split_compensation_max_pages_v1() != 16: return err("YDBv1 NODE_SPLIT recovery page bound changed")

    var bounded_pages: List[YazaDbWalNodeSplitPageV1] = List[YazaDbWalNodeSplitPageV1]()
    var boundary_page_id: Number = 3
    while boundary_page_id < 19:
        let boundary_page: Bytes = yaza_base_node_split_test_page_v1(boundary_page_id, 40)?
        if not list_try_push(bounded_pages, YazaDbWalNodeSplitPageV1(boundary_page_id, false, bytes_from_text(""), boundary_page)): return err("YDBv1 NODE_SPLIT boundary fixture allocation failed")
        set boundary_page_id = boundary_page_id + 1
    let max_payload: Bytes = yaza_db_wal_node_split_payload_encode_v1(40, bounded_pages)?
    let max_record: YazaDbWalRecordV1 = YazaDbWalRecordV1(40, 20, 7, yaza_db_wal_type_node_split_v1(), 0, max_payload)
    let max_decoded: YazaDbWalNodeSplitV1 = yaza_db_wal_node_split_payload_decode_v1(max_record)?
    if list_count(max_decoded.pages) != 16: return err("YDBv1 NODE_SPLIT codec rejected the maximum supported page set")
    let extra_page: Bytes = yaza_base_node_split_test_page_v1(19, 40)?
    if not list_try_push(bounded_pages, YazaDbWalNodeSplitPageV1(19, false, bytes_from_text(""), extra_page)): return err("YDBv1 NODE_SPLIT over-bound fixture allocation failed")
    if result_is_ok(yaza_db_wal_node_split_payload_encode_v1(40, bounded_pages)): return err("YDBv1 NODE_SPLIT encoder accepted more pages than its recovery arena bound")

    var bounded_clr_pages: List[YazaDbWalPageSetImageV1] = List[YazaDbWalPageSetImageV1]()
    var clr_page_id: Number = 3
    while clr_page_id < 19:
        let clr_image: Bytes = yaza_base_node_split_test_page_v1(clr_page_id, 80)?
        if not list_try_push(bounded_clr_pages, YazaDbWalPageSetImageV1(clr_page_id, clr_image)): return err("YDBv1 NODE_SPLIT CLR boundary fixture allocation failed")
        set clr_page_id = clr_page_id + 1
    let max_clr_payload: Bytes = yaza_db_wal_node_split_compensation_payload_encode_v1(20, 40, 80, 60, bounded_clr_pages)?
    if bytes_length(max_clr_payload) != yaza_db_wal_node_split_compensation_payload_size_v1(16): return err("YDBv1 NODE_SPLIT CLR maximum payload size is incorrect")
    let extra_clr_image: Bytes = yaza_base_node_split_test_page_v1(19, 80)?
    if not list_try_push(bounded_clr_pages, YazaDbWalPageSetImageV1(19, extra_clr_image)): return err("YDBv1 NODE_SPLIT CLR over-bound fixture allocation failed")
    if result_is_ok(yaza_db_wal_node_split_compensation_payload_encode_v1(20, 40, 80, 60, bounded_clr_pages)): return err("YDBv1 NODE_SPLIT CLR encoder accepted more pages than its recovery bound")

    let undo_image: Bytes = bytes_try_slice(before_image, 0, bytes_length(before_image))?
    if not yaza_db_write_uint_le_v1(undo_image, 0, 80, 8): return err("YDBv1 NODE_SPLIT CLR fixture could not stamp its undo image")
    let stamped_undo_image: Bytes = yaza_db_page_finalize_v1(undo_image)?
    var clr_pages: List[YazaDbWalPageSetImageV1] = List[YazaDbWalPageSetImageV1]()
    if not list_try_push(clr_pages, YazaDbWalPageSetImageV1(3, stamped_undo_image)): return err("YDBv1 NODE_SPLIT CLR fixture page list allocation failed")
    let clr_payload: Bytes = yaza_db_wal_node_split_compensation_payload_encode_v1(20, 40, 80, 60, clr_pages)?
    let clr_record: YazaDbWalRecordV1 = YazaDbWalRecordV1(80, 60, 7, yaza_db_wal_type_compensation_v1(), 0, clr_payload)
    let clr_bytes: Bytes = yaza_db_wal_encode_v1(clr_record)?
    let decoded_clr_record: YazaDbWalRecordV1 = yaza_db_wal_decode_v1(clr_bytes, 80)?
    let decoded_clr: YazaDbWalNodeSplitCompensationV1 = yaza_db_wal_node_split_compensation_payload_decode_v1(decoded_clr_record)?
    if decoded_clr.undo_next_lsn != 20 or decoded_clr.compensated_lsn != 40 or list_count(decoded_clr.pages) != 1 or list_get(decoded_clr.pages, 0).page_id != 3 or not bytes_equal(list_get(decoded_clr.pages, 0).image, stamped_undo_image): return err("YDBv1 NODE_SPLIT CLR codec did not round-trip its undo chain and page image")

    var descending_pages: List[YazaDbWalNodeSplitPageV1] = List[YazaDbWalNodeSplitPageV1]()
    if not list_try_push(descending_pages, new_page) or not list_try_push(descending_pages, existing_page): return err("YDBv1 descending NODE_SPLIT fixture allocation failed")
    if result_is_ok(yaza_db_wal_node_split_payload_encode_v1(40, descending_pages)): return err("YDBv1 NODE_SPLIT encoder accepted noncanonical page order")
    let wrong_record_type: YazaDbWalRecordV1 = YazaDbWalRecordV1(40, 20, 7, yaza_db_wal_type_node_merge_v1(), 0, payload)
    if result_is_ok(yaza_db_wal_node_split_payload_decode_v1(wrong_record_type)): return err("YDBv1 NODE_SPLIT decoder accepted a different record type")
    let wrong_record_lsn: YazaDbWalRecordV1 = YazaDbWalRecordV1(41, 20, 7, yaza_db_wal_type_node_split_v1(), 0, payload)
    if result_is_ok(yaza_db_wal_node_split_payload_decode_v1(wrong_record_lsn)): return err("YDBv1 NODE_SPLIT decoder accepted after-images stamped with another LSN")

    let corrupt_payload: Bytes = bytes_try_slice(payload, 0, bytes_length(payload))?
    let corrupt_offset: Number = yaza_db_wal_node_split_header_size_v1() + yaza_db_wal_node_split_entry_size_v1() + 16 + 100
    if not bytes_try_set(corrupt_payload, corrupt_offset, bytes_get(corrupt_payload, corrupt_offset) + 1): return err("YDBv1 NODE_SPLIT corruption fixture could not modify its page image")
    let corrupt_record: YazaDbWalRecordV1 = YazaDbWalRecordV1(40, 20, 7, yaza_db_wal_type_node_split_v1(), 0, corrupt_payload)
    if result_is_ok(yaza_db_wal_node_split_payload_decode_v1(corrupt_record)): return err("YDBv1 NODE_SPLIT decoder accepted a corrupt page CRC")

    let bad_flag_payload: Bytes = bytes_try_slice(payload, 0, bytes_length(payload))?
    if not yaza_db_write_uint_le_v1(bad_flag_payload, yaza_db_wal_node_split_header_size_v1() + 8, 2, 4): return err("YDBv1 NODE_SPLIT invalid-flag fixture could not be encoded")
    let bad_flag_record: YazaDbWalRecordV1 = YazaDbWalRecordV1(40, 20, 7, yaza_db_wal_type_node_split_v1(), 0, bad_flag_payload)
    if result_is_ok(yaza_db_wal_node_split_payload_decode_v1(bad_flag_record)): return err("YDBv1 NODE_SPLIT decoder accepted an unknown image flag")

    let bad_new_before: YazaDbWalNodeSplitPageV1 = YazaDbWalNodeSplitPageV1(4, false, bytes_from_text("not-zero"), split.right_page)
    let bad_new_pages: List[YazaDbWalNodeSplitPageV1] = [existing_page, bad_new_before]
    if result_is_ok(yaza_db_wal_node_split_payload_encode_v1(40, bad_new_pages)): return err("YDBv1 NODE_SPLIT encoder accepted nonzero absent-before data")
    let bad_clr_chain: Result[Bytes, Text] = yaza_db_wal_node_split_compensation_payload_encode_v1(40, 40, 80, 60, clr_pages)
    if result_is_ok(bad_clr_chain): return err("YDBv1 NODE_SPLIT CLR encoder accepted a non-advancing undo cursor")
    return ok(bytes_length(payload))

start:
    let outcome: Result[Number, Text] = yaza_base_node_split_wal_v1_check()
    if result_is_ok(outcome):
        say "yazabase-node-split-wal-v1-ok bytes=" + number_text(result_unwrap(outcome))
    else:
        say result_unwrap_error(outcome)
