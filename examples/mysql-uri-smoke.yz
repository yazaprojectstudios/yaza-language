use "std/mysql/uri"

start:
    # 1. Full URI with credentials, port, db, and params
    let uri1: Text = "mysql://app_user:s3cr3t@db.example.com:3307/orders?sslmode=require&charset=utf8mb4&connect_timeout=15"
    let res1: Result[MysqlConnectionConfig, Text] = mysql_parse_uri(uri1)
    assert result_is_ok(res1)
    let cfg1: MysqlConnectionConfig = result_unwrap(res1)
    assert cfg1.user == "app_user"
    assert option_is_some(cfg1.password)
    assert option_unwrap(cfg1.password) == "s3cr3t"
    assert cfg1.host == "db.example.com"
    assert cfg1.port == 3307
    assert option_is_some(cfg1.database)
    assert option_unwrap(cfg1.database) == "orders"
    assert cfg1.ssl_mode == "require"
    assert cfg1.charset == "utf8mb4"
    assert cfg1.connect_timeout_seconds == 15

    # 2. Minimal URI
    let uri2: Text = "mysql://localhost/testdb"
    let res2: Result[MysqlConnectionConfig, Text] = mysql_parse_uri(uri2)
    assert result_is_ok(res2)
    let cfg2: MysqlConnectionConfig = result_unwrap(res2)
    assert cfg2.user == "root"
    assert not option_is_some(cfg2.password)
    assert cfg2.host == "localhost"
    assert cfg2.port == 3306
    assert option_is_some(cfg2.database)
    assert option_unwrap(cfg2.database) == "testdb"

    # 3. Percent-encoded user and password
    let uri3: Text = "mysql://user%40domain:p%40ss%3Aword@127.0.0.1:3306/db"
    let res3: Result[MysqlConnectionConfig, Text] = mysql_parse_uri(uri3)
    assert result_is_ok(res3)
    let cfg3: MysqlConnectionConfig = result_unwrap(res3)
    assert cfg3.user == "user@domain"
    assert option_is_some(cfg3.password)
    assert option_unwrap(cfg3.password) == "p@ss:word"

    # 4. Invalid schemes and ports
    assert not result_is_ok(mysql_parse_uri("postgres://localhost/db"))
    assert not result_is_ok(mysql_parse_uri("mysql://localhost:99999/db"))
    assert not result_is_ok(mysql_parse_uri("mysql://localhost:abc/db"))
