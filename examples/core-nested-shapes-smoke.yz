shape Shelf:
    featured: Option[Book]
    stock: Number

shape Book:
    title: Text
    price: Number

shape Node:
    next: Option[Node]

fn replace_featured(shelf: Shelf, book: Book) -> Shelf:
    return Shelf(some(book), shelf.stock)

fn lookup_book(book: Book, found: Boolean) -> Result[Book, Book]:
    if found:
        return ok(book)
    else:
        return err(book)
    return err(book)

fn relay_lookup(book: Book, found: Boolean) -> Result[Book, Book]:
    return lookup_book(book, found)?

start:
    let original: Book = Book("YAZA Guide", 1499)
    var shelf: Shelf = Shelf(some(original), 5)
    assert option_unwrap(shelf.featured).title == "YAZA Guide"
    assert option_unwrap(shelf.featured).price == 1499
    match shelf.featured:
        some(featured):
            assert featured.title == "YAZA Guide"
        none:
            assert false

    set shelf.featured = some(Book("Compiler Notes", 1899))
    assert option_unwrap(shelf.featured).title == "Compiler Notes"
    let replaced: Shelf = replace_featured(shelf, Book("Runtime Manual", 1999))
    assert option_unwrap(replaced.featured).title == "Runtime Manual"
    assert replaced.stock == 5

    let absent: Option[Book] = none
    assert not option_is_some(absent)
    let failed: Result[Book, Book] = lookup_book(original, false)
    assert not result_is_ok(failed)
    assert result_unwrap_error(failed).title == "YAZA Guide"
    match failed:
        ok(value):
            assert false
        err(problem):
            assert problem.price == 1499
    let successful: Result[Book, Book] = relay_lookup(original, true)
    assert result_is_ok(successful)
    assert result_unwrap(successful).title == "YAZA Guide"
    let propagated: Result[Book, Book] = relay_lookup(original, false)
    assert not result_is_ok(propagated)
    assert result_unwrap_error(propagated).price == 1499

    var head: Node = Node(none)
    set head.next = some(Node(none))
    assert option_is_some(head.next)
    let second: Node = option_unwrap(head.next)
    assert not option_is_some(second.next)
    set head.next = some(Node(some(Node(none))))
    let third: Node = option_unwrap(option_unwrap(head.next).next)
    assert not option_is_some(third.next)
    say "nested-shapes-ok"
