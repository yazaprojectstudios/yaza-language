shape Product:
    id: Number

variant Lookup:
    Missing
    Found(product: Product)

fn inner_values() -> List[Number]:
    var values: List[Number] = List[Number]()
    list_push(values, 1)
    return values

start:
    var products: List[Product] = List[Product]()
    list_push(products, Product(1))
    var lookups: List[Lookup] = List[Lookup]()
    list_push(lookups, Lookup::Found(Product(2)))
    var options: List[Option[Number]] = List[Option[Number]]()
    list_push(options, some(3))
    var results: List[Result[Number, Text]] = List[Result[Number, Text]]()
    list_push(results, ok(4))
    var nested: List[List[Number]] = List[List[Number]]()
    list_push(nested, inner_values())

    let mode: Text = arg(1)
    if mode == "product-get":
        let invalid: Product = list_get(products, 9)
        say invalid.id
    elif mode == "variant-get":
        let invalid: Lookup = list_get(lookups, 9)
        match invalid:
            Missing:
                say "missing"
            Found(product):
                say product.id
    elif mode == "option-get":
        let invalid: Option[Number] = list_get(options, 9)
        say option_is_some(invalid)
    elif mode == "result-get":
        let invalid: Result[Number, Text] = list_get(results, 9)
        say result_is_ok(invalid)
    elif mode == "nested-get":
        let invalid: List[Number] = list_get(nested, 9)
        say list_count(invalid)
    elif mode == "product-set":
        list_set(products, 9, Product(11))
    elif mode == "variant-set":
        list_set(lookups, 9, Lookup::Missing)
    elif mode == "option-set":
        list_set(options, 9, some(13))
    elif mode == "result-set":
        list_set(results, 9, err("replacement"))
    elif mode == "nested-set":
        list_set(nested, 9, inner_values())
    else:
        say "unknown-mode"
