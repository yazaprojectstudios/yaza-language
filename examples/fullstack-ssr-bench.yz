# YAZA Arena-SSR Fullstack Benchmark Server (RFC 0009 Phase 4)
# Isolates HTTP/1.1 keep-alive + per-request arena_scope + std/web/* SSR/Fragment/Static/JSON throughput.
use "std/net"
use "std/http"
use "std/json"
use "std/sync"
use "std/web/request"
use "std/web/response"
use "std/web/view"
use "std/web/static"

shape BenchTask:
    id: Text
    title: Text
    owner: Text
    priority: Text
    status: Text

fn header_end_index(raw_text: Text) -> Number:
    let crlf: Number = text_find(raw_text, "\r\n\r\n")
    if crlf >= 0: return crlf + 4
    let lf: Number = text_find(raw_text, "\n\n")
    if lf >= 0: return lf + 2
    return -1

fn request_wants_close(raw_text: Text) -> Boolean:
    return text_find(raw_text, "Connection: close") >= 0 or text_find(raw_text, "connection: close") >= 0

fn read_http_req(client_fd: Number) -> Bytes:
    var buf: Bytes = bytes_empty()
    var hdr_end: Number = -1
    var content_len: Number = 0
    var chunks: Number = 0
    while chunks < 32:
        let rd: Result[Bytes, Text] = tcp_read(client_fd, 8192, 5000)
        if not result_is_ok(rd): break
        let chunk: Bytes = result_unwrap(rd)
        if bytes_length(chunk) == 0: break
        set buf = bytes_concat(buf, chunk)
        let cur_len: Number = bytes_length(buf)
        if hdr_end < 0:
            let txt: Text = bytes_to_text(buf)
            set hdr_end = header_end_index(txt)
            if hdr_end >= 0:
                let p: Result[HttpRequest, Text] = http_parse_request(bytes_slice(buf, 0, hdr_end))
                if result_is_ok(p): set content_len = result_unwrap(p).content_length
        if hdr_end >= 0 and cur_len >= hdr_end + content_len:
            return bytes_slice(buf, 0, hdr_end + content_len)
        set chunks = chunks + 1
    return buf

fn build_bench_tasks() -> List[BenchTask]:
    let items: List[BenchTask] = List[BenchTask]()
    var i: Number = 1
    while i <= 16:
        var prio: Text = "normal"
        var st: Text = "open"
        if i % 3 == 0: set prio = "high"
        if i % 4 == 0: set st = "done"
        list_push(items, BenchTask("tsk-" + number_text(i), "Arena-SSR Task #" + number_text(i) + " <verified & safe>", "admin", prio, st))
        set i = i + 1
    return items

fn render_fragment(items: List[BenchTask], csrf: Text) -> Text:
    var out: Text = "<section id=\"task-board\"><div class=\"yz-metrics\"><article class=\"yz-card\"><strong>16</strong></article></div><table class=\"yz-table\"><tbody>"
    var i: Number = 0
    while i < list_count(items):
        let it: BenchTask = list_get(items, i)
        set out = out + "<tr><td>" + view_escape(it.id) + "</td><td>" + view_escape(it.title) + "</td><td>" + view_escape(it.priority) + "</td><td>" + view_escape(it.status) + "</td><td>" + view_csrf_input(csrf) + "</td></tr>"
        set i = i + 1
    return out + "</tbody></table></section>"

fn render_full_page(items: List[BenchTask], csrf: Text) -> Text:
    var html: Text = "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><title>Bench · YAZA MVC</title><link rel=\"stylesheet\" href=\"/public/yaza-ui.css\"><script defer src=\"/public/yaza-live.js\"></script></head><body><main class=\"yz-content\"><h1>Workspace Tasks</h1>"
    set html = html + render_fragment(items, csrf)
    return html + "</main></body></html>"

fn render_json(items: List[BenchTask]) -> Text:
    var out: Text = "["
    var i: Number = 0
    while i < list_count(items):
        if i > 0: set out = out + ","
        let it: BenchTask = list_get(items, i)
        set out = out + "{\"id\":\"" + json_escape_text(it.id) + "\",\"title\":\"" + json_escape_text(it.title) + "\",\"owner\":\"" + json_escape_text(it.owner) + "\",\"priority\":\"" + json_escape_text(it.priority) + "\",\"status\":\"" + json_escape_text(it.status) + "\"}"
        set i = i + 1
    return out + "]"

fn dispatch_bench(req: WebRequest, css_bytes: Bytes, css_etag: Text) -> WebResponse:
    let path: Text = req.http.path
    if path == "/healthz":
        return web_from_http_response(http_response_ok_json("{\"status\":\"ok\"}"))
    if path == "/public/yaza-ui.css":
        if req.if_none_match == css_etag:
            return web_not_modified(css_etag, "public, max-age=300, must-revalidate")
        return web_static_ok("text/css; charset=utf-8", css_bytes, css_etag, "public, max-age=300, must-revalidate")
    let items: List[BenchTask] = build_bench_tasks()
    let csrf: Text = "7bd8e11f66c2ec6a94f1c8d30e2b5a4c112233445566778899aabbccddeeff00"
    if path == "/api/v1/tasks" or web_request_wants_json(req):
        return web_from_http_response(http_response_ok_json(render_json(items)))
    if path == "/tasks" and web_request_wants_fragment(req):
        return web_fragment_ok(render_fragment(items, csrf))
    return web_html_ok(render_full_page(items, csrf))

fn handle_conn(client_fd: Number, css_bytes: Bytes, css_etag: Text) -> Boolean:
    var keep_alive: Boolean = true
    var n: Number = 0
    while keep_alive and n < 4096:
        var cont: Boolean = false
        arena_scope 1048576:
            let raw: Bytes = read_http_req(client_fd)
            if bytes_length(raw) > 0:
                set n = n + 1
                if n >= 4096 or request_wants_close(bytes_to_text(raw)): set keep_alive = false
                let parsed: Result[WebRequest, Text] = web_parse_request(raw)
                var resp: WebResponse = web_from_http_response(http_response_bad_request("bad request", true))
                if result_is_ok(parsed):
                    set resp = dispatch_bench(result_unwrap(parsed), css_bytes, css_etag)
                let wire: Bytes = web_format_response(resp, "", keep_alive)
                let wr: Result[Number, Text] = tcp_write(client_fd, wire, 5000)
                if result_is_ok(wr): set cont = true
        if not cont: break
    let _cl: Result[Boolean, Text] = tcp_close(client_fd)
    return true

async fn worker_loop(lock: Mutex, listener: Number, css_bytes: Bytes, css_etag: Text) -> Boolean:
    while true:
        let _lk: Boolean = mutex_lock(lock)
        let acc: Result[Number, Text] = tcp_accept(listener, 1000)
        let _unlk: Boolean = mutex_unlock(lock)
        if result_is_ok(acc):
            let _ok: Boolean = handle_conn(result_unwrap(acc), css_bytes, css_etag)
    return true

start:
    var port: Number = 18110
    let env_p: Text = env_get("BENCH_PORT")
    if env_p != "":
        let pr: Result[Number, Text] = number_try_parse(env_p)
        if result_is_ok(pr): set port = result_unwrap(pr)
    var css_path: Text = "templates/fullstack/public/yaza-ui.css"
    let env_css: Text = env_get("BENCH_CSS_PATH")
    if env_css != "": set css_path = env_css
    let css_bytes: Bytes = bytes_from_text(file_read(css_path))
    let css_etag: Text = static_compute_etag(css_bytes)
    let listener: Number = result_unwrap(tcp_listen("127.0.0.1", port, 256))
    let lock: Mutex = mutex_create(1)
    let workers: List[Task[Boolean]] = List[Task[Boolean]]()
    var i: Number = 0
    while i < 8:
        list_push(workers, spawn worker_loop(lock, listener, css_bytes, css_etag))
        set i = i + 1
    var j: Number = 0
    while j < list_count(workers):
        let _d: Boolean = await list_get(workers, j)
        set j = j + 1
