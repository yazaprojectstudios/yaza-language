start:
    let retained: List[Bytes] = List[Bytes]()
    let initial: Bytes = bytes_from_text("static")
    arena_scope 4096:
        var carried: Bytes = initial
        var index: Number = 0
        while index < 2:
            list_push(retained, carried)
            set carried = bytes_from_text("child-" + number_text(index))
            set index = index + 1
    say "scope-closed"
