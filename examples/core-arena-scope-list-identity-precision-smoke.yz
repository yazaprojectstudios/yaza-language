start:
    let parent_bytes: Bytes = bytes_from_text("parent-safe")
    let output: List[Bytes] = List[Bytes]()
    arena_scope 4096:
        let parent_value_list: List[Bytes] = List[Bytes]()
        let child_value_list: List[Bytes] = List[Bytes]()
        let parent_list_alias: List[Bytes] = parent_value_list
        let child_bytes: Bytes = bytes_from_text("child")
        list_push(parent_list_alias, parent_bytes)
        list_push(child_value_list, child_bytes)
        let safe_value: Bytes = list_get(parent_value_list, 0)
        list_push(output, safe_value)
    say bytes_to_text(list_get(output, 0))
