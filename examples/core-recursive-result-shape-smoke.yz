shape Chain:
    value: Number
    next: Result[Chain, Text]

fn relay_follow(result: Result[Chain, Text]) -> Result[Chain, Text]:
    return result?

start:
    let last_result: Result[Chain, Text] = err("end")
    let last: Chain = Chain(3, last_result)
    let middle_result: Result[Chain, Text] = ok(last)
    let middle: Chain = Chain(2, middle_result)
    let first_result: Result[Chain, Text] = ok(middle)
    let first: Chain = Chain(1, first_result)

    assert first.value == 1
    assert result_is_ok(first.next)
    assert result_unwrap(first.next).value == 2
    assert result_unwrap(result_unwrap(first.next).next).value == 3
    assert result_unwrap_error(result_unwrap(result_unwrap(first.next).next).next) == "end"
    assert result_unwrap_error(last.next) == "end"
    assert result_unwrap(relay_follow(first.next)).value == 2

    let values: List[Result[Chain, Text]] = List[Result[Chain, Text]]()
    list_push(values, ok(first))
    list_push(values, err("missing"))
    let first_value: Option[Result[Chain, Text]] = list_try_get(values, 0)
    let second_value: Option[Result[Chain, Text]] = list_try_get(values, 1)
    assert result_unwrap(option_unwrap(first_value)).value == 1
    assert result_unwrap_error(option_unwrap(second_value)) == "missing"
    assert not option_is_some(list_try_get(values, 2))

    say "recursive-result-shape-ok"
