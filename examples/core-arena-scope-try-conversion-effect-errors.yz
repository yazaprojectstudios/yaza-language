shape SourceError:
    items: List[Bytes]

shape TargetError:
    message: Text

impl From[SourceError] for TargetError:
    fn from(error: SourceError) -> TargetError:
        let temporary: Bytes = bytes_from_text("child " + number_text(11))
        list_push(error.items, temporary)
        return TargetError("converted")

fn convert_or_fallback(input: Result[Number, SourceError], fallback: Result[Number, TargetError]) -> Result[Number, TargetError]:
    let value: Number = input?
    return fallback

start:
    let output: List[Bytes] = List[Bytes]()
    let source_error: SourceError = SourceError(output)
    let failed: Result[Number, SourceError] = err(source_error)
    let fallback: Result[Number, TargetError] = ok(0)
    arena_scope 4096:
        let ignored: Result[Number, TargetError] = convert_or_fallback(failed, fallback)
        assert not result_is_ok(ignored)
