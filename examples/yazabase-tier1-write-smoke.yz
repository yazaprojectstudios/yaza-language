use "./yazabase-tier1-write-cases"

start:
    if arg_count() < 1:
        say "usage: yazabase-tier1-write-smoke <root-dir>"
        exit(2)
    let outcome: Result[Boolean, Text] = t1_test_delta_wal_and_write_plan_cache(arg(1))
    if not result_is_ok(outcome):
        say "yazabase-tier1-write-smoke: FAIL: " + result_unwrap_error(outcome)
        exit(1)
    say "yazabase-tier1-write-smoke: PASS"
