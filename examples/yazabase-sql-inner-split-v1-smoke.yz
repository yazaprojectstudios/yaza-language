use "std/fs"
use "../yazabase/checkpoint_v1"
use "../yazabase/catalog_init_v1"
use "../yazabase/catalog_snapshot_v1"
use "../yazabase/key_codec_v1"
use "../yazabase/page_v1"
use "../yazabase/row_v1"
use "../yazabase/sql_binder_v1"
use "../yazabase/sql_dispatch_v1"
use "../yazabase/sql_executor_v1"
use "../yazabase/storage_v1"
use "../yazabase/transaction_v1"
use "../yazabase/wal_v1"

shape YazaDbSqlInnerSplitSeedV1:
    next_key: Number

fn yazabase_sql_inner_split_key_v1(value: Number, columns: List[YazaSqlColumnSchemaV1]) -> Result[Bytes, Text]:
    let integer_value: YazaSqlValueV1 = yaza_sql_value_integer_v1(4, value)?
    let values: List[YazaSqlValueV1] = [integer_value]
    let nulls: List[Boolean] = [false]
    let key_ordinals: List[Number] = [0]
    return yaza_db_key_encode_composite_v1(values, nulls, columns, key_ordinals)

fn yazabase_sql_inner_split_row_v1(value: Number, columns: List[YazaSqlColumnSchemaV1], version_ts: Number) -> Result[Bytes, Text]:
    let integer_value: YazaSqlValueV1 = yaza_sql_value_integer_v1(4, value)?
    let values: List[YazaSqlValueV1] = [integer_value]
    let nulls: List[Boolean] = [false]
    return yaza_db_row_encode_v1(values, nulls, columns, version_ts)

fn yazabase_sql_inner_split_write_page_v1(storage: YazaDbStorageHandleV1, page: Bytes) -> Result[Boolean, Text]:
    let written: Number = yaza_db_storage_write_page_v1(storage.file, storage.header, page)?
    if written != yaza_db_page_size_v1(): return err("YDBv1 SQL inner-split fixture wrote an incomplete page")
    return ok(true)

fn yazabase_sql_inner_split_seed_tree_v1(storage: YazaDbStorageHandleV1, root_page_id: Number, columns: List[YazaSqlColumnSchemaV1], commit_ts: Number) -> Result[YazaDbSqlInnerSplitSeedV1, Text]:
    let parent_page_id: Number = 2048
    let first_leaf_page_id: Number = 2049
    let max_separator_count: Number = 1000
    let reserve_right_leaf_page_id: Number = first_leaf_page_id + max_separator_count + 2
    let empty: Bytes = bytes_from_text("")
    let root_separator: Bytes = yazabase_sql_inner_split_key_v1(1000000, columns)?
    let first_separator: Bytes = yazabase_sql_inner_split_key_v1(10000, columns)?

    # Reserve a page range away from the catalog and table-root allocations.
    let bitmap: Bytes = yaza_db_storage_read_page_v1(storage.file, storage.header, 2)?
    let bitmap_header: YazaDbPageHeaderV1 = yaza_db_page_header_decode_v1(bitmap, 2)?
    var reserved_page_id: Number = parent_page_id
    while reserved_page_id <= reserve_right_leaf_page_id:
        let address: YazaDbBitmapAddressV1 = yaza_db_bitmap_address_v1(reserved_page_id)?
        if address.bitmap_page_id != 2: return err("YDBv1 SQL inner-split fixture crossed its bootstrap bitmap range")
        let was_allocated: Boolean = yaza_db_bitmap_page_bit_v1(bitmap, address.bit_index, 2)?
        if was_allocated: return err("YDBv1 SQL inner-split fixture page range was already allocated")
        let claimed: Boolean = yaza_db_bitmap_page_set_allocated_v1(bitmap, address.bit_index, true, bitmap_header.page_lsn, 2)?
        if not claimed: return err("YDBv1 SQL inner-split fixture could not reserve its page range")
        set reserved_page_id = reserved_page_id + 1
    let bitmap_written: Number = yaza_db_storage_write_page_v1(storage.file, storage.header, bitmap)?
    if bitmap_written != yaza_db_page_size_v1(): return err("YDBv1 SQL inner-split fixture could not write its allocation bitmap")

    # Fill the first leaf with valid committed tuples until the page is full.
    let target_leaf_empty: Bytes = yaza_db_page_new_v1(first_leaf_page_id, 0, 1, 0)?
    let target_leaf_fenced: Bytes = yaza_db_page_set_fences_v1(target_leaf_empty, false, empty, true, first_separator)?
    var target_leaf: Bytes = target_leaf_fenced
    var next_key: Number = 0
    var target_leaf_full: Boolean = false
    while next_key < 1000 and not target_leaf_full:
        let key: Bytes = yazabase_sql_inner_split_key_v1(next_key, columns)?
        let row: Bytes = yazabase_sql_inner_split_row_v1(next_key, columns, commit_ts)?
        let added: Result[Number, Text] = yaza_db_page_add_slot_v1(target_leaf, key, row)
        if result_is_ok(added):
            set next_key = next_key + 1
        else:
            let message: Text = result_unwrap_error(added)
            if not text_starts_with(message, "YDBv1 page has insufficient free space") and not text_starts_with(message, "YDBv1 slot array is full"): return err("YDBv1 SQL inner-split fixture could not fill its target leaf: " + message)
            set target_leaf_full = true
    if not target_leaf_full or next_key < 2 or next_key >= 10000: return err("YDBv1 SQL inner-split fixture did not fill a safely searchable target leaf")
    let packed_target_leaf: Bytes = yaza_db_page_finalize_v1(target_leaf)?
    let target_written: Boolean = yazabase_sql_inner_split_write_page_v1(storage, packed_target_leaf)?
    if not target_written: return err("YDBv1 SQL inner-split fixture could not write its full target leaf")

    # Fill a non-root INNER page until another separator no longer fits.
    let parent_empty: Bytes = yaza_db_page_new_v1(parent_page_id, 0, 2, 1)?
    let parent_prefix: Bytes = bytes_try_slice(first_separator, 0, 8)?
    let parent_prefix_len: Number = yaza_db_page_set_prefix_v1(parent_empty, parent_prefix)?
    if parent_prefix_len != 8: return err("YDBv1 SQL inner-split fixture did not install the INNER key prefix")
    var parent: Bytes = parent_empty
    if not yaza_db_page_set_upper_v1(parent, first_leaf_page_id + max_separator_count): return err("YDBv1 SQL inner-split fixture could not initialize the INNER upper child")
    let first_child_pointer: Bytes = bytes_try_new_zeroed(8)?
    if not yaza_db_write_uint_le_v1(first_child_pointer, 0, first_leaf_page_id * 2, 8): return err("YDBv1 SQL inner-split fixture first child pointer could not be encoded")
    let first_inserted: Number = yaza_db_page_add_slot_v1(parent, first_separator, first_child_pointer)?
    if first_inserted != 0: return err("YDBv1 SQL inner-split fixture first separator was not installed")
    let parent_after_first: Bytes = yaza_db_page_finalize_v1(parent)?
    let parent_fenced: Bytes = yaza_db_page_set_fences_v1(parent_after_first, false, empty, true, root_separator)?
    set parent = parent_fenced
    var separator_index: Number = 1
    var parent_full: Boolean = false
    while separator_index < max_separator_count and not parent_full:
        let separator_value: Number = 10000 + separator_index * 32
        let separator: Bytes = yazabase_sql_inner_split_key_v1(separator_value, columns)?
        let child_page_id: Number = first_leaf_page_id + separator_index
        let child_pointer: Bytes = bytes_try_new_zeroed(8)?
        if not yaza_db_write_uint_le_v1(child_pointer, 0, child_page_id * 2, 8): return err("YDBv1 SQL inner-split fixture child pointer could not be encoded")
        let inserted_result: Result[Number, Text] = yaza_db_page_add_slot_v1(parent, separator, child_pointer)
        if result_is_ok(inserted_result):
            let inserted: Number = result_unwrap(inserted_result)
            if inserted != separator_index: return err("YDBv1 SQL inner-split fixture INNER separators are not ordered")
            set separator_index = separator_index + 1
        else:
            let insert_error: Text = result_unwrap_error(inserted_result)
            if not text_starts_with(insert_error, "YDBv1 page has insufficient free space") and not text_starts_with(insert_error, "YDBv1 slot array is full"): return err("YDBv1 SQL inner-split fixture could not fill its INNER page: " + insert_error)
            set parent_full = true
    if not parent_full or separator_index < 2 or separator_index >= max_separator_count: return err("YDBv1 SQL inner-split fixture did not fill its INNER parent")
    let separator_count: Number = separator_index
    let last_leaf_page_id: Number = first_leaf_page_id + separator_count
    let right_inner_page_id: Number = last_leaf_page_id + 1
    let right_leaf_page_id: Number = right_inner_page_id + 1
    if not yaza_db_page_set_upper_v1(parent, last_leaf_page_id): return err("YDBv1 SQL inner-split fixture could not set the INNER upper child")
    let fenced_parent: Bytes = yaza_db_page_finalize_v1(parent)?
    let parent_header: YazaDbPageHeaderV1 = yaza_db_page_header_decode_v1(fenced_parent, parent_page_id)?
    if parent_header.count != separator_count: return err("YDBv1 SQL inner-split fixture parent count changed while finalizing")
    let parent_written: Boolean = yazabase_sql_inner_split_write_page_v1(storage, fenced_parent)?
    if not parent_written: return err("YDBv1 SQL inner-split fixture could not write its full INNER page")

    # Seed empty fenced siblings. Child levels descend by exactly one.
    var leaf_index: Number = 1
    while leaf_index <= separator_count:
        let page_id: Number = first_leaf_page_id + leaf_index
        let low_fence: Bytes = yazabase_sql_inner_split_key_v1(10000 + (leaf_index - 1) * 32, columns)?
        var high_fence: Bytes = root_separator
        let has_high_fence: Boolean = true
        if leaf_index < separator_count:
            set high_fence = yazabase_sql_inner_split_key_v1(10000 + leaf_index * 32, columns)?
        let blank: Bytes = yaza_db_page_new_v1(page_id, 0, 1, 0)?
        let fenced: Bytes = yaza_db_page_set_fences_v1(blank, true, low_fence, has_high_fence, high_fence)?
        let written: Boolean = yazabase_sql_inner_split_write_page_v1(storage, fenced)?
        if not written: return err("YDBv1 SQL inner-split fixture could not write an empty leaf sibling")
        set leaf_index = leaf_index + 1

    let right_leaf_blank: Bytes = yaza_db_page_new_v1(right_leaf_page_id, 0, 1, 0)?
    let right_leaf: Bytes = yaza_db_page_set_fences_v1(right_leaf_blank, true, root_separator, false, empty)?
    let right_leaf_written: Boolean = yazabase_sql_inner_split_write_page_v1(storage, right_leaf)?
    if not right_leaf_written: return err("YDBv1 SQL inner-split fixture could not write the upper leaf")
    let right_inner_blank: Bytes = yaza_db_page_new_v1(right_inner_page_id, 0, 2, 1)?
    if not yaza_db_page_set_upper_v1(right_inner_blank, right_leaf_page_id): return err("YDBv1 SQL inner-split fixture could not set the root's upper child")
    let right_inner_packed: Bytes = yaza_db_page_finalize_v1(right_inner_blank)?
    let right_inner: Bytes = yaza_db_page_set_fences_v1(right_inner_packed, true, root_separator, false, empty)?
    let right_inner_written: Boolean = yazabase_sql_inner_split_write_page_v1(storage, right_inner)?
    if not right_inner_written: return err("YDBv1 SQL inner-split fixture could not write the root's upper INNER page")

    let root_blank: Bytes = yaza_db_page_new_v1(root_page_id, 0, 2, 2)?
    if not yaza_db_page_set_upper_v1(root_blank, right_inner_page_id): return err("YDBv1 SQL inner-split fixture could not set the table root's upper child")
    let parent_pointer: Bytes = bytes_try_new_zeroed(8)?
    if not yaza_db_write_uint_le_v1(parent_pointer, 0, parent_page_id * 2, 8): return err("YDBv1 SQL inner-split fixture table-root pointer could not be encoded")
    let root_slot: Number = yaza_db_page_add_slot_v1(root_blank, root_separator, parent_pointer)?
    if root_slot != 0: return err("YDBv1 SQL inner-split fixture table root did not receive its separator")
    let root_page: Bytes = yaza_db_page_finalize_v1(root_blank)?
    let root_written: Boolean = yazabase_sql_inner_split_write_page_v1(storage, root_page)?
    if not root_written: return err("YDBv1 SQL inner-split fixture could not write its table root")
    let synced: Boolean = sync(storage.file)?
    if not synced: return err("YDBv1 SQL inner-split fixture page seed could not sync")
    return ok(YazaDbSqlInnerSplitSeedV1(next_key))

fn yazabase_sql_inner_split_check_v1(root_path: Text) -> Result[Number, Text]:
    let root: Number = root_open(root_path)?
    let database_name: Text = "sql-inner-split-smoke.ydb"
    let db_uuid: Bytes = bytes_from_text("sql-dpsplit-0001")
    let initial_header: YazaDbFileHeaderV1 = YazaDbFileHeaderV1(db_uuid, 0, 1, 1, 0, 2, 1)
    let empty_storage: YazaDbStorageHandleV1 = yaza_db_storage_create_empty_v1(root, database_name, initial_header)?
    let empty_closed: Boolean = yaza_db_storage_close_v1(empty_storage)?
    if not empty_closed: return err("YDBv1 SQL inner-split fixture could not close its empty database")
    let initialized: YazaDbCatalogBootstrapV1 = yaza_db_catalog_initialize_v1(root, database_name)?
    let no_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let create_result: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(initialized.storage, initialized.wal, "CREATE TABLE deep_rows (id BIGINT PRIMARY KEY)", no_parameters)?
    if create_result.statement_kind != yaza_db_sql_statement_kind_create_table_v1() or not option_is_some(create_result.write_commit): return err("YDBv1 SQL inner-split fixture could not create its table")
    let created: YazaDbWriteCommitV1 = option_unwrap(create_result.write_commit)
    let catalog: YazaDbCatalogSnapshotWithRootsV1 = yaza_db_catalog_snapshot_load_with_roots_v1(created.storage.file, created.storage.header)?
    let table_index: Number = list_count(catalog.sql_snapshot.tables) - 1
    if table_index < 4 or table_index >= list_count(catalog.root_page_ids): return err("YDBv1 SQL inner-split fixture could not find its new table")
    let table: YazaSqlTableSchemaV1 = list_get(catalog.sql_snapshot.tables, table_index)
    if table.name != "deep_rows" or list_count(table.columns) != 1: return err("YDBv1 SQL inner-split fixture loaded the wrong schema")
    let table_root_page_id: Number = list_get(catalog.root_page_ids, table_index)
    let seeded: YazaDbSqlInnerSplitSeedV1 = yazabase_sql_inner_split_seed_tree_v1(created.storage, table_root_page_id, table.columns, created.commit_ts)?
    let target_id: Number = seeded.next_key
    let insert_source: Text = "INSERT INTO deep_rows VALUES (" + number_text(target_id) + ")"
    let insert_result: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(created.storage, created.wal, insert_source, no_parameters)?
    if insert_result.statement_kind != yaza_db_sql_statement_kind_insert_v1() or not option_is_some(insert_result.write_commit): return err("YDBv1 SQL inner-split fixture did not commit its catalog INSERT")
    let inserted: YazaDbWriteCommitV1 = option_unwrap(insert_result.write_commit)
    let root_after: Bytes = yaza_db_storage_read_page_v1(inserted.storage.file, inserted.storage.header, table_root_page_id)?
    let root_after_header: YazaDbPageHeaderV1 = yaza_db_page_header_decode_v1(root_after, table_root_page_id)?
    if root_after_header.page_type != 2 or root_after_header.level != 2 or root_after_header.count != 2: return err("YDBv1 catalog INSERT did not split its full non-root parent into the table root")
    let inserted_wal_closed: Boolean = yaza_db_wal_log_close_v1(inserted.wal)?
    let inserted_storage_closed: Boolean = yaza_db_storage_close_v1(inserted.storage)?
    if not inserted_wal_closed or not inserted_storage_closed: return err("YDBv1 SQL inner-split writer handles did not close")

    let recovered: YazaDbCheckpointRecoveryV1 = yaza_db_open_recovered_v1(root, database_name)?
    let select_source: Text = "SELECT id FROM deep_rows WHERE id = " + number_text(target_id)
    let selected_result: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(recovered.storage, recovered.wal, select_source, no_parameters)?
    if not option_is_some(selected_result.query_result): return err("YDBv1 SQL inner-split fixture did not return its recovered SELECT")
    let selected: YazaSqlQueryResultV1 = option_unwrap(selected_result.query_result)
    if list_count(selected.rows) != 1 or list_get(list_get(selected.rows, 0), 0).integer_value != target_id: return err("YDBv1 catalog INSERT row did not survive recursive split recovery")
    let final_wal_closed: Boolean = yaza_db_wal_log_close_v1(selected_result.wal)?
    let final_storage_closed: Boolean = yaza_db_storage_close_v1(selected_result.storage)?
    if not final_wal_closed or not final_storage_closed: return err("YDBv1 SQL inner-split recovered handles did not close")
    let removed: Boolean = remove(root, database_name)?
    if not removed: return err("YDBv1 SQL inner-split fixture could not remove its database")
    let synced: Boolean = sync_directory(root)?
    if not synced: return err("YDBv1 SQL inner-split fixture cleanup sync failed")
    let root_closed: Boolean = close(root)?
    if not root_closed: return err("YDBv1 SQL inner-split fixture root did not close")
    return ok(target_id)

start:
    let outcome: Result[Number, Text] = yazabase_sql_inner_split_check_v1(arg(1))
    if result_is_ok(outcome):
        say "yazabase-sql-inner-split-v1-ok id=" + number_text(result_unwrap(outcome))
    else:
        say result_unwrap_error(outcome)
