use "../yazabase/sql_parser_v2"

fn yaza_base_sql_parser_v2_smoke() -> Boolean:
    let source: Text = "SELECT DISTINCT p.id AS product_id, p.name AS \"display name\", p.* FROM catalog.products AS p WHERE p.price >= :floor ORDER BY p.price DESC, p.id ASC LIMIT 25;"
    let parsed: Result[YazaSqlSelectAstV2, Text] = yaza_sql_parse_select_v2(source)
    if not result_is_ok(parsed): return false
    let query: YazaSqlSelectAstV2 = result_unwrap(parsed)
    if query.version != 2 or not query.distinct: return false
    if query.start_byte != 0 or query.end_byte != text_length(source): return false
    if list_count(query.projections) != 3: return false

    let first_projection: YazaSqlProjectionV2 = list_get(query.projections, 0)
    if first_projection.name.part_count != 2 or first_projection.name.wildcard: return false
    if text_slice(source, first_projection.name.first_token.start_byte, first_projection.name.first_token.end_byte - first_projection.name.first_token.start_byte) != "p": return false
    if text_slice(source, first_projection.name.second_token.start_byte, first_projection.name.second_token.end_byte - first_projection.name.second_token.start_byte) != "id": return false
    if not first_projection.has_alias: return false
    if text_slice(source, first_projection.alias.start_byte, first_projection.alias.end_byte - first_projection.alias.start_byte) != "product_id": return false

    let second_projection: YazaSqlProjectionV2 = list_get(query.projections, 1)
    if second_projection.name.part_count != 2 or not second_projection.has_alias: return false
    if text_slice(source, second_projection.alias.start_byte, second_projection.alias.end_byte - second_projection.alias.start_byte) != "\"display name\"": return false

    let third_projection: YazaSqlProjectionV2 = list_get(query.projections, 2)
    if third_projection.name.part_count != 1 or not third_projection.name.wildcard or third_projection.has_alias: return false
    if text_slice(source, third_projection.name.first_token.start_byte, third_projection.name.first_token.end_byte - third_projection.name.first_token.start_byte) != "p": return false

    if query.table_name.part_count != 2 or query.has_table_alias == false: return false
    if text_slice(source, query.table_name.first_token.start_byte, query.table_name.first_token.end_byte - query.table_name.first_token.start_byte) != "catalog": return false
    if text_slice(source, query.table_name.second_token.start_byte, query.table_name.second_token.end_byte - query.table_name.second_token.start_byte) != "products": return false
    if text_slice(source, query.table_alias.start_byte, query.table_alias.end_byte - query.table_alias.start_byte) != "p": return false

    if not query.has_where or query.where_operator != 6 or query.where_value.kind != 5: return false
    if query.where_column.part_count != 2: return false
    if text_slice(source, query.where_column.second_token.start_byte, query.where_column.second_token.end_byte - query.where_column.second_token.start_byte) != "price": return false
    if text_slice(source, query.where_value.start_byte, query.where_value.end_byte - query.where_value.start_byte) != ":floor": return false

    if list_count(query.order_by) != 2: return false
    let first_order: YazaSqlOrderTermV2 = list_get(query.order_by, 0)
    let second_order: YazaSqlOrderTermV2 = list_get(query.order_by, 1)
    if first_order.name.part_count != 2 or not first_order.descending: return false
    if second_order.name.part_count != 2 or second_order.descending: return false
    if query.limit != 25 or not query.has_limit: return false

    let bare_star: Result[YazaSqlSelectAstV2, Text] = yaza_sql_parse_select_v2("select * from users")
    if not result_is_ok(bare_star): return false
    let bare_query: YazaSqlSelectAstV2 = result_unwrap(bare_star)
    let bare_projection: YazaSqlProjectionV2 = list_get(bare_query.projections, 0)
    if not bare_projection.name.wildcard: return false
    let lowercase: Result[YazaSqlSelectAstV2, Text] = yaza_sql_parse_select_v2("select u.* from users as u")
    if not result_is_ok(lowercase): return false
    let lowercase_query: YazaSqlSelectAstV2 = result_unwrap(lowercase)
    let qualified_star: YazaSqlProjectionV2 = list_get(lowercase_query.projections, 0)
    if not qualified_star.name.wildcard: return false

    let too_many_parts: Result[YazaSqlSelectAstV2, Text] = yaza_sql_parse_select_v2("SELECT a.b.c.d FROM t")
    if result_is_ok(too_many_parts): return false
    let three_parts: Result[YazaSqlSelectAstV2, Text] = yaza_sql_parse_select_v2("SELECT db.schema.column FROM t")
    if not result_is_ok(three_parts): return false
    let three_parts_query: YazaSqlSelectAstV2 = result_unwrap(three_parts)
    let three_parts_projection: YazaSqlProjectionV2 = list_get(three_parts_query.projections, 0)
    if three_parts_projection.name.part_count != 3: return false
    let missing_part: Result[YazaSqlSelectAstV2, Text] = yaza_sql_parse_select_v2("SELECT a..b FROM t")
    if result_is_ok(missing_part): return false
    let bare_alias: Result[YazaSqlSelectAstV2, Text] = yaza_sql_parse_select_v2("SELECT a item FROM t")
    if result_is_ok(bare_alias): return false
    let missing_projection_alias: Result[YazaSqlSelectAstV2, Text] = yaza_sql_parse_select_v2("SELECT a AS FROM t")
    if result_is_ok(missing_projection_alias): return false
    let missing_table_alias: Result[YazaSqlSelectAstV2, Text] = yaza_sql_parse_select_v2("SELECT a FROM t AS")
    if result_is_ok(missing_table_alias): return false
    let multiple_statements: Result[YazaSqlSelectAstV2, Text] = yaza_sql_parse_select_v2("SELECT a FROM t; DELETE FROM t")
    if result_is_ok(multiple_statements): return false
    return true

start:
    let initial_used: Number = arena_used()
    arena_scope 65536:
        assert yaza_base_sql_parser_v2_smoke()
    assert arena_used() == initial_used
    say "yazabase-sql-parser-v2-ok"
