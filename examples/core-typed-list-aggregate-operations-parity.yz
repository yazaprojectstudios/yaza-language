shape Product:
    id: Number
    name: Text

variant Lookup:
    Missing
    Found(product: Product)

fn make_inner_values(first: Number, second: Number) -> List[Number]:
    var values: List[Number] = List[Number]()
    list_push(values, first)
    list_push(values, second)
    return values

start:
    var products: List[Product] = List[Product]()
    assert list_try_push(products, Product(7, "first"))
    assert list_try_push(products, Product(9, "second"))
    assert list_count(products) == 2
    list_set(products, 1, Product(11, "updated"))
    let maybe_product: Option[Product] = list_try_get(products, 1)
    assert option_is_some(maybe_product)
    assert list_get(products, 0).id == 7
    assert option_unwrap(maybe_product).name == "updated"
    assert not option_is_some(list_try_get(products, 2))

    var lookups: List[Lookup] = List[Lookup]()
    assert list_try_push(lookups, Lookup::Missing)
    assert list_try_push(lookups, Lookup::Found(Product(13, "found")))
    list_set(lookups, 0, Lookup::Found(Product(17, "replaced")))
    let maybe_lookup: Option[Lookup] = list_try_get(lookups, 0)
    assert option_is_some(maybe_lookup)
    let selected: Lookup = list_get(lookups, 0)
    match selected:
        Missing:
            assert false
        Found(product):
            assert product.id == 17
    let selected_option: Lookup = option_unwrap(maybe_lookup)
    match selected_option:
        Missing:
            assert false
        Found(product):
            assert product.id == 17

    var option_values: List[Option[Number]] = List[Option[Number]]()
    assert list_try_push(option_values, some(23))
    assert list_try_push(option_values, some(29))
    list_set(option_values, 1, some(31))
    let maybe_option: Option[Option[Number]] = list_try_get(option_values, 1)
    assert option_is_some(maybe_option)
    assert option_unwrap(option_unwrap(maybe_option)) == 31

    var result_values: List[Result[Number, Text]] = List[Result[Number, Text]]()
    assert list_try_push(result_values, ok(37))
    assert list_try_push(result_values, err("initial"))
    list_set(result_values, 1, err("updated"))
    let maybe_result: Option[Result[Number, Text]] = list_try_get(result_values, 1)
    assert option_is_some(maybe_result)
    assert result_unwrap_error(option_unwrap(maybe_result)) == "updated"
    assert result_unwrap(list_get(result_values, 0)) == 37

    var nested_values: List[List[Number]] = List[List[Number]]()
    assert list_try_push(nested_values, make_inner_values(41, 42))
    assert list_try_push(nested_values, make_inner_values(43, 44))
    list_set(nested_values, 1, make_inner_values(47, 48))
    let maybe_nested: Option[List[Number]] = list_try_get(nested_values, 1)
    assert option_is_some(maybe_nested)
    assert list_get(option_unwrap(maybe_nested), 1) == 48
    assert list_get(list_get(nested_values, 0), 0) == 41
    assert not option_is_some(list_try_get(nested_values, 2))

    say "typed-list-aggregate-operations-ok"
