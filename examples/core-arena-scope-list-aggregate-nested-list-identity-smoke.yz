shape Bucket:
    values: List[Bytes]

start:
    let parent_bytes: Bytes = bytes_from_text("parent-safe")
    let output: List[Bytes] = List[Bytes]()
    arena_scope 4096:
        let parent_bucket: Bucket = Bucket(List[Bytes]())
        let child_bucket: Bucket = Bucket(List[Bytes]())
        let child_bytes: Bytes = bytes_from_text("child")
        list_push(parent_bucket.values, parent_bytes)
        list_push(child_bucket.values, child_bytes)
        let buckets: List[Bucket] = List[Bucket]()
        list_push(buckets, parent_bucket)
        list_push(buckets, child_bucket)
        let selected_bucket: Bucket = list_get(buckets, 0)
        let safe_value: Bytes = list_get(selected_bucket.values, 0)
        list_push(output, safe_value)
    say bytes_to_text(list_get(output, 0))
