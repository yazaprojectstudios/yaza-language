use "std/net"

start:
    let s1_res: Result[Number, Text] = tcp_pair_create()
    if not result_is_ok(s1_res):
        say "FAIL pair_create: " + result_unwrap_error(s1_res)
        exit(1)
    let s1: Number = result_unwrap(s1_res)

    let s2_res: Result[Number, Text] = tcp_pair_peer(s1)
    if not result_is_ok(s2_res):
        say "FAIL pair_peer: " + result_unwrap_error(s2_res)
        exit(1)
    let s2: Number = result_unwrap(s2_res)

    let msg: Bytes = bytes_from_text("hello-socket-pair")
    let w_res: Result[Number, Text] = tcp_write(s1, msg, 1000)
    if not result_is_ok(w_res):
        say "FAIL write: " + result_unwrap_error(w_res)
        exit(1)
    say "WROTE BYTES: " + number_text(result_unwrap(w_res))

    let r_res: Result[Bytes, Text] = tcp_read(s2, 1024, 1000)
    if not result_is_ok(r_res):
        say "FAIL read: " + result_unwrap_error(r_res)
        exit(1)
    let read_msg: Bytes = result_unwrap(r_res)
    say "READ MSG: " + bytes_to_text(read_msg)

    let c1: Result[Boolean, Text] = tcp_close(s1)
    let c2: Result[Boolean, Text] = tcp_close(s2)
    if not result_is_ok(c1) or not result_is_ok(c2):
        say "FAIL close"
        exit(1)
    say "PAIR SMOKE PASS"
