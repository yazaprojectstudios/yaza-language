        return err("YDBv1 correlated NOT EXISTS did not retain the unmatched outer row")
    let correlated_snapshot: YazaSqlQueryResultV1 = yaza_db_execute_select_at_snapshot_v1(right_commit.storage, right_commit.wal, "SELECT i.id FROM items AS i WHERE EXISTS (SELECT p.user_id FROM profiles AS p WHERE p.user_id = i.id) ORDER BY i.id", no_parameters, right_commit.commit_ts, 0, List[YazaDbTxnStatusV1]())?
    if list_count(correlated_snapshot.rows) != 2 or list_get(list_get(correlated_snapshot.rows, 1), 0).integer_value != 2:
        return err("YDBv1 correlated EXISTS returned incorrect rows at a historical snapshot")
    if result_is_ok(yaza_db_execute_statement_v1(right_commit.storage, right_commit.wal, "SELECT i.id FROM items AS i WHERE EXISTS (SELECT p.user_id FROM profiles AS p INNER JOIN items AS j ON p.user_id = j.id INNER JOIN profiles AS q ON q.user_id = j.id WHERE j.id = i.id)", no_parameters)):
        return err("YDBv1 binder accepted a correlated EXISTS subquery containing a JOIN as uncorrelated")
    if result_is_ok(yaza_db_execute_statement_v1(right_commit.storage, right_commit.wal, "SELECT id FROM items WHERE EXISTS (SELECT user_id FROM profiles WHERE user_id = $1)", no_parameters)):
        return err("YDBv1 binder accepted a bind parameter inside an EXISTS subquery")
    var depth_eight_query: Text = "SELECT id FROM items"
    var nested_level: Number = 0
    while nested_level < 8:
        set depth_eight_query = "SELECT id FROM items WHERE EXISTS (" + depth_eight_query + ")"
        set nested_level = nested_level + 1
    let depth_eight_result: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(right_commit.storage, right_commit.wal, depth_eight_query, no_parameters)?
    if not option_is_some(depth_eight_result.query_result) or list_count(option_unwrap(depth_eight_result.query_result).rows) != 3:
        return err("YDBv1 binder or executor rejected the supported eight-level subquery depth")
    set depth_eight_query = "SELECT id FROM items WHERE EXISTS (" + depth_eight_query + ")"
    if result_is_ok(yaza_db_execute_statement_v1(right_commit.storage, right_commit.wal, depth_eight_query, no_parameters)):
        return err("YDBv1 binder accepted a subquery deeper than its eight-level bound")
    let historical_in_subquery: YazaSqlQueryResultV1 = yaza_db_execute_select_at_snapshot_v1(right_commit.storage, right_commit.wal, "SELECT id FROM items WHERE id IN (SELECT user_id FROM profiles)", no_parameters, left_commit.commit_ts, 0, List[YazaDbTxnStatusV1]())?
    if list_count(historical_in_subquery.rows) != 0:
        return err("YDBv1 historical IN subquery observed rows newer than its snapshot")
    let historical_nested_exists: YazaSqlQueryResultV1 = yaza_db_execute_select_at_snapshot_v1(right_commit.storage, right_commit.wal, "SELECT id FROM items WHERE EXISTS (SELECT user_id FROM profiles WHERE EXISTS (SELECT id FROM items WHERE id = 1))", no_parameters, left_commit.commit_ts, 0, List[YazaDbTxnStatusV1]())?
    if list_count(historical_nested_exists.rows) != 0:
        return err("YDBv1 historical nested EXISTS observed rows newer than its snapshot")
    let historical_joined_in_subquery: YazaSqlQueryResultV1 = yaza_db_execute_select_at_snapshot_v1(right_commit.storage, right_commit.wal, "SELECT id FROM items WHERE id IN (SELECT p.user_id FROM profiles AS p INNER JOIN items AS i ON p.user_id = i.id INNER JOIN profiles AS q ON q.user_id = i.id)", no_parameters, right_commit.commit_ts, 0, List[YazaDbTxnStatusV1]())?
    if list_count(historical_joined_in_subquery.rows) != 2:
        return err("YDBv1 historical IN subquery with a JOIN returned incorrect snapshot rows")
    let historical_exists: YazaSqlQueryResultV1 = yaza_db_execute_select_at_snapshot_v1(right_commit.storage, right_commit.wal, "SELECT id FROM items WHERE EXISTS (SELECT user_id FROM profiles)", no_parameters, left_commit.commit_ts, 0, List[YazaDbTxnStatusV1]())?
    if list_count(historical_exists.rows) != 0:
        return err("YDBv1 historical EXISTS observed rows newer than its snapshot")
    let historical_exists_visible: YazaSqlQueryResultV1 = yaza_db_execute_select_at_snapshot_v1(right_commit.storage, right_commit.wal, "SELECT id FROM items WHERE EXISTS (SELECT user_id FROM profiles)", no_parameters, right_commit.commit_ts, 0, List[YazaDbTxnStatusV1]())?
    if list_count(historical_exists_visible.rows) != 3:
        return err("YDBv1 historical EXISTS omitted rows visible at its snapshot")
    let historical_joined_exists: YazaSqlQueryResultV1 = yaza_db_execute_select_at_snapshot_v1(right_commit.storage, right_commit.wal, "SELECT id FROM items WHERE EXISTS (SELECT p.user_id FROM profiles AS p INNER JOIN items AS i ON p.user_id = i.id INNER JOIN profiles AS q ON q.user_id = i.id)", no_parameters, right_commit.commit_ts, 0, List[YazaDbTxnStatusV1]())?
    if list_count(historical_joined_exists.rows) != 3:
        return err("YDBv1 historical EXISTS subquery with a JOIN omitted rows visible at its snapshot")

    let left_where_source: Text = "SELECT i.id, p.note FROM items AS i LEFT JOIN profiles AS p ON i.id = p.user_id WHERE p.note = 'alpha'"
    let left_where_statement: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(right_commit.storage, right_commit.wal, left_where_source, no_parameters)?
    if not option_is_some(left_where_statement.query_result): return err("YDBv1 LEFT JOIN WHERE query did not return a result")
    let left_where: YazaSqlQueryResultV1 = option_unwrap(left_where_statement.query_result)
    if list_count(left_where.rows) != 1: return err("YDBv1 LEFT JOIN WHERE predicate did not filter null-extended rows using SQL NULL semantics")

    let empty_right_snapshot: YazaSqlQueryResultV1 = yaza_db_execute_select_at_snapshot_v1(left_commit.storage, left_commit.wal, left_source, no_parameters, left_commit.commit_ts, 0, List[YazaDbTxnStatusV1]())?
    if list_count(empty_right_snapshot.rows) != 3: return err("YDBv1 historical LEFT JOIN did not preserve left rows when the right table was empty")
    var empty_right_nulls: Number = 0
    var empty_row_index: Number = 0
    while empty_row_index < list_count(empty_right_snapshot.rows):
        if list_get(list_get(empty_right_snapshot.rows, empty_row_index), 1).is_null: set empty_right_nulls = empty_right_nulls + 1
        set empty_row_index = empty_row_index + 1
    if empty_right_nulls != 3: return err("YDBv1 historical LEFT JOIN did not null-extend every row for an empty right input")

    let empty_at_snapshot: YazaSqlQueryResultV1 = yaza_db_execute_select_at_snapshot_v1(right_commit.storage, right_commit.wal, source, no_parameters, left_commit.commit_ts, 0, List[YazaDbTxnStatusV1]())?
    if list_count(empty_at_snapshot.rows) != 0: return err("YDBv1 historical INNER JOIN exposed rows from after its snapshot")
    let visible_at_snapshot: YazaSqlQueryResultV1 = yaza_db_execute_select_at_snapshot_v1(right_commit.storage, right_commit.wal, source, no_parameters, right_commit.commit_ts, 0, List[YazaDbTxnStatusV1]())?
    if list_count(visible_at_snapshot.rows) != 3: return err("YDBv1 historical INNER JOIN did not see rows committed by its snapshot")

    let query_closed: Boolean = yaza_db_wal_log_close_v1(selected.wal)?
    let storage_closed: Boolean = yaza_db_storage_close_v1(selected.storage)?
    if not query_closed or not storage_closed: return err("YDBv1 JOIN fixture could not close its database handles")
    let recovered: YazaDbCheckpointRecoveryV1 = yaza_db_open_recovered_v1(root, db_name)?
    let reopened: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(recovered.storage, recovered.wal, source, no_parameters)?
    if not option_is_some(reopened.query_result) or list_count(option_unwrap(reopened.query_result).rows) != 3:
        return err("YDBv1 INNER JOIN did not survive close and reopen")
    let reopened_left: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(reopened.storage, reopened.wal, left_source, no_parameters)?
    if not option_is_some(reopened_left.query_result) or list_count(option_unwrap(reopened_left.query_result).rows) != 4:
        return err("YDBv1 LEFT JOIN did not survive close and reopen")
    let reopened_right: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(reopened.storage, reopened.wal, right_source, no_parameters)?
    if not option_is_some(reopened_right.query_result) or list_count(option_unwrap(reopened_right.query_result).rows) != 5:
        return err("YDBv1 RIGHT JOIN did not survive close and reopen")
    let cross_source: Text = "SELECT i.id, p.note FROM items AS i CROSS JOIN profiles AS p"
    let reopened_cross: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(reopened.storage, reopened.wal, cross_source, no_parameters)?
    if not option_is_some(reopened_cross.query_result) or list_count(option_unwrap(reopened_cross.query_result).rows) != 15:
        return err("YDBv1 CROSS JOIN did not return the persisted Cartesian product")
    let cross_explain: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(reopened.storage, reopened.wal, "EXPLAIN SELECT i.id, p.note FROM items AS i CROSS JOIN profiles AS p", no_parameters)?
    if not option_is_some(cross_explain.explain_text) or text_find(option_unwrap(cross_explain.explain_text), "CrossJoin(table_id=") < 0:
        return err("YDBv1 EXPLAIN did not report CROSS JOIN")
    let theta_source: Text = "SELECT i.id, p.user_id FROM items AS i JOIN profiles AS p ON i.id < p.user_id"
    let reopened_theta: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(reopened.storage, reopened.wal, theta_source, no_parameters)?
    if not option_is_some(reopened_theta.query_result) or list_count(option_unwrap(reopened_theta.query_result).rows) != 4:
        return err("YDBv1 theta JOIN returned an incorrect persistent result")
    var theta_row_index: Number = 0
    while theta_row_index < list_count(option_unwrap(reopened_theta.query_result).rows):
        let theta_row: List[YazaSqlValueV1] = list_get(option_unwrap(reopened_theta.query_result).rows, theta_row_index)
        if list_get(theta_row, 0).integer_value >= list_get(theta_row, 1).integer_value or list_get(theta_row, 1).is_null:
            return err("YDBv1 theta JOIN returned a false match or matched a NULL key")
        set theta_row_index = theta_row_index + 1
    let theta_explain: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(reopened.storage, reopened.wal, "EXPLAIN SELECT i.id, p.user_id FROM items AS i JOIN profiles AS p ON i.id < p.user_id", no_parameters)?
    if not option_is_some(theta_explain.explain_text) or text_find(option_unwrap(theta_explain.explain_text), "ThetaJoin(table_id=") < 0 or text_find(option_unwrap(theta_explain.explain_text), "predicate=<") < 0:
        return err("YDBv1 EXPLAIN did not report the theta JOIN predicate")
    let right_explain: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(reopened.storage, reopened.wal, "EXPLAIN SELECT i.id, p.note FROM items AS i RIGHT JOIN profiles AS p ON i.id = p.user_id", no_parameters)?
    if not option_is_some(right_explain.explain_text) or text_find(option_unwrap(right_explain.explain_text), "RightJoin(normalized_to_left") < 0:
        return err("YDBv1 EXPLAIN did not report RIGHT JOIN normalization")
    let full_explain: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(reopened.storage, reopened.wal, "EXPLAIN SELECT i.id, p.note FROM items AS i FULL JOIN profiles AS p ON i.id = p.user_id", no_parameters)?
    if not option_is_some(full_explain.explain_text) or text_find(option_unwrap(full_explain.explain_text), "FullJoin(table_id=") < 0:
        return err("YDBv1 EXPLAIN did not report FULL JOIN")
    let reopened_wal_closed: Boolean = yaza_db_wal_log_close_v1(reopened.wal)?
    let reopened_storage_closed: Boolean = yaza_db_storage_close_v1(reopened.storage)?
    if not reopened_wal_closed or not reopened_storage_closed: return err("YDBv1 reopened JOIN fixture handles did not close")
    let root_closed: Boolean = close(root)?
    if not root_closed: return err("YDBv1 JOIN fixture root did not close")
    return ok(true)

start:
    let outcome: Result[Boolean, Text] = yazabase_sql_inner_join_persist_v1(arg(1))
    if not result_is_ok(outcome): say result_unwrap_error(outcome)
    elif result_unwrap(outcome): say "yazabase-sql-inner-join-persist-v1-ok"
    else: say "YDBv1 JOIN fixture returned false"
