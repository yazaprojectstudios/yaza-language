use "std/db/core"
use "std/mysql/protocol"
use "std/db/mysql"

start:
    # 1. Setup column definitions
    let col_id: MysqlColumnDefinition = MysqlColumnDefinition("def", "app", "users", "users", "id", "id", 63, 11, 3, 0, 0)
    let col_name: MysqlColumnDefinition = MysqlColumnDefinition("def", "app", "users", "users", "name", "name", 45, 255, 253, 0, 0)
    let col_salary: MysqlColumnDefinition = MysqlColumnDefinition("def", "app", "users", "users", "salary", "salary", 63, 15, 246, 0, 2)
    let col_active: MysqlColumnDefinition = MysqlColumnDefinition("def", "app", "users", "users", "active", "active", 63, 1, 1, 0, 0)
    let col_created: MysqlColumnDefinition = MysqlColumnDefinition("def", "app", "users", "users", "created_at", "created_at", 63, 19, 12, 0, 0)

    let columns: List[MysqlColumnDefinition] = List[MysqlColumnDefinition]()
    list_push(columns, col_id)
    list_push(columns, col_name)
    list_push(columns, col_salary)
    list_push(columns, col_active)
    list_push(columns, col_created)

    # 2. Setup row data
    let cell_vals: TextList = text_list()
    let null_flags: TextList = text_list()
    list_push(cell_vals, "101")
    list_push(null_flags, "false")
    list_push(cell_vals, "Alice")
    list_push(null_flags, "false")
    list_push(cell_vals, "75000.50")
    list_push(null_flags, "false")
    list_push(cell_vals, "1")
    list_push(null_flags, "false")
    list_push(cell_vals, "2026-11-16 11:30:00")
    list_push(null_flags, "false")
    let row1: MysqlRow = MysqlRow(cell_vals, null_flags)

    # 3. Decode row to DbRow
    let db_row_res: Result[DbRow, DbError] = db_mysql_row_to_dbrow(columns, row1)
    assert result_is_ok(db_row_res)
    let db_row: DbRow = result_unwrap(db_row_res)
    assert list_count(db_row.columns) == 5

    # Check ID is Int32
    let val_id: DbValue = list_get(db_row.columns, 0).value
    assert option_is_some(db_value_as_int32(val_id))
    assert int32_text(option_unwrap(db_value_as_int32(val_id))) == "101"

    # Check Name is Text
    let val_name: DbValue = list_get(db_row.columns, 1).value
    assert option_is_some(db_value_as_text(val_name))
    assert option_unwrap(db_value_as_text(val_name)) == "Alice"

    # Check Salary is Decimal
    let val_salary: DbValue = list_get(db_row.columns, 2).value
    assert option_is_some(db_value_as_decimal(val_salary))
    assert option_unwrap(db_value_as_decimal(val_salary)) == "75000.50"

    # Check Active is Int32
    let val_active: DbValue = list_get(db_row.columns, 3).value
    assert option_is_some(db_value_as_int32(val_active))
    assert int32_text(option_unwrap(db_value_as_int32(val_active))) == "1"

    # Check Created is Timestamp
    let val_created: DbValue = list_get(db_row.columns, 4).value
    assert option_is_some(db_value_as_temporal_text(val_created))
    assert option_unwrap(db_value_as_temporal_text(val_created)) == "2026-11-16 11:30:00"

    # 4. Null column test
    let cell_vals_null: TextList = text_list()
    let null_flags_null: TextList = text_list()
    list_push(cell_vals_null, "")
    list_push(null_flags_null, "true")
    list_push(cell_vals_null, "")
    list_push(null_flags_null, "true")
    list_push(cell_vals_null, "")
    list_push(null_flags_null, "true")
    list_push(cell_vals_null, "")
    list_push(null_flags_null, "true")
    list_push(cell_vals_null, "")
    list_push(null_flags_null, "true")
    let row_null: MysqlRow = MysqlRow(cell_vals_null, null_flags_null)

    let db_row_null_res: Result[DbRow, DbError] = db_mysql_row_to_dbrow(columns, row_null)
    assert result_is_ok(db_row_null_res)
    let db_row_null: DbRow = result_unwrap(db_row_null_res)
    assert db_value_is_null(list_get(db_row_null.columns, 0).value)
    assert db_value_is_null(list_get(db_row_null.columns, 1).value)
    assert db_value_is_null(list_get(db_row_null.columns, 2).value)
