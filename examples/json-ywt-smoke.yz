use "std/json"
use "std/http"
use "std/ywt"

start:
    # 1. JSON test
    let obj: Text = "{\"name\": \"yaza\", \"count\": 42}"
    let name_opt: Option[Text] = json_extract_string(obj, "name")
    if not option_is_some(name_opt): fail("json: name not found")
    if option_unwrap(name_opt) != "yaza": fail("json: name mismatch")
    say "JSON name: " + option_unwrap(name_opt)

    let count_opt: Option[Number] = json_extract_number(obj, "count")
    if not option_is_some(count_opt): fail("json: count not found")
    if option_unwrap(count_opt) != 42: fail("json: count mismatch")
    say "JSON count: " + number_text(option_unwrap(count_opt))

    # 2. YWT test
    let secret: Text = "super-secret-key-for-yaza-smoke-32-bytes-min"
    let token: Text = ywt_create("admin", "yazabase", 5000, secret)
    say "YWT token: " + token
    let verified: Result[Text, Text] = ywt_verify(token, "yazabase", 1000, secret)
    if not result_is_ok(verified): fail("ywt: verify failed: " + result_unwrap_error(verified))
    say "YWT verified sub: " + result_unwrap(verified)

    # 3. HTTP parse test
    let raw_http: Text = "POST /api/v1/sql HTTP/1.1\r\nHost: localhost\r\nAccept: application/json\r\nContent-Type: application/json\r\nContent-Length: 18\r\n\r\n{\"sql\":\"SELECT 1\"}"
    let req_res: Result[HttpRequest, Text] = http_parse_request(bytes_from_text(raw_http))
    if not result_is_ok(req_res): fail("http: parse failed: " + result_unwrap_error(req_res))
    let req: HttpRequest = result_unwrap(req_res)
    say "HTTP method: " + req.method
    say "HTTP path: " + req.path
    say "HTTP accept: " + req.accept
    say "HTTP body: " + req.body_text
    say "JSON-YWT-HTTP SMOKE PASS"
