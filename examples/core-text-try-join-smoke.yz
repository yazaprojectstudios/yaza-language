fn join_values(values: TextList, separator: Text) -> Result[Text,Text]:
    return text_try_join(values, separator)

start:
    let values: TextList = text_list()
    list_push(values, "alpha")
    list_push(values, "beta")
    let joined: Result[Text,Text] = join_values(values, "::")
    assert result_is_ok(joined)
    assert result_unwrap(joined) == "alpha::beta"

    let empty_values: TextList = text_list()
    let empty_join: Result[Text,Text] = text_try_join(empty_values, ",")
    assert result_is_ok(empty_join)
    assert result_unwrap(empty_join) == ""
    say "fallible-text-join-ok"
