use "../yazabase/page_v1"
use "../yazabase/page_wal_v1"
use "../yazabase/wal_v1"

fn yaza_base_page_wal_v1_check() -> Result[Number, Text]:
    let key_a: Bytes = bytes_from_text("a")
    let key_b: Bytes = bytes_from_text("b")
    let key_c: Bytes = bytes_from_text("c")
    let key_d: Bytes = bytes_from_text("d")
    let before_page: Bytes = yaza_db_page_new_v1(3, 4, 1, 0)?
    let add_a: Number = yaza_db_page_add_slot_v1(before_page, key_a, bytes_from_text("row-a"))?
    let add_c: Number = yaza_db_page_add_slot_v1(before_page, key_c, bytes_from_text("row-c"))?
    let before_image: Bytes = yaza_db_page_finalize_v1(before_page)?

    let inserted_unstamped: Bytes = yaza_db_page_insert_slot_v1(before_image, key_b, bytes_from_text("row-b"))?
    if not yaza_db_write_uint_le_v1(inserted_unstamped, 0, 40, 8): return err("YDBv1 page-WAL fixture could not stamp INSERT page LSN")
    let inserted_image: Bytes = yaza_db_page_finalize_v1(inserted_unstamped)?
    let insert_payload: Bytes = yaza_db_wal_leaf_mutation_payload_encode_v1(yaza_db_wal_type_leaf_insert_v1(), 3, 40, before_image, inserted_image)?
    let insert_record: YazaDbWalRecordV1 = YazaDbWalRecordV1(40, 20, 7, yaza_db_wal_type_leaf_insert_v1(), 0, insert_payload)
    let insert_decoded: YazaDbWalLeafMutationV1 = yaza_db_wal_leaf_mutation_payload_decode_v1(insert_record)?
    if insert_decoded.operation != yaza_db_wal_type_leaf_insert_v1() or insert_decoded.page_id != 3 or not bytes_equal(insert_decoded.before_image, before_image) or not bytes_equal(insert_decoded.after_image, inserted_image): return err("YDBv1 LEAF_INSERT payload did not round-trip")
    let insert_wal_bytes: Bytes = yaza_db_wal_encode_v1(insert_record)?
    let insert_wal_record: YazaDbWalRecordV1 = yaza_db_wal_decode_v1(insert_wal_bytes, 40)?
    let insert_wal_mutation: YazaDbWalLeafMutationV1 = yaza_db_wal_leaf_mutation_payload_decode_v1(insert_wal_record)?
    if not bytes_equal(insert_wal_mutation.after_image, inserted_image): return err("YDBv1 LEAF_INSERT WAL framing lost its page image")

    let replaced_image: Bytes = yaza_db_page_replace_leaf_slot_v1(inserted_image, 60, key_b, bytes_from_text("row-b-updated"))?
    let update_payload: Bytes = yaza_db_wal_leaf_mutation_payload_encode_v1(yaza_db_wal_type_leaf_update_v1(), 3, 60, inserted_image, replaced_image)?
    let update_record: YazaDbWalRecordV1 = YazaDbWalRecordV1(60, 40, 7, yaza_db_wal_type_leaf_update_v1(), 0, update_payload)
    let update_decoded: YazaDbWalLeafMutationV1 = yaza_db_wal_leaf_mutation_payload_decode_v1(update_record)?
    if update_decoded.operation != yaza_db_wal_type_leaf_update_v1() or not bytes_equal(update_decoded.after_image, replaced_image): return err("YDBv1 LEAF_UPDATE payload did not round-trip")

    let batch_keys: List[Bytes] = [key_a, key_c]
    let batch_values: List[Bytes] = [bytes_from_text("row-a-batch"), bytes_from_text("row-c-batch")]
    let batch_image: Bytes = yaza_db_page_replace_leaf_slots_v1(inserted_image, 70, batch_keys, batch_values)?
    let batch_payload: Bytes = yaza_db_wal_leaf_mutation_payload_encode_batch_v2(yaza_db_wal_type_leaf_update_v1(), 3, 70, inserted_image, batch_image)?
    let batch_record: YazaDbWalRecordV1 = YazaDbWalRecordV1(70, 40, 7, yaza_db_wal_type_leaf_update_v1(), 0, batch_payload)
    let batch_decoded: YazaDbWalLeafMutationV1 = yaza_db_wal_leaf_mutation_payload_decode_v1(batch_record)?
    if not bytes_equal(batch_decoded.after_image, batch_image): return err("YDBv1 batched LEAF_UPDATE payload did not round-trip")
    let batch_a_index: Number = yaza_db_page_lower_bound_v1(batch_decoded.after_image, key_a, 3)?
    let batch_c_index: Number = yaza_db_page_lower_bound_v1(batch_decoded.after_image, key_c, 3)?
    let batch_a_slot: YazaDbPageSlotV1 = yaza_db_page_slot_v1(batch_decoded.after_image, batch_a_index, 3)?
    let batch_c_slot: YazaDbPageSlotV1 = yaza_db_page_slot_v1(batch_decoded.after_image, batch_c_index, 3)?
    if not bytes_equal(batch_a_slot.payload, bytes_from_text("row-a-batch")) or not bytes_equal(batch_c_slot.payload, bytes_from_text("row-c-batch")):
        return err("YDBv1 batched LEAF_UPDATE did not retain every replacement")
    let rejected_multi_update_v1: Result[Bytes, Text] = yaza_db_wal_leaf_mutation_payload_encode_v1(yaza_db_wal_type_leaf_update_v1(), 3, 70, inserted_image, batch_image)
    if result_is_ok(rejected_multi_update_v1): return err("YDBv1 single-row payload accepted a multi-row page mutation")
    let rejected_batch_insert: Result[Bytes, Text] = yaza_db_wal_leaf_mutation_payload_encode_batch_v2(yaza_db_wal_type_leaf_insert_v1(), 3, 70, inserted_image, batch_image)
    if result_is_ok(rejected_batch_insert): return err("YDBv1 batched payload version accepted a non-UPDATE operation")

    var grouped_insert_image: Bytes = yaza_db_page_insert_sorted_slot_v1(before_image, key_b, bytes_from_text("row-b"))?
    set grouped_insert_image = yaza_db_page_insert_sorted_slot_v1(grouped_insert_image, key_d, bytes_from_text("row-d"))?
    if not yaza_db_write_uint_le_v1(grouped_insert_image, 0, 75, 8): return err("YDBv1 grouped INSERT fixture could not stamp its page LSN")
    set grouped_insert_image = yaza_db_page_finalize_v1(grouped_insert_image)?
    let grouped_insert_payload: Bytes = yaza_db_wal_leaf_mutation_payload_encode_group_v3(yaza_db_wal_type_leaf_insert_v1(), 3, 75, before_image, grouped_insert_image)?
    let grouped_insert_record: YazaDbWalRecordV1 = YazaDbWalRecordV1(75, 40, 7, yaza_db_wal_type_leaf_insert_v1(), 0, grouped_insert_payload)
    let grouped_insert_decoded: YazaDbWalLeafMutationV1 = yaza_db_wal_leaf_mutation_payload_decode_v1(grouped_insert_record)?
    let grouped_insert_header: YazaDbPageHeaderV1 = yaza_db_page_header_decode_v1(grouped_insert_decoded.after_image, 3)?
    if grouped_insert_header.count != 4 or not bytes_equal(grouped_insert_decoded.before_image, before_image) or not bytes_equal(grouped_insert_decoded.after_image, grouped_insert_image):
        return err("YDBv1 grouped LEAF_INSERT did not preserve its before/after images and two added keys")
    let rejected_grouped_insert_v1: Result[Bytes, Text] = yaza_db_wal_leaf_mutation_payload_encode_v1(yaza_db_wal_type_leaf_insert_v1(), 3, 75, before_image, grouped_insert_image)
    if result_is_ok(rejected_grouped_insert_v1): return err("YDBv1 single-row LEAF_INSERT accepted two added keys")

    let deleted_image: Bytes = yaza_db_page_delete_leaf_slot_v1(replaced_image, 80, key_b)?
    let delete_payload: Bytes = yaza_db_wal_leaf_mutation_payload_encode_v1(yaza_db_wal_type_leaf_delete_v1(), 3, 80, replaced_image, deleted_image)?
    let delete_record: YazaDbWalRecordV1 = YazaDbWalRecordV1(80, 60, 7, yaza_db_wal_type_leaf_delete_v1(), 0, delete_payload)
    let delete_decoded: YazaDbWalLeafMutationV1 = yaza_db_wal_leaf_mutation_payload_decode_v1(delete_record)?
    if delete_decoded.operation != yaza_db_wal_type_leaf_delete_v1() or not bytes_equal(delete_decoded.after_image, deleted_image): return err("YDBv1 LEAF_DELETE payload did not round-trip")

    let clr_image: Bytes = bytes_try_slice(before_image, 0, bytes_length(before_image))?
    if not yaza_db_write_uint_le_v1(clr_image, 0, 100, 8): return err("YDBv1 leaf CLR fixture could not stamp its page LSN")
    let finalized_clr_image: Bytes = yaza_db_page_finalize_v1(clr_image)?
    let clr_payload: Bytes = yaza_db_wal_leaf_compensation_payload_encode_v1(yaza_db_wal_type_leaf_insert_v1(), 3, 20, 40, 100, 80, finalized_clr_image)?
    let clr_record: YazaDbWalRecordV1 = YazaDbWalRecordV1(100, 80, 7, yaza_db_wal_type_compensation_v1(), 0, clr_payload)
    let clr_wal_bytes: Bytes = yaza_db_wal_encode_v1(clr_record)?
    let clr_wal_record: YazaDbWalRecordV1 = yaza_db_wal_decode_v1(clr_wal_bytes, 100)?
    let clr_decoded: YazaDbWalLeafCompensationV1 = yaza_db_wal_leaf_compensation_payload_decode_v1(clr_wal_record)?
    if clr_decoded.operation != yaza_db_wal_type_leaf_insert_v1() or clr_decoded.page_id != 3 or clr_decoded.undo_next_lsn != 20 or clr_decoded.compensated_lsn != 40 or not bytes_equal(clr_decoded.image, finalized_clr_image): return err("YDBv1 leaf CLR payload did not round-trip through WAL framing")

    let wrong_operation: YazaDbWalRecordV1 = YazaDbWalRecordV1(40, 20, 7, yaza_db_wal_type_leaf_update_v1(), 0, insert_payload)
    if result_is_ok(yaza_db_wal_leaf_mutation_payload_decode_v1(wrong_operation)): return err("YDBv1 leaf mutation decoder accepted an operation mismatch")
    let wrong_lsn: Result[Bytes, Text] = yaza_db_wal_leaf_mutation_payload_encode_v1(yaza_db_wal_type_leaf_insert_v1(), 3, 41, before_image, inserted_image)
    if result_is_ok(wrong_lsn): return err("YDBv1 leaf mutation encoder accepted an after-image LSN mismatch")
    let no_delta: Result[Bytes, Text] = yaza_db_wal_leaf_mutation_payload_encode_v1(yaza_db_wal_type_leaf_insert_v1(), 3, 40, before_image, before_image)
    if result_is_ok(no_delta): return err("YDBv1 leaf mutation encoder accepted an INSERT with no added key")

    let corrupt_payload: Bytes = bytes_try_slice(insert_payload, 0, bytes_length(insert_payload))?
    if not bytes_try_set(corrupt_payload, 24 + 100, bytes_get(corrupt_payload, 24 + 100) + 1): return err("YDBv1 leaf mutation corruption fixture could not modify the image")
    let corrupt_record: YazaDbWalRecordV1 = YazaDbWalRecordV1(40, 20, 7, yaza_db_wal_type_leaf_insert_v1(), 0, corrupt_payload)
    if result_is_ok(yaza_db_wal_leaf_mutation_payload_decode_v1(corrupt_record)): return err("YDBv1 leaf mutation decoder accepted an image with an invalid page CRC")

    let wrong_page_image: Bytes = yaza_db_page_new_v1(4, 40, 1, 0)?
    let wrong_page_payload: Result[Bytes, Text] = yaza_db_wal_leaf_mutation_payload_encode_v1(yaza_db_wal_type_leaf_insert_v1(), 3, 40, before_image, wrong_page_image)
    if result_is_ok(wrong_page_payload): return err("YDBv1 leaf mutation encoder accepted mismatched page identity")
    let wrong_clr_chain: Result[Bytes, Text] = yaza_db_wal_leaf_compensation_payload_encode_v1(yaza_db_wal_type_leaf_insert_v1(), 3, 40, 40, 100, 80, finalized_clr_image)
    if result_is_ok(wrong_clr_chain): return err("YDBv1 leaf CLR encoder accepted a non-advancing undo chain")
    let wrong_clr_image: Result[Bytes, Text] = yaza_db_wal_leaf_compensation_payload_encode_v1(yaza_db_wal_type_leaf_insert_v1(), 3, 20, 40, 101, 80, finalized_clr_image)
    if result_is_ok(wrong_clr_image): return err("YDBv1 leaf CLR encoder accepted an image-LSN mismatch")
    return ok(bytes_length(insert_payload) + bytes_length(grouped_insert_payload) + bytes_length(update_payload) + bytes_length(delete_payload) + bytes_length(clr_payload))

start:
    let outcome: Result[Number, Text] = yaza_base_page_wal_v1_check()
    if result_is_ok(outcome):
        say "yazabase-page-wal-v1-ok bytes=" + number_text(result_unwrap(outcome))
    else:
        say result_unwrap_error(outcome)
