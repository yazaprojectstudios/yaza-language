use "std/convert"

fn convert_hex_smoke() -> Result[Boolean, Text]:
    let empty_encoded: Result[Text, Text] = convert_try_hex_encode(bytes_from_text(""))
    let empty_decoded: Result[Bytes, Text] = convert_try_hex_decode("")
    if not result_is_ok(empty_encoded) or result_unwrap(empty_encoded) != "" or not result_is_ok(empty_decoded) or bytes_length(result_unwrap(empty_decoded)) != 0:
        return err("Hex conversion did not round-trip empty input")

    let binary_result: Result[Bytes, Text] = bytes_try_new_zeroed(4)
    if not result_is_ok(binary_result): return err(result_unwrap_error(binary_result))
    let binary: Bytes = result_unwrap(binary_result)
    if not bytes_try_set(binary, 0, 0) or not bytes_try_set(binary, 1, 255) or not bytes_try_set(binary, 2, 128) or not bytes_try_set(binary, 3, 16):
        return err("Hex fixture could not prepare arbitrary binary bytes")
    let encoded: Result[Text, Text] = convert_try_hex_encode(binary)
    if not result_is_ok(encoded) or result_unwrap(encoded) != "00ff8010":
        return err("Hex encoder did not emit canonical lowercase output")
    let decoded: Result[Bytes, Text] = convert_try_hex_decode("00FF8010")
    if not result_is_ok(decoded) or not bytes_equal(result_unwrap(decoded), binary):
        return err("Hex decoder did not accept uppercase or preserve binary data")

    let text_encoded: Result[Text, Text] = convert_try_hex_encode(bytes_from_text("Yaza"))
    let text_decoded: Result[Bytes, Text] = convert_try_hex_decode("59617a61")
    if not result_is_ok(text_encoded) or result_unwrap(text_encoded) != "59617a61" or not result_is_ok(text_decoded) or not bytes_equal(result_unwrap(text_decoded), bytes_from_text("Yaza")):
        return err("Hex conversion failed an ASCII round-trip")

    let malformed_result: Result[TextList, Text] = text_list_try_new()
    if not result_is_ok(malformed_result): return err(result_unwrap_error(malformed_result))
    let malformed: TextList = result_unwrap(malformed_result)
    if not list_try_push(malformed, "f") or not list_try_push(malformed, "0g") or not list_try_push(malformed, " 0") or not list_try_push(malformed, "0x") or not list_try_push(malformed, "0é"):
        return err("Hex fixture could not append malformed inputs")
    var malformed_index: Number = 0
    while malformed_index < list_count(malformed):
        if result_is_ok(convert_try_hex_decode(list_get(malformed, malformed_index))):
            return err("Hex decoder accepted an odd-length or invalid input")
        set malformed_index = malformed_index + 1

    return ok(true)

start:
    let outcome: Result[Boolean, Text] = convert_hex_smoke()
    if not result_is_ok(outcome): say result_unwrap_error(outcome)
    elif result_unwrap(outcome): say "hex-conversion-ok"
    else: say "Hex conversion fixture returned false"
