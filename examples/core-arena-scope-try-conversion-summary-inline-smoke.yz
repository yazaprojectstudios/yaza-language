impl From[Number] for Int32:
    fn from(value: Number) -> Int32:
        return int32_from_number(value)

fn maybe_use(input: Result[Number, Number], fallback: Result[Number, Int32]) -> Result[Number, Int32]:
    let value: Number = input?
    return fallback

start:
    var escaped: Result[Number, Int32] = err(int32_from_number(0))
    let failed: Result[Number, Number] = err(7)
    let fallback: Result[Number, Int32] = err(int32_from_number(9))
    arena_scope 4096:
        set escaped = maybe_use(failed, fallback)
    assert not result_is_ok(escaped)
    assert number_from_int32(result_unwrap_error(escaped)) == 7
    say "inline-try-conversion-summary-ok"
