use "std/nosql/uri"

start:
    # 1. Redis URI
    let r_uri1: Text = "redis://:mypassword@cache.internal:6380/2"
    let r_res1: Result[RedisConnectionConfig, Text] = redis_parse_uri(r_uri1)
    assert result_is_ok(r_res1)
    let r_cfg1: RedisConnectionConfig = result_unwrap(r_res1)
    assert r_cfg1.host == "cache.internal"
    assert r_cfg1.port == 6380
    assert option_is_some(r_cfg1.password)
    assert option_unwrap(r_cfg1.password) == "mypassword"
    assert r_cfg1.database_index == 2

    # Minimal Redis URI
    let r_uri2: Text = "redis://localhost"
    let r_res2: Result[RedisConnectionConfig, Text] = redis_parse_uri(r_uri2)
    assert result_is_ok(r_res2)
    let r_cfg2: RedisConnectionConfig = result_unwrap(r_res2)
    assert r_cfg2.host == "localhost"
    assert r_cfg2.port == 6379
    assert not option_is_some(r_cfg2.password)
    assert r_cfg2.database_index == 0

    # 2. MongoDB URI
    let m_uri1: Text = "mongodb://mongo_admin:s3cr3t@db.internal:27018/customers"
    let m_res1: Result[MongoConnectionConfig, Text] = mongo_parse_uri(m_uri1)
    assert result_is_ok(m_res1)
    let m_cfg1: MongoConnectionConfig = result_unwrap(m_res1)
    assert m_cfg1.host == "db.internal"
    assert m_cfg1.port == 27018
    assert option_is_some(m_cfg1.user)
    assert option_unwrap(m_cfg1.user) == "mongo_admin"
    assert option_is_some(m_cfg1.password)
    assert option_unwrap(m_cfg1.password) == "s3cr3t"
    assert option_is_some(m_cfg1.database)
    assert option_unwrap(m_cfg1.database) == "customers"

    # Minimal MongoDB URI
    let m_uri2: Text = "mongodb://localhost"
    let m_res2: Result[MongoConnectionConfig, Text] = mongo_parse_uri(m_uri2)
    assert result_is_ok(m_res2)
    let m_cfg2: MongoConnectionConfig = result_unwrap(m_res2)
    assert m_cfg2.host == "localhost"
    assert m_cfg2.port == 27017

    # 3. Invalid URI schemes
    assert not result_is_ok(redis_parse_uri("postgres://localhost"))
    assert not result_is_ok(mongo_parse_uri("mysql://localhost"))
