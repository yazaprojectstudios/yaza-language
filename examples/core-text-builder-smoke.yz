use "std/text"

fn text_builder_quota_failure_recovers() -> Boolean:
    var recovered: Boolean = false
    arena_scope 2048:
        let created: Result[TextBuilder, Text] = text_builder_new(1600)
        if result_is_ok(created):
            let source_result: Result[Text, Text] = text_try_repeat("x", 1500)
            if result_is_ok(source_result):
                let builder: TextBuilder = result_unwrap(created)
                let append_result: Result[TextBuilder, Text] = text_builder_append(builder, result_unwrap(source_result))
                set recovered = not result_is_ok(append_result) and text_builder_byte_length(builder) == 0
    return recovered

fn text_builder_smoke() -> Result[Boolean, Text]:
    let created: Result[TextBuilder, Text] = text_builder_new(11)
    if not result_is_ok(created): return err(result_unwrap_error(created))
    var builder: TextBuilder = result_unwrap(created)
    set builder = text_builder_append(builder, "YAZA")?
    set builder = text_builder_append(builder, "")?
    set builder = text_builder_append(builder, " rocks")?
    if text_builder_byte_length(builder) != 10: return err("TextBuilder counted appended bytes incorrectly")

    let rejected: Result[TextBuilder, Text] = text_builder_append(builder, " too much")
    if result_is_ok(rejected) or text_builder_byte_length(builder) != 10:
        return err("TextBuilder limit rejection changed the current builder")

    set builder = text_builder_append(builder, "!")?
    if text_builder_byte_length(builder) != 11: return err("TextBuilder exact byte limit was not accepted")
    let output: Result[Text, Text] = text_builder_finish(builder)
    if not result_is_ok(output) or result_unwrap(output) != "YAZA rocks!":
        return err("TextBuilder produced an incorrect result")

    let empty_created: Result[TextBuilder, Text] = text_builder_new(0)
    if not result_is_ok(empty_created): return err(result_unwrap_error(empty_created))
    var empty_builder: TextBuilder = result_unwrap(empty_created)
    set empty_builder = text_builder_append(empty_builder, "")?
    let empty_output: Result[Text, Text] = text_builder_finish(empty_builder)
    if not result_is_ok(empty_output) or result_unwrap(empty_output) != "":
        return err("TextBuilder did not finish an empty output")

    if result_is_ok(text_builder_new(-1)) or result_is_ok(text_builder_new(67108865)):
        return err("TextBuilder accepted an invalid byte limit")
    if result_is_ok(text_builder_finish(TextBuilder(text_list(), 1, 1))):
        return err("TextBuilder accepted inconsistent length metadata")
    if not text_builder_quota_failure_recovers():
        return err("TextBuilder did not recover from an arena quota failure")

    let many_created: Result[TextBuilder, Text] = text_builder_new(1000)
    if not result_is_ok(many_created): return err(result_unwrap_error(many_created))
    var many: TextBuilder = result_unwrap(many_created)
    var part_index: Number = 0
    while part_index < 1000:
        set many = text_builder_append(many, "x")?
        set part_index = part_index + 1
    let many_output: Result[Text, Text] = text_builder_finish(many)
    if not result_is_ok(many_output): return err(result_unwrap_error(many_output))
    if text_length(result_unwrap(many_output)) != 1000 or text_byte(result_unwrap(many_output), 999) != 120:
        return err("TextBuilder did not assemble 1000 fragments correctly")
    return ok(true)

start:
    let outcome: Result[Boolean, Text] = text_builder_smoke()
    if not result_is_ok(outcome): say result_unwrap_error(outcome)
    elif result_unwrap(outcome): say "text-builder-ok"
    else: say "TextBuilder fixture returned false"
