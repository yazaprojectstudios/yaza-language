fn yazabase_sync_recovery_indexed_update_v1(root: Number, row_id: Number) -> Number:
    let source: Text = "UPDATE crash_rows SET value = " + number_text(row_id + 2000000) + " WHERE id = " + number_text(row_id)
    let no_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    return yazabase_sync_recovery_execute_v1(root, source, no_parameters, false)

fn yazabase_sync_recovery_indexed_update_verify_v1(root: Number, row_id: Number) -> Number:
    let old_value: Number = row_id + 1000000
    let new_value: Number = row_id + 2000000
    let actual: Number = yazabase_sync_recovery_row_value_v1(root, row_id)
    let old_count: Number = yazabase_sync_recovery_query_count_v1(root, "SELECT id FROM crash_rows WHERE value = " + number_text(old_value))
    let new_count: Number = yazabase_sync_recovery_query_count_v1(root, "SELECT id FROM crash_rows WHERE value = " + number_text(new_value))
    if actual == old_value and old_count == 1 and new_count == 0: return 0
    if actual == new_value and old_count == 0 and new_count == 1: return 0
    return 78

