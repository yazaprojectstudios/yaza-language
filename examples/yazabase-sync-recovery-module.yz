fn yazabase_sync_recovery_close_v1(storage: YazaDbStorageHandleV1, wal: YazaDbWalLogV1) -> Number:
    let wal_closed: Result[Boolean, Text] = yaza_db_wal_log_close_v1(wal)
    let storage_closed: Result[Boolean, Text] = yaza_db_storage_close_v1(storage)
    if not result_is_ok(wal_closed) or not result_is_ok(storage_closed): return 1
    if not result_unwrap(wal_closed) or not result_unwrap(storage_closed): return 2
    return 0

fn yazabase_sync_recovery_initialize_v1(root: Number) -> Number:
    let header: YazaDbFileHeaderV1 = YazaDbFileHeaderV1(bytes_from_text("fault-test-ydb01"), 0, 1, 1, 0, 2, 1)
    let empty_result: Result[YazaDbStorageHandleV1, Text] = yaza_db_storage_create_empty_v1(root, "sync-recovery.ydb", header)
    if not result_is_ok(empty_result): return 10
    let empty_closed: Result[Boolean, Text] = yaza_db_storage_close_v1(result_unwrap(empty_result))
    if not result_is_ok(empty_closed) or not result_unwrap(empty_closed): return 11

    let initialized_result: Result[YazaDbCatalogBootstrapV1, Text] = yaza_db_catalog_initialize_v1(root, "sync-recovery.ydb")
    if not result_is_ok(initialized_result): return 12
    let initialized: YazaDbCatalogBootstrapV1 = result_unwrap(initialized_result)
    return yazabase_sync_recovery_close_v1(initialized.storage, initialized.wal)

fn yazabase_sync_recovery_catalog_migration_v1(root: Number) -> Number:
    let recovered_result: Result[YazaDbCheckpointRecoveryV1, Text] = yaza_db_open_recovered_v1(root, "sync-recovery.ydb")
    if not result_is_ok(recovered_result): return 130
    let recovered: YazaDbCheckpointRecoveryV1 = result_unwrap(recovered_result)
    let migrated_result: Result[YazaDbCatalogMigrationV1, Text] = yaza_db_catalog_migrate_views_opened_v1(recovered.storage, recovered.wal)
    if not result_is_ok(migrated_result): return 131
    let migrated: YazaDbCatalogMigrationV1 = result_unwrap(migrated_result)
    return yazabase_sync_recovery_close_v1(migrated.storage, migrated.wal)

fn yazabase_sync_recovery_catalog_migration_verify_v1(root: Number) -> Number:
    let recovered_result: Result[YazaDbCheckpointRecoveryV1, Text] = yaza_db_open_recovered_v1(root, "sync-recovery.ydb")
    if not result_is_ok(recovered_result):
        say "catalog migration recovery failed: " + result_unwrap_error(recovered_result)
        return 132
    let recovered: YazaDbCheckpointRecoveryV1 = result_unwrap(recovered_result)
    let catalog_result: Result[YazaDbCatalogRootV1, Text] = yaza_db_catalog_storage_read_root_v1(recovered.storage.file, recovered.storage.header)
    if not result_is_ok(catalog_result):
        say "catalog migration root validation failed: " + result_unwrap_error(catalog_result)
        let ignored_close: Number = yazabase_sync_recovery_close_v1(recovered.storage, recovered.wal)
        return 133
    let catalog: YazaDbCatalogRootV1 = result_unwrap(catalog_result)
    if catalog.sys_views_root != 0:
        let view_root_result: Result[Bytes, Text] = yaza_db_storage_read_page_v1(recovered.storage.file, recovered.storage.header, catalog.sys_views_root)
        if not result_is_ok(view_root_result):
            let ignored_close: Number = yazabase_sync_recovery_close_v1(recovered.storage, recovered.wal)
            return 134
        let view_header_result: Result[YazaDbPageHeaderV1, Text] = yaza_db_page_header_decode_v1(result_unwrap(view_root_result), catalog.sys_views_root)
        if not result_is_ok(view_header_result):
            let ignored_close: Number = yazabase_sync_recovery_close_v1(recovered.storage, recovered.wal)
            return 134
        if result_unwrap(view_header_result).page_type != 1 or catalog.generation < 2:
            let ignored_close: Number = yazabase_sync_recovery_close_v1(recovered.storage, recovered.wal)
            return 134
    return yazabase_sync_recovery_close_v1(recovered.storage, recovered.wal)

fn yazabase_sync_recovery_fk_child_name_v1(value: Number) -> Text:
    return "crash_fk_child_" + number_text(value)

fn yazabase_sync_recovery_fk_prepare_v1(root: Number) -> Number:
    let no_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let parent_create: Number = yazabase_sync_recovery_execute_v1(root, "CREATE TABLE crash_fk_parent (id BIGINT PRIMARY KEY)", no_parameters, false)
    if parent_create != 0: return 160
    return yazabase_sync_recovery_execute_v1(root, "INSERT INTO crash_fk_parent (id) VALUES (1)", no_parameters, false)

fn yazabase_sync_recovery_fk_create_v1(root: Number, value: Number) -> Number:
    let no_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let child_name: Text = yazabase_sync_recovery_fk_child_name_v1(value)
    let source: Text = "CREATE TABLE " + child_name + " (id BIGINT PRIMARY KEY, parent_id BIGINT, FOREIGN KEY (parent_id) REFERENCES crash_fk_parent(id))"
    return yazabase_sync_recovery_execute_v1(root, source, no_parameters, false)

fn yazabase_sync_recovery_fk_verify_v1(root: Number, value: Number) -> Number:
    let recovered_result: Result[YazaDbCheckpointRecoveryV1, Text] = yaza_db_open_recovered_v1(root, "sync-recovery.ydb")
    if not result_is_ok(recovered_result): return 161
    let recovered: YazaDbCheckpointRecoveryV1 = result_unwrap(recovered_result)
    let no_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let child_name: Text = yazabase_sync_recovery_fk_child_name_v1(value)
    let select_source: Text = "SELECT id FROM " + child_name + " LIMIT 1"
    let selected: Result[YazaDbSqlStatementResultV1, Text] = yaza_db_execute_statement_v1(recovered.storage, recovered.wal, select_source, no_parameters)
    if not result_is_ok(selected):
        let diagnostic: Text = result_unwrap_error(selected)
        let close_status: Number = yazabase_sync_recovery_close_v1(recovered.storage, recovered.wal)
        if close_status != 0: return 162
        if not text_starts_with(diagnostic, "SQL binder could not resolve table"): return 163
        let parent_delete_when_child_absent: Number = yazabase_sync_recovery_execute_v1(root, "DELETE FROM crash_fk_parent WHERE id = 1", no_parameters, false)
        if parent_delete_when_child_absent != 0: return 164
        return 0
    let select_statement: YazaDbSqlStatementResultV1 = result_unwrap(selected)
    if not option_is_some(select_statement.query_result):
        let ignored_close: Number = yazabase_sync_recovery_close_v1(select_statement.storage, select_statement.wal)
        return 165
    let child_query: YazaSqlQueryResultV1 = option_unwrap(select_statement.query_result)
    if list_count(child_query.rows) != 0:
        let ignored_close: Number = yazabase_sync_recovery_close_v1(select_statement.storage, select_statement.wal)
        return 166
    if yazabase_sync_recovery_close_v1(select_statement.storage, select_statement.wal) != 0: return 167
    let invalid_child_insert: Number = yazabase_sync_recovery_execute_v1(root, "INSERT INTO " + child_name + " (id, parent_id) VALUES (9101, 999999)", no_parameters, false)
    if invalid_child_insert == 0: return 168
    let valid_child_insert: Number = yazabase_sync_recovery_execute_v1(root, "INSERT INTO " + child_name + " (id, parent_id) VALUES (1, 1)", no_parameters, false)
    if valid_child_insert != 0: return 169
    let blocked_parent_delete: Number = yazabase_sync_recovery_execute_v1(root, "DELETE FROM crash_fk_parent WHERE id = 1", no_parameters, false)
    if blocked_parent_delete == 0: return 170
    let child_delete: Number = yazabase_sync_recovery_execute_v1(root, "DELETE FROM " + child_name + " WHERE id = 1", no_parameters, false)
    if child_delete != 0: return 171
    let parent_delete_after_child: Number = yazabase_sync_recovery_execute_v1(root, "DELETE FROM crash_fk_parent WHERE id = 1", no_parameters, false)
    if parent_delete_after_child != 0: return 172
    return 1

fn yazabase_sync_recovery_execute_v1(root: Number, source: Text, parameters: List[YazaSqlValueV1], select_result: Boolean) -> Number:
    let recovered_result: Result[YazaDbCheckpointRecoveryV1, Text] = yaza_db_open_recovered_v1(root, "sync-recovery.ydb")
    if not result_is_ok(recovered_result):
        say result_unwrap_error(recovered_result)
        return 20
    let recovered: YazaDbCheckpointRecoveryV1 = result_unwrap(recovered_result)
    let statement_result: Result[YazaDbSqlStatementResultV1, Text] = yaza_db_execute_statement_v1(recovered.storage, recovered.wal, source, parameters)
    if not result_is_ok(statement_result):
        let ignored_close: Number = yazabase_sync_recovery_close_v1(recovered.storage, recovered.wal)
        return 21
    let statement: YazaDbSqlStatementResultV1 = result_unwrap(statement_result)
    if select_result:
        if not option_is_some(statement.query_result):
            let ignored_close: Number = yazabase_sync_recovery_close_v1(statement.storage, statement.wal)
            return 22
        let query: YazaSqlQueryResultV1 = option_unwrap(statement.query_result)
        let row_count: Number = list_count(query.rows)
        let closed: Number = yazabase_sync_recovery_close_v1(statement.storage, statement.wal)
        if closed != 0: return 23
        return row_count
    if not option_is_some(statement.write_commit):
        let ignored_close: Number = yazabase_sync_recovery_close_v1(statement.storage, statement.wal)
        return 24
    let committed: YazaDbWriteCommitV1 = option_unwrap(statement.write_commit)
    return yazabase_sync_recovery_close_v1(committed.storage, committed.wal)

fn yazabase_sync_recovery_capacity_setup_v1(root: Number) -> Number:
    let created_result: Result[YazaDbCatalogBootstrapV1, Text] = yaza_db_catalog_create_v1(root, "capacity-fault.ydb")
    if not result_is_ok(created_result): return 60
    let created: YazaDbCatalogBootstrapV1 = result_unwrap(created_result)
    return yazabase_sync_recovery_close_v1(created.storage, created.wal)

fn yazabase_sync_recovery_capacity_grow_v1(root: Number) -> Number:
    let recovered_result: Result[YazaDbCheckpointRecoveryV1, Text] = yaza_db_open_recovered_v1(root, "capacity-fault.ydb")
    if not result_is_ok(recovered_result): return 61
    let recovered: YazaDbCheckpointRecoveryV1 = result_unwrap(recovered_result)
    let begun_result: Result[YazaDbWriteTransactionV1, Text] = yaza_db_write_transaction_begin_with_reserve_v1(recovered.storage, recovered.wal, yaza_db_storage_preallocated_page_count_v1())
    if not result_is_ok(begun_result):
        let ignored_close: Number = yazabase_sync_recovery_close_v1(recovered.storage, recovered.wal)
        return 62
    let committed_result: Result[YazaDbWriteCommitV1, Text] = yaza_db_write_transaction_commit_v1(result_unwrap(begun_result))
    if not result_is_ok(committed_result): return 63
    let committed: YazaDbWriteCommitV1 = result_unwrap(committed_result)
    return yazabase_sync_recovery_close_v1(committed.storage, committed.wal)

fn yazabase_sync_recovery_capacity_verify_v1(root: Number) -> Number:
    let recovered_result: Result[YazaDbCheckpointRecoveryV1, Text] = yaza_db_open_recovered_v1(root, "capacity-fault.ydb")
    if not result_is_ok(recovered_result): return 64
    let recovered: YazaDbCheckpointRecoveryV1 = result_unwrap(recovered_result)
    let initial_pages: Number = yaza_db_storage_preallocated_page_count_v1()
    if recovered.storage.header.page_count != initial_pages and recovered.storage.header.page_count != initial_pages * 2:
        let ignored_close: Number = yazabase_sync_recovery_close_v1(recovered.storage, recovered.wal)
        return 65
    if recovered.storage.header.page_count == initial_pages * 2:
        let free_pages: Result[Number, Text] = yaza_db_allocator_count_free_pages_v1(recovered.storage, initial_pages)
        if not result_is_ok(free_pages) or result_unwrap(free_pages) < initial_pages:
            let ignored_close: Number = yazabase_sync_recovery_close_v1(recovered.storage, recovered.wal)
            return 66
    let begun_result: Result[YazaDbWriteTransactionV1, Text] = yaza_db_write_transaction_begin_v1(recovered.storage, recovered.wal)
    if not result_is_ok(begun_result): return 67
    let committed_result: Result[YazaDbWriteCommitV1, Text] = yaza_db_write_transaction_commit_v1(result_unwrap(begun_result))
    if not result_is_ok(committed_result): return 68
    let committed: YazaDbWriteCommitV1 = result_unwrap(committed_result)
    return yazabase_sync_recovery_close_v1(committed.storage, committed.wal)

fn yazabase_sync_recovery_index_name_v1(index_id: Number) -> Text:
    return "crash_idx_" + number_text(index_id)

fn yazabase_sync_recovery_index_state_v1(root: Number, index_id: Number) -> Number:
    let recovered_result: Result[YazaDbCheckpointRecoveryV1, Text] = yaza_db_open_recovered_v1(root, "sync-recovery.ydb")
    if not result_is_ok(recovered_result):
        say "index-state recovery error: " + result_unwrap_error(recovered_result)
        return -1
    let recovered: YazaDbCheckpointRecoveryV1 = result_unwrap(recovered_result)
    let rows_result: Result[List[YazaDbRowV1], Text] = yaza_db_index_catalog_rows_v1(recovered.storage.file, recovered.storage.header, recovered.storage.header.next_commit_ts - 1)
    if not result_is_ok(rows_result):
        let ignored_close: Number = yazabase_sync_recovery_close_v1(recovered.storage, recovered.wal)
        return -2
    let rows: List[YazaDbRowV1] = result_unwrap(rows_result)
    let expected_name: Text = yazabase_sync_recovery_index_name_v1(index_id)
    var state: Number = 0
    var index: Number = 0
    while index < list_count(rows):
        let row: YazaDbRowV1 = list_get(rows, index)
        if list_get(row.values, 2).text_value == expected_name:
            set state = list_get(row.values, 4).integer_value
            set index = list_count(rows)
        else: set index = index + 1
    let closed: Number = yazabase_sync_recovery_close_v1(recovered.storage, recovered.wal)
    if closed != 0: return -3
    return state

fn yazabase_sync_recovery_index_create_v1(root: Number, index_id: Number) -> Number:
    let no_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let name: Text = yazabase_sync_recovery_index_name_v1(index_id)
    return yazabase_sync_recovery_execute_v1(root, "CREATE INDEX " + name + " ON crash_rows(value)", no_parameters, false)

fn yazabase_sync_recovery_index_verify_active_v1(root: Number, index_id: Number) -> Number:
    let prior_state: Number = yazabase_sync_recovery_index_state_v1(root, index_id)
    if prior_state < 0: return 70
    if prior_state != 2:
        let created: Number = yazabase_sync_recovery_index_create_v1(root, index_id)
        if created != 0: return 71
    if yazabase_sync_recovery_index_state_v1(root, index_id) != 2: return 72
    let no_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let matching_rows: Number = yazabase_sync_recovery_execute_v1(root, "SELECT id FROM crash_rows WHERE value = 9000000", no_parameters, true)
    if matching_rows != 1: return 73
    return 0

fn yazabase_sync_recovery_unique_index_name_v1(index_id: Number) -> Text:
    return "crash_unique_idx_" + number_text(index_id)

fn yazabase_sync_recovery_unique_index_state_v1(root: Number, index_id: Number) -> Number:
    let recovered_result: Result[YazaDbCheckpointRecoveryV1, Text] = yaza_db_open_recovered_v1(root, "sync-recovery.ydb")
    if not result_is_ok(recovered_result): return -1
    let recovered: YazaDbCheckpointRecoveryV1 = result_unwrap(recovered_result)
    let rows_result: Result[List[YazaDbRowV1], Text] = yaza_db_index_catalog_rows_v1(recovered.storage.file, recovered.storage.header, recovered.storage.header.next_commit_ts - 1)
    if not result_is_ok(rows_result):
        let ignored_close: Number = yazabase_sync_recovery_close_v1(recovered.storage, recovered.wal)
        return -2
    let rows: List[YazaDbRowV1] = result_unwrap(rows_result)
    let expected_name: Text = yazabase_sync_recovery_unique_index_name_v1(index_id)
    var state: Number = 0
    var index: Number = 0
    while index < list_count(rows):
        let row: YazaDbRowV1 = list_get(rows, index)
        if list_get(row.values, 2).text_value == expected_name:
            set state = list_get(row.values, 4).integer_value
            set index = list_count(rows)
        else: set index = index + 1
    let closed: Number = yazabase_sync_recovery_close_v1(recovered.storage, recovered.wal)
    if closed != 0: return -3
    return state

fn yazabase_sync_recovery_unique_index_create_v1(root: Number, index_id: Number) -> Number:
    let no_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let name: Text = yazabase_sync_recovery_unique_index_name_v1(index_id)
    return yazabase_sync_recovery_execute_v1(root, "CREATE UNIQUE INDEX " + name + " ON crash_rows(value)", no_parameters, false)

fn yazabase_sync_recovery_unique_index_verify_active_v1(root: Number, index_id: Number) -> Number:
    let prior_state: Number = yazabase_sync_recovery_unique_index_state_v1(root, index_id)
    if prior_state < 0: return 110
    if prior_state != 2:
        let created: Number = yazabase_sync_recovery_unique_index_create_v1(root, index_id)
        if created != 0: return 111
    if yazabase_sync_recovery_unique_index_state_v1(root, index_id) != 2: return 112
    let duplicate_id: Number = 5000000 + index_id
    let duplicate_source: Text = "INSERT INTO crash_rows (id, value) VALUES (" + number_text(duplicate_id) + ", 9000000)"
    let no_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    if yazabase_sync_recovery_execute_v1(root, duplicate_source, no_parameters, false) == 0: return 113
    let matching_rows: Number = yazabase_sync_recovery_query_count_v1(root, "SELECT id FROM crash_rows WHERE value = 9000000")
    if matching_rows != 1: return 114
    return 0

fn yazabase_sync_recovery_unique_index_drop_v1(root: Number, index_id: Number) -> Number:
    let no_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let name: Text = yazabase_sync_recovery_unique_index_name_v1(index_id)
    return yazabase_sync_recovery_execute_v1(root, "DROP INDEX " + name, no_parameters, false)

fn yazabase_sync_recovery_index_drop_v1(root: Number, index_id: Number) -> Number:
    let no_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let name: Text = yazabase_sync_recovery_index_name_v1(index_id)
    return yazabase_sync_recovery_execute_v1(root, "DROP INDEX " + name, no_parameters, false)

fn yazabase_sync_recovery_index_verify_drop_v1(root: Number, index_id: Number) -> Number:
    let state: Number = yazabase_sync_recovery_index_state_v1(root, index_id)
    if state == -1: return 101
    if state == -2: return 102
    if state == -3: return 103
    if state != 0 and state != 2: return 75
    let no_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let matching_rows: Number = yazabase_sync_recovery_execute_v1(root, "SELECT id FROM crash_rows WHERE value = 9000000", no_parameters, true)
    if matching_rows != 1: return 76
    return 0

fn yazabase_sync_recovery_query_count_v1(root: Number, source: Text) -> Number:
    let no_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    return yazabase_sync_recovery_execute_v1(root, source, no_parameters, true)

fn yazabase_sync_recovery_row_value_v1(root: Number, row_id: Number) -> Number:
    let recovered_result: Result[YazaDbCheckpointRecoveryV1, Text] = yaza_db_open_recovered_v1(root, "sync-recovery.ydb")
    if not result_is_ok(recovered_result): return -1
    let recovered: YazaDbCheckpointRecoveryV1 = result_unwrap(recovered_result)
    let no_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let source: Text = "SELECT value FROM crash_rows WHERE id = " + number_text(row_id)
    let selected: Result[YazaDbSqlStatementResultV1, Text] = yaza_db_execute_statement_v1(recovered.storage, recovered.wal, source, no_parameters)
    if not result_is_ok(selected):
        let ignored_close: Number = yazabase_sync_recovery_close_v1(recovered.storage, recovered.wal)
        return -2
    let statement: YazaDbSqlStatementResultV1 = result_unwrap(selected)
    if not option_is_some(statement.query_result):
        let ignored_close: Number = yazabase_sync_recovery_close_v1(statement.storage, statement.wal)
        return -3
    let query: YazaSqlQueryResultV1 = option_unwrap(statement.query_result)
    if list_count(query.rows) != 1 or list_count(list_get(query.rows, 0)) != 1:
        let ignored_close: Number = yazabase_sync_recovery_close_v1(statement.storage, statement.wal)
        return -4
    let actual: YazaSqlValueV1 = list_get(list_get(query.rows, 0), 0)
    let closed: Number = yazabase_sync_recovery_close_v1(statement.storage, statement.wal)
    if closed != 0 or actual.is_null or actual.type_id != 4: return -5
    return actual.integer_value

fn yazabase_sync_recovery_indexed_insert_v1(root: Number, row_id: Number) -> Number:
    let indexed_value: Number = row_id + 1000000
    let source: Text = "INSERT INTO crash_rows (id, value) VALUES (" + number_text(row_id) + ", " + number_text(indexed_value) + ")"
    let no_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    return yazabase_sync_recovery_execute_v1(root, source, no_parameters, false)

fn yazabase_sync_recovery_indexed_insert_verify_v1(root: Number, row_id: Number) -> Number:
    let indexed_value: Number = row_id + 1000000
    let id_count: Number = yazabase_sync_recovery_query_count_v1(root, "SELECT id FROM crash_rows WHERE id = " + number_text(row_id))
    let value_count: Number = yazabase_sync_recovery_query_count_v1(root, "SELECT id FROM crash_rows WHERE value = " + number_text(indexed_value))
    if (id_count != 0 and id_count != 1) or value_count != id_count: return 77
    return 0

fn yazabase_sync_recovery_indexed_batch_insert_v1(root: Number, first_id: Number) -> Number:
    let first: Text = number_text(first_id)
    let second: Text = number_text(first_id + 1)
    let third: Text = number_text(first_id + 2)
    let fourth: Text = number_text(first_id + 3)
    let source: Text = "INSERT INTO crash_rows (id, value) VALUES (" + first + ", " + number_text(first_id + 1000) + "), (" + second + ", " + number_text(first_id + 1001) + "), (" + third + ", " + number_text(first_id + 1002) + "), (" + fourth + ", " + number_text(first_id + 1003) + ")"
    let no_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    return yazabase_sync_recovery_execute_v1(root, source, no_parameters, false)

fn yazabase_sync_recovery_indexed_batch_insert_verify_v1(root: Number, first_id: Number) -> Number:
    let id_count: Number = yazabase_sync_recovery_query_count_v1(root, "SELECT id FROM crash_rows WHERE id >= " + number_text(first_id) + " AND id <= " + number_text(first_id + 3))
    let index_count: Number = yazabase_sync_recovery_query_count_v1(root, "SELECT id FROM crash_rows WHERE value >= " + number_text(first_id + 1000) + " AND value <= " + number_text(first_id + 1003))
    if (id_count != 0 and id_count != 4) or index_count != id_count: return 120
    return 0

fn yazabase_sync_recovery_indexed_batch_delete_v1(root: Number, first_id: Number) -> Number:
    let source: Text = "DELETE FROM crash_rows WHERE id >= " + number_text(first_id) + " AND id <= " + number_text(first_id + 3)
