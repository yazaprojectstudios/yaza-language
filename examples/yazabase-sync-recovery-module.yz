fn yazabase_sync_recovery_indexed_batch_delete_verify_v1(root: Number, first_id: Number) -> Number:
    let id_count: Number = yazabase_sync_recovery_query_count_v1(root, "SELECT id FROM crash_rows WHERE id >= " + number_text(first_id) + " AND id <= " + number_text(first_id + 3))
    let index_count: Number = yazabase_sync_recovery_query_count_v1(root, "SELECT id FROM crash_rows WHERE value >= " + number_text(first_id + 1000) + " AND value <= " + number_text(first_id + 1003))
    if (id_count != 0 and id_count != 4) or index_count != id_count: return 121
