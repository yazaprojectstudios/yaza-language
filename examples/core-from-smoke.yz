use "core-from-errors"

fn read_storage(succeeds: Boolean) -> Result[Number, StorageError]:
    if succeeds:
        return ok(41)
    return err(StorageError::Unavailable("storage offline"))

fn load_storage(succeeds: Boolean) -> Result[Number, ApplicationError]:
    let value: Number = read_storage(succeeds)?
    return ok(value + 1)

fn return_storage(succeeds: Boolean) -> Result[Number, ApplicationError]:
    return read_storage(succeeds)?

start:
    assert result_unwrap(load_storage(true)) == 42
    match load_storage(false):
        err(error):
            match error:
                Storage(message):
                    assert message == "storage offline"
                MissingRecord:
                    assert false
        ok(_):
            assert false
    assert result_unwrap(return_storage(true)) == 41
    match return_storage(false):
        err(error):
            match error:
                Storage(message):
                    assert message == "storage offline"
                MissingRecord:
                    assert false
        ok(_):
            assert false
    say "from-ok"
