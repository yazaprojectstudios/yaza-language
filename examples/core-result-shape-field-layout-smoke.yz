shape UserRecord:
    id: Number
    display_name: Text

shape QueryFault:
    code: Int32
    message: Text

shape QuerySnapshot:
    current: Result[UserRecord, QueryFault]
    cached: Option[Result[UserRecord, QueryFault]]
    history: List[Result[UserRecord, QueryFault]]

fn snapshot_name(snapshot: QuerySnapshot) -> Text:
    match snapshot.current:
        ok(user):
            return user.display_name
        err(problem):
            return problem.message

start:
    let user: UserRecord = UserRecord(42, "Ayu")
    let fault: QueryFault = QueryFault(int32_from_number(503), "temporarily unavailable")
    let success: Result[UserRecord, QueryFault] = ok(user)
    let failure: Result[UserRecord, QueryFault] = err(fault)
    let history: List[Result[UserRecord, QueryFault]] = List[Result[UserRecord, QueryFault]]()
    list_push(history, success)
    list_push(history, failure)

    var snapshot: QuerySnapshot = QuerySnapshot(success, some(failure), history)
    assert snapshot_name(snapshot) == "Ayu"
    assert result_is_ok(snapshot.current)
    assert result_unwrap(snapshot.current).id == 42
    assert result_unwrap_error(option_unwrap(snapshot.cached)).message == "temporarily unavailable"
    assert result_unwrap(list_get(snapshot.history, 0)).display_name == "Ayu"
    assert number_from_int32(result_unwrap_error(list_get(snapshot.history, 1)).code) == 503

    set snapshot.current = failure
    assert snapshot_name(snapshot) == "temporarily unavailable"
    set snapshot.cached = some(success)
    assert result_unwrap(option_unwrap(snapshot.cached)).display_name == "Ayu"
    say "result-shape-field-layout-ok"
