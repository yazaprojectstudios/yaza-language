use "../yazabase/sql_temporal_v1"

fn yazabase_sql_temporal_v1_smoke() -> Result[Boolean, Text]:
    let midnight: Number = yaza_sql_time_parse_v1("00:00:00")?
    if midnight != 0: return err("YazaBase TIME midnight was not zero")
    let last_microsecond: Number = yaza_sql_time_parse_v1("23:59:59.999999")?
    if last_microsecond != 86399999999: return err("YazaBase TIME upper bound was incorrect")
    let last_microsecond_text: Text = yaza_sql_time_to_text_v1(last_microsecond)?
    if last_microsecond_text != "23:59:59.999999": return err("YazaBase TIME canonical formatting failed")
    if result_is_ok(yaza_sql_time_parse_v1("24:00:00")): return err("YazaBase TIME accepted the exclusive day endpoint")
    if result_is_ok(yaza_sql_time_parse_v1("12:00:00.0000001")): return err("YazaBase TIME silently accepted precision loss")

    let epoch: Number = yaza_sql_timestamp_parse_v1("1970-01-01 00:00:00")?
    let epoch_text: Text = yaza_sql_timestamp_to_text_v1(epoch)?
    if epoch != 0 or epoch_text != "1970-01-01 00:00:00.000000": return err("YazaBase civil TIMESTAMP epoch round-trip failed")
    let before_epoch: Number = yaza_sql_timestamp_parse_v1("1969-12-31T23:59:59.999999")?
    let before_epoch_text: Text = yaza_sql_timestamp_to_text_v1(before_epoch)?
    if before_epoch != -1 or before_epoch_text != "1969-12-31 23:59:59.999999": return err("YazaBase civil TIMESTAMP negative epoch round-trip failed")
    let leap_day: Number = yaza_sql_timestamp_parse_v1("2024-02-29 12:34:56.1203")?
    let leap_day_text: Text = yaza_sql_timestamp_to_text_v1(leap_day)?
    if leap_day_text != "2024-02-29 12:34:56.120300": return err("YazaBase civil TIMESTAMP leap-day or fraction formatting failed")
    if result_is_ok(yaza_sql_timestamp_parse_v1("2023-02-29 12:34:56")): return err("YazaBase civil TIMESTAMP accepted an invalid Gregorian date")
    if result_is_ok(yaza_sql_timestamp_parse_v1("2024-02-29 12:34:56Z")): return err("YazaBase civil TIMESTAMP accepted an offset")

    let zoned_offset: Number = yaza_sql_timestamptz_parse_v1("2024-01-02T03:04:05.123456+03:00")?
    let zoned_utc: Number = yaza_sql_timestamptz_parse_v1("2024-01-02T00:04:05.123456Z")?
    if zoned_offset != zoned_utc: return err("YazaBase TIMESTAMPTZ offset normalization failed")
    let zoned_text: Text = yaza_sql_timestamptz_to_text_v1(zoned_offset)?
    if zoned_text != "2024-01-02T00:04:05.123456Z": return err("YazaBase TIMESTAMPTZ canonical UTC formatting failed")
    let negative_offset: Number = yaza_sql_timestamptz_parse_v1("2024-01-01T18:34:05.123456-05:30")?
    if negative_offset != zoned_utc: return err("YazaBase TIMESTAMPTZ negative-offset normalization failed")
    if result_is_ok(yaza_sql_timestamptz_parse_v1("2024-01-02T00:04:05")): return err("YazaBase TIMESTAMPTZ accepted a missing offset")
    if result_is_ok(yaza_sql_timestamptz_parse_v1("2024-01-02T00:04:05+14:01")): return err("YazaBase TIMESTAMPTZ accepted an offset outside ±14:00")
    if result_is_ok(yaza_sql_timestamptz_parse_v1("2024-01-02T00:04:05.0000001Z")): return err("YazaBase TIMESTAMPTZ silently accepted precision loss")
    return ok(true)

start:
    let checked: Result[Boolean, Text] = yazabase_sql_temporal_v1_smoke()
    if not result_is_ok(checked):
        say result_unwrap_error(checked)
        exit(1)
    say "yazabase-sql-temporal-v1-ok"
