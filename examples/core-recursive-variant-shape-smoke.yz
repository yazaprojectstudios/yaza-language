variant NodeLink:
    End
    Next(node: Node)

shape Node:
    value: Number
    link: NodeLink

fn node_value(node: Node) -> Number:
    return node.value

start:
    let leaf: Node = Node(3, NodeLink::End)
    let middle: Node = Node(2, NodeLink::Next(leaf))
    let root: Node = Node(1, NodeLink::Next(middle))

    assert node_value(root) == 1
    match root.link:
        End:
            assert false
        Next(child):
            assert child.value == 2
            match child.link:
                End:
                    assert false
                Next(grandchild):
                    assert grandchild.value == 3
                    match grandchild.link:
                        End:
                            assert true
                        Next(_):
                            assert false

    var editable: Node = root
    set editable.link = NodeLink::End
    match editable.link:
        End:
            assert editable.value == 1
        Next(_):
            assert false

    let nodes: List[Node] = List[Node]()
    list_push(nodes, root)
    match list_get(nodes, 0).link:
        End:
            assert false
        Next(child):
            assert child.value == 2
    say "recursive-variant-shape-ok"
