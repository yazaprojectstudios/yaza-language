use "std/db/core"
use "std/db/postgres"

fn database_postgres_rows_add_column(metadata: TextList, name: Text, type_oid: Number, format_code: Number) -> Boolean:
    list_push(metadata, name)
    list_push(metadata, "0")
    list_push(metadata, "0")
    list_push(metadata, number_text(type_oid))
    list_push(metadata, "-1")
    list_push(metadata, "-1")
    list_push(metadata, number_text(format_code))
    return true

fn database_postgres_rows_add_cell(values: TextList, null_flags: TextList, value: Text, is_null: Boolean) -> Boolean:
    list_push(values, value)
    if is_null:
        list_push(null_flags, "1")
    else:
        list_push(null_flags, "0")
    return true

fn database_postgres_rows_test_value(row: DbRow, name: Text) -> DbValue:
    let found: Result[DbColumnLookup, DbError] = db_row_find(row, name)
    if not result_is_ok(found):
        return DbValue::Null
    match result_unwrap(found):
        ColumnFound(value):
            return value
        ColumnMissing:
            return DbValue::Null
        ColumnAmbiguous:
            return DbValue::Null
    return DbValue::Null

start:
    let metadata: TextList = text_list()
    database_postgres_rows_add_column(metadata, "id", 20, 0)
    database_postgres_rows_add_column(metadata, "stock", 23, 0)
    database_postgres_rows_add_column(metadata, "small", 21, 0)
    database_postgres_rows_add_column(metadata, "object", 26, 0)
    database_postgres_rows_add_column(metadata, "active", 16, 0)
    database_postgres_rows_add_column(metadata, "title", 25, 0)
    database_postgres_rows_add_column(metadata, "note", 25, 0)
    database_postgres_rows_add_column(metadata, "payload", 17, 0)
    database_postgres_rows_add_column(metadata, "score", 701, 0)

    let values: TextList = text_list()
    let null_flags: TextList = text_list()
    database_postgres_rows_add_cell(values, null_flags, "9223372036854775807", false)
    database_postgres_rows_add_cell(values, null_flags, "-2147483648", false)
    database_postgres_rows_add_cell(values, null_flags, "-32768", false)
    database_postgres_rows_add_cell(values, null_flags, "4294967295", false)
    database_postgres_rows_add_cell(values, null_flags, "t", false)
    database_postgres_rows_add_cell(values, null_flags, "YAZA", false)
    database_postgres_rows_add_cell(values, null_flags, "", false)
    let slash: Option[Text] = bytes_to_text_checked(bytes_from_number(92))
    assert option_is_some(slash)
    database_postgres_rows_add_cell(values, null_flags, option_unwrap(slash) + "x414200", false)
    database_postgres_rows_add_cell(values, null_flags, "1.25e2", false)
    database_postgres_rows_add_cell(values, null_flags, "", true)
    database_postgres_rows_add_cell(values, null_flags, "2147483647", false)
    database_postgres_rows_add_cell(values, null_flags, "32767", false)
    database_postgres_rows_add_cell(values, null_flags, "1", false)
    database_postgres_rows_add_cell(values, null_flags, "f", false)
    database_postgres_rows_add_cell(values, null_flags, "", true)
    database_postgres_rows_add_cell(values, null_flags, "present", false)
    database_postgres_rows_add_cell(values, null_flags, "", true)
    database_postgres_rows_add_cell(values, null_flags, "-1.5e2", false)

    let query_result: PgQueryResult = PgQueryResult(metadata, values, null_flags, "SELECT 2", 1, 2, PgTransactionStatus::Idle)
    let rows_result: Result[List[DbRow], DbError] = db_postgres_rows(query_result)
    assert result_is_ok(rows_result)
    let rows: List[DbRow] = result_unwrap(rows_result)
    assert list_count(rows) == 2

    let first: DbRow = list_get(rows, 0)
    assert list_count(first.columns) == 9
    assert number_text(option_unwrap(db_value_as_int64(database_postgres_rows_test_value(first, "id")))) == "9223372036854775807"
    assert int32_text(option_unwrap(db_value_as_int32(database_postgres_rows_test_value(first, "stock")))) == "-2147483648"
    assert int32_text(option_unwrap(db_value_as_int32(database_postgres_rows_test_value(first, "small")))) == "-32768"
    assert number_text(option_unwrap(db_value_as_int64(database_postgres_rows_test_value(first, "object")))) == "4294967295"
    assert option_unwrap(db_value_as_boolean(database_postgres_rows_test_value(first, "active")))
    assert option_unwrap(db_value_as_text(database_postgres_rows_test_value(first, "title"))) == "YAZA"
    assert option_unwrap(db_value_as_text(database_postgres_rows_test_value(first, "note"))) == ""
    let payload: Bytes = option_unwrap(db_value_as_bytes(database_postgres_rows_test_value(first, "payload")))
    assert bytes_length(payload) == 3
    assert bytes_get(payload, 0) == 65
    assert bytes_get(payload, 1) == 66
    assert bytes_get(payload, 2) == 0
    assert option_unwrap(db_value_as_float64(database_postgres_rows_test_value(first, "score"))) == 125.0

    let second: DbRow = list_get(rows, 1)
    assert db_value_is_null(database_postgres_rows_test_value(second, "id"))
    assert int32_text(option_unwrap(db_value_as_int32(database_postgres_rows_test_value(second, "stock")))) == "2147483647"
    assert int32_text(option_unwrap(db_value_as_int32(database_postgres_rows_test_value(second, "small")))) == "32767"
    assert option_unwrap(db_value_as_int64(database_postgres_rows_test_value(second, "object"))) == 1
    assert not option_unwrap(db_value_as_boolean(database_postgres_rows_test_value(second, "active")))
    assert db_value_is_null(database_postgres_rows_test_value(second, "title"))
    assert option_unwrap(db_value_as_text(database_postgres_rows_test_value(second, "note"))) == "present"
    assert db_value_is_null(database_postgres_rows_test_value(second, "payload"))
    assert option_unwrap(db_value_as_float64(database_postgres_rows_test_value(second, "score"))) == -150.0

    let direct_row: Result[DbRow, DbError] = db_postgres_row(query_result, 1)
    assert result_is_ok(direct_row)
    assert db_value_is_null(database_postgres_rows_test_value(result_unwrap(direct_row), "id"))
    let invalid_index: Result[DbRow, DbError] = db_postgres_row(query_result, 2)
    assert not result_is_ok(invalid_index)
    assert db_error_code(result_unwrap_error(invalid_index).kind) == "configuration"

    let empty_values: TextList = text_list()
    let empty_null_flags: TextList = text_list()
    let empty_result: PgQueryResult = PgQueryResult(metadata, empty_values, empty_null_flags, "SELECT 0", 1, 0, PgTransactionStatus::Idle)
    let empty_rows: Result[List[DbRow], DbError] = db_postgres_rows(empty_result)
    assert result_is_ok(empty_rows)
    assert list_count(result_unwrap(empty_rows)) == 0

    let decimal_metadata: TextList = text_list()
    database_postgres_rows_add_column(decimal_metadata, "amount", 1700, 0)
    let decimal_values: TextList = text_list()
    let decimal_nulls: TextList = text_list()
    database_postgres_rows_add_cell(decimal_values, decimal_nulls, "12345678901234567890.000100", false)
    let decimal_result: PgQueryResult = PgQueryResult(decimal_metadata, decimal_values, decimal_nulls, "SELECT 1", 1, 1, PgTransactionStatus::Idle)
    let decimal_rows: Result[List[DbRow], DbError] = db_postgres_rows(decimal_result)
    assert result_is_ok(decimal_rows)
    assert option_unwrap(db_value_as_decimal(database_postgres_rows_test_value(list_get(result_unwrap(decimal_rows), 0), "amount"))) == "12345678901234567890.000100"

    let temporal_metadata: TextList = text_list()
    database_postgres_rows_add_column(temporal_metadata, "day", 1082, 0)
    database_postgres_rows_add_column(temporal_metadata, "clock", 1083, 0)
    database_postgres_rows_add_column(temporal_metadata, "clock_zone", 1266, 0)
    database_postgres_rows_add_column(temporal_metadata, "created_at", 1114, 0)
    database_postgres_rows_add_column(temporal_metadata, "created_at_zone", 1184, 0)
    let temporal_values: TextList = text_list()
    let temporal_nulls: TextList = text_list()
    database_postgres_rows_add_cell(temporal_values, temporal_nulls, "2024-02-29", false)
    database_postgres_rows_add_cell(temporal_values, temporal_nulls, "23:59:59.123456", false)
    database_postgres_rows_add_cell(temporal_values, temporal_nulls, "23:59:59-05:30", false)
    database_postgres_rows_add_cell(temporal_values, temporal_nulls, "2024-02-29 23:59:59.123456", false)
    database_postgres_rows_add_cell(temporal_values, temporal_nulls, "2024-02-29 23:59:59.123456+05:30", false)
    let temporal_result: PgQueryResult = PgQueryResult(temporal_metadata, temporal_values, temporal_nulls, "SELECT 1", 1, 1, PgTransactionStatus::Idle)
    let temporal_rows: Result[List[DbRow], DbError] = db_postgres_rows(temporal_result)
    assert result_is_ok(temporal_rows)
    let temporal_row: DbRow = list_get(result_unwrap(temporal_rows), 0)
    assert option_unwrap(db_value_as_temporal_text(database_postgres_rows_test_value(temporal_row, "day"))) == "2024-02-29"
    assert option_unwrap(db_value_as_temporal_text(database_postgres_rows_test_value(temporal_row, "clock"))) == "23:59:59.123456"
    assert option_unwrap(db_value_as_temporal_text(database_postgres_rows_test_value(temporal_row, "clock_zone"))) == "23:59:59-05:30"
    assert option_unwrap(db_value_as_temporal_text(database_postgres_rows_test_value(temporal_row, "created_at"))) == "2024-02-29 23:59:59.123456"
    assert option_unwrap(db_value_as_temporal_text(database_postgres_rows_test_value(temporal_row, "created_at_zone"))) == "2024-02-29 23:59:59.123456+05:30"

    let duplicate_metadata: TextList = text_list()
    database_postgres_rows_add_column(duplicate_metadata, "label", 25, 0)
    database_postgres_rows_add_column(duplicate_metadata, "label", 25, 0)
    let duplicate_values: TextList = text_list()
    let duplicate_nulls: TextList = text_list()
    database_postgres_rows_add_cell(duplicate_values, duplicate_nulls, "left", false)
    database_postgres_rows_add_cell(duplicate_values, duplicate_nulls, "right", false)
    let duplicate_result: PgQueryResult = PgQueryResult(duplicate_metadata, duplicate_values, duplicate_nulls, "SELECT 1", 1, 1, PgTransactionStatus::Idle)
    let duplicate_rows: Result[List[DbRow], DbError] = db_postgres_rows(duplicate_result)
    assert result_is_ok(duplicate_rows)
    match result_unwrap(db_row_find(list_get(result_unwrap(duplicate_rows), 0), "label")):
        ColumnAmbiguous:
            assert true
        ColumnFound(_):
            assert false
        ColumnMissing:
            assert false

    let unsupported_metadata: TextList = text_list()
    database_postgres_rows_add_column(unsupported_metadata, "unsupported", 99999, 0)
    let unsupported_result: PgQueryResult = PgQueryResult(unsupported_metadata, empty_values, empty_null_flags, "SELECT 0", 1, 0, PgTransactionStatus::Idle)
    let unsupported_rows: Result[List[DbRow], DbError] = db_postgres_rows(unsupported_result)
    assert not result_is_ok(unsupported_rows)
    assert db_error_code(result_unwrap_error(unsupported_rows).kind) == "unsupported_feature"
    let unsupported_null_values: TextList = text_list()
    let unsupported_null_flags: TextList = text_list()
    database_postgres_rows_add_cell(unsupported_null_values, unsupported_null_flags, "", true)
    let unsupported_null_result: PgQueryResult = PgQueryResult(unsupported_metadata, unsupported_null_values, unsupported_null_flags, "SELECT 1", 1, 1, PgTransactionStatus::Idle)
    let unsupported_null_value: Result[DbValue, DbError] = db_postgres_read_value(unsupported_null_result, 0, 0)
    assert not result_is_ok(unsupported_null_value)
    assert db_error_code(result_unwrap_error(unsupported_null_value).kind) == "unsupported_feature"

    let binary_metadata: TextList = text_list()
    database_postgres_rows_add_column(binary_metadata, "id", 20, 1)
    let binary_result: PgQueryResult = PgQueryResult(binary_metadata, empty_values, empty_null_flags, "SELECT 0", 1, 0, PgTransactionStatus::Idle)
    assert not result_is_ok(db_postgres_rows(binary_result))

    var oversized_metadata: TextList = text_list()
    var oversized_column_index: Number = 0
    while oversized_column_index < 257:
        database_postgres_rows_add_column(oversized_metadata, "value" + number_text(oversized_column_index), 25, 0)
        set oversized_column_index = oversized_column_index + 1
    let oversized_result: PgQueryResult = PgQueryResult(oversized_metadata, empty_values, empty_null_flags, "SELECT 0", 1, 0, PgTransactionStatus::Idle)
    let oversized_rows: Result[List[DbRow], DbError] = db_postgres_rows(oversized_result)
    assert not result_is_ok(oversized_rows)
    assert db_error_code(result_unwrap_error(oversized_rows).kind) == "unsupported_feature"

    let wide_metadata: TextList = text_list()
    database_postgres_rows_add_column(wide_metadata, "a", 25, 0)
    database_postgres_rows_add_column(wide_metadata, "b", 25, 0)
    database_postgres_rows_add_column(wide_metadata, "c", 25, 0)
    let oversized_cells: PgQueryResult = PgQueryResult(wide_metadata, empty_values, empty_null_flags, "SELECT 0", 1, 3334, PgTransactionStatus::Idle)
    let oversized_cell_rows: Result[List[DbRow], DbError] = db_postgres_rows(oversized_cells)
    assert not result_is_ok(oversized_cell_rows)
    assert db_error_code(result_unwrap_error(oversized_cell_rows).kind) == "unsupported_feature"

    let corrupt_values: TextList = text_list()
    let corrupt_nulls: TextList = text_list()
    database_postgres_rows_add_cell(corrupt_values, corrupt_nulls, "9223372036854775808", false)
    let corrupt_metadata: TextList = text_list()
    database_postgres_rows_add_column(corrupt_metadata, "id", 20, 0)
    let corrupt_result: PgQueryResult = PgQueryResult(corrupt_metadata, corrupt_values, corrupt_nulls, "SELECT 1", 1, 1, PgTransactionStatus::Idle)
    let corrupt_rows: Result[List[DbRow], DbError] = db_postgres_rows(corrupt_result)
    assert not result_is_ok(corrupt_rows)
    assert db_error_code(result_unwrap_error(corrupt_rows).kind) == "protocol"

    let malformed_result: PgQueryResult = PgQueryResult(corrupt_metadata, empty_values, empty_null_flags, "SELECT 1", 1, 1, PgTransactionStatus::Idle)
    let malformed_rows: Result[List[DbRow], DbError] = db_postgres_rows(malformed_result)
    assert not result_is_ok(malformed_rows)
    assert db_error_code(result_unwrap_error(malformed_rows).kind) == "protocol"

    let invalid_marker_values: TextList = text_list()
    let invalid_marker_nulls: TextList = text_list()
    list_push(invalid_marker_values, "1")
    list_push(invalid_marker_nulls, "2")
    let invalid_marker_result: PgQueryResult = PgQueryResult(corrupt_metadata, invalid_marker_values, invalid_marker_nulls, "SELECT 1", 1, 1, PgTransactionStatus::Idle)
    let invalid_marker_rows: Result[List[DbRow], DbError] = db_postgres_rows(invalid_marker_result)
    assert not result_is_ok(invalid_marker_rows)
    assert db_error_code(result_unwrap_error(invalid_marker_rows).kind) == "protocol"

    let selected_columns: TextList = text_list()
    list_push(selected_columns, "id")
    let select_query: Result[DbSelect, DbError] = db_select_new("products", selected_columns)
    assert result_is_ok(select_query)
    let failed_select: Result[List[DbRow], DbError] = db_postgres_select_rows(-1, result_unwrap(select_query), 100)
    assert not result_is_ok(failed_select)
    assert db_error_code(result_unwrap_error(failed_select).kind) == "unavailable"
