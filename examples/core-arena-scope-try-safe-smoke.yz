impl From[Number] for Float64:
    fn from(value: Number) -> Float64:
        return float64_from_number(value)

fn propagate_outer_error(value: Result[Number, Text]) -> Result[Number, Text]:
    arena_scope 4096:
        let number: Number = value?
        return ok(number)

fn scoped_concat_length(left: Text, right: Text) -> Result[Number, Text]:
    arena_scope 4096:
        let joined: Text = text_try_concat(left, right)?
        return ok(text_length(joined))

fn propagate_converted_error(value: Result[Number, Number]) -> Result[Number, Float64]:
    arena_scope 4096:
        let number: Number = value?
        return ok(number)

fn scoped_concat_quota_failure(left: Text, right: Text) -> Result[Number, Text]:
    arena_scope 1:
        let joined: Text = text_try_concat(left, right)?
        return ok(text_length(joined))

start:
    let source_error: Result[Number, Text] = err("outer error")
    let propagated: Result[Number, Text] = propagate_outer_error(source_error)
    assert not result_is_ok(propagated)
    assert result_unwrap_error(propagated) == "outer error"

    let source_number_error: Result[Number, Number] = err(5)
    let converted: Result[Number, Float64] = propagate_converted_error(source_number_error)
    assert not result_is_ok(converted)
    assert result_unwrap_error(converted) == float64_from_number(5)

    let success: Result[Number, Text] = scoped_concat_length("arena ", "safe")
    assert result_is_ok(success)
    assert result_unwrap(success) == 10

    let quota_error: Result[Number, Text] = scoped_concat_quota_failure("a", "b")
    assert not result_is_ok(quota_error)
    assert result_unwrap_error(quota_error) == "Could not allocate Text in the active arena"
    assert arena_live_scopes() == 0
    say "scoped-postfix-question-cleanup-ok"
