use "std/smtp"

start:
    assert smtp_address_valid("alice@example.com")
    assert not smtp_address_valid("alice@example.com\r\nBCC: intruder@example.com")
    assert not smtp_address_valid("alice@@example.com")
    assert not smtp_address_valid("alice@-example.com")
    assert not smtp_address_valid("alice@exa..mple.com")
    assert not smtp_subject_valid("hello\r\nBcc: intruder@example.com")
    assert smtp_rfc5322_date_from_unix_ms(0) == "Thu, 01 Jan 1970 00:00:00 +0000"
    assert smtp_rfc5322_date_from_unix_ms(1795132800000) == "Fri, 20 Nov 2026 00:00:00 +0000"
    let message: SmtpMessage = SmtpMessage("alice@example.com", "bob@example.com", "Welcome", "hello\r\n.unsafe\nworld")
    let formatted: Result[Text, Text] = smtp_format_message(message, 0)
    assert result_is_ok(formatted)
    let wire: Text = result_unwrap(formatted)
    assert text_find(wire, "From: <alice@example.com>\r\n") == 0
    assert text_find(wire, "Content-Transfer-Encoding: base64\r\n") > 0
    assert text_find(wire, "\r\n.unsafe") < 0
    assert text_find(wire, "aGVsbG8N") > 0
    say "smtp-format-smoke passed"
