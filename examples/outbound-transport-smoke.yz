use "std/http_client"
use "std/smtp"

start:
    let insecure: Result[HttpsResponse, Text] = http_client_get("http://127.0.0.1:443/", "")
    assert not result_is_ok(insecure)
    let bad_method: Result[HttpsResponse, Text] = http_client_request("CONNECT", "https://example.com/", bytes_empty(), "", 1000, 1024)
    assert not result_is_ok(bad_method)
    let message: SmtpMessage = SmtpMessage("alice@example.com", "bob@example.com", "Hello", "Body")
    let bad_provider: Result[Boolean, Text] = smtp_send_secure("unknown", "password", "alice", "secret", message, 1000)
    assert not result_is_ok(bad_provider)
    let bad_auth: Result[Boolean, Text] = smtp_send_secure("brevo", "oauth2", "alice", "secret", message, 1000)
    assert not result_is_ok(bad_auth)
    let bad_envelope: Result[Boolean, Text] = smtp_secure_send("brevo", "password", "login", "secret", "alice@example.com> SIZE=0", "bob@example.com", "Message", 1000)
    assert not result_is_ok(bad_envelope)
    say "outbound-transport-smoke passed"
