use "std/db/core"
use "std/mssql/protocol"
use "std/db/mssql"

start:
    # 1. Setup column metadata
    # id: INT (56)
    let cm_id: TdsColumnMetadata = TdsColumnMetadata(0, 0, 56, 4, "id")
    # title: NVARCHAR (231)
    let cm_title: TdsColumnMetadata = TdsColumnMetadata(0, 0, 231, 100, "title")
    # price: DECIMALN (106)
    let cm_price: TdsColumnMetadata = TdsColumnMetadata(0, 0, 106, 9, "price")
    # active: BIT (50)
    let cm_active: TdsColumnMetadata = TdsColumnMetadata(0, 0, 50, 1, "active")
    # created_at: DATETIME2 (42)
    let cm_created: TdsColumnMetadata = TdsColumnMetadata(0, 0, 42, 8, "created_at")

    let columns: List[TdsColumnMetadata] = List[TdsColumnMetadata]()
    list_push(columns, cm_id)
    list_push(columns, cm_title)
    list_push(columns, cm_price)
    list_push(columns, cm_active)
    list_push(columns, cm_created)

    # 2. Setup row data
    let cell_vals: TextList = text_list()
    let null_flags: TextList = text_list()
    list_push(cell_vals, "5001")
    list_push(null_flags, "false")
    list_push(cell_vals, "Enterprise License")
    list_push(null_flags, "false")
    list_push(cell_vals, "1999.99")
    list_push(null_flags, "false")
    list_push(cell_vals, "1")
    list_push(null_flags, "false")
    list_push(cell_vals, "2026-11-16 11:35:00")
    list_push(null_flags, "false")
    let row1: TdsRow = TdsRow(cell_vals, null_flags)

    # 3. Decode row to DbRow
    let db_row_res: Result[DbRow, DbError] = db_mssql_row_to_dbrow(columns, row1)
    assert result_is_ok(db_row_res)
    let db_row: DbRow = result_unwrap(db_row_res)
    assert list_count(db_row.columns) == 5

    # Check ID is Int32
    let val_id: DbValue = list_get(db_row.columns, 0).value
    assert option_is_some(db_value_as_int32(val_id))
    assert int32_text(option_unwrap(db_value_as_int32(val_id))) == "5001"

    # Check Title is Text
    let val_title: DbValue = list_get(db_row.columns, 1).value
    assert option_is_some(db_value_as_text(val_title))
    assert option_unwrap(db_value_as_text(val_title)) == "Enterprise License"

    # Check Price is Decimal
    let val_price: DbValue = list_get(db_row.columns, 2).value
    assert option_is_some(db_value_as_decimal(val_price))
    assert option_unwrap(db_value_as_decimal(val_price)) == "1999.99"

    # Check Active is Boolean
    let val_active: DbValue = list_get(db_row.columns, 3).value
    assert option_is_some(db_value_as_boolean(val_active))
    assert option_unwrap(db_value_as_boolean(val_active))

    # Check Created is Timestamp
    let val_created: DbValue = list_get(db_row.columns, 4).value
    assert option_is_some(db_value_as_temporal_text(val_created))
    assert option_unwrap(db_value_as_temporal_text(val_created)) == "2026-11-16 11:35:00"

    # 4. Null column test
    let cell_vals_null: TextList = text_list()
    let null_flags_null: TextList = text_list()
    list_push(cell_vals_null, "")
    list_push(null_flags_null, "true")
    list_push(cell_vals_null, "")
    list_push(null_flags_null, "true")
    list_push(cell_vals_null, "")
    list_push(null_flags_null, "true")
    list_push(cell_vals_null, "")
    list_push(null_flags_null, "true")
    list_push(cell_vals_null, "")
    list_push(null_flags_null, "true")
    let row_null: TdsRow = TdsRow(cell_vals_null, null_flags_null)

    let db_row_null_res: Result[DbRow, DbError] = db_mssql_row_to_dbrow(columns, row_null)
    assert result_is_ok(db_row_null_res)
    let db_row_null: DbRow = result_unwrap(db_row_null_res)
    assert db_value_is_null(list_get(db_row_null.columns, 0).value)
    assert db_value_is_null(list_get(db_row_null.columns, 1).value)
    assert db_value_is_null(list_get(db_row_null.columns, 2).value)
