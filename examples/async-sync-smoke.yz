use "std/time"
use "std/async"
use "std/sync"

async fn producer_task(ch: AsyncChannel, count: Number) -> Number:
    var i: Number = 1
    while i <= count:
        assert(async_channel_send(ch, i))
        set i = i + 1
    let closed_ch: AsyncChannel = async_channel_close(ch)
    assert(async_channel_is_closed(closed_ch))
    return count

async fn consumer_task(ch: AsyncChannel, sum_atomic: AtomicNumber) -> Number:
    var total: Number = 0
    while true:
        let item: Option[Number] = async_channel_recv(ch)
        if not option_is_some(item):
            break
        let val: Number = option_unwrap(item)
        set total = total + val
        atomic_add(sum_atomic, val)
    return total

start:
    let now_ns: Number = time_now_monotonic_ns()
    let now_ms: Number = time_now_unix_ms()
    let workers: Number = async_worker_count()

    say "Monotonic NS: " + number_text(now_ns)
    say "Unix Epoch MS: " + number_text(now_ms)
    say "Worker count (hardware CPUs): " + number_text(workers)

    assert now_ns > 0
    # UNIX epoch ms in 2026+ must be > 1,700,000,000,000 (not uptime monotonic_ms!)
    assert now_ms > 1700000000000
    assert workers >= 1

    # Real producer-consumer bounded channel across spawned tasks
    let ch: AsyncChannel = async_channel_create(4)
    let sum_atomic: AtomicNumber = atomic_create(0)
    let tp: Task[Number] = spawn producer_task(ch, 10)
    let tc: Task[Number] = spawn consumer_task(ch, sum_atomic)
    assert(await tp == 10)
    assert(await tc == 55)
    assert(atomic_load(sum_atomic) == 55)

    say "async-sync-smoke passed!"
