fn append_effect(effects: List[Number]) -> Number:
    list_push(effects, 99)
    return list_count(effects)

start:
    let outputs: List[Number] = List[Number]()
    let effects: List[Number] = List[Number]()
    list_push(outputs, append_effect(effects))
    assert list_count(effects) == 1
    assert list_get(effects, 0) == 99
    assert list_count(outputs) == 1
    assert list_get(outputs, 0) == 1

    let try_outputs: List[Number] = List[Number]()
    let try_effects: List[Number] = List[Number]()
    assert list_try_push(try_outputs, append_effect(try_effects))
    assert list_count(try_effects) == 1
    assert list_get(try_effects, 0) == 99
    assert list_count(try_outputs) == 1
    assert list_get(try_outputs, 0) == 1
