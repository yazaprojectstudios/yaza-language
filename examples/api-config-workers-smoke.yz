use "std/config/api_config"

start:
    let automatic: Result[ApiServiceConfig, Text] = api_config_parse("[api.resources]\nprofile = \"balanced\"\nworkers = \"auto\"\n")
    assert result_is_ok(automatic)
    let automatic_config: ApiServiceConfig = result_unwrap(automatic)
    let auto_workers: Number = automatic_config.resources.worker_threads
    assert auto_workers >= 1 and auto_workers <= 32
    assert auto_workers <= processor_count()

    let explicit: Result[ApiServiceConfig, Text] = api_config_parse("[api.resources]\nprofile = \"balanced\"\nworkers = 3\n")
    assert result_is_ok(explicit)
    let explicit_config: ApiServiceConfig = result_unwrap(explicit)
    assert explicit_config.resources.worker_threads == 3
    assert explicit_config.resources.worker_threads_source == "explicit"

    let reduced: Result[ApiServiceConfig, Text] = api_config_parse("[api.resources]\nprofile = \"low_memory\"\nmax_in_flight = 2\nworkers = \"auto\"\n")
    assert result_is_ok(reduced)
    let reduced_config: ApiServiceConfig = result_unwrap(reduced)
    assert reduced_config.resources.worker_threads <= 2

    let bad: Result[ApiServiceConfig, Text] = api_config_parse("[api.resources]\nworkers = 33\n")
    assert not result_is_ok(bad)
    let zero: Result[ApiServiceConfig, Text] = api_config_parse("[api.resources]\nworkers = 0\n")
    assert not result_is_ok(zero)
    say "api-config-workers-smoke passed"
