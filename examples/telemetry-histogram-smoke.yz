use "std/telemetry"

start:
    let hist: LatencyHistogram = telemetry_latency_new()
    assert telemetry_latency_record(hist, 500000)
    assert telemetry_latency_record(hist, 1500000)
    assert telemetry_latency_record(hist, 7000000)
    assert telemetry_latency_record(hist, 200000000)
    assert telemetry_latency_cumulative(hist, 1) == 1
    assert telemetry_latency_cumulative(hist, 3) == 2
    assert telemetry_latency_cumulative(hist, 8) == 4
    assert telemetry_latency_percentile_upper_ms(hist, 50) == 2
    assert telemetry_latency_percentile_upper_ms(hist, 95) == 101
    let metrics: Text = telemetry_latency_prometheus(hist)
    assert text_find(metrics, "yaza_http_request_duration_ms_count 4") > 0
    say "telemetry-histogram-smoke passed"
