fn append_text(target: List[Text], value: Text) -> Unit:
    list_push(target, value)
fn append_from_child(target: TextList) -> Number:
    arena_scope 2048:
        let temporary: Text = "callee-child"
        list_push(target, temporary)
    return 0
start:
    let output: List[Text] = List[Text]()
    let legacy_output: TextList = text_list()
    arena_scope 4096:
        let temporary: Text = "child-" + number_text(7)
        append_text(output, temporary)
        list_push(legacy_output, temporary)
        assert list_try_push(output, temporary)
        list_set(output, 0, temporary)
    append_from_child(legacy_output)
    assert list_get(output, 0) == "child-7"
    assert list_get(output, 1) == "child-7"
    assert list_get(legacy_output, 0) == "child-7"
    assert list_get(legacy_output, 1) == "callee-child"
    say "parent-list-text-copies-survived"
