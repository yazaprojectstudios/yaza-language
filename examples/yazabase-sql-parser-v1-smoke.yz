use "../yazabase/sql_parser_v1"

fn yaza_base_sql_parser_v1_smoke() -> Boolean:
    let source: Text = "SELECT DISTINCT id, name FROM products WHERE price >= :floor ORDER BY price DESC, id ASC LIMIT 25;"
    let parsed: Result[YazaSqlSelectAstV1, Text] = yaza_sql_parse_select_v1(source)
    if not result_is_ok(parsed): return false
    let query: YazaSqlSelectAstV1 = result_unwrap(parsed)
    if query.version != 1 or not query.distinct: return false
    if query.start_byte != 0 or query.end_byte != text_length(source): return false
    if list_count(query.projections) != 2: return false
    let first_projection: YazaSqlProjectionV1 = list_get(query.projections, 0)
    let second_projection: YazaSqlProjectionV1 = list_get(query.projections, 1)
    if first_projection.is_star or second_projection.is_star: return false
    if text_slice(source, first_projection.token.start_byte, first_projection.token.end_byte - first_projection.token.start_byte) != "id": return false
    if text_slice(source, second_projection.token.start_byte, second_projection.token.end_byte - second_projection.token.start_byte) != "name": return false
    if text_slice(source, query.table.start_byte, query.table.end_byte - query.table.start_byte) != "products": return false
    if not query.has_where or query.where_operator != 6 or query.where_value.kind != 5: return false
    if text_slice(source, query.where_column.start_byte, query.where_column.end_byte - query.where_column.start_byte) != "price": return false
    if text_slice(source, query.where_value.start_byte, query.where_value.end_byte - query.where_value.start_byte) != ":floor": return false
    if list_count(query.order_by) != 2: return false
    let first_order: YazaSqlOrderTermV1 = list_get(query.order_by, 0)
    let second_order: YazaSqlOrderTermV1 = list_get(query.order_by, 1)
    if not first_order.descending or second_order.descending: return false
    if query.limit != 25 or not query.has_limit: return false

    let lowercase: Result[YazaSqlSelectAstV1, Text] = yaza_sql_parse_select_v1("select * from users")
    if not result_is_ok(lowercase): return false
    let star_query: YazaSqlSelectAstV1 = result_unwrap(lowercase)
    if list_count(star_query.projections) != 1 or not list_get(star_query.projections, 0).is_star: return false

    let invalid_start: Result[YazaSqlSelectAstV1, Text] = yaza_sql_parse_select_v1("DELETE FROM users")
    if result_is_ok(invalid_start): return false
    if result_unwrap_error(invalid_start) != "SQL parser expected SELECT at byte 0": return false

    let decimal_limit: Result[YazaSqlSelectAstV1, Text] = yaza_sql_parse_select_v1("SELECT id FROM users LIMIT 1.5")
    if result_is_ok(decimal_limit): return false
    let excessive_limit: Result[YazaSqlSelectAstV1, Text] = yaza_sql_parse_select_v1("SELECT id FROM users LIMIT 1000001")
    if result_is_ok(excessive_limit): return false
    let max_limit: Result[YazaSqlSelectAstV1, Text] = yaza_sql_parse_select_v1("SELECT id FROM users LIMIT 1000000")
    if not result_is_ok(max_limit) or result_unwrap(max_limit).limit != 1000000: return false
    let second_statement: Result[YazaSqlSelectAstV1, Text] = yaza_sql_parse_select_v1("SELECT id FROM users; DELETE FROM users")
    if result_is_ok(second_statement): return false
    return true

start:
    let initial_used: Number = arena_used()
    arena_scope 65536:
        assert yaza_base_sql_parser_v1_smoke()
    assert arena_used() == initial_used
    say "yazabase-sql-parser-v1-ok"
