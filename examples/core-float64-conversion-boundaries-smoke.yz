start:
    let minimum_exact: Float64 = float64_from_number(number_parse("-9007199254740992"))
    let maximum_exact: Float64 = float64_from_number(number_parse("9007199254740992"))
    let minimum_number: Number = number_from_float64(float64_parse("-9223372036854775808"))
    let maximum_representable_number: Number = number_from_float64(float64_parse("9223372036854774784"))
    assert float64_text(minimum_exact) == "-9007199254740992"
    assert float64_text(maximum_exact) == "9007199254740992"
    assert number_text(minimum_number) == "-9223372036854775808"
    assert number_text(maximum_representable_number) == "9223372036854774784"
    say "float64-conversion-boundaries-ok"
