use "std/crypto/hash"
use "std/time"

start:
    let key: Text = crypto_sha256_hex("test-login-user")
    let now_ms: Number = time_now_monotonic_ms()
    var i: Number = 0
    while i < 5:
        assert(login_attempt(key, now_ms, false))
        set i = i + 1
    assert(not login_attempt(key, now_ms, false))
    assert(login_attempt(key, now_ms, true))
    assert(login_attempt(key, now_ms, false))
    assert(login_attempt(key, now_ms + 900001, false))
    assert(not login_attempt("bad", now_ms, false))
    say "login-limiter-smoke passed"
