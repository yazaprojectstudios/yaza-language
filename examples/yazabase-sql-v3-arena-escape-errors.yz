use "../yazabase/sql_parser_v3"

fn yaza_base_leak_select_ast_v3() -> Result[YazaSqlSelectAstV3, Text]:
    arena_scope 65536:
        return yaza_sql_parse_select_v3("SELECT id FROM users WHERE active = TRUE OR count > 0")

start:
    let escaped: Result[YazaSqlSelectAstV3, Text] = yaza_base_leak_select_ast_v3()
    assert not result_is_ok(escaped)
