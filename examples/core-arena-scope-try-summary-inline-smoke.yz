fn maybe_use(input: Result[Number, Number], fallback: Result[Number, Number]) -> Result[Number, Number]:
    let value: Number = input?
    return fallback

start:
    var escaped: Result[Number, Number] = err(0)
    let fallback: Result[Number, Number] = err(9)
    arena_scope 4096:
        let failed: Result[Number, Number] = err(7)
        set escaped = maybe_use(failed, fallback)
    assert not result_is_ok(escaped)
    assert result_unwrap_error(escaped) == 7
    say "inline-try-summary-ok"
