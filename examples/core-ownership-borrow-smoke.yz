# Core 2 Borrowing: shared (&T) and exclusive mutable (edit T) borrows
shape Counter:
    count: Number
    label: Text

fn read_counter(c: &Counter) -> Number:
    return c.count

fn increment(c: edit Counter, step: Number) -> Number:
    set c.count = c.count + step
    return c.count

start:
    var c: Counter = Counter(10, "metrics")

    # Multiple shared borrows allowed concurrently
    let r1: Number = read_counter(&c)
    let r2: Number = read_counter(&c)
    assert(r1 == 10)
    assert(r2 == 10)

    # Exclusive mutable borrow can update fields
    let updated: Number = increment(edit c, 5)
    assert(updated == 15)
    assert(c.count == 15)

    # Subsequent borrows allowed after previous borrow ends
    let next: Number = increment(edit c, 10)
    assert(next == 25)
    assert(c.count == 25)

    say "ownership borrow smoke passed"
