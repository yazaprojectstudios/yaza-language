shape Payloads:
    items: List[Bytes]

shape Envelope:
    label: Text
    payloads: Payloads

variant Pick:
    First
    Second

fn build(label: Text, payloads: Payloads) -> Envelope:
    return Envelope(label, payloads)

fn keep(value: Envelope) -> Envelope:
    return value

fn append(value: Envelope, item: Bytes) -> Unit:
    list_push(value.payloads.items, item)

fn choose(pick: Pick, left: Envelope, right: Envelope) -> Envelope:
    let result: Envelope = match pick:
        First -> left
        Second -> right
    return result

start:
    let parent_label: Text = "parent " + number_text(1)
    arena_scope 4096:
        let local_bytes: Bytes = bytes_from_text("child")
        let built: Envelope = build(parent_label, Payloads(List[Bytes]()))
        let returned: Envelope = keep(built)
        let selected: Envelope = choose(Pick::First, returned, returned)
        append(selected, local_bytes)
        assert list_count(selected.payloads.items) == 1
    say "interprocedural-field-ownership-ok"
