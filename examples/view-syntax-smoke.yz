# Smoke test for first-class YAZA native `view` syntax (zero list_push, zero quote escaping, XSS auto-escaped).
use "std/web/view"

view render_badge(label: Text, active: Boolean):
    if active:
        <span class="badge is-active">{{ label }}</span>
    else:
        <span class="badge">{{ label }}</span>

view render_card(title: Text, items: TextList, show_footer: Boolean):
    <section class="card" data-kind="demo">
      <header class="card-head">
        <h2>{{ title }}</h2>
        {! render_badge("Arena-SSR", true) !}
      </header>
      <ul class="card-list">
        var i: Number = 0
        while i < list_count(items):
            let item: Text = list_get(items, i)
            <li>{{ item }}</li>
            set i = i + 1
      </ul>
      if show_footer:
          <footer>
            | Powered by YAZA {{ number_text(list_count(items)) }} items
          </footer>
    </section>

start:
    let items: TextList = text_list()
    list_push(items, "Zero-GC Arena")
    list_push(items, "XSS <script>alert(1)</script> Guard")
    let html: Text = render_card("Hello \"YAZA\" <Views>", items, true)
    assert(text_find(html, "<section class=\"card\" data-kind=\"demo\">") >= 0)
    assert(text_find(html, "<h2>Hello &quot;YAZA&quot; &lt;Views&gt;</h2>") >= 0)
    assert(text_find(html, "<span class=\"badge is-active\">Arena-SSR</span>") >= 0)
    assert(text_find(html, "<li>XSS &lt;script&gt;alert(1)&lt;/script&gt; Guard</li>") >= 0)
    assert(text_find(html, "<script>") < 0)
    assert(text_find(html, "Powered by YAZA 2 items") >= 0)
    say "VIEW_SYNTAX_SMOKE: PASS"
