shape Alpha:
    beta: Option[Beta]
    root: Number

shape Beta:
    alpha: Option[Alpha]
    depth: Number

fn inspect(value: Alpha) -> Number:
    if option_is_some(value.beta):
        let nested: Beta = option_unwrap(value.beta)
        if option_is_some(nested.alpha):
            let back: Alpha = option_unwrap(nested.alpha)
            return back.root + nested.depth
    return value.root

start:
    let empty: Alpha = Alpha(none, 1)
    let beta: Beta = Beta(some(empty), 2)
    let alpha: Alpha = Alpha(some(beta), 3)
    say inspect(alpha)
