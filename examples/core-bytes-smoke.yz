fn checked_text(value: Bytes) -> Text:
    let converted: Option[Text] = bytes_to_text_checked(value)
    if option_is_some(converted): return option_unwrap(converted)
    return "invalid"

start:
    let word: Bytes = bytes_from_text("hello")
    assert bytes_length(word) == 5
    assert bytes_get(word, 0) == 104
    assert bytes_get(word, 4) == 111
    assert bytes_equal(word, bytes_from_text("hello"))
    assert bytes_equal_constant_time(word, bytes_from_text("hello"))
    assert not bytes_equal(word, bytes_from_text("world"))
    assert not bytes_equal_constant_time(word, bytes_from_text("world"))

    let joined: Bytes = bytes_concat(word, bytes_from_number(0))
    assert bytes_length(joined) == 6
    assert bytes_get(joined, 5) == 0
    assert bytes_equal(bytes_slice(joined, 0, 5), word)
    assert bytes_length(bytes_slice(joined, 5, 0)) == 0
    assert bytes_length(bytes_from_number(255)) == 1
    assert bytes_get(bytes_from_number(255), 0) == 255

    let decoded: Option[Text] = bytes_to_text_checked(bytes_from_text("héllo 🌋"))
    assert option_is_some(decoded)
    assert option_unwrap(decoded) == "héllo 🌋"
    assert not option_is_some(bytes_to_text_checked(bytes_from_number(255)))
    assert not option_is_some(bytes_to_text_checked(joined))
    let overlong: Bytes = bytes_concat(bytes_from_number(192), bytes_from_number(175))
    let surrogate: Bytes = bytes_concat(bytes_from_number(237), bytes_concat(bytes_from_number(160), bytes_from_number(128)))
    assert not option_is_some(bytes_to_text_checked(overlong))
    assert not option_is_some(bytes_to_text_checked(surrogate))
    assert option_unwrap(bytes_to_text_checked(bytes_concat(bytes_from_number(195), bytes_from_number(169)))) == "é"
    assert checked_text(word) == "hello"

    let exact_limit: Result[Bytes, Text] = bytes_from_text_bounded("abc", 3)
    let over_limit: Result[Bytes, Text] = bytes_from_text_bounded("abc", 2)
    let multibyte_over_limit: Result[Bytes, Text] = bytes_from_text_bounded("é", 1)
    assert result_is_ok(exact_limit)
    assert bytes_equal(result_unwrap(exact_limit), bytes_from_text("abc"))
    assert not result_is_ok(over_limit)
    assert result_unwrap_error(over_limit) == "Text exceeds the configured byte limit"
    assert not result_is_ok(multibyte_over_limit)
    let empty_text_bytes: Result[Bytes, Text] = bytes_from_text_bounded("", 0)
    assert result_is_ok(empty_text_bytes)
    assert bytes_length(result_unwrap(empty_text_bytes)) == 0

    let values: List[Bytes] = [word, joined]
    assert list_count(values) == 2
    assert bytes_equal(list_get(values, 0), word)
    assert bytes_equal(list_get(values, 1), joined)
    let found: Option[Bytes] = list_try_get(values, 9)
    assert not option_is_some(found)
    assert bytes_equal(option_unwrap(list_try_get(values, 0)), word)
    let joined_list: Result[Bytes, Text] = bytes_join(values)
    assert result_is_ok(joined_list)
    assert bytes_equal(result_unwrap(joined_list), bytes_concat(word, joined))
    let empty_list: Result[Bytes, Text] = bytes_join(List[Bytes]())
    assert result_is_ok(empty_list)
    assert bytes_length(result_unwrap(empty_list)) == 0
    say "bytes-ok"
