fn report(value: Text) -> Unit:
    assert value == "deferred:7"
    say value

start:
    let initial_scopes: Number = arena_live_scopes()
    arena_scope 4096:
        let payload: Text = "deferred:" + number_text(7)
        defer report(payload)
        say "body"
    assert arena_live_scopes() == initial_scopes
    say "scope-closed"
