start:
    let false_value: Boolean = false
    let true_value: Boolean = true
    if false_value < true_value:
        say "false < true"
    else:
        say "false < true failed"
    if true_value > false_value:
        say "true > false"
    else:
        say "true > false failed"
    if false_value <= false_value:
        say "false <= false"
    else:
        say "false <= false failed"
    if true_value >= true_value:
        say "true >= true"
    else:
        say "true >= true failed"
    if not (true_value < false_value):
        say "not true < false"
    else:
        say "true < false failed"
    if not (false_value > true_value):
        say "not false > true"
    else:
        say "false > true failed"
    if not (false_value >= true_value):
        say "not false >= true"
    else:
        say "false >= true failed"
    if not (true_value <= false_value):
        say "not true <= false"
    else:
        say "true <= false failed"
