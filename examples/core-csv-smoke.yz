use "../std/csv"

start:
    let source: Bytes = bytes_from_text("name,value,note\r\n\"a,b\",\"say \"\"hello\"\"\",\"first line\r\nsecond line\"\r\nplain,,end")
    let first_result: Result[Option[CsvRecord], Text] = csv_read_record(source, 0)
    assert result_is_ok(first_result)
    let first_option: Option[CsvRecord] = result_unwrap(first_result)
    assert option_is_some(first_option)
    let first: CsvRecord = option_unwrap(first_option)
    assert list_count(first.fields) == 3
    assert list_get(first.fields, 0) == "name"
    assert first.next_offset == 17

    let second_result: Result[Option[CsvRecord], Text] = csv_read_record(source, first.next_offset)
    assert result_is_ok(second_result)
    let second_option: Option[CsvRecord] = result_unwrap(second_result)
    assert option_is_some(second_option)
    let second: CsvRecord = option_unwrap(second_option)
    assert list_count(second.fields) == 3
    assert list_get(second.fields, 0) == "a,b"
    assert list_get(second.fields, 1) == "say \"hello\""
    assert list_get(second.fields, 2) == "first line\r\nsecond line"

    let third_result: Result[Option[CsvRecord], Text] = csv_read_record(source, second.next_offset)
    assert result_is_ok(third_result)
    let third: CsvRecord = option_unwrap(result_unwrap(third_result))
    assert list_count(third.fields) == 3
    assert list_get(third.fields, 0) == "plain"
    assert list_get(third.fields, 1) == ""
    assert list_get(third.fields, 2) == "end"

    let end_result: Result[Option[CsvRecord], Text] = csv_read_record(source, third.next_offset)
    assert result_is_ok(end_result)
    assert not option_is_some(result_unwrap(end_result))

    let output_fields: TextList = text_list()
    list_push(output_fields, "a,b")
    list_push(output_fields, "say \"hello\"")
    list_push(output_fields, "line\r\nbreak")
    let encoded: Result[Bytes, Text] = csv_encode_record(output_fields)
    assert result_is_ok(encoded)
    let expected: Bytes = bytes_from_text("\"a,b\",\"say \"\"hello\"\"\",\"line\r\nbreak\"\r\n")
    assert bytes_equal(result_unwrap(encoded), expected)
    let round_trip: CsvRecord = option_unwrap(result_unwrap(csv_read_record(result_unwrap(encoded), 0)))
    assert list_count(round_trip.fields) == 3
    assert list_get(round_trip.fields, 0) == list_get(output_fields, 0)
    assert list_get(round_trip.fields, 1) == list_get(output_fields, 1)
    assert list_get(round_trip.fields, 2) == list_get(output_fields, 2)

    let malformed: Result[Option[CsvRecord], Text] = csv_read_record(bytes_from_text("\"open"), 0)
    assert not result_is_ok(malformed)
    let invalid_quote: Result[Option[CsvRecord], Text] = csv_read_record(bytes_from_text("a\"b\r\n"), 0)
    assert not result_is_ok(invalid_quote)
    let bare_lf: Result[Option[CsvRecord], Text] = csv_read_record(bytes_from_text("a\nb"), 0)
    assert not result_is_ok(bare_lf)
    let trailing_quote_text: Result[Option[CsvRecord], Text] = csv_read_record(bytes_from_text("\"a\"tail\r\n"), 0)
    assert not result_is_ok(trailing_quote_text)
    let bare_cr: Result[Option[CsvRecord], Text] = csv_read_record(bytes_from_text("a\rb"), 0)
    assert not result_is_ok(bare_cr)
    let bad_utf8: Result[Option[CsvRecord], Text] = csv_read_record(bytes_from_number(255), 0)
    assert not result_is_ok(bad_utf8)
    let nul_byte: Result[Option[CsvRecord], Text] = csv_read_record(bytes_from_number(0), 0)
    assert not result_is_ok(nul_byte)
    let bad_offset: Result[Option[CsvRecord], Text] = csv_read_record(source, -1)
    assert not result_is_ok(bad_offset)

    let trailing_comma: CsvRecord = option_unwrap(result_unwrap(csv_read_record(bytes_from_text("first,"), 0)))
    assert list_count(trailing_comma.fields) == 2
    assert list_get(trailing_comma.fields, 1) == ""
    let blank_record: CsvRecord = option_unwrap(result_unwrap(csv_read_record(bytes_from_text("\r\n"), 0)))
    assert list_count(blank_record.fields) == 1
    assert list_get(blank_record.fields, 0) == ""
    let quoted_empty: CsvRecord = option_unwrap(result_unwrap(csv_read_record(bytes_from_text("\"\"\r\n"), 0)))
    assert list_count(quoted_empty.fields) == 1
    assert list_get(quoted_empty.fields, 0) == ""

    let emoji: Bytes = bytes_from_text("city,value\r\nBandung,🌋\r\n")
    let emoji_header: CsvRecord = option_unwrap(result_unwrap(csv_read_record(emoji, 0)))
    let emoji_row: CsvRecord = option_unwrap(result_unwrap(csv_read_record(emoji, emoji_header.next_offset)))
    assert list_get(emoji_row.fields, 1) == "🌋"

    var octet: Number = 0
    while octet <= 255:
        let single_byte_input: Bytes = bytes_from_number(octet)
        let single_byte_result: Result[Option[CsvRecord], Text] = csv_read_record(single_byte_input, 0)
        set octet = octet + 1
