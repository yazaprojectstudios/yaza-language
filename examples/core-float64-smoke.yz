start:
    let positive_exponent: Float64 = 1.25e2
    let negative_exponent: Float64 = 5E-3
    let signed_exponent: Float64 = 2.5e+1
    let integer_mantissa: Float64 = 5e-3
    let parsed: Float64 = float64_parse("-10.5")
    let added: Float64 = 1.25 + 2.5
    let subtracted: Float64 = 5.5 - 1.25
    let multiplied: Float64 = 1.5 * 4.0
    let divided: Float64 = 7.5 / 2.5
    let negated: Float64 = -1.25
    assert positive_exponent == 125.0
    assert negative_exponent == 0.005
    assert signed_exponent == 25.0
    assert integer_mantissa == 0.005
    assert parsed == -10.5
    assert added == 3.75
    assert subtracted == 4.25
    assert multiplied == 6.0
    assert divided == 3.0
    assert negated == -1.25
    assert added > 3.5
    assert subtracted <= 4.25
    assert multiplied >= 6.0
    assert divided < 3.5
    assert negated < 0.0
    assert number_from_float64(float64_from_number(42)) == 42
    say "float64-ok"
