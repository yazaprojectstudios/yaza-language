use "std/nosql/document"

start:
    # 1. Construct BSON document
    let fields: List[BsonField] = List[BsonField]()
    list_push(fields, bson_field_string("name", "Document Store"))
    list_push(fields, bson_field_int32("version", 1))
    list_push(fields, bson_field_boolean("active", true))
    list_push(fields, bson_field_null("extra"))

    let enc_res: Result[Bytes, Text] = bson_encode_document(fields)
    assert result_is_ok(enc_res)
    let doc_bytes: Bytes = result_unwrap(enc_res)
    assert bytes_length(doc_bytes) > 5

    # 2. Decode BSON document
    let dec_res: Result[BsonParsedDocument, Text] = bson_decode_document(doc_bytes, 0)
    assert result_is_ok(dec_res)
    let parsed: BsonParsedDocument = result_unwrap(dec_res)
    assert list_count(parsed.fields) == 4

    let f0: BsonField = list_get(parsed.fields, 0)
    assert f0.name == "name"
    assert f0.field_type == 2
    assert f0.str_val == "Document Store"

    let f1: BsonField = list_get(parsed.fields, 1)
    assert f1.name == "version"
    assert f1.field_type == 16
    assert f1.num_val == 1

    let f2: BsonField = list_get(parsed.fields, 2)
    assert f2.name == "active"
    assert f2.field_type == 8
    assert f2.bool_val

    let f3: BsonField = list_get(parsed.fields, 3)
    assert f3.name == "extra"
    assert f3.field_type == 10

    # 3. Construct OP_MSG packet (Opcode 2013)
    let msg_res: Result[Bytes, Text] = doc_msg_packet(101, doc_bytes)
    assert result_is_ok(msg_res)
    let msg_bytes: Bytes = result_unwrap(msg_res)
    assert bytes_length(msg_bytes) == 20 + 1 + bytes_length(doc_bytes)
    # Check opcode at offset 12 (2013 LE: 221, 7, 0, 0)
    assert bytes_get(msg_bytes, 12) == 221
    assert bytes_get(msg_bytes, 13) == 7
    assert bytes_get(msg_bytes, 14) == 0
    assert bytes_get(msg_bytes, 15) == 0
