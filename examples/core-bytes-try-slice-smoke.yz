start:
    let input: Bytes = bytes_from_text("YAZA")
    let part: Result[Bytes, Text] = bytes_try_slice(input, 1, 2)
    match part:
        ok(value):
            say bytes_to_text(value)
        err(message):
            say message
    let outside: Result[Bytes, Text] = bytes_try_slice(input, 4, 1)
    match outside:
        ok(value):
            say bytes_to_text(value)
        err(message):
            say message
    say "fallible-bytes-slice-ok"
