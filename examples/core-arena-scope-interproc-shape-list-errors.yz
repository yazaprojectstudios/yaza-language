shape Inbox:
    items: List[Bytes]

fn append_to_inbox(inbox: Inbox, value: Bytes) -> Unit:
    list_push(inbox.items, value)

start:
    let inbox: Inbox = Inbox(List[Bytes]())
    arena_scope 4096:
        let local_bytes: Bytes = bytes_from_text("child " + number_text(14))
        append_to_inbox(inbox, local_bytes)
