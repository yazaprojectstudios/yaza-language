use "std/fs"
use "../yazabase/catalog_init_v1"
use "../yazabase/sql_dispatch_v1"

fn yaza_db_blob_overflow_sql_v1_check(root_path: Text) -> Result[Number, Text]:
    let root: Number = root_open(root_path)?
    let database_name: Text = "blob-overflow-smoke.ydb"
    let initial_header: YazaDbFileHeaderV1 = YazaDbFileHeaderV1(bytes_from_text("blob-overflow-id"), 0, 1, 1, 0, 2, 1)
    let empty_storage: YazaDbStorageHandleV1 = yaza_db_storage_create_empty_v1(root, database_name, initial_header)?
    let empty_storage_closed: Boolean = yaza_db_storage_close_v1(empty_storage)?
    if not empty_storage_closed: return err("YDBv1 BLOB overflow fixture could not close its empty database")

    let initialized: YazaDbCatalogBootstrapV1 = yaza_db_catalog_initialize_v1(root, database_name)?
    let no_parameters: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let create_result: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(initialized.storage, initialized.wal, "CREATE TABLE payloads (id BIGINT PRIMARY KEY, body BLOB NOT NULL, fallback BLOB NOT NULL DEFAULT X'00FF')", no_parameters)?
    if not option_is_some(create_result.write_commit): return err("YDBv1 BLOB overflow fixture CREATE TABLE did not commit")
    let created: YazaDbWriteCommitV1 = option_unwrap(create_result.write_commit)
    let created_wal_closed: Boolean = yaza_db_wal_log_close_v1(created.wal)?
    let created_storage_closed: Boolean = yaza_db_storage_close_v1(created.storage)?
    if not created_wal_closed or not created_storage_closed: return err("YDBv1 BLOB overflow fixture could not close after CREATE TABLE")

    let after_create: YazaDbCheckpointRecoveryV1 = yaza_db_open_recovered_v1(root, database_name)?
    let original_blob: Bytes = bytes_try_new_zeroed(6000)?
    var original_index: Number = 0
    while original_index < bytes_length(original_blob):
        var original_byte: Number = (original_index * 37 + 11) % 256
        if original_index % 5 == 0: set original_byte = 255
        if not bytes_try_set(original_blob, original_index, original_byte): return err("YDBv1 BLOB overflow fixture could not populate original bytes")
        set original_index = original_index + 1
    let id_value: YazaSqlValueV1 = yaza_sql_value_integer_v1(4, 1)?
    let original_value: YazaSqlValueV1 = yaza_sql_value_blob_v1(original_blob)?
    let insert_parameters: List[YazaSqlValueV1] = [id_value, original_value]
    let insert_result: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(after_create.storage, after_create.wal, "INSERT INTO payloads (id, body) VALUES ($1, $2)", insert_parameters)?
    if not option_is_some(insert_result.write_commit): return err("YDBv1 BLOB overflow fixture INSERT did not commit")
    let inserted: YazaDbWriteCommitV1 = option_unwrap(insert_result.write_commit)

    let select_result: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(inserted.storage, inserted.wal, "SELECT body, fallback FROM payloads WHERE id = 1", no_parameters)?
    if not option_is_some(select_result.query_result): return err("YDBv1 BLOB overflow fixture point SELECT returned no result")
    let selected: YazaSqlQueryResultV1 = option_unwrap(select_result.query_result)
    if list_count(selected.rows) != 1 or not bytes_equal(list_get(list_get(selected.rows, 0), 0).bytes_value, original_blob): return err("YDBv1 BLOB overflow point lookup changed bytes after external-page hydration")
    let default_blob: Bytes = list_get(list_get(selected.rows, 0), 1).bytes_value
    if bytes_length(default_blob) != 2 or bytes_get(default_blob, 0) != 0 or bytes_get(default_blob, 1) != 255: return err("YDBv1 BLOB DEFAULT did not materialize exact bytes")

    let filter_parameters: List[YazaSqlValueV1] = [original_value]
    let filter_result: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(select_result.storage, select_result.wal, "SELECT COUNT(*) FROM payloads WHERE body = $1", filter_parameters)?
    if not option_is_some(filter_result.query_result) or list_get(list_get(option_unwrap(filter_result.query_result).rows, 0), 0).integer_value != 1: return err("YDBv1 BLOB overflow equality filter failed to hydrate and compare external bytes")

    let replacement_blob: Bytes = bytes_try_new_zeroed(9000)?
    var replacement_index: Number = 0
    while replacement_index < bytes_length(replacement_blob):
        var replacement_byte: Number = (replacement_index * 19 + 7) % 256
        if replacement_index % 7 == 0: set replacement_byte = 0
        if not bytes_try_set(replacement_blob, replacement_index, replacement_byte): return err("YDBv1 BLOB overflow fixture could not populate replacement bytes")
        set replacement_index = replacement_index + 1
    let replacement_value: YazaSqlValueV1 = yaza_sql_value_blob_v1(replacement_blob)?
    let replacement_parameters: List[YazaSqlValueV1] = [replacement_value]
    let update_result: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(filter_result.storage, filter_result.wal, "UPDATE payloads SET body = $1 WHERE id = 1", replacement_parameters)?
    if not option_is_some(update_result.write_commit): return err("YDBv1 BLOB overflow fixture UPDATE did not commit")
    let updated: YazaDbWriteCommitV1 = option_unwrap(update_result.write_commit)

    let historical: YazaSqlQueryResultV1 = yaza_db_execute_select_at_snapshot_v1(updated.storage, updated.wal, "SELECT body FROM payloads WHERE id = 1", no_parameters, inserted.commit_ts, 0, List[YazaDbTxnStatusV1]())?
    if list_count(historical.rows) != 1 or not bytes_equal(list_get(list_get(historical.rows, 0), 0).bytes_value, original_blob): return err("YDBv1 BLOB overflow UPDATE did not preserve its historical external value")
    let current_result: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(updated.storage, updated.wal, "SELECT body FROM payloads WHERE id = 1", no_parameters)?
    if not option_is_some(current_result.query_result): return err("YDBv1 BLOB overflow current SELECT returned no result")
    if not bytes_equal(list_get(list_get(option_unwrap(current_result.query_result).rows, 0), 0).bytes_value, replacement_blob): return err("YDBv1 BLOB overflow UPDATE did not hydrate the replacement chain")

    let wal_closed: Boolean = yaza_db_wal_log_close_v1(current_result.wal)?
    let storage_closed: Boolean = yaza_db_storage_close_v1(current_result.storage)?
    if not wal_closed or not storage_closed: return err("YDBv1 BLOB overflow fixture could not close after UPDATE")
    let reopened: YazaDbCheckpointRecoveryV1 = yaza_db_open_recovered_v1(root, database_name)?
    let reopened_insert: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(reopened.storage, reopened.wal, "INSERT INTO payloads (id, body) VALUES (2, X'ABCD')", no_parameters)?
    if not option_is_some(reopened_insert.write_commit): return err("YDBv1 BLOB DEFAULT fixture could not insert after reopen")
    let reopened_commit: YazaDbWriteCommitV1 = option_unwrap(reopened_insert.write_commit)
    let default_after_reopen: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(reopened_commit.storage, reopened_commit.wal, "SELECT fallback FROM payloads WHERE id = 2", no_parameters)?
    if not option_is_some(default_after_reopen.query_result): return err("YDBv1 BLOB DEFAULT lookup after reopen returned no result")
    let default_after_reopen_rows: List[List[YazaSqlValueV1]] = option_unwrap(default_after_reopen.query_result).rows
    if list_count(default_after_reopen_rows) != 1: return err("YDBv1 BLOB DEFAULT lookup after reopen returned the wrong row count")
    let reopened_default_blob: Bytes = list_get(list_get(default_after_reopen_rows, 0), 0).bytes_value
    if bytes_length(reopened_default_blob) != 2 or bytes_get(reopened_default_blob, 0) != 0 or bytes_get(reopened_default_blob, 1) != 255: return err("YDBv1 BLOB catalog DEFAULT did not survive close/reopen")
    let reopened_current: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(default_after_reopen.storage, default_after_reopen.wal, "SELECT body FROM payloads WHERE id = 1", no_parameters)?
    if not option_is_some(reopened_current.query_result) or not bytes_equal(list_get(list_get(option_unwrap(reopened_current.query_result).rows, 0), 0).bytes_value, replacement_blob): return err("YDBv1 BLOB overflow replacement did not survive close/reopen")
    let reopened_historical: YazaSqlQueryResultV1 = yaza_db_execute_select_at_snapshot_v1(reopened_current.storage, reopened_current.wal, "SELECT body FROM payloads WHERE id = 1", no_parameters, inserted.commit_ts, 0, List[YazaDbTxnStatusV1]())?
    if list_count(reopened_historical.rows) != 1 or not bytes_equal(list_get(list_get(reopened_historical.rows, 0), 0).bytes_value, original_blob): return err("YDBv1 historical BLOB overflow chain did not survive close/reopen")

    let drop_result: YazaDbSqlStatementResultV1 = yaza_db_execute_statement_v1(reopened_current.storage, reopened_current.wal, "DROP TABLE payloads", no_parameters)?
    if not option_is_some(drop_result.write_commit): return err("YDBv1 BLOB overflow fixture DROP TABLE did not commit")
    let dropped: YazaDbWriteCommitV1 = option_unwrap(drop_result.write_commit)
    let drop_wal_closed: Boolean = yaza_db_wal_log_close_v1(dropped.wal)?
    let drop_storage_closed: Boolean = yaza_db_storage_close_v1(dropped.storage)?
    if not drop_wal_closed or not drop_storage_closed: return err("YDBv1 BLOB overflow fixture could not close after DROP TABLE")
    let after_drop: YazaDbCheckpointRecoveryV1 = yaza_db_open_recovered_v1(root, database_name)?
    let missing_table: Result[YazaDbSqlStatementResultV1, Text] = yaza_db_execute_statement_v1(after_drop.storage, after_drop.wal, "SELECT body FROM payloads", no_parameters)
    if result_is_ok(missing_table): return err("YDBv1 BLOB overflow table remained visible after DROP")
    let final_wal_closed: Boolean = yaza_db_wal_log_close_v1(after_drop.wal)?
    let final_storage_closed: Boolean = yaza_db_storage_close_v1(after_drop.storage)?
    let root_closed: Boolean = close(root)?
    if not final_wal_closed or not final_storage_closed or not root_closed: return err("YDBv1 BLOB overflow fixture could not close its handles")
    return ok(15005)

start:
    let outcome: Result[Number, Text] = yaza_db_blob_overflow_sql_v1_check(arg(1))
    if result_is_ok(outcome):
        say "yazabase-blob-overflow-sql-v1-ok bytes=" + number_text(result_unwrap(outcome))
    else:
        say result_unwrap_error(outcome)
