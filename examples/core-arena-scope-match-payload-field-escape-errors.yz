shape Envelope:
    label: Text
    items: List[Bytes]

start:
    let parent_label: Text = "parent " + number_text(1)
    let parent_items: List[Bytes] = List[Bytes]()
    arena_scope 4096:
        let local_bytes: Bytes = bytes_from_text("child")
        let wrapped: Option[Envelope] = some(Envelope(parent_label, parent_items))
        match wrapped:
            some(value):
                list_push(value.items, local_bytes)
            none:
                assert false
