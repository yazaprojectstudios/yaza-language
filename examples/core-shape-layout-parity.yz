shape Address:
    city: Text
    postal_code: Number

shape Person:
    name: Text
    address: Address
    rating: Float64
    revision: Int32
    active: Boolean
    payload: Bytes
    aliases: TextList

variant State:
    Empty
    Loaded(person: Person)
    Rejected(reason: Text)

shape Snapshot:
    people: List[Person]
    state: State
    selected: Option[Person]
    optional_people: Option[List[Person]]

shape OptionalState:
    value: Option[State]

shape OptionalPayloads:
    optional_text: Option[Text]
    optional_bytes: Option[Bytes]
    optional_aliases: Option[TextList]
    nested_number: Option[Option[Number]]
    optional_states: Option[List[State]]
    person_slots: List[Option[Person]]

fn make_snapshot(people: List[Person], state: State) -> Snapshot:
    let first: Person = list_get(people, 0)
    return Snapshot(people, state, some(first), some(people))

fn copy_snapshot(snapshot: Snapshot) -> Snapshot:
    return snapshot

fn copy_optional_payloads(value: OptionalPayloads) -> OptionalPayloads:
    return value

fn state_city(state: State) -> Text:
    match state:
        Empty:
            return "empty"
        Loaded(person):
            return person.address.city
        Rejected(reason):
            return reason

start:
    var people: List[Person] = List[Person]()
    var primary_aliases: TextList = text_list()
    list_push(primary_aliases, "primary")
    var secondary_aliases: TextList = text_list()
    list_push(secondary_aliases, "secondary")
    list_push(people, Person("Ayu", Address("Bandung", 40111), 4.75, int32_from_number(7), true, bytes_from_text("contact"), primary_aliases))
    list_push(people, Person("Bima", Address("Surabaya", 60111), 3.5, int32_from_number(9), false, bytes_from_text("office"), secondary_aliases))

    var snapshot: Snapshot = make_snapshot(people, State::Loaded(list_get(people, 0)))
    let copied: Snapshot = copy_snapshot(snapshot)
    assert list_count(copied.people) == 2
    assert list_get(copied.people, 1).address.city == "Surabaya"
    let first_person: Person = list_get(copied.people, 0)
    assert first_person.rating == 4.75
    assert number_from_int32(first_person.revision) == 7
    assert first_person.active
    assert bytes_equal(first_person.payload, bytes_from_text("contact"))
    assert list_get(first_person.aliases, 0) == "primary"
    assert state_city(copied.state) == "Bandung"
    assert option_is_some(copied.selected)
    assert option_unwrap(copied.selected).address.postal_code == 40111
    assert option_is_some(copied.optional_people)
    assert list_count(option_unwrap(copied.optional_people)) == 2
    assert list_get(option_unwrap(copied.optional_people), 1).name == "Bima"
    var empty_optional_people: Snapshot = Snapshot(people, copied.state, copied.selected, none)
    assert not option_is_some(empty_optional_people.optional_people)
    set empty_optional_people.optional_people = some(people)
    assert list_count(option_unwrap(empty_optional_people.optional_people)) == 2
    var optional_state: OptionalState = OptionalState(none)
    assert not option_is_some(optional_state.value)
    set optional_state.value = some(State::Loaded(first_person))
    assert option_is_some(optional_state.value)
    match option_unwrap(optional_state.value):
        Empty:
            assert false
        Loaded(person):
            assert person.address.city == "Bandung"
        Rejected(reason):
            assert false

    var empty_aliases: TextList = text_list()
    var states: List[State] = List[State]()
    list_push(states, State::Loaded(first_person))
    list_push(states, State::Rejected("blocked"))
    var person_slots: List[Option[Person]] = List[Option[Person]]()
    list_push(person_slots, some(first_person))
    list_push(person_slots, none)
    var optional_payloads: OptionalPayloads = OptionalPayloads(some("memo"), some(bytes_from_text("secret")), some(empty_aliases), some(some(42)), some(states), person_slots)
    list_push(option_unwrap(optional_payloads.optional_aliases), "alias")
    let copied_payloads: OptionalPayloads = copy_optional_payloads(optional_payloads)
    assert option_is_some(copied_payloads.optional_text)
    assert option_unwrap(copied_payloads.optional_text) == "memo"
    assert bytes_equal(option_unwrap(copied_payloads.optional_bytes), bytes_from_text("secret"))
    assert list_get(option_unwrap(copied_payloads.optional_aliases), 0) == "alias"
    assert option_unwrap(option_unwrap(copied_payloads.nested_number)) == 42
    match list_get(option_unwrap(copied_payloads.optional_states), 0):
        Empty:
            assert false
        Loaded(person):
            assert person.name == "Ayu"
        Rejected(reason):
            assert false
    assert list_count(copied_payloads.person_slots) == 2
    assert option_unwrap(list_get(copied_payloads.person_slots, 0)).name == "Ayu"
    assert not option_is_some(list_get(copied_payloads.person_slots, 1))

    var absent_payloads: OptionalPayloads = OptionalPayloads(none, none, none, none, none, person_slots)
    assert not option_is_some(absent_payloads.optional_text)
    assert not option_is_some(absent_payloads.optional_bytes)
    assert not option_is_some(absent_payloads.optional_aliases)
    assert not option_is_some(absent_payloads.nested_number)
    assert not option_is_some(absent_payloads.optional_states)
    set absent_payloads.optional_text = some("restored")
    set absent_payloads.optional_bytes = some(bytes_from_text("payload"))
    set absent_payloads.optional_aliases = some(empty_aliases)
    set absent_payloads.nested_number = some(some(99))
    set absent_payloads.optional_states = some(states)
    assert option_unwrap(absent_payloads.optional_text) == "restored"
    assert bytes_equal(option_unwrap(absent_payloads.optional_bytes), bytes_from_text("payload"))
    assert option_unwrap(option_unwrap(absent_payloads.nested_number)) == 99
    assert list_count(option_unwrap(absent_payloads.optional_states)) == 2
    let outcome: Result[Person, Text] = ok(option_unwrap(copied.selected))
    assert result_is_ok(outcome)
    assert result_unwrap(outcome).name == "Ayu"

    set snapshot.state = State::Rejected("unavailable")
    let failure: Result[Person, Text] = err("unavailable")
    assert state_city(snapshot.state) == "unavailable"
    assert not result_is_ok(failure)
    assert result_unwrap_error(failure) == "unavailable"
    say "shape-layout-parity-ok"
