fn append_value(target: TextList, value: Text) -> Unit:
    list_push(target, value)
start:
    var output: TextList = text_list()
    arena_scope 4096:
        let temporary: Text = "temporary " + number_text(42)
        let local: TextList = text_list()
        append_value(local, temporary)
        append_value(output, "static value")
        say list_get(local, 0)
    say list_get(output, 0)
    assert arena_live_scopes() == 0
