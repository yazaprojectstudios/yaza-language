start:
    let number_text: Result[Text,Text] = number_try_text(-9223372036854775808)
    assert result_is_ok(number_text)
    assert result_unwrap(number_text) == "-9223372036854775808"

    let integer: Int32 = int32_from_number(2147483647)
    let integer_text: Result[Text,Text] = int32_try_text(integer)
    assert result_is_ok(integer_text)
    assert result_unwrap(integer_text) == "2147483647"

    let float_text: Result[Text,Text] = float64_try_text(1.25)
    assert result_is_ok(float_text)
    assert result_unwrap(float_text) == "1.25"
    say "fallible-number-formatting-ok"
