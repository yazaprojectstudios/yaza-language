start:
    let minimum: Number = -9223372036854775808
    let maximum: Number = 9223372036854775807
    let minimum_with_leading_zeroes: Number = -0009223372036854775808
    assert minimum == minimum_with_leading_zeroes
    assert minimum < 0
    assert maximum > 0
    assert number_from_int32(int32_from_number(-2147483648)) == -2147483648
    assert number_from_int32(int32_from_number(2147483647)) == 2147483647
    say(number_text(minimum))
    say(number_text(maximum))
