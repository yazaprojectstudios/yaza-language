fn imported_append_child_bytes(target: List[Bytes]) -> Unit:
    arena_scope 2048:
        let temporary: Bytes = bytes_from_text("imported child " + number_text(7))
        list_push(target, temporary)

fn imported_append_child_text(target: TextList) -> Unit:
    arena_scope 2048:
        let temporary: Text = "imported text " + number_text(7)
        list_push(target, temporary)
