fn describe_optional(value: Option[Text]) -> Text:
    match value:
        some(item):
            return item
        none:
            return "empty"

fn describe_optional_expression(value: Option[Text]) -> Text:
    return match value:
        some(item) -> item
        none -> "empty"

fn describe_optional_let_expression(value: Option[Text]) -> Text:
    let label: Text = match value:
        some(item) -> item
        none -> "empty"
    return label

fn describe_optional_set_expression(value: Option[Text]) -> Text:
    var label: Text = "unset"
    set label = match value:
        some(item) -> item
        none -> "empty"
    return label
