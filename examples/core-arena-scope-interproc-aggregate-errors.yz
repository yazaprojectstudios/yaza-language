shape Envelope:
    payload: Option[Result[Text, Text]]

fn wrap_text(value: Text) -> Envelope:
    return Envelope(some(ok(value)))

fn leaking_envelope() -> Envelope:
    arena_scope 4096:
        let local_text: Text = "short lived " + number_text(9)
        return wrap_text(local_text)

start:
    say "done"
