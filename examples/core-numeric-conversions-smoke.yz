start:
    let signed_number: Number = number_parse("  +42")
    let number_text_value: Text = number_text(signed_number)
    assert number_text_value == "42"

    let minimum_int32: Int32 = int32_from_number(number_parse("-2147483648"))
    let maximum_int32: Int32 = int32_from_number(number_parse("2147483647"))
    assert int32_text(minimum_int32) == "-2147483648"
    assert int32_text(maximum_int32) == "2147483647"
    assert number_from_int32(minimum_int32) == -2147483648
    assert number_from_int32(maximum_int32) == 2147483647

    let parsed_float: Float64 = float64_parse("+1.25e+2")
    assert float64_text(parsed_float) == "125"
    let negative_zero: Float64 = float64_parse("-0")
    assert float64_text(negative_zero) == "-0"

    let exact_float: Float64 = float64_from_number(number_parse("-9007199254740992"))
    let exact_number: Number = number_from_float64(exact_float)
    assert number_text(exact_number) == "-9007199254740992"
    let minimum_number: Number = number_parse("-9223372036854775808")
    let maximum_number: Number = number_parse("9223372036854775807")

    say number_text_value
    say int32_text(minimum_int32)
    say int32_text(maximum_int32)
    say float64_text(parsed_float)
    say float64_text(negative_zero)
    say number_text(exact_number)
    say minimum_int32
    say maximum_int32
    say minimum_number
    say maximum_number
    say parsed_float
