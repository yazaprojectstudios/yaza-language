shape Person:
    name: Text

variant Lookup:
    Missing
    TextResult(message: Text, status: Number)
    PersonResult(person: Person)

shape Envelope:
    result: Lookup

fn describe(value: Lookup) -> Text:
    match value:
        Missing:
            return "missing"
        TextResult(message, _):
            return message
        PersonResult(person):
            return person.name

fn print_value(value: Lookup) -> Unit:
    match value:
        Missing():
            say "missing"
        TextResult(message, _):
            say message
        PersonResult(person):
            say person.name

fn partial_return(value: Lookup) -> Text:
    match value:
        Missing:
            return "missing"
        TextResult(message, _):
            return message
        PersonResult(person):
            say person.name
    return "fallback"

start:
    let missing: Lookup = Lookup::Missing
    let missing_call: Lookup = Lookup::Missing()
    let text_value: Lookup = Lookup::TextResult("found", 200)
    let person: Person = Person("Ami")
    let person_value: Lookup = Lookup::PersonResult(person)
    var envelope: Envelope = Envelope(text_value)
    assert describe(missing) == "missing"
    assert describe(missing_call) == "missing"
    assert describe(envelope.result) == "found"
    set envelope.result = person_value
    assert describe(envelope.result) == "Ami"
    assert partial_return(person_value) == "fallback"
    say describe(missing)
    say describe(text_value)
    say describe(envelope.result)
    print_value(text_value)
