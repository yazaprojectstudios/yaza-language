start:
    let label: Text = "100% ready"
    let empty: Text = ""
    let maximum: Number = number_parse("9223372036854775807")
    let minimum32: Int32 = int32_from_number(-2147483648)
    let large: Float64 = float64_parse("1.2345678901234567e+200")
    let small: Float64 = float64_parse("1.2345678901234567e-200")
    say "label={label}; empty=<{empty}>; max={maximum}; min32={minimum32}; large={large}; small={small}; again={label}"
