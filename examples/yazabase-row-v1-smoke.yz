use "../yazabase/row_v1"

fn yaza_base_row_v1_columns() -> List[YazaSqlColumnSchemaV1]:
    let columns: List[YazaSqlColumnSchemaV1] = List[YazaSqlColumnSchemaV1]()
    list_push(columns, YazaSqlColumnSchemaV1("id", 4, false, 0, 0, 0, ""))
    list_push(columns, YazaSqlColumnSchemaV1("score", 6, true, 1, 0, 0, ""))
    list_push(columns, YazaSqlColumnSchemaV1("active", 1, false, 2, 0, 0, ""))
    list_push(columns, YazaSqlColumnSchemaV1("name", 9, true, 3, 0, 0, ""))
    return columns

fn yaza_base_row_v1_values(name: Text) -> List[YazaSqlValueV1]:
    let values: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    list_push(values, yaza_sql_executor_value_v1(4, -9223372036854775807 - 1, 0.0, false, ""))
    list_push(values, yaza_sql_value_double_v1(1.5))
    list_push(values, yaza_sql_value_boolean_v1(true))
    list_push(values, yaza_sql_value_text_v1(name))
    return values

fn yaza_base_row_v1_nulls(null_name: Boolean) -> List[Boolean]:
    let nulls: List[Boolean] = List[Boolean]()
    list_push(nulls, false)
    list_push(nulls, false)
    list_push(nulls, false)
    list_push(nulls, null_name)
    return nulls

fn yaza_base_row_v2_columns() -> List[YazaSqlColumnSchemaV1]:
    let columns: List[YazaSqlColumnSchemaV1] = yaza_base_row_v1_columns()
    list_push(columns, YazaSqlColumnSchemaV1("note", 9, true, 4, 0, 0, ""))
    return columns

fn yaza_base_row_v2_values() -> List[YazaSqlValueV1]:
    let values: List[YazaSqlValueV1] = yaza_base_row_v1_values("Yaza")
    list_push(values, yaza_sql_value_text_v1("since-v2"))
    return values

fn yaza_base_row_v2_nulls() -> List[Boolean]:
    let nulls: List[Boolean] = yaza_base_row_v1_nulls(false)
    list_push(nulls, false)
    return nulls

fn yaza_base_row_v1_check() -> Result[Number, Text]:
    let columns: List[YazaSqlColumnSchemaV1] = yaza_base_row_v1_columns()
    let values: List[YazaSqlValueV1] = yaza_base_row_v1_values("Yaza")
    let nulls: List[Boolean] = yaza_base_row_v1_nulls(false)
    let encoded: Bytes = yaza_db_row_encode_v1(values, nulls, columns, 77)?
    if bytes_length(encoded) != 52: return err("YDBv1 row encoded the scalar layout at an unexpected length")
    let decoded_version: Number = yaza_db_read_uint_le_v1(encoded, 0, 8)?
    let decoded_width: Number = yaza_db_read_uint_le_v1(encoded, 18, 2)?
    if decoded_version != 77 or decoded_width != 4: return err("YDBv1 row header did not round-trip")
    let decoded: YazaDbRowV1 = yaza_db_row_decode_v1(encoded, columns)?
    if decoded.version_ts != 77 or list_count(decoded.values) != 4 or list_count(decoded.nulls) != 4: return err("YDBv1 row decode metadata is wrong")
    if list_get(decoded.nulls, 0) or list_get(decoded.nulls, 1) or list_get(decoded.nulls, 2) or list_get(decoded.nulls, 3): return err("YDBv1 row changed non-NULL markers")
    let decoded_id: YazaSqlValueV1 = list_get(decoded.values, 0)
    let decoded_score: YazaSqlValueV1 = list_get(decoded.values, 1)
    let decoded_active: YazaSqlValueV1 = list_get(decoded.values, 2)
    let decoded_name: YazaSqlValueV1 = list_get(decoded.values, 3)
    if decoded_id.integer_value != -9223372036854775807 - 1 or decoded_score.float_value != 1.5 or not decoded_active.boolean_value or decoded_name.text_value != "Yaza": return err("YDBv1 row scalar values did not round-trip")
    if float64_bits(decoded_score.float_value) != float64_bits(1.5): return err("YDBv1 DOUBLE bit pattern changed during row decode")
    let unmaterialized: YazaDbRowV1 = yaza_db_row_decode_for_schema_with_buffers_v1(encoded, columns, 1, false, false, List[YazaSqlValueV1](), List[Boolean](), List[YazaDbOverflowRefV1]())?
    if unmaterialized.text_input_bytes != 4 or unmaterialized.max_text_input_bytes != 4 or list_get(unmaterialized.nulls, 3) or list_get(unmaterialized.values, 3).is_null or list_get(unmaterialized.values, 3).text_value != "":
        return err("YDBv1 non-materializing TEXT decode lost its byte budget or non-NULL placeholder")
    let ascii_utf8_bytes: Bytes = bytes_try_from_text("ordinary ASCII payload")?
    let ascii_utf8_view: YazaDbRowByteViewV1 = yaza_db_row_byte_view_new_v1(ascii_utf8_bytes, 0, bytes_length(ascii_utf8_bytes))?
    let multibyte_utf8_bytes: Bytes = bytes_try_from_text("café")?
    let multibyte_utf8_view: YazaDbRowByteViewV1 = yaza_db_row_byte_view_new_v1(multibyte_utf8_bytes, 0, bytes_length(multibyte_utf8_bytes))?
    if not yaza_db_row_utf8_range_valid_v1(ascii_utf8_view, 0, ascii_utf8_view.length) or not yaza_db_row_utf8_range_valid_v1(multibyte_utf8_view, 0, multibyte_utf8_view.length):
        return err("YDBv1 UTF-8 validator rejected valid ASCII or multi-byte text")
    let reusable_values: List[YazaSqlValueV1] = [yaza_db_row_null_placeholder_v1(4), yaza_db_row_null_placeholder_v1(6), yaza_db_row_null_placeholder_v1(1), yaza_db_row_null_placeholder_v1(9)]
    let reusable_nulls: List[Boolean] = [true, true, true, true]
    let reusable_overflow_refs: List[YazaDbOverflowRefV1] = [yaza_db_row_empty_overflow_ref_v1(), yaza_db_row_empty_overflow_ref_v1(), yaza_db_row_empty_overflow_ref_v1(), yaza_db_row_empty_overflow_ref_v1()]
    let encoded_length: Number = bytes_length(encoded)
    let projected_values: List[YazaSqlValueV1] = [yaza_db_row_null_placeholder_v1(4), yaza_sql_value_double_v1(99.0), yaza_sql_value_boolean_v1(false), yaza_sql_value_text_v1("sentinel")]
    let projected_nulls: List[Boolean] = [true, true, true, true]
    let projected_overflow_refs: List[YazaDbOverflowRefV1] = [yaza_db_row_empty_overflow_ref_v1(), yaza_db_row_empty_overflow_ref_v1(), yaza_db_row_empty_overflow_ref_v1(), yaza_db_row_empty_overflow_ref_v1()]
    let projected_columns: List[Boolean] = [true, false, false, false]
    let projected_row: YazaDbRowV1 = yaza_db_row_decode_for_stream_scan_span_v1(encoded, 0, encoded_length, columns, 1, true, true, true, false, projected_values, projected_nulls, projected_overflow_refs, projected_columns)?
    if list_get(projected_row.values, 0).integer_value != -9223372036854775807 - 1 or list_get(projected_row.values, 1).float_value != 99.0 or list_get(projected_row.values, 2).boolean_value or list_get(projected_row.values, 3).text_value != "sentinel": return err("YDBv1 projected scan changed an unrequested output value")
    if list_get(projected_row.nulls, 0) or not list_get(projected_row.nulls, 1) or not list_get(projected_row.nulls, 2) or not list_get(projected_row.nulls, 3): return err("YDBv1 projected scan changed an unrequested NULL marker")
    if projected_row.text_input_bytes != 4 or list_get(projected_row.overflow_refs, 3).first_page_id != 0: return err("YDBv1 projected scan lost text-budget validation or retained an unrequested overflow reference")
    let short_projection_mask: List[Boolean] = [true]
    if result_is_ok(yaza_db_row_decode_for_stream_scan_span_v1(encoded, 0, encoded_length, columns, 1, true, true, true, false, projected_values, projected_nulls, projected_overflow_refs, short_projection_mask)): return err("YDBv1 projected row decoder accepted a mask with the wrong schema width")
    let corrupt_unprojected_boolean: Bytes = bytes_try_slice(encoded, 0, encoded_length)?
    if not bytes_try_set(corrupt_unprojected_boolean, yaza_db_row_header_size_v1() + 1 + 8 + 8, 2): return err("YDBv1 unprojected BOOLEAN fixture could not be corrupted")
    if result_is_ok(yaza_db_row_decode_for_stream_scan_span_v1(corrupt_unprojected_boolean, 0, encoded_length, columns, 1, true, true, true, false, projected_values, projected_nulls, projected_overflow_refs, projected_columns)): return err("YDBv1 projected scan skipped validation of an unrequested BOOLEAN column")
    let text_offset_field: Number = yaza_db_row_header_size_v1() + 1 + 8 + 8 + 1
    let text_row_offset: Number = yaza_db_read_uint_le_v1(encoded, text_offset_field, 2)?
    let corrupt_unprojected_utf8: Bytes = bytes_try_slice(encoded, 0, encoded_length)?
    if not bytes_try_set(corrupt_unprojected_utf8, text_row_offset + 4, 255): return err("YDBv1 unprojected TEXT fixture could not be corrupted")
    if result_is_ok(yaza_db_row_decode_for_stream_scan_span_v1(corrupt_unprojected_utf8, 0, encoded_length, columns, 1, true, true, true, false, projected_values, projected_nulls, projected_overflow_refs, projected_columns)): return err("YDBv1 projected scan skipped UTF-8 validation of an unrequested TEXT column")
    let truncated_source_result: Result[Bytes, Text] = bytes_try_new_zeroed(encoded_length + 1)
    if not result_is_ok(truncated_source_result): return err("YDBv1 truncated row span fixture could not allocate its backing bytes")
    let truncated_source: Bytes = result_unwrap(truncated_source_result)
    var truncated_index: Number = 0
    while truncated_index < encoded_length - 1:
        if not bytes_try_set(truncated_source, truncated_index, bytes_get(encoded, truncated_index)): return err("YDBv1 truncated row span fixture could not copy its valid prefix")
        set truncated_index = truncated_index + 1
    if not bytes_try_set(truncated_source, encoded_length - 1, 0): return err("YDBv1 truncated row span fixture could not add its adjacent sentinel")
    let truncated_span: Result[YazaDbRowV1, Text] = yaza_db_row_decode_for_scan_span_v1(truncated_source, 0, encoded_length - 1, columns, 1, true, false, true, reusable_values, reusable_nulls, reusable_overflow_refs)
    if result_is_ok(truncated_span): return err("YDBv1 row span decoder read past a truncated row into adjacent page bytes")

    var span_bench_index: Number = 0
    let copy_decode_start: Number = arena_used()
    while span_bench_index < 256:
        let copied_payload: Bytes = bytes_try_slice(encoded, 0, encoded_length)?
        let copied_row: YazaDbRowV1 = yaza_db_row_decode_for_scan_v1(copied_payload, columns, 1, true, false, reusable_values, reusable_nulls, reusable_overflow_refs)?
        if copied_row.version_ts != 77: return err("YDBv1 copied row scan decode changed its version")
        set span_bench_index = span_bench_index + 1
    let copied_decode_growth: Number = arena_used() - copy_decode_start
    set span_bench_index = 0
    let span_decode_start: Number = arena_used()
    while span_bench_index < 256:
        let viewed_row: YazaDbRowV1 = yaza_db_row_decode_for_scan_span_v1(encoded, 0, encoded_length, columns, 1, true, false, true, reusable_values, reusable_nulls, reusable_overflow_refs)?
        if viewed_row.version_ts != 77: return err("YDBv1 borrowed row scan decode changed its version")
        set span_bench_index = span_bench_index + 1
    let span_decode_growth: Number = arena_used() - span_decode_start
    if copied_decode_growth < 256 * encoded_length or span_decode_growth >= copied_decode_growth:
        return err("YDBv1 row span scan did not reduce transient arena allocation versus payload copies")
    say "yazabase-row-span-arena copy=" + number_text(copied_decode_growth) + " span=" + number_text(span_decode_growth)
    let invalid_utf8_text: Bytes = bytes_try_slice(encoded, 0, bytes_length(encoded))?
    if not bytes_try_set(invalid_utf8_text, 48, 192) or not bytes_try_set(invalid_utf8_text, 49, 175): return err("YDBv1 invalid-UTF8 row fixture could not be corrupted")
    if result_is_ok(yaza_db_row_decode_for_schema_with_buffers_v1(invalid_utf8_text, columns, 1, false, false, List[YazaSqlValueV1](), List[Boolean](), List[YazaDbOverflowRefV1]())):
        return err("YDBv1 non-materializing TEXT decode accepted invalid UTF-8")

    let active_txn_version: Number = yaza_db_row_version_txn_encode_v1(41)?
    if active_txn_version >= 0: return err("YDBv1 active transaction version did not set its high-bit tag")
    let active_txn_row: Bytes = yaza_db_row_encode_v1(values, nulls, columns, active_txn_version)?
    let active_txn_decoded: YazaDbRowV1 = yaza_db_row_decode_v1(active_txn_row, columns)?
    if active_txn_decoded.version_ts != active_txn_version: return err("YDBv1 in-progress version tag did not round-trip")
    let active_txn_id: Number = yaza_db_row_version_txn_decode_v1(active_txn_decoded.version_ts)?
    if active_txn_id != 41: return err("YDBv1 in-progress version tag lost its transaction ID")
    if result_is_ok(yaza_db_row_version_txn_encode_v1(0)): return err("YDBv1 row version encoder accepted reserved transaction ID zero")
    if result_is_ok(yaza_db_row_version_txn_decode_v1(77)): return err("YDBv1 row version decoder treated a committed timestamp as a transaction ID")
    let zero_txn_tag: Number = yaza_db_row_version_min_signed_v1()
    if result_is_ok(yaza_db_row_encode_v1(values, nulls, columns, zero_txn_tag)): return err("YDBv1 row encoder accepted high-bit tag with transaction ID zero")

    let nullable_values: List[YazaSqlValueV1] = yaza_base_row_v1_values("")
    let nullable_row: Bytes = yaza_db_row_encode_v1(nullable_values, yaza_base_row_v1_nulls(true), columns, 78)?
    let decoded_nullable: YazaDbRowV1 = yaza_db_row_decode_v1(nullable_row, columns)?
    if not list_get(decoded_nullable.nulls, 3) or not list_get(decoded_nullable.values, 3).is_null or list_get(decoded_nullable.values, 3).text_value != "": return err("YDBv1 nullable TEXT did not use the canonical NULL representation")

    let expanded_columns: List[YazaSqlColumnSchemaV1] = yaza_base_row_v2_columns()
    let legacy_row: Bytes = yaza_db_row_encode_v1(values, nulls, columns, 81)?
    let legacy_as_v2: YazaDbRowV1 = yaza_db_row_decode_for_schema_v1(legacy_row, expanded_columns, 2)?
    if legacy_as_v2.schema_epoch != 1 or legacy_as_v2.schema_version != 2 or legacy_as_v2.physical_column_count != 4: return err("YDBv1 legacy row lost its explicit epoch-1 physical width")
    if list_count(legacy_as_v2.values) != 5 or list_count(legacy_as_v2.nulls) != 5 or not list_get(legacy_as_v2.nulls, 4) or not list_get(legacy_as_v2.values, 4).is_null or list_get(legacy_as_v2.values, 4).text_value != "": return err("YDBv1 legacy row did not expose an appended nullable column as SQL NULL")
    let exact_legacy_row: Bytes = yaza_db_row_encode_physical_schema_v1(legacy_as_v2.values, legacy_as_v2.nulls, expanded_columns, legacy_as_v2.version_ts, legacy_as_v2.schema_version, legacy_as_v2.schema_epoch, legacy_as_v2.physical_column_count)?
    if not bytes_equal(exact_legacy_row, legacy_row): return err("YDBv1 legacy row epoch/width did not round-trip exactly for MVCC history")

    let expanded_values: List[YazaSqlValueV1] = yaza_base_row_v2_values()
    let expanded_nulls: List[Boolean] = yaza_base_row_v2_nulls()
    let epoch_two_row: Bytes = yaza_db_row_encode_for_schema_v1(expanded_values, expanded_nulls, expanded_columns, 82, 2)?
    let epoch_two_tag: Number = yaza_db_read_uint_le_v1(epoch_two_row, 22, 2)?
    let epoch_two_width: Number = yaza_db_read_uint_le_v1(epoch_two_row, 18, 2)?
    let decoded_epoch_two: YazaDbRowV1 = yaza_db_row_decode_for_schema_v1(epoch_two_row, expanded_columns, 2)?
    if epoch_two_tag != 32770 or epoch_two_width != 5 or decoded_epoch_two.schema_epoch != 2 or decoded_epoch_two.physical_column_count != 5: return err("YDBv1 epoch-2 row did not encode its schema tag and physical width")
    if list_get(decoded_epoch_two.values, 4).text_value != "since-v2" or list_get(decoded_epoch_two.nulls, 4): return err("YDBv1 epoch-2 row lost its appended column value")
    if result_is_ok(yaza_db_row_decode_v1(epoch_two_row, expanded_columns)): return err("YDBv1 legacy-schema decoder accepted a future row epoch")
    let wrong_legacy_width: Bytes = bytes_try_slice(legacy_row, 0, bytes_length(legacy_row))?
    if not yaza_db_write_uint_le_v1(wrong_legacy_width, 18, 3, 2): return err("YDBv1 legacy-width corruption fixture could not be written")
    if result_is_ok(yaza_db_row_decode_for_schema_v1(wrong_legacy_width, expanded_columns, 2)): return err("YDBv1 decoder accepted a row width inconsistent with its schema epoch")
    let noncanonical_schema_tag: Bytes = bytes_try_slice(legacy_row, 0, bytes_length(legacy_row))?
    if not yaza_db_write_uint_le_v1(noncanonical_schema_tag, 22, 1, 2): return err("YDBv1 schema-tag corruption fixture could not be written")
    if result_is_ok(yaza_db_row_decode_for_schema_v1(noncanonical_schema_tag, expanded_columns, 2)): return err("YDBv1 decoder accepted a non-canonical row schema tag")
    let nonnullable_suffix: List[YazaSqlColumnSchemaV1] = yaza_base_row_v1_columns()
    list_push(nonnullable_suffix, YazaSqlColumnSchemaV1("note", 9, false, 4, 0, 0, ""))
    if result_is_ok(yaza_db_row_decode_for_schema_v1(legacy_row, nonnullable_suffix, 2)): return err("YDBv1 decoder synthesized NULL for a non-nullable schema addition")

    let epoch_two_stamped: Bytes = yaza_db_row_set_undo_ref_v1(epoch_two_row, 96)?
    let epoch_two_deleted: Bytes = yaza_db_row_set_deleted_v1(epoch_two_stamped, true)?
    let decoded_epoch_two_deleted: YazaDbRowV1 = yaza_db_row_decode_for_schema_v1(epoch_two_deleted, expanded_columns, 2)?
    if not decoded_epoch_two_deleted.deleted or decoded_epoch_two_deleted.undo_ref != 96 or decoded_epoch_two_deleted.schema_epoch != 2: return err("YDBv1 row mutation failed to preserve its versioned schema tag")

    let null_score_flags: List[Boolean] = List[Boolean]()
    list_push(null_score_flags, false)
    list_push(null_score_flags, true)
    list_push(null_score_flags, false)
    list_push(null_score_flags, false)
    let null_score_row: Bytes = yaza_db_row_encode_v1(values, null_score_flags, columns, 79)?
    let corrupt_null_fixed: Bytes = bytes_try_slice(null_score_row, 0, bytes_length(null_score_row))?
    if not bytes_try_set(corrupt_null_fixed, 33, 1): return err("YDBv1 NULL fixed-field fixture could not be corrupted")
    if result_is_ok(yaza_db_row_decode_v1(corrupt_null_fixed, columns)): return err("YDBv1 row decoder accepted non-zero bytes in a NULL fixed field")
    let null_bit_without_infomask: Bytes = bytes_try_slice(encoded, 0, bytes_length(encoded))?
    if not bytes_try_set(null_bit_without_infomask, yaza_db_row_header_size_v1(), 1): return err("YDBv1 NULL bitmap/infomask fixture could not be corrupted")
    if result_is_ok(yaza_db_row_decode_v1(null_bit_without_infomask, columns)): return err("YDBv1 no-NULL fast path accepted a set bitmap bit with a clear infomask")

    let not_nulls: List[Boolean] = List[Boolean]()
    list_push(not_nulls, true)
    list_push(not_nulls, false)
    list_push(not_nulls, false)
    list_push(not_nulls, false)
    if result_is_ok(yaza_db_row_encode_v1(values, not_nulls, columns, 80)): return err("YDBv1 row encoder accepted NULL in a NOT NULL column")

    let corrupt_offset: Bytes = bytes_try_slice(encoded, 0, bytes_length(encoded))?
    if not bytes_try_set(corrupt_offset, 42, 45): return err("YDBv1 row offset corruption fixture could not be written")
    if result_is_ok(yaza_db_row_decode_v1(corrupt_offset, columns)): return err("YDBv1 row decoder accepted a non-canonical TEXT offset")
    let stamped_row: Bytes = yaza_db_row_set_undo_ref_v1(encoded, 64)?
    let decoded_stamped: YazaDbRowV1 = yaza_db_row_decode_v1(stamped_row, columns)?
    if decoded_stamped.undo_ref != 64 or decoded_stamped.deleted: return err("YDBv1 row undo reference did not round-trip")
    if result_is_ok(yaza_db_row_set_undo_ref_v1(stamped_row, 80)): return err("YDBv1 row accepted replacement of an existing undo reference")
    if result_is_ok(yaza_db_row_set_undo_ref_v1(encoded, 0)): return err("YDBv1 row accepted zero as a persisted undo target")
    let tombstone_row: Bytes = yaza_db_row_set_deleted_v1(stamped_row, true)?
    let decoded_tombstone: YazaDbRowV1 = yaza_db_row_decode_v1(tombstone_row, columns)?
    if not decoded_tombstone.deleted or decoded_tombstone.undo_ref != 64: return err("YDBv1 row tombstone did not preserve its undo reference")
    let restored_live_row: Bytes = yaza_db_row_set_deleted_v1(tombstone_row, false)?
    let decoded_restored_live: YazaDbRowV1 = yaza_db_row_decode_v1(restored_live_row, columns)?
    if decoded_restored_live.deleted or decoded_restored_live.undo_ref != 64: return err("YDBv1 row live/tombstone flag did not round-trip")
    let out_of_range_undo: Bytes = bytes_try_slice(encoded, 0, bytes_length(encoded))?
    if not yaza_db_write_uint_le_v1(out_of_range_undo, 8, yaza_db_row_max_undo_ref_v1() + 1, 8): return err("YDBv1 out-of-range undo fixture could not be written")
    if result_is_ok(yaza_db_row_decode_v1(out_of_range_undo, columns)): return err("YDBv1 row decoder accepted an undo LSN above the WAL limit")
    let unknown_infomask: Bytes = bytes_try_slice(encoded, 0, bytes_length(encoded))?
    if not yaza_db_write_uint_le_v1(unknown_infomask, 16, 2, 2): return err("YDBv1 unknown-infomask fixture could not be written")
    if result_is_ok(yaza_db_row_decode_v1(unknown_infomask, columns)): return err("YDBv1 row decoder accepted an unsupported infomask flag")

    let large_text: Text = text_try_repeat("x", 5000)?
    let large_text_bytes: Bytes = bytes_try_from_text(large_text)?
    let overflow_columns: List[YazaSqlColumnSchemaV1] = List[YazaSqlColumnSchemaV1]()
    let overflow_values: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let overflow_nulls: List[Boolean] = List[Boolean]()
    let overflow_refs: List[YazaDbOverflowRefV1] = List[YazaDbOverflowRefV1]()
    list_push(overflow_columns, YazaSqlColumnSchemaV1("payload", 9, false, 0, 0, 0, ""))
    list_push(overflow_values, yaza_sql_value_text_v1(large_text))
    list_push(overflow_nulls, false)
    let overflow_ref: YazaDbOverflowRefV1 = YazaDbOverflowRefV1(8, bytes_length(large_text_bytes), bytes_ydbv1_checksum(large_text_bytes), 0)
    list_push(overflow_refs, overflow_ref)
    let overflow_row: Bytes = yaza_db_row_encode_for_schema_with_overflow_v1(overflow_values, overflow_nulls, overflow_refs, overflow_columns, 91, 1)?
    let overflow_offset: Number = yaza_db_read_uint_le_v1(overflow_row, 25, 2)?
    let overflow_marker: Number = yaza_db_read_uint_le_v1(overflow_row, overflow_offset, 4)?
    if overflow_offset != 27 or overflow_marker != yaza_db_row_overflow_length_marker_v1(): return err("YDBv1 row did not encode the external-TEXT marker at the canonical offset")
    let decoded_overflow: YazaDbRowV1 = yaza_db_row_decode_v1(overflow_row, overflow_columns)?
    if list_count(decoded_overflow.overflow_refs) != 1 or list_count(decoded_overflow.values) != 1 or decoded_overflow.text_input_bytes != 5000 or decoded_overflow.max_text_input_bytes != 5000: return err("YDBv1 external-TEXT row returned invalid field width or text-budget metadata")
    let decoded_overflow_ref: YazaDbOverflowRefV1 = list_get(decoded_overflow.overflow_refs, 0)
    let decoded_overflow_value: YazaSqlValueV1 = list_get(decoded_overflow.values, 0)
    if decoded_overflow_ref.first_page_id != 8 or decoded_overflow_ref.total_length != 5000 or decoded_overflow_value.text_value != "": return err("YDBv1 external-TEXT row did not preserve its reference and placeholder")
    let exact_overflow_row: Bytes = yaza_db_row_encode_physical_schema_with_overflow_v1(decoded_overflow.values, decoded_overflow.nulls, decoded_overflow.overflow_refs, overflow_columns, decoded_overflow.version_ts, decoded_overflow.schema_version, decoded_overflow.schema_epoch, decoded_overflow.physical_column_count)?
    if not bytes_equal(exact_overflow_row, overflow_row): return err("YDBv1 external-TEXT row reference did not round-trip byte-for-byte")
    let mismatched_overflow_refs: List[YazaDbOverflowRefV1] = List[YazaDbOverflowRefV1]()
    list_push(mismatched_overflow_refs, YazaDbOverflowRefV1(8, 5001, overflow_ref.checksum, 0))
    if result_is_ok(yaza_db_row_encode_for_schema_with_overflow_v1(overflow_values, overflow_nulls, mismatched_overflow_refs, overflow_columns, 91, 1)): return err("YDBv1 row encoder accepted an external-TEXT reference length that disagrees with its value")
    let truncated_overflow_row: Bytes = bytes_try_slice(overflow_row, 0, bytes_length(overflow_row) - 1)?
    if result_is_ok(yaza_db_row_decode_v1(truncated_overflow_row, overflow_columns)): return err("YDBv1 row decoder accepted a truncated external-TEXT reference")
    let corrupt_overflow_ref: Bytes = bytes_try_slice(overflow_row, 0, bytes_length(overflow_row))?
    if not yaza_db_write_uint_le_v1(corrupt_overflow_ref, overflow_offset + 4 + 20, 1, 4): return err("YDBv1 overflow-reference corruption fixture could not be written")
    if result_is_ok(yaza_db_row_decode_v1(corrupt_overflow_ref, overflow_columns)): return err("YDBv1 row decoder accepted a non-zero external-TEXT reserved field")
    if result_is_ok(yaza_db_row_encode_v1(overflow_values, overflow_nulls, overflow_columns, 91)): return err("YDBv1 row encoder accepted large TEXT without an overflow reference")

    let corrupt_zero_txn_tag: Bytes = bytes_try_slice(encoded, 0, bytes_length(encoded))?
    if not yaza_db_write_int_le_v1(corrupt_zero_txn_tag, 0, zero_txn_tag, 8): return err("YDBv1 zero-transaction version fixture could not be written")
    if result_is_ok(yaza_db_row_decode_v1(corrupt_zero_txn_tag, columns)): return err("YDBv1 row decoder accepted an invalid in-progress version tag")

    let leaf_page: Bytes = yaza_db_page_new_v1(6, 80, 1, 0)?
    let row_slot: Number = yaza_db_page_add_slot_v1(leaf_page, bytes_from_text("row:0001"), encoded)?
    if row_slot != 0: return err("YDBv1 row did not occupy the first leaf slot")
    let sealed_leaf: Bytes = yaza_db_page_finalize_v1(leaf_page)?
    let stored_slot: YazaDbPageSlotV1 = yaza_db_page_slot_v1(sealed_leaf, 0, 6)?
    let stored_row: YazaDbRowV1 = yaza_db_row_decode_v1(stored_slot.payload, columns)?
    if stored_row.version_ts != 77 or list_get(stored_row.values, 0).integer_value != -9223372036854775807 - 1: return err("YDBv1 row payload did not round-trip through a leaf page")

    # BLOB is opaque bytes: the fixture deliberately includes NUL and invalid
    # UTF-8 so an accidental Text conversion is caught by the round trip.
    let blob_columns: List[YazaSqlColumnSchemaV1] = List[YazaSqlColumnSchemaV1]()
    let blob_values: List[YazaSqlValueV1] = List[YazaSqlValueV1]()
    let blob_nulls: List[Boolean] = List[Boolean]()
    let raw_blob: Bytes = bytes_try_new_zeroed(3)?
    if not bytes_try_set(raw_blob, 0, 255) or not bytes_try_set(raw_blob, 1, 0) or not bytes_try_set(raw_blob, 2, 128): return err("BLOB row fixture could not initialize arbitrary bytes")
    list_push(blob_columns, YazaSqlColumnSchemaV1("raw", 16, false, 0, 0, 0, ""))
    list_push(blob_columns, YazaSqlColumnSchemaV1("empty_value", 16, false, 1, 0, 0, ""))
    list_push(blob_columns, YazaSqlColumnSchemaV1("optional", 16, true, 2, 0, 0, ""))
    let raw_blob_value: Result[YazaSqlValueV1, Text] = yaza_sql_value_blob_v1(raw_blob)
    let empty_blob_value: Result[YazaSqlValueV1, Text] = yaza_sql_value_blob_v1(bytes_empty())
    let null_blob_value: Result[YazaSqlValueV1, Text] = yaza_sql_value_null_v1(16)
    if not result_is_ok(raw_blob_value) or not result_is_ok(empty_blob_value) or not result_is_ok(null_blob_value): return err("BLOB SQL value construction failed")
    list_push(blob_values, result_unwrap(raw_blob_value))
    list_push(blob_values, result_unwrap(empty_blob_value))
    list_push(blob_values, result_unwrap(null_blob_value))
    list_push(blob_nulls, false)
    list_push(blob_nulls, false)
    list_push(blob_nulls, true)
    let blob_row: Bytes = yaza_db_row_encode_v1(blob_values, blob_nulls, blob_columns, 92)?
    let decoded_blob_row: YazaDbRowV1 = yaza_db_row_decode_v1(blob_row, blob_columns)?
    if list_count(decoded_blob_row.values) != 3 or not bytes_equal(list_get(decoded_blob_row.values, 0).bytes_value, raw_blob): return err("YDBv1 BLOB row changed arbitrary byte payload")
    if bytes_length(list_get(decoded_blob_row.values, 1).bytes_value) != 0 or not list_get(decoded_blob_row.nulls, 2): return err("YDBv1 BLOB row changed empty-value or NULL semantics")
    let large_blob: Bytes = bytes_try_new_zeroed(5000)?
    var large_blob_index: Number = 0
    while large_blob_index < bytes_length(large_blob):
        var large_blob_byte: Number = large_blob_index % 256
        if large_blob_index % 3 == 0: set large_blob_byte = 255
        if not bytes_try_set(large_blob, large_blob_index, large_blob_byte): return err("BLOB overflow fixture could not initialize its payload")
        set large_blob_index = large_blob_index + 1
    let large_blob_value: Result[YazaSqlValueV1, Text] = yaza_sql_value_blob_v1(large_blob)
    if not result_is_ok(large_blob_value): return err("BLOB overflow fixture value construction failed")
    let large_blob_values: List[YazaSqlValueV1] = [result_unwrap(large_blob_value)]
    let large_blob_nulls: List[Boolean] = [false]
    let large_blob_columns: List[YazaSqlColumnSchemaV1] = [YazaSqlColumnSchemaV1("payload", 16, false, 0, 0, 0, "")]
    let large_blob_ref: YazaDbOverflowRefV1 = YazaDbOverflowRefV1(8, bytes_length(large_blob), bytes_ydbv1_checksum(large_blob), 0)
    let large_blob_refs: List[YazaDbOverflowRefV1] = [large_blob_ref]
    let large_blob_row: Bytes = yaza_db_row_encode_for_schema_with_overflow_v1(large_blob_values, large_blob_nulls, large_blob_refs, large_blob_columns, 93, 1)?
    let decoded_large_blob_row: YazaDbRowV1 = yaza_db_row_decode_v1(large_blob_row, large_blob_columns)?
    if list_get(decoded_large_blob_row.overflow_refs, 0).total_length != 5000 or bytes_length(list_get(decoded_large_blob_row.values, 0).bytes_value) != 0: return err("YDBv1 BLOB overflow row lost its reference or placeholder")
    let canonical_large_blob_row: Bytes = yaza_db_row_encode_for_schema_with_overflow_v1(decoded_large_blob_row.values, decoded_large_blob_row.nulls, decoded_large_blob_row.overflow_refs, large_blob_columns, 93, 1)?
    if not bytes_equal(canonical_large_blob_row, large_blob_row): return err("YDBv1 BLOB overflow row did not round-trip canonically")

    return ok(bytes_length(encoded))

start:
    let outcome: Result[Number, Text] = yaza_base_row_v1_check()
    if result_is_ok(outcome):
        say "yazabase-row-v1-ok bytes=" + number_text(result_unwrap(outcome))
    else:
        say result_unwrap_error(outcome)
