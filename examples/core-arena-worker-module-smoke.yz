fn request_length(request_id: Number, suffix: Number) -> Number:
    let formatted_result: Result[Text, Text] = number_try_text(request_id + suffix)
    if result_is_ok(formatted_result):
        let formatted: Text = result_unwrap(formatted_result)
        let request_text_result: Result[Text, Text] = text_try_concat("request-", formatted)
        if result_is_ok(request_text_result):
            let request_text: Text = result_unwrap(request_text_result)
            return text_length(request_text)
    return -1

fn request_text(request_id: Text) -> Number:
    return text_length(request_id)

