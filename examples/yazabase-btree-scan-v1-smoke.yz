use "std/fs"
use "../yazabase/btree_scan_v1"
use "../yazabase/key_codec_v1"
use "../yazabase/page_v1"
use "../yazabase/row_v1"
use "../yazabase/sql_executor_v1"
use "../yazabase/storage_v1"

shape YazaBtreeScanSmokeTupleV1:
    key: Bytes
    payload: Bytes

fn yaza_btree_scan_smoke_tuple_v1(value: Number, columns: List[YazaSqlColumnSchemaV1]) -> Result[YazaBtreeScanSmokeTupleV1, Text]:
    let values_result: Result[List[YazaSqlValueV1], Text] = list_try_new()
    if not result_is_ok(values_result): return err(result_unwrap_error(values_result))
    let values: List[YazaSqlValueV1] = result_unwrap(values_result)
    let integer_value: YazaSqlValueV1 = yaza_sql_value_integer_v1(4, value)?
    if not list_try_push(values, integer_value): return err("YDBv1 B+Tree fixture value list growth failed")
    let nulls: List[Boolean] = [false]
    let row: Bytes = yaza_db_row_encode_v1(values, nulls, columns, 1)?
    let key: Bytes = yaza_db_key_encode_composite_v1(values, nulls, columns, [0])?
    return ok(YazaBtreeScanSmokeTupleV1(key, row))

fn yaza_btree_scan_smoke_leaf_v1(page_id: Number, values: List[Number], columns: List[YazaSqlColumnSchemaV1], has_low: Boolean, low: Bytes, has_high: Boolean, high: Bytes) -> Result[Bytes, Text]:
    var page: Bytes = yaza_db_page_new_v1(page_id, 0, 1, 0)?
    if has_low or has_high: set page = yaza_db_page_set_fences_v1(page, has_low, low, has_high, high)?
    var index: Number = 0
    while index < list_count(values):
        let tuple: YazaBtreeScanSmokeTupleV1 = yaza_btree_scan_smoke_tuple_v1(list_get(values, index), columns)?
        let inserted: Number = yaza_db_page_add_slot_v1(page, tuple.key, tuple.payload)?
        if inserted != index: return err("YDBv1 B+Tree fixture could not append a leaf tuple")
        set index = index + 1
    return yaza_db_page_finalize_v1(page)

fn yaza_base_btree_scan_v1_check(root_path: Text) -> Result[Number, Text]:
    let one_column_row_limit: Number = yaza_db_btree_scan_materialized_row_limit_v1(1)?
    let seventeen_column_row_limit: Number = yaza_db_btree_scan_materialized_row_limit_v1(17)?
    let maximum_width_row_limit: Number = yaza_db_btree_scan_materialized_row_limit_v1(1024)?
    if one_column_row_limit != 65536 or seventeen_column_row_limit != 61680 or maximum_width_row_limit != 1024:
        return err("YDBv1 B+Tree materialized scan row budget does not respect the executor cell cap")
    if result_is_ok(yaza_db_btree_scan_materialized_row_limit_v1(0)) or result_is_ok(yaza_db_btree_scan_materialized_row_limit_v1(1025)):
        return err("YDBv1 B+Tree materialized scan accepted a schema outside its bound")
    let root: Number = root_open(root_path)?
    let initial_header: YazaDbFileHeaderV1 = YazaDbFileHeaderV1(bytes_from_text("btree-scan-id001"), 0, 1, 1, 0, 2, 1)
    let storage: YazaDbStorageHandleV1 = yaza_db_storage_create_empty_v1(root, "btree-scan-smoke.ydb", initial_header)?

    let bitmap: Bytes = yaza_db_storage_read_page_v1(storage.file, storage.header, 2)?
    let bitmap_header: YazaDbPageHeaderV1 = yaza_db_page_header_decode_v1(bitmap, 2)?
    var page_id: Number = 3
    while page_id <= 18:
        let allocated: Boolean = yaza_db_bitmap_page_set_page_allocated_v1(bitmap, page_id, true, bitmap_header.page_lsn, 2)?
        if not allocated: return err("YDBv1 B+Tree fixture could not reserve its test pages")
        set page_id = page_id + 1
    let bitmap_written: Number = yaza_db_storage_write_page_sync_v1(storage.file, storage.header, bitmap)?
    if bitmap_written != yaza_db_page_size_v1(): return err("YDBv1 B+Tree fixture could not sync its allocation bitmap")

    let columns: List[YazaSqlColumnSchemaV1] = [YazaSqlColumnSchemaV1("id", 4, false, 0, 0, 0, "")]
    let prefix_tuple_one: YazaBtreeScanSmokeTupleV1 = yaza_btree_scan_smoke_tuple_v1(1, columns)?
    let prefix_tuple_two: YazaBtreeScanSmokeTupleV1 = yaza_btree_scan_smoke_tuple_v1(2, columns)?
    let shared_prefix: Bytes = bytes_try_slice(prefix_tuple_one.key, 0, 2)?
    var prefix_page: Bytes = yaza_db_page_new_v1(21, 0, 1, 0)?
    let prefix_set: Number = yaza_db_page_set_prefix_v1(prefix_page, shared_prefix)?
    if prefix_set != 2: return err("YDBv1 slot-span fixture could not set the shared key prefix")
    let prefix_slot_one: Number = yaza_db_page_add_slot_v1(prefix_page, prefix_tuple_one.key, prefix_tuple_one.payload)?
    let prefix_slot_two: Number = yaza_db_page_add_slot_v1(prefix_page, prefix_tuple_two.key, prefix_tuple_two.payload)?
    if prefix_slot_one != 0 or prefix_slot_two != 1: return err("YDBv1 slot-span fixture could not append prefix-compressed keys")
    set prefix_page = yaza_db_page_finalize_v1(prefix_page)?
    let prefix_header: YazaDbPageHeaderV1 = yaza_db_page_header_decode_v1(prefix_page, 21)?
    let prefix_span_one: YazaDbPageSlotSpanV1 = yaza_db_page_slot_span_from_validated_header_v1(prefix_page, prefix_header, 0)?
    let prefix_span_two: YazaDbPageSlotSpanV1 = yaza_db_page_slot_span_from_validated_header_v1(prefix_page, prefix_header, 1)?
    let prefix_one_equal: Number = yaza_db_page_slot_span_compare_key_v1(prefix_page, prefix_header, prefix_span_one, prefix_tuple_one.key)?
    let prefix_one_before_two: Number = yaza_db_page_slot_span_compare_key_v1(prefix_page, prefix_header, prefix_span_one, prefix_tuple_two.key)?
    let prefix_two_after_one: Number = yaza_db_page_slot_span_compare_key_v1(prefix_page, prefix_header, prefix_span_two, prefix_tuple_one.key)?
    if prefix_one_equal != 0 or prefix_one_before_two >= 0 or prefix_two_after_one <= 0: return err("YDBv1 slot-span comparison mishandled a shared prefix or key boundary")
    let prefix_key_scratch: Bytes = bytes_try_new_zeroed(8)?
    let prefix_value_one: YazaSqlValueV1 = yaza_sql_value_integer_v1(4, 1)?
    let prefix_value_two: YazaSqlValueV1 = yaza_sql_value_integer_v1(4, 2)?
    let prefix_one_matches: Boolean = yaza_db_key_matches_single_integer_span_v1(prefix_page, prefix_header, prefix_span_one, prefix_value_one, false, 4, prefix_key_scratch)?
    let prefix_wrong_value_matches: Boolean = yaza_db_key_matches_single_integer_span_v1(prefix_page, prefix_header, prefix_span_one, prefix_value_two, false, 4, prefix_key_scratch)?
    if not prefix_one_matches or prefix_wrong_value_matches: return err("YDBv1 allocation-free integer-key validation returned the wrong result")
    let tuple_three: YazaBtreeScanSmokeTupleV1 = yaza_btree_scan_smoke_tuple_v1(3, columns)?
    let key_three: Bytes = tuple_three.key
    let left_page: Bytes = yaza_btree_scan_smoke_leaf_v1(3, [1, 2], columns, false, bytes_from_text(""), true, key_three)?
    let right_page: Bytes = yaza_btree_scan_smoke_leaf_v1(4, [3, 4], columns, true, key_three, false, bytes_from_text(""))?
    let inner_page: Bytes = yaza_db_page_new_v1(5, 0, 2, 1)?
    if not yaza_db_page_set_upper_v1(inner_page, 4): return err("YDBv1 B+Tree fixture could not set the rightmost child pointer")
    let left_pointer: Bytes = bytes_try_new_zeroed(8)?
    if not yaza_db_write_uint_le_v1(left_pointer, 0, 6, 8): return err("YDBv1 B+Tree fixture could not encode its left child pointer")
    let separator_slot: Number = yaza_db_page_add_slot_v1(inner_page, key_three, left_pointer)?
    if separator_slot != 0: return err("YDBv1 B+Tree fixture could not add its child separator")
    let root_page: Bytes = yaza_db_page_finalize_v1(inner_page)?
    let left_written: Number = yaza_db_storage_write_page_sync_v1(storage.file, storage.header, left_page)?
    let right_written: Number = yaza_db_storage_write_page_sync_v1(storage.file, storage.header, right_page)?
    let root_written: Number = yaza_db_storage_write_page_sync_v1(storage.file, storage.header, root_page)?
    if left_written != yaza_db_page_size_v1() or right_written != yaza_db_page_size_v1() or root_written != yaza_db_page_size_v1(): return err("YDBv1 B+Tree fixture could not persist its test tree")

    let empty_point_cache: YazaDbBtreePointBitmapCacheV1 = YazaDbBtreePointBitmapCacheV1(false, -1, bytes_from_text(""))
    let first_point_page: YazaDbBtreeSeekPageReadV1 = yaza_db_btree_seek_read_page_v1(storage.file, storage.header, 3, empty_point_cache, List[Number]())?
    if not first_point_page.bitmap_cache.is_valid or first_point_page.bitmap_cache.bitmap_page_id != 2: return err("YDBv1 point seek did not retain its validated in-range allocation bitmap")
    let unallocated_leaf: Bytes = yaza_btree_scan_smoke_leaf_v1(19, [21], columns, false, bytes_from_text(""), false, bytes_from_text(""))?
    let unallocated_offset: Number = yaza_db_storage_page_offset_v1(19)?
    let unallocated_written: Number = write_exact(storage.file, unallocated_offset, unallocated_leaf)?
    if unallocated_written != yaza_db_page_size_v1(): return err("YDBv1 point-cache fixture could not construct a valid image in an unallocated slot")
    if result_is_ok(yaza_db_btree_seek_read_page_v1(storage.file, storage.header, 19, first_point_page.bitmap_cache, List[Number]())): return err("YDBv1 point seek accepted a valid page image whose allocation bit was clear in the cached bitmap")

    let tuple_one: YazaBtreeScanSmokeTupleV1 = yaza_btree_scan_smoke_tuple_v1(1, columns)?
    let first_key: Bytes = tuple_one.key
    let left_seek: YazaDbBtreeSeekV1 = yaza_db_btree_seek_leaf_v1(storage.file, storage.header, 5, first_key)?
    let right_seek: YazaDbBtreeSeekV1 = yaza_db_btree_seek_leaf_v1(storage.file, storage.header, 5, key_three)?
    if left_seek.leaf_page_id != 3 or right_seek.leaf_page_id != 4: return err("YDBv1 B+Tree separator did not route keys to the correct child")
    let left_path: YazaDbBtreeSeekPathV1 = yaza_db_btree_seek_leaf_with_path_v1(storage.file, storage.header, 5, first_key)?
    let right_path: YazaDbBtreeSeekPathV1 = yaza_db_btree_seek_leaf_with_path_v1(storage.file, storage.header, 5, key_three)?
    if left_path.leaf_page_id != 3 or left_path.page_reads != 2 or list_count(left_path.parent_path) != 1 or list_get(left_path.parent_path, 0).page_id != 5 or list_get(left_path.parent_path, 0).child_index != 0: return err("YDBv1 B+Tree left descent path did not preserve its parent and child slot")
    if right_path.leaf_page_id != 4 or right_path.page_reads != 2 or list_count(right_path.parent_path) != 1 or list_get(right_path.parent_path, 0).page_id != 5 or list_get(right_path.parent_path, 0).child_index != 1: return err("YDBv1 B+Tree separator descent path did not preserve its right child slot")
    let root_leaf_path: YazaDbBtreeSeekPathV1 = yaza_db_btree_seek_leaf_with_path_v1(storage.file, storage.header, 3, first_key)?
    if root_leaf_path.leaf_page_id != 3 or root_leaf_path.page_reads != 1 or list_count(root_leaf_path.parent_path) != 0: return err("YDBv1 B+Tree leaf-root descent path should be empty")
    let scan: YazaDbBtreeScanResultV1 = yaza_db_btree_read_rows_with_stats_v1(storage.file, storage.header, 5, columns, [0], 1, 10)?
    let rows: List[YazaDbRowV1] = scan.rows
    if list_count(rows) != 4: return err("YDBv1 B+Tree path cursor did not return every row")
    if scan.page_reads != 3: return err("YDBv1 B+Tree cursor page-read count was " + number_text(scan.page_reads) + ", expected 3 after retaining validated ancestor pages")
    let role_cache: YazaDbBtreePageValidationCacheV1 = yaza_db_btree_page_validation_cache_new_v1(storage.file, storage.header, List[Number]())?
    let cached_left_page: Bytes = yaza_db_btree_page_validation_cache_read_v1(role_cache, storage.file, storage.header, 3)?
    let cached_right_page: Bytes = yaza_db_btree_page_validation_cache_read_v1(role_cache, storage.file, storage.header, 4)?
    if bytes_length(cached_left_page) != yaza_db_page_size_v1() or bytes_length(cached_right_page) != yaza_db_page_size_v1(): return err("YDBv1 B+Tree bitmap cache returned an invalid data-page image")
    if list_count(role_cache.bitmap_page_reads) != 1 or list_get(role_cache.bitmap_page_reads, 0) != 1: return err("YDBv1 B+Tree cache reread the allocation bitmap for two pages in one range")
    if list_count(role_cache.bitmap_words) != yaza_db_btree_bitmap_cache_words_v1() or list_get(role_cache.bitmap_word_starts, 0) != 0: return err("YDBv1 B+Tree cache did not populate the bounded allocation-bitmap word window")
    let last_bit_in_first_window: Boolean = yaza_db_btree_page_validation_cache_bitmap_test_v1(role_cache, storage.file, storage.header, 2, 16383)?
    if last_bit_in_first_window or list_get(role_cache.bitmap_page_reads, 0) != 1: return err("YDBv1 B+Tree bitmap cache missed the final bit in its first word window")
    let first_bit_in_next_window: Boolean = yaza_db_btree_page_validation_cache_bitmap_test_v1(role_cache, storage.file, storage.header, 2, 16384)?
    if first_bit_in_next_window or list_get(role_cache.bitmap_page_reads, 0) != 2 or list_get(role_cache.bitmap_word_starts, 0) != 512: return err("YDBv1 B+Tree bitmap cache did not rotate to the next bounded word window")
    let last_bit_in_second_window: Boolean = yaza_db_btree_page_validation_cache_bitmap_test_v1(role_cache, storage.file, storage.header, 2, 32767)?
    if last_bit_in_second_window or list_get(role_cache.bitmap_page_reads, 0) != 2: return err("YDBv1 B+Tree bitmap cache did not reuse its second word window")
    let unallocated_bit: Boolean = yaza_db_btree_page_validation_cache_bitmap_test_v1(role_cache, storage.file, storage.header, 2, 17)?
    if unallocated_bit: return err("YDBv1 B+Tree bitmap cache marked an unallocated page as allocated")
    let stale_header: YazaDbFileHeaderV1 = YazaDbFileHeaderV1(storage.header.db_uuid, storage.header.checkpoint_lsn + 1, storage.header.next_txn_id, storage.header.next_commit_ts, storage.header.catalog_root, storage.header.page_count, storage.header.flags)
    if result_is_ok(yaza_db_btree_page_validation_cache_read_v1(role_cache, storage.file, stale_header, 5)): return err("YDBv1 B+Tree validation cache accepted a different snapshot identity")
    var row_index: Number = 0
    while row_index < 4:
        if list_get(list_get(rows, row_index).values, 0).integer_value != row_index + 1: return err("YDBv1 B+Tree cursor returned rows out of key order")
        set row_index = row_index + 1
    if result_is_ok(yaza_db_btree_read_rows_v1(storage.file, storage.header, 5, columns, [0], 1, 3)): return err("YDBv1 B+Tree scan exceeded the caller's row limit")
    let prefix_scan: YazaDbBtreeScanResultV1 = yaza_db_btree_read_rows_prefix_with_stats_v1(storage.file, storage.header, 5, columns, [0], 1, 2)?
    if list_count(prefix_scan.rows) != 2 or prefix_scan.page_reads != 2: return err("YDBv1 B+Tree prefix scan did not stop after its requested rows")
    if list_get(list_get(prefix_scan.rows, 0).values, 0).integer_value != 1 or list_get(list_get(prefix_scan.rows, 1).values, 0).integer_value != 2: return err("YDBv1 B+Tree prefix scan returned incorrect rows")
    let empty_prefix_scan: YazaDbBtreeScanResultV1 = yaza_db_btree_read_rows_prefix_with_stats_v1(storage.file, storage.header, 5, columns, [0], 1, 0)?
    if list_count(empty_prefix_scan.rows) != 0 or empty_prefix_scan.page_reads != 0: return err("YDBv1 zero-row prefix scan should avoid all page reads")
    let continuation_after_three: List[YazaDbRowV1] = yaza_db_btree_read_rows_after_key_for_schema_v1(storage.file, storage.header, 5, columns, 1, [0], 1, key_three, 1)?
    if list_count(continuation_after_three) != 1 or list_get(list_get(continuation_after_three, 0).values, 0).integer_value != 4: return err("YDBv1 B+Tree continuation did not return the first key strictly after its cursor")

    let tuple_five: YazaBtreeScanSmokeTupleV1 = yaza_btree_scan_smoke_tuple_v1(5, columns)?
    let tuple_seven: YazaBtreeScanSmokeTupleV1 = yaza_btree_scan_smoke_tuple_v1(7, columns)?
    let leaf_six: Bytes = yaza_btree_scan_smoke_leaf_v1(6, [1, 2], columns, false, bytes_from_text(""), true, tuple_three.key)?
    let leaf_seven: Bytes = yaza_btree_scan_smoke_leaf_v1(7, [3, 4], columns, true, tuple_three.key, true, tuple_five.key)?
    let leaf_eight: Bytes = yaza_btree_scan_smoke_leaf_v1(8, [5, 6], columns, true, tuple_five.key, true, tuple_seven.key)?
    let leaf_nine: Bytes = yaza_btree_scan_smoke_leaf_v1(9, [7, 8], columns, true, tuple_seven.key, false, bytes_from_text(""))?

    var inner_left: Bytes = yaza_db_page_new_v1(10, 0, 2, 1)?
    if not yaza_db_page_set_upper_v1(inner_left, 7): return err("YDBv1 multi-level B+Tree fixture could not set the left INNER upper child")
    set inner_left = yaza_db_page_finalize_v1(inner_left)?
    set inner_left = yaza_db_page_set_fences_v1(inner_left, false, bytes_from_text(""), true, tuple_five.key)?
    let leaf_six_pointer: Bytes = bytes_try_new_zeroed(8)?
    if not yaza_db_write_uint_le_v1(leaf_six_pointer, 0, 12, 8): return err("YDBv1 multi-level B+Tree fixture could not encode the first leaf pointer")
    let left_separator: Number = yaza_db_page_add_slot_v1(inner_left, tuple_three.key, leaf_six_pointer)?
    if left_separator != 0: return err("YDBv1 multi-level B+Tree fixture could not add the left separator")
    let inner_left_final: Bytes = yaza_db_page_finalize_v1(inner_left)?

    var inner_right: Bytes = yaza_db_page_new_v1(11, 0, 2, 1)?
    if not yaza_db_page_set_upper_v1(inner_right, 9): return err("YDBv1 multi-level B+Tree fixture could not set the right INNER upper child")
    set inner_right = yaza_db_page_finalize_v1(inner_right)?
    set inner_right = yaza_db_page_set_fences_v1(inner_right, true, tuple_five.key, false, bytes_from_text(""))?
    let leaf_eight_pointer: Bytes = bytes_try_new_zeroed(8)?
    if not yaza_db_write_uint_le_v1(leaf_eight_pointer, 0, 16, 8): return err("YDBv1 multi-level B+Tree fixture could not encode the third leaf pointer")
    let right_separator: Number = yaza_db_page_add_slot_v1(inner_right, tuple_seven.key, leaf_eight_pointer)?
    if right_separator != 0: return err("YDBv1 multi-level B+Tree fixture could not add the right separator")
    let inner_right_final: Bytes = yaza_db_page_finalize_v1(inner_right)?

    var root_level_two: Bytes = yaza_db_page_new_v1(12, 0, 2, 2)?
    if not yaza_db_page_set_upper_v1(root_level_two, 11): return err("YDBv1 multi-level B+Tree fixture could not set the root upper child")
    let inner_left_pointer: Bytes = bytes_try_new_zeroed(8)?
    if not yaza_db_write_uint_le_v1(inner_left_pointer, 0, 20, 8): return err("YDBv1 multi-level B+Tree fixture could not encode the left INNER pointer")
    let root_separator: Number = yaza_db_page_add_slot_v1(root_level_two, tuple_five.key, inner_left_pointer)?
    if root_separator != 0: return err("YDBv1 multi-level B+Tree fixture could not add the root separator")
    let root_level_two_final: Bytes = yaza_db_page_finalize_v1(root_level_two)?
    let leaf_six_written: Number = yaza_db_storage_write_page_sync_v1(storage.file, storage.header, leaf_six)?
    let leaf_seven_written: Number = yaza_db_storage_write_page_sync_v1(storage.file, storage.header, leaf_seven)?
    let leaf_eight_written: Number = yaza_db_storage_write_page_sync_v1(storage.file, storage.header, leaf_eight)?
    let leaf_nine_written: Number = yaza_db_storage_write_page_sync_v1(storage.file, storage.header, leaf_nine)?
    let inner_left_written: Number = yaza_db_storage_write_page_sync_v1(storage.file, storage.header, inner_left_final)?
    let inner_right_written: Number = yaza_db_storage_write_page_sync_v1(storage.file, storage.header, inner_right_final)?
    let root_level_two_written: Number = yaza_db_storage_write_page_sync_v1(storage.file, storage.header, root_level_two_final)?
    if leaf_six_written != yaza_db_page_size_v1() or leaf_seven_written != yaza_db_page_size_v1() or leaf_eight_written != yaza_db_page_size_v1() or leaf_nine_written != yaza_db_page_size_v1() or inner_left_written != yaza_db_page_size_v1() or inner_right_written != yaza_db_page_size_v1() or root_level_two_written != yaza_db_page_size_v1(): return err("YDBv1 multi-level B+Tree fixture could not persist its test tree")
    let multi_level_scan: YazaDbBtreeScanResultV1 = yaza_db_btree_read_rows_with_stats_v1(storage.file, storage.header, 12, columns, [0], 1, 10)?
    if list_count(multi_level_scan.rows) != 8: return err("YDBv1 multi-level B+Tree cursor did not visit all four leaves")
    if multi_level_scan.page_reads != 7: return err("YDBv1 multi-level B+Tree cursor page-read count was " + number_text(multi_level_scan.page_reads) + ", expected 7 after retaining validated ancestors")
    set row_index = 0
    while row_index < 8:
        if list_get(list_get(multi_level_scan.rows, row_index).values, 0).integer_value != row_index + 1: return err("YDBv1 multi-level B+Tree cursor returned rows out of key order")
        set row_index = row_index + 1
    let upper_exclusive_scan: YazaDbBtreeScanResultV1 = yaza_db_btree_read_rows_internal_filtered_profiled_v1(0, bytes_from_text(""), 0, storage.file, storage.header, 12, columns, 1, [0], 1, 10, false, 0, List[YazaDbTxnStatusV1](), false, false, bytes_from_text(""), true, tuple_three.key, false, none, List[YazaSqlValueV1](), List[YazaSqlSubqueryValuesV1](), List[Number](), false)?
    if list_count(upper_exclusive_scan.rows) != 2 or upper_exclusive_scan.page_reads != 3: return err("YDBv1 exclusive upper fence scan should stop before reading the next leaf")
    if list_get(list_get(upper_exclusive_scan.rows, 0).values, 0).integer_value != 1 or list_get(list_get(upper_exclusive_scan.rows, 1).values, 0).integer_value != 2: return err("YDBv1 exclusive upper fence scan returned an incorrect prefix")
    let upper_inclusive_scan: YazaDbBtreeScanResultV1 = yaza_db_btree_read_rows_internal_filtered_profiled_v1(0, bytes_from_text(""), 0, storage.file, storage.header, 12, columns, 1, [0], 1, 10, false, 0, List[YazaDbTxnStatusV1](), false, false, bytes_from_text(""), true, tuple_three.key, true, none, List[YazaSqlValueV1](), List[YazaSqlSubqueryValuesV1](), List[Number](), false)?
    if list_count(upper_inclusive_scan.rows) != 3 or upper_inclusive_scan.page_reads != 4: return err("YDBv1 inclusive upper fence scan should read the boundary leaf")
    if list_get(list_get(upper_inclusive_scan.rows, 2).values, 0).integer_value != 3: return err("YDBv1 inclusive upper fence scan omitted its boundary key")
    let multi_level_continuation: List[YazaDbRowV1] = yaza_db_btree_read_rows_after_key_for_schema_v1(storage.file, storage.header, 12, columns, 1, [0], 1, tuple_three.key, 3)?
    if list_count(multi_level_continuation) != 3: return err("YDBv1 multi-level continuation returned the wrong bounded batch size")
    set row_index = 0
    while row_index < 3:
        if list_get(list_get(multi_level_continuation, row_index).values, 0).integer_value != row_index + 4: return err("YDBv1 multi-level continuation skipped or repeated a key across leaf boundaries")
        set row_index = row_index + 1

    let tuple_two_boundary: YazaBtreeScanSmokeTupleV1 = yaza_btree_scan_smoke_tuple_v1(2, columns)?
    let unary_leaf_left: Bytes = yaza_btree_scan_smoke_leaf_v1(16, [1], columns, false, bytes_from_text(""), true, tuple_two_boundary.key)?
    let unary_leaf_middle: Bytes = yaza_btree_scan_smoke_leaf_v1(17, [2], columns, true, tuple_two_boundary.key, true, tuple_three.key)?
    let unary_leaf_right: Bytes = yaza_btree_scan_smoke_leaf_v1(18, [3], columns, true, tuple_three.key, false, bytes_from_text(""))?

    var unary_left_inner: Bytes = yaza_db_page_new_v1(14, 0, 2, 1)?
    if not yaza_db_page_set_upper_v1(unary_left_inner, 17): return err("YDBv1 unary-inner fixture could not set its left subtree upper child")
    set unary_left_inner = yaza_db_page_finalize_v1(unary_left_inner)?
    set unary_left_inner = yaza_db_page_set_fences_v1(unary_left_inner, false, bytes_from_text(""), true, tuple_three.key)?
    let unary_left_pointer: Bytes = bytes_try_new_zeroed(8)?
    if not yaza_db_write_uint_le_v1(unary_left_pointer, 0, 32, 8): return err("YDBv1 unary-inner fixture could not encode its first leaf pointer")
    let unary_left_separator: Number = yaza_db_page_add_slot_v1(unary_left_inner, tuple_two_boundary.key, unary_left_pointer)?
    if unary_left_separator != 0: return err("YDBv1 unary-inner fixture could not add its left separator")
    let unary_left_final: Bytes = yaza_db_page_finalize_v1(unary_left_inner)?

    var unary_right_inner: Bytes = yaza_db_page_new_v1(15, 0, 2, 1)?
    if not yaza_db_page_set_upper_v1(unary_right_inner, 18): return err("YDBv1 unary-inner fixture could not set its sole child")
    set unary_right_inner = yaza_db_page_finalize_v1(unary_right_inner)?
    set unary_right_inner = yaza_db_page_set_fences_v1(unary_right_inner, true, tuple_three.key, false, bytes_from_text(""))?

    var unary_root: Bytes = yaza_db_page_new_v1(13, 0, 2, 2)?
    if not yaza_db_page_set_upper_v1(unary_root, 15): return err("YDBv1 unary-inner fixture could not set its root upper child")
    let unary_root_pointer: Bytes = bytes_try_new_zeroed(8)?
    if not yaza_db_write_uint_le_v1(unary_root_pointer, 0, 28, 8): return err("YDBv1 unary-inner fixture could not encode its left INNER pointer")
    let unary_root_separator: Number = yaza_db_page_add_slot_v1(unary_root, tuple_three.key, unary_root_pointer)?
    if unary_root_separator != 0: return err("YDBv1 unary-inner fixture could not add its root separator")
    let unary_root_final: Bytes = yaza_db_page_finalize_v1(unary_root)?

    let unary_leaf_left_written: Number = yaza_db_storage_write_page_sync_v1(storage.file, storage.header, unary_leaf_left)?
    let unary_leaf_middle_written: Number = yaza_db_storage_write_page_sync_v1(storage.file, storage.header, unary_leaf_middle)?
    let unary_leaf_right_written: Number = yaza_db_storage_write_page_sync_v1(storage.file, storage.header, unary_leaf_right)?
    let unary_left_written: Number = yaza_db_storage_write_page_sync_v1(storage.file, storage.header, unary_left_final)?
    let unary_right_written: Number = yaza_db_storage_write_page_sync_v1(storage.file, storage.header, unary_right_inner)?
    let unary_root_written: Number = yaza_db_storage_write_page_sync_v1(storage.file, storage.header, unary_root_final)?
    if unary_leaf_left_written != yaza_db_page_size_v1() or unary_leaf_middle_written != yaza_db_page_size_v1() or unary_leaf_right_written != yaza_db_page_size_v1() or unary_left_written != yaza_db_page_size_v1() or unary_right_written != yaza_db_page_size_v1() or unary_root_written != yaza_db_page_size_v1(): return err("YDBv1 unary-inner fixture could not persist its test tree")
    let unary_inner_scan: YazaDbBtreeScanResultV1 = yaza_db_btree_read_rows_with_stats_v1(storage.file, storage.header, 13, columns, [0], 1, 10)?
    if list_count(unary_inner_scan.rows) != 3: return err("YDBv1 B+Tree cursor did not traverse a zero-separator INNER child")
    if unary_inner_scan.page_reads != 6: return err("YDBv1 unary-inner B+Tree cursor page-read count was " + number_text(unary_inner_scan.page_reads) + ", expected 6 after retaining validated ancestors")
    set row_index = 0
    while row_index < 3:
        if list_get(list_get(unary_inner_scan.rows, row_index).values, 0).integer_value != row_index + 1: return err("YDBv1 unary-inner B+Tree cursor returned rows out of key order")
        set row_index = row_index + 1

    let malformed_pointer: Bytes = bytes_try_new_zeroed(8)?
    if not yaza_db_write_uint_le_v1(malformed_pointer, 0, 7, 8): return err("YDBv1 B+Tree malformed-pointer fixture could not encode its test pointer")
    let bad_inner: Bytes = yaza_db_page_new_v1(5, 0, 2, 1)?
    if not yaza_db_page_set_upper_v1(bad_inner, 4): return err("YDBv1 B+Tree malformed-pointer fixture could not set its upper child")
    let bad_separator: Number = yaza_db_page_add_slot_v1(bad_inner, key_three, malformed_pointer)?
    if bad_separator != 0: return err("YDBv1 B+Tree malformed-pointer fixture could not add its separator")
    let bad_root: Bytes = yaza_db_page_finalize_v1(bad_inner)?
    let bad_written: Number = yaza_db_storage_write_page_sync_v1(storage.file, storage.header, bad_root)?
    if bad_written != yaza_db_page_size_v1(): return err("YDBv1 B+Tree malformed-pointer fixture could not write its page")
    if result_is_ok(yaza_db_btree_seek_leaf_v1(storage.file, storage.header, 5, first_key)): return err("YDBv1 B+Tree seek accepted a misaligned on-disk child pointer")
    let restored_root: Number = yaza_db_storage_write_page_sync_v1(storage.file, storage.header, root_page)?
    if restored_root != yaza_db_page_size_v1(): return err("YDBv1 B+Tree fixture could not restore its valid root")

    let tuple_two: YazaBtreeScanSmokeTupleV1 = yaza_btree_scan_smoke_tuple_v1(2, columns)?
    let bad_fence_left: Bytes = yaza_btree_scan_smoke_leaf_v1(3, [1, 2], columns, false, bytes_from_text(""), true, tuple_two.key)?
    let bad_fence_written: Number = yaza_db_storage_write_page_sync_v1(storage.file, storage.header, bad_fence_left)?
    if bad_fence_written != yaza_db_page_size_v1(): return err("YDBv1 B+Tree bad-fence fixture could not write its leaf")
    if result_is_ok(yaza_db_btree_seek_leaf_v1(storage.file, storage.header, 5, first_key)): return err("YDBv1 B+Tree seek accepted a child fence that disagreed with its parent")
    let restored_left: Number = yaza_db_storage_write_page_sync_v1(storage.file, storage.header, left_page)?
    if restored_left != yaza_db_page_size_v1(): return err("YDBv1 B+Tree fixture could not restore its valid left leaf")

    let closed: Boolean = yaza_db_storage_close_v1(storage)?
    if not closed: return err("YDBv1 B+Tree fixture storage did not close")
    let removed: Boolean = remove(root, "btree-scan-smoke.ydb")?
    if not removed: return err("YDBv1 B+Tree fixture could not remove its database")
    let synced: Boolean = sync_directory(root)?
    if not synced: return err("YDBv1 B+Tree fixture cleanup sync failed")
    let root_closed: Boolean = close(root)?
    if not root_closed: return err("YDBv1 B+Tree fixture root did not close")
    return ok(list_count(rows))

start:
    let outcome: Result[Number, Text] = yaza_base_btree_scan_v1_check(arg(1))
    if result_is_ok(outcome):
        say "yazabase-btree-scan-v1-ok rows=" + number_text(result_unwrap(outcome))
    else:
        say result_unwrap_error(outcome)
