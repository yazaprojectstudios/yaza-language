fn concatenate(left: Text, right: Text) -> Result[Text,Text]:
    return text_try_concat(left, right)

start:
    let joined: Result[Text,Text] = concatenate("YAZA ", "LLVM")
    assert result_is_ok(joined)
    assert result_unwrap(joined) == "YAZA LLVM"
    let empty: Result[Text,Text] = text_try_concat("", "")
    assert result_is_ok(empty)
    assert result_unwrap(empty) == ""
    say "fallible-text-concat-ok"
