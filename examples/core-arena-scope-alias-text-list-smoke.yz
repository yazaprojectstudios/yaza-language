shape Inbox:
    items: TextList

start:
    let shared: Inbox = Inbox(text_list())
    arena_scope 4096:
        let alias: Inbox = shared
        let message: Text = "child " + number_text(42)
        list_push(alias.items, message)
    assert list_count(shared.items) == 1
    assert list_get(shared.items, 0) == "child 42"
    say "aggregate-alias-text-copy-ok"
