shape Payloads:
    data: List[Bytes]

shape Envelope:
    label: Text
    payloads: Payloads

start:
    let parent_label: Text = "parent " + number_text(1)
    arena_scope 4096:
        let local_bytes: Bytes = bytes_from_text("child")
        let payloads: Payloads = Payloads(List[Bytes]())
        let original: Envelope = Envelope(parent_label, payloads)
        let alias: Envelope = original
        list_push(alias.payloads.data, local_bytes)
        assert list_count(alias.payloads.data) == 1
    say "nested-field-precise-list-store-ok"
