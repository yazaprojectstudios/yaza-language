use "../yazabase/sql_join_v1"

fn multi_join_integer(value: Number) -> YazaSqlValueV1:
    return result_unwrap(yaza_sql_value_integer_v1(4, value))

fn multi_join_item_row(id: Number) -> List[YazaSqlValueV1]:
    return [multi_join_integer(id)]

fn multi_join_profile_row(id: Number, item_id: Number) -> List[YazaSqlValueV1]:
    return [multi_join_integer(id), multi_join_integer(item_id)]

fn multi_join_audit_row(profile_id: Number, event: Text) -> List[YazaSqlValueV1]:
    return [multi_join_integer(profile_id), yaza_sql_value_text_v1(event)]

fn multi_join_eight_table_fixture() -> Boolean:
    let columns: List[YazaSqlColumnSchemaV1] = [YazaSqlColumnSchemaV1("id", 4, false, 0, 0, 0, "")]
    let schemas: List[YazaSqlTableSchemaV1] = [YazaSqlTableSchemaV1(5, "t0", columns), YazaSqlTableSchemaV1(6, "t1", columns), YazaSqlTableSchemaV1(7, "t2", columns), YazaSqlTableSchemaV1(8, "t3", columns), YazaSqlTableSchemaV1(9, "t4", columns), YazaSqlTableSchemaV1(10, "t5", columns), YazaSqlTableSchemaV1(11, "t6", columns), YazaSqlTableSchemaV1(12, "t7", columns)]
    let catalog: YazaSqlCatalogSnapshotV1 = YazaSqlCatalogSnapshotV1(11, schemas, List[YazaSqlColumnDefaultV1]())
    let source: Text = "SELECT t0.id FROM t0 AS t0 JOIN t1 AS t1 ON t0.id = t1.id JOIN t2 AS t2 ON t1.id = t2.id JOIN t3 AS t3 ON t2.id = t3.id JOIN t4 AS t4 ON t3.id = t4.id JOIN t5 AS t5 ON t4.id = t5.id JOIN t6 AS t6 ON t5.id = t6.id JOIN t7 AS t7 ON t6.id = t7.id"
    let parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(source)
    if not result_is_ok(parsed): return false
    let bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(source, result_unwrap(parsed), catalog)
    if not result_is_ok(bound): return false
    let plan: YazaSqlBoundPlanV1 = result_unwrap(bound)
    if list_count(plan.join_stages) != 6: return false
    let first_rows: List[List[YazaSqlValueV1]] = [multi_join_item_row(1), multi_join_item_row(2)]
    let first: YazaSqlMemoryTableV1 = YazaSqlMemoryTableV1(5, 11, [4], first_rows, 0)
    let second: YazaSqlMemoryTableV1 = YazaSqlMemoryTableV1(6, 11, [4], first_rows, 0)
    let initial: Result[YazaSqlMemoryTableV1, Text] = yaza_sql_join_inner_memory_v1(plan, first, second)
    if not result_is_ok(initial): return false
    let remaining: List[YazaSqlMemoryTableV1] = [YazaSqlMemoryTableV1(7, 11, [4], first_rows, 0), YazaSqlMemoryTableV1(8, 11, [4], first_rows, 0), YazaSqlMemoryTableV1(9, 11, [4], first_rows, 0), YazaSqlMemoryTableV1(10, 11, [4], first_rows, 0), YazaSqlMemoryTableV1(11, 11, [4], first_rows, 0), YazaSqlMemoryTableV1(12, 11, [4], first_rows, 0)]
    var joined: YazaSqlMemoryTableV1 = result_unwrap(initial)
    var stage_index: Number = 0
    while stage_index < list_count(plan.join_stages):
        let stage: YazaSqlBoundJoinStageV1 = list_get(plan.join_stages, stage_index)
        let next: Result[YazaSqlMemoryTableV1, Text] = yaza_sql_join_additional_memory_v1(plan, stage, joined, list_get(remaining, stage_index))
        if not result_is_ok(next): return false
        set joined = result_unwrap(next)
        set stage_index = stage_index + 1
    let executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(plan, joined, List[YazaSqlValueV1]())
    if not result_is_ok(executed): return false
    return list_count(result_unwrap(executed).rows) == 2 and list_count(result_unwrap(executed).columns) == 1 and list_count(joined.column_type_ids) == 8

fn multi_join_memory_fixture() -> Boolean:
    let item_columns: List[YazaSqlColumnSchemaV1] = [YazaSqlColumnSchemaV1("id", 4, false, 0, 0, 0, "")]
    let profile_columns: List[YazaSqlColumnSchemaV1] = [YazaSqlColumnSchemaV1("id", 4, false, 0, 0, 0, ""), YazaSqlColumnSchemaV1("item_id", 4, false, 1, 0, 0, "")]
    let audit_columns: List[YazaSqlColumnSchemaV1] = [YazaSqlColumnSchemaV1("profile_id", 4, false, 0, 0, 0, ""), YazaSqlColumnSchemaV1("event", 9, false, 1, 0, 0, "")]
    let trace_columns: List[YazaSqlColumnSchemaV1] = [YazaSqlColumnSchemaV1("profile_id", 4, false, 0, 0, 0, ""), YazaSqlColumnSchemaV1("marker", 9, false, 1, 0, 0, "")]
    let catalog_tables: List[YazaSqlTableSchemaV1] = [YazaSqlTableSchemaV1(5, "items", item_columns), YazaSqlTableSchemaV1(6, "profiles", profile_columns), YazaSqlTableSchemaV1(7, "audit", audit_columns), YazaSqlTableSchemaV1(8, "trace", trace_columns)]
    let catalog: YazaSqlCatalogSnapshotV1 = YazaSqlCatalogSnapshotV1(11, catalog_tables, List[YazaSqlColumnDefaultV1]())
    let source: Text = "SELECT i.id, p.id, a.event, t.marker FROM items AS i INNER JOIN profiles AS p ON i.id = p.item_id INNER JOIN audit AS a ON p.id = a.profile_id INNER JOIN trace AS t ON a.profile_id = t.profile_id ORDER BY a.event"
    let parsed: Result[YazaSqlSelectAstV3, Text] = yaza_sql_parse_select_v3(source)
    if not result_is_ok(parsed): return false
    let bound: Result[YazaSqlBoundPlanV1, Text] = yaza_sql_bind_select_v1(source, result_unwrap(parsed), catalog)
    if not result_is_ok(bound): return false
    let plan: YazaSqlBoundPlanV1 = result_unwrap(bound)
    if list_count(plan.join_stages) != 2: return false

    let items: YazaSqlMemoryTableV1 = YazaSqlMemoryTableV1(5, 11, [4], [multi_join_item_row(1), multi_join_item_row(2)], 0)
    let profiles: YazaSqlMemoryTableV1 = YazaSqlMemoryTableV1(6, 11, [4, 4], [multi_join_profile_row(10, 1), multi_join_profile_row(11, 1), multi_join_profile_row(12, 2)], 0)
    let audits: YazaSqlMemoryTableV1 = YazaSqlMemoryTableV1(7, 11, [4, 9], [multi_join_audit_row(10, "view"), multi_join_audit_row(12, "close"), multi_join_audit_row(10, "open"), multi_join_audit_row(99, "orphan")], 0)
    let traces: YazaSqlMemoryTableV1 = YazaSqlMemoryTableV1(8, 11, [4, 9], [multi_join_audit_row(10, "tag-a"), multi_join_audit_row(12, "tag-b"), multi_join_audit_row(99, "tag-orphan")], 0)
    let first_join: Result[YazaSqlMemoryTableV1, Text] = yaza_sql_join_inner_memory_v1(plan, items, profiles)
    if not result_is_ok(first_join): return false
    let stage: YazaSqlBoundJoinStageV1 = list_get(plan.join_stages, 0)
    if stage.left_key_ordinal != 1 or stage.right_key_ordinal != 0: return false
    let second_join: Result[YazaSqlMemoryTableV1, Text] = yaza_sql_join_additional_memory_v1(plan, stage, result_unwrap(first_join), audits)
    if not result_is_ok(second_join): return false
    let second_stage: YazaSqlBoundJoinStageV1 = list_get(plan.join_stages, 1)
    if second_stage.left_key_ordinal != 3 or second_stage.right_key_ordinal != 0: return false
    let third_join: Result[YazaSqlMemoryTableV1, Text] = yaza_sql_join_additional_memory_v1(plan, second_stage, result_unwrap(second_join), traces)
    if not result_is_ok(third_join): return false
    let joined: YazaSqlMemoryTableV1 = result_unwrap(third_join)
    if list_count(joined.rows) != 3 or list_count(joined.column_type_ids) != 7 or joined.join_work_units <= result_unwrap(second_join).join_work_units: return false

    let executed: Result[YazaSqlQueryResultV1, Text] = yaza_sql_execute_memory_v1(plan, joined, List[YazaSqlValueV1]())
    if not result_is_ok(executed): return false
    let output: YazaSqlQueryResultV1 = result_unwrap(executed)
    if list_count(output.columns) != 4 or list_count(output.rows) != 3: return false
    let first: List[YazaSqlValueV1] = list_get(output.rows, 0)
    let second: List[YazaSqlValueV1] = list_get(output.rows, 1)
    let third: List[YazaSqlValueV1] = list_get(output.rows, 2)
    if list_get(first, 0).integer_value != 2 or list_get(first, 1).integer_value != 12 or list_get(first, 2).text_value != "close" or list_get(first, 3).text_value != "tag-b": return false
    if list_get(second, 0).integer_value != 1 or list_get(second, 1).integer_value != 10 or list_get(second, 2).text_value != "open" or list_get(second, 3).text_value != "tag-a": return false
    return list_get(third, 0).integer_value == 1 and list_get(third, 1).integer_value == 10 and list_get(third, 2).text_value == "view" and list_get(third, 3).text_value == "tag-a"

start:
    arena_scope 1048576:
        assert multi_join_eight_table_fixture()
        assert multi_join_memory_fixture()
    say "yazabase-sql-multi-join-memory-v1-ok"
