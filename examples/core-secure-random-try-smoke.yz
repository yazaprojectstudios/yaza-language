start:
    let empty: Result[Bytes,Text] = secure_random_bytes_try(0)
    assert result_is_ok(empty)
    assert bytes_length(result_unwrap(empty)) == 0

    let generated: Result[Bytes,Text] = secure_random_bytes_try(32)
    assert result_is_ok(generated)
    let secret: Bytes = result_unwrap(generated)
    assert bytes_length(secret) == 32
    assert bytes_zeroize(secret) == 0
    assert bytes_get(secret, 0) == 0

    let negative_length: Result[Bytes,Text] = secure_random_bytes_try(-1)
    assert not result_is_ok(negative_length)
    assert result_unwrap_error(negative_length) == "secure random length must be between 0 and 64 MiB"

    let excessive_length: Result[Bytes,Text] = secure_random_bytes_try(67108865)
    assert not result_is_ok(excessive_length)
    assert result_unwrap_error(excessive_length) == "secure random length must be between 0 and 64 MiB"
    say "secure-random-try-ok"
