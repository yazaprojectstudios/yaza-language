use "std/mysql/protocol"
use "std/mysql/auth"

start:
    # 1. 32-byte XOR validation
    let a: Bytes = crypto_sha256(bytes_from_text("alpha"))
    let b: Bytes = crypto_sha256(bytes_from_text("beta"))
    let xor_res: Result[Bytes, Text] = mysql_xor_32(a, b)
    assert result_is_ok(xor_res)
    let c: Bytes = result_unwrap(xor_res)
    assert bytes_length(c) == 32
    # Commutative: b XOR a == c
    let xor_rev: Result[Bytes, Text] = mysql_xor_32(b, a)
    assert result_is_ok(xor_rev)
    assert bytes_equal(c, result_unwrap(xor_rev))
    # Self-inverse: c XOR b == a
    let xor_inv: Result[Bytes, Text] = mysql_xor_32(c, b)
    assert result_is_ok(xor_inv)
    assert bytes_equal(a, result_unwrap(xor_inv))

    # 2. caching_sha2_password scramble
    let salt: Bytes = bytes_from_text("01234567890123456789")
    let scramble_res: Result[Bytes, Text] = mysql_scramble_caching_sha2("secretpassword", salt)
    assert result_is_ok(scramble_res)
    let scramble: Bytes = result_unwrap(scramble_res)
    assert bytes_length(scramble) == 32

    # Empty password produces empty scramble
    let empty_scramble: Result[Bytes, Text] = mysql_scramble_caching_sha2("", salt)
    assert result_is_ok(empty_scramble)
    assert bytes_length(result_unwrap(empty_scramble)) == 0
