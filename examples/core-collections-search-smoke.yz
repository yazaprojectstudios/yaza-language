use "std/collections"

start:
    let values: List[Number] = [1, 2, 2, 2, 5, 9]
    assert collections_linear_search_number(values, 2) == 1
    assert collections_linear_search_number(values, 8) == -1

    assert collections_lower_bound_number(values, -4) == 0
    assert collections_lower_bound_number(values, 2) == 1
    assert collections_lower_bound_number(values, 3) == 4
    assert collections_lower_bound_number(values, 9) == 5
    assert collections_lower_bound_number(values, 10) == 6
    assert collections_branchless_lower_bound_number(values, -4) == 0
    assert collections_branchless_lower_bound_number(values, 2) == 1
    assert collections_branchless_lower_bound_number(values, 3) == 4
    assert collections_branchless_lower_bound_number(values, 9) == 5
    assert collections_branchless_lower_bound_number(values, 10) == 6

    assert collections_binary_search_number(values, 1) == 0
    assert collections_binary_search_number(values, 2) == 1
    assert collections_binary_search_number(values, 9) == 5
    assert collections_binary_search_number(values, 8) == -1
    assert collections_branchless_binary_search_number(values, 1) == 0
    assert collections_branchless_binary_search_number(values, 2) == 1
    assert collections_branchless_binary_search_number(values, 9) == 5
    assert collections_branchless_binary_search_number(values, 8) == -1

    let empty: List[Number] = List[Number]()
    assert collections_lower_bound_number(empty, 5) == 0
    assert collections_binary_search_number(empty, 5) == -1
    assert collections_branchless_lower_bound_number(empty, 5) == 0
    assert collections_branchless_binary_search_number(empty, 5) == -1
    assert collections_interpolation_search(empty, 5) == -1

    # Sparse range where val_high - val_low >> high - low (regression for integer division truncation)
    let sparse: List[Number] = List[Number]()
    var si: Number = 0
    while si < 1000:
        list_push(sparse, si * 1000 + 500)
        set si = si + 1
    assert collections_interpolation_search(sparse, 500) == 0
    assert collections_interpolation_search(sparse, 500500) == 500
    assert collections_interpolation_search(sparse, 999500) == 999
    assert collections_interpolation_search(sparse, 500123) == -1
    assert collections_interpolation_search(sparse, 0) == -1
    assert collections_interpolation_search(sparse, 1000000) == -1
    let sparse_view: ListView[Number] = list_read_view(sparse)
    assert collections_interpolation_search_view(sparse_view, 750500) == 750
    assert collections_interpolation_search_view(sparse_view, 750501) == -1

    # Huge 64-bit range (> 2^53) to ensure zero integer overflow and zero Float64 precision trap
    let huge: List[Number] = [0, 1000000000000000, 2000000000000000, 3000000000000000, 4000000000000000]
    assert collections_interpolation_search(huge, 3000000000000000) == 3
    assert collections_interpolation_search(huge, 2500000000000000) == -1

    say "collections search passed"
