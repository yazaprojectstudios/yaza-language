start:
    let left: Bytes = bytes_from_text("YAZA")
    let right: Bytes = bytes_from_text("!")
    let joined: Result[Bytes, Text] = bytes_try_concat(left, right)
    match joined:
        ok(value):
            say bytes_to_text(value)
        err(message):
            say message
    say "fallible-bytes-concat-ok"
